// 0.81：对齐 Go 标准库的第四批（compress/flate、gzip、zlib，text/template）
use std.text.template
use std.encoding.json
use std.encoding.json.{ Json }
use std.compress.flate
use std.compress.gzip
use std.compress.zlib

fn main() {
  let data = json.parse(r#"{"name": "Kite", "ver": 0.8, "tags": ["go", "lang", "gc"], "users": [{"n": "ann", "age": 31, "admin": true}, {"n": "bob", "age": 17, "admin": false}], "empty": [], "m": {"b": 2, "a": 1}, "html": "<a href='x'>&</a>"}"#) |> unwrap
  let src = r#"Hello, {{.name}} v{{.ver}}! tags={{.tags}} n={{len .tags}} first={{index .tags 0}}
{{range $i, $u := .users -}}
  {{$i}}: {{$u.n | printf "%-5s|"}} {{if ge $u.age 18}}adult{{else}}minor{{end}}{{if $u.admin}} (admin){{end}}
{{end -}}
{{range .empty}}x{{else}}(empty){{end}} {{with .m}}a={{.a}} b={{.b}}{{end}} {{range $k, $v := .m}}{{$k}}={{$v}};{{end}}
{{- /* 注释 */ -}}
|{{.missing}}|{{html .html}}|{{urlquery "a b&c"}}|{{js "it's <b>"}}|
{{$x := 1}}{{range .tags}}{{if eq . "lang"}}{{break}}{{end}}{{$x = 2}}[{{.}}]{{end}} x={{$x}}
{{define "item"}}<{{.}}>{{end}}{{range .tags}}{{template "item" .}}{{end}} {{block "foot" .name}}foot:{{.}}{{end}}
{{printf "%5.2f|%05d|%x|%q|%v|%t|%+d|%s" 3.14159 42 255 "hi" .tags true 7 nil}} {{printf "%d" "x"}} {{print 1 2 "a" 3}} {{and 1 0 2}} {{or 0 "" "z"}} {{not .empty}}
{{if and (gt (len .tags) 2) (ne .name "Go")}}ok{{end}} {{slice "abcdef" 1 3}} {{range 3}}{{.}}{{end}} {{eq .name "Go" "Kite"}} {{lt 1 2.5}} {{index .m "a"}}
{{if false}}a{{else if .name}}b{{else}}c{{end}} {{shout .name}} {{.name | shout | printf "[%s]"}}"#
  let t0 = template.add_func(template.new("demo"), "shout", (args: List<Json>) => Ok(JStr(upper(json.as_str(args[0]) |> unwrap_or("")) + "!")))
  let t = template.parse_into(t0, src) |> unwrap
  print(template.execute(t, data) |> unwrap)
  print(template.defined(t))
  print(template.parse("e1", r#"{{if .x}}a"#), template.parse("e2", r#"a
{{nope 1}}"#), template.parse("e3", r#"{{end}}"#), template.parse("e4", r#"{{.x"#))
  print(template.render(r#"{{index .a 5}}"#, json.parse("\{\"a\": [1]\}") |> unwrap), template.render(r#"{{template "zz"}}"#, JNull), template.render(r#"{{lt 1 "a"}}"#, JNull), template.render(r#"{{.a.b}}"#, json.parse("\{\"a\": 3\}") |> unwrap))

  let s = "hello hello hello hello, 你好你好你好 abcabcabcabc"
  for lv in [0, 1, 6, 9] {
    let c = flate.compress_str(s, lv)
    print(lv, len(c), flate.decompress_str(c))
  }
  print(flate.decompress([75, 76, 74, 6, 0]), flate.decompress([1, 2]), flate.compress([], 6), flate.decompress(flate.compress([], 6)))
  let pyg = [31, 139, 8, 0, 0, 0, 0, 0, 2, 3, 123, 178, 119, 193, 211, 165, 123, 223, 239, 233, 241, 206, 44, 73, 125, 191, 167, 49, 35, 53, 39, 39, 95, 1, 137, 228, 122, 66, 5, 21, 0, 246, 138, 241, 72, 102, 0, 0, 0]
  print(gzip.decompress_str(pyg), gzip.header(pyg))
  print(zlib.decompress_str([120, 218, 171, 202, 201, 76, 82, 72, 43, 202, 207, 85, 40, 168, 44, 201, 200, 207, 211, 81, 168, 66, 19, 1, 0, 223, 92, 12, 219]), zlib.adler32_str("Wikipedia"))
  let src = "Kite 压缩往返 " + join(map(["a", "b", "c", "a", "b", "c"], (x) => x + x + x), "-")
  let g = gzip.compress_str(src)
  let z = zlib.compress_str(src)
  print(len(__bytes(src)), len(g), len(z), gzip.decompress_str(g) == Ok(src), zlib.decompress_str(z) == Ok(src))
}
