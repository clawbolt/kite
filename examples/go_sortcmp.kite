use std.sort
use std.cmp
use std.maps
use std.math
fn main() {
  print(sort.ints([3, 1, 2, -5, 3]), sort.strings(["b", "a", "B", ""]), sort.float64s([
    2.5,
    math.nan,
    -1.0,
    math.inf,
  ]))
  print(
    sort.search_ints([1, 3, 5, 7], 4),
    sort.search_strings(["a", "c"], "c"),
    sort.search(100, (i) => i * i >= 50),
    sort.find(5, (i) => 3 - i),
  )
  let ps = [("a", 3), ("b", 1), ("c", 3), ("d", 2), ("e", 1)]
  print(
    sort.slice_stable(ps, (x, y) => x.1 < y.1),
    sort.slice_is_sorted([1, 2, 2], (a, b) => a < b),
    sort.ints_are_sorted([2, 1]),
    sort.slice([5, 4, 9], sort.reverse((a, b) => a < b)),
  )
  print(
    cmp.compare(1, 2),
    cmp.compare("b", "a"),
    cmp.compare(math.nan, 1.0),
    cmp.compare(math.nan, math.nan),
    cmp.less(math.nan, -1.0),
    cmp.or("", ["", "x", "y"]),
    cmp.or(0, [0, 0]),
  )
  let m = Map([("a", 1), ("b", 2), ("c", 3)])
  print(
    maps.sorted_keys(m),
    maps.equal(m, maps.clone(m)),
    maps.sorted_keys(maps.delete_func(m, (k, v) => v % 2 == 1)),
    maps.copy(m, Map([("z", 26), ("a", 0)]))["a"],
    len(maps.collect([("x", 1), ("x", 2)])),
    maps.equal_func(m, Map([("a", "1"), ("b", "2"), ("c", "3")]), (x, y) => "{x}" == y),
  )
}
