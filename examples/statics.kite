// 静态方法：impl 里不带 self 的方法用 类型.方法(...) 调用，impl 内可写 Self.方法(...)
type V2 = { x: Int, y: Int }

impl V2 {
  fn new(x: Int, y: Int) -> Self { V2 { x: x, y: y } }
  fn zero() -> V2 { Self.new(0, 0) }
  fn len2(self) -> Int { self.x * self.x + self.y * self.y }
}

type Stack<T> = { items: List<T> }

impl<T> Stack<T> {
  fn empty() -> Stack<T> { Stack { items: [] } }
  fn push(self, x: T) -> Stack<T> { Stack { items: self.items + [x] } }
}

impl Int {
  fn parse_or(s: Str, d: Int) -> Int { d }
}

fn main() {
  let v = V2.new(3, 4)
  print(v, v.len2(), V2.zero())
  let s = Stack.empty().push(1).push(2)
  print(s.items)
  let mk = V2.new
  print(mk(1, 2), Int.parse_or("x", 7))
}
