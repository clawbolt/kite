use std.math.big.rat
use std.math.big.rat.{ Rat }
use std.math.big
fn show(x: Rat) -> Str {
  let (f, exact) = x.float64()
  let (n, ex) = x.float_prec()
  "{x.string()} {x.rat_string()} {x.float_string(0)} {x.float_string(3)} {x.float_string(10)} {x.num().string()} {x.denom().string()} {x.is_int()} {x.sign()} {rat.float64_bits(f)} {exact} {n} {ex}"
}
fn main() {
  let strs = ["0", "1", "-1", "3/4", "-6/8", "+5/10", "0x10/0b11", "-0o17/011", "1_000/3", "1/0", "1/-2", "1/+2", "/2", "2/", "1/2/3", "1.25", "-1.25", ".5", "5.", "1e3", "1E-3", "1.5e+2", "-0.001e-2", "0x1p-2", "0x1.8p1", "0b1.01", "0o7.4", "0x.8", "0X1P4", "1_234.5_6", "1__2", "_1", "1_", "1.2.3", "1e", "1e+", "1p3", "0b102", "abc", "", "+", "-", ".", "-.", "1e1000001", "1e-1000001", "00012", "0012.5", "12e-1_0", "1e9999999999999999999", "0.1", "0.3", "123456789012345678901234567890.123456789", "-7/3", "22/7", "355/113", "1/3", "2/3", "5/2", "-5/2", "7/2", "-1/1000000", "999999/1000000", "1e-400", "1e-320", "4.9406564584124654e-324", "2.4703282292062327e-324", "2.4703282292062328e-324", "1.7976931348623157e308", "1.7976931348623159e308", "1e309", "9007199254740993", "9007199254740995", "0.1e1", "1/10", "-0", "0/5", "0e10", "0x"]
  for s in strs {
    match rat.parse(s) {
      Some(r) => print(s, show(r)),
      None    => print(s, "nil"),
    }
  }
  let small = [rat.new_rat(0, 1), rat.new_rat(1, 2), rat.new_rat(-3, 4), rat.new_rat(7, -3), rat.new_rat(-10, -4), rat.new_rat(5, 1), rat.new_rat(-1, 7), rat.new_rat(9223372036854775807, 3), rat.new_rat(-9223372036854775807 - 1, 1), rat.new_rat(-9223372036854775807 - 1, -2)]
  for x in small {
    print(show(x), show(x.negate()), show(x.abs_value()))
    if x.sign() != 0 { print(show(x.inv())) }
    for y in small {
      var line = "{x.add(y).string()} {x.sub(y).string()} {x.mul(y).string()} {x.cmp(y)}"
      if y.sign() != 0 { line = line + " " + x.quo(y).string() }
      print(line)
    }
  }
  let inf = rat.float64_frombits(9218868437227405312)
  for f in [0.0, 1.0, -1.0, 0.1, -2.5, 1e100, 1e-100, 5e-324, 1.7976931348623157e308, 5e-324 * 3.0, 2.2250738585072014e-308, 123456.789, -0.0, inf, -inf, rat.float64_frombits(9221120237041090561)] {
    match rat.from_float64(f) {
      Some(r) => print(show(r)),
      None    => print("nil"),
    }
  }
  let a = unwrap(big.parse("123456789012345678901234567890", 10))
  let b = unwrap(big.parse("-987654321098765432109876543210", 10))
  print(show(rat.from_frac(a, b)), show(rat.from_frac(b, a)), show(rat.from_int(a)), show(rat.from_int64(-42)), show(rat.from_uint64(-1)))
  var h = rat.from_int64(0)
  var i = 1
  while i <= 30 {
    h = h.add(rat.new_rat(1, i))
    i += 1
  }
  print(show(h))
  var c = rat.new_rat(1, 1)
  var k = 0
  while k < 20 {
    c = rat.new_rat(1, 1).add(rat.new_rat(1, 1).add(c).inv())
    k += 1
  }
  print(show(c))
  for p in [0, 1, 2, 5, 20] {
    print(rat.new_rat(2, 3).float_string(p), rat.new_rat(-2, 3).float_string(p), rat.new_rat(1, 2).float_string(p), rat.new_rat(-1, 2).float_string(p), rat.new_rat(-5, 1000).float_string(p), rat.new_rat(99999, 100000).float_string(p), rat.new_rat(-99999, 100000).float_string(p), rat.new_rat(1, 3).float_string(p))
  }
}
