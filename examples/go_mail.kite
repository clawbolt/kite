use std.net.mail
use std.strconv

fn q(s: Str) -> Str { strconv.quote_go(s) }

fn fa(a: mail.Address) -> Str { "\{" + q(a.name) + " " + q(a.address) + "} " + a.string() }

fn show_list(label: Str, r: Result<List<mail.Address>, Str>) {
  match r {
    Ok(xs) => {
      print(label + " {len(xs)}")
      for a in xs { print("  " + fa(a)) }
    }
    Err(e) => print(label + " err " + e),
  }
}

fn show_date(label: Str, r: Result<mail.Time, Str>) {
  match r {
    Ok(t) => print(label + " {t.unix} {t.nsec} " + q(t.zone) + " {t.offset}"),
    Err(e) => print(label + " err " + e),
  }
}

