  for d in dates { show_date("D " + q(d), mail.parse_date(d)) }
  let keys = [
    "content-type",
    "CONTENT-TYPE",
    "x-my-header",
    "foo bar",
    "foo@bar",
    "",
    "-x-",
    "a--b",
    "ÄBC",
    "message-id",
    "Mime-version",
    "user_agent",
    "Content-Type",
    "cOnTeNt-tYpE",
    "x",
    "X-",
    "1abc-def",
    "foo:bar",
    "Custom/Header",
    "a.b_c~d",
  ]
  for k in keys { print("K " + q(k) + " " + q(mail.canonical_mime_header_key(k))) }
  let msgs = [
    "From: John Doe <jdoe@machine.example>\nTo: Mary Smith <mary@example.net>\nSubject: Saying Hello\nDate: Fri, 21 Nov 1997 09:55:06 -0600\nMessage-ID: <1234@local.machine.example>\n\nThis is a message just to say hello.\nSo, \"Hello\".\n",
    "Feedback-Type: abuse\nUser-Agent: SomeGenerator/1.0\nVersion: 1\n",
    "From: iant@golang.org\nCustom/Header: v\n\nBody\n",
    "From iant@golang.org Mon Jun 19 00:00:00 2023\nFrom: iant@golang.org\n\nHello, gophers!\n",
    "From: John Doe <jdoe@machine.example>\u{d}\nTo: Mary Smith <mary@example.net>, \u{d}\n  Bob <bob@example.net>\u{d}\nCc: g: a@b, c@d;\u{d}\nSubject: Saying Hello\u{d}\nDate: Fri, 21 Nov 1997 09:55:06 -0600\u{d}\n\u{d}\nThis is a message.\u{d}\nSo, \"Hello\".\u{d}\n",
    "subject: line one\n  continued\n\tmore   \nX-Empty:\nx-dup: 1\nX-DUP: 2\n\nbody\n",
    "A: b\n",
    "A: b",
    "A: b\n   ",
    "",
    "\n",
    "\nbody only",
    " bad: initial\nA: b\n\n",
    "\tbad\n",
    "noColon\n\n",
    "A: b\nnoColon\n\n",
    ": empty key\nB: c\n\n",
    "Key : spaced\n\n",
    "To: bad address\n\nx",
    "Date: garbage\n\n",
    "Date: Mon, 2 Jan 2006 15:04 +0100\nFrom: =?utf-8?q?J=C3=B6rg?= <j@x>\n\n",
    "A:b\u{d}",
    "A: b\u{d}\n\u{d}\nbody\u{d}\nwith CRLF",
    "A:    \t value with spaces  \t\nB:\n\n\n\nbody after blanks",
    "X: 1\n \n Y\n\n",
    "subject: héllo wörld\nfrom: 日本 <n@x.jp>\n\nüñí\n",
    "To: a@b,\n c@d,\n\te@f\nCc:\n\n",
    "mime-version: 1.0\ncontent-type: text/plain\nmessage-id: <x@y>\n\n",
  ]
  for s in msgs {
    print("M " + q(s))
    match mail.read_message(s) {
      Ok(m) => {
        for k in m.header.keys() {
          for v in m.header.values(k) { print(" H " + q(k) + " " + q(v)) }
        }
        print(" get subject " + q(m.header.get("subject")) + " from " + q(m.header.get("FROM")))
        for k in ["From", "to", "Cc"] { show_list(" " + k, m.header.address_list(k)) }
        show_date(" date", m.header.date())
        print(" body " + q(m.body_string()))
      }
      Err(e) => print(" err " + e),
    }
  }
}
