// 对拍 tests/go/smtp.go：脚本客户端跑 Client 方法；send 行走 send_mail_via（同 SendMail 的步骤）
use std.fs
use std.encoding.hex
use std.strconv
use std.net.smtp

fn q(s: Str) -> Str { strconv.quote_go(s) }

fn qb(b: List<Int>) -> Str { strconv.quote_bytes_with(b, 34, false, false) }

fn dec(s: Str) -> List<Int> { unwrap(hex.decode(s)) }

fn ds(s: Str) -> Str { unwrap(__from_bytes(dec(s))) }

fn es(r: Result<Unit, Str>) -> Str {
  match r {
    Ok(_) => "",
    Err(e) => e,
  }
}

fn main() {
  var n = 0
  var c: Option<smtp.Client> = None
  for line in split(unwrap(fs.read("tests/go/testdata/smtp/cases.txt")), "\n") {
    if line == "" { continue }
    let p = split(line, "|")
    if p[0] == "case" {
      n += 1
      let (c0, e) = smtp.new_script_client(dec(p[2]), ds(p[1]), false)
      print("case {n} new err={q(e)}")
      c = if e == "" { Some(c0) } else { None }
      if e != "" {
        // Go：NewClient 出错返回 nil，但写出的字节仍要打印
        c = None
        print("  out={qb(c0.out)}")
      }
      continue
    }
    if p[0] == "end" {
      match c {
        Some(cc) => print("  out={qb(cc.out)}"),
        None => {},
      }
      c = None
      continue
    }
    if p[0] == "send" {
      n += 1
      let a = if p[2] == "plain" {
        Some(smtp.plain_auth("", "user", "pass", "127.0.0.1"))
      } else if p[2] == "cram" {
        Some(smtp.cram_md5_auth("user", "secret"))
      } else {
        None
      }
      let server = dec(p[1])
      let (cl, r) = smtp.send_mail_via(
        () => {
          let (c0, e) = smtp.new_script_client(server, "127.0.0.1", false)
          if e == "" { Ok(c0) } else { Err(e) }
        },
        a,
        ds(p[3]),
        split(ds(p[4]), "\u{0}"),
        dec(p[5]),
      )
      let out = match cl {
        Some(x) => x.out,
        None => [],
      }
      print("send {n} err={q(es(r))}\n  out={qb(out)}")
      continue
    }
    let cc = match c {
      Some(x) => x,
      None => { continue },
    }
    let args = map(p[1..], ds)
    if p[0] == "ext" {
      let (c2, ok, param) = smtp.extension(cc, args[0])
      c = Some(c2)
      print("  ext {args[0]} {if ok { "true" } else { "false" }} {q(param)}")
      continue
    }
    let (c2, r) = if p[0] == "hello" {
      smtp.hello_as(cc, args[0])
    } else if p[0] == "verify" {
      smtp.verify(cc, args[0])
    } else if p[0] == "mail" {
      smtp.mail(cc, args[0])
    } else if p[0] == "rcpt" {
      smtp.rcpt(cc, args[0])
    } else if p[0] == "data" {
      smtp.data(cc, __bytes(args[0]))
    } else if p[0] == "reset" {
      smtp.reset(cc)
    } else if p[0] == "noop" {
      smtp.noop(cc)
    } else if p[0] == "quit" {
      smtp.quit(cc)
    } else if p[0] == "plain" {
      smtp.auth(cc, smtp.plain_auth(args[0], args[1], args[2], args[3]))
    } else {
      smtp.auth(cc, smtp.cram_md5_auth(args[0], args[1]))
    }
    c = Some(c2)
    print("  {p[0]} err={q(es(r))}")
  }
}
