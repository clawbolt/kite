// 闭包、upvalue、循环控制、defer —— 用来对比两个引擎的语义

fn make_counter() -> fn() -> Int {
  var n = 0
  () => {
    n += 1
    n
  }
}

fn log_steps() -> Int {
  defer { print("defer: 最后执行") }
  defer { print("defer: 先执行") }
  print("函数体")
  42
}

fn find_first_neg(xs: List<Int>) -> Option<Int> {
  for x in xs {
    if x < 0 { return Some(x) }
  }
  None
}

fn main() {
  let c = make_counter()
  c(); c()
  print("计数器:", c())

  // 每次迭代的闭包各自捕获自己的 i
  var fs = []
  for i in 1..=3 {
    fs = push(fs, () => i * 10)
  }
  print(fs |> map(f => f()))

  // break / continue
  var total = 0
  for i in 1..=10 {
    if i % 2 == 0 { continue }
    if i > 7 { break }
    total += i
  }
  print("奇数和:", total)

  // 局部函数互相递归
  fn is_even(n: Int) -> Bool { if n == 0 { true } else { is_odd(n - 1) } }
  fn is_odd(n: Int) -> Bool { if n == 0 { false } else { is_even(n - 1) } }
  print(is_even(10), is_odd(7))

  print(log_steps())
  print(find_first_neg([3, -2, -5]), find_first_neg([1]))

  let [head, ..rest] = [1, 2, 3]
  print(head, rest)
}
