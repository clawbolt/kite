// 由 tests/go/fmt.go 生成（KITEGEN=1 go run fmt.go），再经 kite fmt 排版
use std.fmt
use std.math
use std.strconv

fn row(i: Int, f: Str, a: List<fmt.Arg>) { print("{i}: " + strconv.quote_go(f) + " [" + fmt.sprintf(f, a) + "]") }

fn sp(i: Int, a: List<fmt.Arg>) { print("sprint {i}: [" + fmt.sprint(a) + "] [" + fmt.sprintln(a) + "]") }

fn ef(i: Int, f: Str, a: List<fmt.Arg>) { print("errorf {i}: [" + fmt.errorf(f, a) + "]") }

