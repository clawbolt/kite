  row(2056, "%[2]v %[1]v %v|%[1]T", [VStr("a"), VFloat(1.5)])
  row(2057, "%[2]*[1]d|%-[2]*[1]d|", [VInt(7), VInt(4)])
  row(2058, "%v %v", [VStruct("main.SI", [("I", VNil)]), VStruct("main.SI", [("I", VStruct("main.T", [("A", VInt(1)), ("B", VStr("x"))]))])])
  row(2059, "%+v|%#v", [VStruct("main.SI", [("I", VErr("boom"))]), VStruct("main.SI", [("I", VNil)])])
  row(2060, "%s|%v|%d", [VNil, VTyped("[]interface \{}", VList([VNil])), VTyped("[]interface \{}", VList([VNil, VInt(1)]))])
  row(2061, "%#v|%#v|%#v", [VTyped("int8", VInt(-3)), VTyped("uint16", VUint(65535)), VTyped("uintptr", VUint(255))])
  row(2062, "%x|%X|%o|%O|%#o|%#O|%#b", [VInt(-255), VInt(-255), VInt(-8), VInt(-8), VInt(0), VInt(8), VInt(0)])
  row(2063, "%08.3f|%-08.3f|%+08.3f|% 08.3f|%08.3e|%08g", [VFloat(-3.14159), VFloat(3.14159), VFloat(3.14159), VFloat(3.14159), VFloat(3.14159), VFloat(1e-05)])
  row(2064, "%6.2v|%.3v|%10.4v|%-10v|", [VFloat(3.14159), VStr("abcdef"), VFloat(123.456789), VFloat(1.5)])
  sp(0, [VInt(1), VInt(2), VStr("a"), VStr("b"), VInt(3), VFloat(4.5), VNil, VBool(true)])
  sp(1, [VStr("a"), VInt(1), VStr("b")])
  sp(2, [VTyped("main.MyStr", VStr("x")), VInt(1), VTyped("main.MyStr", VStr("y"))])
  sp(3, [VErr("boom"), VErr("boom"), VStr("s"), VTyped("[]int", VList([VInt(1)])), VTyped("map[string]int", VMap([(VStr("a"), VInt(1))]))])
  sp(4, [])
  sp(5, [VNil, VNil])
  sp(6, [VStruct("main.T", [("A", VInt(1)), ("B", VStr("x"))]), VPtr(VStruct("main.T", [("A", VInt(2)), ("B", VStr("y"))])), VTyped("main.Color", VInt(3)), VTyped("main.Celsius", VFloat(1.0))])
  ef(0, "wrap: %w", [VErr("boom")])
  ef(1, "%w and %w", [VErr("boom"), VErr("x")])
  ef(2, "%w", [VInt(1)])
  ef(3, "%v %s %d", [VErr("boom"), VErr("boom"), VInt(3)])
  ef(4, "plain", [])
}

