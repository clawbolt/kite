fn pal_hex(p: List<png.Color>) -> Str {
  var b: List<Int> = []
  for c in p { b = b + [c.r, c.g, c.b, c.a] }
  hex.encode_bytes(b)
}

fn tup(t: (Int, Int, Int, Int)) -> Str {
  let (r, g, b, a) = t
  "({r}, {g}, {b}, {a})"
}

fn describe(m: png.Image) -> Str {
  var s = png.kind_name(m.kind) + " {m.width}x{m.height} stride={m.stride}"
  if m.kind == png.PALETTED { s = s + " pal{len(m.palette)}=" + pal_hex(m.palette) }
  s = s + " last=" + tup(m.rgba_at(m.width - 1, m.height - 1)) + " first=" + tup(m.rgba_at(0, 0))
  if len(m.pix) <= 300 {
    s = s + " pix=" + hex.encode_bytes(m.pix)
  } else {
    s = s + " pixlen={len(m.pix)} pixcrc={crc32.checksum_bytes(m.pix)}"
  }
  s
}

fn decode_one(name: Str, data: List<Int>) {
  match png.decode(data) {
    Ok(m)  => print(name, describe(m)),
    Err(e) => print(name, "err", e),
  }
  match png.decode_config(data) {
    Ok(c) => {
      var s = "  cfg " + png.kind_name(c.model) + " {c.width}x{c.height}"
      if c.model == png.PALETTED { s = s + " pal=" + pal_hex(c.palette) }
      print(s)
    },
    Err(e) => print("  cfg err", e),
  }
}

fn f8(i: Int) -> Int { (i * 73 + 41) % 256 }

const ALPHAS8: List<Int> = [0, 255, 128, 7, 200, 64]

const ALPHAS16: List<Int> = [0x0000, 0xffff, 0x8000, 0x0102, 0xfff0, 0x00ff]

fn fill(n: Int, bpp: Int, alpha: Int) -> List<Int> {
  var pix: List<Int> = []
  var i = 0
  while i < n {
    var v = f8(i)
    if alpha != 0 {
      let p = i / bpp
      let k = i % bpp
      if bpp == 4 && k == 3 {
        v = if alpha == 1 { 0xff } else { ALPHAS8[p % 6] }
      } else if bpp == 8 && k >= 6 {
        let a = if alpha == 1 { 0xffff } else { ALPHAS16[p % 6] }
        v = if k == 6 { a >> 8 } else { a & 255 }
      }
    }
    pix = push(pix, v)
    i += 1
  }
  pix
}

fn make_pal(n: Int, trans: Bool) -> List<png.Color> {
  var p: List<png.Color> = []
  for i in 0..n {
    let a = if trans && i % 3 == 1 { (i * 17) & 255 } else { 0xff }
    p = push(p, png.Color { r: f8(3 * i), g: f8(3 * i + 1), b: f8(3 * i + 2), a: a })
  }
  p
}

fn make_img(kind: Int, w: Int, h: Int, alpha: Int, npal: Int, trans: Bool) -> png.Image {
  let m = png.new_image(kind, w, h)
  if kind == png.PALETTED {
    var pix: List<Int> = []
    for i in 0..w * h { pix = push(pix, if npal > 0 { ((i * 7 + 3) % npal) & 255 } else { 0 }) }
    return png.Image { pix: pix, palette: make_pal(npal, trans), ..m }
  }
  png.Image { pix: fill(len(m.pix), m.bytes_per_pixel(), alpha), ..m }
}

fn be32_at(bs: List<Int>, i: Int) -> Int { (bs[i] << 24) | (bs[i + 1] << 16) | (bs[i + 2] << 8) | bs[i + 3] }

fn idat_payload(data: List<Int>) -> (List<Int>, Int) {
  var out: List<Int> = []
  var n = 0
  var p = 8
  while p + 8 <= len(data) {
    let l = be32_at(data, p)
    if data[p + 4..p + 8] == [73, 68, 65, 84] {
      out = out + data[p + 8..p + 8 + l]
      n += 1
    }
    p += 12 + l
  }
  (out, n)
}

fn main() {
  print("== decode")
  for (name, hx) in vectors() { decode_one(name, unwrap(hex.decode(hx))) }

  print("== encode")
  let cases = [
    (png.GRAY, 5, 3, 0, 0, false),
    (png.GRAY16, 4, 3, 0, 0, false),
    (png.RGBA, 4, 3, 1, 0, false),
    (png.RGBA, 6, 3, 2, 0, false),
    (png.NRGBA, 3, 3, 1, 0, false),
    (png.NRGBA, 5, 2, 2, 0, false),
    (png.RGBA64, 3, 2, 1, 0, false),
    (png.RGBA64, 3, 4, 2, 0, false),
    (png.NRGBA64, 2, 3, 1, 0, false),
    (png.NRGBA64, 4, 3, 2, 0, false),
    (png.PALETTED, 11, 3, 0, 1, false),
    (png.PALETTED, 11, 3, 0, 2, false),
    (png.PALETTED, 5, 3, 0, 3, true),
    (png.PALETTED, 7, 2, 0, 16, false),
    (png.PALETTED, 5, 5, 0, 17, true),
    (png.PALETTED, 6, 4, 0, 256, false),
    (png.GRAY, 16, 16, 0, 0, false),
    (png.NRGBA, 16, 16, 2, 0, false),
    (png.RGBA64, 16, 9, 2, 0, false),
  ]
  let levels = [png.NO_COMPRESSION, png.DEFAULT_COMPRESSION, png.BEST_SPEED, png.BEST_COMPRESSION]
  var ci = 0
  for (kind, w, h, alpha, npal, trans) in cases {
    let m = make_img(kind, w, h, alpha, npal, trans)
    let lvs = if ci == 3 || ci == 9 || ci == 17 { levels } else { take(levels, 2) }
    for lv in lvs {
      match png.encode_level(m, lv) {
        Err(e)  => print(ci, lv, "err", e),
        Ok(out) => {
          let (payload, nidat) = idat_payload(out)
          let raw = unwrap(zlib.decompress(payload))
          if lv == png.NO_COMPRESSION {
            if len(out) <= 400 { print(ci, lv, "png", hex.encode_bytes(out)) }
            print(ci, lv, "len", len(out), "crc", crc32.checksum_bytes(out), "idats", nidat)
          }
          print(ci, lv, "raw", len(raw), crc32.checksum_bytes(raw), "head", hex.encode_bytes(take(raw, 40)))
          match png.decode(out) {
            Ok(d)  => print(ci, lv, "decoded", describe(d)),
            Err(e) => print(ci, lv, "decode err", e),
          }
        },
      }
    }
    ci += 1
  }
  let big = make_img(png.GRAY, 300, 240, 0, 0, false)
  let out = unwrap(png.encode_level(big, png.NO_COMPRESSION))
  let (_, nidat) = idat_payload(out)
  print("big len", len(out), "crc", crc32.checksum_bytes(out), "idats", nidat)
  match png.decode(out) {
    Ok(d)  => print("big decoded", describe(d)),
    Err(e) => print("big decode err", e),
  }

  print("== encode errors")
  for m in [png.new_image(png.GRAY, 0, 0), png.new_image(png.RGBA, 3, 0), png.new_paletted(2, 2, []), make_img(png.PALETTED, 2, 2, 0, 257, false)] {
    match png.encode(m) {
      Ok(_)  => print("err <nil>"),
      Err(e) => print("err", e),
    }
  }
}
