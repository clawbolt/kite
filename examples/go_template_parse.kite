fn walk(tr: Tree, n: Node) {
  let (loc, ctx) = parse.error_context(tr, n)
  print("ctx {loc} {q(ctx)}")
  match n {
    ListNode { nodes, .. } => { for c in nodes { walk(tr, c) } },
    IfNode { pipe, list, .. } => {
      walk(tr, pipe)
      walk(tr, list)
    },
    ActionNode { pipe, .. } => walk(tr, pipe),
    PipeNode { decl, cmds, .. } => {
      for d in decl { walk(tr, d) }
      for c in cmds {
        walk(tr, c)
        match c {
          CommandNode { args, .. } => { for a in args { walk(tr, a) } },
          _ => (),
        }
      }
    },
    _ => (),
  }
}

fn errs(e: Str) -> Str { if e == "" { "<nil>" } else { e } }

fn main() {
  for (n, i) in PARSE_TESTS { show(n, i, 0, "", "", BUILTINS) }
  for i in [
    "\{\{/*\n\n\n*/\}\}",
    "x \r\n\t\{\{- /* hi */\}\}",
    "\{\{/* hi */ -\}\}\n\n\ty",
    "x \r\n\t\{\{- /* */ -\}\}\n\n\ty",
    "\{\{define `x`\}\}\{\{/* c */\}\}\{\{end\}\}\{\{/* d */\}\}",
  ] {
    show("comments", i, parse.PARSE_COMMENTS, "", "", [])
  }
  for i in [
    "[[.X]]",
    "[[/* a comment */]]",
    "[[if .X]]y[[else]]z[[end]]",
    "[[range .X]][[break]][[continue]][[end]]",
    "[[with .X]]y[[end]]",
    "[[template \"name\" .]]",
    "\{\{.X\}\} [[- .Y -]] \{\{.Z\}\}",
    "[[.X]",
  ] {
    show("delims", i, parse.PARSE_COMMENTS, "[[", "]]", [])
  }
  show("delims2", "<%if .X%>a<%- else -%>b<%end%>", 0, "<%", "%>", [])
  show("delims3", "$\{.X\}\}", 0, "$", "\}", [])
  show("skip func check", "\{\{fn 1 2\}\}", parse.SKIP_FUNC_CHECK, "", "", [])
  show(
    "skip func check 2",
    "\{\{if fn\}\}\{\{fn | g\}\}\{\{end\}\}",
    parse.SKIP_FUNC_CHECK,
    "",
    "",
    [],
  )
  show("break func", "\{\{range .X\}\}\{\{break 20\}\}\{\{end\}\}", 0, "", "", ["break"])
  show("break no func", "\{\{range .X\}\}\{\{break 20\}\}\{\{end\}\}", 0, "", "", [])
  show("continue func", "\{\{continue 1\}\}\{\{range .\}\}\{\{continue\}\}\{\{end\}\}", 0, "", "", [
    "continue",
  ])
  show("nil func", "\{\{nilfn\}\}", 0, "", "", ["continue"])
  show("two maps", "\{\{a\}\}\{\{b\}\}", 0, "", "", ["a", "b"])
  match parse.parse(
    "top",
    "\{\{define `a`\}\}A\{\{end\}\}top\{\{template `a`\}\}",
    "",
    "",
    BUILTINS,
  ) {
    Ok(set) => {
      let names = sort(keys(set))
      print("Parse: [" + join(names, " ") + "] <nil>")
      for k in names {
        let st = unwrap(get(set, k))
        print("  {k}: {q(parse.tree_string(st))} {st.parse_name}")
      }
    },
    Err(e) => print("Parse:", e),
  }
  match parse.parse("bad", "\{\{define `a`\}\}A\{\{end\}\}\{\{.X", "", "", []) {
    Ok(_) => print("Parse bad: <nil>"),
    Err(e) => print("Parse bad: " + e),
  }
  var ts: Map<Str, Tree> = Map()
  var line = ""
  match parse.tree_parse(
    parse.new("one"),
    "\{\{define `shared`\}\}S1\{\{end\}\}one",
    "",
    "",
    ts,
    [],
  ) {
    Ok((_, s)) => {
      ts = s
      line = "true <nil>"
    },
    Err(e) => { line = "false " + e },
  }
  match parse.tree_parse(
    parse.new("two"),
    "\{\{define `shared`\}\}S2\{\{end\}\}two",
    "",
    "",
    ts,
    [],
  ) {
    Ok((_, s)) => {
      ts = s
      line = line + " true <nil>"
    },
    Err(e) => { line = line + " false " + e },
  }
  print(line)
  match parse.tree_parse(
    parse.new("three"),
    "\{\{define `x`\}\} \{\{end\}\}three",
    "",
    "",
    ts,
    [],
  ) {
    Ok((_, s)) => {
      ts = s
      print("true <nil> " + parse.tree_string(unwrap(get(ts, "shared"))) + " {len(keys(ts))}")
    },
    Err(e) => print("false", e),
  }
  print(b(parse.is_empty_tree(None)))
  for i in [
    "",
    "hello",
    " \t\n \t\n",
    "\{\{/* comment */\}\}",
    "\{\{define \"x\"\}\}something\{\{end\}\}",
    "\{\{define `x`\}\}something\{\{end\}\}\n\n\{\{define `y`\}\}something\{\{end\}\}\n\n",
    "\{\{define `x`\}\}something\{\{end\}\}\nx\n\{\{define `y`\}\}something\{\{end\}\}\ny\n",
    "\{\{define `x`\}\}something\{\{end\}\}\{\{if 3\}\}foo\{\{end\}\}",
    "\{\{.\}\}",
    "\{\{range .\}\}\{\{end\}\}",
    "\{\{with .\}\}\{\{end\}\}",
    "\{\{template `x`\}\}",
    "\u{a0}\u{2003}\u{b}\u{c}",
    "\u{200b}",
  ] {
    match parse.tree_parse(parse.new("root"), i, "", "", Map(), []) {
      Ok((tr, _)) => print("empty {q(i)}: {b(parse.is_empty_tree(tr.root))} <nil>"),
      Err(e) => print("empty {q(i)}: {e}"),
    }
  }
  let (tr, _) = unwrap(
    parse.tree_parse(
      parse.new("ctx"),
      "ab\ncd\{\{if .X\}\}\n  \{\{.Y | printf \"%d\"\}\}\{\{end\}\}\n\{\{$z := 1\}\}",
      "",
      "",
      Map(),
      BUILTINS,
    ),
  )
  walk(tr, root_of(tr))
  print(tr.name, tr.parse_name, "true")
  print(
    "{parse.NODE_TEXT} {parse.NODE_ACTION} {parse.NODE_BOOL} {parse.NODE_CHAIN} {parse.NODE_COMMAND} {parse.NODE_DOT} {parse.NODE_FIELD} {parse.NODE_IDENTIFIER} {parse.NODE_IF} {parse.NODE_LIST} {parse.NODE_NIL} {parse.NODE_NUMBER} {parse.NODE_PIPE} {parse.NODE_RANGE} {parse.NODE_STRING} {parse.NODE_TEMPLATE} {parse.NODE_VARIABLE} {parse.NODE_WITH} {parse.NODE_COMMENT} {parse.NODE_BREAK} {parse.NODE_CONTINUE} {parse.PARSE_COMMENTS} {parse.SKIP_FUNC_CHECK}",
  )
  let id = match parse.new_identifier("foo") {
    IdentifierNode { ident, .. } => Node.IdentifierNode { pos: 7, ident: ident },
    x => x,
  }
  print(parse.string(id, "", ""), parse.position(id), parse.node_type(id))
  var sb = ""
  var k = 0
  while k < 200 {
    sb = sb + "line {k} \{\{if .A{k}\}\}\{\{.B | printf \"%d\" {k}\}\}\{\{else\}\}x\{\{end\}\}\n"
    k += 1
  }
  match parse.tree_parse(parse.new("big"), sb, "", "", Map(), BUILTINS) {
    Ok((tb, _)) => {
      let ns = nodes_of(root_of(tb))
      print("<nil> {len(ns)} {b(parse.tree_string(tb) == sb)}")
      match ns[len(ns) - 2] {
        IfNode { line, pos, pipe, .. } => {
          let pl = match pipe {
            PipeNode { line, .. } => line,
            _ => 0,
          }
          print(line, pos, pl)
        },
        _ => print("?"),
      }
    },
    Err(e) => print(e),
  }
}
