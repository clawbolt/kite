// text/template/parse 对拍（tests/go/template_parse.go）
use std.strconv
use std.text.template.parse
use std.text.template.parse.{ Node, Tree }

fn q(s: Str) -> Str { strconv.quote_go(s) }

fn f64(f: Float) -> Str { strconv.format_float_go(f, "g", -1, 64) }

fn ql(xs: List<Str>) -> Str { "[" + join(map(xs, q), " ") + "]" }

fn b(x: Bool) -> Str { if x { "true" } else { "false" } }

fn dump(n: Node, ind: Str) {
  let p = parse.position(n)
  let t = parse.node_type(n)
  match n {
    ListNode { nodes, .. } => {
      print("{ind}List@{p} t={t} n={len(nodes)}")
      for c in nodes { dump(c, ind + "  ") }
    },
    TextNode { text, .. } => print("{ind}Text@{p} t={t} {q(text)}"),
    CommentNode { text, .. } => print("{ind}Comment@{p} t={t} {q(text)}"),
    ActionNode { line, pipe, .. } => {
      print("{ind}Action@{p} t={t} L{line}")
      dump(pipe, ind + "  ")
    },
    PipeNode { line, is_assign, decl, cmds, .. } => {
      print("{ind}Pipe@{p} t={t} L{line} assign={b(is_assign)} decl={len(decl)} cmds={len(cmds)}")
      for d in decl { dump(d, ind + "  ") }
      for c in cmds { dump(c, ind + "  ") }
    },
    CommandNode { args, .. } => {
      print("{ind}Command@{p} t={t} args={len(args)}")
      for a in args { dump(a, ind + "  ") }
    },
    IdentifierNode { ident, .. } => print("{ind}Identifier@{p} t={t} {ident}"),
    VariableNode { ident, .. } => print("{ind}Variable@{p} t={t} {ql(ident)}"),
    DotNode { .. } => print("{ind}Dot@{p} t={t}"),
    NilNode { .. } => print("{ind}Nil@{p} t={t}"),
    FieldNode { ident, .. } => print("{ind}Field@{p} t={t} {ql(ident)}"),
    ChainNode { node, field, .. } => {
      print("{ind}Chain@{p} t={t} {ql(field)}")
      dump(node, ind + "  ")
    },
    BoolNode { val, .. } => print("{ind}Bool@{p} t={t} {b(val)}"),
    NumberNode { num, .. } => print(
      "{ind}Number@{p} t={t} {num.text} int={b(num.is_int)}:{num.int64} uint={b(num.is_uint)}:{strconv.format_uint(num.uint64, 10)} float={b(num.is_float)}:{f64(num.float64)} complex={b(num.is_complex)}:{f64(num.re)},{f64(num.im)}",
    ),
    StringNode { quoted, text, .. } => print("{ind}String@{p} t={t} {quoted} {q(text)}"),
    IfNode { line, pipe, list, else_list, .. } => {
      print("{ind}If@{p} t={t} L{line}")
      branch(pipe, list, else_list, ind)
    },
    RangeNode { line, pipe, list, else_list, .. } => {
      print("{ind}Range@{p} t={t} L{line}")
      branch(pipe, list, else_list, ind)
    },
    WithNode { line, pipe, list, else_list, .. } => {
      print("{ind}With@{p} t={t} L{line}")
      branch(pipe, list, else_list, ind)
    },
    BreakNode { line, .. } => print("{ind}Break@{p} t={t} L{line}"),
    ContinueNode { line, .. } => print("{ind}Continue@{p} t={t} L{line}"),
    TemplateNode { line, name, pipe, .. } => {
      print("{ind}Template@{p} t={t} L{line} {q(name)}")
      match pipe {
        Some(x) => dump(x, ind + "  "),
        None => print("{ind}  nil pipe"),
      }
    },
    _ => print("{ind}??"),
  }
}

fn branch(pipe: Node, list: Node, el: Node?, ind: Str) {
  dump(pipe, ind + "  ")
  dump(list, ind + "  ")
  if let Some(e) = el {
    print("{ind}  else:")
    dump(e, ind + "  ")
  }
}

const BUILTINS: List<Str> = ["printf", "contains"]

fn root_of(t: Tree) -> Node { unwrap(t.root) }

fn nodes_of(n: Node) -> List<Node> {
  match n {
    ListNode { nodes, .. } => nodes,
    _ => [],
  }
}

fn show(name: Str, input: Str, mode: Int, ld: Str, rd: Str, funcs: List<Str>) {
  let tr = Tree { mode: mode, ..parse.new(name) }
  print("== {name} {q(input)}")
  match parse.tree_parse(tr, input, ld, rd, Map(), funcs) {
    Err(e) => print("error: {e}"),
    Ok((tmpl, set)) => {
      print("string: {q(parse.tree_string(tmpl))}")
      print(
        "name={tmpl.name} parse_name={tmpl.parse_name} empty={b(parse.is_empty_tree(tmpl.root))}",
      )
      dump(root_of(tmpl), "")
      for k in sort(keys(set)) {
        if k == name { continue }
        let st = unwrap(get(set, k))
        print("tree {q(k)}: {q(parse.tree_string(st))}")
        dump(root_of(st), "  ")
      }
      let ns = nodes_of(root_of(tmpl))
      if len(ns) > 0 {
        let (loc, ctx) = parse.error_context(tmpl, ns[len(ns) - 1])
        print("context: {loc} {q(ctx)}")
      }
    },
  }
}

