use std.math.cmplx
use std.math.cmplx.{ Complex, complex }
use std.math
use std.strconv

fn fe(x: Float) -> Str { strconv.format_float_go(x, "e", 11, 64) }

fn cs(z: Complex) -> Str { "(" + fe(z.re) + ", " + fe(z.im) + ")" }

fn main() {
  let nz = -0.0
  let inf = math.inf
  let nan = math.nan
  let generic = [
    complex(1.0, 2.0),
    complex(-3.5, 0.25),
    complex(0.5, -0.75),
    complex(2.0, -3.0),
    complex(-1.0, -1.0),
    complex(0.3, 0.4),
    complex(1.5, 0.0),
    complex(-2.0, 0.0),
    complex(0.0, 1.5),
    complex(0.0, -0.5),
    complex(0.25, 0.0),
    complex(10.0, 5.0),
    complex(-0.7, 3.2),
    complex(1e-5, 2e-5),
    complex(-6.0, -2.5),
    complex(0.8, 0.1),
    complex(3.0, 0.001),
    complex(-0.2, -1.7),
  ]
  let special = [
    complex(0.0, 0.0),
    complex(nz, 0.0),
    complex(0.0, nz),
    complex(nz, nz),
    complex(inf, 0.0),
    complex(-inf, 0.0),
    complex(inf, nz),
    complex(0.0, inf),
    complex(0.0, -inf),
    complex(nz, inf),
    complex(inf, inf),
    complex(-inf, -inf),
    complex(inf, -inf),
    complex(-inf, inf),
    complex(nan, 0.0),
    complex(0.0, nan),
    complex(nan, nan),
    complex(inf, nan),
    complex(-inf, nan),
    complex(nan, inf),
    complex(nan, -inf),
    complex(1.0, inf),
    complex(-1.0, -inf),
    complex(1.0, nan),
    complex(nan, 1.0),
    complex(inf, 1.0),
    complex(-inf, 1.0),
    complex(inf, -2.0),
    complex(-inf, -2.0),
    complex(0.5, 0.0),
    complex(0.0, 0.5),
    complex(nz, 0.5),
    complex(0.5, nz),
    complex(1.0, 0.0),
    complex(-1.0, 0.0),
    complex(0.0, 1.0),
    complex(0.0, -1.0),
  ]
  let names = [
    "Sqrt", "Exp", "Log", "Log10", "Conj", "Sin", "Cos", "Tan", "Cot", "Sinh", "Cosh", "Tanh",
    "Asin", "Acos", "Atan", "Asinh", "Acosh", "Atanh",
  ]
  let fns = [
    cmplx.sqrt,
    cmplx.exp,
    cmplx.log,
    cmplx.log10,
    cmplx.conj,
    cmplx.sin,
    cmplx.cos,
    cmplx.tan,
    cmplx.cot,
    cmplx.sinh,
    cmplx.cosh,
    cmplx.tanh,
    cmplx.asin,
    cmplx.acos,
    cmplx.atan,
    cmplx.asinh,
    cmplx.acosh,
    cmplx.atanh,
  ]
  for z in generic + special {
    let (r, th) = cmplx.polar(z)
    print(
      "z",
      cs(z),
      "abs",
      fe(cmplx.abs(z)),
      "phase",
      fe(cmplx.phase(z)),
      "polar",
      fe(r),
      fe(th),
      "isinf",
      cmplx.is_inf(z),
      "isnan",
      cmplx.is_nan(z),
    )
    var k = 0
    while k < len(fns) {
      let f = fns[k]
      print("  " + names[k], cs(f(z)))
      k += 1
    }
  }
  let ops = [
    complex(1.0, 2.0),
    complex(-3.5, 0.25),
    complex(0.5, -0.75),
    complex(0.0, 0.0),
    complex(nz, 0.0),
    complex(4.0, 0.0),
    complex(0.0, -2.0),
    complex(inf, 1.0),
    complex(1.0, inf),
    complex(inf, inf),
    complex(nan, 1.0),
    complex(nan, nan),
    complex(1e300, 1e300),
    complex(1e-300, 2e-300),
    complex(-inf, 0.0),
    complex(3.0, nan),
  ]
  var i = 0
  while i < len(ops) {
    var j = 0
    while j < len(ops) {
      if i != j {
        let a = ops[i]
        let b = ops[j]
        print(
          cs(a),
          cs(b),
          "add",
          cs(a.add(b)),
          "sub",
          cs(a.sub(b)),
          "mul",
          cs(cmplx.mul(a, b)),
          "div",
          cs(a.div(b)),
        )
      }
      j += 1
    }
    i += 1
  }
  let pows = [
    complex(0.0, 0.0),
    complex(nz, 0.0),
    complex(1.0, 2.0),
    complex(-2.0, 0.0),
    complex(0.5, -1.5),
    complex(3.0, 0.0),
    complex(0.0, 1.0),
    complex(-1.0, 0.0),
    complex(2.0, 0.5),
    complex(0.0, -2.0),
    complex(nan, 0.0),
    complex(inf, 0.0),
    complex(-0.5, 0.0),
  ]
  for a in pows {
    for b in pows {
      print("Pow", cs(a), cs(b), cs(cmplx.pow(a, b)))
    }
  }
  for p in [
    (1.0, 0.0),
    (2.0, 1.0),
    (3.0, -2.5),
    (0.5, 3.0),
    (0.0, 1.0),
    (inf, 0.0),
    (1.0, inf),
    (nan, 1.0),
    (-2.0, 0.75),
    (1e10, 1e-3),
  ] {
    let (r, th) = p
    print("Rect", fe(r), fe(th), cs(cmplx.rect(r, th)))
  }
  for z in [
    complex(1.5707963267948966, 0.001),
    complex(1.57, -0.002),
    complex(0.001, 0.002),
    complex(-0.003, 0.0005),
    complex(3.1415, 0.01),
    complex(-1.5707, 0.05),
  ] {
    print(
      "pole",
      cs(z),
      "Tan",
      cs(cmplx.tan(z)),
      "Cot",
      cs(cmplx.cot(z)),
      "series",
      fe(cmplx.tan_series(z)),
    )
  }
  for x in [
    0.0,
    0.5,
    3.0,
    100.0,
    -7.0,
    12345.678,
    1073741823.0,
    1073741824.0,
    1e10,
    3e15,
    1.2345e20,
    4.5e30,
    1e100,
    1.5e300,
    1.7976931348623157e308,
    9.223372036854776e18,
    1.4411518807585587e17,
  ] {
    print("reducePi", fe(x), fe(cmplx.reduce_pi(x)))
  }
  for z in [complex(1e10, 0.01), complex(4.5e30, 0.1), complex(1e100, 0.3)] {
    print("series", cs(z), fe(cmplx.tan_series(z)))
  }
  print(
    cs(cmplx.inf()),
    cs(cmplx.nan()),
    cmplx.is_inf(cmplx.inf()),
    cmplx.is_nan(cmplx.nan()),
    cmplx.is_nan(complex(inf, nan)),
  )
  for z in [
    complex(1.0, 2.0),
    complex(-1.5, nz),
    complex(nz, 0.0),
    complex(1e21, 1e-7),
    complex(123456789.0, 0.1),
    complex(inf, inf),
    complex(-inf, nan),
    complex(nan, -inf),
    complex(nan, nan),
    complex(0.1, -0.2),
    complex(5e-324, 1e6),
    complex(100000.0, 100000.5),
    cmplx.conj(complex(3.0, 4.0)),
  ] {
    print(z.string())
  }
  print(
    complex(1.0, 2.0).equal(complex(1.0, 2.0)),
    cmplx.equal(complex(0.0, 0.0), complex(nz, nz)),
    cmplx.equal(complex(nan, 0.0), complex(nan, 0.0)),
  )
}
