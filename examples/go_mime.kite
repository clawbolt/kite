// 对应 tests/go/mime.go（同一份用例生成）
use std.mime
use std.strings

fn show_params(p: Map<Str, Str>) -> Str {
  var parts: List<Str> = []
  for k in sort(keys(p)) { parts = push(parts, k + "=" + unwrap(get(p, k))) }
  "\{" + join(parts, ";") + "}"
}

fn ebt(t: mime.TypeTable, typ: Str) -> Str {
  match t.extensions_by_type(typ) {
    Ok(xs) => { return "[" + join(xs, ",") + "] err=[]" }
    Err(e) => { return "[] err=[" + e + "]" }
  }
}

fn tbe(t: mime.TypeTable, e: Str) {
  print("TypeByExtension [" + e + "] = [" + t.type_by_extension(e) + "]")
}

fn ext(t: mime.TypeTable, e: Str) { print("ExtensionsByType [" + e + "] = " + ebt(t, e)) }

fn add(t: mime.TypeTable, e: Str, typ: Str) -> mime.TypeTable {
  let (nt, err) = match t.add_extension_type(e, typ) {
    Ok(x) => (x, ""),
    Err(m) => (t, m),
  }
  let (just, _, perr) = mime.parse_media_type(typ)
  let x = if perr == "" { ebt(nt, just) } else { "-" }
  print(
    "AddExtensionType [" + e + "] [" + typ + "] err=[" + err + "] | [" + nt
      .type_by_extension(e) + "] [" + nt
      .type_by_extension(strings.to_lower(e)) + "] " + x,
  )
  nt
}

fn fm(t: Str, p: Map<Str, Str>) {
  print(
    "FormatMediaType [" + t + "] " + show_params(p) + " = [" + mime.format_media_type(t, p) + "]",
  )
}

fn parse(s: Str) {
  let (m, p, err) = mime.parse_media_type(s)
  print("ParseMediaType [" + s + "] = [" + m + "] " + show_params(p) + " err=[" + err + "]")
  if err == "" { print("  -> [" + mime.format_media_type(m, p) + "]") }
}

fn enc(e: mime.WordEncoder, name: Str, cs: Str, s: Str) {
  print("Encode " + name + " " + cs + " [" + s + "] = [" + e.encode(cs, s) + "]")
}

fn res(r: Result<Str, Str>) -> Str {
  match r {
    Ok(s) => { return "[" + s + "] err=[]" }
    Err(e) => { return "[] err=[" + e + "]" }
  }
}

fn dec(w: Str) { print("Decode [" + w + "] = " + res(mime.word_decoder().decode(w))) }

fn hdr(h: Str) { print("DecodeHeader [" + h + "] = " + res(mime.word_decoder().decode_header(h))) }

