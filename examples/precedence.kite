// 文法 v0.6 第二批：|> 高于比较、低于区间；区间低于 | ^ &；~ 按位取反；is 的绑定在 && 右侧和 then 分支可见
fn first_even(xs: List<Int>) -> Option<Int> {
  xs |> find(x => x % 2 == 0)
}

fn main() {
  let xs = [5, 2, 8, 1]
  print(xs |> len == 4, xs |> sort |> first == Some(1))
  print(0..4 |> map(i => i * i), 1 | 2..5)
  let mask = 0b1010
  print(~mask, mask & ~0b10, 6 ^ 3)
  let o = first_even(xs)
  print(o is Some(n) && n > 1, o is Some(n) && n > 5)
  if o is Some(n) && n % 2 == 0 { print("偶数", n) } else { print("没有") }
  if first_even([1, 3]) is Some(n) { print(n) } else { print("全是奇数") }
}
