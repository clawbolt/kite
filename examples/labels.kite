// 0.40：带标签的 break / continue。标签写在 while / for / loop 前面：'名字:
fn find_pair(xs: List<Int>, target: Int) -> Option<(Int, Int)> {
  var found = None
  'outer: for i in 0..len(xs) {
    for j in i + 1..len(xs) {
      if xs[i] + xs[j] == target {
        found = Some((xs[i], xs[j]))
        break 'outer
      }
    }
  }
  found
}

fn main() {
  print(find_pair([3, 8, 1, 5, 7], 12), find_pair([1, 2], 10))
  // continue 'rows：跳过这一行剩下的列
  'rows: for row in [[1, 2, -1, 4], [5, 6], [-2, 9]] {
    var s = 0
    for x in row {
      if x < 0 {
        print("跳过", row)
        continue 'rows
      }
      s += x
    }
    print("和", s)
  }
  // loop / while / while let 都能带标签，defer 照常执行
  var n = 0
  'a: loop {
    defer { print("离开一轮", n) }
    var k = 0
    while k < 10 {
      k += 1
      n += 1
      if n == 7 { break 'a }
      if k == 3 { continue 'a }
    }
  }
  print("n =", n)
  var stack = [1, 2, 3]
  'w: while let [x, ..rest] = stack {
    stack = rest
    for _ in 0..x {
      if x == 2 { continue 'w }
    }
    print("弹出", x)
  }
  // 闭包里的循环有自己的标签
  let f = (m) => {
    var c = 0
    'i: for a in 0..m {
      for b in 0..m {
        if b > a { continue 'i }
        c += 1
      }
    }
    c
  }
  print(f(4))
}
