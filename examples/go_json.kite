// 对齐 Go 1.27 的 encoding/json（v1 由 v2/jsontext 实现）：tests/go/json.go
// 对每个基础文档做删除、替换、插入变异，比较 Unmarshal(any)+Marshal、Valid、Compact、Indent 的结果和错误
use std.encoding.json
use std.encoding.hex

const BASES: List<Str> = [
  "\{\"a\":1}",
  "[1,2.5,-3e10,true,false,null]",
  "\"he\\\"llo\\u00e9\\n\"",
  "\{\"k\":[\{},[]],\"z\":\"x\"}",
  " 0 ",
  "-0.5E+3",
  "\{\"a\" : [ 1 , \{ \"b\" : null } ] }",
  "\"\\ud83d\\ude00 \\ud800\"",
  "[[[]]]",
  "\{\"\":\"\"}",
  "\"é<&>\\u2028\"",
  "123",
  "true",
  "",
  "\{\"a\":1,\"a\":2}",
  "[1e400]",
  "\"\\/\\b\\f\\r\\t\"",
  "  [\n\t1\r\n]  ",
  "nul",
  "\{\"x\":tru}",
]

const MUTS: List<Int> = [32, 34, 44, 125, 93, 120, 92, 48, 255]

fn base(i: Int) -> List<Int> {
  // 第 14 个基础文档含非法 UTF-8，Kite 的字符串字面量写不出来
  if i == 13 { [34, 0xff, 0xfe, 34] } else { __bytes(BASES[i]) }
}

fn show(inp: List<Int>) {
  print("IN " + hex.encode_bytes(inp))
  match json.check_valid(inp) {
    Some(e) => print(" U syn {e.offset} {e.msg}"),
    None => match json.unmarshal(inp) {
      Err(e) => print(" U err " + e),
      Ok(v) => print(" U ok " + hex.encode_bytes(unwrap(json.marshal(v))) + " <nil>"),
    },
  }
  print(" V {json.valid(inp)}")
  match json.compact(inp) {
    Err(e) => print(" C err {e.offset} {e.msg}"),
    Ok(c) => print(" C " + hex.encode_bytes(c)),
  }
  match json.indent(inp, "> ", "\t.") {
    Err(e) => print(" I err {e.offset} {e.msg}"),
    Ok(c) => print(" I " + hex.encode_bytes(c)),
  }
}

fn main() {
  for bi in 0..len(BASES) {
    let inp = base(bi)
    show(inp)
    for i in 0..len(inp) {
      show(inp[..i] + inp[i + 1..])
      for m in MUTS { show(set(inp, i, m)) }
    }
    var i = 0
    while i <= len(inp) {
      for m in MUTS { show(inp[..i] + [m] + inp[i..]) }
      i += 3
    }
  }
  print(
    unwrap(
      __from_bytes(
        unwrap(json.indent(__bytes("\{\"a\":[1,\{\"b\":[]}],\"c\":\{}" + "}"), "", "  ")),
      ),
    ),
  )
  print(unwrap(__from_bytes(json.html_escape(__bytes("<a href=\"x&y\">\u{2028}\u{2029}</a>")))))
  let m = JObj(Map([
    ("b", JArr([JNum(1.0), JStr("s"), JNull, JBool(true)])),
    ("a", JObj(Map())),
    ("c", JArr([])),
    ("d", JNum(1e21)),
    ("e", JNum(0.0000001)),
    ("f", JNum(123456789.0)),
    ("g", JNum(0.1)),
  ]))
  print(unwrap(__from_bytes(unwrap(json.marshal_indent(m, "#", " ")))))
  for x in [
    "\{\"a\":\{\"b\":[1,1e999]}" + "}",
    "\{\"x\":1e999}",
    "[1e999,]",
    "\{\"a\":1e999,\"a\":1}",
    "-1e999",
    "[0.1e-400, 4.9e-324, 1e308, 123456789012345678901]",
    "\{\"\\u00e9\":[\"\\u2028\",\"\"]}",
  ] {
    match json.unmarshal(__bytes(x)) {
      Ok(v) => print(x + " | <nil> | " + unwrap(__from_bytes(unwrap(json.marshal(v))))),
      Err(e) => print(x + " | " + e + " | -"),
    }
  }
}
