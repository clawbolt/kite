    ("a[", "ab"),
    ("a[", "x"),
    ("a/b[", "x"),
    ("*x", "xxx"),
    ("*.go", "main.go"),
    ("*.go", "dir/main.go"),
    ("*/*.go", "dir/main.go"),
    ("a*", "ab["),
