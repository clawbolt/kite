    ("a???b", "a☺b"),
    ("a[^a][^a][^a]b", "a☺b"),
    ("[a-ζ]*", "α"),
    ("*[a-ζ]", "A"),
    ("a?b", "a/b"),
    ("a*b", "a/b"),
    ("[\\]a]", "]"),
    ("[\\-]", "-"),
    ("[x\\-]", "x"),
