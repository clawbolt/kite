          pax_records: Map([("path", rep("q", 120))]),
          ..hd(reg, rep("q", 120))
        },
        "",
      ),
      (
        tar.Header {
          uid: 7,
          mod_time: t0,
          pax_records: Map([("uid", "7"), ("mtime", "1700000000")]),
          ..hd(reg, "short")
        },
        "",
      ),
      (
        tar.Header {
          mod_time: t0,
          pax_records: Map([("k", rep("v", 95))]),
          ..hd(reg, "long-record")
        },
        "",
      ),
    ]),
    ("errors", [
      (tar.Header { format: tar.FORMAT_USTAR, ..hd(reg, rep("n", 120)) }, ""),
      (tar.Header { format: tar.FORMAT_USTAR, pax_records: Map([("a", "b")]), ..hd(reg, "x") }, ""),
      (hd(tar.TYPE_XHEADER, "x"), ""),
      (hd(tar.TYPE_GNU_LONG_NAME, "x"), ""),
      (hd(reg, "dir/"), ""),
      (tar.Header { size: -1, ..hd(reg, "neg") }, ""),
      (tar.Header { size: 3, ..hd(tar.TYPE_XGLOBAL_HEADER, "") }, ""),
      (tar.Header { pax_records: Map([("a=b", "x")]), ..hd(reg, "bad") }, ""),
      (hd(reg, "nul\u{0}name"), ""),
      (
        tar.Header { access_time: tm(1257894000, 0), format: tar.FORMAT_USTAR, ..hd(reg, "at") },
        "",
      ),
      (tar.Header { mod_time: tm(1257894000, 5), format: tar.FORMAT_USTAR, ..hd(reg, "nano") }, ""),
      (tar.Header { format: tar.FORMAT_GNU, pax_records: Map([("a", "b")]), ..hd(reg, "g") }, ""),
      (tar.Header { mode: 1 << 30, format: tar.FORMAT_PAX, ..hd(reg, "p") }, ""),
      (tar.Header { uname: "a\u{0}b", format: tar.FORMAT_GNU, ..hd(reg, "u") }, ""),
      (tar.Header { mode: 1 << 62, mod_time: t0, ..hd(reg, "m") }, ""),
      (
        tar.Header {
          format: tar.FORMAT_GNU,
          pax_records: Map([("a", "b")]),
          ..hd(tar.TYPE_XGLOBAL_HEADER, "")
        },
        "",
      ),
      (tar.Header { format: tar.FORMAT_USTAR, ..hd(tar.TYPE_XGLOBAL_HEADER, "") }, ""),
      (tar.Header { xattrs: Map([("k", "v")]), format: tar.FORMAT_GNU, ..hd(reg, "x") }, ""),
      (tar.Header { pax_records: Map([("bad\u{0}key", "v")]), ..hd(reg, "y") }, ""),
      (tar.Header { pax_records: Map([("", "v")]), ..hd(reg, "z") }, ""),
      (tar.Header { linkname: "l\u{0}", format: tar.FORMAT_PAX, ..hd(reg, "w") }, ""),
      (tar.Header { size: 2, mod_time: t0, ..hd(reg, "ok-after-errors") }, "hi"),
    ]),
    ("pax-paths", [
      (tar.Header { mod_time: t0, ..hd(reg, "/" + rep("abs", 40)) }, ""),
