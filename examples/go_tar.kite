      (tar.Header { uid: -1, gid: -5, mod_time: t0, ..hd(reg, "neguid") }, ""),
      (tar.Header { size: 1 << 34, mod_time: t0, ..hd(dir, "hugedir/") }, ""),
      (tar.Header { mod_time: tm(-100, 0), ..hd(reg, "oldfile") }, ""),
      (tar.Header { mod_time: tm(1 << 34, 0), ..hd(reg, "future") }, ""),
