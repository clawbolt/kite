use std.archive.tar
use std.hash.crc32
use std.strconv

fn tm(s: Int, ns: Int) -> tar.Time { tar.unix(s, ns) }

fn show_map(m: Map<Str, Str>) -> Str {
  let parts = map(
    sort(keys(m)),
    (k) => strconv.quote_go(k) + ":" + strconv.quote_go(unwrap(get(m, k))),
  )
  "\{" + join(parts, ",") + "\}"
}

fn show_time(t: tar.Time) -> Str { "{t.sec}.{t.nsec}" }

fn show(h: tar.Header) -> Str {
  "typ={h.typeflag} name=" + strconv
    .quote_go(h.name) + " link=" + strconv
    .quote_go(h.linkname) + " size={h.size} mode={h.mode} uid={h.uid} gid={h.gid} uname=" +
    strconv
      .quote_go(h.uname) + " gname=" + strconv
      .quote_go(h.gname) + " mtime=" + show_time(h.mod_time) + " atime=" + show_time(
        h.access_time,
      ) + " ctime=" +
    show_time(h.change_time) + " dev={h.devmajor},{h.devminor} fmt=" + tar.format_string(
      h.format,
    ) + " pax=" + show_map(h.pax_records) + " xattr=" + show_map(h.xattrs)
}

fn errs(r: Result<(), Str>) -> Str {
  match r {
    Ok(_) => "ok",
    Err(e) => "err " + e,
  }
}

fn errs_s(e: Str) -> Str { if e == "" { "ok" } else { "err " + e } }

fn hex8(x: Int) -> Str {
  var s = strconv.format_int(x, 16)
  while len(s) < 8 { s = "0" + s }
  s
}

fn digest(b: List<Int>) -> Str { "len={len(b)} crc=" + hex8(crc32.checksum_bytes(b)) }

fn data_str(b: List<Int>) -> Str {
  if len(b) <= 40 { strconv.quote_go(unwrap(__from_bytes(b))) } else { digest(b) }
}

fn read_all(b: List<Int>) {
  var tr = tar.new_reader(b)
  var i = 0
  while i < 100 {
    let (t1, res) = tr.next()
    tr = t1
    match res {
      Err(e) => {
        print("  next: err " + e)
        return
      }
      Ok(h) => {
        print("  hdr: " + show(h))
        if h.size <= 65536 {
          let (t2, d, e) = tr.read_all()
          tr = t2
          print("  data: " + data_str(d) + " " + errs_s(e))
        }
      }
    }
    i += 1
  }
}

fn hd(typ: Int, name: Str) -> tar.Header {
  tar.Header { typeflag: typ, name: name, ..tar.header() }
}

fn rep(s: Str, n: Int) -> Str {
  var out = ""
  for _ in 0..n { out = out + s }
  out
}

fn write_case(name: Str, es: List<(tar.Header, Str)>) -> List<Int> {
  var tw = tar.new_writer()
  var res: List<Str> = []
  for (h, data) in es {
    let (t1, r) = tw.write_header(h)
    tw = t1
    res = push(res, errs(r))
    if is_ok(r) && data != "" {
      let (t2, n, e) = tw.write_string(data)
      tw = t2
      res = push(res, "w{n}:" + errs_s(e))
    }
  }
  let (t3, r) = tw.close()
  tw = t3
  res = push(res, "close:" + errs(r))
  let b = tw.bytes()
  print("case " + name + " " + join(res, " ") + " " + digest(b))
  b
}

fn decode(s: Str) -> List<Int> {
  let bs = __bytes(s)
  var out: List<Int> = []
  var i = 0
  let n = len(bs)
  while i < n {
    if bs[i] == 122 {
      var j = i + 1
      var k = 0
      while bs[j] != 46 {
        k = k * 10 + bs[j] - 48
        j += 1
      }
      out = out + [0; k]
      i = j + 1
    } else {
      out = push(out, hexv(bs[i]) * 16 + hexv(bs[i + 1]))
      i += 2
    }
  }
  out
}

fn hexv(c: Int) -> Int { if c <= 57 { c - 48 } else { c - 87 } }

fn main() {
  let t0 = tm(1700000000, 0)
  let reg = tar.TYPE_REG
  let dir = tar.TYPE_DIR
  let cases: List<(Str, List<(tar.Header, Str)>)> = [
    ("basic", [
      (
        tar.Header {
          mode: 0o644,
