          uid: 1000,
          gid: 100,
          uname: "alice",
          gname: "staff",
          mod_time: t0,
          ..hd(reg, "hello.txt")
        },
        "hello",
      ),
      (tar.Header { mode: 0o755, mod_time: t0, ..hd(dir, "dir/") }, ""),
      (
        tar.Header {
          linkname: "../hello.txt",
          mode: 0o777,
          mod_time: t0,
          ..hd(tar.TYPE_SYMLINK, "dir/link")
        },
