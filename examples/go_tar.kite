      (tar.Header { mod_time: t0, ..hd(reg, "ü") }, ""),
      (tar.Header { mod_time: t0, ..hd(dir, "dir/sub/ü/") }, ""),
      (tar.Header { mod_time: t0, ..hd(reg, "../ü") }, ""),
      (tar.Header { mod_time: t0, ..hd(reg, "x/../../y/ü") }, ""),
      (tar.Header { mod_time: t0, ..hd(reg, "é" + rep("a/", 60) + "f") }, ""),
      (tar.Header { mod_time: t0, ..hd(reg, rep("é", 60) + "/" + rep("z", 120)) }, ""),
      (tar.Header { size: 0, mod_time: t0, ..hd(tar.TYPE_GNU_SPARSE, "sparse-flag") }, ""),
      (tar.Header { size: 1, mod_time: t0, ..hd(tar.TYPE_CONT, "cont") }, "c"),
      (
        tar.Header {
          linkname: rep("é", 70),
          mod_time: t0,
          format: tar.FORMAT_GNU,
          ..hd(tar.TYPE_SYMLINK, "ü-link")
        },
        "",
      ),
      (
        tar.Header {
          pax_records: Map([("a", "b")]),
          ..hd(tar.TYPE_XGLOBAL_HEADER, "/dir/" + rep("G", 120) + "/")
        },
        "",
      ),
    ]),
    ("too-long", [
      (tar.Header { size: 3, mod_time: t0, ..hd(reg, "f") }, "abcdef"),
      (tar.Header { size: 10, mod_time: t0, ..hd(dir, "d/") }, "zz"),
    ]),
  ]
  for (name, es) in cases {
    let b = write_case(name, es)
    read_all(b)
  }

  // 写入不足、Flush、关闭后的行为
  var tw = tar.new_writer()
  let (w1, r1) = tw.write_header(tar.Header { size: 10, mod_time: t0, ..hd(0, "a") })
  print(errs(r1))
  let (w2, n2, e2) = w1.write_string("1234")
  print("{n2} " + errs_s(e2))
  let (w3, r3) = w2.flush()
  print(errs(r3))
  let (w4, r4) = w3.write_header(tar.Header { mod_time: t0, ..hd(0, "b") })
  print(errs(r4))
  let (w5, n5, e5) = w4.write_string("567890")
  print("{n5} " + errs_s(e5))
  let (w6, r6) = w5.flush()
  print(errs(r6))
  let (w7, r7) = w6.write_header(tar.Header { size: 3, mod_time: t0, ..hd(0, "c") })
  print(errs(r7))
  let (w8, r8) = w7.close()
  print(errs(r8))
  let (w9, r9) = w8.close()
  print(errs(r9))
  let (w10, r10) = w9.write_header(tar.Header { mod_time: t0, ..hd(0, "d") })
  print(errs(r10))
  let (w11, n11, e11) = w10.write_string("x")
  print("{n11} " + errs_s(e11))
  let (w12, r12) = w11.flush()
  print(errs(r12))
  let out1 = w12.bytes()
  print(digest(out1))
  let (w13, r13) = tar.new_writer().close()
  print(errs(r13) + " " + digest(out1 + w13.bytes()))

  // 分块读
  var cw = tar.new_writer()
  let (c1, _) = cw.write_header(tar.Header { size: 7, mod_time: t0, ..hd(0, "chunks") })
  let (c2, _, _) = c1.write_string("abcdefg")
  let (c3, _) = c2.write_header(tar.Header { size: 2, mod_time: t0, ..hd(0, "second") })
  let (c4, _, _) = c3.write_string("xy")
  let (c5, _) = c4.close()
  let b = c5.bytes()
  var tr = tar.new_reader(b)
  let (t1, h1) = tr.next()
  tr = t1
  print(unwrap(h1).name + " ok")
  for _ in 0..6 {
    let (t2, got, e) = tr.read(3)
    tr = t2
    print(strconv.quote_go(unwrap(__from_bytes(got))) + " " + errs_s(e))
  }
  let (t3, h2) = tr.next()
  tr = t3
  print(unwrap(h2).name + " ok")
  let (t4, got4, e4) = tr.read(1)
  tr = t4
  print(strconv.quote_go(unwrap(__from_bytes(got4))) + " " + errs_s(e4))
  let (t5, h5) = tr.next()
  tr = t5
  print(errs(map_unit(h5)))
  let (t6, h6) = tr.next()
  tr = t6
  print(errs(map_unit(h6)))
  let (t7, got7, e7) = tr.read(1)
  print("{len(got7)} " + errs_s(e7))
  for cut in [0, 100, 512, 513, 515, 519, 1024, 1030, 1536, 2048, 2560] {
    print("cut {cut}")
    read_all(b[..cut])
  }
  print("badsum")
  read_all(set(b, 148, b[148] ^ 1))
  print("zero-then-data")
  read_all([0; 512] + b)
  var bad2 = set(b, 124, 120)
  var s = 0
  for i in 0..512 { s += if i >= 148 && i < 156 { 32 } else { bad2[i] } }
  var oct = strconv.format_int(s, 8)
  while len(oct) < 6 { oct = "0" + oct }
  bad2 = bad2[..148] + __bytes(oct) + [0, 32] + bad2[156..]
  print("badsize")
  read_all(bad2)

  for (name, enc) in testdata() {
    print("file " + name)
    read_all(decode(enc))
    if __str_find(name, "sparse", 0) >= 0 { sparse_chunks(decode(enc)) }
  }
}

// 稀疏文件分块读每个条目的前 300 字节
fn sparse_chunks(b: List<Int>) {
  var tr = tar.new_reader(b)
  for _ in 0..20 {
    let (t1, res) = tr.next()
    tr = t1
    match res {
      Err(e) => {
        print("  chunk next: err " + e)
        return
      }
      Ok(h) => {
        var line = [h.name]
        for _ in 0..5 {
          let (t2, got, e) = tr.read(64)
          tr = t2
          line = push(line, "{len(got)}:" + hex8(crc32.checksum_bytes(got)) + ":" + errs_s(e))
          if e != "" { break }
        }
        print("  chunks: " + join(line, " "))
      }
    }
  }
}

fn map_unit(r: Result<tar.Header, Str>) -> Result<(), Str> {
  match r {
    Ok(_) => Ok(()),
    Err(e) => Err(e),
  }
}

// 由 Go 的 archive/tar/testdata 编码：两位十六进制一个字节，zN. 表示 N 个零字节
fn testdata() -> List<(Str, Str)> {
  [
