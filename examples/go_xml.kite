// 对拍 Go 的 encoding/xml：输出必须和 tests/go/xml.expected 逐字节相同（测试数据由生成脚本与 tests/go/xml.go 同步产出）
use std.encoding.xml
use std.strings

fn show(b: List<Int>) -> Str {
  var out = ""
  for c in b {
    if c == 92 {
      out = out + "\\\\"
    } else if c == 34 {
      out = out + "\\\""
    } else if c == 10 {
      out = out + "\\n"
    } else if c == 9 {
      out = out + "\\t"
    } else if c == 13 {
      out = out + "\\r"
    } else if c >= 32 && c < 127 {
      out = out + __chr(c)
    } else {
      let h = "0123456789abcdef"
      out = out + "\\x" + __str_slice(h, c / 16, c / 16 + 1) + __str_slice(h, c % 16, c % 16 + 1)
    }
  }
  "\"" + out + "\""
}

fn nm(n: xml.Name) -> Str { if n.space == "" { n.local } else { "\{" + n.space + "}" + n.local } }

fn tok_str(t: xml.Token) -> Str {
  match t {
    XStart(se) => {
      var s = "S <" + nm(se.name)
      for a in se.attr { s = s + " " + nm(a.name) + "=" + show(__bytes(a.value)) }
      s + ">"
    },
    XEnd(n)                 => "E </" + nm(n) + ">",
    XCharData(b)            => "C " + show(b),
    XComment(b)             => "M " + show(b),
    XProcInst(target, inst) => "P " + target + " " + show(inst),
    XDirective(b)           => "D " + show(b),
  }
}

fn err_str(e: xml.XmlError) -> Str { if e.kind == xml.EOF { "EOF" } else { "ERR " + show(__bytes(e.error())) } }

fn next(d: xml.Decoder, raw: Bool) -> (xml.Decoder, Result<xml.Token, xml.XmlError>) { if raw { d.raw_token() } else { d.token() } }

fn run_doc(d0: xml.Decoder, raw: Bool) {
  var d = d0
  var i = 0
  while i < 300 {
    let (d2, r) = next(d, raw)
    d = d2
    match r {
      Ok(t)  => { print("  " + tok_str(t)) },
      Err(e) => {
        print("  " + err_str(e))
        let (d3, r2) = next(d, raw)
        d = d3
        match r2 {
          Ok(_)   => { print("  again ?") },
          Err(e2) => { print("  again " + err_str(e2)) },
        }
        break
      },
    }
    i += 1
  }
  let (line, col) = d.input_pos()
  print("  pos {d.input_offset()} {line} {col}")
}

fn step(r: (xml.Encoder, Option<Str>)) -> xml.Encoder {
  let (e, err) = r
  match err {
    Some(m) => { print("  err " + show(__bytes(m)) + " {len(e.output_bytes())}") },
    None    => { print("  ok {len(e.output_bytes())}") },
  }
  e
}

fn latin1(charset: Str, b: List<Int>) -> Result<List<Int>, Str> {
  if !strings.equal_fold(charset, "latin1") { return Err("unsupported charset " + charset) }
  var out: List<Int> = []
  for c in b {
    if c < 128 { out = push(out, c) } else { out = out + [0xc0 | (c >> 6), 0x80 | (c & 0x3f)] }
  }
  Ok(out)
}

fn opt_el(o: Option<xml.Element>) -> Str {
  match o {
    Some(e) => "found " + nm(e.name) + " " + show(__bytes(e.text())),
    None    => "none",
  }
}

