  e_indent = step(e_indent.encode_token(xml.end(xml.name("", "c"))))
  e_indent = step(e_indent.encode_token(xml.comment("note")))
  e_indent = step(e_indent.encode_token(xml.start(xml.name("", "d"), [])))
  e_indent = step(e_indent.encode_token(xml.start(xml.name("", "e"), [])))
  e_indent = step(e_indent.encode_token(xml.end(xml.name("", "e"))))
  e_indent = step(e_indent.encode_token(xml.end(xml.name("", "d"))))
  e_indent = step(e_indent.encode_token(xml.end(xml.name("", "a"))))
  print("  out " + show(e_indent.flush().output_bytes()))
  print("enc prefix")
  var e_prefix = xml.new_encoder().indent(">>", "\t")
  e_prefix = step(e_prefix.encode_token(xml.start(xml.name("", "a"), [xml.attr(xml.name("", "x"), "1")])))
  e_prefix = step(e_prefix.encode_token(xml.start(xml.name("u", "b"), [])))
  e_prefix = step(e_prefix.encode_token(xml.end(xml.name("u", "b"))))
  e_prefix = step(e_prefix.encode_token(xml.end(xml.name("", "a"))))
  e_prefix = step(e_prefix.encode_token(xml.start(xml.name("", "z"), [])))
  e_prefix = step(e_prefix.encode_token(xml.end(xml.name("", "z"))))
  print("  out " + show(e_prefix.flush().output_bytes()))
  print("enc prefixonly")
  var e_prefixonly = xml.new_encoder().indent("#", "")
  e_prefixonly = step(e_prefixonly.encode_token(xml.start(xml.name("", "a"), [])))
  e_prefixonly = step(e_prefixonly.encode_token(xml.start(xml.name("", "b"), [])))
  e_prefixonly = step(e_prefixonly.encode_token(xml.end(xml.name("", "b"))))
  e_prefixonly = step(e_prefixonly.encode_token(xml.end(xml.name("", "a"))))
  print("  out " + show(e_prefixonly.flush().output_bytes()))
  print("enc xmlprocinst")
  var e_xmlprocinst = xml.new_encoder().indent("", "")
  e_xmlprocinst = step(e_xmlprocinst.encode_token(xml.proc_inst("xml", "Instruction")))
  e_xmlprocinst = step(e_xmlprocinst.encode_token(xml.proc_inst("Target", "Instruction")))
  e_xmlprocinst = step(e_xmlprocinst.encode_token(xml.proc_inst("xml", "Instruction")))
  e_xmlprocinst = step((e_xmlprocinst.flush(), None))
  e_xmlprocinst = step(e_xmlprocinst.encode_token(xml.proc_inst("xml", "again")))
  print("  out " + show(e_xmlprocinst.flush().output_bytes()))
  print("enc close")
  var e_close = xml.new_encoder().indent("", "")
  e_close = step(e_close.encode_token(xml.start(xml.name("", "a"), [])))
  e_close = step(e_close.close())
  e_close = step(e_close.encode_token(xml.char_data("x")))
  e_close = step(e_close.close())
  print("  out " + show(e_close.flush().output_bytes()))
  print("enc closeok")
  var e_closeok = xml.new_encoder().indent("", "")
  e_closeok = step(e_closeok.encode_token(xml.start(xml.name("", "a"), [])))
  e_closeok = step(e_closeok.encode_token(xml.end(xml.name("", "a"))))
  e_closeok = step(e_closeok.close())
  e_closeok = step(e_closeok.encode_token(xml.end(xml.name("", "a"))))
  e_closeok = step(e_closeok.encode_token(xml.start(xml.name("", "b"), [])))
  print("  out " + show(e_closeok.flush().output_bytes()))
  print("enc bigflush")
  var e_bigflush = xml.new_encoder().indent("", "")
  e_bigflush = step(e_bigflush.encode_token(xml.char_data("yyyyyyyyyy")))
  e_bigflush = step(e_bigflush.encode_token(xml.char_data(strings.repeat("x", 5000))))
  e_bigflush = step(e_bigflush.encode_token(xml.char_data(strings.repeat("z", 4090))))
  e_bigflush = step(e_bigflush.encode_token(xml.char_data("wwwwwwwwwwwwwwwwwwww")))
  e_bigflush = step(e_bigflush.encode_token(xml.proc_inst("xml", "late")))
  print("  out " + show(e_bigflush.flush().output_bytes()))
  print("enc bigdirect")
  var e_bigdirect = xml.new_encoder().indent("", "")
  e_bigdirect = step(e_bigdirect.encode_token(xml.char_data(strings.repeat("x", 5000))))
  e_bigdirect = step(e_bigdirect.encode_token(xml.proc_inst("xml", "ok")))
  e_bigdirect = step(e_bigdirect.encode_token(xml.start(xml.name("", "a"), [])))
  print("  out " + show(e_bigdirect.flush().output_bytes()))
  print("== roundtrip")
  var rd = xml.new_decoder(__bytes("\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\n  \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<body xmlns:foo=\"ns1\" xmlns=\"ns2\" xmlns:tag=\"ns3\" \r\n\t  >\n  <hello lang=\"en\">World &lt;&gt;&apos;&quot; &#x767d;&#40300;翔</hello>\n  <query>q</query>\n  <goodbye />\n  <outer foo:attr=\"value\" xmlns:tag=\"ns4\">\n    <inner/>\n  </outer>\n  <tag:name>\n    <![CDATA[Some text here.]]>\n  </tag:name>\n</body><!-- missing final newline -->"))
  var re = xml.new_encoder()
  loop {
    let (d2, r) = rd.token()
    rd = d2
    match r {
      Err(e) => {
        print("  " + err_str(e))
        break
      },
      Ok(t) => {
        let (e2, err) = re.encode_token(t)
        re = e2
        match err {
          Some(m) => { print("  enc " + m) },
          None    => {},
        }
      },
    }
  }
  print("  " + show(re.flush().output_bytes()))
  print("== escape")
  print("  " + show(xml.escape_text(__bytes(""))) + " " + show(xml.escape(__bytes(""))))
  print("  " + show(xml.escape_text(__bytes("plain"))) + " " + show(xml.escape(__bytes("plain"))))
  print("  " + show(xml.escape_text(__bytes("<a href=\"x\">&'</a>"))) + " " + show(xml.escape(__bytes("<a href=\"x\">&'</a>"))))
  print("  " + show(xml.escape_text(__bytes("\t\n\r"))) + " " + show(xml.escape(__bytes("\t\n\r"))))
  print("  " + show(xml.escape_text(__bytes("\u{0}\u{1}\u{1f}"))) + " " + show(xml.escape(__bytes("\u{0}\u{1}\u{1f}"))))
  print("  " + show(xml.escape_text(__bytes("퟿�\u{fffe}\u{ffff}"))) + " " + show(xml.escape(__bytes("퟿�\u{fffe}\u{ffff}"))))
  print("  " + show(xml.escape_text(__bytes("é😀"))) + " " + show(xml.escape(__bytes("é😀"))))
  print("  " + show(xml.escape_text([255])) + " " + show(xml.escape([255])))
  print("  " + show(xml.escape_text([97, 195])) + " " + show(xml.escape([97, 195])))
  print("  " + show(xml.escape_text([237, 160, 128])) + " " + show(xml.escape([237, 160, 128])))
  print("== tree")
  print("tree 0")
  match xml.parse("<root a='1'>hello <b>bold</b> world<!--c--><i x='y'/><![CDATA[cd&]]> end</root>") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 1")
  match xml.parse("<?xml version='1.0'?>\n<!-- pre -->\n<list xmlns='urn:x' xmlns:q='urn:q'>\n  <item q:id='1'>one</item>\n  <item q:id='2'>two &amp; more</item>\n</list>\n") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 2")
  match xml.parse("<a><b><c/></b></a>") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 3")
  match xml.parse("<a>unclosed") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 4")
  match xml.parse("<!-- only -->") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 5")
  match xml.parse("<a></b>") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 6")
  match xml.parse("<a/><b>second</b>") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("tree 7")
  match xml.parse("<x>&lt;tag&gt; \"q\" 'a'\ttab\nnl</x>") {
    Err(e) => { print("  error " + show(__bytes(e.error()))) },
    Ok(el) => {
      print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))))
      print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "", "  "), "?"))))
      print("  text " + show(__bytes(el.text())) + " kids {len(el.children)}")
      for k in ["b", "item", "c", "zz"] {
        print("  find " + k + " " + opt_el(el.find(k)))
        print("  all " + k + " {len(el.find_all(k))}")
      }
      for k in ["a", "x", "xmlns"] {
        let v = el.attr_value(k)
        print("  attr " + k + " " + (if is_some(v) { "true" } else { "false" }) + " " + show(__bytes(unwrap_or(v, ""))))
      }
    },
  }
  print("== build")
  let el = xml.element(xml.name("", "doc"), [xml.attr(xml.name("", "v"), "1 < 2")], [
    XElem(xml.element(xml.name("urn:a", "x"), [xml.attr(xml.name("urn:b", "y"), "q")], [XText("t&t")])),
    XComm(__bytes(" hi ")),
    XElem(xml.element(xml.name("", "empty"), [], [])),
    XText("tail"),
  ])
  print("  " + show(__bytes(unwrap_or(xml.marshal(el), "?"))) + " <nil>")
  print("  " + show(__bytes(unwrap_or(xml.marshal_indent(el, "> ", "\t"), "?"))) + " <nil>")
  match xml.marshal(xml.element(xml.name("", "a"), [], [XComm(__bytes("x-->"))])) {
    Ok(_)  => { print("?") },
    Err(m) => { print("  " + m) },
  }
  match xml.marshal(xml.element(xml.name("", ""), [], [])) {
    Ok(_)  => { print("?") },
    Err(m) => { print("  " + m) },
  }
}
