// 对齐 Go 1.27 的 uuid 包和 crypto/rand：tests/go/uuid.go
use std.uuid
use std.crypto.rand as crand
use std.math.big
use std.strconv

fn main() {
  for s in ["f81d4fae-7dec-11d0-a765-00a0c91e6bf6", "F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6", "\{f81d4fae-7dec-11d0-a765-00a0c91e6bf6}",
            "urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6", "URN:UUID:f81d4fae-7dec-11d0-a765-00a0c91e6bf6", "f81d4fae7dec11d0a76500a0c91e6bf6",
            "f81d4fae-7dec-11d0-a765-00a0c91e6bf", "f81d4fae-7dec-11d0-a765_00a0c91e6bf6", "g81d4fae-7dec-11d0-a765-00a0c91e6bf6",
            "(f81d4fae-7dec-11d0-a765-00a0c91e6bf6)", "\{f81d4fae-7dec-11d0-a765-00a0c91e6bf6", "", "00000000-0000-0000-0000-000000000000",
            "ffffffff-ffff-ffff-ffff-ffffffffffff", "f81d4fae7dec11d0a76500a0c91e6bfz", "+81d4fae-7dec-11d0-a765-00a0c91e6bf6",
            "f81d4fae-7dec-11d0-a765-00a0c91e6bf6 ", "xxxf81d4fae-7dec-11d0-a765-00a0c91e6bf6"] {
    match uuid.parse(s) {
      Ok(u) => print("{strconv.quote_go(s)} {u.string()} <nil>"),
      Err(e) => print("{strconv.quote_go(s)} {uuid.nil_uuid().string()} {e}"),
    }
  }
  let a = uuid.must_parse("00000000-0000-0000-0000-000000000001")
  let b = uuid.must_parse("00000000-0000-0000-0000-000000000002")
  print("{a.compare(b)} {b.compare(a)} {a.compare(a)} {a == a} {a == b} {uuid.nil_uuid().string()} {uuid.max_uuid().string()} {uuid.nil_uuid().compare(uuid.max_uuid())}")
  print(unwrap(__from_bytes(a.append_text(__bytes("id=")))))
  let v4 = uuid.new()
  let v7 = uuid.new_v7()
  print("{v4.version()} {v4.variant()} {v7.version()} {v7.variant()} {v4 != uuid.new_v4()}")
  var g = uuid.new_v7_gen()
  let (p0, g0) = g.next()
  var prev = p0
  g = g0
  var ok = true
  for _ in 0..200 {
    let (n, g2) = g.next()
    if prev.compare(n) >= 0 { ok = false }
    prev = n
    g = g2
  }
  print(ok)
  print("{len(crand.text())} 0")
  let m = big.new_int(1000)
  var ok_int = true
  for _ in 0..100 {
    let x = crand.int(m)
    if x.sign() < 0 || x.cmp(m) >= 0 { ok_int = false }
  }
  print(ok_int)
}
