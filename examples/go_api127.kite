// Go 1.27 新增 API：big.Int.Divide、strings/bytes.CutLast（tests/go/api127.go）
use std.math.big
use std.strings
use std.bytes
fn main() {
  for (x, y) in [
    (7, 2),
    (-7, 2),
    (7, -2),
    (-7, -2),
    (5, 2),
    (-5, 2),
    (6, 4),
    (-6, 4),
    (9, 3),
    (0, 5),
    (1, 3),
    (2, 3),
  ] {
    var line = "{x} {y}"
    for m in [big.TRUNC, big.FLOOR, big.ROUND, big.CEIL] {
      let (q, r) = big.new_int(x).divide(big.new_int(y), m)
      line = line + " {q.string()} {r.string()}"
    }
    print(line)
  }
  for (s, sep) in [("a/b/c", "/"), ("abc", "/"), ("xx--yy--zz", "--"), ("", ""), ("ab", "")] {
    match strings.cut_last(s, sep) {
      Some((a, b)) => print("[{a}] [{b}] true"),
      None => print("[{s}] [] false"),
    }
  }
  let (a, b, f) = bytes.cut_last([1, 2, 1, 3], [1])
  print(a, b, f)
}
