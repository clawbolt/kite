// 对拍 Go 的 net/http/cookiejar：输出必须和 tests/go/cookiejar.expected 逐字节相同
use std.net.http.cookiejar
use std.net.url
use std.time

type JarTest = {
  description: Str,
  from_url: Str,
  set_cookies: List<Str>,
  content: Str,
  queries: List<(Str, Str)>,
}

// 测试用的固定时间：2013-01-01 12:00:00 UTC
fn t_now() -> Int { time.date(2013, 1, 1, 12, 0, 0, 0) }

// 和 jar_test.go 的 testPSL 相同：只有 "co.uk" 和默认规则 "*"，外加两个故意的错误
fn test_psl(d: Str) -> Str {
  if d == "co.uk" || ends_with(d, ".co.uk") { return "co.uk" }
  if d == "www.buggy.psl" { return "xy" }
  if d == "www2.buggy.psl" { return "com" }
  let parts = split(d, ".")
  parts[len(parts) - 1]
}

fn psl() -> cookiejar.PublicSuffixList { cookiejar.public_suffix_list(test_psl, "testPSL") }

fn new_test_jar() -> cookiejar.Jar {
  cookiejar.new(cookiejar.Options { public_suffix_list: Some(psl()) })
}

fn expires_in(delta: Int) -> Str { "expires=" + time.format(t_now() + delta * 1000, time.RFC1123) }

fn must_parse_url(s: Str) -> url.URL {
  match url.parse(s) {
    Ok(u) => u,
    Err(e) => panic("Unable to parse URL {s}. {e}"),
  }
}

fn b(x: Bool) -> Str { if x { "true" } else { "false" } }

fn err_str<T>(r: Result<T, Str>) -> Str {
  match r {
    Ok(_) => "nil",
    Err(e) => e,
  }
}

fn show_cookies(cs: List<cookiejar.Cookie>) -> Str {
  "[" + join(map(cs, (c) => c.string()), " ") + "]"
}

fn run_test(test: JarTest, jar0: cookiejar.Jar) -> cookiejar.Jar {
  var now = t_now()
  print("== " + test.description)
  var set_cookies = []
  for cs in test.set_cookies {
    match cookiejar.parse_set_cookie(cs) {
      Ok(c) => { set_cookies = push(set_cookies, c) },
      Err(_) => { print("  bad cookie line: " + cs) },
    }
  }
  var jar = jar0.set_cookies_at(must_parse_url(test.from_url), set_cookies, now)
  now += 1001
  var cs = []
  for e in jar.entries() {
    if !(e.expires > now) { continue }
    var v = e.value
    if contains(v, " ") || contains(v, ",") || e.quoted { v = "\"" + v + "\"" }
    cs = push(cs, e.name + "=" + v)
  }
  let got = join(sort(cs), " ")
  print("  content: " + got + " ok=" + b(got == test.content))
  for (to_url, want) in test.queries {
    now += 1001
    let (res, j2) = jar.cookies_at(must_parse_url(to_url), now)
    jar = j2
    let g = join(map(res, (c) => c.string()), " ")
    print("  " + to_url + " -> " + g + " ok=" + b(g == want))
  }
  jar
}

fn run_fresh(tests: List<JarTest>) {
  for t in tests { run_test(t, new_test_jar()) }
}

fn run_shared(tests: List<JarTest>) {
  var jar = new_test_jar()
  for t in tests { jar = run_test(t, jar) }
}

fn dump_entries(jar: cookiejar.Jar) {
  for e in jar.entries() {
    print(
      "  {e.id()} value={e.value} quoted={b(e.quoted)} samesite={e.same_site} secure={b(e.secure)} httponly={b(e.http_only)} persistent={b(e.persistent)} hostonly={b(e.host_only)} expires={e.expires} creation={e.creation} lastaccess={e.last_access} seq={e.seq_num}",
    )
  }
}

fn opt_ms(t: Option<Int>) -> Str {
  match t {
    Some(x) => "{x}",
    None => "zero",
  }
}

fn show_parsed(c: cookiejar.Cookie) -> Str {
  "name=[{c.name}] value=[{c.value}] quoted={b(c.quoted)} path=[{c.path}] domain=[{c.domain}] expires={opt_ms(c.expires)} raw=[{c.raw_expires}] maxage={c.max_age} secure={b(c.secure)} httponly={b(c.http_only)} samesite={c.same_site} partitioned={b(c.partitioned)} unparsed=[" + join(
    c.unparsed,
    "|",
  ) + "]"
}

fn parse_lines(lines: List<Str>) -> List<cookiejar.Cookie> { cookiejar.read_set_cookies(lines) }

fn mk(name: Str, value: Str) -> cookiejar.Cookie { cookiejar.new_cookie(name, value) }

fn main() {
  print("# hasDotSuffix")
  for (s, suf) in has_dot_suffix_tests() {
    print("[{s}] [{suf}] {b(cookiejar.has_dot_suffix(s, suf))}")
  }
  print("# canonicalHost")
  for h in canonical_host_list() {
    let r = cookiejar.canonical_host(h)
    let got = match r {
      Ok(x) => x,
      Err(_) => "",
    }
    print("[{h}] -> [{got}] err={err_str(r)}")
  }
  print("# SplitHostPort")
  for h in [
    "a:1",
    "a",
    "[::1]:80",
    "[::1]",
    "[::1]x",
    "[::1]:80:",
    "a:b:c",
    "a[:1",
    "a]:1",
    "[a]]:1",
    "[a:1",
    ":80",
    "[]:",
  ] {
    let r = cookiejar.split_host_port(h)
    let (host, port) = match r {
      Ok(p) => p,
      Err(_) => ("", ""),
    }
    print("[{h}] -> [{host}] [{port}] err={err_str(r)}")
  }
  print("# hasPort")
  for h in has_port_list() { print("[{h}] {b(cookiejar.has_port(h))}") }
  print("# jarKey")
  for h in jar_key_list() {
    print("[{h}] psl=[{cookiejar.jar_key(h, Some(psl()))}] nil=[{cookiejar.jar_key(h, None)}]")
  }
  print("# isIP")
  for h in is_ip_list() { print("[{h}] {b(cookiejar.is_ip(h))}") }
  print("# defaultPath")
  for p in default_path_list() { print("[{p}] -> [{cookiejar.default_path(p)}]") }
  print("# domainAndType")
  let tj = new_test_jar()
  for (host, domain) in domain_and_type_tests() {
    let r = cookiejar.domain_and_type(tj, host, domain)
    let (d, ho) = match r {
      Ok(p) => p,
      Err(_) => ("", false),
    }
    print("[{host}] [{domain}] -> [{d}] {b(ho)} err={err_str(r)}")
  }
  let nj = cookiejar.new(cookiejar.options())
  for (host, domain) in [
    ("foo.bar.co.uk", ".co.uk"),
    ("www.example.com", "com"),
    ("x.com", "perché.com"),
    ("x.com", "x.com."),
    ("x.com", "X.COM"),
  ] {
    let r = cookiejar.domain_and_type(nj, host, domain)
    let (d, ho) = match r {
      Ok(p) => p,
      Err(_) => ("", false),
    }
    print("nil [{host}] [{domain}] -> [{d}] {b(ho)} err={err_str(r)}")
  }
  print("# punycode")
  for (s, want) in punycode_tests() {
    let r = cookiejar.encode("", s)
    let got = match r {
      Ok(x) => x,
      Err(_) => "",
    }
    print("[{got}] ok={b(got == want)} err={err_str(r)}")
  }
  for s in [
    "golang",
    "bücher.example.com",
    "www.bücher.de",
    "日本語.jp",
    "a.ü.b",
    "",
    "Hello世界.com",
    "ÜBER.de",
  ] {
    let r = cookiejar.to_ascii(s)
    let got = match r {
      Ok(x) => x,
      Err(_) => "",
    }
    print("toASCII [{s}] -> [{got}] err={err_str(r)}")
  }

  print("# basics")
  run_fresh(basics_tests())
  print("# updateAndDelete")
  run_shared(update_and_delete_tests())
  print("# expiration")
  run_test(
    JarTest {
      description: "Expiration.",
      from_url: "http://www.host.test",
      set_cookies: [
        "a=1",
        "b=2; max-age=3",
        "c=3; " + expires_in(3),
        "d=4; max-age=5",
        "e=5; " + expires_in(5),
        "f=6; max-age=100",
      ],
      content: "a=1 b=2 c=3 d=4 e=5 f=6",
      queries: [
        ("http://www.host.test", "a=1 b=2 c=3 d=4 e=5 f=6"),
        ("http://www.host.test", "a=1 d=4 e=5 f=6"),
        ("http://www.host.test", "a=1 d=4 e=5 f=6"),
        ("http://www.host.test", "a=1 f=6"),
        ("http://www.host.test", "a=1 f=6"),
      ],
    },
    new_test_jar(),
  )
  print("# chromiumBasics")
  run_fresh(chromium_basics_tests())
  print("# chromiumDomain")
  run_shared(chromium_domain_tests())
  print("# chromiumDeletion")
  run_shared(chromium_deletion_tests())
  print("# domainHandling")
  run_fresh(domain_handling_tests())

  print("# issue19384")
  let cookies = [mk("name", "value")]
  for host in ["", ".", "..", "..."] {
    let jar = cookiejar.new(cookiejar.options())
    let u = url.URL {
      scheme: "http",
      opaque: "",
      user: None,
      password: None,
      host: host,
      path: "/",
      raw_query: "",
      fragment: "",
    }
    let before = show_cookies(jar.cookies(u))
    let jar2 = jar.set_cookies(u, cookies)
    print("[{host}] before={before} after={show_cookies(jar2.cookies(u))}")
  }

  print("# nil PSL")
  let pj = cookiejar
    .new(cookiejar.options())
    .set_cookies_at(
      must_parse_url("http://www.bbc.co.uk/"),
      parse_lines(["a=1; domain=co.uk", "b=2"]),
      t_now(),
    )
  for q in ["http://other.co.uk/", "http://www.bbc.co.uk/x", "http://co.uk/", "http://uk/"] {
    let (cs, _) = pj.cookies_at(must_parse_url(q), t_now())
    print("  " + q + " -> " + show_cookies(cs))
  }

  print("# entries")
  let u = must_parse_url("http://www.host.test/dir/page")
  var jar = new_test_jar().set_cookies_at(
    u,
    parse_lines([
      "a=1; SameSite=Lax; Secure",
      "b=2; samesite=strict; HttpOnly; max-age=60",
      "c=3; SameSite",
      "d=4; samesite=none",
      "e=\"q v\"; Path=/p; Domain=.host.test; Expires=Tue, 01 Jan 2013 13:00:00 GMT",
      "f=6; samesite=bogus",
      "x=1; max-age=2",
    ]),
    t_now(),
  )
  dump_entries(jar)
  let (q1, j1) = jar.cookies_at(must_parse_url("https://www.host.test/dir/x"), t_now() + 5000)
  jar = j1
  print("  query " + show_cookies(q1))
  dump_entries(jar)
  jar = jar.set_cookies_at(
    u,
    parse_lines(["a=changed", "x=again", "g=7; expires=Tue, 01 Jan 2013 11:00:00 GMT"]),
    t_now() + 10000,
  )
  dump_entries(jar)
  let (q2, j2) = jar.cookies_at(must_parse_url("https://www.host.test/dir/x"), t_now() + 61000)
  jar = j2
  print("  query " + show_cookies(q2))
  dump_entries(jar)
  jar = jar.set_cookies_at(must_parse_url("ftp://www.host.test/"), parse_lines(["z=1"]), t_now())
  let bad = url.URL {
    scheme: "http",
    opaque: "",
    user: None,
    password: None,
    host: "[bad",
    path: "/",
    raw_query: "",
    fragment: "",
  }
  jar = jar.set_cookies_at(bad, parse_lines(["z=1"]), t_now())
  jar = jar.set_cookies_at(u, [], t_now())
  dump_entries(jar)

  print("# ParseSetCookie")
  for l in parse_set_cookie_lines() {
    match cookiejar.parse_set_cookie(l) {
      Ok(c) => { print("[{l}] " + show_parsed(c)) },
      Err(e) => { print("[{l}] err={e}") },
    }
  }
  print("# Cookie.String")
  let exp = time.date(2013, 1, 2, 3, 4, 5, 0)
  for c in [
    mk("a", "b"),
    mk("a", "b c"),
    mk("a", "b,c"),
    cookiejar.Cookie { quoted: true, ..mk("a", "x") },
    mk("a", ""),
    mk("a b", "x"),
    mk("", "x"),
    cookiejar.Cookie {
      path: "/p",
      domain: ".example.com",
      expires: Some(exp),
      max_age: 10,
      http_only: true,
      secure: true,
      same_site: cookiejar.SAME_SITE_LAX_MODE,
      partitioned: true,
      ..mk("full", "v")
    },
    cookiejar.Cookie { max_age: -1, same_site: cookiejar.SAME_SITE_NONE_MODE, ..mk("neg", "v") },
    cookiejar.Cookie {
      same_site: cookiejar.SAME_SITE_STRICT_MODE,
      domain: "1.2.3.4",
      ..mk("s", "v")
    },
    cookiejar.Cookie {
      same_site: cookiejar.SAME_SITE_DEFAULT_MODE,
      domain: "example.com",
      ..mk("d", "v")
    },
    cookiejar.Cookie { expires: Some(time.date(1600, 12, 31, 0, 0, 0, 0)), ..mk("old", "v") },
    cookiejar.Cookie { expires: Some(time.date(1601, 1, 1, 0, 0, 0, 0)), ..mk("y1601", "v") },
  ] {
    print("[{c.string()}]")
  }
}

