fn parse_set_cookie_lines() -> List<Str> {
  [
    "",
    "   ",
    "noequal",
    "a b=1",
    "=v",
    "n=bad\\val",
    "n=\"x\"",
    "n=\"",
    "n=\"a b\"",
    "ü=1",
    "n=v; Max-Age=0",
    "n=v; max-age=05",
    "n=v; max-age=-3",
    "n=v; max-age=abc",
    "n=v; max-age=+7",
    "n=v; max-age=3600",
    "n=v; Expires=Wed, 09 Jun 2021 10:18:14 GMT",
    "n=v; expires=Wed, 09-Jun-2021 10:18:14 GMT",
    "n=v; expires=Mon, 09 Jun 2021 10:18:14 UTC",
    "n=v; expires=bogus",
    "n=v; expires=Wed, 31 Feb 2021 10:18:14 GMT",
    "n=v; expires=Wed, 09 Jun 2021 24:18:14 GMT",
    "n=v; Partitioned; foo=bar; wéird=1",
    "n=v; path=/x; path=/y",
    "n=v; domain=a\"b",
    " n = v ; secure",
    "n=v;;  ; HTTPONLY",
    "n=v; SameSite=Lax",
    "n=v; samesite=STRICT",
    "n=v; samesite=None",
    "n=v; samesite",
    "n=v; samesite=bogus",
    "n=v; samesite=lâx",
    "n=v; Domain=.Example.COM; Path=/a/b",
  ]
}

fn basics_tests() -> List<JarTest> {
  [
    JarTest {
      description: "Retrieval of a plain host cookie.",
      from_url: "http://www.host.test/",
      set_cookies: ["A=a"],
      content: "A=a",
      queries: [
        ("http://www.host.test", "A=a"),
        ("http://www.host.test/", "A=a"),
        ("http://www.host.test/some/path", "A=a"),
        ("https://www.host.test", "A=a"),
        ("https://www.host.test/", "A=a"),
        ("https://www.host.test/some/path", "A=a"),
        ("ftp://www.host.test", ""),
        ("ftp://www.host.test/", ""),
        ("ftp://www.host.test/some/path", ""),
        ("http://www.other.org", ""),
        ("http://sibling.host.test", ""),
        ("http://deep.www.host.test", ""),
      ],
    },
    JarTest {
      description: "Secure cookies are not returned to http.",
      from_url: "http://www.host.test/",
      set_cookies: ["A=a; secure"],
      content: "A=a",
      queries: [
        ("http://www.host.test", ""),
        ("http://www.host.test/", ""),
        ("http://www.host.test/some/path", ""),
        ("https://www.host.test", "A=a"),
        ("https://www.host.test/", "A=a"),
        ("https://www.host.test/some/path", "A=a"),
      ],
    },
    JarTest {
      description: "Secure cookies are sent for localhost",
      from_url: "http://localhost:8910/",
      set_cookies: ["A=a; secure"],
      content: "A=a",
      queries: [
        ("http://localhost:8910", "A=a"),
        ("http://localhost:8910/", "A=a"),
        ("http://localhost:8910/some/path", "A=a"),
        ("https://localhost:8910", "A=a"),
        ("https://localhost:8910/", "A=a"),
        ("https://localhost:8910/some/path", "A=a"),
      ],
    },
    JarTest {
      description: "Secure cookies are sent for localhost (tld)",
      from_url: "http://example.LOCALHOST:8910/",
      set_cookies: ["A=a; secure"],
      content: "A=a",
      queries: [
        ("http://example.LOCALHOST:8910", "A=a"),
        ("http://example.LOCALHOST:8910/", "A=a"),
        ("http://example.LOCALHOST:8910/some/path", "A=a"),
        ("https://example.LOCALHOST:8910", "A=a"),
        ("https://example.LOCALHOST:8910/", "A=a"),
        ("https://example.LOCALHOST:8910/some/path", "A=a"),
      ],
    },
    JarTest {
      description: "Secure cookies are sent for localhost (ipv6)",
      from_url: "http://[::1]:8910/",
      set_cookies: ["A=a; secure"],
      content: "A=a",
      queries: [
        ("http://[::1]:8910", "A=a"),
        ("http://[::1]:8910/", "A=a"),
        ("http://[::1]:8910/some/path", "A=a"),
        ("https://[::1]:8910", "A=a"),
        ("https://[::1]:8910/", "A=a"),
        ("https://[::1]:8910/some/path", "A=a"),
      ],
    },
    JarTest {
      description: "Localhost only if it's a segment",
      from_url: "http://notlocalhost/",
      set_cookies: ["A=a; secure"],
      content: "A=a",
      queries: [
        ("http://notlocalhost", ""),
        ("http://notlocalhost/", ""),
        ("http://notlocalhost/some/path", ""),
        ("https://notlocalhost", "A=a"),
        ("https://notlocalhost/", "A=a"),
        ("https://notlocalhost/some/path", "A=a"),
      ],
    },
    JarTest {
      description: "Explicit path.",
      from_url: "http://www.host.test/",
      set_cookies: ["A=a; path=/some/path"],
      content: "A=a",
      queries: [
        ("http://www.host.test", ""),
        ("http://www.host.test/", ""),
        ("http://www.host.test/some", ""),
        ("http://www.host.test/some/", ""),
        ("http://www.host.test/some/path", "A=a"),
        ("http://www.host.test/some/paths", ""),
        ("http://www.host.test/some/path/foo", "A=a"),
        ("http://www.host.test/some/path/foo/", "A=a"),
      ],
    },
    JarTest {
      description: "Implicit path #1: path is a directory.",
      from_url: "http://www.host.test/some/path/",
      set_cookies: ["A=a"],
      content: "A=a",
      queries: [
        ("http://www.host.test", ""),
        ("http://www.host.test/", ""),
        ("http://www.host.test/some", ""),
        ("http://www.host.test/some/", ""),
        ("http://www.host.test/some/path", "A=a"),
        ("http://www.host.test/some/paths", ""),
        ("http://www.host.test/some/path/foo", "A=a"),
        ("http://www.host.test/some/path/foo/", "A=a"),
      ],
    },
    JarTest {
      description: "Implicit path #2: path is not a directory.",
      from_url: "http://www.host.test/some/path/index.html",
      set_cookies: ["A=a"],
      content: "A=a",
      queries: [
        ("http://www.host.test", ""),
        ("http://www.host.test/", ""),
        ("http://www.host.test/some", ""),
        ("http://www.host.test/some/", ""),
        ("http://www.host.test/some/path", "A=a"),
        ("http://www.host.test/some/paths", ""),
        ("http://www.host.test/some/path/foo", "A=a"),
        ("http://www.host.test/some/path/foo/", "A=a"),
      ],
    },
    JarTest {
      description: "Implicit path #3: no path in URL at all.",
      from_url: "http://www.host.test",
      set_cookies: ["A=a"],
      content: "A=a",
      queries: [
        ("http://www.host.test", "A=a"),
        ("http://www.host.test/", "A=a"),
        ("http://www.host.test/some/path", "A=a"),
      ],
    },
    JarTest {
      description: "Cookies are sorted by path length.",
      from_url: "http://www.host.test/",
      set_cookies: [
        "A=a; path=/foo/bar",
        "B=b; path=/foo/bar/baz/qux",
        "C=c; path=/foo/bar/baz",
        "D=d; path=/foo",
      ],
      content: "A=a B=b C=c D=d",
      queries: [
        ("http://www.host.test/foo/bar/baz/qux", "B=b C=c A=a D=d"),
        ("http://www.host.test/foo/bar/baz/", "C=c A=a D=d"),
        ("http://www.host.test/foo/bar", "A=a D=d"),
      ],
    },
    JarTest {
      description: "Creation time determines sorting on same length paths.",
      from_url: "http://www.host.test/",
      set_cookies: [
        "A=a; path=/foo/bar",
        "X=x; path=/foo/bar",
        "Y=y; path=/foo/bar/baz/qux",
        "B=b; path=/foo/bar/baz/qux",
        "C=c; path=/foo/bar/baz",
        "W=w; path=/foo/bar/baz",
        "Z=z; path=/foo",
        "D=d; path=/foo",
      ],
      content: "A=a B=b C=c D=d W=w X=x Y=y Z=z",
      queries: [
        ("http://www.host.test/foo/bar/baz/qux", "Y=y B=b C=c W=w A=a X=x Z=z D=d"),
        ("http://www.host.test/foo/bar/baz/", "C=c W=w A=a X=x Z=z D=d"),
        ("http://www.host.test/foo/bar", "A=a X=x Z=z D=d"),
      ],
    },
    JarTest {
      description: "Sorting of same-name cookies.",
      from_url: "http://www.host.test/",
      set_cookies: [
        "A=1; path=/",
        "A=2; path=/path",
        "A=3; path=/quux",
        "A=4; path=/path/foo",
        "A=5; domain=.host.test; path=/path",
        "A=6; domain=.host.test; path=/quux",
        "A=7; domain=.host.test; path=/path/foo",
      ],
      content: "A=1 A=2 A=3 A=4 A=5 A=6 A=7",
      queries: [
        ("http://www.host.test/path", "A=2 A=5 A=1"),
        ("http://www.host.test/path/foo", "A=4 A=7 A=2 A=5 A=1"),
      ],
    },
    JarTest {
      description: "Disallow domain cookie on public suffix.",
      from_url: "http://www.bbc.co.uk",
      set_cookies: ["a=1", "b=2; domain=co.uk"],
      content: "a=1",
      queries: [
        ("http://www.bbc.co.uk", "a=1"),
      ],
    },
    JarTest {
      description: "Host cookie on IP.",
      from_url: "http://192.168.0.10",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://192.168.0.10", "a=1"),
      ],
    },
    JarTest {
      description: "Domain cookies on IP.",
      from_url: "http://192.168.0.10",
      set_cookies: [
        "a=1; domain=192.168.0.10",
        "b=2; domain=172.31.9.9",
        "c=3; domain=.192.168.0.10",
      ],
      content: "a=1",
      queries: [
        ("http://192.168.0.10", "a=1"),
        ("http://172.31.9.9", ""),
        ("http://www.fancy.192.168.0.10", ""),
      ],
    },
    JarTest {
      description: "Port is ignored #1.",
      from_url: "http://www.host.test/",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://www.host.test", "a=1"),
        ("http://www.host.test:8080/", "a=1"),
      ],
    },
    JarTest {
      description: "Port is ignored #2.",
      from_url: "http://www.host.test:8080/",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://www.host.test", "a=1"),
        ("http://www.host.test:8080/", "a=1"),
        ("http://www.host.test:1234/", "a=1"),
      ],
    },
    JarTest {
      description: "IPv6 zone is not treated as a host.",
      from_url: "https://example.com/",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("https://[::1%25.example.com]:80/", ""),
      ],
    },
    JarTest {
      description: "Retrieval of cookies with quoted values",
      from_url: "http://www.host.test/",
      set_cookies: [
        "cookie-1=\"quoted\"",
        "cookie-2=\"quoted with spaces\"",
        "cookie-3=\"quoted,with,commas\"",
        "cookie-4= ,",
      ],
      content: "cookie-1=\"quoted\" cookie-2=\"quoted with spaces\" cookie-3=\"quoted,with,commas\" cookie-4=\" ,\"",
      queries: [
        (
          "http://www.host.test",
          "cookie-1=\"quoted\" cookie-2=\"quoted with spaces\" cookie-3=\"quoted,with,commas\" cookie-4=\" ,\"",
        ),
      ],
    },
  ]
}

fn update_and_delete_tests() -> List<JarTest> {
  [
    JarTest {
      description: "Set initial cookies.",
      from_url: "http://www.host.test",
      set_cookies: ["a=1", "b=2; secure", "c=3; httponly", "d=4; secure; httponly"],
      content: "a=1 b=2 c=3 d=4",
      queries: [
        ("http://www.host.test", "a=1 c=3"),
        ("https://www.host.test", "a=1 b=2 c=3 d=4"),
      ],
    },
    JarTest {
      description: "Update value via http.",
      from_url: "http://www.host.test",
      set_cookies: ["a=w", "b=x; secure", "c=y; httponly", "d=z; secure; httponly"],
      content: "a=w b=x c=y d=z",
      queries: [
        ("http://www.host.test", "a=w c=y"),
        ("https://www.host.test", "a=w b=x c=y d=z"),
      ],
    },
    JarTest {
      description: "Clear Secure flag from an http.",
      from_url: "http://www.host.test/",
      set_cookies: ["b=xx", "d=zz; httponly"],
      content: "a=w b=xx c=y d=zz",
      queries: [
        ("http://www.host.test", "a=w b=xx c=y d=zz"),
      ],
    },
    JarTest {
      description: "Delete all.",
      from_url: "http://www.host.test/",
      set_cookies: [
        "a=1; max-Age=-1",
        "b=2; expires=Tue, 01 Jan 2013 11:59:50 UTC",
        "c=2; max-age=-1; expires=Tue, 01 Jan 2013 11:59:50 UTC",
        "d=4; max-age=-1; expires=Tue, 01 Jan 2013 12:00:10 UTC",
      ],
      content: "",
      queries: [
        ("http://www.host.test", ""),
      ],
    },
    JarTest {
      description: "Refill #1.",
      from_url: "http://www.host.test",
      set_cookies: [
        "A=1",
        "A=2; path=/foo",
        "A=3; domain=.host.test",
        "A=4; path=/foo; domain=.host.test",
      ],
      content: "A=1 A=2 A=3 A=4",
      queries: [
        ("http://www.host.test/foo", "A=2 A=4 A=1 A=3"),
      ],
    },
    JarTest {
      description: "Refill #2.",
      from_url: "http://www.google.com",
      set_cookies: [
        "A=6",
        "A=7; path=/foo",
        "A=8; domain=.google.com",
        "A=9; path=/foo; domain=.google.com",
      ],
      content: "A=1 A=2 A=3 A=4 A=6 A=7 A=8 A=9",
      queries: [
        ("http://www.host.test/foo", "A=2 A=4 A=1 A=3"),
        ("http://www.google.com/foo", "A=7 A=9 A=6 A=8"),
      ],
    },
    JarTest {
      description: "Delete A7.",
      from_url: "http://www.google.com",
      set_cookies: ["A=; path=/foo; max-age=-1"],
      content: "A=1 A=2 A=3 A=4 A=6 A=8 A=9",
      queries: [
        ("http://www.host.test/foo", "A=2 A=4 A=1 A=3"),
        ("http://www.google.com/foo", "A=9 A=6 A=8"),
      ],
    },
    JarTest {
      description: "Delete A4.",
      from_url: "http://www.host.test",
      set_cookies: ["A=; path=/foo; domain=host.test; max-age=-1"],
      content: "A=1 A=2 A=3 A=6 A=8 A=9",
      queries: [
        ("http://www.host.test/foo", "A=2 A=1 A=3"),
        ("http://www.google.com/foo", "A=9 A=6 A=8"),
      ],
    },
    JarTest {
      description: "Delete A6.",
      from_url: "http://www.google.com",
      set_cookies: ["A=; max-age=-1"],
      content: "A=1 A=2 A=3 A=8 A=9",
      queries: [
        ("http://www.host.test/foo", "A=2 A=1 A=3"),
        ("http://www.google.com/foo", "A=9 A=8"),
      ],
    },
    JarTest {
      description: "Delete A3.",
      from_url: "http://www.host.test",
      set_cookies: ["A=; domain=host.test; max-age=-1"],
      content: "A=1 A=2 A=8 A=9",
      queries: [
        ("http://www.host.test/foo", "A=2 A=1"),
        ("http://www.google.com/foo", "A=9 A=8"),
      ],
    },
    JarTest {
      description: "No cross-domain delete.",
      from_url: "http://www.host.test",
      set_cookies: [
        "A=; domain=google.com; max-age=-1",
        "A=; path=/foo; domain=google.com; max-age=-1",
      ],
      content: "A=1 A=2 A=8 A=9",
      queries: [
        ("http://www.host.test/foo", "A=2 A=1"),
        ("http://www.google.com/foo", "A=9 A=8"),
      ],
    },
    JarTest {
      description: "Delete A8 and A9.",
      from_url: "http://www.google.com",
      set_cookies: [
        "A=; domain=google.com; max-age=-1",
        "A=; path=/foo; domain=google.com; max-age=-1",
      ],
      content: "A=1 A=2",
      queries: [
        ("http://www.host.test/foo", "A=2 A=1"),
        ("http://www.google.com/foo", ""),
      ],
    },
  ]
}

fn chromium_basics_tests() -> List<JarTest> {
  [
    JarTest {
      description: "DomainWithTrailingDotTest.",
      from_url: "http://www.google.com/",
      set_cookies: ["a=1; domain=.www.google.com.", "b=2; domain=.www.google.com.."],
      content: "",
      queries: [
        ("http://www.google.com", ""),
      ],
    },
    JarTest {
      description: "ValidSubdomainTest #1.",
      from_url: "http://a.b.c.d.com",
      set_cookies: [
        "a=1; domain=.a.b.c.d.com",
        "b=2; domain=.b.c.d.com",
        "c=3; domain=.c.d.com",
        "d=4; domain=.d.com",
      ],
      content: "a=1 b=2 c=3 d=4",
      queries: [
        ("http://a.b.c.d.com", "a=1 b=2 c=3 d=4"),
        ("http://b.c.d.com", "b=2 c=3 d=4"),
        ("http://c.d.com", "c=3 d=4"),
        ("http://d.com", "d=4"),
      ],
    },
    JarTest {
      description: "ValidSubdomainTest #2.",
      from_url: "http://a.b.c.d.com",
      set_cookies: [
        "a=1; domain=.a.b.c.d.com",
        "b=2; domain=.b.c.d.com",
        "c=3; domain=.c.d.com",
        "d=4; domain=.d.com",
        "X=bcd; domain=.b.c.d.com",
        "X=cd; domain=.c.d.com",
      ],
      content: "X=bcd X=cd a=1 b=2 c=3 d=4",
      queries: [
        ("http://b.c.d.com", "b=2 c=3 d=4 X=bcd X=cd"),
        ("http://c.d.com", "c=3 d=4 X=cd"),
      ],
    },
    JarTest {
      description: "InvalidDomainTest #1.",
      from_url: "http://foo.bar.com",
      set_cookies: [
        "a=1; domain=.yo.foo.bar.com",
        "b=2; domain=.foo.com",
        "c=3; domain=.bar.foo.com",
        "d=4; domain=.foo.bar.com.net",
        "e=5; domain=ar.com",
        "f=6; domain=.",
        "g=7; domain=/",
        "h=8; domain=http://foo.bar.com",
        "i=9; domain=..foo.bar.com",
        "j=10; domain=..bar.com",
        "k=11; domain=.foo.bar.com?blah",
        "l=12; domain=.foo.bar.com/blah",
        "m=12; domain=.foo.bar.com:80",
        "n=14; domain=.foo.bar.com:",
        "o=15; domain=.foo.bar.com#sup",
      ],
      content: "",
      queries: [
        ("http://foo.bar.com", ""),
      ],
    },
    JarTest {
      description: "InvalidDomainTest #2.",
      from_url: "http://foo.com.com",
      set_cookies: ["a=1; domain=.foo.com.com.com"],
      content: "",
      queries: [
        ("http://foo.bar.com", ""),
      ],
    },
    JarTest {
      description: "DomainWithoutLeadingDotTest #1.",
      from_url: "http://manage.hosted.filefront.com",
      set_cookies: ["a=1; domain=filefront.com"],
      content: "a=1",
      queries: [
        ("http://www.filefront.com", "a=1"),
      ],
    },
    JarTest {
      description: "DomainWithoutLeadingDotTest #2.",
      from_url: "http://www.google.com",
      set_cookies: ["a=1; domain=www.google.com"],
      content: "a=1",
      queries: [
        ("http://www.google.com", "a=1"),
        ("http://sub.www.google.com", "a=1"),
        ("http://something-else.com", ""),
      ],
    },
    JarTest {
      description: "CaseInsensitiveDomainTest.",
      from_url: "http://www.google.com",
      set_cookies: ["a=1; domain=.GOOGLE.COM", "b=2; domain=.www.gOOgLE.coM"],
      content: "a=1 b=2",
      queries: [
        ("http://www.google.com", "a=1 b=2"),
      ],
    },
    JarTest {
      description: "TestIpAddress #1.",
      from_url: "http://1.2.3.4/foo",
      set_cookies: ["a=1; path=/"],
      content: "a=1",
      queries: [
        ("http://1.2.3.4/foo", "a=1"),
      ],
    },
    JarTest {
      description: "TestIpAddress #2.",
      from_url: "http://1.2.3.4/foo",
      set_cookies: ["a=1; domain=.1.2.3.4", "b=2; domain=.3.4"],
      content: "",
      queries: [
        ("http://1.2.3.4/foo", ""),
      ],
    },
    JarTest {
      description: "TestIpAddress #3.",
      from_url: "http://1.2.3.4/foo",
      set_cookies: ["a=1; domain=1.2.3.3"],
      content: "",
      queries: [
        ("http://1.2.3.4/foo", ""),
      ],
    },
    JarTest {
      description: "TestIpAddress #4.",
      from_url: "http://1.2.3.4/foo",
      set_cookies: ["a=1; domain=1.2.3.4"],
      content: "a=1",
      queries: [
        ("http://1.2.3.4/foo", "a=1"),
      ],
    },
    JarTest {
      description: "TestNonDottedAndTLD #2.",
      from_url: "http://com./index.html",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://com./index.html", "a=1"),
        ("http://no-cookies.com./index.html", ""),
      ],
    },
    JarTest {
      description: "TestNonDottedAndTLD #3.",
      from_url: "http://a.b",
      set_cookies: ["a=1; domain=.b", "b=2; domain=b"],
      content: "",
      queries: [
        ("http://bar.foo", ""),
      ],
    },
    JarTest {
      description: "TestNonDottedAndTLD #4.",
      from_url: "http://google.com",
      set_cookies: ["a=1; domain=.com", "b=2; domain=com"],
      content: "",
      queries: [
        ("http://google.com", ""),
      ],
    },
    JarTest {
      description: "TestNonDottedAndTLD #5.",
      from_url: "http://google.co.uk",
      set_cookies: ["a=1; domain=.co.uk", "b=2; domain=.uk"],
      content: "",
      queries: [
        ("http://google.co.uk", ""),
        ("http://else.co.com", ""),
        ("http://else.uk", ""),
      ],
    },
    JarTest {
      description: "TestHostEndsWithDot.",
      from_url: "http://www.google.com",
      set_cookies: ["a=1", "b=2; domain=.www.google.com."],
      content: "a=1",
      queries: [
        ("http://www.google.com", "a=1"),
      ],
    },
    JarTest {
      description: "PathTest",
      from_url: "http://www.google.izzle",
      set_cookies: ["a=1; path=/wee"],
      content: "a=1",
      queries: [
        ("http://www.google.izzle/wee", "a=1"),
        ("http://www.google.izzle/wee/", "a=1"),
        ("http://www.google.izzle/wee/war", "a=1"),
        ("http://www.google.izzle/wee/war/more/more", "a=1"),
        ("http://www.google.izzle/weehee", ""),
        ("http://www.google.izzle/", ""),
      ],
    },
  ]
}

fn chromium_domain_tests() -> List<JarTest> {
  [
    JarTest {
      description: "Fill #1.",
      from_url: "http://www.google.izzle",
      set_cookies: ["A=B"],
      content: "A=B",
      queries: [
        ("http://www.google.izzle", "A=B"),
      ],
    },
    JarTest {
      description: "Fill #2.",
      from_url: "http://www.google.izzle",
      set_cookies: ["C=D; domain=.google.izzle"],
      content: "A=B C=D",
      queries: [
        ("http://www.google.izzle", "A=B C=D"),
      ],
    },
    JarTest {
      description: "Verify A is a host cookie and not accessible from subdomain.",
      from_url: "http://unused.nil",
      set_cookies: [],
      content: "A=B C=D",
      queries: [
        ("http://foo.www.google.izzle", "C=D"),
      ],
    },
    JarTest {
      description: "Verify domain cookies are found on proper domain.",
      from_url: "http://www.google.izzle",
      set_cookies: ["E=F; domain=.www.google.izzle"],
      content: "A=B C=D E=F",
      queries: [
        ("http://www.google.izzle", "A=B C=D E=F"),
      ],
    },
    JarTest {
      description: "Leading dots in domain attributes are optional.",
      from_url: "http://www.google.izzle",
      set_cookies: ["G=H; domain=www.google.izzle"],
      content: "A=B C=D E=F G=H",
      queries: [
        ("http://www.google.izzle", "A=B C=D E=F G=H"),
      ],
    },
    JarTest {
      description: "Verify domain enforcement works #1.",
      from_url: "http://www.google.izzle",
      set_cookies: ["K=L; domain=.bar.www.google.izzle"],
      content: "A=B C=D E=F G=H",
      queries: [
        ("http://bar.www.google.izzle", "C=D E=F G=H"),
      ],
    },
    JarTest {
      description: "Verify domain enforcement works #2.",
      from_url: "http://unused.nil",
      set_cookies: [],
      content: "A=B C=D E=F G=H",
      queries: [
        ("http://www.google.izzle", "A=B C=D E=F G=H"),
      ],
    },
  ]
}

fn chromium_deletion_tests() -> List<JarTest> {
  [
    JarTest {
      description: "Create session cookie a1.",
      from_url: "http://www.google.com",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://www.google.com", "a=1"),
      ],
    },
    JarTest {
      description: "Delete sc a1 via MaxAge.",
      from_url: "http://www.google.com",
      set_cookies: ["a=1; max-age=-1"],
      content: "",
      queries: [
        ("http://www.google.com", ""),
      ],
    },
    JarTest {
      description: "Create session cookie b2.",
      from_url: "http://www.google.com",
      set_cookies: ["b=2"],
      content: "b=2",
      queries: [
        ("http://www.google.com", "b=2"),
      ],
    },
    JarTest {
      description: "Delete sc b2 via Expires.",
      from_url: "http://www.google.com",
      set_cookies: ["b=2; expires=Tue, 01 Jan 2013 11:59:50 UTC"],
      content: "",
      queries: [
        ("http://www.google.com", ""),
      ],
    },
    JarTest {
      description: "Create persistent cookie c3.",
      from_url: "http://www.google.com",
      set_cookies: ["c=3; max-age=3600"],
      content: "c=3",
      queries: [
        ("http://www.google.com", "c=3"),
      ],
    },
    JarTest {
      description: "Delete pc c3 via MaxAge.",
      from_url: "http://www.google.com",
      set_cookies: ["c=3; max-age=-1"],
      content: "",
      queries: [
        ("http://www.google.com", ""),
      ],
    },
    JarTest {
      description: "Create persistent cookie d4.",
      from_url: "http://www.google.com",
      set_cookies: ["d=4; max-age=3600"],
      content: "d=4",
      queries: [
        ("http://www.google.com", "d=4"),
      ],
    },
    JarTest {
      description: "Delete pc d4 via Expires.",
      from_url: "http://www.google.com",
      set_cookies: ["d=4; expires=Tue, 01 Jan 2013 11:59:50 UTC"],
      content: "",
      queries: [
        ("http://www.google.com", ""),
      ],
    },
  ]
}

fn domain_handling_tests() -> List<JarTest> {
  [
    JarTest {
      description: "Host cookie",
      from_url: "http://www.host.test",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://www.host.test", "a=1"),
        ("http://host.test", ""),
        ("http://bar.host.test", ""),
        ("http://foo.www.host.test", ""),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Domain cookie #1",
      from_url: "http://www.host.test",
      set_cookies: ["a=1; domain=host.test"],
      content: "a=1",
      queries: [
        ("http://www.host.test", "a=1"),
        ("http://host.test", "a=1"),
        ("http://bar.host.test", "a=1"),
        ("http://foo.www.host.test", "a=1"),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Domain cookie #2",
      from_url: "http://www.host.test",
      set_cookies: ["a=1; domain=.host.test"],
      content: "a=1",
      queries: [
        ("http://www.host.test", "a=1"),
        ("http://host.test", "a=1"),
        ("http://bar.host.test", "a=1"),
        ("http://foo.www.host.test", "a=1"),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Host cookie on IDNA domain #1",
      from_url: "http://www.bücher.test",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://www.bücher.test", "a=1"),
        ("http://www.xn--bcher-kva.test", "a=1"),
        ("http://bücher.test", ""),
        ("http://xn--bcher-kva.test", ""),
        ("http://bar.bücher.test", ""),
        ("http://bar.xn--bcher-kva.test", ""),
        ("http://foo.www.bücher.test", ""),
        ("http://foo.www.xn--bcher-kva.test", ""),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Host cookie on IDNA domain #2",
      from_url: "http://www.xn--bcher-kva.test",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://www.bücher.test", "a=1"),
        ("http://www.xn--bcher-kva.test", "a=1"),
        ("http://bücher.test", ""),
        ("http://xn--bcher-kva.test", ""),
        ("http://bar.bücher.test", ""),
        ("http://bar.xn--bcher-kva.test", ""),
        ("http://foo.www.bücher.test", ""),
        ("http://foo.www.xn--bcher-kva.test", ""),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Domain cookie on IDNA domain #1",
      from_url: "http://www.bücher.test",
      set_cookies: ["a=1; domain=xn--bcher-kva.test"],
      content: "a=1",
      queries: [
        ("http://www.bücher.test", "a=1"),
        ("http://www.xn--bcher-kva.test", "a=1"),
        ("http://bücher.test", "a=1"),
        ("http://xn--bcher-kva.test", "a=1"),
        ("http://bar.bücher.test", "a=1"),
        ("http://bar.xn--bcher-kva.test", "a=1"),
        ("http://foo.www.bücher.test", "a=1"),
        ("http://foo.www.xn--bcher-kva.test", "a=1"),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Domain cookie on IDNA domain #2",
      from_url: "http://www.xn--bcher-kva.test",
      set_cookies: ["a=1; domain=xn--bcher-kva.test"],
      content: "a=1",
      queries: [
        ("http://www.bücher.test", "a=1"),
        ("http://www.xn--bcher-kva.test", "a=1"),
        ("http://bücher.test", "a=1"),
        ("http://xn--bcher-kva.test", "a=1"),
        ("http://bar.bücher.test", "a=1"),
        ("http://bar.xn--bcher-kva.test", "a=1"),
        ("http://foo.www.bücher.test", "a=1"),
        ("http://foo.www.xn--bcher-kva.test", "a=1"),
        ("http://other.test", ""),
        ("http://test", ""),
      ],
    },
    JarTest {
      description: "Host cookie on TLD.",
      from_url: "http://com",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://com", "a=1"),
        ("http://any.com", ""),
        ("http://any.test", ""),
      ],
    },
    JarTest {
      description: "Domain cookie on TLD becomes a host cookie.",
      from_url: "http://com",
      set_cookies: ["a=1; domain=com"],
      content: "a=1",
      queries: [
        ("http://com", "a=1"),
        ("http://any.com", ""),
        ("http://any.test", ""),
      ],
    },
    JarTest {
      description: "Host cookie on public suffix.",
      from_url: "http://co.uk",
      set_cookies: ["a=1"],
      content: "a=1",
      queries: [
        ("http://co.uk", "a=1"),
        ("http://uk", ""),
        ("http://some.co.uk", ""),
        ("http://foo.some.co.uk", ""),
        ("http://any.uk", ""),
      ],
    },
    JarTest {
      description: "Domain cookie on public suffix is ignored.",
      from_url: "http://some.co.uk",
      set_cookies: ["a=1; domain=co.uk"],
      content: "",
      queries: [
        ("http://co.uk", ""),
        ("http://uk", ""),
        ("http://some.co.uk", ""),
        ("http://foo.some.co.uk", ""),
        ("http://any.uk", ""),
      ],
    },
  ]
}
