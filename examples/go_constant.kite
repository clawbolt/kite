use std.go.constant
use std.go.constant.{ Value, Kind, Val }
use std.go.token
use std.math
use std.math.bits
use std.math.big
use std.math.big.rat
use std.math.big.float as bigfloat
use std.strconv
use std.strings

fn f64(f: Float) -> Str { strconv.format_float_go(f, "g", -1, 64) }

fn f32(f: Float) -> Str { strconv.format_float_go(f, "g", -1, 32) }

fn blist(bs: List<Int>) -> Str { "[" + join(map(bs, (b) => "{b}"), ", ") + "]" }

fn show(x: Value) -> Str { "{x.kind()}|{x.string()}|{x.exact_string()}" }

fn val_type(x: Value) -> Str {
  match constant.val(x) {
    Val.Nil => "<nil>",
    Val.Bool(_) => "bool",
    Val.String(_) => "string",
    Val.Int64(_) => "int64",
    Val.BigInt(_) => "*big.Int",
    Val.Rat(_) => "*big.Rat",
    Val.BigFloat(_) => "*big.Float",
  }
}

fn numeric(x: Value) -> Bool {
  let k = x.kind()
  k == Kind.Int || k == Kind.Float || k == Kind.Complex || k == Kind.Unknown
}

fn describe(name: Str, x: Value) {
  print("{name} => {show(x)} val={val_type(x)}")
  let k = x.kind()
  if numeric(x) {
    print(
      "  sign={constant.sign(x)} real={constant.real(x).string()} imag={constant.imag(x).string()}",
    )
    print(
      "  toInt={show(constant.to_int(x))} toFloat={show(constant.to_float(x))} toComplex={show(constant.to_complex(x))}",
    )
  }
  if k == Kind.Int || k == Kind.Float || k == Kind.Unknown {
    print(
      "  num={show(constant.num(x))} denom={show(constant.denom(x))} imag*={show(constant.make_imag(x))}",
    )
    let (f, e) = constant.float64_val(x)
    let (g, e2) = constant.float32_val(x)
    print("  f64={f64(f)} {e} f32={f32(g)} {e2}")
  }
  if k == Kind.Int || k == Kind.Unknown {
    let (i, e) = constant.int64_val(x)
    let (u, e2) = constant.uint64_val(x)
    print("  i64={i} {e} u64={bits.ustr(u)} {e2} bitlen={constant.bit_len(x)}")
  }
  if k == Kind.Int {
    let bs = constant.bytes(x)
    print("  bytes={blist(bs)} back={show(constant.make_from_bytes(bs))}")
  }
  if k == Kind.Bool || k == Kind.Unknown { print("  bool={constant.bool_val(x)}") }
  if k == Kind.String || k == Kind.Unknown {
    print("  str={strconv.quote_go(constant.string_val(x))} len={constant.string_len(x)}")
  }
}

fn lit(tok: Int, s: Str) -> (Int, Str) { (tok, s) }

fn bop(x: Value, op: Int, y: Value) -> Value { constant.binary_op(x, op, y) }

fn ts(op: Int) -> Str { token.token_string(op) }

fn main() {
  let lits = [
    lit(token.INT, "0"),
    lit(token.INT, "42"),
    lit(token.INT, "0x7fffffffffffffff"),
    lit(token.INT, "0x8000000000000000"),
    lit(token.INT, "0xffffffffffffffff"),
    lit(token.INT, "123456789012345678901234567890"),
    lit(token.INT, "0b1011"),
    lit(token.INT, "0o777"),
    lit(token.INT, "0777"),
    lit(token.INT, "1_000_000"),
    lit(token.INT, "12a"),
    lit(token.INT, "_1"),
    lit(token.FLOAT, "1.5"),
    lit(token.FLOAT, "0.1"),
    lit(token.FLOAT, "1e10"),
    lit(token.FLOAT, "1e-10"),
    lit(token.FLOAT, "3.14159265358979323846264338327950288419716939937510582097494459"),
    lit(token.FLOAT, "1e100"),
    lit(token.FLOAT, "1e400"),
    lit(token.FLOAT, "1e-400"),
    lit(token.FLOAT, "1e1000"),
    lit(token.FLOAT, "1e5000"),
    lit(token.FLOAT, "-1e5000"),
    lit(token.FLOAT, "1e-5000"),
    lit(token.FLOAT, "0x1p-2"),
    lit(token.FLOAT, "0x1.8p10"),
    lit(token.FLOAT, "1_0.2_5"),
    lit(token.FLOAT, "1e"),
    lit(token.FLOAT, "2.0"),
    lit(token.FLOAT, "123456789.0"),
    lit(token.FLOAT, "1234567.5"),
    lit(token.FLOAT, "0.000001"),
    lit(token.FLOAT, "1e-6000000000"),
    lit(token.FLOAT, "1e9999999"),
    lit(token.FLOAT, "1e-40"),
    lit(token.FLOAT, "1.4e-45"),
    lit(token.FLOAT, "7e-46"),
    lit(token.FLOAT, "3.4028235e38"),
    lit(token.FLOAT, "3.4028236e38"),
    lit(token.FLOAT, "1e39"),
    lit(token.FLOAT, "-1e-5000"),
    lit(token.FLOAT, "-2.5e-1300"),
    lit(token.FLOAT, "0.33333333333333333333333333333333333333"),
    lit(token.FLOAT, "16777217"),
    lit(token.FLOAT, "0x1.fffffep127"),
    lit(token.IMAG, "2i"),
    lit(token.IMAG, "1.5i"),
    lit(token.IMAG, "0x10i"),
    lit(token.IMAG, "1e1000i"),
    lit(token.IMAG, "i"),
    lit(token.CHAR, "'a'"),
    lit(token.CHAR, "'\\n'"),
    lit(token.CHAR, "'\\u00e9'"),
    lit(token.CHAR, "'世'"),
    lit(token.CHAR, "'\\x41'"),
    lit(token.CHAR, "'ab'"),
    lit(token.CHAR, "''"),
    lit(token.CHAR, "'\\q'"),
    lit(token.STRING, "\"hello\""),
    lit(token.STRING, "`raw\\n`"),
    lit(token.STRING, "\"tab\\there\""),
    lit(token.STRING, "\"\\u4e16\\u754c\""),
    lit(token.STRING, "\"bad"),
    lit(token.STRING, "\"\""),
  ]
  for (tok, s) in lits { describe("lit {ts(tok)} {s}", constant.make_from_literal(s, tok, 0)) }

  describe("unknown", constant.make_unknown())
  describe("true", constant.make_bool(true))
  describe("false", constant.make_bool(false))
  describe("str", constant.make_string("go \"constant\"\n"))
  describe("long", constant.make_string(strings.repeat("abcdefghij", 10)))
  describe("long-uni", constant.make_string(strings.repeat("世界", 40)))
  describe("str70", constant.make_string(strings.repeat("x", 70)))
  describe("str71", constant.make_string(strings.repeat("x", 71)))
  describe("minint", constant.make_int64(-9223372036854775807 - 1))
  describe("maxint", constant.make_int64(9223372036854775807))
  describe("-5", constant.make_int64(-5))
  describe("u64max", constant.make_uint64(-1))
  describe("u64 1<<63", constant.make_uint64(1 << 63))
  describe("u64 7", constant.make_uint64(7))
  let fs = [
    0.0,
    -0.0,
    1.0,
    -2.5,
    0.1,
    1.0 / 3.0,
    1e300,
    1e-300,
    5e-324,
    1e20,
    123456.75,
    math.max_float,
    math.inf,
    math.nan,
    16777217.0,
    3.4e38,
    3.5e38,
    1e-46,
  ]
  for f in fs { describe("f64 " + f64(f), constant.make_float64(f)) }
  describe("make bigint", constant.make_big_int(big.new_int(3).lsh(100)))
  describe("make bigint small", constant.make_big_int(big.new_int(-77)))
  describe("make rat", constant.make_rat(rat.new_rat(-22, 7)))
  describe("make rat int", constant.make_rat(rat.new_rat(10, 5)))
  describe("make float", constant.make_big_float(bigfloat.new_float(1.25)))
  describe("make float0", constant.make_big_float(bigfloat.new_float(0.0)))
  describe("make float inf", constant.make_big_float(bigfloat.zero().set_inf(true)))
  describe(
    "make float pi",
    constant.make_big_float(bigfloat.zero().set_prec(200).set_float64(math.pi)),
  )
  describe("bytes", constant.make_from_bytes([1, 2, 3, 0, 0]))
  describe("bytes empty", constant.make_from_bytes([]))
  describe("bytes big", constant.make_from_bytes([0, 0, 0, 0, 0, 0, 0, 0, 1]))
  describe("bytes 2^63", constant.make_from_bytes([0, 0, 0, 0, 0, 0, 0, 128]))

  let c1 = bop(constant.make_int64(3), token.ADD, constant.make_imag(constant.make_int64(4)))
  let c2 = bop(
    constant.make_from_literal("1.5", token.FLOAT, 0),
    token.SUB,
    constant.make_imag(constant.make_from_literal("0.5", token.FLOAT, 0)),
  )
  describe("c1", c1)
  describe("c2", c2)
  describe("c1*c2", bop(c1, token.MUL, c2))
  describe("c1/c2", bop(c1, token.QUO, c2))
  describe("c1-c1", bop(c1, token.SUB, c1))
  describe("-c1", constant.unary_op(token.SUB, c1, 0))
  describe("+c1", constant.unary_op(token.ADD, c1, 0))
  describe(
    "c3",
    bop(constant.make_float64(2.5), token.ADD, constant.make_imag(constant.make_int64(0))),
  )

  let nums = [
    constant.make_int64(0),
    constant.make_int64(7),
    constant.make_int64(-3),
    constant.make_int64(9223372036854775807),
    constant.make_int64(-9223372036854775807 - 1),
    constant.make_int64(1 << 40),
    constant.make_int64(-(1 << 62) - 5),
    constant.make_from_literal("123456789012345678901234567890", token.INT, 0),
    constant.make_from_literal("-98765432109876543210", token.INT, 0),
    constant.make_from_literal("2.5", token.FLOAT, 0),
    constant.make_from_literal("-0.1", token.FLOAT, 0),
    constant.make_from_literal("1e5000", token.FLOAT, 0),
    constant.make_from_literal("1e-3000", token.FLOAT, 0),
    c1,
    constant.make_unknown(),
  ]
  let int_ops = [
    token.ADD,
    token.SUB,
    token.MUL,
    token.QUO,
    token.QUO_ASSIGN,
    token.REM,
    token.AND,
    token.OR,
    token.XOR,
    token.AND_NOT,
  ]
  let flt_ops = [token.ADD, token.SUB, token.MUL, token.QUO]
  let cmp_ops = [token.EQL, token.NEQ, token.LSS, token.LEQ, token.GTR, token.GEQ]
  for x in nums {
    for y in nums {
      let both_int = x.kind() == Kind.Int && y.kind() == Kind.Int
      let any_cx = x.kind() == Kind.Complex || y.kind() == Kind.Complex
      let ops = if both_int { int_ops } else { flt_ops }
      for op in ops {
        if (op == token.QUO || op == token.QUO_ASSIGN || op == token.REM) && constant.sign(y) == 0 {
          continue
        }
        print("{x.string()} {ts(op)} {y.string()} = {show(bop(x, op, y))}")
      }
      if any_cx {
        print(
          "{x.string()} == {y.string()}: {constant.compare(x, token.EQL, y)}, != {constant.compare(x, token.NEQ, y)}",
        )
      } else {
        let res = map(cmp_ops, (op) => "{ts(op)}:{constant.compare(x, op, y)}")
        let joined = join(res, " ")
        print("cmp {x.string()} {y.string()}: {joined}")
      }
    }
  }

  let third = bop(constant.make_int64(1), token.QUO, constant.make_int64(3))
  describe("1/3", third)
  describe("1/3*3", bop(third, token.MUL, constant.make_int64(3)))
  describe(
    "10 QUO_ASSIGN 3",
    bop(constant.make_int64(10), token.QUO_ASSIGN, constant.make_int64(3)),
  )
  describe("-7 % 2", bop(constant.make_int64(-7), token.REM, constant.make_int64(2)))
  describe(
    "min / -1",
    bop(constant.make_int64(-9223372036854775807 - 1), token.QUO_ASSIGN, constant.make_int64(-1)),
  )
  let big1 = constant.make_from_literal("1e5000", token.FLOAT, 0)
  describe("big/3", bop(big1, token.QUO, constant.make_int64(3)))
  describe("big-big", bop(big1, token.SUB, big1))
  describe(
    "big*big",
    bop(big1, token.MUL, constant.make_from_literal("1e400000000", token.FLOAT, 0)),
  )
  let pi = constant.make_from_literal(
    "3.14159265358979323846264338327950288419716939937510582097494459",
    token.FLOAT,
    0,
  )
  describe("pi*pi", bop(pi, token.MUL, pi))
  let x3 = bop(
    constant.make_from_literal("1e5000", token.FLOAT, 0),
    token.QUO,
    constant.make_from_literal("1e4999", token.FLOAT, 0),
  )
  describe("1e5000/1e4999", x3)
  let tenth = bop(
    constant.make_from_literal("1e-3000", token.FLOAT, 0),
    token.MUL,
    constant.make_from_literal("1e3000", token.FLOAT, 0),
  )
  describe("1e-3000*1e3000", tenth)

  let s1 = constant.make_string("foo")
  let s2 = constant.make_string("bar")
  let s3 = bop(bop(s1, token.ADD, s2), token.ADD, constant.make_string("世界"))
  describe("concat", s3)
  for op in cmp_ops {
    print(
      "str {ts(op)}: {constant.compare(s1, op, s2)} {constant.compare(s1, op, s1)} {constant.compare(s2, op, s3)}",
    )
  }
  let b1 = constant.make_bool(true)
  let b2 = constant.make_bool(false)
  print(
    "bool {bop(b1, token.LAND, b2).string()} {bop(b1, token.LOR, b2).string()} {constant.compare(b1, token.EQL, b2)} {constant.compare(b1, token.NEQ, b2)} {constant.unary_op(token.NOT, b2, 0).string()}",
  )
  let u = constant.make_unknown()
  print(
    "unknown ops {bop(b1, token.LAND, u).string()} {constant.compare(u, token.EQL, b1)} {constant.unary_op(token.NOT, u, 0).string()} {constant.unary_op(token.XOR, u, 0).string()}",
  )

  let uvals = [
    constant.make_int64(0),
    constant.make_int64(5),
    constant.make_int64(-1),
    constant.make_int64(-9223372036854775807 - 1),
    constant.make_int64(9223372036854775807),
    constant.make_from_literal("123456789012345678901234567890", token.INT, 0),
    constant.make_uint64(-1),
  ]
  for v in uvals {
    let neg = show(constant.unary_op(token.SUB, v, 0))
    let pos = show(constant.unary_op(token.ADD, v, 0))
    let x0 = show(constant.unary_op(token.XOR, v, 0))
    let x8 = show(constant.unary_op(token.XOR, v, 8))
    let x64 = show(constant.unary_op(token.XOR, v, 64))
    print("unary {v.string()}: -={neg} +={pos} ^={x0} ^8={x8} ^64={x64}")
  }
  for v in [constant.make_from_literal("2.5", token.FLOAT, 0), big1, constant.make_float64(1e300)] {
    let neg = show(constant.unary_op(token.SUB, v, 0))
    let pos = show(constant.unary_op(token.ADD, v, 0))
    print("unary {v.string()}: -={neg} +={pos}")
  }

  let svals = [
    constant.make_int64(1),
    constant.make_int64(-5),
    constant.make_int64(9223372036854775807),
    constant.make_int64(-9223372036854775807 - 1),
    constant.make_from_literal("123456789012345678901234567890", token.INT, 0),
    constant.make_from_literal("-123456789012345678901234567890", token.INT, 0),
    constant.make_unknown(),
  ]
  for v in svals {
    for s in [0, 1, 3, 62, 63, 64, 100] {
      let l = show(constant.shift(v, token.SHL, s))
      let r = show(constant.shift(v, token.SHR, s))
      print("shift {v.string()} {s}: << {l} >> {r}")
    }
  }

  let kinds = [Kind.Unknown, Kind.Bool, Kind.String, Kind.Int, Kind.Float, Kind.Complex]
  print(fold(kinds, "", (acc, k) => acc + "{k} "))
}
