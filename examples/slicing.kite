// 0.39：切片 xs[a..b]，对 List 和 Str 都可以用。Str 按字符（Unicode 码点）计算
// 负数下标从末尾往回数；越界时报错（strings.slice 则会自动截断）
fn main() {
  let s = "héllo, 世界!"
  print(s[0..5], s[7..], s[..5], s[..=1], s[-3..], s[-3..-1], s[..])
  let xs = [10, 20, 30, 40, 50]
  print(xs[1..3], xs[2..], xs[..2], xs[1..=3], xs[-2..], xs[3..3])
  let n = 2
  print(xs[n..n + 2], xs[n - 1..len(xs) - 1], s[n..])
  for c in s[7..9] { print(c) }
  print(split("one two three", " ")[1..] |> join(","))
  // 逐字符处理：for c in s 按字符遍历，s[i] 取第 i 个字符
  var rev = ""
  for c in s { rev = c + rev }
  print(rev)
  fn is_pal(w: Str) -> Bool {
    if len(w) < 2 { return true }
    w[0] == w[-1] && is_pal(w[1..-1])
  }
  print(is_pal("上海自来水来自海上"), is_pal("kite"))
}
