// Kite 自举编译器：模块系统（对应 modules.py 的 Loader / Resolver，逐条移植）
// 把程序及其引用的模块解析、改名、拼接成一个扁平的程序；行号编码为 文件序号 * LINE_BASE + 行
use std.fs
use std.path
use ast
use ast.{ V, nd, kind, line, fld, sv, iv, items, is_nil, with }
use lexer
use parser

pub const LINE_BASE: Int = 1000000

pub type Pkg = { name: Str, root: Str, src: Str, prefix: Str, deps: List<Str> }

pub type Mod = {
  key: Str,
  prefix: Str,
  path: Str,
  pkg: Pkg,
  items: List<V>,
  names: Map<Str, Str>,
  pubs: Map<Str, Bool>,
  vis: Map<Str, Str>,
  types: Map<Str, Bool>,
  deps: List<Str>,
  inl: Map<Str, Str>,
  inl_pub: Map<Str, Bool>,
  parent: Str?,
  children: List<Str>,
}

// 错误：ln = -1 未支持，ln = -2 被导入文件的语法错误
pub type ME = { ln: Int, msg: Str }

pub type L = {
  mods: Map<Str, Mod>,
  order: List<Str>,
  loading: List<Str>,
  nfiles: Int,
  files: List<Str>,
  by_path: Map<Str, Str>,
  main: Str,
  root: Pkg,
  cwd: Str,
  kdir: Str,
  lm: Int,
  dtab: Map<Str, Pkg>,
  dunsup: Str,
}

fn me(ln: Int, msg: Str) -> ME { ME { ln: ln, msg: msg } }

fn decl_named(k: Str) -> Bool { contains(["Fn", "Struct", "Enum", "Trait", "Alias"], k) }

fn mangle(prefix: Str, name: Str) -> Str { if prefix == "" { name } else { prefix + "." + name } }

fn new_mod(key: Str, path: Str, pkg: Pkg) -> Mod {
  Mod {
    key: key,
    prefix: key,
    path: path,
    pkg: pkg,
    items: [],
    names: Map(),
    pubs: Map(),
    vis: Map(),
    types: Map(),
    deps: [],
    inl: Map(),
    inl_pub: Map(),
    parent: None,
    children: [],
  }
}

fn gm(l: L, key: Str) -> Mod { unwrap(get(l.mods, key)) }

fn pm(l: L, m: Mod) -> L { L { mods: set(l.mods, m.key, m), ..l } }

pub fn pat_binds(p: V) -> List<Str> {
  let xs = items(p)
  if len(xs) == 0 { return [] }
  let k = sv(xs[0])
  var out: List<Str> = []
  if k == "bind" {
    out = [sv(xs[1])]
  } else if k == "tuple" {
    for x in items(xs[1]) { out = out + pat_binds(x) }
  } else if k == "list" {
    for x in items(xs[1]) { out = out + pat_binds(x) }
    if !is_nil(xs[2]) && sv(xs[2]) != "_" && sv(xs[2]) != "" { out = push(out, sv(xs[2])) }
  } else if k == "variant" && !is_nil(xs[2]) {
    for x in items(xs[2]) { out = out + pat_binds(x) }
  } else if k == "struct" {
    for f in items(xs[2]) { out = out + pat_binds(items(f)[1]) }
  } else if k == "or" {
    out = pat_binds(items(xs[1])[0])
  } else if k == "at" {
    out = pat_binds(xs[1]) + pat_binds(xs[2])
  }
  if k == "list" && len(xs) > 3 { for x in items(xs[3]) { out = out + pat_binds(x) } }
  out
}

fn use_name(e: V) -> (Str, Str) {
  match e {
    VT(xs) => (sv(xs[0]), sv(xs[1])),
    _      => (sv(e), sv(e)),
  }
}

// ── 路径 ──

fn abspath(cwd: Str, p: Str) -> Str { if path.is_abs(p) { path.clean(p) } else { path.join([cwd, p]) } }

fn dirname(p: Str) -> Str { path.dir(p) }

fn relpath(cwd: Str, p: Str) -> Str {
  let a = filter(split(p, "/"), (s) => s != "")
  let b = filter(split(cwd, "/"), (s) => s != "")
  var i = 0
  while i < len(a) && i < len(b) && a[i] == b[i] { i += 1 }
  var parts: List<Str> = []
  var j = i
  while j < len(b) {
    parts = push(parts, "..")
    j += 1
  }
  parts = parts + skip(a, i)
  if len(parts) == 0 { "." } else { join(parts, "/") }
}

fn is_file(p: Str) -> Bool { fs.is_file(p) }

// ── 包 ──

fn manifest_name(root: Str) -> (Str, Bool) {
  let src = match fs.read(path.join([root, "kite.toml"])) {
    Ok(s)  => s,
    Err(_) => "",
  }
  var name = ""
  var sect = ""
  var deps = false
  for raw in split(src, "\n") {
    let ln = trim(raw)
    if starts_with(ln, "[") {
      sect = ln
      continue
    }
    if ln == "" || starts_with(ln, "#") { continue }
    if sect == "[package]" && starts_with(ln, "name") {
      let ps = split(ln, "\"")
      if len(ps) >= 2 { name = ps[1] }
    }
    if sect == "[dependencies]" { deps = true }
  }
  (name, deps)
}

fn infer_package(cwd: Str, main: Str) -> Pkg {
  let d = dirname(main)
  var root = d
  var found = false
  var go = true
  while go {
    if fs.exists(path.join([root, "kite.toml"])) {
      found = true
      go = false
    } else {
      let parent = dirname(root)
      if parent == root { go = false } else { root = parent }
    }
  }
  if !found { return Pkg { name: "", root: d, src: d, prefix: "", deps: [] } }
  let src = path.join([root, "src"])
  let (name, deps) = manifest_name(root)
  Pkg { name: name, root: root, src: if fs.is_dir(src) { src } else { d }, prefix: "", deps: if deps { ["?"] } else { [] } }
}

// 依赖表：读 kite.lock（由 Python 包管理器 kite get 生成），名字 → Pkg；所有依赖共享同一张表
fn dep_table(root: Str) -> Result<Map<Str, Pkg>, Str> {
  let src = match fs.read(path.join([root, "kite.lock"])) {
    Ok(s)  => s,
    Err(_) => { return Err("依赖包（还没有 kite.lock，先运行 kite get）") },
  }
  var ents: List<(Str, Str, Str)> = []
  var nm = ""
  var ver = ""
  var srcv = ""
  var inpkg = false
  for raw in split(src + "\n[[end]]", "\n") {
    let ln = trim(raw)
    if starts_with(ln, "[") {
      if inpkg && nm != "" { ents = push(ents, (nm, ver, srcv)) }
      inpkg = ln == "[[package]]"
      nm = ""
      ver = ""
      srcv = ""
      continue
    }
    let ps = split(ln, "\"")
    if len(ps) < 2 { continue }
    let key = trim(ps[0])
    if key == "name =" { nm = ps[1] }
    if key == "version =" { ver = ps[1] }
    if key == "source =" { srcv = ps[1] }
  }
  let names = map(ents, (e) => e.0)
  var tab: Map<Str, Pkg> = Map()
  for (n, v, sv) in ents {
    let d = if starts_with(sv, "path+") { path.clean(path.join([root, __str_slice(sv, 5, len(sv))])) } else { path.join([root, ".kite", "deps", n + "-" + v]) }
    if !fs.is_dir(d) { return Err("依赖包 {n} 还没安装（先运行 kite get）") }
    tab = set(tab, n, Pkg { name: n, root: d, src: path.join([d, "src"]), prefix: n, deps: names })
  }
  Ok(tab)
}

pub fn new_l(cwd: Str, main: Str, kite_dir: Str) -> L {
  let mp = abspath(cwd, main)
  let rp0 = infer_package(cwd, mp)
  var rp = rp0
  var dtab: Map<Str, Pkg> = Map()
  var dun = ""
  if len(rp0.deps) > 0 {
    match dep_table(rp0.root) {
      Ok(t)  => {
        dtab = t
        rp = Pkg { deps: keys(t), ..rp0 }
      },
      Err(m) => { dun = m },
    }
  }
  L {
    dtab: dtab,
    dunsup: dun,
    mods: Map(),
    order: [],
    loading: [],
    nfiles: 0,
    files: [],
    by_path: Map(),
    main: mp,
    root: rp,
    cwd: cwd,
    kdir: kite_dir,
    lm: 0,
  }
}

// ── 改名（_rename_mod）──

fn rename_mod(x: V, old: Str, new: Str, exact: Bool) -> V {
  let pre = old + "."
  match x {
    VQ(s, q) => match q {
      Some(qs) => if qs == old || starts_with(qs, pre) { VQ(s, Some(new + __str_slice(qs, len(old), len(qs)))) } else { x },
      None     => x,
    },
    VS(s)    => if exact && s == old { VS(new) } else if starts_with(s, pre) { VS(new + "." + __str_slice(s, len(pre), len(s))) } else { x },
    VN(k, l, m0) => {
      var m = m0
      if k == "Name" && sv(unwrap_or(get(m, "name"), VNil)) == old { m = set(m, "name", VS(new)) }
      if k == "Use" {
        let p = items(unwrap_or(get(m, "path"), VNil))
        if len(p) > 0 && sv(p[0]) == old {
          if let VS(_) = p[0] { m = set(m, "path", VL(push([], VS(new)) + skip(p, 1))) }
        }
      }
      var m2 = m
      for key in keys(m) { m2 = set(m2, key, rename_mod(unwrap(get(m, key)), old, new, exact)) }
      VN(k, l, m2)
    },
    VL(xs)   => VL(map(xs, (w) => rename_mod(w, old, new, exact))),
    VR(xs)   => VR(map(xs, (w) => rename_mod(w, old, new, exact))),
    VT(xs)   => VT(map(xs, (w) => rename_mod(w, old, new, exact))),
    VD(kvs)  => VD(map(kvs, (kv) => (kv.0, rename_mod(kv.1, old, new, exact)))),
    _        => x,
  }
}

fn ren_list(xs: List<V>, old: Str, new: Str, exact: Bool) -> List<V> { map(xs, (w) => rename_mod(w, old, new, exact)) }

// ── 函数体里的 mod（hoist_local_mods）──

fn hoist(l0: L, its: List<V>) -> Result<(L, List<V>, List<V>), ME> {
  var l = l0
  var out: List<V> = []
  var res: List<V> = []
  for it in its {
    if contains(["Fn", "Impl", "Let", "Trait"], kind(it)) {
      let (l1, o1, x) = walk_h(l, it, out)?
      l = l1
      out = o1
      res = push(res, x)
    } else {
      res = push(res, it)
    }
  }
  Ok((l, out, res))
}

fn walk_h(l0: L, x: V, out0: List<V>) -> Result<(L, List<V>, V), ME> {
  var l = l0
  var out = out0
  match x {
    VN(k, ln, m0) => {
      if k == "Mod" { return Ok((l, out, x)) }
      var m = m0
      if k == "Block" {
        var stmts = items(unwrap(get(m, "stmts")))
        let mods0 = filter(stmts, (s) => kind(s) == "Mod" && !is_nil(fld(s, "items")))
        if len(mods0) > 0 {
          var seen: List<Str> = []
          for md in mods0 {
            let mn = sv(fld(md, "name"))
            if mn == "super" { return Err(me(line(md), "super 是保留名字，不能用作模块名")) }
            if contains(seen, mn) { return Err(me(line(md), "模块 {mn} 重复定义")) }
            seen = push(seen, mn)
          }
          stmts = filter(stmts, (s) => !(kind(s) == "Mod" && !is_nil(fld(s, "items"))))
          var mods = mods0
          var i = 0
          while i < len(mods) {
            let mn = sv(fld(mods[i], "name"))
            l = L { lm: l.lm + 1, ..l }
            let nn = "__lm{l.lm}_{mn}"
            mods = map(mods, (o) => with(o, "items", VL(ren_list(items(fld(o, "items")), mn, nn, false))))
            stmts = ren_list(stmts, mn, nn, false)
            mods = set(mods, i, with(with(mods[i], "name", VS(nn)), "pub", VB(false)))
            i += 1
          }
          out = out + mods
        }
        let uses = filter(stmts, (s) => kind(s) == "Use" && is_lm_use(s))
        if len(uses) > 0 {
          stmts = filter(stmts, (s) => !(kind(s) == "Use" && is_lm_use(s)))
          for st in uses {
            let p = items(fld(st, "path"))
            let lastp = p[len(p) - 1]
            if sv(lastp) == "*" { return Err(me(line(st), "函数体里不支持 use m.*，请逐个列出名字")) }
            let al = fld(st, "alias")
            let ents = match lastp {
              VL(es) => map(es, use_name),
              _      => [(sv(lastp), if is_nil(al) { sv(lastp) } else { sv(al) })],
            }
            for (orig, bind) in ents {
              l = L { lm: l.lm + 1, ..l }
              let nb = "__lmu{l.lm}_{bind}"
              out = push(out, nd("Use", line(st), [("path", VL(take(p, len(p) - 1) + [VS(orig)])), ("alias", VS(nb)), ("pub", VB(false)), ("vis", VNil)]))
              stmts = ren_list(stmts, bind, nb, first_upper(bind))
            }
          }
        }
        m = set(m, "stmts", VL(stmts))
      }
      var m2 = m
      for key in keys(m) {
        let (l1, o1, v) = walk_h(l, unwrap(get(m, key)), out)?
        l = l1
        out = o1
        m2 = set(m2, key, v)
      }
      Ok((l, out, VN(k, ln, m2)))
    },
    VL(xs)        => {
      let (l1, o1, ys) = walk_hs(l, xs, out)?
      Ok((l1, o1, VL(ys)))
    },
    VR(xs)        => {
      let (l1, o1, ys) = walk_hs(l, xs, out)?
      Ok((l1, o1, VR(ys)))
    },
    VT(xs)        => {
      let (l1, o1, ys) = walk_hs(l, xs, out)?
      Ok((l1, o1, VT(ys)))
    },
    _             => Ok((l, out, x)),
  }
}

fn walk_hs(l0: L, xs: List<V>, out0: List<V>) -> Result<(L, List<V>, List<V>), ME> {
  var l = l0
  var out = out0
  var ys: List<V> = []
  for x in xs {
    let (l1, o1, y) = walk_h(l, x, out)?
    l = l1
    out = o1
    ys = push(ys, y)
  }
  Ok((l, out, ys))
}

fn is_lm_use(s: V) -> Bool {
  match fld(s, "path") {
    VL(p) => len(p) > 0 && starts_with(sv(p[0]), "__lm") && is_vs(p[0]),
    _     => false,
  }
}

fn is_vs(v: V) -> Bool {
  match v {
    VS(_) => true,
    _     => false,
  }
}

fn first_upper(s: Str) -> Bool {
  if len(s) == 0 { return false }
  let o = __ord(__str_slice(s, 0, 1))
  o >= 65 && o <= 90
}

// ── 加载 ──

// std 按 Go 的包路径分层（std/go/ast.kite → use std.go.ast）：取最长的模块文件前缀，返回 (文件, 用掉的段数)
fn std_find(l: L, segs: List<V>) -> (Str, Int) {
  let sd = path.join([l.kdir, "std"])
  var n = len(segs)
  while n > 0 {
    let parts = take(segs, n)
    if all(parts, is_vs) {
      let ps = map(parts, sv)
      let f1 = path.join(push([], sd) + ps) + ".kite"
      let f2 = path.join(push([], sd) + ps + ["mod.kite"])
      for f in [f1, f2] { if is_file(f) { return (f, n) } }
    }
    n -= 1
  }
  ("", 0)
}

fn full_std(l: L, segs: List<V>) -> Bool { len(segs) > 0 && std_find(l, segs).1 == len(segs) }

fn kite_std(l: L, v: V) -> Bool { full_std(l, [v]) }

// use 路径（以 std 开头）是否引用 Kite 写的 std 模块
fn kstd_use(l: L, p: List<V>) -> Bool {
  if len(p) < 2 || !is_vs(p[0]) || sv(p[0]) != "std" { return false }
  let segs = skip(p, 1)
  match segs[len(segs) - 1] {
    VL(ms) => {
      let pre = take(segs, len(segs) - 1)
      (len(pre) > 0 && std_find(l, pre).1 > 0) || any(ms, (m) => full_std(l, pre + [VS(use_name(m).0)]))
    },
    _ => std_find(l, segs).1 > 0,
  }
}

fn parse_file(l: L, p: Str) -> Result<(L, List<V>), ME> {
  let idx = l.nfiles
  let l1 = L { nfiles: l.nfiles + 1, files: push(l.files, p), ..l }
  let src = match fs.read(p) {
    Ok(s)  => s,
    Err(e) => { return Err(me(0, "无法读取 {p}: {e}")) },
  }
  match parser.parse_off(src, idx * LINE_BASE) {
    Ok(its) => Ok((l1, map(its, ast.to_v))),
    Err(_)  => Err(me(-2, "SKIP parse")),
  }
}

fn find_module_file(l: L, base: Str, segs: List<V>) -> (Str, Int) {
  var n = len(segs)
  while n > 0 {
    let parts = take(segs, n)
    if all(parts, is_vs) {
      let ps = map(parts, sv)
      let f1 = path.join(push([], base) + ps) + ".kite"
      let f2 = path.join(push([], base) + ps + ["mod.kite"])
      for f in [f1, f2] { if is_file(f) && abspath(l.cwd, f) != l.main { return (f, n) } }
    }
    n -= 1
  }
  ("", 0)
}

fn path_join_strs(xs: List<V>) -> Str { join(map(xs, sv), ".") }

fn resolve_use(l0: L, key0: Str, p: List<V>, ln: Int) -> Result<(L, Str, List<V>), ME> {
  let info = gm(l0, key0)
  let pkg = info.pkg
  let head = p[0]
  let hs = sv(head)
  if is_vs(head) && contains(info.inl, hs) {
    var key = unwrap(get(info.inl, hs))
    var rest = skip(p, 1)
    while len(rest) > 0 && is_vs(rest[0]) && contains(gm(l0, key).inl, sv(rest[0])) {
      key = sub_mod(l0, key, sv(rest[0]), ln, key0)?
      rest = skip(rest, 1)
    }
    return Ok((l0, key, rest))
  }
  if hs == "std" && is_vs(head) && len(p) >= 2 {
    let (sf, sn) = std_find(l0, skip(p, 1))
    if sn > 0 {
      let parts = map(take(skip(p, 1), sn), sv)
      let name = join(parts, ".")
      var par = "std"
      var i = 0
      while i < len(parts) && parts[i] != "internal" { par = par + "." + parts[i]; i += 1 }
      if i < len(parts) && !starts_with(key0 + ".", par + ".") {
        return Err(me(ln, "不能使用内部模块 std.{name}（只供 {par} 及其子模块使用）"))
      }
      let sd = path.join([l0.kdir, "std"])
      let spkg = Pkg { name: "std", root: sd, src: sd, prefix: "std", deps: [] }
      let (l1, k) = load(l0, "std." + name, sf, spkg, ln)?
      return Ok((l1, k, skip(p, 1 + sn)))
    }
  }
  let (f, n) = find_module_file(l0, pkg.src, p)
  if f != "" {
    let (l1, k) = load(l0, mangle(pkg.prefix, path_join_strs(take(p, n))), f, pkg, ln)?
    return Ok((l1, k, skip(p, n)))
  }
  if pkg.root == l0.root.root && pkg.prefix == "" && hs == pkg.name && pkg.name != "" {
    let lib = path.join([pkg.src, "lib.kite"])
    if is_file(lib) && abspath(l0.cwd, lib) != l0.main {
      let (f2, n2) = find_module_file(l0, pkg.src, skip(p, 1))
      if f2 != "" {
        let (l1, k) = load(l0, mangle(pkg.prefix, path_join_strs(take(skip(p, 1), n2))), f2, pkg, ln)?
        return Ok((l1, k, skip(p, 1 + n2)))
      }
      let (l1, k) = load(l0, pkg.name, lib, pkg, ln)?
      return Ok((l1, k, skip(p, 1)))
    }
  }
  if contains(pkg.deps, hs) {
    let dp = unwrap(get(l0.dtab, hs))
    let (f, n) = find_module_file(l0, dp.src, skip(p, 1))
    if f != "" {
      let (l1, k) = load(l0, mangle(dp.prefix, path_join_strs(take(skip(p, 1), n))), f, dp, ln)?
      return Ok((l1, k, skip(p, 1 + n)))
    }
    let lib = path.join([dp.src, "lib.kite"])
    if !is_file(lib) { return Err(me(ln, "依赖包 {hs} 没有 src/lib.kite")) }
    let (l1, k) = load(l0, dp.prefix, lib, dp, ln)?
    return Ok((l1, k, skip(p, 1)))
  }
  let wh = relpath(l0.cwd, path.join([pkg.src, hs + ".kite"]))
  Err(me(ln, "找不到模块 {hs}（没有 {wh}，也不是 kite.toml 里的依赖）"))
}

fn load(l0: L, key0: Str, p: Str, pkg: Pkg, ln: Int) -> Result<(L, Str), ME> {
  let ap = abspath(l0.cwd, p)
  let key = unwrap_or(get(l0.by_path, ap), key0)
  var l = L { by_path: set(l0.by_path, ap, key), ..l0 }
  if contains(l.mods, key) {
    if contains(l.loading, key) {
      var i = 0
      while l.loading[i] != key { i += 1 }
      let chain = join(skip(l.loading, i) + [key], " → ")
      return Err(me(ln, "模块循环引用: {chain}"))
    }
    return Ok((l, key))
  }
  var info = new_mod(key, p, pkg)
  l = pm(l, info)
  l = L { loading: push(l.loading, key), ..l }
  let (l1, its) = parse_file(l, p)?
  info = Mod { items: its, ..gm(l1, key) }
  l = process(pm(l1, info), key)?
  l = L { loading: take(l.loading, len(l.loading) - 1), order: push(l.order, key), ..l }
  Ok((l, key))
}

// 入口：返回拼接后的顶层项
pub fn load_main(l0: L) -> Result<List<V>, ME> {
  let (its, _) = load_main_src(l0, "")?
  Ok(its)
}

// 同时返回源文件表（kite.SOURCES：主文件按给定的写法，其余相对当前目录）
pub fn load_main_src(l0: L, given: Str) -> Result<(List<V>, List<Str>), ME> {
  if l0.dunsup != "" { return Err(me(-1, l0.dunsup)) }
  var l = pm(l0, new_mod("", l0.main, l0.root))
  l = L { loading: push(l.loading, ""), ..l }
  let (l1, its) = parse_file(l, l0.main)?
  l = pm(l1, Mod { items: its, ..gm(l1, "") })
  l = process(l, "")?
  l = L { loading: take(l.loading, len(l.loading) - 1), ..l }
  var variants: Map<Str, Str> = Map()
  let keys_ = push(l.order, "")
  for key in keys_ {
    for it in gm(l, key).items {
      if kind(it) == "Enum" {
        for v in items(fld(it, "variants")) {
          let vn = sv(items(v)[0])
          if let Some(prev) = get(variants, vn) {
            if prev != key {
              let a = if prev == "" { "主文件" } else { prev }
              let b = if key == "" { "主文件" } else { key }
              return Err(me(line(it), "枚举变体 {vn} 在 {a} 和 {b} 中重复定义（变体目前是全局名字）"))
            }
          }
          variants = set(variants, vn, key)
        }
      }
    }
  }
  var out: List<V> = []
  for key in keys_ { out = out + gm(l, key).items }
  var srcs = [given]
  for f in skip(l.files, 1) {
    let r = relpath(l.cwd, f)
    srcs = push(srcs, if starts_with(r, "../..") { relpath(l.root.root, f) } else { r })
  }
  Ok((order_consts(out), srcs))
}

fn process(l: L, key: Str) -> Result<L, ME> {
  let l1 = declare(l, key)?
  finish(l1, key)
}

fn declare(l0: L, key: Str) -> Result<L, ME> {
  var info = gm(l0, key)
  let (l1, hoisted, its) = hoist(l0, info.items)?
  var l = l1
  info = Mod { items: hoisted + its, ..gm(l, key) }
  for it in info.items {
    let k = kind(it)
    var names: List<Str> = []
    if decl_named(k) { names = [sv(fld(it, "name"))] } else if k == "Let" { names = pat_binds(fld(it, "pat")) }
    for nm in names {
      info = Mod { names: set(info.names, nm, mangle(info.prefix, nm)), ..info }
      if ast.truthy(fld(it, "pub")) {
        let vv = fld(it, "vis")
        info = Mod { pubs: set(info.pubs, nm, true), vis: set(info.vis, nm, if is_nil(vv) { "pub" } else { sv(vv) }), ..info }
      }
      if contains(["Struct", "Enum", "Trait", "Alias"], k) { info = Mod { types: set(info.types, nm, true), ..info } }
    }
  }
  l = pm(l, info)
  var inline = info.inl
  var rest: List<V> = []
  for it in info.items {
    if kind(it) == "Mod" && !is_nil(fld(it, "items")) {
      let mn = sv(fld(it, "name"))
      if mn == "super" { return Err(me(line(it), "super 是保留名字，不能用作模块名")) }
      if contains(inline, mn) { return Err(me(line(it), "模块 {mn} 重复定义")) }
      let ckey = if key != "" { key + "." + mn } else { mn }
      if contains(l.mods, ckey) { return Err(me(line(it), "内联模块 {mn} 和已有模块 {ckey} 重名")) }
      var child = new_mod(ckey, info.path, info.pkg)
      child = Mod { items: items(fld(it, "items")), parent: Some(key), inl: set(Map(), "super", key), inl_pub: set(Map(), "super", false), ..child }
      l = pm(l, child)
      l = declare(l, ckey)?
      let pi = gm(l, key)
      l = pm(l, Mod { children: push(pi.children, ckey), inl_pub: set(pi.inl_pub, mn, ast.truthy(fld(it, "pub"))), deps: push(pi.deps, ckey), ..pi })
      inline = set(inline, mn, ckey)
    } else {
      rest = push(rest, it)
    }
  }
  Ok(pm(l, Mod { items: rest, inl: inline, ..gm(l, key) }))
}

fn is_kstd(l: L, u: V) -> Bool {
  let p = items(fld(u, "path"))
  kstd_use(l, p)
}

fn walk_kstd(l: L, x: V, acc0: List<V>) -> (List<V>, V) {
  var acc = acc0
  match x {
    VN(k, ln, m0) => {
      var m = m0
      if k == "Block" {
        let ss = items(unwrap(get(m, "stmts")))
        acc = acc + filter(ss, (s) => kind(s) == "Use" && is_kstd(l, s))
        m = set(m, "stmts", VL(filter(ss, (s) => !(kind(s) == "Use" && is_kstd(l, s)))))
      }
      var m2 = m
      for key in keys(m) {
        let (a1, v) = walk_kstd(l, unwrap(get(m, key)), acc)
        acc = a1
        m2 = set(m2, key, v)
      }
      (acc, VN(k, ln, m2))
    },
    VL(xs)        => {
      var ys: List<V> = []
      for y in xs {
        let (a1, v) = walk_kstd(l, y, acc)
        acc = a1
        ys = push(ys, v)
      }
      (acc, VL(ys))
    },
    VT(xs)        => {
      var ys: List<V> = []
      for y in xs {
        let (a1, v) = walk_kstd(l, y, acc)
        acc = a1
        ys = push(ys, v)
      }
      (acc, VT(ys))
    },
    _             => (acc, x),
  }
}

fn finish(l0: L, key: Str) -> Result<L, ME> {
  var l = l0
  for ck in gm(l, key).children {
    l = L { loading: push(l.loading, ck), ..l }
    l = finish(l, ck)?
    l = L { loading: take(l.loading, len(l.loading) - 1), order: push(l.order, ck), ..l }
  }
  var info = gm(l, key)
  var hoisted: List<V> = []
  var its: List<V> = []
  for it in info.items {
    if contains(["Fn", "Impl", "Let"], kind(it)) {
      let (a, v) = walk_kstd(l, it, hoisted)
      hoisted = a
      its = push(its, v)
    } else {
      its = push(its, it)
    }
  }
  its = hoisted + its
  var uses: List<V> = []
  for it in its {
    let p = if kind(it) == "Use" { items(fld(it, "path")) } else { [] }
    var split_ = false
    if len(p) >= 2 && is_vs(p[0]) && sv(p[0]) == "std" {
      if let VL(ms) = p[len(p) - 1] {
        let pre = take(skip(p, 1), len(p) - 2)
        if all(pre, is_vs) && any(ms, (m) => full_std(l, pre + [VS(use_name(m).0)])) {
          split_ = true
          for m in ms {
            let (nm, al) = use_name(m)
            if full_std(l, pre + [VS(nm)]) { uses = push(uses, nd("Use", line(it), [("path", VL([VS("std")] + pre + [VS(nm)])), ("alias", VS(al))])) }
          }
          let rest = filter(ms, (m) => !full_std(l, pre + [VS(use_name(m).0)]))
          if len(rest) > 0 {
            if len(pre) > 0 {
              let bad = join(map(rest, (m) => use_name(m).0), ", ")
              return Err(me(line(it), "std.{path_join_strs(pre)} 下没有模块 {bad}"))
            }
            uses = push(uses, with(it, "path", VL([VS("std"), VL(rest)])))
          }
        }
      }
    }
    if !split_ { uses = push(uses, it) }
  }
  var aliases = info.inl
  var imports: Map<Str, Str> = Map()
  var kept: List<V> = []
  for it in uses {
    let p = if kind(it) == "Use" { items(fld(it, "path")) } else { [] }
    if kind(it) == "Use" && len(p) > 0 && (sv(p[0]) != "std" || !is_vs(p[0]) || kstd_use(l, p)) {
      let (l1, k0, rest0) = resolve_use(l, key, p, line(it))?
      l = l1
      var k = k0
      var rest = rest0
      while len(rest) > 0 && is_vs(rest[0]) && contains(gm(l, k).inl, sv(rest[0])) {
        k = sub_mod(l, k, sv(rest[0]), line(it), key)?
        rest = skip(rest, 1)
      }
      let cur = gm(l, key)
      if !contains(cur.deps, k) { l = pm(l, Mod { deps: push(cur.deps, k), ..cur }) }
      let al = fld(it, "alias")
      if len(rest) == 0 {
        aliases = set(aliases, if is_nil(al) { sv(p[len(p) - 1]) } else { sv(al) }, k)
      } else if len(rest) == 1 && sv(rest[0]) == "*" && is_vs(rest[0]) {
        let m = gm(l, k)
        for nm in sort(keys(m.pubs)) { if visible(l, m, nm, key) { imports = set(imports, nm, unwrap(get(m.names, nm))) } }
      } else {
        let lastr = rest[len(rest) - 1]
        let is_group = match lastr {
          VL(_) => true,
          _     => false,
        }
        if len(rest) > 1 && !is_group { return Err(me(line(it), "找不到模块 " + path_join_strs(take(p, len(p) - 1)))) }
        let names = match lastr {
          VL(es) => map(es, use_name),
          _      => [(sv(lastr), if is_nil(al) { sv(lastr) } else { sv(al) })],
        }
        for (nm, b) in names { imports = set(imports, b, export(l, k, nm, line(it), Some(key))?) }
      }
      continue
    }
    kept = push(kept, it)
  }
  var r = R { key: key, aliases: aliases, imports: imports, scopes: [], gens: [] }
  var out: List<V> = []
  for it in kept {
    let (r1, v) = top(l, r, it)?
    r = r1
    out = push(out, v)
  }
  Ok(pm(l, Mod { items: out, ..gm(l, key) }))
}

fn within(l: L, req: Str, m: Str) -> Bool {
  var cur: Str? = Some(req)
  while is_some(cur) {
    let c = unwrap(cur)
    if c == m { return true }
    cur = gm(l, c).parent
  }
  false
}

fn sub_mod(l: L, key: Str, name: Str, ln: Int, req: Str) -> Result<Str, ME> {
  let m = gm(l, key)
  let ck = unwrap_or(get(m.inl, name), "")
  if name == "super" && !within(l, req, key) { return Err(me(ln, "{key}.super 只能在模块 {key} 内部使用")) }
  if !within(l, req, key) && !unwrap_or(get(m.inl_pub, name), false) {
    return Err(me(ln, "{key}.{name} 是私有模块（写 pub mod {name} 才能在外面使用）"))
  }
  Ok(ck)
}

fn export(l: L, key: Str, name: Str, ln: Int, req: Str?) -> Result<Str, ME> {
  let m = gm(l, key)
  if !contains(m.names, name) { return Err(me(ln, "模块 {key} 里没有 {name}")) }
  let inside = match req {
    Some(r) => within(l, r, key),
    None    => false,
  }
  if !contains(m.pubs, name) && !inside { return Err(me(ln, "{key}.{name} 是私有的（在定义前加 pub 才能被其他模块使用）")) }
  if let Some(r) = req {
    if !visible(l, m, name, r) {
      let lvl = unwrap_or(get(m.vis, name), "pub")
      let what = if lvl == "pkg" { "本包" } else { "所在目录的模块" }
      return Err(me(ln, "{key}.{name} 是 pub({lvl})，只对{what}可见"))
    }
  }
  Ok(unwrap(get(m.names, name)))
}

fn mod_scope(l: L, m: Mod) -> Str {
  let ap = abspath(l.cwd, m.path)
  let d = dirname(ap)
  let b = path.base(m.path)
  if b == "lib.kite" { return abspath(l.cwd, m.pkg.src) }
  if b == "mod.kite" { return dirname(d) }
  d
}

fn visible(l: L, m: Mod, name: Str, req: Str) -> Bool {
  let lvl = unwrap_or(get(m.vis, name), "pub")
  if lvl == "pub" || within(l, req, m.key) { return true }
  let rq = gm(l, req)
  if rq.pkg.root != m.pkg.root || rq.pkg.prefix != m.pkg.prefix { return false }
  if lvl == "pkg" { return true }
  let sc = mod_scope(l, m)
  let rp = abspath(l.cwd, rq.path)
  rp == sc || starts_with(rp, sc + "/")
}

// ── Resolver ──

type R = { key: Str, aliases: Map<Str, Str>, imports: Map<Str, Str>, scopes: List<List<Str>>, gens: List<Str> }

fn is_local(r: R, n: Str) -> Bool { any(r.scopes, (s) => contains(s, n)) }

fn value(l: L, r: R, n: Str) -> Str {
  if is_local(r, n) { return n }
  let info = gm(l, r.key)
  if let Some(x) = get(info.names, n) { return x }
  if let Some(x) = get(r.imports, n) { return x }
  n
}

fn type_name(l: L, r: R, name: Str, gens: List<Str>) -> Result<Str, ME> {
  if contains(gens, name) { return Ok(name) }
  if contains(name, ".") {
    let segs = split(name, ".")
    let hd = segs[0]
    if let Some(k0) = get(r.aliases, hd) {
      var k = k0
      var parts = skip(segs, 1)
      while len(parts) > 1 && contains(gm(l, k).inl, parts[0]) {
        k = sub_mod(l, k, parts[0], 0, r.key)?
        parts = skip(parts, 1)
      }
      if len(parts) == 1 { return export(l, k, parts[0], 0, Some(r.key)) }
    }
    return Ok(name)
  }
  let info = gm(l, r.key)
  if contains(info.types, name) { return Ok(unwrap(get(info.names, name))) }
  if let Some(x) = get(r.imports, name) { return Ok(x) }
  Ok(name)
}

fn tn_v(l: L, r: R, v: V, gens: List<Str>) -> Result<V, ME> {
  let n = type_name(l, r, sv(v), gens)?
  Ok(if n == sv(v) { v } else { VS(n) })
}

fn tns(l: L, r: R, vs: List<V>, gens: List<Str>) -> Result<List<V>, ME> {
  var out: List<V> = []
  for v in vs { out = push(out, tn_v(l, r, v, gens)?) }
  Ok(out)
}

fn rty(l: L, r: R, t: V, gens: List<Str>) -> Result<V, ME> {
  if is_nil(t) { return Ok(t) }
  let xs = items(t)
  let k = sv(xs[0])
  if k == "con" { return Ok(VT([xs[0], tn_v(l, r, xs[1], gens)?, VL(rtys(l, r, items(xs[2]), gens)?), xs[3]])) }
  if k == "tuple" { return Ok(VT([xs[0], VL(rtys(l, r, items(xs[1]), gens)?), xs[2]])) }
  if k == "fn" { return Ok(VT([xs[0], VL(rtys(l, r, items(xs[1]), gens)?), rty(l, r, xs[2], gens)?, xs[3]])) }
  if k == "dyn" || k == "impl" { return Ok(VT([xs[0], VL(tns(l, r, items(xs[1]), gens)?), xs[2]])) }
  if k == "unsafe" { return Ok(VT([xs[0], rty(l, r, xs[1], gens)?, xs[2]])) }
  Ok(t)
}

fn rtys(l: L, r: R, ts: List<V>, gens: List<Str>) -> Result<List<V>, ME> {
  var out: List<V> = []
  for t in ts { out = push(out, rty(l, r, t, gens)?) }
  Ok(out)
}

fn rpat(l: L, r: R, p: V) -> Result<V, ME> {
  let xs = items(p)
  if len(xs) == 0 { return Ok(p) }
  match p {
    VT(_) => (),
    _     => { return Ok(p) },
  }
  let k = sv(xs[0])
  if k == "tuple" { return Ok(VT([xs[0], VL(rpats(l, r, items(xs[1]))?)])) }
  if k == "list" {
    if len(xs) > 3 { return Ok(VT([xs[0], VL(rpats(l, r, items(xs[1]))?), xs[2], VL(rpats(l, r, items(xs[3]))?)])) }
    return Ok(VT([xs[0], VL(rpats(l, r, items(xs[1]))?), xs[2]]))
  }
  if k == "at" { return Ok(VT([xs[0], xs[1], rpat(l, r, xs[2])?])) }
  if k == "variant" {
    let info = gm(l, r.key)
    if is_nil(xs[2]) && is_vs(xs[1]) && contains(info.names, sv(xs[1])) && !is_local(r, sv(xs[1])) {
      return Ok(VT([xs[0], VS(unwrap(get(info.names, sv(xs[1])))), VNil]))
    }
    return Ok(VT([xs[0], xs[1], if is_nil(xs[2]) { xs[2] } else { VL(rpats(l, r, items(xs[2]))?) }]))
  }
  if k == "struct" {
    var fs: List<V> = []
    for f in items(xs[2]) { fs = push(fs, VT([items(f)[0], rpat(l, r, items(f)[1])?])) }
    return Ok(VT([xs[0], tn_v(l, r, xs[1], [])?, VL(fs)]))
  }
  if k == "or" { return Ok(VT([xs[0], VL(rpats(l, r, items(xs[1]))?)])) }
  Ok(p)
}

fn rpats(l: L, r: R, ps: List<V>) -> Result<List<V>, ME> {
  var out: List<V> = []
  for p in ps { out = push(out, rpat(l, r, p)?) }
  Ok(out)
}

fn bind(r: R, p: V) -> R {
  let n = len(r.scopes)
  R { scopes: set(r.scopes, n - 1, r.scopes[n - 1] + pat_binds(p)), ..r }
}

fn push_scope(r: R, s: List<Str>) -> R { R { scopes: push(r.scopes, s), ..r } }

fn pop_scope(r: R) -> R { R { scopes: take(r.scopes, len(r.scopes) - 1), ..r } }

fn rbounds(l: L, r: R, b: V, gens: List<Str>) -> Result<V, ME> {
  var out: List<(Str, V)> = []
  match b {
    VD(kvs) => { for (g, bs) in kvs { out = push(out, (g, VL(tns(l, r, items(bs), gens)?))) } },
    _       => { return Ok(b) },
  }
  Ok(VD(out))
}

fn strl(v: V) -> List<Str> { map(items(v), sv) }

fn top(l: L, r0: R, it: V) -> Result<(R, V), ME> {
  var r = r0
  let k = kind(it)
  let gens = strl(fld(it, "generics"))
  var x = it
  let info = gm(l, r.key)
  if (k == "Struct" || k == "Enum" || k == "Alias") && len(ast.dpairs(fld(it, "bounds"))) > 0 {
    x = with(x, "bounds", rbounds(l, r, fld(x, "bounds"), gens)?)
  }
  if k == "Fn" {
    x = with(x, "name", VS(value(l, r, sv(fld(x, "name")))))
    return rfn(l, r, x, [])
  }
  if k == "Struct" {
    var fs: List<V> = []
    for f in items(fld(x, "fields")) { fs = push(fs, VT([items(f)[0], rty(l, r, items(f)[1], gens)?])) }
    return Ok((r, with(with(x, "name", VS(unwrap(get(info.names, sv(fld(x, "name")))))), "fields", VL(fs))))
  }
  if k == "Enum" {
    var vs: List<V> = []
    for v in items(fld(x, "variants")) {
      let vx = items(v)
      let fs = vx[1]
      let nf = match fs {
        VL(xs) => VL(rfields(l, r, xs, gens)?),
        VR(xs) => VR(rfields(l, r, xs, gens)?),
        _      => fs,
      }
      vs = push(vs, VT([vx[0], nf]))
    }
    return Ok((r, with(with(x, "name", VS(unwrap(get(info.names, sv(fld(x, "name")))))), "variants", VL(vs))))
  }
  if k == "Alias" {
    return Ok((r, with(with(x, "name", VS(unwrap(get(info.names, sv(fld(x, "name")))))), "target", rty(l, r, fld(x, "target"), gens)?)))
  }
  if k == "Trait" {
    x = with(x, "name", VS(unwrap(get(info.names, sv(fld(x, "name"))))))
    var assoc: List<V> = []
    for a in items(fld(x, "assoc")) {
      let ax = items(a)
      assoc = push(assoc, VT([ax[0], VL(tns(l, r, items(ax[1]), [])?), rty(l, r, ax[2], ["Self"])?]))
    }
    x = with(with(x, "assoc", VL(assoc)), "supers", VL(tns(l, r, items(fld(x, "supers")), [])?))
    var cs: List<V> = []
    for c in items(fld(x, "consts")) {
      let cx = items(c)
      let (r1, ev) = if is_nil(cx[2]) { (r, VNil) } else { rexpr(l, r, cx[2])? }
      r = r1
      cs = push(cs, VT([cx[0], rty(l, r, cx[1], ["Self"])?, ev, cx[3]]))
    }
    x = with(x, "consts", VL(cs))
    var ms: List<V> = []
    for m in items(fld(x, "methods")) {
      let (r2, mv) = rfn(l, r, m, ["Self"])?
      r = r2
      ms = push(ms, mv)
    }
    return Ok((r, with(x, "methods", VL(ms))))
  }
  if k == "Impl" { return rimpl(l, r, x) }
  if k == "Let" {
    let (r1, v) = rexpr(l, r, fld(x, "value"))?
    r = r1
    let p = rpat(l, r, fld(x, "pat"))?
    return Ok((r, with(with(with(x, "value", v), "ty", rty(l, r, fld(x, "ty"), [])?), "pat", top_pat(info, p))))
  }
  if k == "Use" || k == "Mod" { return Ok((r, x)) }
  r = push_scope(r, [])
  let (r3, sx) = rstmt(l, r, x)?
  Ok((pop_scope(r3), sx))
}

fn rfields(l: L, r: R, xs: List<V>, gens: List<Str>) -> Result<List<V>, ME> {
  var out: List<V> = []
  for f in xs { out = push(out, VT([items(f)[0], rty(l, r, items(f)[1], gens)?])) }
  Ok(out)
}

fn top_pat(info: Mod, p: V) -> V {
  let xs = items(p)
  if len(xs) == 0 { return p }
  let k = sv(xs[0])
  if k == "bind" { return VT(push([], xs[0]) + [VS(unwrap_or(get(info.names, sv(xs[1])), sv(xs[1])))] + skip(xs, 2)) }
  if k == "or" { return VT([xs[0], VL(map(items(xs[1]), (q) => top_pat(info, q)))]) }
  if k == "at" { return VT([xs[0], top_pat(info, xs[1]), top_pat(info, xs[2])]) }
  if k == "tuple" { return VT([xs[0], VL(map(items(xs[1]), (q) => top_pat(info, q)))]) }
  if k == "list" {
    let rest = if is_nil(xs[2]) || sv(xs[2]) == "" { xs[2] } else { VS(unwrap_or(get(info.names, sv(xs[2])), sv(xs[2]))) }
    let a = VL(map(items(xs[1]), (q) => top_pat(info, q)))
    if len(xs) > 3 { return VT([xs[0], a, rest, VL(map(items(xs[3]), (q) => top_pat(info, q)))]) }
    return VT([xs[0], a, rest])
  }
  if k == "variant" { return VT([xs[0], xs[1], if is_nil(xs[2]) { xs[2] } else { VL(map(items(xs[2]), (q) => top_pat(info, q))) }]) }
  if k == "struct" { return VT([xs[0], xs[1], VL(map(items(xs[2]), (f) => VT([items(f)[0], top_pat(info, items(f)[1])])))]) }
  p
}

fn rimpl(l: L, r0: R, it: V) -> Result<(R, V), ME> {
  var r = r0
  let gens = strl(fld(it, "generics"))
  let gs = push(gens, "Self")
  var x = with(it, "target", tn_v(l, r, fld(it, "target"), gens)?)
  x = with(x, "target_t", rty(l, r, fld(x, "target_t"), gens)?)
  if !is_nil(fld(x, "trait")) { x = with(x, "trait", tn_v(l, r, fld(x, "trait"), gens)?) }
  var assoc: List<V> = []
  for a in items(fld(x, "assoc")) { assoc = push(assoc, VT([items(a)[0], rty(l, r, items(a)[1], gs)?])) }
  x = with(x, "assoc", VL(assoc))
  var ms: List<V> = []
  for m in items(fld(x, "methods")) {
    let (r1, mv) = rfn(l, r, m, gs)?
    r = r1
    ms = push(ms, mv)
  }
  x = with(x, "methods", VL(ms))
  var cs: List<V> = []
  for c in items(fld(x, "consts")) {
    let cx = items(c)
    let (r2, ev) = if is_nil(cx[2]) { (r, VNil) } else { rexpr(l, r, cx[2])? }
    r = r2
    cs = push(cs, VT([cx[0], rty(l, r, cx[1], gs)?, ev, cx[3]]))
  }
  Ok((r, with(x, "consts", VL(cs))))
}

fn rfn(l: L, r0: R, f: V, outer: List<Str>) -> Result<(R, V), ME> {
  var r = r0
  let gens = outer + strl(fld(f, "generics"))
  var ps: List<V> = []
  for p in items(fld(f, "params")) { ps = push(ps, VT([items(p)[0], rty(l, r, items(p)[1], gens)?])) }
  var x = with(with(f, "params", VL(ps)), "ret", rty(l, r, fld(f, "ret"), gens)?)
  if len(ast.dpairs(fld(f, "bounds"))) > 0 { x = with(x, "bounds", rbounds(l, r, fld(f, "bounds"), gens)?) }
  if !is_nil(fld(f, "body")) {
    r = push_scope(r, map(ps, (p) => sv(items(p)[0])))
    r = R { gens: gens, ..r }
    let (r1, b) = rexpr(l, r, fld(x, "body"))?
    r = pop_scope(r1)
    x = with(x, "body", b)
  }
  Ok((r, x))
}

fn rblock(l: L, r0: R, b: V) -> Result<(R, V), ME> {
  let ss = items(fld(b, "stmts"))
  var r = push_scope(r0, map(filter(ss, (s) => decl_named(kind(s))), (s) => sv(fld(s, "name"))))
  var out: List<V> = []
  for s in ss {
    let (r1, v) = rstmt(l, r, s)?
    r = r1
    out = push(out, v)
  }
  Ok((pop_scope(r), with(b, "stmts", VL(out))))
}

fn rx(l: L, r: R, e: V) -> Result<(R, V), ME> {
  if is_nil(e) { return Ok((r, e)) }
  rexpr(l, r, e)
}

fn rstmt(l: L, r0: R, s: V) -> Result<(R, V), ME> {
  var r = r0
  let k = kind(s)
  if k == "Let" {
    let (r1, v) = rexpr(l, r, fld(s, "value"))?
    r = r1
    let p = rpat(l, r, fld(s, "pat"))?
    let x = with(with(with(s, "value", v), "ty", rty(l, r, fld(s, "ty"), r.gens)?), "pat", p)
    return Ok((bind(r, p), x))
  }
  if k == "Fn" { return rfn(l, r, s, r.gens) }
  if k == "Impl" { return rimpl(l, r, s) }
  if contains(["Struct", "Enum", "Alias", "Trait", "Use", "Mod"], k) { return Ok((r, s)) }
  if k == "ExprStmt" {
    let (r1, v) = rexpr(l, r, fld(s, "expr"))?
    return Ok((r1, with(s, "expr", v)))
  }
  if k == "Assign" {
    let (r1, t) = rexpr(l, r, fld(s, "target"))?
    let (r2, v) = rexpr(l, r1, fld(s, "value"))?
    return Ok((r2, with(with(s, "target", t), "value", v)))
  }
  if k == "Return" || k == "Break" || k == "Continue" {
    let (r1, v) = rx(l, r, fld(s, "value"))?
    return Ok((r1, if is_nil(fld(s, "value")) { s } else { with(s, "value", v) }))
  }
  if k == "Defer" {
    let (r1, v) = rexpr(l, r, fld(s, "body"))?
    return Ok((r1, with(s, "body", v)))
  }
  if k == "For" {
    let (r1, it) = rexpr(l, r, fld(s, "iter"))?
    let p = rpat(l, r1, fld(s, "pat"))?
    r = bind(push_scope(r1, []), p)
    let (r2, b) = rexpr(l, r, fld(s, "body"))?
    return Ok((pop_scope(r2), with(with(with(s, "iter", it), "pat", p), "body", b)))
  }
  if k == "While" {
    let (r1, c) = rx(l, r, fld(s, "cond"))?
    let (r2, b) = rexpr(l, r1, fld(s, "body"))?
    return Ok((r2, with(with(s, "cond", if is_nil(fld(s, "cond")) { VNil } else { c }), "body", b)))
  }
  let (r3, _) = rexpr(l, r, s)?
  Ok((r3, s))
}

fn rexpr(l: L, r: R, e: V) -> Result<(R, V), ME> {
  let (r1, v, _) = rexpr_m(l, r, e)?
  Ok((r1, v))
}

// 第三个结果：内联子模块引用 a.b 的模块 key（Python 版的 _modkey），否则 "#"
fn rexpr_m(l: L, r0: R, e: V) -> Result<(R, V, Str), ME> {
  var r = r0
  let k = kind(e)
  if k == "" { return Ok((r, e, "#")) }
  let ln = line(e)
  if k == "Name" { return Ok((r, with(e, "name", VS(value(l, r, sv(fld(e, "name"))))), "#")) }
  if k == "Field" {
    let o = fld(e, "obj")
    let fname = sv(fld(e, "name"))
    if kind(o) == "Name" && !is_local(r, sv(fld(o, "name"))) && contains(r.aliases, sv(fld(o, "name"))) {
      let ak = unwrap(get(r.aliases, sv(fld(o, "name"))))
      if contains(gm(l, ak).inl, fname) {
        let mk = sub_mod(l, ak, fname, ln, r.key)?
        return Ok((r, nd("Field", ln, [("obj", o), ("name", VS(fname))]), mk))
      }
      return Ok((r, nd("Name", ln, [("name", VS(export(l, ak, fname, ln, Some(r.key))?))]), "#"))
    }
    if kind(o) == "Field" {
      let (r1, o2, mk0) = rexpr_m(l, r, o)?
      if mk0 != "#" {
        if contains(gm(l, mk0).inl, fname) {
          let mk = sub_mod(l, mk0, fname, ln, r.key)?
          return Ok((r1, nd("Field", ln, [("obj", o2), ("name", VS(fname))]), mk))
        }
        return Ok((r1, nd("Name", ln, [("name", VS(export(l, mk0, fname, ln, Some(r.key))?))]), "#"))
      }
      return Ok((r1, with(e, "obj", o2), "#"))
    }
    let (r2, o3) = rexpr(l, r, o)?
    return Ok((r2, with(e, "obj", o3), "#"))
  }
  if k == "Block" {
    let (r1, b) = rblock(l, r, e)?
    return Ok((r1, b, "#"))
  }
  if k == "TypeApp" {
    let (r1, f) = rexpr(l, r, fld(e, "fn"))?
    var ts: List<V> = []
    for t in items(fld(e, "targs")) { ts = push(ts, if is_nil(t) { t } else { rty(l, r1, t, r1.gens)? }) }
    return Ok((r1, with(with(e, "fn", f), "targs", VL(ts)), "#"))
  }
  if k == "Lambda" {
    var ps: List<V> = []
    for p in items(fld(e, "params")) { ps = push(ps, VT([items(p)[0], rty(l, r, items(p)[1], r.gens)?])) }
    r = push_scope(r, map(ps, (p) => sv(items(p)[0])))
    let (r1, b) = rexpr(l, r, fld(e, "body"))?
    return Ok((pop_scope(r1), with(with(e, "params", VL(ps)), "body", b), "#"))
  }
  if k == "Match" {
    let (r1, subj) = rexpr(l, r, fld(e, "subject"))?
    r = r1
    var arms: List<V> = []
    for a in items(fld(e, "arms")) {
      let ax = items(a)
      let p = rpat(l, r, ax[0])?
      r = bind(push_scope(r, []), p)
      let (r2, g) = rx(l, r, ax[1])?
      let (r3, b) = rx(l, r2, ax[2])?
      r = pop_scope(r3)
      arms = push(arms, VT([p, g, b]))
    }
    let e2 = with(with(e, "subject", subj), "arms", VL(arms))
    // let … else：let_else 和第二个分支的块是同一个对象（Python 版就地解析，两处一起变）
    if !is_nil(fld(e, "let_else")) && len(arms) == 2 { return Ok((r, with(e2, "let_else", items(arms[1])[2]), "#")) }
    return Ok((r, e2, "#"))
  }
  if k == "Select" {
    var arms: List<V> = []
    for a in items(fld(e, "arms")) {
      let ax = items(a)
      let (r1, av) = rx(l, r, ax[1])?
      let (r2, bv) = rx(l, r1, ax[2])?
      let (r3, gv) = rx(l, r2, ax[4])?
      r = push_scope(r3, [])
      var p = ax[3]
      if !is_nil(p) {
        p = rpat(l, r, p)?
        r = bind(r, p)
      }
      let (r4, body) = rx(l, r, ax[5])?
      r = pop_scope(r4)
      arms = push(arms, VT([ax[0], av, bv, p, gv, body]))
    }
    return Ok((r, with(e, "arms", VL(arms)), "#"))
  }
  if k == "Is" {
    let (r1, v) = rexpr(l, r, fld(e, "value"))?
    return Ok((r1, with(with(e, "value", v), "pat", rpat(l, r1, fld(e, "pat"))?), "#"))
  }
  if k == "StructLit" {
    let nm = tn_v(l, r, fld(e, "name"), [])?
    var fs: List<V> = []
    for f in items(fld(e, "fields")) {
      let (r1, v) = rexpr(l, r, items(f)[1])?
      r = r1
      fs = push(fs, VT([items(f)[0], v]))
    }
    var x = with(with(e, "name", nm), "fields", VL(fs))
    if !is_nil(fld(e, "base")) {
      let (r2, b) = rexpr(l, r, fld(e, "base"))?
      r = r2
      x = with(x, "base", b)
    }
    return Ok((r, x, "#"))
  }
  if k == "Interp" {
    var ps: List<V> = []
    for p in items(fld(e, "parts")) {
      if is_vs(p) {
        ps = push(ps, p)
      } else {
        let (r1, v) = rexpr(l, r, p)?
        r = r1
        ps = push(ps, v)
      }
    }
    return Ok((r, with(e, "parts", VL(ps)), "#"))
  }
  if contains(["Let", "Assign", "Return", "Defer", "For", "While", "ExprStmt", "Break", "Continue", "Fn", "Impl", "Struct", "Enum", "Alias", "Trait", "Use", "Mod"], k) {
    let (r1, v) = rstmt(l, r, e)?
    return Ok((r1, v, "#"))
  }
  match e {
    VN(kk, ll, m) => {
      var m2 = m
      for key in keys(m) {
        let v = unwrap(get(m, key))
        match v {
          VN(_, _, _) => {
            let (r1, nv) = rexpr(l, r, v)?
            r = r1
            m2 = set(m2, key, nv)
          },
          VL(xs)      => {
            if len(xs) > 0 && all(xs, (x) => kind(x) != "") {
              var ys: List<V> = []
              for x in xs {
                let (r1, y) = rexpr(l, r, x)?
                r = r1
                ys = push(ys, y)
              }
              m2 = set(m2, key, VL(ys))
            }
          },
          _           => (),
        }
      }
      Ok((r, VN(kk, ll, m2), "#"))
    },
    _             => Ok((r, e, "#")),
  }
}

// ── 顶层 const 按依赖排序（order_consts）──

fn refs(x: V, owner: Map<Str, Int>, acc0: List<Int>) -> List<Int> {
  var acc = acc0
  match x {
    VN(k, _, m) => {
      if k == "Name" {
        if let Some(i) = get(owner, sv(unwrap_or(get(m, "name"), VNil))) { if !contains(acc, i) { acc = push(acc, i) } }
      }
      for key in keys(m) { acc = refs(unwrap(get(m, key)), owner, acc) }
      acc
    },
    VL(xs)      => {
      for y in xs { acc = refs(y, owner, acc) }
      acc
    },
    VR(xs)      => {
      for y in xs { acc = refs(y, owner, acc) }
      acc
    },
    VT(xs)      => {
      for y in xs { acc = refs(y, owner, acc) }
      acc
    },
    VD(kvs)     => {
      for kv in kvs { acc = refs(kv.1, owner, acc) }
      acc
    },
    _           => acc,
  }
}

fn order_consts(its: List<V>) -> List<V> {
  var idx: List<Int> = []
  var i = 0
  for it in its {
    if kind(it) == "Let" { idx = push(idx, i) }
    i += 1
  }
  if len(idx) < 2 { return its }
  if any(its, (it) => !(decl_named(kind(it)) || contains(["Impl", "Use", "Mod", "Let"], kind(it)))) { return its }
  if any(idx, (j) => !ast.truthy(fld(its[j], "is_const"))) { return its }
  let consts = map(idx, (j) => its[j])
  var owner: Map<Str, Int> = Map()
  var ci = 0
  for c in consts {
    for nm in pat_binds(fld(c, "pat")) { owner = set(owner, nm, ci) }
    ci += 1
  }
  let deps = map(consts, (c) => refs(fld(c, "value"), owner, []))
  var done: List<Int> = []
  var busy: List<Int> = []
  var out: List<Int> = []
  ci = 0
  while ci < len(consts) {
    let (d1, b1, o1) = visit(ci, deps, done, busy, out)
    done = d1
    busy = b1
    out = o1
    ci += 1
  }
  let rest = filter(its, (it) => kind(it) != "Let")
  var first = 0
  var j = 0
  while j < idx[0] {
    if kind(its[j]) != "Let" { first += 1 }
    j += 1
  }
  take(rest, first) + map(out, (n) => consts[n]) + skip(rest, first)
}

fn visit(c: Int, deps: List<List<Int>>, done0: List<Int>, busy0: List<Int>, out0: List<Int>) -> (List<Int>, List<Int>, List<Int>) {
  if contains(done0, c) || contains(busy0, c) { return (done0, busy0, out0) }
  var done = done0
  var busy = push(busy0, c)
  var out = out0
  var d = 0
  while d < len(deps) {
    if contains(deps[c], d) {
      let (d1, b1, o1) = visit(d, deps, done, busy, out)
      done = d1
      busy = b1
      out = o1
    }
    d += 1
  }
  (push(done, c), filter(busy, (x) => x != c), push(out, c))
}

// 函数体里 mod / use 提升后的内部名字 __lm<N>_ / __lmu<N>_，报错时还原（kite.py 的 KiteError）
pub fn strip_lm(msg: Str) -> Str {
  var out = ""
  var i = 0
  let n = len(msg)
  while i < n {
    if __str_slice(msg, i, i + 4) == "__lm" {
      var j = i + 4
      if j < n && __str_slice(msg, j, j + 1) == "u" { j += 1 }
      let d0 = j
      while j < n && __ord(__str_slice(msg, j, j + 1)) >= 48 && __ord(__str_slice(msg, j, j + 1)) <= 57 { j += 1 }
      if j > d0 && j < n && __str_slice(msg, j, j + 1) == "_" {
        i = j + 1
        continue
      }
    }
    out = out + __str_slice(msg, i, i + 1)
    i += 1
  }
  out
}
