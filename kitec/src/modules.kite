// Kite 自举编译器：模块系统（对应 modules.py 的 Loader / Resolver，逐条移植）
// 把程序及其引用的模块解析、改名、拼接成一个扁平的程序；行号编码为 文件序号 * LINE_BASE + 行
// 输入输出都是强类型语法树 ast.Node
use std.fs
use std.path
use std.kite.ast as ast
use std.kite.ast.{
  Node,
  K,
  Lit,
  Nm,
  TyX,
  Pat,
  Attr,
  Vis,
  EvF,
  UseP,
  IPart,
  AConst,
  TAssoc,
  Arm,
  SArm,
  Gen,
  FnD,
  ImplD,
  TraitD,
  MatchD,
}
use builtins
use std.kite.scanner as lexer
use std.kite.parser as parser

pub const LINE_BASE: Int = 1000000

pub type Pkg = { name: Str, root: Str, src: Str, prefix: Str, deps: List<Str> }

pub type Mod = {
  key: Str,
  prefix: Str,
  path: Str,
  pkg: Pkg,
  items: List<Node>,
  names: Map<Str, Str>,
  pubs: Map<Str, Bool>,
  vis: Map<Str, Str>,
  types: Map<Str, Bool>,
  deps: List<Str>,
  inl: Map<Str, Str>,
  inl_pub: Map<Str, Bool>,
  parent: Str?,
  children: List<Str>,
}

// 错误：ln = -1 未支持，ln = -2 被导入文件的语法错误
pub type ME = { ln: Int, msg: Str }

pub type L = {
  mods: Map<Str, Mod>,
  order: List<Str>,
  loading: List<Str>,
  nfiles: Int,
  files: List<Str>,
  by_path: Map<Str, Str>,
  main: Str,
  root: Pkg,
  cwd: Str,
  kdir: Str,
  lm: Int,
  dtab: Map<Str, Pkg>,
  dunsup: Str,
  ov: Str,
  ovsrc: Str,
  ren: Map<Str, Bool>,
}

fn me(ln: Int, msg: Str) -> ME { ME { ln: ln, msg: msg } }

fn me(ln: Int, msg: Str) -> ME { ME { ln: ln, msg: msg } }

fn decl_named(k: K) -> Bool {
  match k {
    NFn(_) => true,
    NStruct(..) => true,
    NEnum(..) => true,
    NTrait(_) => true,
    NAlias(..) => true,
    _ => false,
  }
}

// 声明的名字（Fn / Struct / Enum / Trait / Alias / Mod）
pub fn decl_name(n: Node) -> Str {
  match n.k {
    NFn(f) => f.name,
    NStruct(m, _, _) => m,
    NEnum(m, _, _) => m,
    NTrait(t) => t.name,
    NAlias(m, _, _) => m,
    NMod(m, _) => unwrap_or(m, ""),
    _ => "",
  }
}

fn is_pub(n: Node) -> Bool {
  match n.vis {
    Some(v) => v.is_pub,
    None => false,
  }
}

fn builtin_set() -> Map<Str, Bool> {
  var m: Map<Str, Bool> = Map()
  for (n, _, _) in builtins.builtin_sigs() { m = set(m, n, true) }
  m
}

fn mangle(prefix: Str, name: Str) -> Str { if prefix == "" { name } else { prefix + "." + name } }

fn new_mod(key: Str, path: Str, pkg: Pkg) -> Mod {
  Mod {
    key: key,
    prefix: key,
    path: path,
    pkg: pkg,
    items: [],
    names: Map(),
    pubs: Map(),
    vis: Map(),
    types: Map(),
    deps: [],
    inl: Map(),
    inl_pub: Map(),
    parent: None,
    children: [],
  }
}

fn gm(l: L, key: Str) -> Mod { unwrap(get(l.mods, key)) }

fn pm(l: L, m: Mod) -> L { L { mods: set(l.mods, m.key, m), ..l } }

pub fn pat_binds(p: Pat) -> List<Str> {
  match p {
    PBind(n) => [ast.nm_str(n)],
    PVar(n) => [ast.nm_str(n)],
    PTuple(xs) => binds_of(xs),
    PList(pre, rest, post) => {
      var out = binds_of(pre)
      if let Some(r) = rest { if r != "_" && r != "" { out = push(out, r) } }
      out + binds_of(post)
    },
    PVariant(_, Some(xs)) => binds_of(xs),
    PStruct(_, fs) => binds_of(map(fs, (f) => f.1)),
    POr(xs) => pat_binds(xs[0]),
    PAt(a, b) => pat_binds(a) + pat_binds(b),
    _ => [],
  }
}

fn binds_of(ps: List<Pat>) -> List<Str> {
  var out: List<Str> = []
  for x in ps { out = out + pat_binds(x) }
  out
}

fn use_name(e: (Str, Str?)) -> (Str, Str) { (e.0, unwrap_or(e.1, e.0)) }

fn up_s(u: UseP) -> Str {
  match u {
    UName(s) => s,
    UGroup(_) => "",
  }
}

fn is_vs(u: UseP) -> Bool {
  match u {
    UName(_) => true,
    UGroup(_) => false,
  }
}

fn use_path(n: Node) -> List<UseP> {
  match n.k {
    NUse(p, _) => p,
    _ => [],
  }
}

fn use_alias(n: Node) -> Str? {
  match n.k {
    NUse(_, a) => a,
    _ => None,
  }
}

fn is_use(n: Node) -> Bool {
  match n.k {
    NUse(..) => true,
    _ => false,
  }
}

fn is_let(n: Node) -> Bool {
  match n.k {
    NLet(..) => true,
    _ => false,
  }
}

// 带内容的内联 mod
fn inline_mod(n: Node) -> List<Node>? {
  match n.k {
    NMod(_, its) => its,
    _ => None,
  }
}

// ── 路径 ──

fn abspath(cwd: Str, p: Str) -> Str {
  if path.is_abs(p) { path.clean(p) } else { path.join([cwd, p]) }
}

fn dirname(p: Str) -> Str { path.dir(p) }

fn relpath(cwd: Str, p: Str) -> Str {
  let a = filter(split(p, "/"), (s) => s != "")
  let b = filter(split(cwd, "/"), (s) => s != "")
  var i = 0
  while i < len(a) && i < len(b) && a[i] == b[i] { i += 1 }
  var parts: List<Str> = []
  var j = i
  while j < len(b) {
    parts = push(parts, "..")
    j += 1
  }
  parts = parts + skip(a, i)
  if len(parts) == 0 { "." } else { join(parts, "/") }
}

fn is_file(p: Str) -> Bool { fs.is_file(p) }

// ── 包 ──

fn manifest_name(root: Str) -> (Str, Bool) {
  let src = match fs.read(path.join([root, "kite.toml"])) {
    Ok(s) => s,
    Err(_) => "",
  }
  var name = ""
  var sect = ""
  var deps = false
  for raw in split(src, "\n") {
    let ln = trim(raw)
    if starts_with(ln, "[") {
      sect = ln
      continue
    }
    if ln == "" || starts_with(ln, "#") { continue }
    if sect == "[package]" && starts_with(ln, "name") {
      let ps = split(ln, "\"")
      if len(ps) >= 2 { name = ps[1] }
    }
    if sect == "[dependencies]" { deps = true }
  }
  (name, deps)
}

fn infer_package(cwd: Str, main: Str) -> Pkg {
  let d = dirname(main)
  var root = d
  var found = false
  var go = true
  while go {
    if fs.exists(path.join([root, "kite.toml"])) {
      found = true
      go = false
    } else {
      let parent = dirname(root)
      if parent == root { go = false } else { root = parent }
    }
  }
  if !found { return Pkg { name: "", root: d, src: d, prefix: "", deps: [] } }
  let src = path.join([root, "src"])
  let (name, deps) = manifest_name(root)
  Pkg {
    name: name,
    root: root,
    src: if fs.is_dir(src) { src } else { d },
    prefix: "",
    deps: if deps { ["?"] } else { [] },
  }
}

// 依赖表：读 kite.lock（由 Python 包管理器 kite get 生成），名字 → Pkg；所有依赖共享同一张表
fn dep_table(root: Str) -> Result<Map<Str, Pkg>, Str> {
  let src = match fs.read(path.join([root, "kite.lock"])) {
    Ok(s) => s,
    Err(_) => { return Err("依赖包（还没有 kite.lock，先运行 kite get）") },
  }
  var ents: List<(Str, Str, Str)> = []
  var nm = ""
  var ver = ""
  var srcv = ""
  var inpkg = false
  for raw in split(src + "\n[[end]]", "\n") {
    let ln = trim(raw)
    if starts_with(ln, "[") {
      if inpkg && nm != "" { ents = push(ents, (nm, ver, srcv)) }
      inpkg = ln == "[[package]]"
      nm = ""
      ver = ""
      srcv = ""
      continue
    }
    let ps = split(ln, "\"")
    if len(ps) < 2 { continue }
    let key = trim(ps[0])
    if key == "name =" { nm = ps[1] }
    if key == "version =" { ver = ps[1] }
    if key == "source =" { srcv = ps[1] }
  }
  let names = map(ents, (e) => e.0)
  var tab: Map<Str, Pkg> = Map()
  for (n, v, sv) in ents {
    let d = if starts_with(sv, "path+") {
      path.clean(path.join([root, __str_slice(sv, 5, len(sv))]))
    } else {
      path.join([root, ".kite", "deps", n + "-" + v])
    }
    if !fs.is_dir(d) { return Err("依赖包 {n} 还没安装（先运行 kite get）") }
    tab = set(tab, n, Pkg { name: n, root: d, src: path.join([d, "src"]), prefix: n, deps: names })
  }
  Ok(tab)
}

pub fn new_l(cwd: Str, main: Str, kite_dir: Str) -> L {
  let mp = abspath(cwd, main)
  let rp0 = infer_package(cwd, mp)
  var rp = rp0
  var dtab: Map<Str, Pkg> = Map()
  var dun = ""
  if len(rp0.deps) > 0 {
    match dep_table(rp0.root) {
      Ok(t) => {
        dtab = t
        rp = Pkg { deps: keys(t), ..rp0 }
      },
      Err(m) => { dun = m },
    }
  }
  L {
    dtab: dtab,
    dunsup: dun,
    mods: Map(),
    order: [],
    loading: [],
    nfiles: 0,
    files: [],
    by_path: Map(),
    main: mp,
    root: rp,
    cwd: cwd,
    kdir: kite_dir,
    lm: 0,
    ov: "",
    ovsrc: "",
    ren: Map(),
  }
}

// ── 改名（_rename_mod）：语法树里所有字符串都过一遍（Python 版遍历 __dict__ 的全部字段）──

type Rn = { old: Str, new: Str, pre: Str, exact: Bool }

fn rs(r: Rn, s: Str) -> Str {
  if r.exact && s == r.old { return r.new }
  if starts_with(s, r.pre) { return r.new + "." + __str_slice(s, len(r.pre), len(s)) }
  s
}

fn rso(r: Rn, s: Str?) -> Str? {
  match s {
    Some(x) => Some(rs(r, x)),
    None => None,
  }
}

fn rnm(r: Rn, n: Nm) -> Nm {
  match n {
    NmS(s) => NmS(rs(r, s)),
    NmQ(s, Some(q)) => if q == r.old || starts_with(q, r.pre) {
      NmQ(s, Some(r.new + __str_slice(q, len(r.old), len(q))))
    } else {
      n
    },
    _ => n,
  }
}

fn rlit(r: Rn, l: Lit) -> Lit {
  match l {
    LStr(s) => LStr(rs(r, s)),
    _ => l,
  }
}

fn rlito(r: Rn, l: Lit?) -> Lit? {
  match l {
    Some(x) => Some(rlit(r, x)),
    None => None,
  }
}

fn rt(r: Rn, t: TyX) -> TyX {
  match t {
    YCon(n, a, l) => YCon(rs(r, n), map(a, (x) => rt(r, x)), l),
    YTup(a, l) => YTup(map(a, (x) => rt(r, x)), l),
    YDyn(bs, l) => YDyn(map(bs, (b) => rs(r, b)), l),
    YImpl(bs, l) => YImpl(map(bs, (b) => rs(r, b)), l),
    YUnsafe(x, l) => YUnsafe(rt(r, x), l),
    YFn(a, b, l) => YFn(map(a, (x) => rt(r, x)), rt(r, b), l),
  }
}

fn rto(r: Rn, t: TyX?) -> TyX? {
  match t {
    Some(x) => Some(rt(r, x)),
    None => None,
  }
}

fn rp(r: Rn, p: Pat) -> Pat {
  match p {
    PBind(n) => PBind(rnm(r, n)),
    PVar(n) => PVar(rnm(r, n)),
    PLit(l) => PLit(rlit(r, l)),
    PRange(lo, hi, inc) => PRange(rlito(r, lo), rlito(r, hi), inc),
    PTuple(xs) => PTuple(map(xs, (x) => rp(r, x))),
    PList(pre, rest, post) => PList(
      map(pre, (x) => rp(r, x)),
      rso(r, rest),
      map(post, (x) => rp(r, x)),
    ),
    PVariant(n, subs) => PVariant(rnm(r, n), match subs {
      Some(xs) => Some(map(xs, (x) => rp(r, x))),
      None => None,
    }),
    PStruct(n, fs) => PStruct(rnm(r, n), map(fs, (f) => (rs(r, f.0), rp(r, f.1)))),
    POr(xs) => POr(map(xs, (x) => rp(r, x))),
    PAt(a, b) => PAt(rp(r, a), rp(r, b)),
    _ => p,
  }
}

fn rpo(r: Rn, p: Pat?) -> Pat? {
  match p {
    Some(x) => Some(rp(r, x)),
    None => None,
  }
}

fn rparams(r: Rn, ps: List<(Str, TyX?)>) -> List<(Str, TyX?)> {
  map(ps, (p) => (rs(r, p.0), rto(r, p.1)))
}

fn rgen(r: Rn, g: Gen) -> Gen {
  Gen {
    names: map(g.names, (x) => rs(r, x)),
    bounds: map(g.bounds, (b) => (b.0, map(b.1, (t) => rt(r, t)))),
    cgens: map(g.cgens, (x) => rs(r, x)),
  }
}

fn rconst(r: Rn, c: AConst) -> AConst { AConst { name: rs(r, c.name), ty: rt(r, c.ty), ..c } }

fn rk(r: Rn, k: K) -> K {
  match k {
    NFn(f) => NFn(FnD {
      name: rs(r, f.name),
      params: rparams(r, f.params),
      ret: rto(r, f.ret),
      gen: rgen(r, f.gen),
      ext: match f.ext {
        Some(ls) => Some(map(ls, (x) => rs(r, x))),
        None => None,
      },
      cname: rso(r, f.cname),
      ..f
    }),
    NStruct(n, fs, g) => NStruct(rs(r, n), rparams(r, fs), rgen(r, g)),
    NAlias(n, t, g) => NAlias(rs(r, n), rt(r, t), rgen(r, g)),
    NEnum(n, vs, g) => NEnum(
      rs(r, n),
      map(vs, (v) => (rs(r, v.0), match v.1 {
        EvList(l) => EvList(map(l, (f) => (rs(r, f.0), rt(r, f.1)))),
        EvRec(l) => EvRec(map(l, (f) => (rs(r, f.0), rt(r, f.1)))),
        EvNone => EvNone,
      })),
      rgen(r, g),
    ),
    NTrait(t) => NTrait(TraitD {
      name: rs(r, t.name),
      assoc: map(t.assoc, (a) => TAssoc {
        name: rs(r, a.name),
        bounds: map(a.bounds, (b) => rs(r, b)),
        dflt: rto(r, a.dflt),
      }),
      supers: map(t.supers, (x) => rs(r, x)),
      consts: map(t.consts, (c) => rconst(r, c)),
      ..t
    }),
    NImpl(d) => NImpl(ImplD {
      tr: rto(r, d.tr),
      target: rs(r, d.target),
      target_t: rt(r, d.target_t),
      gen: rgen(r, d.gen),
      assoc: map(d.assoc, (a) => (rs(r, a.0), rt(r, a.1))),
      consts: map(d.consts, (c) => rconst(r, c)),
      ..d
    }),
    NUse(p, a) => {
      let p1 = if len(p) > 0 && up_s(p[0]) == r.old && is_vs(p[0]) {
        push([], UName(r.new)) + skip(p, 1)
      } else {
        p
      }
      NUse(
        map(p1, (u) => match u {
          UName(s) => UName(rs(r, s)),
          UGroup(g) => UGroup(map(g, (e) => (rs(r, e.0), rso(r, e.1)))),
        }),
        rso(r, a),
      )
    },
    NMod(n, its) => NMod(rso(r, n), its),
    NLet(p, m, t, v, ic) => NLet(rp(r, p), m, rto(r, t), v, ic),
    NBreak(l, v, b) => NBreak(rso(r, l), v, b),
    NContinue(l) => NContinue(rso(r, l)),
    NFor(p, it, b) => NFor(rp(r, p), it, b),
    NLoop(b, l) => NLoop(b, rso(r, l)),
    NAssign(t, op, v) => NAssign(t, rs(r, op), v),
    NLit(l) => NLit(rlit(r, l)),
    NName(s) => NName(rs(r, if s == r.old { r.new } else { s })),
    NBin(op, a, b) => NBin(rs(r, op), a, b),
    NUnary(op, x, pos) => NUnary(rs(r, op), x, pos),
    NCast(v, t) => NCast(v, rt(r, t)),
    NIs(v, p) => NIs(v, rp(r, p)),
    NTypeApp(f, ts) => NTypeApp(f, map(ts, (t) => rto(r, t))),
    NField(o, s) => NField(o, rnm(r, s)),
    NInterp(ps) => NInterp(map(ps, (p) => match p {
      IStr(s) => IStr(rs(r, s)),
      IExpr(e) => IExpr(e),
    })),
    NLambda(ps, b, ctx) => NLambda(rparams(r, ps), b, rso(r, ctx)),
    NStructLit(n, fs, b) => NStructLit(rnm(r, n), map(fs, (f) => (rs(r, f.0), f.1)), b),
    NSelect(arms) => NSelect(map(arms, (a) => SArm {
      kind: rs(r, a.kind),
      pat: rpo(r, a.pat),
      ..a
    })),
    NMatch(m) => NMatch(MatchD { arms: map(m.arms, (a) => Arm { pat: rp(r, a.pat), ..a }), ..m }),
    _ => k,
  }
}

fn ren(r: Rn, x: Node) -> Node {
  let n1 = Node {
    k: rk(r, x.k),
    vis: match x.vis {
      Some(v) => Some(Vis { vis: rso(r, v.vis), ..v }),
      None => None,
    },
    label: rso(r, x.label),
    attrs: match x.attrs {
      Some(ats) => Some(map(ats, (a) => Attr {
        name: rs(r, a.name),
        args: map(a.args, (kv) => (rso(r, kv.0), rlito(r, kv.1))),
        line: a.line,
      })),
      None => None,
    },
    ..x
  }
  ast.with_kids(n1, map(ast.kids(n1), (y) => ren(r, y)))
}

fn rename_mod(x: Node, old: Str, new: Str, exact: Bool) -> Node {
  ren(Rn { old: old, new: new, pre: old + ".", exact: exact }, x)
}

fn ren_list(xs: List<Node>, old: Str, new: Str, exact: Bool) -> List<Node> {
  map(xs, (w) => rename_mod(w, old, new, exact))
}

// ── 函数体里的 mod（hoist_local_mods）──

fn hoist(l0: L, its: List<Node>) -> Result<(L, List<Node>, List<Node>), ME> {
  var l = l0
  var out: List<Node> = []
  var res: List<Node> = []
  for it in its {
    let go = match it.k {
      NFn(_) => true,
      NImpl(_) => true,
      NLet(..) => true,
      NTrait(_) => true,
      _ => false,
    }
    if go {
      let (l1, o1, x) = walk_h(l, it, out)?
      l = l1
      out = o1
      res = push(res, x)
    } else {
      res = push(res, it)
    }
  }
  Ok((l, out, res))
}

fn is_inline_mod(s: Node) -> Bool { is_some(inline_mod(s)) }

fn walk_h(l0: L, x0: Node, out0: List<Node>) -> Result<(L, List<Node>, Node), ME> {
  var l = l0
  var out = out0
  var x = x0
  match x.k {
    NMod(..) => { return Ok((l, out, x)) },
    NBlock(ss, u) => {
      var stmts = ss
      let mods0 = filter(stmts, is_inline_mod)
      if len(mods0) > 0 {
        var seen: List<Str> = []
        for md in mods0 {
          let mn = decl_name(md)
          if mn == "super" { return Err(me(md.line, "super 是保留名字，不能用作模块名")) }
          if contains(seen, mn) { return Err(me(md.line, "模块 {mn} 重复定义")) }
          seen = push(seen, mn)
        }
        stmts = filter(stmts, (s) => !is_inline_mod(s))
        var mods = mods0
        var i = 0
        while i < len(mods) {
          let mn = decl_name(mods[i])
          l = L { lm: l.lm + 1, ..l }
          let nn = "__lm{l.lm}_{mn}"
          mods = map(mods, (o) => match o.k {
            NMod(n, Some(its)) => Node { k: NMod(n, Some(ren_list(its, mn, nn, false))), ..o },
            _ => o,
          })
          stmts = ren_list(stmts, mn, nn, false)
          let mi = mods[i]
          mods = set(mods, i, Node {
            k: NMod(Some(nn), inline_mod(mi)),
            vis: match mi.vis {
              Some(v) => Some(Vis { is_pub: false, ..v }),
              None => Some(Vis { is_pub: false, vis: None, has_vis: false }),
            },
            ..mi
          })
          i += 1
        }
        out = out + mods
      }
      let uses = filter(stmts, (s) => is_use(s) && is_lm_use(s))
      if len(uses) > 0 {
        stmts = filter(stmts, (s) => !(is_use(s) && is_lm_use(s)))
        for st in uses {
          let p = use_path(st)
          let lastp = p[len(p) - 1]
          if up_s(lastp) == "*" {
            return Err(me(st.line, "函数体里不支持 use m.*，请逐个列出名字"))
          }
          let al = use_alias(st)
          let ents = match lastp {
            UGroup(es) => map(es, use_name),
            UName(s) => [(s, unwrap_or(al, s))],
          }
          for (orig, bnd) in ents {
            l = L { lm: l.lm + 1, ..l }
            let nb = "__lmu{l.lm}_{bnd}"
            let un = ast.mkn(st.line, NUse(take(p, len(p) - 1) + [UName(orig)], Some(nb)))
            out = push(out, Node {
              vis: Some(Vis { is_pub: false, vis: None, has_vis: true }),
              ..un
            })
            stmts = ren_list(stmts, bnd, nb, first_upper(bnd))
          }
        }
      }
      x = Node { k: NBlock(stmts, u), ..x }
    },
    _ => (),
  }
  var ys: List<Node> = []
  for y in ast.kids(x) {
    let (l1, o1, v) = walk_h(l, y, out)?
    l = l1
    out = o1
    ys = push(ys, v)
  }
  Ok((l, out, ast.with_kids(x, ys)))
}

fn is_lm_use(s: Node) -> Bool {
  let p = use_path(s)
  len(p) > 0 && starts_with(up_s(p[0]), "__lm") && is_vs(p[0])
}

fn first_upper(s: Str) -> Bool {
  if len(s) == 0 { return false }
  let o = __ord(__str_slice(s, 0, 1))
  o >= 65 && o <= 90
}

// ── 加载 ──

// std 按 Go 的包路径分层（std/go/ast.kite → use std.go.ast）：取最长的模块文件前缀，返回 (文件, 用掉的段数)
fn std_find(l: L, segs: List<UseP>) -> (Str, Int) {
  let sd = path.join([l.kdir, "std"])
  var n = len(segs)
  while n > 0 {
    let parts = take(segs, n)
    if all(parts, is_vs) {
      let ps = map(parts, up_s)
      let f1 = path.join(push([], sd) + ps) + ".kite"
      let f2 = path.join(push([], sd) + ps + ["mod.kite"])
      for f in [f1, f2] { if is_file(f) { return (f, n) } }
    }
    n -= 1
  }
  ("", 0)
}

fn full_std(l: L, segs: List<UseP>) -> Bool { len(segs) > 0 && std_find(l, segs).1 == len(segs) }

// use 路径（以 std 开头）是否引用 Kite 写的 std 模块
fn kstd_use(l: L, p: List<UseP>) -> Bool {
  if len(p) < 2 || !is_vs(p[0]) || up_s(p[0]) != "std" { return false }
  let segs = skip(p, 1)
  match segs[len(segs) - 1] {
    UGroup(ms) => {
      let pre = take(segs, len(segs) - 1)
      (len(pre) > 0 && std_find(l, pre).1 > 0)
        || any(ms, (m) => full_std(l, pre + [UName(use_name(m).0)]))
    },
    _ => std_find(l, segs).1 > 0,
  }
}

fn parse_file(l: L, p: Str) -> Result<(L, List<Node>), ME> {
  let idx = l.nfiles
  let l1 = L { nfiles: l.nfiles + 1, files: push(l.files, p), ..l }
  let src = if p == l.ov && l.ov != "" {
    l.ovsrc
  } else {
    match fs.read(p) {
      Ok(s) => s,
      Err(e) => { return Err(me(0, "无法读取 {p}: {e}")) },
    }
  }
  match parser.parse_off(src, idx * LINE_BASE) {
    Ok(its) => Ok((l1, its)),
    Err(e) => Err(me(-2, syntax_msg(relpath(l.cwd, p), e))),
  }
}

// 语法错误 "ERR 行:列 信息"（行号带文件偏移）→ "文件:行:列: 信息"
pub fn syntax_msg(file: Str, e: Str) -> Str {
  if !starts_with(e, "ERR ") { return file + ": " + e }
  let rest = __str_slice(e, 4, len(e))
  let sp = __str_find(rest, " ", 0)
  if sp < 0 { return file + ": " + e }
  let lc = split(__str_slice(rest, 0, sp), ":")
  let ln = match parse_int(lc[0]) {
    Ok(n) => n % LINE_BASE,
    Err(_) => 0,
  }
  let col = if len(lc) > 1 && lc[1] != "-" { ":" + lc[1] } else { "" }
  file + ":{ln}{col}: " + __str_slice(rest, sp + 1, len(rest))
}

// 不加载、只看文件系统：use 路径 → (模块文件, 用掉的段数)；找不到时文件为 ""（语言服务器用）
pub fn resolve_static(l: L, p: List<UseP>) -> (Str, Int) {
  let pk = l.root
  let segs = filter(p, (x) => match x {
    UName(s) => s != "*",
    UGroup(_) => false,
  })
  let (f, n) = find_module_file(l, pk.src, segs)
  if f != "" { return (abspath(l.cwd, f), n) }
  if pk.name != "" && len(p) > 0 && up_s(p[0]) == pk.name {
    let (f2, n2) = find_module_file(l, pk.src, skip(segs, 1))
    if f2 != "" { return (abspath(l.cwd, f2), 1 + n2) }
    let lib = path.join([pk.src, "lib.kite"])
    if is_file(lib) { return (abspath(l.cwd, lib), 1) }
  }
  ("", 0)
}

// 主文件改用内存里的文本（语言服务器：编辑器里还没保存的内容）
pub fn with_overlay(l: L, src: Str) -> L { L { ov: l.main, ovsrc: src, ..l } }

fn find_module_file(l: L, base: Str, segs: List<UseP>) -> (Str, Int) {
  var n = len(segs)
  while n > 0 {
    let parts = take(segs, n)
    if all(parts, is_vs) {
      let ps = map(parts, up_s)
      let f1 = path.join(push([], base) + ps) + ".kite"
      let f2 = path.join(push([], base) + ps + ["mod.kite"])
      for f in [f1, f2] { if is_file(f) && abspath(l.cwd, f) != l.main { return (f, n) } }
    }
    n -= 1
  }
  ("", 0)
}

fn path_join_strs(xs: List<UseP>) -> Str { join(map(xs, up_s), ".") }
fn resolve_use(l0: L, key0: Str, p: List<UseP>, ln: Int) -> Result<(L, Str, List<UseP>), ME> {
  let info = gm(l0, key0)
  let pkg = info.pkg
  let head = p[0]
  let hs = up_s(head)
  if is_vs(head) && contains(info.inl, hs) {
    var key = unwrap(get(info.inl, hs))
    var rest = skip(p, 1)
    while len(rest) > 0 && is_vs(rest[0]) && contains(gm(l0, key).inl, up_s(rest[0])) {
      key = sub_mod(l0, key, up_s(rest[0]), ln, key0)?
      rest = skip(rest, 1)
    }
    return Ok((l0, key, rest))
  }
  if hs == "std" && is_vs(head) && len(p) >= 2 {
    let (sf, sn) = std_find(l0, skip(p, 1))
    if sn > 0 {
      let parts = map(take(skip(p, 1), sn), up_s)
      let name = join(parts, ".")
      var par = "std"
      var i = 0
      while i < len(parts) && parts[i] != "internal" { par = par + "." + parts[i]; i += 1 }
      if i < len(parts) && !starts_with(key0 + ".", par + ".") {
        return Err(me(ln, "不能使用内部模块 std.{name}（只供 {par} 及其子模块使用）"))
      }
      let sd = path.join([l0.kdir, "std"])
      let spkg = Pkg { name: "std", root: sd, src: sd, prefix: "std", deps: [] }
      let (l1, k) = load(l0, "std." + name, sf, spkg, ln)?
      return Ok((l1, k, skip(p, 1 + sn)))
    }
  }
  let (f, n) = find_module_file(l0, pkg.src, p)
  if f != "" {
    let (l1, k) = load(l0, mangle(pkg.prefix, path_join_strs(take(p, n))), f, pkg, ln)?
    return Ok((l1, k, skip(p, n)))
  }
  if pkg.root == l0.root.root && pkg.prefix == "" && hs == pkg.name && pkg.name != "" {
    let lib = path.join([pkg.src, "lib.kite"])
    if is_file(lib) && abspath(l0.cwd, lib) != l0.main {
      let (f2, n2) = find_module_file(l0, pkg.src, skip(p, 1))
      if f2 != "" {
        let (l1, k) = load(
          l0,
          mangle(pkg.prefix, path_join_strs(take(skip(p, 1), n2))),
          f2,
          pkg,
          ln,
        )?
        return Ok((l1, k, skip(p, 1 + n2)))
      }
      let (l1, k) = load(l0, pkg.name, lib, pkg, ln)?
      return Ok((l1, k, skip(p, 1)))
    }
  }
  if contains(pkg.deps, hs) {
    let dp = unwrap(get(l0.dtab, hs))
    let (f, n) = find_module_file(l0, dp.src, skip(p, 1))
    if f != "" {
      let (l1, k) = load(l0, mangle(dp.prefix, path_join_strs(take(skip(p, 1), n))), f, dp, ln)?
      return Ok((l1, k, skip(p, 1 + n)))
    }
    let lib = path.join([dp.src, "lib.kite"])
    if !is_file(lib) { return Err(me(ln, "依赖包 {hs} 没有 src/lib.kite")) }
    let (l1, k) = load(l0, dp.prefix, lib, dp, ln)?
    return Ok((l1, k, skip(p, 1)))
  }
  let wh = relpath(l0.cwd, path.join([pkg.src, hs + ".kite"]))
  Err(me(ln, "找不到模块 {hs}（没有 {wh}，也不是 kite.toml 里的依赖）"))
}

fn load(l0: L, key0: Str, p: Str, pkg: Pkg, ln: Int) -> Result<(L, Str), ME> {
  let ap = abspath(l0.cwd, p)
  let key = unwrap_or(get(l0.by_path, ap), key0)
  var l = L { by_path: set(l0.by_path, ap, key), ..l0 }
  if contains(l.mods, key) {
    if contains(l.loading, key) {
      var i = 0
      while l.loading[i] != key { i += 1 }
      let chain = join(skip(l.loading, i) + [key], " → ")
      return Err(me(ln, "模块循环引用: {chain}"))
    }
    return Ok((l, key))
  }
  var info = new_mod(key, p, pkg)
  l = pm(l, info)
  l = L { loading: push(l.loading, key), ..l }
  let (l1, its) = parse_file(l, p)?
  info = Mod { items: its, ..gm(l1, key) }
  l = process(pm(l1, info), key)?
  l = L { loading: take(l.loading, len(l.loading) - 1), order: push(l.order, key), ..l }
  Ok((l, key))
}

// 入口：返回拼接后的顶层项
pub fn load_main(l0: L) -> Result<List<Node>, ME> {
  let (its, _) = load_main_src(l0, "")?
  Ok(its)
}

// 同时返回源文件表（kite.SOURCES：主文件按给定的写法，其余相对当前目录）
pub fn load_main_src(l0: L, given: Str) -> Result<(List<Node>, List<Str>), ME> {
  let (l, out, srcs) = load_once(l0, given)?
  // 主文件定义了和内建函数同名的东西，而其他模块用的是内建函数：给主文件的那个改名再来一遍
  let bset = builtin_set()
  var ren: Map<Str, Bool> = Map()
  let rootn = gm(l, "").names
  for key in l.order {
    for it in gm(l, key).items {
      for n in free_names(it, bset, rootn) { ren = set(ren, n, true) }
    }
  }
  if len(keys(ren)) == 0 { return Ok((out, srcs)) }
  let (_, out2, srcs2) = load_once(L { ren: ren, ..l0 }, given)?
  Ok((out2, srcs2))
}

fn free_names(n: Node, a: Map<Str, Bool>, b: Map<Str, Str>) -> List<Str> {
  var out: List<Str> = []
  if let NName(s) = n.k { if contains(a, s) && contains(b, s) { out = [s] } }
  for k in ast.kids(n) {
    let x = free_names(k, a, b)
    if len(x) > 0 { out = out + x }
  }
  out
}

fn load_once(l0: L, given: Str) -> Result<(L, List<Node>, List<Str>), ME> {
  if l0.dunsup != "" { return Err(me(-1, l0.dunsup)) }
  var l = pm(l0, new_mod("", l0.main, l0.root))
  l = L { loading: push(l.loading, ""), ..l }
  let (l1, its) = parse_file(l, l0.main)?
  l = pm(l1, Mod { items: its, ..gm(l1, "") })
  l = process(l, "")?
  l = L { loading: take(l.loading, len(l.loading) - 1), ..l }
  var variants: Map<Str, Str> = Map()
  let keys_ = push(l.order, "")
  for key in keys_ {
    for it in gm(l, key).items {
      if let NEnum(_, vs, _) = it.k {
        for v in vs {
          let vn = v.0
          if let Some(prev) = get(variants, vn) {
            if prev != key {
              let a = if prev == "" { "主文件" } else { prev }
              let b = if key == "" { "主文件" } else { key }
              return Err(
                me(it.line, "枚举变体 {vn} 在 {a} 和 {b} 中重复定义（变体目前是全局名字）"),
              )
            }
          }
          variants = set(variants, vn, key)
        }
      }
    }
  }
  var out: List<Node> = []
  for key in keys_ { out = out + gm(l, key).items }
  var srcs = [given]
  for f in skip(l.files, 1) {
    let r = relpath(l.cwd, f)
    srcs = push(srcs, if starts_with(r, "../..") { relpath(l.root.root, f) } else { r })
  }
  Ok((l, order_consts(out), srcs))
}

fn process(l: L, key: Str) -> Result<L, ME> {
  let l1 = declare(l, key)?
  finish(l1, key)
}

fn declare(l0: L, key: Str) -> Result<L, ME> {
  var info = gm(l0, key)
  let (l1, hoisted, its) = hoist(l0, info.items)?
  var l = l1
  info = Mod { items: hoisted + its, ..gm(l, key) }
  for it in info.items {
    var names: List<Str> = []
    if decl_named(it.k) {
      names = [decl_name(it)]
    } else if let NLet(p, _, _, _, _) = it.k {
      names = pat_binds(p)
    }
    let is_type = match it.k {
      NStruct(..) => true,
      NEnum(..) => true,
      NTrait(_) => true,
      NAlias(..) => true,
      _ => false,
    }
    for nm in names {
      // 主文件的名字不加前缀；和内建函数同名、又被其他模块当内建函数用时（L.ren）改名
      let mg = if key == "" && contains(l0.ren, nm) {
        "__main." + nm
      } else {
        mangle(info.prefix, nm)
      }
      info = Mod { names: set(info.names, nm, mg), ..info }
      if is_pub(it) {
        let vv = match it.vis {
          Some(v) => if v.has_vis { v.vis } else { None },
          None => None,
        }
        info = Mod {
          pubs: set(info.pubs, nm, true),
          vis: set(info.vis, nm, unwrap_or(vv, "pub")),
          ..info
        }
      }
      if is_type { info = Mod { types: set(info.types, nm, true), ..info } }
    }
  }
  l = pm(l, info)
  var inline = info.inl
  var rest: List<Node> = []
  for it in info.items {
    if let Some(mits) = inline_mod(it) {
      let mn = decl_name(it)
      if mn == "super" { return Err(me(it.line, "super 是保留名字，不能用作模块名")) }
      if contains(inline, mn) { return Err(me(it.line, "模块 {mn} 重复定义")) }
      let ckey = if key != "" { key + "." + mn } else { mn }
      if contains(l.mods, ckey) { return Err(me(it.line, "内联模块 {mn} 和已有模块 {ckey} 重名")) }
      var child = new_mod(ckey, info.path, info.pkg)
      child = Mod {
        items: mits,
        parent: Some(key),
        inl: set(Map(), "super", key),
        inl_pub: set(Map(), "super", false),
        ..child
      }
      l = pm(l, child)
      l = declare(l, ckey)?
      let pi = gm(l, key)
      l = pm(l, Mod {
        children: push(pi.children, ckey),
        inl_pub: set(pi.inl_pub, mn, is_pub(it)),
        deps: push(pi.deps, ckey),
        ..pi
      })
      inline = set(inline, mn, ckey)
    } else {
      rest = push(rest, it)
    }
  }
  Ok(pm(l, Mod { items: rest, inl: inline, ..gm(l, key) }))
}

fn is_kstd(l: L, u: Node) -> Bool { is_use(u) && kstd_use(l, use_path(u)) }

fn walk_kstd(l: L, x0: Node, acc0: List<Node>) -> (List<Node>, Node) {
  var acc = acc0
  var x = x0
  if let NBlock(ss, u) = x.k {
    acc = acc + filter(ss, (s) => is_kstd(l, s))
    x = Node { k: NBlock(filter(ss, (s) => !is_kstd(l, s)), u), ..x }
  }
  var ys: List<Node> = []
  for y in ast.kids(x) {
    let (a1, v) = walk_kstd(l, y, acc)
    acc = a1
    ys = push(ys, v)
  }
  (acc, ast.with_kids(x, ys))
}

fn finish(l0: L, key: Str) -> Result<L, ME> {
  var l = l0
  for ck in gm(l, key).children {
    l = L { loading: push(l.loading, ck), ..l }
    l = finish(l, ck)?
    l = L { loading: take(l.loading, len(l.loading) - 1), order: push(l.order, ck), ..l }
  }
  var info = gm(l, key)
  var hoisted: List<Node> = []
  var its: List<Node> = []
  for it in info.items {
    let go = match it.k {
      NFn(_) => true,
      NImpl(_) => true,
      NLet(..) => true,
      _ => false,
    }
    if go {
      let (a, v) = walk_kstd(l, it, hoisted)
      hoisted = a
      its = push(its, v)
    } else {
      its = push(its, it)
    }
  }
  its = hoisted + its
  var uses: List<Node> = []
  for it in its {
    let p = use_path(it)
    var split_ = false
    if len(p) >= 2 && is_vs(p[0]) && up_s(p[0]) == "std" {
      if let UGroup(ms) = p[len(p) - 1] {
        let pre = take(skip(p, 1), len(p) - 2)
        if all(pre, is_vs) && any(ms, (m) => full_std(l, pre + [UName(use_name(m).0)])) {
          split_ = true
          for m in ms {
            let (nm, al) = use_name(m)
            if full_std(l, pre + [UName(nm)]) {
              uses = push(
                uses,
                ast.mkn(it.line, NUse([UName("std")] + pre + [UName(nm)], Some(al))),
              )
            }
          }
          let rest = filter(ms, (m) => !full_std(l, pre + [UName(use_name(m).0)]))
          if len(rest) > 0 {
            if len(pre) > 0 {
              let bad = join(map(rest, (m) => use_name(m).0), ", ")
              return Err(me(it.line, "std.{path_join_strs(pre)} 下没有模块 {bad}"))
            }
            uses = push(uses, Node { k: NUse([UName("std"), UGroup(rest)], use_alias(it)), ..it })
          }
        }
      }
    }
    if !split_ { uses = push(uses, it) }
  }
  var aliases = info.inl
  var imports: Map<Str, Str> = Map()
  var kept: List<Node> = []
  for it in uses {
    let p = use_path(it)
    if is_use(it) && len(p) > 0 && (up_s(p[0]) != "std" || !is_vs(p[0]) || kstd_use(l, p)) {
      let (l1, k0, rest0) = resolve_use(l, key, p, it.line)?
      l = l1
      var k = k0
      var rest = rest0
      while len(rest) > 0 && is_vs(rest[0]) && contains(gm(l, k).inl, up_s(rest[0])) {
        k = sub_mod(l, k, up_s(rest[0]), it.line, key)?
        rest = skip(rest, 1)
      }
      let cur = gm(l, key)
      if !contains(cur.deps, k) { l = pm(l, Mod { deps: push(cur.deps, k), ..cur }) }
      let al = use_alias(it)
      if len(rest) == 0 {
        aliases = set(aliases, unwrap_or(al, up_s(p[len(p) - 1])), k)
      } else if len(rest) == 1 && up_s(rest[0]) == "*" && is_vs(rest[0]) {
        let m = gm(l, k)
        for nm in sort(keys(m.pubs)) {
          if visible(l, m, nm, key) { imports = set(imports, nm, unwrap(get(m.names, nm))) }
        }
      } else {
        let lastr = rest[len(rest) - 1]
        let is_group = !is_vs(lastr)
        if len(rest) > 1 && !is_group {
          return Err(me(it.line, "找不到模块 " + path_join_strs(take(p, len(p) - 1))))
        }
        let names = match lastr {
          UGroup(es) => map(es, use_name),
          UName(s) => [(s, unwrap_or(al, s))],
        }
        for (nm, b) in names { imports = set(imports, b, export(l, k, nm, it.line, Some(key))?) }
      }
      continue
    }
    kept = push(kept, it)
  }
  var r = R { key: key, aliases: aliases, imports: imports, scopes: [], gens: [] }
  var out: List<Node> = []
  for it in kept {
    let (r1, v) = top(l, r, it)?
    r = r1
    out = push(out, v)
  }
  Ok(pm(l, Mod { items: out, ..gm(l, key) }))
}

fn within(l: L, req: Str, m: Str) -> Bool {
  var cur: Str? = Some(req)
  while is_some(cur) {
    let c = unwrap(cur)
    if c == m { return true }
    cur = gm(l, c).parent
  }
  false
}

fn sub_mod(l: L, key: Str, name: Str, ln: Int, req: Str) -> Result<Str, ME> {
  let m = gm(l, key)
  let ck = unwrap_or(get(m.inl, name), "")
  if name == "super" && !within(l, req, key) {
    return Err(me(ln, "{key}.super 只能在模块 {key} 内部使用"))
  }
  if !within(l, req, key) && !unwrap_or(get(m.inl_pub, name), false) {
    return Err(me(ln, "{key}.{name} 是私有模块（写 pub mod {name} 才能在外面使用）"))
  }
  Ok(ck)
}

fn export(l: L, key: Str, name: Str, ln: Int, req: Str?) -> Result<Str, ME> {
  let m = gm(l, key)
  if !contains(m.names, name) { return Err(me(ln, "模块 {key} 里没有 {name}")) }
  let inside = match req {
    Some(r) => within(l, r, key),
    None => false,
  }
  if !contains(m.pubs, name) && !inside {
    return Err(me(ln, "{key}.{name} 是私有的（在定义前加 pub 才能被其他模块使用）"))
  }
  if let Some(r) = req {
    if !visible(l, m, name, r) {
      let lvl = unwrap_or(get(m.vis, name), "pub")
      let what = if lvl == "pkg" { "本包" } else { "所在目录的模块" }
      return Err(me(ln, "{key}.{name} 是 pub({lvl})，只对{what}可见"))
    }
  }
  Ok(unwrap(get(m.names, name)))
}

fn mod_scope(l: L, m: Mod) -> Str {
  let ap = abspath(l.cwd, m.path)
  let d = dirname(ap)
  let b = path.base(m.path)
  if b == "lib.kite" { return abspath(l.cwd, m.pkg.src) }
  if b == "mod.kite" { return dirname(d) }
  d
}

fn visible(l: L, m: Mod, name: Str, req: Str) -> Bool {
  let lvl = unwrap_or(get(m.vis, name), "pub")
  if lvl == "pub" || within(l, req, m.key) { return true }
  let rq = gm(l, req)
  if rq.pkg.root != m.pkg.root || rq.pkg.prefix != m.pkg.prefix { return false }
  if lvl == "pkg" { return true }
  let sc = mod_scope(l, m)
  let rp = abspath(l.cwd, rq.path)
  rp == sc || starts_with(rp, sc + "/")
}

// ── Resolver ──
// ── Resolver ──

type R = {
  key: Str,
  aliases: Map<Str, Str>,
  imports: Map<Str, Str>,
  scopes: List<List<Str>>,
  gens: List<Str>,
}

fn is_local(r: R, n: Str) -> Bool { any(r.scopes, (s) => contains(s, n)) }

fn value(l: L, r: R, n: Str) -> Str {
  if is_local(r, n) { return n }
  let info = gm(l, r.key)
  if let Some(x) = get(info.names, n) { return x }
  if let Some(x) = get(r.imports, n) { return x }
  n
}

fn type_name(l: L, r: R, name: Str, gens: List<Str>) -> Result<Str, ME> {
  if contains(gens, name) { return Ok(name) }
  if contains(name, ".") {
    let segs = split(name, ".")
    let hd = segs[0]
    if let Some(k0) = get(r.aliases, hd) {
      var k = k0
      var parts = skip(segs, 1)
      while len(parts) > 1 && contains(gm(l, k).inl, parts[0]) {
        k = sub_mod(l, k, parts[0], 0, r.key)?
        parts = skip(parts, 1)
      }
      if len(parts) == 1 { return export(l, k, parts[0], 0, Some(r.key)) }
    }
    return Ok(name)
  }
  let info = gm(l, r.key)
  if contains(info.types, name) { return Ok(unwrap(get(info.names, name))) }
  if let Some(x) = get(r.imports, name) { return Ok(x) }
  Ok(name)
}

fn tns(l: L, r: R, vs: List<Str>, gens: List<Str>) -> Result<List<Str>, ME> {
  var out: List<Str> = []
  for v in vs { out = push(out, type_name(l, r, v, gens)?) }
  Ok(out)
}

// 约束 / impl 的 trait：Python 版存的是类型元组的第二项（通常是名字），只解析这一项
fn rhead(l: L, r: R, t: TyX, gens: List<Str>) -> Result<TyX, ME> {
  match t {
    YCon(n, a, ln) => Ok(YCon(type_name(l, r, n, gens)?, a, ln)),
    _ => {
      let _ = type_name(l, r, "", gens)?
      Ok(t)
    },
  }
}

fn rty(l: L, r: R, t: TyX, gens: List<Str>) -> Result<TyX, ME> {
  match t {
    YCon(n, a, ln) => {
      let n2 = type_name(l, r, n, gens)?
      Ok(YCon(n2, rtys(l, r, a, gens)?, ln))
    },
    YTup(a, ln) => Ok(YTup(rtys(l, r, a, gens)?, ln)),
    YFn(a, b, ln) => {
      let a2 = rtys(l, r, a, gens)?
      Ok(YFn(a2, rty(l, r, b, gens)?, ln))
    },
    YDyn(bs, ln) => Ok(YDyn(tns(l, r, bs, gens)?, ln)),
    YImpl(bs, ln) => Ok(YImpl(tns(l, r, bs, gens)?, ln)),
    YUnsafe(x, ln) => Ok(YUnsafe(rty(l, r, x, gens)?, ln)),
  }
}

fn rtyo(l: L, r: R, t: TyX?, gens: List<Str>) -> Result<TyX?, ME> {
  match t {
    Some(x) => Ok(Some(rty(l, r, x, gens)?)),
    None => Ok(None),
  }
}

fn rtys(l: L, r: R, ts: List<TyX>, gens: List<Str>) -> Result<List<TyX>, ME> {
  var out: List<TyX> = []
  for t in ts { out = push(out, rty(l, r, t, gens)?) }
  Ok(out)
}

fn rnm_t(l: L, r: R, n: Nm) -> Result<Nm, ME> {
  let s = ast.nm_str(n)
  let s2 = type_name(l, r, s, [])?
  Ok(if s2 == s { n } else { NmS(s2) })
}

fn rpat(l: L, r: R, p: Pat) -> Result<Pat, ME> {
  match p {
    PTuple(xs) => Ok(PTuple(rpats(l, r, xs)?)),
    PList(pre, rest, post) => {
      let a = rpats(l, r, pre)?
      Ok(PList(a, rest, rpats(l, r, post)?))
    },
    PAt(a, b) => Ok(PAt(a, rpat(l, r, b)?)),
    PVariant(n, subs) => {
      let info = gm(l, r.key)
      if let NmS(s) = n {
        if is_none(subs) && contains(info.names, s) && !is_local(r, s) {
          return Ok(PVariant(NmS(unwrap(get(info.names, s))), None))
        }
      }
      match subs {
        Some(xs) => Ok(PVariant(n, Some(rpats(l, r, xs)?))),
        None => Ok(p),
      }
    },
    PStruct(n, fs) => {
      var out: List<(Str, Pat)> = []
      for f in fs { out = push(out, (f.0, rpat(l, r, f.1)?)) }
      Ok(PStruct(rnm_t(l, r, n)?, out))
    },
    POr(xs) => Ok(POr(rpats(l, r, xs)?)),
    _ => Ok(p),
  }
}

fn rpats(l: L, r: R, ps: List<Pat>) -> Result<List<Pat>, ME> {
  var out: List<Pat> = []
  for p in ps { out = push(out, rpat(l, r, p)?) }
  Ok(out)
}

fn bind(r: R, p: Pat) -> R {
  let n = len(r.scopes)
  R { scopes: set(r.scopes, n - 1, r.scopes[n - 1] + pat_binds(p)), ..r }
}

fn push_scope(r: R, s: List<Str>) -> R { R { scopes: push(r.scopes, s), ..r } }

fn pop_scope(r: R) -> R { R { scopes: take(r.scopes, len(r.scopes) - 1), ..r } }

fn rbounds(l: L, r: R, g: Gen, gens: List<Str>) -> Result<Gen, ME> {
  if len(g.bounds) == 0 { return Ok(g) }
  var out: List<(Str, List<TyX>)> = []
  for (n, bs) in g.bounds {
    var ts: List<TyX> = []
    for b in bs { ts = push(ts, rhead(l, r, b, gens)?) }
    out = push(out, (n, ts))
  }
  Ok(Gen { bounds: out, ..g })
}

fn rfields(l: L, r: R, xs: List<(Str, TyX)>, gens: List<Str>) -> Result<List<(Str, TyX)>, ME> {
  var out: List<(Str, TyX)> = []
  for f in xs { out = push(out, (f.0, rty(l, r, f.1, gens)?)) }
  Ok(out)
}

fn rfields_o(l: L, r: R, xs: List<(Str, TyX?)>, gens: List<Str>) -> Result<List<(Str, TyX?)>, ME> {
  var out: List<(Str, TyX?)> = []
  for f in xs { out = push(out, (f.0, rtyo(l, r, f.1, gens)?)) }
  Ok(out)
}

fn rconsts(l: L, r0: R, cs: List<AConst>, gens: List<Str>) -> Result<(R, List<AConst>), ME> {
  var r = r0
  var out: List<AConst> = []
  for c in cs {
    var ev: Node? = None
    if let Some(v) = c.value {
      let (r1, e) = rexpr(l, r, v)?
      r = r1
      ev = Some(e)
    }
    out = push(out, AConst { ty: rty(l, r, c.ty, gens)?, value: ev, ..c })
  }
  Ok((r, out))
}

fn top(l: L, r0: R, it: Node) -> Result<(R, Node), ME> {
  var r = r0
  let info = gm(l, r.key)
  let mangled = (n: Str) => unwrap(get(info.names, n))
  match it.k {
    NFn(f) => {
      let x = Node { k: NFn(FnD { name: value(l, r, f.name), ..f }), ..it }
      return rfn(l, r, x, [])
    },
    NStruct(n, fs, g) => {
      let g2 = rbounds(l, r, g, g.names)?
      return Ok((r, Node { k: NStruct(mangled(n), rfields_o(l, r, fs, g.names)?, g2), ..it }))
    },
    NEnum(n, vs, g) => {
      let g2 = rbounds(l, r, g, g.names)?
      var out: List<(Str, EvF)> = []
      for v in vs {
        let nf = match v.1 {
          EvList(xs) => EvList(rfields(l, r, xs, g.names)?),
          EvRec(xs) => EvRec(rfields(l, r, xs, g.names)?),
          EvNone => EvNone,
        }
        out = push(out, (v.0, nf))
      }
      return Ok((r, Node { k: NEnum(mangled(n), out, g2), ..it }))
    },
    NAlias(n, t, g) => {
      let g2 = rbounds(l, r, g, g.names)?
      return Ok((r, Node { k: NAlias(mangled(n), rty(l, r, t, g.names)?, g2), ..it }))
    },
    NTrait(t) => {
      var assoc: List<TAssoc> = []
      for a in t.assoc {
        let bs = tns(l, r, a.bounds, [])?
        assoc = push(assoc, TAssoc {
          name: a.name,
          bounds: bs,
          dflt: rtyo(l, r, a.dflt, ["Self"])?,
        })
      }
      let sups = tns(l, r, t.supers, [])?
      let (r1, cs) = rconsts(l, r, t.consts, ["Self"])?
      r = r1
      var ms: List<Node> = []
      for m in t.methods {
        let (r2, mv) = rfn(l, r, m, ["Self"])?
        r = r2
        ms = push(ms, mv)
      }
      return Ok((r, Node {
        k: NTrait(TraitD {
          name: mangled(t.name),
          methods: ms,
          assoc: assoc,
          supers: sups,
          consts: cs,
        }),
        ..it
      }))
    },
    NImpl(_) => { return rimpl(l, r, it) },
    NLet(p, m, t, v, ic) => {
      let (r1, v2) = rexpr(l, r, v)?
      r = r1
      let p2 = rpat(l, r, p)?
      let t2 = rtyo(l, r, t, [])?
      return Ok((r, Node { k: NLet(top_pat(info, p2), m, t2, v2, ic), ..it }))
    },
    NUse(..) => { return Ok((r, it)) },
    NMod(..) => { return Ok((r, it)) },
    _ => (),
  }
  r = push_scope(r, [])
  let (r3, sx) = rstmt(l, r, it)?
  Ok((pop_scope(r3), sx))
}

fn top_pat(info: Mod, p: Pat) -> Pat {
  let nm = (s: Str) => unwrap_or(get(info.names, s), s)
  match p {
    PBind(n) => PBind(NmS(nm(ast.nm_str(n)))),
    PVar(n) => PVar(NmS(nm(ast.nm_str(n)))),
    POr(xs) => POr(map(xs, (q) => top_pat(info, q))),
    PAt(a, b) => PAt(top_pat(info, a), top_pat(info, b)),
    PTuple(xs) => PTuple(map(xs, (q) => top_pat(info, q))),
    PList(pre, rest, post) => PList(
      map(pre, (q) => top_pat(info, q)),
      match rest {
        Some(s) => if s == "" { rest } else { Some(nm(s)) },
        None => None,
      },
      map(post, (q) => top_pat(info, q)),
    ),
    PVariant(n, subs) => PVariant(n, match subs {
      Some(xs) => Some(map(xs, (q) => top_pat(info, q))),
      None => None,
    }),
    PStruct(n, fs) => PStruct(n, map(fs, (f) => (f.0, top_pat(info, f.1)))),
    _ => p,
  }
}

fn rimpl(l: L, r0: R, it: Node) -> Result<(R, Node), ME> {
  var r = r0
  let d = match it.k {
    NImpl(x) => x,
    _ => { return Ok((r, it)) },
  }
  let gens = d.gen.names
  let gs = push(gens, "Self")
  let target = type_name(l, r, d.target, gens)?
  let tt = rty(l, r, d.target_t, gens)?
  var tr = d.tr
  if let Some(t) = d.tr { tr = Some(rhead(l, r, t, gens)?) }
  var assoc: List<(Str, TyX)> = []
  for a in d.assoc { assoc = push(assoc, (a.0, rty(l, r, a.1, gs)?)) }
  var ms: List<Node> = []
  for m in d.methods {
    let (r1, mv) = rfn(l, r, m, gs)?
    r = r1
    ms = push(ms, mv)
  }
  let (r2, cs) = rconsts(l, r, d.consts, gs)?
  r = r2
  Ok((r, Node {
    k: NImpl(ImplD {
      tr: tr,
      target: target,
      target_t: tt,
      assoc: assoc,
      methods: ms,
      consts: cs,
      ..d
    }),
    ..it
  }))
}

fn rfn(l: L, r0: R, fnode: Node, outer: List<Str>) -> Result<(R, Node), ME> {
  var r = r0
  let f = match fnode.k {
    NFn(x) => x,
    _ => { return Ok((r, fnode)) },
  }
  let gens = outer + f.gen.names
  let ps = rfields_o(l, r, f.params, gens)?
  let ret = rtyo(l, r, f.ret, gens)?
  let g2 = rbounds(l, r, f.gen, gens)?
  var body = f.body
  if let Some(b) = f.body {
    r = push_scope(r, map(ps, (p) => p.0))
    r = R { gens: gens, ..r }
    let (r1, b2) = rexpr(l, r, b)?
    r = pop_scope(r1)
    body = Some(b2)
  }
  Ok((r, Node { k: NFn(FnD { params: ps, ret: ret, gen: g2, body: body, ..f }), ..fnode }))
}

fn rblock(l: L, r0: R, b: Node, ss: List<Node>, u: Bool) -> Result<(R, Node), ME> {
  var r = push_scope(r0, map(filter(ss, (s) => decl_named(s.k)), decl_name))
  var out: List<Node> = []
  for s in ss {
    let (r1, v) = rstmt(l, r, s)?
    r = r1
    out = push(out, v)
  }
  Ok((pop_scope(r), Node { k: NBlock(out, u), ..b }))
}

fn rx(l: L, r: R, e: Node?) -> Result<(R, Node?), ME> {
  match e {
    Some(x) => {
      let (r1, v) = rexpr(l, r, x)?
      Ok((r1, Some(v)))
    },
    None => Ok((r, None)),
  }
}

fn rstmt(l: L, r0: R, s: Node) -> Result<(R, Node), ME> {
  var r = r0
  match s.k {
    NLet(p, m, t, v, ic) => {
      let (r1, v2) = rexpr(l, r, v)?
      r = r1
      let p2 = rpat(l, r, p)?
      let x = Node { k: NLet(p2, m, rtyo(l, r, t, r.gens)?, v2, ic), ..s }
      return Ok((bind(r, p2), x))
    },
    NFn(_) => { return rfn(l, r, s, r.gens) },
    NImpl(_) => { return rimpl(l, r, s) },
    NStruct(..) => { return Ok((r, s)) },
    NEnum(..) => { return Ok((r, s)) },
    NAlias(..) => { return Ok((r, s)) },
    NTrait(_) => { return Ok((r, s)) },
    NUse(..) => { return Ok((r, s)) },
    NMod(..) => { return Ok((r, s)) },
    NExprStmt(e) => {
      let (r1, v) = rexpr(l, r, e)?
      return Ok((r1, Node { k: NExprStmt(v), ..s }))
    },
    NAssign(t, op, v) => {
      let (r1, t2) = rexpr(l, r, t)?
      let (r2, v2) = rexpr(l, r1, v)?
      return Ok((r2, Node { k: NAssign(t2, op, v2), ..s }))
    },
    NReturn(v) => {
      let (r1, v2) = rx(l, r, v)?
      return Ok((r1, Node { k: NReturn(v2), ..s }))
    },
    NBreak(lb, v, bare) => {
      let (r1, v2) = rx(l, r, v)?
      return Ok((r1, Node { k: NBreak(lb, v2, bare), ..s }))
    },
    NContinue(_) => { return Ok((r, s)) },
    NDefer(b) => {
      let (r1, v) = rexpr(l, r, b)?
      return Ok((r1, Node { k: NDefer(v), ..s }))
    },
    NFor(p, it, b) => {
      let (r1, it2) = rexpr(l, r, it)?
      let p2 = rpat(l, r1, p)?
      r = bind(push_scope(r1, []), p2)
      let (r2, b2) = rexpr(l, r, b)?
      return Ok((pop_scope(r2), Node { k: NFor(p2, it2, b2), ..s }))
    },
    NWhile(c, b) => {
      let (r1, c2) = rx(l, r, c)?
      let (r2, b2) = rexpr(l, r1, b)?
      return Ok((r2, Node { k: NWhile(c2, b2), ..s }))
    },
    _ => (),
  }
  // 其他语句：Python 版就地解析，这里和 kitec 迁移前一样只取作用域，不替换节点
  let (r3, _) = rexpr(l, r, s)?
  Ok((r3, s))
}

fn rexpr(l: L, r: R, e: Node) -> Result<(R, Node), ME> {
  let (r1, v, _) = rexpr_m(l, r, e)?
  Ok((r1, v))
}

fn is_name(n: Node) -> Str? {
  match n.k {
    NName(s) => Some(s),
    _ => None,
  }
}

// 第三个结果：内联子模块引用 a.b 的模块 key（Python 版的 _modkey），否则 "#"
fn rexpr_m(l: L, r0: R, e: Node) -> Result<(R, Node, Str), ME> {
  var r = r0
  let ln = e.line
  match e.k {
    NName(s) => { return Ok((r, Node { k: NName(value(l, r, s)), ..e }, "#")) },
    NField(o, fname0) => {
      let fname = ast.nm_str(fname0)
      if let Some(on) = is_name(o) {
        if !is_local(r, on) && contains(r.aliases, on) {
          let ak = unwrap(get(r.aliases, on))
          if contains(gm(l, ak).inl, fname) {
            let mk = sub_mod(l, ak, fname, ln, r.key)?
            return Ok((r, ast.mkn(ln, NField(o, NmS(fname))), mk))
          }
          return Ok((r, ast.mkn(ln, NName(export(l, ak, fname, ln, Some(r.key))?)), "#"))
        }
      }
      if let NField(..) = o.k {
        let (r1, o2, mk0) = rexpr_m(l, r, o)?
        if mk0 != "#" {
          if contains(gm(l, mk0).inl, fname) {
            let mk = sub_mod(l, mk0, fname, ln, r.key)?
            return Ok((r1, ast.mkn(ln, NField(o2, NmS(fname))), mk))
          }
          return Ok((r1, ast.mkn(ln, NName(export(l, mk0, fname, ln, Some(r.key))?)), "#"))
        }
        return Ok((r1, Node { k: NField(o2, fname0), ..e }, "#"))
      }
      let (r2, o3) = rexpr(l, r, o)?
      return Ok((r2, Node { k: NField(o3, fname0), ..e }, "#"))
    },
    NBlock(ss, u) => {
      let (r1, b) = rblock(l, r, e, ss, u)?
      return Ok((r1, b, "#"))
    },
    NTypeApp(f, targs) => {
      let (r1, f2) = rexpr(l, r, f)?
      var ts: List<TyX?> = []
      for t in targs { ts = push(ts, rtyo(l, r1, t, r1.gens)?) }
      return Ok((r1, Node { k: NTypeApp(f2, ts), ..e }, "#"))
    },
    NLambda(ps, b, ctx) => {
      let ps2 = rfields_o(l, r, ps, r.gens)?
      r = push_scope(r, map(ps2, (p) => p.0))
      let (r1, b2) = rexpr(l, r, b)?
      return Ok((pop_scope(r1), Node { k: NLambda(ps2, b2, ctx), ..e }, "#"))
    },
    NMatch(m) => {
      let (r1, subj) = rexpr(l, r, m.subject)?
      r = r1
      var arms: List<Arm> = []
      for a in m.arms {
        let p = rpat(l, r, a.pat)?
        r = bind(push_scope(r, []), p)
        let (r2, g) = rx(l, r, a.guard)?
        let (r3, b) = rexpr(l, r2, a.body)?
        r = pop_scope(r3)
        arms = push(arms, Arm { pat: p, guard: g, body: b })
      }
      // let … else：let_else 和第二个分支的块是同一个对象（Python 版就地解析，两处一起变）
      let le = if is_some(m.let_else) && len(arms) == 2 { Some(arms[1].body) } else { m.let_else }
      // x is P && R：is_conj 和 subject / 第一个分支共用对象（Python 版就地改名；被换成新节点时 is_conj 保留旧的，模式是元组也保留旧的）
      let ic = match m.is_conj {
        Some((isn, rt)) => {
          let isn2 = match isn.k {
            NIs(v, p) => if ast.kname(subj) == ast.kname(v) {
              Node { k: NIs(subj, p), ..isn }
            } else {
              isn
            },
            _ => isn,
          }
          let rt2 = if len(arms) > 0 && ast.kname(arms[0].body) == ast.kname(rt) {
            arms[0].body
          } else {
            rt
          }
          Some((isn2, rt2))
        },
        None => None,
      }
      return Ok(
        (
          r,
          Node {
            k: NMatch(MatchD { subject: subj, arms: arms, let_else: le, is_conj: ic, ..m }),
            ..e
          },
          "#",
        ),
      )
    },
    NSelect(arms0) => {
      var arms: List<SArm> = []
      for a in arms0 {
        let (r1, av) = rx(l, r, a.a)?
        let (r2, bv) = rx(l, r1, a.b)?
        let (r3, gv) = rx(l, r2, a.guard)?
        r = push_scope(r3, [])
        var p = a.pat
        if let Some(px) = a.pat {
          let p2 = rpat(l, r, px)?
          p = Some(p2)
          r = bind(r, p2)
        }
        let (r4, body) = rexpr(l, r, a.body)?
        r = pop_scope(r4)
        arms = push(arms, SArm { kind: a.kind, a: av, b: bv, pat: p, guard: gv, body: body })
      }
      return Ok((r, Node { k: NSelect(arms), ..e }, "#"))
    },
    NIs(v, p) => {
      let (r1, v2) = rexpr(l, r, v)?
      return Ok((r1, Node { k: NIs(v2, rpat(l, r1, p)?), ..e }, "#"))
    },
    NStructLit(nm, fs, base) => {
      let nm1 = rnm_t(l, r, nm)?
      // 限定的记录变体 N.Rect { … } / m.N.Rect { … }：限定名也要按导入改名
      let nm2 = match nm {
        NmQ(_, Some(q)) => {
          let nq = type_name(l, r, q, [])?
          if nq != q { NmQ(ast.nm_str(nm1), Some(nq)) } else { nm1 }
        },
        _ => nm1,
      }
      var out: List<(Str, Node)> = []
      for f in fs {
        let (r1, v) = rexpr(l, r, f.1)?
        r = r1
        out = push(out, (f.0, v))
      }
      let (r2, b2) = rx(l, r, base)?
      return Ok((r2, Node { k: NStructLit(nm2, out, b2), ..e }, "#"))
    },
    NInterp(ps) => {
      var out: List<IPart> = []
      for p in ps {
        match p {
          IStr(_) => { out = push(out, p) },
          IExpr(x) => {
            let (r1, v) = rexpr(l, r, x)?
            r = r1
            out = push(out, IExpr(v))
          },
        }
      }
      return Ok((r, Node { k: NInterp(out), ..e }, "#"))
    },
    NLet(..) => { return stmt_m(l, r, e) },
    NAssign(..) => { return stmt_m(l, r, e) },
    NReturn(_) => { return stmt_m(l, r, e) },
    NDefer(_) => { return stmt_m(l, r, e) },
    NFor(..) => { return stmt_m(l, r, e) },
    NWhile(..) => { return stmt_m(l, r, e) },
    NExprStmt(_) => { return stmt_m(l, r, e) },
    NBreak(..) => { return stmt_m(l, r, e) },
    NContinue(_) => { return stmt_m(l, r, e) },
    NFn(_) => { return stmt_m(l, r, e) },
    NImpl(_) => { return stmt_m(l, r, e) },
    NStruct(..) => { return stmt_m(l, r, e) },
    NEnum(..) => { return stmt_m(l, r, e) },
    NAlias(..) => { return stmt_m(l, r, e) },
    NTrait(_) => { return stmt_m(l, r, e) },
    NUse(..) => { return stmt_m(l, r, e) },
    NMod(..) => { return stmt_m(l, r, e) },
    _ => (),
  }
  // 其余表达式：逐个解析直接子节点
  var ys: List<Node> = []
  for y in ast.kids(e) {
    let (r1, v) = rexpr(l, r, y)?
    r = r1
    ys = push(ys, v)
  }
  Ok((r, ast.with_kids(e, ys), "#"))
}

fn stmt_m(l: L, r: R, e: Node) -> Result<(R, Node, Str), ME> {
  let (r1, v) = rstmt(l, r, e)?
  Ok((r1, v, "#"))
}

// ── 顶层 const 按依赖排序（order_consts）──

fn refs(x: Node, owner: Map<Str, Int>, acc0: List<Int>) -> List<Int> {
  var acc = acc0
  if let NName(s) = x.k {
    if let Some(i) = get(owner, s) { if !contains(acc, i) { acc = push(acc, i) } }
  }
  for y in ast.kids(x) { acc = refs(y, owner, acc) }
  acc
}

fn let_parts(n: Node) -> (Pat, Node, Bool)? {
  match n.k {
    NLet(p, _, _, v, ic) => Some((p, v, ic)),
    _ => None,
  }
}

fn order_consts(its: List<Node>) -> List<Node> {
  var idx: List<Int> = []
  var i = 0
  for it in its {
    if is_let(it) { idx = push(idx, i) }
    i += 1
  }
  if len(idx) < 2 { return its }
  let ok_kind = (it: Node) => decl_named(it.k)
    || match it.k {
      NImpl(_) => true,
      NUse(..) => true,
      NMod(..) => true,
      NLet(..) => true,
      _ => false,
    }
  if any(its, (it) => !ok_kind(it)) { return its }
  if any(idx, (j) => !unwrap(let_parts(its[j])).2) { return its }
  let consts = map(idx, (j) => its[j])
  var owner: Map<Str, Int> = Map()
  var ci = 0
  for c in consts {
    for nm in pat_binds(unwrap(let_parts(c)).0) { owner = set(owner, nm, ci) }
    ci += 1
  }
  let deps = map(consts, (c) => refs(unwrap(let_parts(c)).1, owner, []))
  var done: List<Int> = []
  var busy: List<Int> = []
  var out: List<Int> = []
  ci = 0
  while ci < len(consts) {
    let (d1, b1, o1) = visit(ci, deps, done, busy, out)
    done = d1
    busy = b1
    out = o1
    ci += 1
  }
  let rest = filter(its, (it) => !is_let(it))
  var first = 0
  var j = 0
  while j < idx[0] {
    if !is_let(its[j]) { first += 1 }
    j += 1
  }
  take(rest, first) + map(out, (n) => consts[n]) + skip(rest, first)
}
fn visit(c: Int, deps: List<List<Int>>, done0: List<Int>, busy0: List<Int>, out0: List<Int>) -> (
  List<Int>,
  List<Int>,
  List<Int>,
) {
  if contains(done0, c) || contains(busy0, c) { return (done0, busy0, out0) }
  var done = done0
  var busy = push(busy0, c)
  var out = out0
  var d = 0
  while d < len(deps) {
    if contains(deps[c], d) {
      let (d1, b1, o1) = visit(d, deps, done, busy, out)
      done = d1
      busy = b1
      out = o1
    }
    d += 1
  }
  (push(done, c), filter(busy, (x) => x != c), push(out, c))
}

// 函数体里 mod / use 提升后的内部名字 __lm<N>_ / __lmu<N>_，报错时还原（kite.py 的 KiteError）
pub fn strip_lm(msg: Str) -> Str {
  var out = ""
  var i = 0
  let n = len(msg)
  while i < n {
    if __str_slice(msg, i, i + 4) == "__lm" {
      var j = i + 4
      if j < n && __str_slice(msg, j, j + 1) == "u" { j += 1 }
      let d0 = j
      while j < n
        && __ord(__str_slice(msg, j, j + 1)) >= 48
        && __ord(__str_slice(msg, j, j + 1)) <= 57 {
        j += 1
      }
      if j > d0 && j < n && __str_slice(msg, j, j + 1) == "_" {
        i = j + 1
        continue
      }
    }
    out = out + __str_slice(msg, i, i + 1)
    i += 1
  }
  out
}
