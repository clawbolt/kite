// Kite 自举编译器：字节码 → C（native.py 的 Gen 的移植，自举第 3c 步；对应 KITE_NO_KIR=1，即不走 KIR）
// 输入是 bc.compile_chunk 的结果，输出和 tools/c_dump.py（native.Gen.generate）逐字节相同
// 注意：Kite 字符串里的花括号写成 \{ \}

use ast
use ast.{ V, kind, fld, sv, iv, items, is_nil }
use bc
use bc.{ S, PR, GV }
use kir
use kir.{ A, X, T, In, Bk, KF }
use std.path

const BUILTIN_C: Str = "print=b_print len=b_len str=b_str int=b_int float=b_float type_of=b_type_of map=b_map filter=b_filter each=b_each reduce=b_reduce fold=b_reduce sum=b_sum count=b_count any=b_any all=b_all find=b_find first=b_first last=b_last get=b_get take=b_take skip=b_skip reverse=b_reverse sort=b_sort sort_by=b_sort sort_with=b_sort_with __fmt=b_fmt __repeat=b_repeat zip=b_zip enumerate=b_enumerate push=b_push concat=b_concat contains=b_contains join=b_join split=b_split trim=b_trim upper=b_upper lower=b_lower starts_with=b_starts_with ends_with=b_ends_with replace=b_replace chars=b_chars parse_int=b_parse_int parse_float=b_parse_float keys=b_keys remove=b_remove values=b_values set=b_set Map=b_Map Set=b_Set insert=b_insert union=b_union intersect=b_intersect difference=b_difference is_subset=b_is_subset to_list=b_to_list __set_lit=b_Set __set_union=b_union __set_intersect=b_intersect __set_difference=b_difference min=b_min max=b_max abs=b_abs Ok=b_Ok Err=b_Err Some=b_Some unwrap=b_unwrap unwrap_or=b_unwrap_or is_ok=b_is_ok is_err=b_is_err is_some=b_is_some is_none=b_is_none panic=b_panic assert=b_assert assert_eq=b_assert_eq assert_ne=b_assert_ne __kite_test=b_kite_test __race=b_race timeout=b_timeout actor=b_actor tell=b_tell ask=b_ask __recover_raw=b_recover_raw __repanic=b_repanic __restart_log=b_restart_log_k __restart_log_w=b_restart_log_w supervise=b_supervise actor_supervised=b_actor_supervised __env_get=b_env_get __args=b_args __exit=b_exit __run=b_run __ord=b_ord __chr=b_chr __unix_ms=b_unix_ms __str_slice=b_str_slice __slice=b_slice __band=b_band __bor=b_bor __bxor=b_bxor __bnot=b_bnot __shl=b_shl __shr=b_shr __str_find=b_str_find __tcp_listen=b_tcp_listen __tcp_port=b_tcp_port __tcp_accept=b_tcp_accept __tcp_connect=b_tcp_connect __tcp_read_line=b_tcp_read_line __tcp_read_bytes=b_tcp_read_bytes __tcp_read_all=b_tcp_read_all __tcp_write=b_tcp_write __tcp_flush=b_tcp_flush __tcp_close=b_tcp_close __byte_len=b_byte_len __bytes=b_bytes __from_bytes=b_from_bytes __eprint=b_eprint __fs_stat=b_fs_stat __getcwd=b_getcwd __chdir=b_chdir __chmod=b_chmod __env_set=b_env_set __env_unset=b_env_unset __environ=b_environ __hostname=b_hostname __getpid=b_getpid __read_bytes=b_read_bytes __write_bytes=b_write_bytes __tz_offset=b_tz_offset __random_bytes=b_random_bytes __unix_ns=b_unix_ns __tls_server_ctx=b_tls_server_ctx __tls_accept=b_tls_accept __tls_client=b_tls_client __tls_handshake=b_tls_handshake __select=b_select sleep=b_sleep now_ms=b_now_ms chan=b_chan send=b_send recv=b_recv try_recv=b_try_recv close=b_close par_map=b_par_map"

const FAST_C: Str = "\nstatic inline V f_add(V a, V b) \{ int64_t r; if (a.t == T_INT && b.t == T_INT && !__builtin_add_overflow(a.u.i, b.u.i, &r)) return mkint(r); return k_add(a, b); \}\nstatic inline V f_sub(V a, V b) \{ int64_t r; if (a.t == T_INT && b.t == T_INT && !__builtin_sub_overflow(a.u.i, b.u.i, &r)) return mkint(r); return k_sub(a, b); \}\nstatic inline V f_mul(V a, V b) \{ int64_t r; if (a.t == T_INT && b.t == T_INT && !__builtin_mul_overflow(a.u.i, b.u.i, &r)) return mkint(r); return k_mul(a, b); \}\nstatic inline V f_lt(V a, V b) \{ if (a.t == T_INT && b.t == T_INT) return mkbool(a.u.i < b.u.i); k_ordchk(\"<\", a, b); return mkbool(k_cmp(a, b) < 0); \}\nstatic inline V f_gt(V a, V b) \{ if (a.t == T_INT && b.t == T_INT) return mkbool(a.u.i > b.u.i); k_ordchk(\">\", a, b); return mkbool(k_cmp(a, b) > 0); \}\nstatic inline V f_le(V a, V b) \{ if (a.t == T_INT && b.t == T_INT) return mkbool(a.u.i <= b.u.i); k_ordchk(\"<=\", a, b); return mkbool(k_cmp(a, b) <= 0); \}\nstatic inline V f_ge(V a, V b) \{ if (a.t == T_INT && b.t == T_INT) return mkbool(a.u.i >= b.u.i); k_ordchk(\">=\", a, b); return mkbool(k_cmp(a, b) >= 0); \}\nstatic inline V f_eq(V a, V b) \{ if (a.t == T_INT && b.t == T_INT) return mkbool(a.u.i == b.u.i); return mkbool(k_eq(a, b)); \}\nstatic inline V f_ne(V a, V b) \{ if (a.t == T_INT && b.t == T_INT) return mkbool(a.u.i != b.u.i); return mkbool(!k_eq(a, b)); \}\nstatic inline V f_neg(V a) \{\n  if (a.t == T_INT) \{ if (a.u.i == INT64_MIN) die(\"整数溢出\"); return mkint(-a.u.i); \}\n  if (a.t == T_FLOAT) return mkflt(-a.u.f);\n  die(\"不能对 %s 取负\", tname(a)); return UNIT;\n\}"

const CALL_M_C: Str = "static V call_m(int sym, int n, V *base) \{\n  V recv = base[0];\n  if (recv.t == T_MODULE || recv.t == T_ETYPE) return call_v(k_field(recv, sym), n, base + 1);\n  KFn *m = find_method(tid_of(recv), sym);\n  if (m) return m->code(m, n + 1, base);\n  if (recv.t == T_STRUCT) \{ int i = sfield(STRUCTV(recv), sym); if (i >= 0) return call_v(STRUCTV(recv)->f[i], n, base + 1); \}\n  int g = global_of_sym(sym);\n  if (g >= 0 && G[g].t == T_FN) return call_v(G[g], n + 1, base);\n  die(\"%s 没有方法 %s\", tname(recv), SYMS[sym]); return UNIT;\n\}"

const FIXED_TYPES: List<Str> = ["Unit", "Bool", "Int", "Float", "Str", "List", "Tuple", "Map", "Fn", "Result", "Option", "Chan", "Set"]

const STD_MODS: List<(Str, Str)> = [
  ("io", "print println read_line"),
  ("fs", "read write append exists is_file is_dir size list mkdir remove rename"),
  ("ptr", "null is_null addr offset from_addr alloc free read_int write_int read_float write_float read_byte write_byte to_str from_str"),
  ("math", "sqrt sin cos tan asin acos atan sinh cosh tanh asinh acosh atanh exp exp2 expm1 log2 log10 log1p cbrt pow atan2 hypot fmod copysign remainder log floor ceil round trunc is_nan is_inf signbit gcd lcm pi=3.141592653589793 e=2.718281828459045 tau=6.283185307179586 phi=1.618033988749895 sqrt2=1.4142135623730951 ln2=0.6931471805599453 ln10=2.302585092994046 inf=inf nan=nan max_float=1.7976931348623157e+308 smallest_float=5e-324 max_int=9223372036854775807 min_int=-9223372036854775808"),
]

type Gn = {
  bs: S,
  protos: List<Int>,
  pid: Map<Int, Int>,
  pname: Map<Int, Str>,
  syms: List<Str>,
  symid: Map<Str, Int>,
  strs: List<Str>,
  strid: Map<Str, Int>,
  gnames: List<Str>,
  gid: Map<Str, Int>,
  types: List<Str>,
  tid: Map<Str, Int>,
  pats: List<Str>,
  fsyms: List<List<Int>>,
  fsym_id: Map<Str, Int>,
  assigned: Map<Str, Bool>,
  structs: List<(Str, V)>,
  enums: List<(Str, V)>,
  variants: Map<Str, Bool>,
  bmap: Map<Str, Str>,
  ext_id: Map<Str, Int>,
  cstructs: Map<Str, Str>,
  cs_n: Int,
  out: List<Str>,
  err: Str,
  kf: Map<Str, KF>,
  kprot: Map<Int, Str>,
  knames: Map<Str, Str>,
}

fn gerr(g: Gn, msg: Str) -> Gn { if g.err == "" { Gn { err: msg, ..g } } else { g } }

fn lset<T>(xs: List<T>, i: Int, v: T) -> List<T> { take(xs, i) + [v] + skip(xs, i + 1) }

fn w(g: Gn, line: Str) -> Gn { Gn { out: push(g.out, line), ..g } }

// ───────── 字面量 ─────────

fn oct3(n: Int) -> Str { "\\" + str(n / 64) + str(n / 8 % 8) + str(n % 8) }

pub fn c_str(s: Str) -> Str {
  var out: List<Str> = []
  for ch in __bytes(s) {
    if ch == 34 || ch == 92 { out = push(out, "\\" + __chr(ch)) } else if ch >= 32 && ch < 127 && ch != 63 { out = push(out, __chr(ch)) } else { out = push(out, oct3(ch)) }
  }
  "\"" + join(out, "") + "\""
}

fn hex13(n0: Int) -> Str {
  let ds = "0123456789abcdef"
  var n = n0
  var out = ""
  var i = 0
  while i < 13 {
    out = __str_slice(ds, n % 16, n % 16 + 1) + out
    n = n / 16
    i += 1
  }
  out
}

// Python 的 float.hex()
pub fn float_hex(x: Float) -> Str {
  if x == 0.0 { return if starts_with(str(x), "-") { "-0x0.0p+0" } else { "0x0.0p+0" } }
  let neg = x < 0.0
  var a = if neg { 0.0 - x } else { x }
  var e = 0
  while a >= 2.0 {
    a = a / 2.0
    e += 1
  }
  while a < 1.0 && e > -1022 {
    a = a * 2.0
    e -= 1
  }
  let lead = if a >= 1.0 { 1 } else { 0 }
  var frac = a - float(lead)
  var i = 0
  while i < 52 {
    frac = frac * 2.0
    i += 1
  }
  let es = if e >= 0 { "+" + str(e) } else { str(e) }
  (if neg { "-" } else { "" }) + "0x{lead}." + hex13(int(frac)) + "p" + es
}

fn is_nan(x: Float) -> Bool { x != x }

fn const_c(g: Gn, v: V) -> (Gn, Str) {
  match v {
    VB(b)   => (g, if b { "mkbool(1)" } else { "mkbool(0)" }),
    VI(i)   => (g, if i == -9223372036854775807 - 1 { "mkint(INT64_MIN)" } else { "mkint({i}LL)" }),
    VBig(s) => (gerr(g, "整数常量 {s} 超出 64 位范围"), "UNIT"),
    VF(f)   => {
      if is_nan(f) { return (g, "mkflt(NAN)") }
      if f > 1.7976931348623157e308 { return (g, "mkflt(INFINITY)") }
      if f < -1.7976931348623157e308 { return (g, "mkflt(-INFINITY)") }
      (g, "mkflt(" + float_hex(f) + ")")
    },
    VS(s)   => sconst(g, s),
    VQ(s, _) => sconst(g, s),
    VN(_, _, _) => (g, "UNIT"),
    _       => (gerr(g, "原生后端: 不支持的常量 " + ast.dump(v)), "UNIT"),
  }
}

// ───────── 注册表 ─────────

fn sym(g: Gn, name: Str) -> (Gn, Int) {
  if let Some(i) = get(g.symid, name) { return (g, i) }
  let i = len(g.syms)
  (Gn { syms: push(g.syms, name), symid: set(g.symid, name, i), ..g }, i)
}

fn sconst(g: Gn, s: Str) -> (Gn, Str) {
  if let Some(i) = get(g.strid, s) { return (g, "KS[{i}]") }
  let i = len(g.strs)
  (Gn { strs: push(g.strs, s), strid: set(g.strid, s, i), ..g }, "KS[{i}]")
}

fn glob(g: Gn, name: Str) -> (Gn, Int) {
  if let Some(i) = get(g.gid, name) { return (g, i) }
  let i = len(g.gnames)
  (Gn { gnames: push(g.gnames, name), gid: set(g.gid, name, i), ..g }, i)
}

fn glob_(g: Gn, name: Str) -> Gn { glob(g, name).0 }

fn type_id(g: Gn, name: Str) -> (Gn, Int) {
  if let Some(i) = get(g.tid, name) { return (g, i) }
  let i = len(g.types)
  (Gn { types: push(g.types, name), tid: set(g.tid, name, i), ..g }, i)
}

fn tid(g: Gn, name: Str) -> Int { unwrap_or(get(g.tid, name), -1) }

fn symarr(g0: Gn, names: List<Str>) -> (Gn, Str) {
  let key = join(names, ",") + "#{len(names)}"
  if let Some(i) = get(g0.fsym_id, key) { return (g0, "FS{i}") }
  var g = g0
  var ids: List<Int> = []
  for n in names {
    let (g2, i) = sym(g, n)
    g = g2
    ids = push(ids, i)
  }
  let k = len(g.fsyms)
  (Gn { fsyms: push(g.fsyms, ids), fsym_id: set(g.fsym_id, key, k), ..g }, "FS{k}")
}

fn add_proto(g0: Gn, p: Int) -> Gn {
  if contains(g0.pid, p) { return g0 }
  var g = Gn { pid: set(g0.pid, p, len(g0.protos)), protos: push(g0.protos, p), ..g0 }
  for (op, arg) in g.bs.protos[p].code {
    if op == "CLOSURE" { g = add_proto(g, iv(arg)) }
  }
  g
}

fn pk(g: Gn, p: Int) -> Int { unwrap(get(g.pid, p)) }

fn pn(g: Gn, p: Int) -> Str { unwrap_or(get(g.pname, p), g.bs.protos[p].name) }

fn gv(g: Gn, name: Str) -> GV { unwrap_or(get(g.bs.gval, name), GOther) }

fn is_closure(v: GV) -> Bool {
  match v {
    GFn(_) => true,
    _      => false,
  }
}

fn is_builtin(v: GV) -> Bool {
  match v {
    GBuiltin(_) => true,
    GCtor(_)    => true,
    GMember(n)  => is_some(std_const(n)) == false,
    GExt(_, _)  => true,
    _           => false,
  }
}

// std 模块成员：Some(常量文本) 表示不是函数
fn std_const(n: Str) -> Option<Str> {
  for (_, ms) in STD_MODS {
    for m in split(ms, " ") {
      let kv = split(m, "=")
      if kv[0] == n { return if len(kv) > 1 { Some(kv[1]) } else { None } }
    }
  }
  None
}

fn std_mod_of(n: Str) -> Option<Str> {
  for (mn, ms) in STD_MODS {
    for m in split(ms, " ") {
      if split(m, "=")[0] == n { return Some(mn) }
    }
  }
  None
}

// ───────── 栈效应 ─────────

fn is_binop(op: Str) -> Bool { contains(["ADD", "SUB", "MUL", "DIV", "MOD", "LT", "GT", "LE", "GE", "EQ", "NE", "RANGE", "RANGE_INC"], op) }

fn effect(op: Str, arg: V) -> Int {
  if contains(["CONST", "LOAD_L", "LOAD_U", "LOAD_G", "CLOSURE"], op) { return 1 }
  if contains(["STORE_L", "STORE_U", "STORE_G", "DEF_G", "POP", "JIF", "INDEX", "WFIELD", "MATCH_OR_FAIL", "ITER", "DEFER", "JIF_OR_POP", "JIT_OR_POP"], op) { return -1 }
  if is_binop(op) { return -1 }
  if op == "POPN" || op == "CALL" { return 0 - iv(arg) }
  if op == "CALL_M" { return 0 - iv(items(arg)[1]) }
  if contains(["LIST", "TUPLE", "INTERP", "SPAWN"], op) { return 1 - iv(arg) }
  if op == "STRUCT" { return 1 - len(items(items(arg)[1])) }
  if op == "WINDEX" { return -2 }
  if op == "FOR_NEXT" { return 1 }
  0
}

// 每条指令的栈深度（不可达为 -1）与跳转目标
fn depths(g: Gn, p: PR) -> (Gn, List<Int>, Map<Int, Bool>) {
  let code = p.code
  var depth: List<Int> = map(code, (_) => -1)
  var targets: Map<Int, Bool> = Map()
  var work: List<(Int, Int)> = [(0, 0)]
  var gg = g
  while len(work) > 0 {
    var (pc, d) = work[len(work) - 1]
    work = take(work, len(work) - 1)
    while pc < len(code) {
      if depth[pc] >= 0 {
        if depth[pc] != d { gg = gerr(gg, "原生后端内部错误: {p.name} 第 {pc} 条指令栈深度不一致") }
        break
      }
      depth = lset(depth, pc, d)
      let (op, arg) = code[pc]
      if op == "JUMP" {
        targets = set(targets, iv(arg), true)
        pc = iv(arg)
        continue
      }
      if op == "RET" || op == "MATCH_FAIL" { break }
      if op == "JIF" {
        targets = set(targets, iv(arg), true)
        work = push(work, (iv(arg), d - 1))
      } else if op == "JIF_OR_POP" || op == "JIT_OR_POP" {
        targets = set(targets, iv(arg), true)
        work = push(work, (iv(arg), d))
      } else if op == "FOR_NEXT" {
        let t = iv(items(arg)[1])
        targets = set(targets, t, true)
        work = push(work, (t, d))
      }
      d += effect(op, arg)
      pc += 1
    }
  }
  (gg, depth, targets)
}

// ───────── 每个 Proto ─────────

fn gen_proto(g0: Gn, pi: Int) -> (Gn, Str) {
  let p = g0.bs.protos[pi]
  let k = pk(g0, pi)
  if let Some(kn) = get(g0.kprot, pi) { return (g0, kir_wrapper(unwrap(get(g0.kf, kn)), g0.knames, kn, k, p.np)) }
  let (g1, depth, targets) = depths(g0, p)
  var g = g1
  var maxd = 0
  for d in depth { if d > maxd { maxd = d } }
  maxd += 2
  var ndef = count(p.code, (c) => c.0 == "DEFER")
  if ndef == 0 { ndef = 1 }
  var ls: List<Str> = []
  ls = push(ls, "static V p{k}(KFn *self, int argc, V *argv) \{ /* " + pn(g, pi) + " */")
  ls = push(ls, "  if (argc != {p.np}) arity(self, {p.np}, argc);")
  ls = push(ls, "  SAFEPOINT();")
  ls = push(ls, "  V L[{max(p.nl, 1)}]; V S[{maxd}]; V rv; KUp *open = NULL; V defers[{ndef}]; int nd = 0;")
  if p.np > 0 { ls = push(ls, "  memcpy(L, argv, sizeof(V) * {p.np});") }
  if p.nl > p.np { ls = push(ls, "  for (int i = {p.np}; i < {p.nl}; i++) L[i] = UNIT;") }
  let need_frame = any(p.code, (c) => c.0 == "DEFER" || c.0 == "CLOSURE")
  if need_frame { ls = push(ls, "  KFrame fr_ = \{ cur_frame, &open, L, defers, &nd \}; cur_frame = &fr_;") }
  ls = push(ls, "  CANCEL_POINT();")
  var known: Map<Int, Int> = Map()
  var cur_line = -1
  var pc = 0
  let noln = ["CONST", "LOAD_L", "STORE_L", "POP", "JUMP", "CLOSE"]
  let nowr = ["STORE_L", "STORE_U", "STORE_G", "DEF_G", "POP", "POPN", "DEFER", "ITER", "MATCH_OR_FAIL", "JIF", "JIF_OR_POP", "JIT_OR_POP", "CLOSE", "RUN_DEFERS", "JUMP"]
  for (op, arg) in p.code {
    let d = depth[pc]
    if contains(targets, pc) {
      ls = push(ls, " I{pc}:;")
      cur_line = -1
      if d >= 0 { known = filter_known(known, d) }
    }
    if d >= 0 {
      let ln = p.lines[pc]
      if ln != cur_line && !contains(noln, op) {
        ls = push(ls, "  kline = {ln};")
        cur_line = ln
      }
      let (g2, code, nk) = op_c(g, op, arg, d, known, pc)
      g = g2
      ls = push(ls, "  " + code)
      let nd_ = d + effect(op, arg)
      let limit = if contains(nowr, op) { nd_ } else { nd_ - 1 }
      known = filter_known(known, limit)
      if nk >= 0 { known = set(known, d, nk) }
      if op == "CALL" || op == "CALL_M" { cur_line = -1 }
    }
    pc += 1
  }
  ls = push(ls, " ret:")
  ls = push(ls, "  while (nd > 0) \{ nd--; call_v(defers[nd], 0, NULL); \}")
  ls = push(ls, "  if (open) close_ups(&open, L);")
  if need_frame { ls = push(ls, "  cur_frame = fr_.prev;") }
  ls = push(ls, "  return rv;")
  ls = push(ls, "}")
  (g, join(ls, "\n"))
}

fn filter_known(m: Map<Int, Int>, limit: Int) -> Map<Int, Int> {
  var out: Map<Int, Int> = Map()
  for key in keys(m) { if key < limit { out = set(out, key, unwrap(get(m, key))) } }
  out
}

fn binop_fn(op: Str) -> Str {
  match op {
    "ADD" => "f_add",
    "SUB" => "f_sub",
    "MUL" => "f_mul",
    "DIV" => "k_div",
    "MOD" => "k_mod",
    "LT"  => "f_lt",
    "GT"  => "f_gt",
    "LE"  => "f_le",
    "GE"  => "f_ge",
    "EQ"  => "f_eq",
    "NE"  => "f_ne",
    _     => "",
  }
}

fn op_c(g: Gn, op: Str, a: V, d: Int, known: Map<Int, Int>, cur_pc: Int) -> (Gn, Str, Int) {
  let t = d - 1
  if op == "CONST" {
    let (g2, c) = const_c(g, a)
    return (g2, "S[{d}] = {c};", -1)
  }
  if op == "LOAD_L" { return (g, "S[{d}] = L[{iv(a)}];", -1) }
  if op == "STORE_L" { return (g, "L[{iv(a)}] = S[{t}];", -1) }
  if op == "LOAD_U" { return (g, "S[{d}] = *self->ups[{iv(a)}]->ref;", -1) }
  if op == "STORE_U" { return (g, "k_store_up(self->ups[{iv(a)}], S[{t}]);", -1) }
  if op == "LOAD_G" {
    let nm = sv(a)
    let gi = unwrap(get(g.gid, nm))
    match gv(g, nm) {
      GFn(pp) => { if !contains(g.assigned, nm) { return (g, "S[{d}] = G[{gi}];", pk(g, pp)) } },
      _       => {},
    }
    return (g, "S[{d}] = G[{gi}]; if (S[{d}].t == T_UNDEF) die(\"未定义的名字 %s\", " + c_str(nm) + ");", -1)
  }
  if op == "DEF_G" { return (g, "G[{unwrap(get(g.gid, sv(a)))}] = S[{t}];", -1) }
  if op == "STORE_G" { return (g, "k_store_g(&G[{unwrap(get(g.gid, sv(a)))}], S[{t}]);", -1) }
  if op == "POP" || op == "POPN" { return (g, ";", -1) }
  if is_binop(op) {
    let f = binop_fn(op)
    if f != "" { return (g, "S[{t - 1}] = {f}(S[{t - 1}], S[{t}]);", -1) }
    return (g, "S[{t - 1}] = k_range(S[{t - 1}], S[{t}], " + (if op == "RANGE_INC" { "1" } else { "0" }) + ");", -1)
  }
  if op == "NEG" { return (g, "S[{t}] = f_neg(S[{t}]);", -1) }
  if op == "NOT" { return (g, "S[{t}] = mkbool(!truthy(S[{t}]));", -1) }
  if op == "JUMP" {
    if iv(a) <= cur_pc { return (g, "SAFEPOINT(); CANCEL_POINT(); goto I{iv(a)};", -1) }
    return (g, "goto I{iv(a)};", -1)
  }
  if op == "JIF" || op == "JIF_OR_POP" { return (g, "if (!truthy(S[{t}])) goto I{iv(a)};", -1) }
  if op == "JIT_OR_POP" { return (g, "if (truthy(S[{t}])) goto I{iv(a)};", -1) }
  if op == "CALL" {
    let n = iv(a)
    let b = d - n - 1
    if let Some(fk) = get(known, b) { return (g, "S[{b}] = p{fk}(&CL{fk}, {n}, &S[{b + 1}]);", -1) }
    return (g, "S[{b}] = call_v(S[{b}], {n}, &S[{b + 1}]);", -1)
  }
  if op == "CALL_M" {
    let n = iv(items(a)[1])
    let b = d - n - 1
    let (g2, sid) = sym(g, sv(items(a)[0]))
    return (g2, "S[{b}] = call_m({sid}, {n}, &S[{b}]);", -1)
  }
  if op == "RET" { return (g, "rv = S[{t}]; goto ret;", -1) }
  if op == "CLOSURE" {
    let pp = iv(a)
    let k = pk(g, pp)
    let pr = g.bs.protos[pp]
    var parts = ["\{ V c = mkclosure(p{k}, " + c_str(pn(g, pp)) + ", {len(pr.upd)}); KFn *f = FN(c);"]
    var i = 0
    for u in pr.upd {
      let ux = items(u)
      parts = push(parts, if ast.truthy(ux[0]) { "f->ups[{i}] = find_up(&open, &L[{iv(ux[1])}]);" } else { "f->ups[{i}] = self->ups[{iv(ux[1])}];" })
      i += 1
    }
    parts = push(parts, "S[{d}] = c; }")
    return (g, join(parts, " "), -1)
  }
  if op == "LIST" { return (g, "S[{d - iv(a)}] = mklist({iv(a)}, &S[{d - iv(a)}]);", -1) }
  if op == "SPAWN" || op == "TUPLE" {
    if iv(a) == 0 { return (g, "S[{d}] = UNIT;", -1) }
    let b = d - iv(a)
    return (g, "S[{b}] = " + (if op == "SPAWN" { "k_spawn" } else { "mktuple" }) + "({iv(a)}, &S[{b}]);", -1)
  }
  if op == "STRUCT" {
    let fs = map(items(items(a)[1]), (x) => sv(x))
    let n = len(fs)
    let b = d - n
    let (g2, fa) = symarr(g, fs)
    return (g2, "S[{b}] = k_struct(&ST_{tid(g2, sv(items(a)[0]))}, {n}, {fa}, &S[{b}]);", -1)
  }
  if op == "FIELD" {
    let (g2, sid) = sym(g, sv(a))
    return (g2, "S[{t}] = k_field(S[{t}], {sid});", -1)
  }
  if op == "TIDX" { return (g, "S[{t}] = k_tidx(S[{t}], {iv(a)});", -1) }
  if op == "INDEX" { return (g, "S[{t - 1}] = k_index(S[{t - 1}], S[{t}]);", -1) }
  if op == "WFIELD" {
    let (g2, sid) = sym(g, sv(a))
    return (g2, "S[{t - 1}] = k_wfield(S[{t - 1}], {sid}, S[{t}]);", -1)
  }
  if op == "WINDEX" { return (g, "S[{t - 2}] = k_windex(S[{t - 2}], S[{t - 1}], S[{t}]);", -1) }
  if op == "INTERP" { return (g, "S[{d - iv(a)}] = k_interp({iv(a)}, &S[{d - iv(a)}]);", -1) }
  if op == "TEST_PAT" {
    let (g2, pn_) = pat(g, a)
    return (g2, "S[{t}] = mkbool({pn_}(S[{t}], L));", -1)
  }
  if op == "MATCH_OR_FAIL" {
    let (g2, pn_) = pat(g, a)
    return (g2, "if (!{pn_}(S[{t}], L)) die(\"解构失败: %s\", cshow(S[{t}]));", -1)
  }
  if op == "MATCH_FAIL" { return (g, "die(\"match 没有覆盖值 %s\", cshow(S[{t}]));", -1) }
  if op == "TRY" {
    return (g, "\{ V v = S[{t}]; int vr = v.t == T_ENUM ? ENUMV(v)->var : -1; if (vr == SYM_Ok || vr == SYM_Some) S[{t}] = ENUMV(v)->a[0]; else if (vr == SYM_Err || vr == SYM_None) \{ rv = v; goto ret; \} else die(\"? 只能用于 Result 或 Option\"); \}", -1)
  }
  if op == "ITER" { return (g, "L[{iv(a)}] = k_iter(S[{t}]);", -1) }
  if op == "FOR_NEXT" { return (g, "if (!k_next(L[{iv(items(a)[0])}], &S[{d}])) goto I{iv(items(a)[1])};", -1) }
  if op == "CLOSE" { return (g, "if (open) close_ups(&open, &L[{iv(a)}]);", -1) }
  if op == "DEFER" { return (g, "defers[nd++] = S[{t}];", -1) }
  if op == "RUN_DEFERS" { return (g, "while (nd > {iv(a)}) \{ nd--; call_v(defers[nd], 0, NULL); \}", -1) }
  (gerr(g, "原生后端: 不支持的指令 {op}"), "", -1)
}

// ───────── 模式 → C 函数 ─────────

fn pats(g0: Gn, ps: List<V>) -> (Gn, List<Str>) {
  var g = g0
  var out: List<Str> = []
  for p in ps {
    let (g2, n) = pat(g, p)
    g = g2
    out = push(out, n)
  }
  (g, out)
}

fn pat(g0: Gn, p: V) -> (Gn, Str) {
  let k = len(g0.pats)
  var g = Gn { pats: push(g0.pats, ""), ..g0 }
  let name = "pat{k}"
  let xs = items(p)
  let t = sv(xs[0])
  var lines = ["static bool {name}(V v, V *L) \{"]
  if t == "wild" {
    lines = push(lines, "  (void)v; (void)L; return true;")
  } else if t == "bind" {
    lines = push(lines, "  L[{iv(xs[1])}] = v; return true;")
  } else if t == "gbind" {
    let (g2, gi) = glob(g, sv(xs[1]))
    g = g2
    lines = push(lines, "  (void)L; G[{gi}] = v; return true;")
  } else if t == "lit" {
    match xs[1] {
      VB(b)    => { lines = push(lines, "  (void)L; return v.t == T_BOOL && v.u.i == " + (if b { "1" } else { "0" }) + ";") },
      VI(i)    => { lines = push(lines, "  (void)L; return v.t == T_INT && v.u.i == {i}LL;") },
      VF(f)    => { lines = push(lines, "  (void)L; return v.t == T_FLOAT && v.u.f == " + float_hex(f) + ";") },
      VS(s)    => {
        let (g2, c) = sconst(g, s)
        g = g2
        lines = push(lines, "  (void)L; return v.t == T_STR && k_eq(v, {c});")
      },
      _        => { lines = push(lines, "  (void)L; return v.t == T_UNIT;") },
    }
  } else if t == "range" {
    let lo = xs[1]
    let hi = xs[2]
    let probe = if is_nil(lo) { hi } else { lo }
    var conds = [match probe {
      VS(_) => "v.t == T_STR",
      _     => "isnum(v)",
    }]
    if !is_nil(lo) {
      let (g2, c) = const_c(g, lo)
      g = g2
      conds = push(conds, "k_cmp(v, {c}) >= 0")
    }
    if !is_nil(hi) {
      let (g3, c) = const_c(g, hi)
      g = g3
      conds = push(conds, "k_cmp(v, {c}) " + (if ast.truthy(xs[3]) { "<=" } else { "<" }) + " 0")
    }
    lines = push(lines, "  (void)L; return " + join(conds, " && ") + ";")
  } else if t == "at" {
    let (g2, sb) = pat(g, xs[1])
    let (g3, ss) = pat(g2, xs[2])
    g = g3
    lines = push(lines, "  return {ss}(v, L) && {sb}(v, L);")
  } else if t == "or" {
    let (g2, subs) = pats(g, items(xs[1]))
    g = g2
    lines = push(lines, "  return " + join(map(subs, (s) => "{s}(v, L)"), " || ") + ";")
  } else if t == "tuple" {
    let (g2, subs) = pats(g, items(xs[1]))
    g = g2
    lines = push(lines, "  if (v.t != T_TUPLE || TUP(v)->n != {len(subs)}) return false;")
    var i = 0
    for s in subs {
      lines = push(lines, "  if (!{s}(TUP(v)->a[{i}], L)) return false;")
      i += 1
    }
    lines = push(lines, "  return true;")
  } else if t == "list" {
    let (g2, subs) = pats(g, items(xs[1]))
    let n = len(subs)
    lines = push(lines, "  if (v.t != T_LIST) return false;")
    let (g3, post) = pats(g2, if len(xs) > 3 { items(xs[3]) } else { [] })
    g = g3
    let m = len(post)
    if is_nil(xs[2]) { lines = push(lines, "  if (LIST(v)->len != {n}) return false;") }
    lines = push(lines, "  if (LIST(v)->len < {n + m}) return false;")
    var i = 0
    for s in subs {
      lines = push(lines, "  if (!{s}(LIST(v)->a[{i}], L)) return false;")
      i += 1
    }
    i = 0
    for s in post {
      lines = push(lines, "  if (!{s}(LIST(v)->a[LIST(v)->len - {m - i}], L)) return false;")
      i += 1
    }
    if !is_nil(xs[2]) {
      let (g4, r) = pat(g, xs[2])
      g = g4
      lines = push(lines, "  return {r}(slice(LIST(v), {n}, LIST(v)->len - {m}), L);")
    } else {
      lines = push(lines, "  return true;")
    }
  } else if t == "variant" {
    let vn = sv(xs[1])
    let (g2, sid) = sym(g, vn)
    g = g2
    lines = push(lines, "  if (!(v.t == T_ENUM && ENUMV(v)->var == {sid})) \{")
    if is_nil(xs[2]) && !contains(g.variants, vn) {
      lines = push(lines, "    return v.t == T_STRUCT && !strcmp(STRUCTV(v)->ty->name, " + c_str(vn) + ");")
    } else {
      lines = push(lines, "    return false;")
    }
    lines = push(lines, "  }")
    if is_nil(xs[2]) {
      lines = push(lines, "  (void)L; return true;")
    } else {
      let (g3, cs) = pats(g, items(xs[2]))
      g = g3
      lines = push(lines, "  if (ENUMV(v)->n != {len(cs)}) die(\"模式 {vn} 需要 %d 个字段\", ENUMV(v)->n);")
      var i = 0
      for s in cs {
        lines = push(lines, "  if (!{s}(ENUMV(v)->a[{i}], L)) return false;")
        i += 1
      }
      lines = push(lines, "  return true;")
    }
  } else if t == "struct" {
    let sn = sv(xs[1])
    var cs: List<(Int, Str)> = []
    for fp in items(xs[2]) {
      let fx = items(fp)
      let (g2, fsym) = sym(g, sv(fx[0]))
      let (g3, s) = pat(g2, fx[1])
      g = g3
      cs = push(cs, (fsym, s))
    }
    lines = push(lines, "  if (v.t == T_STRUCT && !strcmp(STRUCTV(v)->ty->name, " + c_str(sn) + ")) \{")
    for (fsym, s) in cs {
      lines = push(lines, "    \{ int i = sfield(STRUCTV(v), {fsym}); if (i < 0 || !{s}(STRUCTV(v)->f[i], L)) return false; \}")
    }
    lines = push(lines, "    return true;")
    let (g4, ssid) = sym(g, sn)
    g = g4
    lines = push(lines, "  \} else if (v.t == T_ENUM && ENUMV(v)->var == {ssid} && ENUMV(v)->names) \{")
    for (fsym, s) in cs {
      lines = push(lines, "    \{ int i, ok = 0; for (i = 0; i < ENUMV(v)->n; i++) if (ENUMV(v)->names[i] == {fsym}) \{ ok = {s}(ENUMV(v)->a[i], L); break; \} if (!ok) return false; \}")
    }
    lines = push(lines, "    return true;")
    lines = push(lines, "  }")
    lines = push(lines, "  return false;")
  } else {
    g = gerr(g, "原生后端: 未知模式 {t}")
  }
  lines = push(lines, "}")
  (Gn { pats: lset(g.pats, k, join(lines, "\n")), ..g }, name)
}

// ───────── 入口（Gen.generate）─────────

pub fn generate(bs: S, chunk: Int, src_name: Str, sources: List<Str>, runtime: Str) -> Str { generate_k(bs, chunk, src_name, sources, runtime, Map()) }

// kf：kir.collect 的结果（空表相当于 KITE_NO_KIR=1）
pub fn generate_k(bs: S, chunk: Int, src_name: Str, sources: List<Str>, runtime: Str, kf: Map<Str, KF>) -> Str {
  var bmap: Map<Str, Str> = Map()
  for kv in split(BUILTIN_C, " ") {
    let p = split(kv, "=")
    bmap = set(bmap, p[0], p[1])
  }
  var tids: Map<Str, Int> = Map()
  var i = 0
  for t in FIXED_TYPES {
    tids = set(tids, t, i)
    i += 1
  }
  var g = Gn {
    bs: bs,
    protos: [],
    pid: Map(),
    pname: Map(),
    syms: [],
    symid: Map(),
    strs: [],
    strid: Map(),
    gnames: [],
    gid: Map(),
    types: FIXED_TYPES,
    tid: tids,
    pats: [],
    fsyms: [],
    fsym_id: Map(),
    assigned: Map(),
    structs: [],
    enums: [],
    variants: Map(),
    bmap: bmap,
    ext_id: Map(),
    cstructs: Map(),
    cs_n: 0,
    out: [],
    err: "",
    kf: kf,
    kprot: Map(),
    knames: Map(),
  }
  for s in ["Ok", "Err", "Some", "None"] {
    g = sym(g, s).0
    g = Gn { variants: set(g.variants, s, true), ..g }
  }
  g = add_proto(g, chunk)
  for name in bs.gord {
    match gv(g, name) {
      GFn(p) => { g = add_proto(g, p) },
      _      => {},
    }
  }
  for t in bs.mord {
    let (mo, mt) = unwrap(get(bs.mtab, t))
    for m in mo {
      let p = unwrap(get(mt, m))
      g = add_proto(Gn { pname: set(g.pname, p, t + "." + m), ..g }, p)
    }
  }
  for name in bs.gord {
    match gv(g, name) {
      GStruct(f) => { g = type_id(Gn { structs: push(g.structs, (name, f)), ..g }, name).0 },
      GEnum(v)   => {
        g = type_id(Gn { enums: push(g.enums, (name, v)), ..g }, name).0
        for x in items(v) { g = Gn { variants: set(g.variants, sv(items(x)[0]), true), ..g } }
      },
      _          => {},
    }
  }
  for t in bs.mord { g = type_id(g, t).0 }
  for p in g.protos {
    for (op, arg) in bs.protos[p].code {
      if op == "STORE_G" || op == "DEF_G" { g = Gn { assigned: set(g.assigned, sv(arg), true), ..g } }
      if op == "LOAD_G" || op == "STORE_G" || op == "DEF_G" { g = glob_(g, sv(arg)) }
      if op == "CALL_M" {
        let nm = sv(items(arg)[0])
        let v = gv(g, nm)
        if is_closure(v) || is_builtin(v) { g = glob_(g, nm) }
      }
    }
  }
  for name in bs.gord {
    match gv(g, name) {
      GFn(_)     => { g = glob_(g, name) },
      GStruct(_) => { g = glob_(g, name) },
      GEnum(_)   => { g = glob_(g, name) },
      _          => {},
    }
  }
  g = glob_(g, "main")
  var bodies: List<Str> = []
  let knames = kir_cnames(kf)
  var kprot: Map<Int, Str> = Map()
  for name in keys(kf) {
    if ends_with(name, "#m") {
      let base = __str_slice(name, 0, len(name) - 2)
      var dot = -1
      var i = 0
      for ch in chars(base) {
        if ch == "." { dot = i }
        i += 1
      }
      let cs_ = chars(base)
      let tn = join(take(cs_, dot), "")
      let mn = join(skip(cs_, dot + 1), "")
      if let Some((_, mt)) = get(bs.mtab, tn) {
        if let Some(p) = get(mt, mn) { if contains(g.pid, p) { kprot = set(kprot, p, name) } }
      }
      continue
    }
    match gv(g, name) {
      GFn(p) => { if contains(g.pid, p) && !contains(g.assigned, name) { kprot = set(kprot, p, name) } },
      _      => {},
    }
  }
  g = Gn { kprot: kprot, knames: knames, ..g }
  if len(keys(kf)) > 0 {
    bodies = push(bodies, "/* ───── KIR 函数（不装箱） ───── */")
    for n in sort(keys(kf)) {
      let f = unwrap(get(kf, n))
      bodies = push(bodies, kir_sig(f, knames, n, -1) + ";")
      var j = 0
      for lf in f.lams {
        bodies = push(bodies, kir_sig(lf, knames, n, j) + ";")
        j += 1
      }
    }
    bodies = push(bodies, KIR_HELPERS)
    for n in sort(keys(kf)) {
      let f = unwrap(get(kf, n))
      let (g5, c5) = kir_emit(g, f, knames, n, -1)
      g = g5
      bodies = push(bodies, c5)
      var j = 0
      for lf in f.lams {
        let (g6, c6) = kir_emit(g, lf, knames, n, j)
        g = g6
        bodies = push(bodies, c6)
        j += 1
      }
    }
  }
  for p in g.protos {
    let (g2, b) = gen_proto(g, p)
    g = g2
    bodies = push(bodies, b)
  }
  g = assemble(g, chunk, bodies, src_name, sources, runtime)
  if g.err != "" { return "N " + g.err }
  join(g.out, "\n") + "\n"
}

pub fn first_replace(s: Str, a: Str, b: Str) -> Str {
  match strings_find(s, a) {
    Some(i) => __str_slice(s, 0, i) + b + __str_slice(s, i + len(a), len(s)),
    None    => s,
  }
}

fn strings_find(s: Str, sub: Str) -> Option<Int> {
  let i = __str_find(s, sub, 0)
  if i < 0 { None } else { Some(i) }
}

fn fs_truthy(fs: V) -> Bool { len(items(fs)) > 0 }

fn is_rec(fs: V) -> Bool {
  match fs {
    VR(_) => true,
    _     => false,
  }
}

fn assemble(g0: Gn, chunk: Int, bodies: List<Str>, src_name: Str, sources: List<Str>, runtime: Str) -> Gn {
  var g = g0
  g = w(g, runtime)
  g = w(g, "\n/* ───────────── 生成代码 ───────────── */")
  var ctor_defs: List<(Int, Int, Int, Str, Str)> = []
  var etype_cases: List<(Int, List<Str>)> = []
  for (en, vs) in g.enums {
    let t = tid(g, en)
    var cases: List<Str> = []
    for vx in items(vs) {
      let vn = sv(items(vx)[0])
      let fs = items(vx)[1]
      let (g2, sid) = sym(g, vn)
      g = g2
      if en == "Result" || en == "Option" {
        cases = push(cases, if vn == "None" { "case {sid}: return kNone();" } else { "case {sid}: return mkp(T_FN, &bf_b_{vn});" })
      } else if fs_truthy(fs) {
        var names = map(items(fs), (f) => sv(items(f)[0]))
        if is_rec(fs) { names = push(names, "__rec") }
        let (g3, arr) = symarr(g, names)
        g = g3
        ctor_defs = push(ctor_defs, (t, sid, len(items(fs)), arr, vn))
        cases = push(cases, "case {sid}: return mkp(T_FN, &CT_{t}_{sid});")
      } else {
        cases = push(cases, "case {sid}: return mkenum({t}, {sid}, 0, NULL, NULL);")
      }
    }
    etype_cases = push(etype_cases, (t, cases))
  }
  for (sn, fs) in g.structs { g = symarr(g, map(items(fs), (x) => sv(x))).0 }
  var method_cases: List<(Int, List<(Int, Int)>)> = []
  for tn in g.bs.mord {
    let (mo, mt) = unwrap(get(g.bs.mtab, tn))
    var ms: List<(Int, Int)> = []
    for m in mo {
      let (g2, sid) = sym(g, m)
      g = g2
      ms = push(ms, (sid, pk(g, unwrap(get(mt, m)))))
    }
    method_cases = push(method_cases, (tid(g, tn), ms))
  }
  var ufcs: List<(Int, Int)> = []
  for name in g.gnames {
    let v = gv(g, name)
    if contains(g.symid, name) && (is_closure(v) || is_builtin(v)) { ufcs = push(ufcs, (unwrap(get(g.symid, name)), unwrap(get(g.gid, name)))) }
  }
  let pat_code = g.pats
  g = w(g, "const char *SYMS[] = \{" + join(map(g.syms, (s) => c_str(s)), ", ") + "};")
  g = w(g, "const char *TNAMES[] = \{" + join(map(g.types, (s) => c_str(s)), ", ") + "};")
  g = w(g, "static V G[{max(len(g.gnames), 1)}];")
  g = w(g, "static V KS[{max(len(g.strs), 1)}];")
  var k = 0
  for arr in g.fsyms {
    let body = if len(arr) == 0 { "0" } else { join(map(arr, (x) => str(x)), ", ") }
    g = w(g, "static const int FS{k}[] = \{" + body + "};")
    k += 1
  }
  for (sn, fs) in g.structs {
    let t = tid(g, sn)
    let names = map(items(fs), (x) => sv(x))
    let (g2, arr) = symarr(g, names)
    g = w(g2, "static KSType ST_{t} = \{ {t}, " + c_str(sn) + ", {len(names)}, {arr} \};")
  }
  for (en, _) in g.enums {
    let t = tid(g, en)
    g = w(g, "static KEType ET_{t} = \{ {t}, " + c_str(en) + " \};")
  }
  for (t, sid, n, names, vn) in ctor_defs {
    g = w(g, "static KFn CT_{t}_{sid} = \{ ctor_code, " + c_str(vn) + ", {t}, {sid}, {n}, {names}, 0 \};")
  }
  k = 0
  for p in g.protos {
    g = w(g, "static V p{k}(KFn *self, int argc, V *argv);")
    g = w(g, "static KFn CL{k} = \{ p{k}, " + c_str(pn(g, p)) + ", 0, 0, 0, 0, 0 \};")
    k += 1
  }
  g = w(g, "static bool pat_dummy(void) \{ return false; \}")
  g = w(g, FAST_C)
  g = w(g, "static KFn *find_method(int tid, int sym) \{")
  g = w(g, "  switch (tid) \{")
  for (t, ms) in method_cases {
    g = w(g, "  case {t}: switch (sym) \{ " + join(map(ms, (m) => "case {m.0}: return &CL{m.1};"), " ") + " \} break;")
  }
  g = w(g, "  }")
  g = w(g, "  return NULL;")
  g = w(g, "}")
  g = w(g, "static int global_of_sym(int sym) \{")
  g = w(g, "  switch (sym) \{ " + join(map(ufcs, (u) => "case {u.0}: return {u.1};"), " ") + " \}")
  g = w(g, "  return -1;")
  g = w(g, "}")
  g = w(g, "static V etype_member(KEType *et, int sym) \{")
  g = w(g, "  switch (et->id) \{")
  for (t, cases) in etype_cases {
    g = w(g, "  case {t}: switch (sym) \{ " + join(cases, " ") + " \} break;")
  }
  g = w(g, "  }")
  g = w(g, "  die(\"%s 没有变体 %s\", et->name, SYMS[sym]); return UNIT;")
  g = w(g, "}")
  g = w(g, CALL_M_C)
  k = 0
  for _ in pat_code {
    g = w(g, "static bool pat{k}(V v, V *L);")
    k += 1
  }
  for c in pat_code { g = w(g, c) }
  for b in bodies { g = w(g, b) }
  g = externs(g)
  g = w(g, "static void kite_main(void) \{")
  g = w(g, "  KITE_FILE = " + c_str(src_name) + ";")
  if len(sources) > 1 {
    var fl: List<Str> = []
    var j = 0
    for f in sources {
      fl = push(fl, c_str(if j == 0 { path.base(f) } else { f }))
      j += 1
    }
    g = w(g, "  static const char *files[] = \{ " + join(fl, ", ") + " \};")
    g = w(g, "  KITE_FILES = files; KITE_NFILES = {len(sources)};")
  }
  g = w(g, "  gc_add_root(G, {max(len(g.gnames), 1)}); gc_add_root(KS, {max(len(g.strs), 1)});")
  if contains(g.symid, "__rec") { g = w(g, "  KITE_SYM_REC = {unwrap(get(g.symid, "__rec"))};") }
  let si = (n: Str) => unwrap(get(g.symid, n))
  g = w(g, "  SYM_Ok = {si("Ok")}; SYM_Err = {si("Err")}; SYM_Some = {si("Some")}; SYM_None = {si("None")};")
  k = 0
  for s in g.strs {
    g = w(g, "  KS[{k}] = mkstr(" + c_str(s) + ", {len(__bytes(s))});")
    k += 1
  }
  for name in g.gnames {
    let gi = unwrap(get(g.gid, name))
    let (g2, init) = global_init(g, name)
    g = g2
    if init != "" { g = w(g, "  G[{gi}] = {init};") }
  }
  let ck = pk(g, chunk)
  g = w(g, "  p{ck}(&CL{ck}, 0, NULL);")
  let mg = unwrap(get(g.gid, "main"))
  if is_closure(gv(g, "main")) { g = w(g, "  if (G[{mg}].t == T_FN) call_v(G[{mg}], 0, NULL);") }
  w(g, "}")
}

fn global_init(g: Gn, name: Str) -> (Gn, Str) {
  if !contains(g.bs.gval, name) { return (g, "") }
  match gv(g, name) {
    GExt(_, _)  => (g, "mkp(T_FN, &bfx{unwrap(get(g.ext_id, name))})"),
    GFn(p)      => (g, "mkp(T_FN, &CL{pk(g, p)})"),
    GStruct(_)  => (g, "mkp(T_STYPE, &ST_{tid(g, name)})"),
    GEnum(_)    => (g, "mkp(T_ETYPE, &ET_{tid(g, name)})"),
    GEVal(en, vn) => {
      if vn == "None" { return (g, "kNone()") }
      let (g2, sid) = sym(g, vn)
      (g2, "mkenum({tid(g2, en)}, {sid}, 0, NULL, NULL)")
    },
    GMod(m)     => {
      if !contains(["io", "fs", "math", "ptr"], m) { return (gerr(g, "原生后端暂不支持模块 {m}"), "") }
      (g, "mkp(T_MODULE, (void *)" + c_str(m) + ")")
    },
    GCtor(vn)   => builtin_init(g, vn),
    GBuiltin(n) => builtin_init(g, n),
    GMember(n)  => {
      match std_const(n) {
        Some(c) => {
          if contains(c, ".") || contains(["inf", "nan"], c) || contains(c, "e") { const_c(g, VF(unwrap(parse_float(c)))) } else { const_c(g, VI(unwrap(parse_int(c)))) }
        },
        None    => builtin_init(g, n),
      }
    },
    GOther      => (g, ""),
  }
}

fn builtin_init(g: Gn, n: Str) -> (Gn, Str) {
  for (en, vs) in g.enums {
    if en != "Result" && en != "Option" {
      for vx in items(vs) {
        if sv(items(vx)[0]) == n && fs_truthy(items(vx)[1]) {
          let (g2, sid) = sym(g, n)
          return (g2, "mkp(T_FN, &CT_{tid(g2, en)}_{sid})")
        }
      }
    }
  }
  if let Some(c) = get(g.bmap, n) { return (g, "mkp(T_FN, &bf_{c})") }
  if let Some(m) = std_mod_of(n) { return (g, "module_get(" + c_str(m) + ", " + c_str(n) + ")") }
  (gerr(g, "原生后端暂不支持内建函数 {n}"), "")
}

// ───────── extern fn ─────────

fn cty_prim(d: Str) -> Str {
  match d {
    "Int"   => "int64_t",
    "Float" => "double",
    "Bool"  => "bool",
    "Str"   => "const char *",
    "Unit"  => "void",
    "Ptr"   => "void *",
    "I8"    => "int8_t",
    "I16"   => "int16_t",
    "I32"   => "int32_t",
    "I64"   => "int64_t",
    "U8"    => "uint8_t",
    "U16"   => "uint16_t",
    "U32"   => "uint32_t",
    "U64"   => "uint64_t",
    "F32"   => "float",
    "F64"   => "double",
    _       => "?",
  }
}

fn c_range(d: Str) -> Option<(Str, Str)> {
  match d {
    "I8"  => Some(("-128", "127")),
    "I16" => Some(("-32768", "32767")),
    "I32" => Some(("-2147483648", "2147483647")),
    "U8"  => Some(("0", "255")),
    "U16" => Some(("0", "65535")),
    "U32" => Some(("0", "4294967295")),
    _     => None,
  }
}

fn cty(g0: Gn, d: V) -> (Gn, Str) {
  match d {
    VS(s) => (g0, cty_prim(s)),
    _     => {
      let xs = items(d)
      if sv(xs[0]) == "F" { return (g0, "void *") }
      let key = ast.dump(d)
      if let Some(n) = get(g0.cstructs, key) { return (g0, n) }
      var g = g0
      var parts: List<Str> = []
      for fd in items(xs[2]) {
        let (g2, ct) = cty(g, items(fd)[1])
        g = g2
        parts = push(parts, ct + " " + sv(items(fd)[0]) + ";")
      }
      let nm = "kxs_{g.cs_n}_" + sv(xs[1])
      g = Gn { cstructs: set(g.cstructs, key, nm), cs_n: g.cs_n + 1, ..g }
      (w(g, "typedef struct \{ " + join(parts, " ") + " \} " + nm + ";"), nm)
    },
  }
}

fn to_c(g0: Gn, src: Str, d: V) -> (Gn, Str) {
  match d {
    VS(s) => {
      if let Some((lo, hi)) = c_range(s) { return (g0, "((" + cty_prim(s) + ")kx_rng((" + src + ").u.i, " + lo + "LL, " + hi + "LL, " + c_str(s) + "))") }
      let flt = "((" + src + ").t == T_INT ? (double)(" + src + ").u.i : (" + src + ").u.f)"
      (g0, match s {
        "Int"   => "(" + src + ").u.i",
        "I64"   => "(" + src + ").u.i",
        "U64"   => "(uint64_t)(" + src + ").u.i",
        "Float" => flt,
        "F64"   => flt,
        "F32"   => "(float)" + flt,
        "Bool"  => "(bool)(" + src + ").u.i",
        "Str"   => "CSTR(" + src + ")",
        "Ptr"   => "(void *)(intptr_t)(" + src + ").u.i",
        _       => "?",
      })
    },
    _     => {
      var g = g0
      var sets: List<Str> = []
      var k = 0
      for fd in items(items(d)[2]) {
        let (g2, c) = to_c(g, "STRUCTV(" + src + ")->f[{k}]", items(fd)[1])
        g = g2
        sets = push(sets, "t_." + sv(items(fd)[0]) + " = " + c + ";")
        k += 1
      }
      let (g3, ct) = cty(g, d)
      (g3, "(\{ " + ct + " t_; " + join(sets, " ") + " t_; \})")
    },
  }
}

fn from_c(g0: Gn, src: Str, d: V) -> (Gn, Str) {
  match d {
    VS(s) => {
      if cty_prim(s) != "?" && (starts_with(s, "I") || starts_with(s, "U")) { return (g0, "mkint((int64_t)(" + src + "))") }
      if s == "F32" || s == "F64" { return (g0, "mkflt((double)(" + src + "))") }
      (g0, match s {
        "Int"   => "mkint(" + src + ")",
        "Float" => "mkflt(" + src + ")",
        "Bool"  => "mkbool(" + src + ")",
        "Ptr"   => "mkint((int64_t)(intptr_t)(" + src + "))",
        "Str"   => "cstr((" + src + ") ? (" + src + ") : \"\")",
        _       => "?",
      })
    },
    _     => {
      var g = g0
      var vals: List<Str> = []
      let fds = items(items(d)[2])
      for fd in fds {
        let (g2, c) = from_c(g, "(" + src + ")." + sv(items(fd)[0]), items(fd)[1])
        g = g2
        vals = push(vals, c)
      }
      let fs = map(fds, (fd) => sv(items(fd)[0]))
      let (g3, arr) = symarr(g, fs)
      (g3, "(\{ V v_[{len(fs)}] = \{ " + join(vals, ", ") + " \}; k_struct(&ST_{tid(g3, sv(items(d)[1]))}, {len(fs)}, " + arr + ", v_); \})")
    },
  }
}

fn ext_fn(it: ast.Node) -> ast.FnD {
  match it.k {
    NFn(f) => f,
    _      => ast.FnD { name: "", params: [], ret: None, body: None, gen: ast.no_gen(), is_async: false, is_unsafe: false, varargs: false, ext: None,
      cname: None, x: ast.no_fnx() },
  }
}

fn externs(g0: Gn) -> Gn {
  var g = g0
  var exts: List<(Str, ast.Node, V)> = []
  for n in g.bs.gord {
    match gv(g, n) {
      GExt(it, va) => { exts = push(exts, (n, it, match va {
        Some(xs) => VL(map(xs, (x) => VS(x))),
        None     => VNil,
      })) },
      _            => {},
    }
  }
  if len(exts) > 0 {
    g = w(g, "#define KX_STR2(x) #x\n#define KX_STR(x) KX_STR2(x)")
    g = w(g, "static int64_t kx_rng(int64_t v, int64_t lo, int64_t hi, const char *t) \{ if (v < lo || v > hi) die(\"extern: %lld 超出 %s 的范围\", (long long)v, t); return v; \}")
  }
  var i = 0
  for (n, it, va) in exts {
    let fd = ext_fn(it)
    let cname = unwrap_or(fd.cname, fd.name)
    let (ds, rd) = unwrap(fd.x.ext_tys)
    var ptys = map(ds, ast.xd_v)
    let rty = ast.xd_v(rd)
    let nfixed = len(ptys)
    if !is_nil(va) { ptys = ptys + items(va) }
    g = Gn { ext_id: set(g.ext_id, n, i), ..g }
    var protos: List<Str> = []
    var j = 0
    for t in ptys {
      if is_nil(va) || j < nfixed {
        let (g2, c) = cty(g, t)
        g = g2
        protos = push(protos, c)
      }
      j += 1
    }
    if !is_nil(va) { protos = push(protos, "...") }
    let proto = if len(protos) == 0 { "void" } else { join(protos, ", ") }
    let (g3, rc) = cty(g, rty)
    g = w(g3, "extern " + rc + " kx_sym{i}(" + proto + ") __asm__(KX_STR(__USER_LABEL_PREFIX__) " + c_str(cname) + ");")
    var cbs: List<Int> = []
    j = 0
    for t in ptys {
      match t {
        VT(xs) => { if sv(xs[0]) == "F" { cbs = push(cbs, j) } },
        _      => {},
      }
      j += 1
    }
    for cj in cbs {
      let fx = items(ptys[cj])
      let cps = map(items(fx[1]), (x) => sv(x))
      let cr = sv(fx[2])
      g = w(g, "static __thread V kxcb{i}_{cj};")
      var pl: List<Str> = []
      var vl: List<Str> = []
      var q = 0
      for t in cps {
        pl = push(pl, cty_prim(t) + " a{q}")
        let (g4, c) = from_c(g, "a{q}", VS(t))
        g = g4
        vl = push(vl, c)
        q += 1
      }
      let params = if len(pl) == 0 { "void" } else { join(pl, ", ") }
      let vals = join(vl, ", ")
      let arr = "V cv_[{max(len(cps), 1)}] = \{ " + (if vals == "" { "UNIT" } else { vals }) + " \};"
      let callv = "call_v(kxcb{i}_{cj}, {len(cps)}, cv_)"
      var body = ""
      if cr == "Unit" { body = arr + " " + callv + ";" } else {
        let (g5, rcv) = to_c(g, "r_", VS(cr))
        g = g5
        body = arr + " V r_ = " + callv + "; return " + rcv + ";"
      }
      g = w(g, "static " + cty_prim(cr) + " kxtr{i}_{cj}(" + params + ") \{ " + body + " \}")
    }
    var al: List<Str> = []
    j = 0
    for t in ptys {
      if contains(cbs, j) { al = push(al, "(void *)kxtr{i}_{j}") } else {
        let (g6, c) = to_c(g, "argv[{j}]", t)
        g = g6
        al = push(al, c)
      }
      j += 1
    }
    let call = "kx_sym{i}(" + join(al, ", ") + ")"
    let save = join(map(cbs, (cj) => "V sv{cj}_ = kxcb{i}_{cj}; kxcb{i}_{cj} = argv[{cj}];"), " ")
    let rest = join(map(cbs, (cj) => "kxcb{i}_{cj} = sv{cj}_;"), " ")
    var ret = ""
    if sv(rty) == "Unit" && !is_nil(rty) { ret = save + " " + call + "; " + rest + " return UNIT;" } else {
      let (g7, rc2) = cty(g, rty)
      let (g8, fc) = from_c(g7, "r", rty)
      g = g8
      ret = save + " " + rc2 + " r = " + call + "; " + rest + " return " + fc + ";"
    }
    g = w(g, "B(bx{i}) \{ NARGS({len(ptys)}, {len(ptys)}); " + ret + " \}")
    g = w(g, "static KFn bfx{i} = \{ bx{i}, " + c_str(cname) + ", 0, 0, 0, 0, 0 \};")
    i += 1
  }
  g
}

// ───────── KIR → C（kir.py 的 cnames / c_sig / emit_c / emit_wrapper，自举第 3d 步）─────────

const KIR_HELPERS: Str = "\nstatic inline int kir_try(V v) \{\n  int vr = v.t == T_ENUM ? ENUMV(v)->var : -1;\n  if (vr == SYM_Ok || vr == SYM_Some) return 1;\n  if (vr == SYM_Err || vr == SYM_None) return 0;\n  die(\"? 只能用于 Result 或 Option\"); return 0;\n\}\nstatic KUp *kir_up(V v) \{\n  KUp *u = kalloc(sizeof(KUp)); u->closed = v; u->ref = &u->closed; u->next = NULL; u->owner = cur_task; return u;\n\}\nstatic inline V kir_gload(int g, const char *name) \{\n  if (__builtin_expect(G[g].t == T_UNDEF, 0)) die(\"未定义的名字 %s\", name);\n  return G[g];\n\}\nstatic V kir_vbin(int op, V a, V b) \{\n  switch (op) \{\n  case 0: return f_add(a, b); case 1: return f_sub(a, b); case 2: return f_mul(a, b);\n  case 3: return k_div(a, b); case 4: return k_mod(a, b);\n  case 5: return f_lt(a, b); case 6: return f_gt(a, b); case 7: return f_le(a, b); case 8: return f_ge(a, b);\n  case 9: return f_eq(a, b); case 10: return f_ne(a, b);\n  case 11: return k_range(a, b, 0); case 12: return k_range(a, b, 1);\n  \}\n  return UNIT;\n\}\n"

// KIR 函数名 → C 函数名（按名字排序编号）；lambda 记作 "名字#下标"
fn kir_cnames(kf: Map<Str, KF>) -> Map<Str, Str> {
  var names: Map<Str, Str> = Map()
  var i = 0
  for n in sort(keys(kf)) {
    var s = "kf{i}_"
    for ch in chars(n) {
      let o = __ord(ch)
      s = s + (if o < 128 && ((o >= 48 && o <= 57) || (o >= 65 && o <= 90) || (o >= 97 && o <= 122)) { ch } else { "_" })
    }
    names = set(names, n, s)
    i += 1
  }
  var k = 0
  for n in sort(keys(kf)) {
    var j = 0
    for _ in unwrap(get(kf, n)).lams {
      names = set(names, n + "#{j}", "kl{k}")
      k += 1
      j += 1
    }
  }
  names
}

fn ctype(t: Str) -> Str {
  if t == "i64" { "int64_t" } else if t == "f64" { "double" } else if t == "b1" { "bool" } else if t == "cell" { "KUp *" } else { "V" }
}

fn c_ret(t: Str) -> Str { if t == "unit" || t == "never" { "void" } else { ctype(t) } }

// owner：函数所属的顶层 KIR 函数名；li：lambda 下标（顶层函数为 -1）
fn kir_cname(names: Map<Str, Str>, owner: Str, li: Int) -> Str {
  if li >= 0 { unwrap_or(get(names, owner + "#{li}"), "") } else { unwrap_or(get(names, owner), "") }
}

fn kir_sig(f: KF, names: Map<Str, Str>, owner: Str, li: Int) -> Str {
  if f.closure { return "static V " + kir_cname(names, owner, li) + "(KFn *self, int argc, V *argv)" }
  let ps = join(map(f.params, (p) => ctype(kir.aty(p)) + " r{kir.rid(p)}"), ", ")
  "static " + c_ret(f.ret) + " " + kir_cname(names, owner, li) + "(" + (if ps == "" { "void" } else { ps }) + ")"
}

fn kbox(t: Str, x: Str) -> Str {
  if t == "i64" { "mkint(" + x + ")" } else if t == "f64" { "mkflt(" + x + ")" } else if t == "b1" { "mkbool(" + x + ")" } else { x }
}

fn kunbox(t: Str, x: Str) -> Str {
  if t == "i64" { "(" + x + ").u.i" } else if t == "f64" { "(" + x + ").u.f" } else if t == "b1" { "((" + x + ").u.i != 0)" } else { x }
}

fn kir_a(g: Gn, a: A) -> (Gn, Str) {
  match a {
    R(i, _) => (g, "r{i}"),
    CU      => (g, "UNIT"),
    CS(s)   => sconst(g, s),
    CB(b)   => (g, if b { "1" } else { "0" }),
    CI(i)   => (g, if i == -9223372036854775807 - 1 { "INT64_MIN" } else { "INT64_C({i})" }),
    CF(x)   => {
      if x != x { return (g, "NAN") }
      if x > 1.7976931348623157e308 { return (g, "INFINITY") }
      if x < -1.7976931348623157e308 { return (g, "(-INFINITY)") }
      (g, float_hex(x))
    },
  }
}

fn kir_as(g0: Gn, xs: List<A>) -> (Gn, List<Str>) {
  var g = g0
  var out: List<Str> = []
  for x in xs {
    let (g2, s) = kir_a(g, x)
    g = g2
    out = push(out, s)
  }
  (g, out)
}

fn argv_c(vals: List<Str>) -> (Str, Str) {
  if len(vals) == 0 { return ("0, NULL", "") }
  ("{len(vals)}, a_", "V a_[{len(vals)}] = \{" + join(vals, ", ") + "\}; ")
}

fn direct_c(g: Gn, name: Str) -> Int {
  match gv(g, name) {
    GFn(p) => if !contains(g.assigned, name) && contains(g.pid, p) { pk(g, p) } else { -1 },
    _      => -1,
  }
}

fn vbin_n(op: Str) -> Int {
  let ops = ["+", "-", "*", "/", "%", "<", ">", "<=", ">=", "==", "!=", "..", "..="]
  var i = 0
  for o in ops {
    if o == op { return i }
    i += 1
  }
  0
}

const KLINE_OPS: List<Str> = ["cset", "wfield", "windex", "vbin", "vneg", "callg", "callm", "callv", "field", "tidx", "index", "interp", "struct", "iter", "next", "tryok", "tpat", "unbox", "gload", "call"]

fn kir_emit(g0: Gn, f: KF, names: Map<Str, Str>, owner: Str, li: Int) -> (Gn, Str) {
  var g = g0
  var ls = [kir_sig(f, names, owner, li) + " \{"]
  var regs: Map<Int, Str> = Map()
  for b in f.blocks {
    for ins in b.ins {
      if let Some(d) = ins.d { regs = set(regs, kir.rid(d), kir.aty(d)) }
      if ins.op == "next" {
        if let XR(ri, _) = ins.x { regs = set(regs, ri, "val") }
      }
    }
  }
  var pids: Map<Int, Bool> = Map()
  for p in f.params { pids = set(pids, kir.rid(p), true) }
  if f.closure {
    let n = len(f.params)
    ls = push(ls, "  if (argc != {n}) arity(self, {n}, argc);")
    var i = 0
    for p in f.params {
      ls = push(ls, "  " + ctype(kir.aty(p)) + " r{kir.rid(p)} = " + kunbox(kir.aty(p), "argv[{i}]") + ";")
      i += 1
    }
    i = 0
    for c in f.caps {
      if kir.aty(c) == "cell" { ls = push(ls, "  KUp *r{kir.rid(c)} = self->ups[{i}];") } else {
        ls = push(ls, "  " + ctype(kir.aty(c)) + " r{kir.rid(c)} = " + kunbox(kir.aty(c), "*self->ups[{i}]->ref") + ";")
      }
      pids = set(pids, kir.rid(c), true)
      i += 1
    }
  }
  for rid in sort(keys(regs)) {
    if !contains(pids, rid) {
      let ty = unwrap(get(regs, rid))
      ls = push(ls, "  " + ctype(ty) + " r{rid} = " + (if ty == "val" { "UNIT" } else if ty == "cell" { "NULL" } else { "0" }) + ";")
    }
  }
  let (g1, pnames) = pats(g, f.pats)
  g = g1
  if f.ndefer > 0 {
    ls = push(ls, "  V defers[{f.ndefer}]; int nd = 0; KUp *open = NULL; V FL_[1];")
    ls = push(ls, "  KFrame fr_ = \{ cur_frame, &open, FL_, defers, &nd \}; cur_frame = &fr_;")
  }
  let npb = max(f.npb, 1)
  if len(f.pats) > 0 { ls = push(ls, "  V PB[{npb}]; for (int i_ = 0; i_ < {npb}; i_++) PB[i_] = UNIT;") }
  ls = push(ls, "  SAFEPOINT(); CANCEL_POINT();")
  var order: Map<Int, Int> = Map()
  var bi = 0
  for b in f.blocks {
    order = set(order, b.id, bi)
    bi += 1
  }
  bi = 0
  for b in f.blocks {
    ls = push(ls, " B{b.id}:;")
    var cur_line = -1
    for ins in b.ins {
      let d = match ins.d {
        Some(x) => "r{kir.rid(x)}",
        None    => "",
      }
      let (g2, a) = kir_as(g, ins.args)
      g = g2
      let op = ins.op
      let ln = ins.ln
      if contains(KLINE_OPS, op) && ln != cur_line {
        ls = push(ls, "  kline = {ln};")
        cur_line = ln
      }
      let xs_ = match ins.x {
        XS(s) => s,
        _     => "",
      }
      let xi = match ins.x {
        XI(i) => i,
        _     => 0,
      }
      if op == "copy" { ls = push(ls, "  {d} = {a[0]};") } else if op == "inc" { ls = push(ls, "  {d} = {d} + 1;") } else if op == "add.i64" || op == "sub.i64" || op == "mul.i64" {
        ls = push(ls, "  if (__builtin_" + __str_slice(op, 0, 3) + "_overflow({a[0]}, {a[1]}, &{d})) \{ kline = {ln}; die(\"整数溢出\"); \}")
      } else if op == "div.i64" {
        ls = push(ls, "  if ({a[1]} == 0) \{ kline = {ln}; die(\"除以零\"); \} if ({a[0]} == INT64_MIN && {a[1]} == -1) \{ kline = {ln}; die(\"整数溢出\"); \} {d} = {a[0]} / {a[1]};")
      } else if op == "rem.i64" {
        ls = push(ls, "  if ({a[1]} == 0) \{ kline = {ln}; die(\"除以零\"); \} {d} = {a[1]} == -1 ? 0 : {a[0]} % {a[1]};")
      } else if op == "add.f64" || op == "sub.f64" || op == "mul.f64" {
        let c = if op == "add.f64" { "+" } else if op == "sub.f64" { "-" } else { "*" }
        ls = push(ls, "  {d} = {a[0]} {c} {a[1]};")
      } else if op == "div.f64" { ls = push(ls, "  if ({a[1]} == 0.0) \{ kline = {ln}; die(\"除以零\"); \} {d} = {a[0]} / {a[1]};") } else if op == "rem.f64" { ls = push(ls, "  if ({a[1]} == 0.0) \{ kline = {ln}; die(\"除以零\"); \} {d} = fmod({a[0]}, {a[1]});") } else if op == "neg.i64" { ls = push(ls, "  if (__builtin_sub_overflow((int64_t)0, {a[0]}, &{d})) \{ kline = {ln}; die(\"整数溢出\"); \}") } else if op == "neg.f64" { ls = push(ls, "  {d} = -{a[0]};") } else if op == "bit.band" || op == "bit.bor" || op == "bit.bxor" {
        let c = if op == "bit.band" { "&" } else if op == "bit.bor" { "|" } else { "^" }
        ls = push(ls, "  {d} = {a[0]} {c} {a[1]};")
      } else if op == "bit.bnot" { ls = push(ls, "  {d} = ~{a[0]};") } else if op == "bit.shl" || op == "bit.shr" {
        ls = push(ls, "  if ((uint64_t){a[1]} >= 64) \{ kline = {ln}; die(\"移位位数超出范围: %lld\", (long long){a[1]}); \}")
        ls = push(ls, if op == "bit.shl" { "  {d} = (int64_t)((uint64_t){a[0]} << {a[1]});" } else { "  {d} = {a[0]} >> {a[1]};" })
      } else if op == "not" { ls = push(ls, "  {d} = !{a[0]};") } else if op == "lt" || op == "gt" || op == "le" || op == "ge" || op == "eq" || op == "ne" {
        let c = if op == "lt" { "<" } else if op == "gt" { ">" } else if op == "le" { "<=" } else if op == "ge" { ">=" } else if op == "eq" { "==" } else { "!=" }
        ls = push(ls, "  {d} = {a[0]} {c} {a[1]};")
      } else if op == "i2f" { ls = push(ls, "  {d} = (double){a[0]};") } else if op == "f2i" { ls = push(ls, "  if (!({a[0]} >= -9223372036854775808.0 && {a[0]} < 9223372036854775808.0)) \{ kline = {ln}; die(\"整数溢出\"); \} {d} = (int64_t){a[0]};") } else if op == "b2i" { ls = push(ls, "  {d} = {a[0]} ? 1 : 0;") } else if op == "abs.i64" { ls = push(ls, "  if ({a[0]} == INT64_MIN) \{ kline = {ln}; die(\"整数溢出\"); \} {d} = {a[0]} < 0 ? -{a[0]} : {a[0]};") } else if op == "abs.f64" { ls = push(ls, "  {d} = fabs({a[0]});") } else if op == "min" || op == "max" {
        let c = if op == "min" { "<" } else { ">" }
        ls = push(ls, "  {d} = {a[1]} {c} {a[0]} ? {a[1]} : {a[0]};")
      } else if op == "box" { ls = push(ls, "  {d} = " + kbox(kir.aty(ins.args[0]), a[0]) + ";") } else if op == "unbox" { ls = push(ls, "  {d} = " + kunbox(match ins.d {
        Some(x) => kir.aty(x),
        None    => "val",
      }, a[0]) + ";") } else if op == "mkcell" { ls = push(ls, "  {d} = kir_up({a[0]});") } else if op == "cget" { ls = push(ls, "  {d} = *{a[0]}->ref;") } else if op == "cset" { ls = push(ls, "  k_store_up({a[0]}, {a[1]});") } else if op == "defer" { ls = push(ls, "  defers[nd++] = {a[0]};") } else if op == "rundefers" { ls = push(ls, "  while (nd > {xi}) \{ nd--; call_v(defers[nd], 0, NULL); \}") } else if op == "spawn" { ls = push(ls, "  \{ V a_[{len(a)}] = \{" + join(a, ", ") + "\}; {d} = k_spawn({len(a)}, a_); \}") } else if op == "closure" {
        let lidx = match ins.x {
          XL(i) => i,
          _     => 0,
        }
        let lams = f.lams
        var ups: List<Str> = []
        var j = 0
        for x in a {
          ups = push(ups, "f_->ups[{j}] = " + (if kir.aty(ins.args[j]) == "cell" { x } else { "kir_up(" + x + ")" }) + ";")
          j += 1
        }
        let lbl = owner_label(g, names, owner, lidx)
        ls = push(ls, "  \{ V c_ = mkclosure(" + kir_cname(names, owner, lidx) + ", \"" + lbl + "\", {len(a)}); KFn *f_ = FN(c_); " + join(ups, " ") + " {d} = c_; \}")
      } else if op == "call" {
        let cl = unwrap_or(get(names, xs_), "") + "(" + join(a, ", ") + ")"
        ls = push(ls, if d != "" { "  {d} = " + cl + ";" } else { "  " + cl + ";" })
      } else if op == "callg" || op == "callv" || op == "callm" {
        var decl = ""
        var cl = ""
        if op == "callg" {
          let k = direct_c(g, xs_)
          let (cnt, dc) = argv_c(a)
          decl = dc
          if k >= 0 { cl = "p{k}(&CL{k}, " + cnt + ")" } else {
            let (g3, gi) = glob(g, xs_)
            g = g3
            cl = "call_v(kir_gload({gi}, " + c_str(xs_) + "), " + cnt + ")"
          }
        } else if op == "callv" {
          let (cnt, dc) = argv_c(skip(a, 1))
          decl = dc
          cl = "call_v({a[0]}, " + cnt + ")"
        } else {
          decl = "V a_[{len(a)}] = \{" + join(a, ", ") + "\}; "
          let (g3, si) = sym(g, xs_)
          g = g3
          cl = "call_m({si}, {len(a) - 1}, a_)"
        }
        ls = push(ls, "  \{ " + decl + (if d != "" { d + " = " } else { "" }) + cl + "; \}")
      } else if op == "gload" {
        let (g3, gi) = glob(g, xs_)
        g = g3
        ls = push(ls, "  {d} = kir_gload({gi}, " + c_str(xs_) + ");")
      } else if op == "vbin" { ls = push(ls, "  {d} = kir_vbin({vbin_n(xs_)}, {a[0]}, {a[1]});") } else if op == "vneg" { ls = push(ls, "  {d} = f_neg({a[0]});") } else if op == "list" || op == "tuple" {
        if len(a) == 0 { ls = push(ls, "  {d} = " + (if op == "list" { "mklist(0, NULL)" } else { "UNIT" }) + ";") } else {
          ls = push(ls, "  \{ V a_[{len(a)}] = \{" + join(a, ", ") + "\}; {d} = mk" + op + "({len(a)}, a_); \}")
        }
      } else if op == "struct" {
        let (sn, fs) = match ins.x {
          XST(n, f2) => (n, f2),
          _          => ("", []),
        }
        let ti = tid(g, sn)
        let (g3, fa) = symarr(g, fs)
        g = g3
        ls = push(ls, "  \{ V a_[{max(len(a), 1)}] = \{" + (if len(a) == 0 { "UNIT" } else { join(a, ", ") }) + "\}; {d} = k_struct(&ST_{ti}, {len(a)}, " + fa + ", a_); \}")
      } else if op == "interp" {
        let ps = match ins.x {
          XP(p) => p,
          _     => [],
        }
        var parts: List<Str> = []
        var ai = 0
        for p in ps {
          if p.0 {
            let (g3, sc) = sconst(g, p.1)
            g = g3
            parts = push(parts, sc)
          } else {
            parts = push(parts, a[ai])
            ai += 1
          }
        }
        ls = push(ls, "  \{ V a_[{len(parts)}] = \{" + join(parts, ", ") + "\}; {d} = k_interp({len(parts)}, a_); \}")
      } else if op == "field" {
        let (g3, si) = sym(g, xs_)
        g = g3
        ls = push(ls, "  {d} = k_field({a[0]}, {si});")
      } else if op == "tidx" { ls = push(ls, "  {d} = k_tidx({a[0]}, {xi});") } else if op == "wfield" {
        let (g3, si) = sym(g, xs_)
        g = g3
        ls = push(ls, "  {d} = k_wfield({a[0]}, {si}, {a[1]});")
      } else if op == "windex" { ls = push(ls, "  {d} = k_windex({a[0]}, {a[1]}, {a[2]});") } else if op == "index" { ls = push(ls, "  {d} = k_index({a[0]}, {a[1]});") } else if op == "iter" { ls = push(ls, "  {d} = k_iter({a[0]});") } else if op == "next" {
        let ri = match ins.x {
          XR(i, _) => i,
          _        => 0,
        }
        ls = push(ls, "  {d} = k_next({a[0]}, &r{ri});")
      } else if op == "tpat" { ls = push(ls, "  {d} = " + pnames[xi] + "({a[0]}, PB);") } else if op == "pbget" { ls = push(ls, "  {d} = PB[{xi}];") } else if op == "tryok" { ls = push(ls, "  {d} = kir_try({a[0]});") } else if op == "payload" { ls = push(ls, "  {d} = ENUMV({a[0]})->a[0];") } else { g = gerr(g, "C 生成: " + op) }
    }
    match b.t {
      TNone => { ls = push(ls, "  __builtin_unreachable();") },
      TUnr  => { ls = push(ls, "  __builtin_unreachable();") },
      TBr(x) => {
        let back = unwrap_or(get(order, x), 0) <= bi
        ls = push(ls, (if back { "  SAFEPOINT(); CANCEL_POINT(); " } else { "  " }) + "goto B{x};")
      },
      TCbr(c, x, y) => {
        let (g4, cs) = kir_a(g, c)
        g = g4
        ls = push(ls, "  if (" + cs + ") " + kjmp(order, bi, x) + " else " + kjmp(order, bi, y))
      },
      TRet(v) => {
        if f.ndefer > 0 { ls = push(ls, "  while (nd > 0) \{ nd--; call_v(defers[nd], 0, NULL); \} cur_frame = fr_.prev;") }
        match v {
          Some(x) => {
            let (g4, xs2) = kir_a(g, x)
            g = g4
            ls = push(ls, if f.closure { "  return " + kbox(kir.aty(x), xs2) + ";" } else { "  return " + xs2 + ";" })
          },
          None => { ls = push(ls, if f.closure { "  return UNIT;" } else { "  return;" }) },
        }
      },
      TPanic(m, v, pl) => {
        match v {
          Some(x) => {
            let (g4, xs2) = kir_a(g, x)
            g = g4
            ls = push(ls, "  kline = {pl}; die(\"" + m + "\", cshow(" + kbox(kir.aty(x), xs2) + "));")
          },
          None => { ls = push(ls, "  kline = {pl}; die(\"" + m + "\");") },
        }
      },
    }
    bi += 1
  }
  ls = push(ls, "}")
  (g, join(ls, "\n"))
}

fn owner_label(g: Gn, names: Map<Str, Str>, owner: Str, lidx: Int) -> Str {
  match get(g.kf, owner) {
    Some(of) => if lidx < len(of.lams) { of.lams[lidx].label } else { "<lambda>" },
    None     => "<lambda>",
  }
}

fn kir_wrapper(f: KF, names: Map<Str, Str>, owner: Str, k: Int, nparams: Int) -> Str {
  var args: List<Str> = []
  var i = 0
  for p in f.params {
    args = push(args, kunbox(kir.aty(p), "argv[{i}]"))
    i += 1
  }
  let cl = kir_cname(names, owner, -1) + "(" + join(args, ", ") + ")"
  let body = if f.ret == "unit" || f.ret == "never" { cl + "; return UNIT;" } else { "return " + kbox(f.ret, cl) + ";" }
  "static V p{k}(KFn *self, int argc, V *argv) \{ /* " + f.name + "（KIR） */\n  if (argc != {nparams}) arity(self, {nparams}, argc);\n  " + body + "\n}"
}

fn kjmp(order: Map<Int, Int>, bi: Int, x: Int) -> Str {
  if unwrap_or(get(order, x), 0) <= bi { "\{ SAFEPOINT(); CANCEL_POINT(); goto B{x}; \}" } else { "goto B{x};" }
}

// extern 声明里写的库（native.Gen.libs，按出现顺序去重），链接时加 -l
pub fn ext_libs(bs: S) -> List<Str> {
  var out: List<Str> = []
  for n in bs.gord {
    match unwrap_or(get(bs.gval, n), GOther) {
      GExt(it, _) => { for x in unwrap_or(ext_fn(it).ext, []) { if !contains(out, x) { out = push(out, x) } } },
      _ => (),
    }
  }
  out
}
