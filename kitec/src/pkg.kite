// Kite 包管理：kitec new / add / get / update / publish / tree（对应 pkg.py）
//
// 清单 kite.toml：
//     [package]
//     name = "app"
//     version = "0.1.0"
//
//     [dependencies]
//     geom = "^1.2"                 # 从仓库取，语义化版本约束
//     util = { path = "../util" }   # 本地路径依赖
//
// 锁文件 kite.lock：精确记录每个包的版本、来源和 sha256 校验和，提交到版本库即可复现构建。
//
// 仓库：目录形式（KITE_REGISTRY 环境变量，默认 ~/.kite/registry）
//     index/<名字>.json   {"versions": {"1.2.0": {"sha256": "...", "deps": {...}, "file": "pkgs/geom-1.2.0.tar.gz"}}}
//     pkgs/<名字>-<版本>.tar.gz
// 发布的版本不可覆盖；打包是确定性的（固定顺序、时间戳、属主），相同源码得到相同校验和。
// 安装位置：<项目>/.kite/deps/<名字>-<版本>/，安装时校验 sha256，被篡改的包拒绝使用。
//
// 版本约束（与 Cargo 一致）：
//     "1.2.3" 或 "^1.2.3"  >=1.2.3 <2.0.0（0.x 时：^0.2.3 → <0.3.0，^0.0.3 → <0.0.4）
//     "~1.2.3"            >=1.2.3 <1.3.0
//     "=1.2.3"  ">=1.0"  "<2.0"  ">=1.0, <1.5"  "*"
// 解析：每个包只选一个版本；在满足所有约束的版本里取最高；锁文件里已有且仍满足约束的版本优先（可复现）。
use std.fs
use std.os
use std.env
use std.path
use std.encoding.json
use std.crypto.sha256
use std.compress.gzip
use std.archive.tar
use lexer
use check
use modules
use driver

const LOCK_NAME: Str = "kite.lock"
const MANIFEST: Str = "kite.toml"

fn say(msg: Str) { __eprint(msg) }

fn rpr(s: Str) -> Str { lexer.repr_str(s) }

fn is_digit(c: Str) -> Bool { c >= "0" && c <= "9" }

fn all_digits(s: Str) -> Bool {
  if s == "" { return false }
  for c in chars(s) { if !is_digit(c) { return false } }
  true
}

fn valid_name(s: Str) -> Bool {
  let cs = chars(s)
  if len(cs) == 0 || !(cs[0] >= "a" && cs[0] <= "z") { return false }
  for c in cs { if !((c >= "a" && c <= "z") || is_digit(c) || c == "_") { return false } }
  true
}

// ───────────────────────── 语义化版本 ─────────────────────────
// (主, 次, 修订, 正式版 1 / 预发布 0, 预发布标签)
type Ver = (Int, Int, Int, Int, Str)

fn vcmp(a: Ver, b: Ver) -> Int {
  if a.0 != b.0 { return if a.0 < b.0 { -1 } else { 1 } }
  if a.1 != b.1 { return if a.1 < b.1 { -1 } else { 1 } }
  if a.2 != b.2 { return if a.2 < b.2 { -1 } else { 1 } }
  if a.3 != b.3 { return if a.3 < b.3 { -1 } else { 1 } }
  if a.4 == b.4 { 0 } else if a.4 < b.4 { -1 } else { 1 }
}

fn pre_ok(s: Str) -> Bool {
  if s == "" { return false }
  for c in chars(s) {
    if !(
      (c >= "0" && c <= "9")
        || (c >= "A" && c <= "Z")
        || (c >= "a" && c <= "z")
        || c == "."
        || c == "-"
    ) {
      return false
    }
  }
  true
}

pub fn parse_version(s0: Str) -> Result<Ver, Str> {
  let s = trim(s0)
  let bad = "无效的版本号 {rpr(s0)}（应为 主.次.修订，例如 1.2.0）"
  let i = __str_find(s, "-", 0)
  let core = if i >= 0 { __str_slice(s, 0, i) } else { s }
  let pre = if i >= 0 { __str_slice(s, i + 1, len(s)) } else { "" }
  if i >= 0 && !pre_ok(pre) { return Err(bad) }
  let ps = split(core, ".")
  if len(ps) != 3 || !all(ps, all_digits) { return Err(bad) }
  Ok(
    (
      unwrap(parse_int(ps[0])),
      unwrap(parse_int(ps[1])),
      unwrap(parse_int(ps[2])),
      if pre != "" { 0 } else { 1 },
      pre,
    ),
  )
}

pub fn vstr(v: Ver) -> Str { "{v.0}.{v.1}.{v.2}" + (if v.4 != "" { "-" + v.4 } else { "" }) }

fn partial(s: Str) -> Result<(List<Int>, Int), Str> {
  let parts = split(trim(s), ".")
  if len(parts) < 1 || len(parts) > 3 || !all(parts, all_digits) {
    return Err("无效的版本约束 {rpr(s)}")
  }
  var nums = map(parts, (p) => unwrap(parse_int(p)))
  let n = len(nums)
  while len(nums) < 3 { nums = push(nums, 0) }
  Ok((nums, n))
}

fn ver_tail_ok(s: Str) -> Bool {
  let cs = chars(s)
  if len(cs) == 0 || !is_digit(cs[0]) { return false }
  for c in cs {
    if !(
      (c >= "0" && c <= "9")
        || (c >= "A" && c <= "Z")
        || (c >= "a" && c <= "z")
        || c == "."
        || c == "-"
    ) {
      return false
    }
  }
  true
}

// 返回 [(运算符, 版本)]，全部满足才算匹配
pub fn parse_constraint(c0: Str) -> Result<List<(Str, Ver)>, Str> {
  let c = trim(c0)
  if c == "*" || c == "" { return Ok([]) }
  var out: List<(Str, Ver)> = []
  for part0 in split(c, ",") {
    let part = trim(part0)
    var op = ""
    for o in [">=", "<=", "^", "~", "=", ">", "<"] {
      if op == "" && starts_with(part, o) { op = o }
    }
    let ver = trim(__str_slice(part, len(op), len(part)))
    if !ver_tail_ok(ver)
      || (
        op != ""
          && ver != __str_slice(part, len(op), len(part))
          && trim(__str_slice(part, len(op), len(part))) != ver
      ) {
      return Err("无效的版本约束 {rpr(part)}")
    }
    if op == "" { op = "^" }
    var nums: List<Int> = []
    var n = 0
    var lo: Ver = (0, 0, 0, 0, "")
    if contains(ver, "-") {
      let pv = parse_version(ver)?
      nums = [pv.0, pv.1, pv.2]
      n = 3
      lo = pv
    } else {
      let (ns, k) = partial(ver)?
      nums = ns
      n = k
      lo = (nums[0], nums[1], nums[2], 0, "")
    }
    if op == "^" {
      let hi = if nums[0] > 0 || n == 1 {
        (nums[0] + 1, 0, 0, 0, "")
      } else if nums[1] > 0 || n == 2 {
        (0, nums[1] + 1, 0, 0, "")
      } else {
        (0, 0, nums[2] + 1, 0, "")
      }
      out = out + [(">=", lo), ("<", hi)]
    } else if op == "~" {
      let hi = if n == 1 { (nums[0] + 1, 0, 0, 0, "") } else { (nums[0], nums[1] + 1, 0, 0, "") }
      out = out + [(">=", lo), ("<", hi)]
    } else if op == "=" {
      if n < 3 { return Err("= 约束需要完整版本号: {rpr(part)}") }
      out = push(out, ("=", parse_version(ver)?))
    } else {
      out = push(out, (op, if op == ">=" || op == "<" || lo.4 != "" {
        lo
      } else {
        (nums[0], nums[1], nums[2], 1, "")
      }))
    }
  }
  Ok(out)
}

pub fn satisfies(v: Ver, cons: List<(Str, Ver)>) -> Bool {
  for (op, b) in cons {
    let c = vcmp(v, b)
    if op == "=" && c != 0 { return false }
    if op == ">=" && c < 0 { return false }
    if op == ">" && c <= 0 { return false }
    if op == "<" && c >= 0 { return false }
    if op == "<=" && c > 0 { return false }
  }
  // 预发布版本只在约束明确写了预发布时才匹配
  if v.3 == 0 && !any(cons, (x) => x.1.3 == 0 && x.1.4 != "") { return false }
  true
}

fn sat_str(v: Str, c: Str) -> Bool {
  match (parse_version(v), parse_constraint(c)) {
    (Ok(a), Ok(b)) => satisfies(a, b),
    _ => false,
  }
}

fn max_ver(vs: List<Str>) -> Str {
  var best = vs[0]
  for v in vs { if vcmp(unwrap(parse_version(v)), unwrap(parse_version(best))) > 0 { best = v } }
  best
}

fn sort_vers(vs: List<Str>) -> List<Str> {
  sort_with(vs, (a, b) => vcmp(unwrap(parse_version(a)), unwrap(parse_version(b))))
}

// ───────────────────────── 极简 TOML（kite.toml / kite.lock 用到的子集）─────────────────────────
// 字符串、整数、布尔、数组、内联表；[表] 与 [[表数组]]；# 注释。表保持键的书写顺序。
enum Tv {
  TStr(Str)
  TInt(Int)
  TBool(Bool)
  TArr(List<Tv>)
  TTab(List<(Str, Tv)>)
}

fn tget(t: List<(Str, Tv)>, k: Str) -> Tv? {
  for (a, v) in t { if a == k { return Some(v) } }
  None
}

fn tset(t: List<(Str, Tv)>, k: Str, v: Tv) -> List<(Str, Tv)> {
  var out: List<(Str, Tv)> = []
  var hit = false
  for (a, x) in t {
    if a == k {
      out = push(out, (a, v))
      hit = true
    } else {
      out = push(out, (a, x))
    }
  }
  if hit { out } else { push(out, (k, v)) }
}

type Tp = { cs: List<Str>, i: Int }

fn terr(p: Tp, msg: Str) -> Str {
  var ln = 1
  for k in 0..min(p.i, len(p.cs)) { if p.cs[k] == "\n" { ln += 1 } }
  "{msg}（第 {ln} 行）"
}

fn tch(p: Tp) -> Str { if p.i < len(p.cs) { p.cs[p.i] } else { "" } }

fn tskip(p0: Tp, nl: Bool) -> Tp {
  var p = p0
  while p.i < len(p.cs) {
    let c = p.cs[p.i]
    if c == " " || c == "\t" || c == "\r" || (nl && c == "\n") {
      p = Tp { i: p.i + 1, ..p }
    } else if c == "#" {
      while p.i < len(p.cs) && p.cs[p.i] != "\n" { p = Tp { i: p.i + 1, ..p } }
    } else {
      return p
    }
  }
  p
}

fn bare_char(c: Str) -> Bool {
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_" || c == "-"
}

fn hexval(s: Str) -> Int? {
  var v = 0
  for c in chars(lower(s)) {
    let d = if c >= "0" && c <= "9" {
      __ord(c) - 48
    } else if c >= "a" && c <= "f" {
      __ord(c) - 87
    } else {
      return None
    }
    v = v * 16 + d
  }
  Some(v)
}

fn tstring(p0: Tp) -> Result<(Tp, Str), Str> {
  let q = tch(p0)
  var p = Tp { i: p0.i + 1, ..p0 }
  var out = ""
  while true {
    let c = tch(p)
    if c == "" || c == "\n" { return Err(terr(p, "字符串未闭合")) }
    if c == q { return Ok((Tp { i: p.i + 1, ..p }, out)) }
    if c == "\\" && q == "\"" {
      let d = if p.i + 1 < len(p.cs) { p.cs[p.i + 1] } else { "" }
      if d == "u" || d == "U" {
        let w = if d == "u" { 4 } else { 8 }
        let hx = join(p.cs[min(p.i + 2, len(p.cs))..min(p.i + 2 + w, len(p.cs))], "")
        match hexval(hx) {
          Some(v) => {
            if len(hx) == w { out = out + __chr(v) } else { return Err(terr(p, "无效的转义")) }
          },
          None => { return Err(terr(p, "无效的转义")) },
        }
        p = Tp { i: p.i + 2 + w, ..p }
        continue
      }
      let e = if d == "n" {
        "\n"
      } else if d == "t" {
        "\t"
      } else if d == "r" {
        "\r"
      } else if d == "b" {
        "\x08"
      } else if d == "f" {
        "\x0c"
      } else if d == "\"" {
        "\""
      } else if d == "\\" {
        "\\"
      } else {
        return Err(terr(p, "无效的转义 \\" + d))
      }
      out = out + e
      p = Tp { i: p.i + 2, ..p }
      continue
    }
    out = out + c
    p = Tp { i: p.i + 1, ..p }
  }
  Ok((p, out))
}

fn tkey(p0: Tp) -> Result<(Tp, Str), Str> {
  let p = tskip(p0, false)
  let c = tch(p)
  if c == "\"" || c == "'" { return tstring(p) }
  var j = p.i
  while j < len(p.cs) && bare_char(p.cs[j]) { j += 1 }
  if j == p.i { return Err(terr(p, "缺少键名")) }
  Ok((Tp { i: j, ..p }, join(p.cs[p.i..j], "")))
}

fn tvalue(p0: Tp) -> Result<(Tp, Tv), Str> {
  let p = tskip(p0, false)
  let c = tch(p)
  if c == "\"" || c == "'" {
    let (p2, s) = tstring(p)?
    return Ok((p2, TStr(s)))
  }
  if c == "[" {
    var q = Tp { i: p.i + 1, ..p }
    var items: List<Tv> = []
    while true {
      q = tskip(q, true)
      if tch(q) == "]" { return Ok((Tp { i: q.i + 1, ..q }, TArr(items))) }
      let (q2, v) = tvalue(q)?
      items = push(items, v)
      q = tskip(q2, true)
      if tch(q) == "," {
        q = Tp { i: q.i + 1, ..q }
      } else if tch(q) != "]" {
        return Err(terr(q, "数组里缺少 , 或 ]"))
      }
    }
    return Err(terr(q, "数组未闭合"))
  }
  if c == "\{" {
    var q = tskip(Tp { i: p.i + 1, ..p }, false)
    var tab: List<(Str, Tv)> = []
    if tch(q) == "}" { return Ok((Tp { i: q.i + 1, ..q }, TTab(tab))) }
    while true {
      let (q2, k) = tkey(q)?
      let q3 = tskip(q2, false)
      if tch(q3) != "=" { return Err(terr(q3, "键 {k} 后面缺少 =")) }
      let (q4, v) = tvalue(Tp { i: q3.i + 1, ..q3 })?
      if is_some(tget(tab, k)) { return Err(terr(q4, "重复的键 {k}")) }
      tab = push(tab, (k, v))
      q = tskip(q4, false)
      if tch(q) == "}" { return Ok((Tp { i: q.i + 1, ..q }, TTab(tab))) }
      if tch(q) != "," { return Err(terr(q, "内联表里缺少 , 或 }")) }
      q = Tp { i: q.i + 1, ..q }
    }
    return Err(terr(q, "内联表未闭合"))
  }
  var j = p.i
  while j < len(p.cs) && (bare_char(p.cs[j]) || p.cs[j] == "+" || p.cs[j] == ".") { j += 1 }
  let w = join(p.cs[p.i..j], "")
  if w == "true" { return Ok((Tp { i: j, ..p }, TBool(true))) }
  if w == "false" { return Ok((Tp { i: j, ..p }, TBool(false))) }
  match parse_int(replace(w, "_", "")) {
    Ok(n) => Ok((Tp { i: j, ..p }, TInt(n))),
    Err(_) => Err(terr(p, "无法识别的值")),
  }
}

// 顶层表；子表 [a] 和表数组 [[a]] 只支持一层名字
fn toml_parse(src: Str) -> Result<List<(Str, Tv)>, Str> {
  var p = Tp { cs: chars(src), i: 0 }
  var root: List<(Str, Tv)> = []
  var cur = ""          // 当前表名（"" 是顶层）
  var arr = false       // 当前是否表数组的最后一项
  var defined: List<Str> = []
  while true {
    p = tskip(p, true)
    if p.i >= len(p.cs) { return Ok(root) }
    if tch(p) == "[" {
      let dbl = p.i + 1 < len(p.cs) && p.cs[p.i + 1] == "["
      let (p2, name) = tkey(Tp { i: p.i + (if dbl { 2 } else { 1 }), ..p })?
      var p3 = tskip(p2, false)
      let close = if dbl { "]]" } else { "]" }
      if join(p3.cs[p3.i..min(p3.i + len(close), len(p3.cs))], "") != close {
        return Err(terr(p3, "表头缺少 {close}"))
      }
      p = Tp { i: p3.i + len(close), ..p3 }
      if dbl {
        let prev = match tget(root, name) {
          Some(TArr(xs)) => xs,
          None => [],
          _ => { return Err(terr(p, "{name} 已经定义成别的类型")) },
        }
        root = tset(root, name, TArr(push(prev, TTab([]))))
      } else {
        if contains(defined, name) { return Err(terr(p, "表 [{name}] 重复定义")) }
        defined = push(defined, name)
        match tget(root, name) {
          None => { root = tset(root, name, TTab([])) },
          _ => { return Err(terr(p, "表 [{name}] 重复定义")) },
        }
      }
      cur = name
      arr = dbl
      continue
    }
    let (p2, k) = tkey(p)?
    let p3 = tskip(p2, false)
    if tch(p3) != "=" { return Err(terr(p3, "键 {k} 后面缺少 =")) }
    let (p4, v) = tvalue(Tp { i: p3.i + 1, ..p3 })?
    let p5 = tskip(p4, false)
    if p5.i < len(p5.cs) && p5.cs[p5.i] != "\n" { return Err(terr(p5, "值后面有多余的内容")) }
    p = p5
    if cur == "" {
      if is_some(tget(root, k)) { return Err(terr(p, "重复的键 {k}")) }
      root = push(root, (k, v))
    } else if arr {
      let xs = match tget(root, cur) {
        Some(TArr(x)) => x,
        _ => [],
      }
      let last = match xs[len(xs) - 1] {
        TTab(t) => t,
        _ => [],
      }
      if is_some(tget(last, k)) { return Err(terr(p, "重复的键 {k}")) }
      root = tset(root, cur, TArr(set(xs, len(xs) - 1, TTab(push(last, (k, v))))))
    } else {
      let t = match tget(root, cur) {
        Some(TTab(x)) => x,
        _ => [],
      }
      if is_some(tget(t, k)) { return Err(terr(p, "重复的键 {k}")) }
      root = tset(root, cur, TTab(push(t, (k, v))))
    }
  }
  Ok(root)
}

fn tstr(v: Tv?) -> Str? {
  match v {
    Some(TStr(s)) => Some(s),
    _ => None,
  }
}

fn ttab(v: Tv?) -> List<(Str, Tv)> {
  match v {
    Some(TTab(t)) => t,
    _ => [],
  }
}

// json.dumps(s, ensure_ascii=False)
fn toml_str(s: Str) -> Str {
  var out = "\""
  for c in chars(s) {
    let o = __ord(c)
    out = out + (if c == "\"" {
      "\\\""
    } else if c == "\\" {
      "\\\\"
    } else if o == 10 {
      "\\n"
    } else if o == 13 {
      "\\r"
    } else if o == 9 {
      "\\t"
    } else if o == 8 {
      "\\b"
    } else if o == 12 {
      "\\f"
    } else if o < 32 {
      "\\u00" + (if o < 16 { "0" } else { "1" }) + __str_slice(
        "0123456789abcdef",
        o % 16,
        o % 16 + 1,
      )
    } else {
      c
    })
  }
  out + "\""
}

// ───────────────────────── 清单与锁文件 ─────────────────────────
pub type Dep = { path: Str, version: Str }
pub type Manifest = { name: Str, version: Str, deps: List<(Str, Dep)>, desc: Str }
pub type Entry = { version: Str, source: Str, checksum: Str, deps: List<Str>, dir: Str }

fn dget(ds: List<(Str, Dep)>, k: Str) -> Dep? {
  for (a, d) in ds { if a == k { return Some(d) } }
  None
}

fn dset(ds: List<(Str, Dep)>, k: Str, d: Dep) -> List<(Str, Dep)> {
  if is_some(dget(ds, k)) {
    map(ds, (x) => if x.0 == k { (k, d) } else { x })
  } else {
    push(ds, (k, d))
  }
}

fn sorted_deps(ds: List<(Str, Dep)>) -> List<(Str, Dep)> { sort_by(ds, (x) => x.0) }

fn abspath(p: Str) -> Str {
  path.clean(if path.is_abs(p) { p } else { path.join([__getcwd(), p]) })
}

pub fn find_root(start: Str) -> Str? {
  var d = abspath(start)
  while true {
    if fs.is_file(path.join([d, MANIFEST])) { return Some(d) }
    let parent = path.dir(d)
    if parent == d { return None }
    d = parent
  }
  None
}

pub fn read_manifest(root: Str) -> Result<Manifest, Str> {
  let p = path.join([root, MANIFEST])
  let src = match fs.read(p) {
    Ok(s) => s,
    Err(e) => { return Err("{p}: {e}") },
  }
  let data = match toml_parse(src) {
    Ok(d) => d,
    Err(e) => { return Err("{p}: TOML 格式错误: {e}") },
  }
  let pk = ttab(tget(data, "package"))
  let name = match tstr(tget(pk, "name")) {
    Some(n) => n,
    None => "",
  }
  let ver = match tstr(tget(pk, "version")) {
    Some(v) => v,
    None => "0.1.0",
  }
  if !valid_name(name) { return Err("{p}: [package] name 必须是小写字母开头的标识符") }
  let _ = parse_version(ver)?
  var deps: List<(Str, Dep)> = []
  for (dn, spec) in ttab(tget(data, "dependencies")) {
    if !valid_name(dn) { return Err("{p}: 无效的依赖名 {rpr(dn)}") }
    match spec {
      TStr(s) => {
        let _ = parse_constraint(s)?
        deps = push(deps, (dn, Dep { path: "", version: s }))
      },
      TTab(t) => {
        let pv = tstr(tget(t, "path"))
        let vv = tstr(tget(t, "version"))
        if is_none(pv) && is_none(vv) {
          return Err("{p}: 依赖 {dn} 的写法不对（应为 \"^1.0\" 或 \{ path = \"...\" \}）")
        }
        if let Some(v) = vv { let _ = parse_constraint(v)? }
        deps = push(deps, (dn, Dep { path: unwrap_or(pv, ""), version: unwrap_or(vv, "") }))
      },
      _ => { return Err("{p}: 依赖 {dn} 的写法不对（应为 \"^1.0\" 或 \{ path = \"...\" \}）") },
    }
  }
  Ok(Manifest {
    name: name,
    version: ver,
    deps: deps,
    desc: unwrap_or(tstr(tget(pk, "description")), ""),
  })
}

fn write_text(p: Str, s: Str) -> Result<(), Str> {
  match fs.write(p, s) {
    Ok(_) => Ok(()),
    Err(e) => Err("写入 {p} 失败: {e}"),
  }
}

pub fn write_manifest(root: Str, m: Manifest) -> Result<(), Str> {
  var lines = ["[package]", "name = {toml_str(m.name)}", "version = {toml_str(m.version)}"]
  if m.desc != "" { lines = push(lines, "description = {toml_str(m.desc)}") }
  lines = lines + ["", "[dependencies]"]
  for (dn, spec) in sorted_deps(m.deps) {
    if spec.path != "" {
      lines = push(lines, "{dn} = \{ path = {toml_str(spec.path)} \}")
    } else {
      lines = push(lines, "{dn} = {toml_str(spec.version)}")
    }
  }
  write_text(path.join([root, MANIFEST]), join(lines, "\n") + "\n")
}

fn read_lock(root: Str) -> Result<Map<Str, Entry>?, Str> {
  let p = path.join([root, LOCK_NAME])
  if !fs.exists(p) { return Ok(None) }
  let src = match fs.read(p) {
    Ok(s) => s,
    Err(e) => { return Err("{p}: {e}") },
  }
  let data = match toml_parse(src) {
    Ok(d) => d,
    Err(e) => { return Err("{p}: TOML 格式错误: {e}") },
  }
  var out: Map<Str, Entry> = Map()
  let pkgs = match tget(data, "package") {
    Some(TArr(xs)) => xs,
    _ => [],
  }
  for x in pkgs {
    let t = match x {
      TTab(t) => t,
      _ => [],
    }
    let deps = match tget(t, "dependencies") {
      Some(TArr(ds)) => map(ds, (d) => match d {
        TStr(s) => s,
        _ => "",
      }),
      _ => [],
    }
    let name = unwrap_or(tstr(tget(t, "name")), "")
    out = set(out, name, Entry {
      version: unwrap_or(tstr(tget(t, "version")), ""),
      source: unwrap_or(tstr(tget(t, "source")), ""),
      checksum: unwrap_or(tstr(tget(t, "checksum")), ""),
      deps: deps,
      dir: "",
    })
  }
  Ok(Some(out))
}

fn write_lock(root: Str, pkgs: Map<Str, Entry>) -> Result<(), Str> {
  var lines = ["# 由 kite get 自动生成，请勿手改；提交到版本库以保证可复现构建", "version = 1"]
  for name in sort(keys(pkgs)) {
    let p = unwrap(get(pkgs, name))
    lines = lines + [
      "",
      "[[package]]",
      "name = {toml_str(name)}",
      "version = {toml_str(p.version)}",
      "source = {toml_str(p.source)}",
    ]
    if p.checksum != "" { lines = push(lines, "checksum = {toml_str(p.checksum)}") }
    lines = push(lines, "dependencies = [" + join(map(sort(p.deps), toml_str), ", ") + "]")
  }
  write_text(path.join([root, LOCK_NAME]), join(lines, "\n") + "\n")
}

// ───────────────────────── 仓库 ─────────────────────────
pub fn registry_dir() -> Str {
  let r = env.get_or("KITE_REGISTRY", "")
  abspath(if r != "" { r } else { path.join([env.get_or("HOME", "/"), ".kite", "registry"]) })
}

type VInfo = { sha256: Str, file: Str, deps: List<(Str, Str)> }

// 索引：版本按文件里的顺序
fn registry_index(name: Str) -> Result<List<(Str, VInfo)>?, Str> {
  let p = path.join([registry_dir(), "index", name + ".json"])
  if !fs.exists(p) { return Ok(None) }
  let src = match fs.read(p) {
    Ok(s) => s,
    Err(e) => { return Err("{p}: {e}") },
  }
  let j = match json.parse(src) {
    Ok(x) => x,
    Err(e) => { return Err("{p}: {e}") },
  }
  let vs = match json.field(j, "versions") {
    Some(JObj(m)) => m,
    _ => Map(),
  }
  var out: List<(Str, VInfo)> = []
  for v in sort_vers(keys(vs)) {
    let info = unwrap(get(vs, v))
    let ds = match json.field(info, "deps") {
      Some(JObj(m)) => map(
        sort(keys(m)),
        (k) => (k, unwrap_or(json.as_str(unwrap(get(m, k))), "")),
      ),
      _ => [],
    }
    out = push(out, (v, VInfo { sha256: jstr(info, "sha256"), file: jstr(info, "file"), deps: ds }))
  }
  Ok(Some(out))
}

fn jstr(j: json.Json, k: Str) -> Str {
  match json.field(j, k) {
    Some(x) => unwrap_or(json.as_str(x), ""),
    None => "",
  }
}

fn vget(idx: List<(Str, VInfo)>, v: Str) -> VInfo? {
  for (a, i) in idx { if a == v { return Some(i) } }
  None
}

fn read_bin(p: Str) -> Result<List<Int>, Str> {
  match os.read_bytes(p) {
    Ok(b) => Ok(b),
    Err(e) => Err("读取 {p} 失败: {e}"),
  }
}

fn write_bin(p: Str, bs: List<Int>) -> Result<(), Str> {
  match os.write_bytes(p, bs) {
    Ok(_) => Ok(()),
    Err(e) => Err("写入 {p} 失败: {e}"),
  }
}

fn mkdirs(p: Str) -> Result<(), Str> {
  match os.mkdir_all(p) {
    Ok(_) => Ok(()),
    Err(e) => Err("创建目录 {p} 失败: {e}"),
  }
}

fn walk_kite(dir: Str, rel: Str) -> List<Str> {
  let names = match fs.list(dir) {
    Ok(xs) => sort(xs),
    Err(_) => [],
  }
  var files: List<Str> = []
  var dirs: List<Str> = []
  for n in names {
    let full = path.join([dir, n])
    if fs.is_dir(full) {
      dirs = push(dirs, n)
    } else if ends_with(n, ".kite") {
      files = push(files, rel + "/" + n)
    }
  }
  for d in dirs { files = files + walk_kite(path.join([dir, d]), rel + "/" + d) }
  files
}

// 确定性打包：kite.toml + src/**，固定顺序/时间戳/属主
pub fn pack(root: Str) -> Result<(List<Int>, List<Str>), Str> {
  let files = [MANIFEST] + walk_kite(path.join([root, "src"]), "src")
  var w = tar.new_writer()
  for rel in files {
    let data = read_bin(path.join([root, rel]))?
    let h = tar.Header {
      typeflag: tar.TYPE_REG,
      name: rel,
      size: len(data),
      mode: 420,
      mod_time: tar.unix(0, 0),
      format: tar.FORMAT_USTAR,
      ..tar.header()
    }
    let (w1, r1) = w.write_header(h)
    if let Err(e) = r1 { return Err("打包失败: {e}") }
    let (w2, _, e2) = w1.write(data)
    if e2 != "" { return Err("打包失败: {e2}") }
    w = w2
  }
  let (w3, r3) = w.close()
  if let Err(e) = r3 { return Err("打包失败: {e}") }
  Ok((gzip.compress_level(w3.bytes(), 9), files))
}

fn json_obj(kv: List<(Str, json.Json)>) -> json.Json {
  var m: Map<Str, json.Json> = Map()
  for (k, v) in kv { m = set(m, k, v) }
  JObj(m)
}

fn index_json(name: Str, idx: List<(Str, VInfo)>) -> Str {
  let vs = map(idx, (x) => (x.0, json_obj([
    ("deps", json_obj(map(x.1.deps, (d) => (d.0, JStr(d.1))))),
    ("file", JStr(x.1.file)),
    ("sha256", JStr(x.1.sha256)),
  ])))
  json.pretty(json_obj([("name", JStr(name)), ("versions", json_obj(vs))]))
}

pub fn publish(root: Str) -> Result<(Manifest, Int, Str), Str> {
  let m = read_manifest(root)?
  for (dn, spec) in m.deps {
    if spec.path != "" {
      return Err("发布前请把路径依赖 {dn} 换成仓库版本（仓库里的包不能依赖本地路径）")
    }
  }
  let lib = path.join([root, "src", "lib.kite"])
  if !fs.is_file(lib) { return Err("库包需要 src/lib.kite") }
  // 发布前做一次完整的类型检查（包括依赖）
  let _ = ensure_installed(root, true)?
  let pre = match driver.prelude_path() {
    Some(p) => p,
    None => { return Err("找不到 Kite 安装目录") },
  }
  let ((items, srcs), pits) = driver.load(lib, pre)?
  let (errs, _, _, _) = check.check_c(pits, items)
  if len(errs) > 0 {
    return Err(
      join(map(take(errs, 20), (e) => driver.locs(srcs, lib, e.0, modules.strip_lm(e.1))), "\n"),
    )
  }
  let (data, files) = pack(root)?
  let reg = registry_dir()
  mkdirs(path.join([reg, "index"]))?
  mkdirs(path.join([reg, "pkgs"]))?
  let idx = unwrap_or(registry_index(m.name)?, [])
  if is_some(vget(idx, m.version)) {
    return Err("{m.name} {m.version} 已经发布过，版本不可覆盖（请提升版本号）")
  }
  let rel = "pkgs/{m.name}-{m.version}.tar.gz"
  write_bin(path.join([reg, rel]), data)?
  let sha = sha256.sum_bytes(data)
  let info = VInfo { sha256: sha, file: rel, deps: map(m.deps, (d) => (d.0, d.1.version)) }
  write_text(
    path.join([reg, "index", m.name + ".json"]),
    index_json(m.name, push(idx, (m.version, info))),
  )?
  Ok((m, len(files), sha))
}

// ───────────────────────── 解析 ─────────────────────────
type Rs = { cons: List<(Str, List<(Str, Str)>)>, result: Map<Str, Entry>, seen: Set<Str> }

fn add_con(cs: List<(Str, List<(Str, Str)>)>, dn: Str, c: (Str, Str)) -> List<(
  Str, List<(Str, Str)>
)> {
  if any(cs, (x) => x.0 == dn) {
    map(cs, (x) => if x.0 == dn { (dn, push(x.1, c)) } else { x })
  } else {
    push(cs, (dn, [c]))
  }
}

fn rel_path(target: Str, base: Str) -> Str {
  let t = split(path.clean(target), "/")
  let b = split(path.clean(base), "/")
  var i = 0
  while i < len(t) && i < len(b) && t[i] == b[i] { i += 1 }
  var parts: List<Str> = []
  for k in i..len(b) { if b[k] != "" { parts = push(parts, "..") } }
  let rest = filter(t[i..], (x) => x != "")
  let all_parts = parts + rest
  if len(all_parts) == 0 { "." } else { join(all_parts, "/") }
}

fn visit(
  root: Str,
  selected: Map<Str, Str>,
  st0: Rs,
  owner: Str,
  deps: List<(Str, Dep)>,
  base_dir: Str,
) -> Result<Rs, Str> {
  var st = st0
  for (dn, spec) in sorted_deps(deps) {
    if spec.path != "" {
      let pdir = path.clean(path.join([base_dir, spec.path]))
      if !fs.is_file(path.join([pdir, MANIFEST])) {
        return Err("{owner} 的路径依赖 {dn} 不存在: {pdir}")
      }
      let pm = read_manifest(pdir)?
      if pm.name != dn { return Err("路径依赖 {dn} 的 kite.toml 里名字是 {pm.name}") }
      if let Some(prev) = get(st.result, dn) {
        if prev.dir != pdir && prev.source != "registry" {
          return Err("依赖 {dn} 指向了两个不同的路径")
        }
      }
      st = Rs {
        result: set(st.result, dn, Entry {
          version: pm.version,
          source: "path+" + rel_path(pdir, root),
          checksum: "",
          deps: sort(map(pm.deps, (d) => d.0)),
          dir: pdir,
        }),
        ..st
      }
      if !contains(st.seen, "path\x00" + dn) {
        st = Rs { seen: insert(st.seen, "path\x00" + dn), ..st }
        st = visit(root, selected, st, dn, pm.deps, pdir)?
      }
    } else {
      st = Rs { cons: add_con(st.cons, dn, (spec.version, owner)), ..st }
      if let Some(ver) = get(selected, dn) {
        let idx = unwrap_or(registry_index(dn)?, [])
        let info = unwrap(vget(idx, ver))
        st = Rs {
          result: set(st.result, dn, Entry {
            version: ver,
            source: "registry",
            checksum: "sha256:" + info.sha256,
            deps: sort(map(info.deps, (d) => d.0)),
            dir: "",
          }),
          ..st
        }
        if !contains(st.seen, dn + "\x00" + ver) {
          st = Rs { seen: insert(st.seen, dn + "\x00" + ver), ..st }
          st = visit(
            root,
            selected,
            st,
            "{dn} {ver}",
            map(info.deps, (d) => (d.0, Dep { path: "", version: d.1 })),
            "",
          )?
        }
      }
    }
  }
  Ok(st)
}

pub fn resolve(root: Str, prefer_lock: Bool) -> Result<Map<Str, Entry>, Str> {
  let m = read_manifest(root)?
  let lock: Map<Str, Entry> = if prefer_lock { unwrap_or(read_lock(root)?, Map()) } else { Map() }
  var selected: Map<Str, Str> = Map()
  for _ in 0..100 {
    let st = visit(
      root,
      selected,
      Rs { cons: [], result: Map(), seen: Set() },
      m.name,
      m.deps,
      root,
    )?
    var changed = false
    var failure = ""
    for (dn, cs) in st.cons {
      let idx = match registry_index(dn)? {
        Some(x) => x,
        None => { return Err("仓库里找不到包 {dn}（仓库: {registry_dir()}）") },
      }
      var parsed: List<List<(Str, Ver)>> = []
      for c in cs { parsed = push(parsed, parse_constraint(c.0)?) }
      let ok = filter(
        map(idx, (x) => x.0),
        (v) => all(parsed, (p) => satisfies(unwrap(parse_version(v)), p)),
      )
      if len(ok) == 0 {
        let detail = join(map(cs, (c) => "{c.1} 要求 {c.0}"), "；")
        let have = join(sort_vers(map(idx, (x) => x.0)), ", ")
        if failure == "" {
          failure = "无法为 {dn} 选出满足所有约束的版本：{detail}（现有版本: {have}）"
        }
        continue
      }
      let le = get(lock, dn)
      let locked = match le {
        Some(e) => if e.source == "registry" && contains(ok, e.version) { e.version } else { "" },
        None => "",
      }
      let best = if locked != "" { locked } else { max_ver(ok) }
      if get(selected, dn) != Some(best) {
        selected = set(selected, dn, best)
        changed = true
      }
    }
    for dn in keys(selected) {
      if !any(st.cons, (x) => x.0 == dn) {
        selected = remove(selected, dn)
        changed = true
      }
    }
    if !changed {
      if failure != "" { return Err(failure) }
      return Ok(st.result)
    }
  }
  Err("依赖解析没有收敛（约束互相冲突）")
}

// 清单里的直接依赖与锁文件不一致时返回 true
fn lock_stale(root: Str) -> Result<Bool, Str> {
  let lock = match read_lock(root)? {
    Some(l) => l,
    None => { return Ok(true) },
  }
  let m = read_manifest(root)?
  for (dn, spec) in m.deps {
    let e = match get(lock, dn) {
      Some(x) => x,
      None => { return Ok(true) },
    }
    if spec.path != "" {
      if !starts_with(e.source, "path+") { return Ok(true) }
    } else {
      if e.source != "registry" { return Ok(true) }
      if !sat_str(e.version, spec.version) { return Ok(true) }
    }
  }
  Ok(false)
}

fn dep_dir(root: Str, name: Str, e: Entry) -> Str {
  if starts_with(e.source, "path+") {
    return path.clean(path.join([root, __str_slice(e.source, 5, len(e.source))]))
  }
  path.join([root, ".kite", "deps", "{name}-{e.version}"])
}

fn bad_member(name: Str) -> Bool { starts_with(name, "/") || contains(split(name, "/"), "..") }

fn install(root: Str, pkgs: Map<Str, Entry>, quiet: Bool) -> Result<(), Str> {
  for name in sort(keys(pkgs)) {
    let e = unwrap(get(pkgs, name))
    if e.source != "registry" { continue }
    let dst = dep_dir(root, name, e)
    let stamp = path.join([dst, ".checksum"])
    if fs.exists(stamp) {
      if let Ok(s) = fs.read(stamp) { if trim(s) == e.checksum { continue } }
    }
    let idx = unwrap_or(registry_index(name)?, [])
    let info = match vget(idx, e.version) {
      Some(i) => i,
      None => { return Err("仓库里找不到 {name} {e.version}（锁文件指向的版本被删除了？）") },
    }
    let data = read_bin(path.join([registry_dir(), info.file]))?
    let got = "sha256:" + sha256.sum_bytes(data)
    if got != e.checksum || got != "sha256:" + info.sha256 {
      return Err("{name} {e.version} 校验和不匹配，包可能被篡改：期望 {e.checksum}，实际 {got}")
    }
    let raw = match gzip.decompress(data) {
      Ok(b) => b,
      Err(x) => { return Err("{name} {e.version} 解压失败: {x}") },
    }
    // 先检查全部成员，再解开
    var files: List<(Str, List<Int>)> = []
    var tr = tar.new_reader(raw)
    while true {
      let (t1, res) = tr.next()
      match res {
        Ok(h) => {
          if bad_member(h.name) || !(h.typeflag == tar.TYPE_REG || h.typeflag == tar.TYPE_REGA) {
            return Err("{name} 的包里有非法路径 {h.name}")
          }
          let (t2, d, er) = t1.read_all()
          if er != "" && er != "EOF" { return Err("{name} {e.version} 解包失败: {er}") }
          files = push(files, (h.name, d))
          tr = t2
        },
        Err(x) => {
          if x == tar.EOF { break }
          return Err("{name} {e.version} 解包失败: {x}")
        },
      }
    }
    if fs.exists(dst) { let _ = os.remove_all(dst) }
    mkdirs(dst)?
    for (n, d) in files {
      let full = path.join([dst, n])
      mkdirs(path.dir(full))?
      write_bin(full, d)?
    }
    write_text(stamp, e.checksum)?
    if !quiet { say("  安装 {name} {e.version}") }
  }
  Ok(())
}

fn get_deps(root: Str, update: Bool, quiet: Bool) -> Result<Map<Str, Entry>, Str> {
  let pkgs = resolve(root, !update)?
  write_lock(root, pkgs)?
  install(root, pkgs, quiet)?
  Ok(pkgs)
}

// 运行/构建前调用：锁文件缺失或过期时重新解析，缺的包补装，校验和不对时报错
pub fn ensure_installed(root: Str, quiet: Bool) -> Result<Map<Str, Entry>, Str> {
  if len(read_manifest(root)?.deps) == 0 { return Ok(Map()) }
  if lock_stale(root)? { return get_deps(root, false, quiet) }
  let lock = unwrap_or(read_lock(root)?, Map())
  install(root, lock, quiet)?
  Ok(lock)
}

// ───────────────────────── 命令 ─────────────────────────
fn cmd_new(args: List<Str>) -> Result<Int, Str> {
  let lib = contains(args, "--lib")
  let names = filter(args, (a) => !starts_with(a, "--"))
  if len(names) != 1 {
    say("用法: kite new <名字> [--lib]")
    return Ok(2)
  }
  let name = names[0]
  if !valid_name(name) {
    say("包名必须是小写字母开头，只含小写字母、数字、下划线")
    return Ok(2)
  }
  if fs.exists(name) {
    say("{name} 已存在")
    return Ok(1)
  }
  mkdirs(path.join([name, "src"]))?
  write_manifest(name, Manifest { name: name, version: "0.1.0", deps: [], desc: "" })?
  let (body, f) = if lib {
    (
      "// 库的公开接口：只有 pub 项能被使用者访问\npub fn hello(who: Str) -> Str \{\n  \"你好，\{who\}！\"\n\}\n",
      "lib.kite",
    )
  } else {
    ("fn main() \{\n  print(\"你好，Kite！\")\n\}\n", "main.kite")
  }
  write_text(path.join([name, "src", f]), body)?
  write_text(path.join([name, ".gitignore"]), ".kite/\n")?
  print("已创建" + (if lib { "库" } else { "程序" }) + "包 {name}")
  Ok(0)
}

fn need_root() -> Result<Str, Str> {
  match find_root(__getcwd()) {
    Some(r) => Ok(r),
    None => Err("当前目录不在 Kite 包里（找不到 kite.toml，可以用 kite new 创建）"),
  }
}

fn cmd_add(args: List<Str>) -> Result<Int, Str> {
  let root = need_root()?
  let m = read_manifest(root)?
  if len(args) == 0 {
    say("用法: kite add <名字>[@约束] | kite add <名字> --path <目录>")
    return Ok(2)
  }
  var name = args[0]
  var deps = m.deps
  if contains(args, "--path") {
    var i = 0
    while args[i] != "--path" { i += 1 }
    if i + 1 >= len(args) { return Err("--path 后面需要目录") }
    let p = args[i + 1]
    let pm = read_manifest(if path.is_abs(p) { p } else { path.join([root, p]) })?
    if pm.name != name { return Err("{p} 里的包名是 {pm.name}，不是 {name}") }
    deps = dset(deps, name, Dep { path: p, version: "" })
  } else {
    var cons = ""
    let k = __str_find(args[0], "@", 0)
    if k >= 0 {
      name = __str_slice(args[0], 0, k)
      cons = __str_slice(args[0], k + 1, len(args[0]))
    }
    let idx = match registry_index(name)? {
      Some(x) => x,
      None => { return Err("仓库里找不到包 {name}") },
    }
    if cons == "" {
      let all_v = map(idx, (x) => x.0)
      let stable = filter(all_v, (v) => unwrap(parse_version(v)).3 == 1)
      cons = "^" + max_ver(if len(stable) > 0 { stable } else { all_v })
    }
    let _ = parse_constraint(cons)?
    deps = dset(deps, name, Dep { path: "", version: cons })
  }
  write_manifest(root, Manifest { deps: deps, ..m })?
  let pkgs = get_deps(root, false, false)?
  print("已添加 {name} {unwrap(get(pkgs, name)).version}")
  Ok(0)
}

fn cmd_get(update: Bool) -> Result<Int, Str> {
  let root = need_root()?
  let pkgs = get_deps(root, update, false)?
  print(
    (if update { "已更新" } else { "已安装" }) + " {len(pkgs)} 个依赖，锁文件 {LOCK_NAME} 已写入",
  )
  Ok(0)
}

fn cmd_publish() -> Result<Int, Str> {
  let root = need_root()?
  let (m, n, sha) = publish(root)?
  print(
    "已发布 {m.name} {m.version}（{n} 个文件，sha256 {__str_slice(sha, 0, 16)}…）到 {registry_dir()}",
  )
  Ok(0)
}

fn show_tree(lock: Map<Str, Entry>, names0: List<Str>, prefix: Str, seen: Set<Str>) {
  let names = sort(names0)
  for i in 0..len(names) {
    let dn = names[i]
    let e = unwrap(get(lock, dn))
    let last = i == len(names) - 1
    let src = if e.source == "registry" {
      ""
    } else {
      " (" + __str_slice(e.source, 5, len(e.source)) + ")"
    }
    let cyc = if contains(seen, dn) { " (循环)" } else { "" }
    print(prefix + (if last { "└── " } else { "├── " }) + "{dn} {e.version}{src}{cyc}")
    if cyc == "" {
      show_tree(lock, e.deps, prefix + (if last { "    " } else { "│   " }), insert(seen, dn))
    }
  }
}

fn cmd_tree() -> Result<Int, Str> {
  let root = need_root()?
  let m = read_manifest(root)?
  let lock = ensure_installed(root, true)?
  print("{m.name} {m.version}")
  show_tree(lock, map(m.deps, (d) => d.0), "", Set())
  Ok(0)
}

pub fn is_cmd(c: Str) -> Bool {
  contains(["new", "add", "get", "update", "publish", "tree", "satisfies"], c)
}

// kitec satisfies 版本 约束：打印 true / false（测试语义化版本用）
fn cmd_satisfies(args: List<Str>) -> Result<Int, Str> {
  if len(args) != 2 {
    say("用法: kitec satisfies <版本> <约束>")
    return Ok(2)
  }
  let v = parse_version(args[0])?
  let c = parse_constraint(args[1])?
  print(if satisfies(v, c) { "true" } else { "false" })
  Ok(0)
}

pub fn main(cmd: Str, args: List<Str>) -> Int {
  let r = if cmd == "new" {
    cmd_new(args)
  } else if cmd == "add" {
    cmd_add(args)
  } else if cmd == "get" {
    cmd_get(false)
  } else if cmd == "update" {
    cmd_get(true)
  } else if cmd == "publish" {
    cmd_publish()
  } else if cmd == "tree" {
    cmd_tree()
  } else if cmd == "satisfies" {
    cmd_satisfies(args)
  } else {
    Ok(2)
  }
  match r {
    Ok(c) => c,
    Err(e) => {
      // 类型检查失败时是多行 FILE:行: 信息，原样输出；其他错误加“错误: ”
      if contains(e, "\n") || starts_with(e, "/") && contains(e, ".kite:") {
        say(e)
      } else {
        say("错误: " + e)
      }
      1
    },
  }
}

// 编译 / 运行 / 检查一个文件前调用：文件所在的包有依赖时，确保锁文件和依赖包就绪
pub fn prepare(file: Str) -> Result<(), Str> {
  match find_root(path.dir(abspath(file))) {
    Some(root) => {
      let _ = ensure_installed(root, true)?
      Ok(())
    },
    None => Ok(()),
  }
}

// 命令行没给文件时，在 Kite 包里使用 src/main.kite；返回 (入口文件, 包名)
pub fn entry() -> Result<(Str, Str), Str> {
  let root = match find_root(__getcwd()) {
    Some(r) => r,
    None => { return Err("没有指定文件，当前目录也不在 Kite 包里（找不到 kite.toml）") },
  }
  let main = path.join([root, "src", "main.kite"])
  let relm = rel_path(main, abspath(__getcwd()))
  if !fs.is_file(main) { return Err("{relm} 不存在（库包请用 kite check 或在其他包里依赖它）") }
  Ok((relm, read_manifest(root)?.name))
}
