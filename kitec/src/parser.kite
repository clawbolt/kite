// Kite 自举编译器：语法分析（对应 kite.py 的 Parser，逐条移植）
// 产出强类型语法树（ast.Node）；ast.to_v 转成的动态形式与 Python 版的语法树逐字节一致
// 解析器状态 P 按值传递：每个解析函数返回 (新状态, 结果)
use ast
use lexer
use lexer.{ TV, SPart, sv, iv, is_nil }
use ast.{
  Node,
  K,
  Lit,
  Nm,
  TyX,
  Pat,
  Attr,
  Vis,
  EvF,
  UseP,
  IPart,
  AConst,
  TAssoc,
  Arm,
  SArm,
  Gen,
  FnD,
  ImplD,
  TraitD,
  MatchD,
  mkn,
  kname,
}
use lexer.{ Tok, err, repr_str, repr_v, first_upper, first_lower }

pub type P = {
  t: List<Tok>,
  i: Int,
  no_struct: Bool,
  top: Bool,
  in_mod: Int,
  in_extern: Bool,
  va: Bool,
  in_async: Bool,
  loopfr: List<(Str?, Bool)>,
  impl_target: Str?,
  in_guard: Bool,
  slice_start: Int,
  last_bounds: List<(Str, List<TyX>)>,
  last_cgens: List<Str>,
}

pub fn new_p(toks: List<Tok>) -> P {
  P {
    t: toks,
    i: 0,
    no_struct: false,
    top: false,
    in_mod: 0,
    in_extern: false,
    va: false,
    in_async: false,
    loopfr: [],
    impl_target: None,
    in_guard: false,
    slice_start: -1,
    last_bounds: [],
    last_cgens: [],
  }
}

pub fn parse(src: Str) -> Result<List<Node>, Str> {
  let toks = lexer.lex(src)?
  program(new_p(toks))
}

// 解析一个文件，行号整体加上 off（模块系统的行号编码）
pub fn parse_off(src: Str, off: Int) -> Result<List<Node>, Str> {
  let toks = lexer.lex(src)?
  if off == 0 { return program(new_p(toks)) }
  program(new_p(map(toks, (t) => Tok { line: t.line + off, ..t })))
}

// 解析一个类型（内建函数签名字符串用）
pub fn parse_type(src: Str) -> Result<TyX, Str> {
  let toks = lexer.lex(src)?
  let (_, t) = ty(new_p(toks))?
  Ok(t)
}

// ── 工具 ──

fn cur(p: P) -> Tok { p.t[p.i] }

fn peek(p: P, k: Int) -> Tok { p.t[min(p.i + k, len(p.t) - 1)] }

fn tis(t: Tok, k: Str, v: Str) -> Bool { t.kind == k && sv(t.val) == v }

fn at_k(p: P, k: Str) -> Bool { cur(p).kind == k }

fn at_op(p: P, v: Str) -> Bool { tis(cur(p), "OP", v) }

fn at_kw(p: P, v: Str) -> Bool { tis(cur(p), "KW", v) }

fn at_ops(p: P, vs: List<Str>) -> Bool { cur(p).kind == "OP" && contains(vs, sv(cur(p).val)) }

fn cv(p: P) -> Str { sv(cur(p).val) }

fn adv(p: P) -> (P, Tok) { (P { i: p.i + 1, ..p }, p.t[p.i]) }

fn skip(p: P) -> P { P { i: p.i + 1, ..p } }

fn e_at(t: Tok, msg: Str) -> Str { err(t.line, Some(t.col), msg) }

fn e_ln(ln: Int, msg: Str) -> Str { err(ln, None, msg) }

fn tval(t: Tok) -> Str { if is_nil(t.val) { repr_str(t.kind) } else { repr_v(t.val) } }

fn expect(p: P, k: Str, v: Str) -> Result<(P, Tok), Str> {
  let t = cur(p)
  if !(t.kind == k && (v == "" || sv(t.val) == v)) {
    let want = if v == "" { k } else { v }
    return Err(e_at(t, "语法错误: 期望 " + repr_str(want) + "，实际是 " + tval(t)))
  }
  Ok(adv(p))
}

fn expect_ident(p: P) -> Result<(P, Str), Str> {
  if at_k(p, "IDENT") || at_kw(p, "self") || at_kw(p, "Self") {
    let (q, t) = adv(p)
    return Ok((q, sv(t.val)))
  }
  Err(e_at(cur(p), "语法错误: 期望标识符，实际是 " + repr_v(cur(p).val)))
}

fn skip_nl(p0: P) -> P {
  var p = p0
  while at_k(p, "NEWLINE") || at_op(p, ";") { p = skip(p) }
  p
}

fn end_stmt(p: P) -> Result<P, Str> {
  if at_k(p, "NEWLINE") || at_op(p, ";") { return Ok(skip_nl(p)) }
  if at_op(p, "}") || at_k(p, "EOF") { return Ok(p) }
  Err(e_at(cur(p), "语法错误: 语句后出现意外的 " + repr_v(cur(p).val)))
}

// 字典（Python dict，保持插入顺序）
fn dget(d: List<(Str, List<TyX>)>, k: Str) -> List<TyX>? {
  for (a, b) in d { if a == k { return Some(b) } }
  None
}

fn dset(d: List<(Str, List<TyX>)>, k: Str, v: List<TyX>) -> List<(Str, List<TyX>)> {
  var out: List<(Str, List<TyX>)> = []
  var found = false
  for (a, b) in d {
    if a == k {
      out = push(out, (a, v))
      found = true
    } else {
      out = push(out, (a, b))
    }
  }
  if !found { out = push(out, (k, v)) }
  out
}

fn v_lit(v: TV) -> Lit {
  match v {
    TkInt(i) => LInt(i),
    TkBig(t) => LBig(t),
    TkFlt(f) => LFlt(f),
    _ => LStr(sv(v)),
  }
}

fn lit(ln: Int, l: Lit) -> Node { mkn(ln, NLit(l)) }

fn name_node(ln: Int, n: Str) -> Node { mkn(ln, NName(n)) }

fn block_of(ln: Int, stmts: List<Node>) -> Node { mkn(ln, NBlock(stmts, false)) }

fn expr_stmt(ln: Int, e: Node) -> Node { mkn(ln, NExprStmt(e)) }

fn call_name(ln: Int, f: Str, args: List<Node>) -> Node { mkn(ln, NCall(name_node(ln, f), args)) }

fn block_stmts(b: Node) -> List<Node> {
  match b.k {
    NBlock(ss, _) => ss,
    _ => [],
  }
}

fn unit_tail(b: Node) -> Node {
  let ln = b.line
  block_of(ln, push(block_stmts(b), expr_stmt(ln, mkn(ln, NTuple([])))))
}

fn bind(n: Str) -> Pat { PBind(NmS(n)) }

fn pat_names(p: Pat) -> List<Str> {
  match p {
    PBind(n) => [nm_s(n)],
    PVar(n) => [nm_s(n)],
    PTuple(xs) => concat_names(xs),
    PList(pre, rest, post) => {
      var out = concat_names(pre)
      if let Some(r) = rest { if r != "_" { out = push(out, r) } }
      out + concat_names(post)
    },
    PVariant(_, Some(xs)) => concat_names(xs),
    PStruct(_, fs) => concat_names(map(fs, (f) => f.1)),
    POr(xs) => pat_names(xs[0]),
    PAt(a, b) => pat_names(a) + pat_names(b),
    _ => [],
  }
}

fn nm_s(n: Nm) -> Str { ast.nm_str(n) }

fn concat_names(ps: List<Pat>) -> List<Str> {
  var out: List<Str> = []
  for x in ps { out = out + pat_names(x) }
  out
}

fn with_vis(n: Node, v: Vis) -> Node { Node { vis: Some(v), ..n } }

fn vis_pub(n: Node) -> Bool {
  match n.vis {
    Some(v) => v.is_pub,
    None => false,
  }
}

fn with_attrs(n: Node, ats: List<Attr>) -> Node { Node { attrs: Some(ats), ..n } }

fn with_label(n: Node, l: Str) -> Node {
  match n.k {
    NLoop(b, _) => Node { k: NLoop(b, Some(l)), label: Some(l), ..n },
    _ => Node { label: Some(l), ..n },
  }
}

fn fn_d(n: Node) -> FnD {
  match n.k {
    NFn(f) => f,
    _ => FnD {
      name: "",
      params: [],
      ret: None,
      body: None,
      gen: ast.no_gen(),
      is_async: false,
      is_unsafe: false,
      varargs: false,
      ext: None,
      cname: None,
      x: ast.no_fnx(),
    },
  }
}

fn with_fn(n: Node, f: FnD) -> Node { Node { k: NFn(f), ..n } }

// ── 程序与声明 ──

fn extern_fns(n: Node) -> List<Node>? {
  match n.k {
    NExtern(fs) => Some(fs),
    _ => None,
  }
}

fn program(p0: P) -> Result<List<Node>, Str> {
  var p = skip_nl(p0)
  var out: List<Node> = []
  while !at_k(p, "EOF") {
    let (q, it) = item(p, true)?
    p = q
    match extern_fns(it) {
      Some(fs) => { out = out + fs },
      None => { out = push(out, it) },
    }
    p = end_stmt(p)?
  }
  Ok(out)
}

const KNOWN_ATTRS: List<Str> = ["allow", "cold", "deprecated", "doc", "inline", "link", "test"]

fn extern_block(p0: P) -> Result<(P, Node), Str> {
  let (p1, t0) = adv(p0)
  var p = p1
  let ln = t0.line
  if at_k(p, "STR") {
    let (q, t) = adv(p)
    p = q
    var abi = ""
    for x in lexer.parts(t.val) {
      match x {
        SStr(s) => { abi = abi + s },
        _ => {},
      }
    }
    if abi != "C" { return Err(e_at(t, "语法错误: 只支持 extern \"C\"，不支持 " + repr_str(abi))) }
  }
  let (q, _) = expect(p, "OP", "\{")?
  p = skip_nl(q)
  var fns: List<Node> = []
  while !at_op(p, "}") {
    let (q, ats) = attrs(p)?
    p = q
    var is_pub = false
    if at_kw(p, "pub") {
      p = skip(p)
      is_pub = true
    }
    if !(at_kw(p, "fn") || (at_kw(p, "unsafe") && tis(peek(p, 1), "KW", "fn"))) {
      return Err(e_at(cur(p), "语法错误: extern 块里只能写 fn 签名"))
    }
    p.in_extern = true
    let r = fn_decl(p)
    p.in_extern = false
    let (q, f0) = r?
    p = q
    p.in_extern = false
    let fd = fn_d(f0)
    if is_some(fd.body) { return Err(e_ln(f0.line, "语法错误: extern fn {fd.name} 不能有函数体")) }
    if len(fd.gen.names) > 0 {
      return Err(e_ln(f0.line, "语法错误: extern fn {fd.name} 不能有泛型参数"))
    }
    for a in ats {
      let an = a.name
      if an != "doc" && an != "allow" && an != "deprecated" {
        return Err(e_ln(a.line, "语法错误: @{an} 不能用在 extern fn 上"))
      }
    }
    var f = with_fn(f0, FnD { ext: Some([]), cname: Some(fd.name), ..fd })
    f = Node { vis: Some(Vis { is_pub: is_pub, vis: None, has_vis: false }), attrs: Some(ats), ..f }
    fns = push(fns, f)
    p = end_stmt(p)?
  }
  p = skip(p)
  Ok((p, mkn(ln, NExtern(fns))))
}

fn attrs(p0: P) -> Result<(P, List<Attr>), Str> {
  var p = p0
  var out: List<Attr> = []
  while at_op(p, "@") {
    let (q, at) = adv(p)
    let (q, n0) = expect_ident(q)?
    p = q
    var name = n0
    while at_op(p, ".") {
      let (q, nx) = expect_ident(skip(p))?
      p = q
      name = name + "." + nx
    }
    if !contains(KNOWN_ATTRS, name) {
      return Err(
        e_at(
          at,
          "语法错误: 未知属性 @{name}（支持: " + join(
            map(KNOWN_ATTRS, (a) => "@" + a),
            ", ",
          ) + "）",
        ),
      )
    }
    var args: List<(Str?, Lit?)> = []
    if at_op(p, "(") {
      p = skip(p)
      while !at_op(p, ")") {
        if at_k(p, "IDENT") && tis(peek(p, 1), "OP", ":") {
          let (q, kt) = adv(p)
          let (q, v) = attr_lit(skip(q))?
          p = q
          args = push(args, (Some(sv(kt.val)), Some(v)))
        } else if at_k(p, "IDENT") {
          let (q, kt) = adv(p)
          p = q
          args = push(args, (Some(sv(kt.val)), None))
        } else {
          let (q, v) = attr_lit(p)?
          p = q
          args = push(args, (None, Some(v)))
        }
        if at_op(p, ",") {
          p = skip(p)
        } else if !at_op(p, ")") {
          let (q, _) = expect(p, "OP", ")")?
          p = q
        }
      }
      p = skip(p)
    }
    out = push(out, Attr { name: name, args: args, line: at.line })
    p = skip_nl(p)
  }
  Ok((p, out))
}

fn all_str(xs: List<SPart>) -> Bool {
  for x in xs {
    match x {
      SStr(_) => {},
      _ => { return false },
    }
  }
  true
}

fn join_strs(xs: List<SPart>) -> Str {
  join(map(xs, (x) => match x {
    SStr(s) => s,
    _ => "",
  }), "")
}

fn attr_lit(p: P) -> Result<(P, Lit), Str> {
  let t = cur(p)
  if t.kind == "INT" || t.kind == "FLOAT" { return Ok((skip(p), v_lit(t.val))) }
  if t.kind == "KW" && (sv(t.val) == "true" || sv(t.val) == "false") {
    return Ok((skip(p), LBool(sv(t.val) == "true")))
  }
  if t.kind == "STR" && all_str(lexer.parts(t.val)) {
    return Ok((skip(p), LStr(join_strs(lexer.parts(t.val)))))
  }
  Err(e_at(t, "语法错误: 属性参数只能是字面量（整数、浮点、字符串、true/false）或名字"))
}

fn is_decl(n: Node) -> Bool {
  match n.k {
    NFn(_) => true,
    NStruct(..) => true,
    NEnum(..) => true,
    NTrait(_) => true,
    NImpl(_) => true,
    NAlias(..) => true,
    NLet(_, _, _, _, ic) => ic,
    _ => false,
  }
}

fn is_fn(n: Node) -> Bool {
  match n.k {
    NFn(_) => true,
    _ => false,
  }
}

fn item(p0: P, top: Bool) -> Result<(P, Node), Str> {
  let (p, ats) = attrs(p0)?
  let (p, node) = item0(p, top)?
  if let Some(fs0) = extern_fns(node) {
    var libs: List<Str> = []
    for a in ats {
      let an = a.name
      if an == "link" {
        for kv in a.args {
          match kv.1 {
            Some(LStr(s)) => { libs = push(libs, s) },
            _ => {},
          }
        }
      } else if an != "doc" && an != "allow" {
        return Err(e_ln(a.line, "语法错误: extern 块前只能用 @link / @doc / @allow，不能用 @{an}"))
      }
    }
    let npub = vis_pub(node)
    let fs = map(fs0, (f) => {
      let fd = fn_d(f)
      let v = match f.vis {
        Some(x) => Vis { is_pub: x.is_pub || npub, ..x },
        None => Vis { is_pub: npub, vis: None, has_vis: false },
      }
      Node { k: NFn(FnD { ext: Some(libs), ..fd }), vis: Some(v), ..f }
    })
    return Ok((p, Node { k: NExtern(fs), ..node }))
  }
  for a in ats {
    if a.name == "link" { return Err(e_ln(ats[0].line, "语法错误: @link 只能用在 extern 块上")) }
  }
  if len(ats) > 0 {
    if !is_decl(node) {
      return Err(
        e_ln(ats[0].line, "语法错误: 属性只能放在声明（fn type enum trait impl const）前面"),
      )
    }
    for a in ats {
      let an = a.name
      if (an == "test" || an == "inline" || an == "cold") && !is_fn(node) {
        return Err(e_ln(a.line, "语法错误: @{an} 只能用在 fn 上"))
      }
    }
    return Ok((p, with_attrs(node, ats)))
  }
  Ok((p, node))
}

fn item0(p0: P, top: Bool) -> Result<(P, Node), Str> {
  var p = p0
  p.top = top
  var is_pub = false
  var vis: Str? = None
  if at_kw(p, "pub") {
    p = skip(p)
    is_pub = true
    vis = Some("pub")
    if at_op(p, "(") {
      p = skip(p)
      let t = cur(p)
      if at_kw(p, "mod") {
        p = skip(p)
        vis = Some("mod")
      } else {
        let (q, w) = expect_ident(p)?
        p = q
        if w != "pkg" {
          return Err(e_at(t, "语法错误: 可见性只能是 pub、pub(pkg) 或 pub(mod)，不能写 pub({w})"))
        }
        vis = Some("pkg")
      }
      let (q, _) = expect(p, "OP", ")")?
      p = q
    }
  }
  let (q, node) = item1(p)?
  Ok((q, with_vis(node, Vis { is_pub: is_pub, vis: vis, has_vis: true })))
}

fn item1(p0: P) -> Result<(P, Node), Str> {
  var p = p0
  if at_kw(p, "fn") || at_kw(p, "async") || (at_kw(p, "unsafe") && tis(peek(p, 1), "KW", "fn")) {
    return fn_decl(p)
  }
  if at_kw(p, "type") { return type_decl(p) }
  if at_kw(p, "enum") { return enum_decl(p) }
  if at_kw(p, "trait") { return trait_decl(p) }
  if at_kw(p, "impl") { return impl_decl(p) }
  if at_kw(p, "use") { return use_decl(p) }
  if at_kw(p, "mod") {
    let (q, mt) = adv(p)
    p = q
    let ln = mt.line
    let local = !p.top && p.in_mod == 0
    let t = cur(p)
    let (q, parts) = path(p, false)?
    p = q
    if !at_op(p, "\{") {
      if local { return Err(e_ln(ln, "语法错误: 函数体里只能写内联 mod 块 mod m \{ … }")) }
      return Ok((p, mkn(ln, NMod(None, None))))
    }
    if len(parts) != 1 { return Err(e_at(t, "语法错误: 内联 mod 块的名字只能是一个标识符")) }
    let mname = use_name0(parts[0])
    p = skip_nl(skip(p))
    var its: List<Node> = []
    let saved_top = p.top
    p.in_mod += 1
    while !at_op(p, "}") {
      if at_k(p, "EOF") { return Err(e_ln(ln, "语法错误: mod {mname} 缺少 }")) }
      p.top = true
      let (q, it) = item(p, true)?
      p = q
      match extern_fns(it) {
        Some(fs) => { its = its + fs },
        None => { its = push(its, it) },
      }
      p = end_stmt(p)?
    }
    p.in_mod -= 1
    p.top = saved_top
    p = skip(p)
    return Ok((p, mkn(ln, NMod(Some(mname), Some(its)))))
  }
  if at_kw(p, "extern") {
    if !p.top { return Err(e_at(cur(p), "语法错误: extern 块只能写在顶层")) }
    return extern_block(p)
  }
  if at_kw(p, "const") || !p.top { return stmt(p, None) }
  let t = cur(p)
  if t.kind == "KW" && (sv(t.val) == "let" || sv(t.val) == "var") {
    return Err(
      e_at(
        t,
        "语法错误: 顶层不能用 {sv(t.val)}；全局常量请写 const NAME: T = …，可变状态请放进函数里",
      ),
    )
  }
  Err(
    e_at(
      t,
      "语法错误: 顶层只允许声明（fn type enum trait impl use mod const），语句请放进 fn main",
    ),
  )
}

fn use_name0(u: UseP) -> Str {
  match u {
    UName(s) => s,
    _ => "",
  }
}

fn path(p0: P, is_use: Bool) -> Result<(P, List<UseP>), Str> {
  let (q, first) = expect_ident(p0)?
  var p = q
  var parts = [UName(first)]
  while at_op(p, ".") {
    p = skip(p)
    if at_op(p, "\{") {
      p = skip_nl(skip(p))
      var names: List<(Str, Str?)> = []
      while !at_op(p, "}") {
        let (q, nm) = expect_ident(p)?
        p = q
        var entry: (Str, Str?) = (nm, None)
        if is_use && at_kw(p, "as") {
          let (q, al) = expect_ident(skip(p))?
          p = q
          entry = (nm, Some(al))
        }
        names = push(names, entry)
        p = skip_nl(p)
        if at_op(p, ",") { p = skip_nl(skip(p)) }
      }
      let (q, _) = expect(p, "OP", "}")?
      p = q
      parts = push(parts, UGroup(names))
      break
    }
    if is_use && at_op(p, "*") {
      p = skip(p)
      parts = push(parts, UName("*"))
      break
    }
    let (q, nx) = expect_ident(p)?
    p = q
    parts = push(parts, UName(nx))
  }
  Ok((p, parts))
}

fn use_decl(p0: P) -> Result<(P, Node), Str> {
  let (p, ut) = adv(p0)
  let (p, parts) = path(p, true)?
  var q = p
  var alias: Str? = None
  if at_kw(q, "as") {
    let (q2, t) = adv(q)
    let bad = match parts[len(parts) - 1] {
      UGroup(_) => true,
      UName(s) => s == "*",
    }
    if bad { return Err(e_at(t, "语法错误: 分组或通配导入不能整体改名（在 \{ } 里逐项写 as）")) }
    let (q3, al) = expect_ident(q2)?
    q = q3
    alias = Some(al)
  }
  Ok((q, mkn(ut.line, NUse(parts, alias))))
}

// 类型参数列表的 >：把 >> / >>= 拆开
fn at_gt(p: P) -> (P, Bool) {
  let t = cur(p)
  if t.kind == "OP" && (sv(t.val) == ">>" || sv(t.val) == ">>=") {
    let a = Tok { kind: "OP", val: TkStr(">"), line: t.line, col: t.col, nl: t.nl, pos: t.pos }
    let b = Tok {
      kind: "OP",
      val: TkStr(__str_slice(sv(t.val), 1, len(sv(t.val)))),
      line: t.line,
      col: t.col + 1,
      nl: false,
      pos: t.pos,
    }
    let nt = p.t[0..p.i] + [a, b] + p.t[p.i + 1..len(p.t)]
    return (P { t: nt, ..p }, true)
  }
  (p, at_op(p, ">"))
}

// 约束去重按 Python 版的比较：比较 ty(...)[1]
fn has_head(xs: List<TyX>, b: TyX) -> Bool {
  let h = ast.ty_head(b)
  any(xs, (x) => ast.ty_head(x) == h)
}

fn where_clause(p0: P, gens: List<Str>, bounds0: List<(Str, List<TyX>)>) -> Result<(
  P, List<(Str, List<TyX>)>
), Str> {
  var p = p0
  var bounds = bounds0
  if !at_kw(p, "where") { return Ok((p, bounds)) }
  p = skip(p)
  while true {
    let t = cur(p)
    let (q, name) = expect_ident(p)?
    p = q
    if !contains(gens, name) {
      return Err(e_at(t, "语法错误: where 子句里的 {name} 不是泛型参数（目前只支持约束泛型参数）"))
    }
    let (q, _) = expect(p, "OP", ":")?
    let (q, t1) = ty(q)?
    p = q
    var bs = [t1]
    while at_op(p, "+") {
      let (q, t2) = ty(skip(p))?
      p = q
      bs = push(bs, t2)
    }
    let old = unwrap_or(dget(bounds, name), [])
    bounds = dset(bounds, name, old + filter(bs, (b) => !has_head(old, b)))
    if !at_op(p, ",") { break }
    p = skip_nl(skip(p))
    if at_op(p, "\{") || at_op(p, "=") { break }
  }
  Ok((p, bounds))
}

fn generics(p0: P) -> Result<(P, List<Str>), Str> {
  var p = p0
  var names: List<Str> = []
  p.last_bounds = []
  p.last_cgens = []
  if at_op(p, "<") {
    p = skip(p)
    while true {
      let (q, g) = at_gt(p)
      p = q
      if g { break }
      if at_kw(p, "const") {
        p = skip(p)
        let t = cur(p)
        let (q, n) = expect_ident(p)?
        let (q, _) = expect(q, "OP", ":")?
        let (q, tt) = ty(q)?
        p = q
        if !first_upper(n) {
          return Err(e_at(t, "语法错误: 常量泛型参数名必须以大写字母开头：{n}"))
        }
        let int_ok = match tt {
          YCon(cn, ca, _) => cn == "Int" && len(ca) == 0,
          _ => false,
        }
        if !int_ok { return Err(e_at(t, "语法错误: 常量泛型参数 {n} 目前只支持 Int 类型")) }
        names = push(names, n)
        p.last_cgens = push(p.last_cgens, n)
        if at_op(p, ",") { p = skip(p) }
        continue
      }
      let (q, n) = expect_ident(p)?
      p = q
      names = push(names, n)
      if at_op(p, ":") {
        let (q, t1) = ty(skip(p))?
        p = q
        var bs = [t1]
        while at_op(p, "+") {
          let (q, t2) = ty(skip(p))?
          p = q
          bs = push(bs, t2)
        }
        p.last_bounds = dset(p.last_bounds, n, bs)
      }
      if at_op(p, ",") { p = skip(p) }
    }
    p = skip(p)
  }
  Ok((p, names))
}

fn con(name: Str, args: List<TyX>, ln: Int) -> TyX { YCon(name, args, ln) }

fn ty_list(p0: P) -> Result<(P, List<TyX>), Str> {
  var p = p0
  var ts: List<TyX> = []
  while !at_op(p, ")") {
    let (q, x) = ty(p)?
    p = q
    ts = push(ts, x)
    if at_op(p, ",") { p = skip(p) }
  }
  Ok((skip(p), ts))
}

fn ty(p0: P) -> Result<(P, TyX), Str> {
  var p = p0
  let ln = cur(p).line
  var t = con("", [], ln)
  if at_op(p, "(") {
    let (q, ts) = ty_list(skip(p))?
    p = q
    t = if len(ts) == 0 { con("Unit", [], ln) } else { YTup(ts, ln) }
  } else if at_op(p, "[") {
    let (q, inner) = ty(skip(p))?
    p = q
    var n: TyX? = None
    if at_op(p, ";") {
      p = skip(p)
      if at_k(p, "INT") {
        let (q, it) = adv(p)
        p = q
        if iv(it.val) < 0 { return Err(e_ln(ln, "语法错误: 数组长度不能是负数")) }
        n = Some(con("#" + repr_v(it.val), [], ln))
      } else {
        let (q, nm) = expect_ident(p)?
        p = q
        n = Some(con(nm, [], ln))
      }
    }
    let (q, _) = expect(p, "OP", "]")?
    p = q
    t = match n {
      Some(x) => con("Array", [inner, x], ln),
      None => con("List", [inner], ln),
    }
  } else if at_kw(p, "dyn") || at_kw(p, "impl") {
    let (q, kt) = adv(p)
    let (q, b0) = expect_ident(q)?
    p = q
    var bs = [b0]
    while at_op(p, "+") {
      let (q, b) = expect_ident(skip(p))?
      p = q
      bs = push(bs, b)
    }
    t = if sv(kt.val) == "dyn" { YDyn(bs, ln) } else { YImpl(bs, ln) }
  } else if at_kw(p, "unsafe") && tis(peek(p, 1), "KW", "fn") {
    let (q, inner) = ty(skip(p))?
    return Ok((q, YUnsafe(inner, ln)))
  } else if at_kw(p, "fn") {
    let (q, _) = expect(skip(p), "OP", "(")?
    let (q, ts) = ty_list(q)?
    p = q
    var r = con("Unit", [], ln)
    if at_op(p, "->") {
      let (q, x) = ty(skip(p))?
      p = q
      r = x
    }
    t = YFn(ts, r, ln)
  } else if at_k(p, "INT") {
    let (q, it) = adv(p)
    p = q
    t = con("#" + repr_v(it.val), [], ln)
  } else {
    let (q, n0) = expect_ident(p)?
    p = q
    var name = n0
    while at_op(p, ".") {
      let (q, nx) = expect_ident(skip(p))?
      p = q
      name = name + "." + nx
    }
    var args: List<TyX> = []
    if at_op(p, "<") {
      p = skip(p)
      while true {
        let (q, g) = at_gt(p)
        p = q
        if g { break }
        let (q, x) = ty(p)?
        p = q
        args = push(args, x)
        if at_op(p, ",") { p = skip(p) }
      }
      p = skip(p)
    }
    t = con(name, args, ln)
  }
  while at_op(p, "?") {
    p = skip(p)
    t = con("Option", [t], ln)
  }
  Ok((p, t))
}

fn params(p0: P) -> Result<(P, List<(Str, TyX?)>), Str> {
  let (q, _) = expect(p0, "OP", "(")?
  var p = q
  p.va = false
  var ps: List<(Str, TyX?)> = []
  while !at_op(p, ")") {
    if at_op(p, "..") && tis(peek(p, 1), "OP", ".") {
      let t = cur(p)
      p = skip(skip(p))
      p.va = true
      if at_op(p, ",") { p = skip(p) }
      if !at_op(p, ")") { return Err(e_at(t, "语法错误: ... 只能是最后一个参数")) }
      break
    }
    if at_kw(p, "var") { p = skip(p) }
    let (q, name) = expect_ident(p)?
    p = q
    var t: TyX? = None
    if at_op(p, ":") {
      let (q, x) = ty(skip(p))?
      p = q
      t = Some(x)
    }
    ps = push(ps, (name, t))
    if at_op(p, ",") {
      p = skip(p)
    } else if !at_op(p, ")") {
      let (q, _) = expect(p, "OP", ",")?
      p = q
    }
  }
  Ok((skip(p), ps))
}

// 参数里的 impl Tr → 匿名泛型参数；返回类型里的 impl Tr → dyn Tr
type Desugar = { gens: List<Str>, bounds: List<(Str, List<TyX>)>, n: Int }

fn dwalk_list(d0: Desugar, ts: List<TyX>, in_ret: Bool) -> (Desugar, List<TyX>) {
  var d = d0
  var out: List<TyX> = []
  for a in ts {
    let (d2, a2) = dwalk(d, a, in_ret)
    d = d2
    out = push(out, a2)
  }
  (d, out)
}

fn dwalk(d0: Desugar, t: TyX, in_ret: Bool) -> (Desugar, TyX) {
  var d = d0
  match t {
    YImpl(bs, l) => {
      if in_ret { return (d, YDyn(bs, l)) }
      d.n += 1
      let g = "impl " + join(bs, " + ") + "#{d.n}"
      d.gens = push(d.gens, g)
      d.bounds = dset(d.bounds, g, map(bs, (b) => con(b, [], l)))
      (d, con(g, [], l))
    },
    YCon(n, a, l) => {
      let (d2, a2) = dwalk_list(d, a, in_ret)
      (d2, YCon(n, a2, l))
    },
    YTup(a, l) => {
      let (d2, a2) = dwalk_list(d, a, in_ret)
      (d2, YTup(a2, l))
    },
    YFn(a, r, l) => {
      let (d2, a2) = dwalk_list(d, a, in_ret)
      let (d3, r2) = dwalk(d2, r, in_ret)
      (d3, YFn(a2, r2, l))
    },
    _ => (d, t),
  }
}

fn odwalk(d: Desugar, t: TyX?, in_ret: Bool) -> (Desugar, TyX?) {
  match t {
    Some(x) => {
      let (d2, y) = dwalk(d, x, in_ret)
      (d2, Some(y))
    },
    None => (d, None),
  }
}

fn future_lit(ln: Int, lam: Node) -> Node {
  mkn(ln, NStructLit(NmS("Future"), [("run", lam)], None))
}

fn fn_decl(p0: P) -> Result<(P, Node), Str> {
  var p = p0
  var is_async = false
  var is_unsafe = false
  if at_kw(p, "async") {
    p = skip(p)
    is_async = true
  }
  if at_kw(p, "unsafe") {
    p = skip(p)
    is_unsafe = true
  }
  let (q, ft) = expect(p, "KW", "fn")?
  let ln = ft.line
  let (q, name) = expect_ident(q)?
  let (q, gens) = generics(q)?
  p = q
  let bounds0 = p.last_bounds
  let cgens = p.last_cgens
  let (q, ps0) = params(p)?
  p = q
  var ret: TyX? = None
  let va = p.va
  if va && !p.in_extern { return Err(e_ln(ln, "语法错误: 只有 extern fn 可以有可变参数 ...")) }
  if at_op(p, "->") {
    let (q, r) = ty(skip(p))?
    p = q
    ret = Some(r)
  }
  let (q, bounds1) = where_clause(p, gens, bounds0)?
  p = q
  var d = Desugar { gens: gens, bounds: bounds1, n: 0 }
  var ps: List<(Str, TyX?)> = []
  for pr in ps0 {
    let (d2, t2) = odwalk(d, pr.1, false)
    d = d2
    ps = push(ps, (pr.0, t2))
  }
  let (d3, ret2) = odwalk(d, ret, true)
  ret = ret2
  let saved = p.in_async
  p.in_async = is_async
  var body: Node? = None
  if at_op(p, "\{") {
    let r = block(p)
    let (q, b) = r?
    p = q
    body = Some(b)
  }
  p.in_async = saved
  if is_async && name != "main" {
    let inner = unwrap_or(ret, con("_", [], ln))
    ret = Some(con("Future", [inner], ln))
    if let Some(b) = body {
      let lam = mkn(ln, NLambda([], b, Some("async fn {name} 的返回值")))
      body = Some(block_of(ln, [expr_stmt(ln, future_lit(ln, lam))]))
    }
  }
  let fd = FnD {
    name: name,
    params: ps,
    ret: ret,
    body: body,
    gen: Gen { names: d3.gens, bounds: d3.bounds, cgens: cgens },
    is_async:
      is_async,
    is_unsafe: is_unsafe,
    varargs: va,
    ext: None,
    cname: None,
    x: ast.no_fnx(),
  }
  Ok((p, mkn(ln, NFn(fd))))
}

fn fields(p0: P, close: Str) -> Result<(P, List<(Str, TyX?)>), Str> {
  var p = skip_nl(p0)
  var fs: List<(Str, TyX?)> = []
  while !at_op(p, close) {
    let (q, _) = attrs(p)?
    p = q
    if at_kw(p, "pub") { p = skip(p) }
    let (q, name) = expect_ident(p)?
    p = q
    var t: TyX? = None
    if at_op(p, ":") {
      let (q, x) = ty(skip(p))?
      p = q
      t = Some(x)
    }
    fs = push(fs, (name, t))
    if at_op(p, ",") { p = skip(p) }
    p = skip_nl(p)
  }
  Ok((skip(p), fs))
}

fn type_decl(p0: P) -> Result<(P, Node), Str> {
  let (q, tt) = expect(p0, "KW", "type")?
  let ln = tt.line
  let (q, name) = expect_ident(q)?
  let (q, gens) = generics(q)?
  let cgens = q.last_cgens
  let (q, bounds) = where_clause(q, gens, q.last_bounds)?
  let (q, _) = expect(q, "OP", "=")?
  let g = Gen { names: gens, bounds: bounds, cgens: cgens }
  if at_op(q, "\{") {
    let (q, fs) = fields(skip(q), "}")?
    return Ok((q, mkn(ln, NStruct(name, fs, g))))
  }
  let (q, target) = ty(q)?
  Ok((q, mkn(ln, NAlias(name, target, g))))
}

fn enum_decl(p0: P) -> Result<(P, Node), Str> {
  let (q, et) = expect(p0, "KW", "enum")?
  let ln = et.line
  let (q, name) = expect_ident(q)?
  let (q, gens) = generics(q)?
  let cgens = q.last_cgens
  let (q, bounds) = where_clause(q, gens, q.last_bounds)?
  let (q, _) = expect(q, "OP", "\{")?
  var p = skip_nl(q)
  var variants: List<(Str, EvF)> = []
  while !at_op(p, "}") {
    let (q, _) = attrs(p)?
    let (q, vname) = expect_ident(q)?
    p = q
    var fs = EvNone
    if at_op(p, "\{") {
      p = skip_nl(skip(p))
      var rf: List<(Str, TyX)> = []
      while !at_op(p, "}") {
        let (q, _) = attrs(p)?
        p = q
        let ft = cur(p)
        let (q, fname) = expect_ident(p)?
        let (q, _) = expect(q, "OP", ":")?
        p = q
        if any(rf, (f) => f.0 == fname) {
          return Err(e_at(ft, "语法错误: 变体 {vname} 的字段 {fname} 重复"))
        }
        let (q, x) = ty(p)?
        p = q
        rf = push(rf, (fname, x))
        if at_op(p, ",") { p = skip(p) }
        p = skip_nl(p)
      }
      p = skip(p)
      if len(rf) == 0 {
        return Err(
          e_ln(ln, "语法错误: 记录变体 {vname} 至少要有一个字段（无字段请直接写 {vname}）"),
        )
      }
      fs = EvRec(rf)
    } else if at_op(p, "(") {
      p = skip(p)
      var lf: List<(Str, TyX)> = []
      while !at_op(p, ")") {
        if at_k(p, "IDENT") && tis(peek(p, 1), "OP", ":") {
          let (q, nt) = adv(p)
          let (q, x) = ty(skip(q))?
          p = q
          lf = push(lf, (sv(nt.val), x))
        } else {
          let (q, x) = ty(p)?
          p = q
          lf = push(lf, ("_{len(lf)}", x))
        }
        if at_op(p, ",") { p = skip(p) }
      }
      p = skip(p)
      fs = EvList(lf)
    }
    variants = push(variants, (vname, fs))
    if at_op(p, ",") { p = skip(p) }
    p = skip_nl(p)
  }
  p = skip(p)
  Ok((p, mkn(ln, NEnum(name, variants, Gen { names: gens, bounds: bounds, cgens: cgens }))))
}

fn ident_list(p0: P) -> Result<(P, List<Str>), Str> {
  let (q, b) = expect_ident(p0)?
  var p = q
  var bs = [b]
  while at_op(p, "+") {
    let (q, b2) = expect_ident(skip(p))?
    p = q
    bs = push(bs, b2)
  }
  Ok((p, bs))
}

fn trait_decl(p0: P) -> Result<(P, Node), Str> {
  let (q, tt) = expect(p0, "KW", "trait")?
  let ln = tt.line
  let (q, name) = expect_ident(q)?
  let (q, _) = generics(q)?
  var p = q
  var supers: List<Str> = []
  if at_op(p, ":") {
    let (q, ss) = ident_list(skip(p))?
    p = q
    supers = ss
  }
  let (q, _) = expect(p, "OP", "\{")?
  p = skip_nl(q)
  var methods: List<Node> = []
  var assoc: List<TAssoc> = []
  var consts: List<AConst> = []
  while !at_op(p, "}") {
    let (q, ats) = attrs(p)?
    p = q
    if at_kw(p, "type") {
      let (q, at) = adv(p)
      let (q, an) = expect_ident(q)?
      p = q
      var bs: List<Str> = []
      var dflt: TyX? = None
      if at_op(p, ":") {
        let (q, xs) = ident_list(skip(p))?
        p = q
        bs = xs
      }
      if at_op(p, "=") {
        let (q, x) = ty(skip(p))?
        p = q
        dflt = Some(x)
      }
      if any(assoc, (a) => a.name == an) { return Err(e_at(at, "语法错误: 关联类型 {an} 重复")) }
      assoc = push(assoc, TAssoc { name: an, bounds: bs, dflt: dflt })
    } else if at_kw(p, "const") {
      let (q, c) = assoc_const(p, consts, false)?
      p = q
      consts = push(consts, c)
    } else {
      let (q, m) = fn_decl(p)?
      p = q
      methods = push(methods, with_attrs(m, ats))
    }
    p = skip_nl(p)
  }
  p = skip(p)
  Ok((p, mkn(ln, NTrait(TraitD {
    name: name,
    methods: methods,
    assoc: assoc,
    supers: supers,
    consts: consts,
  }))))
}

fn assoc_const(p0: P, consts: List<AConst>, need_value: Bool) -> Result<(P, AConst), Str> {
  let (q, t) = expect(p0, "KW", "const")?
  let n = cur(q)
  let (q, name) = expect_ident(q)?
  if !first_upper(name) { return Err(e_at(n, "语法错误: 常量名必须以大写字母开头：{name}")) }
  if any(consts, (c) => c.name == name) { return Err(e_at(n, "语法错误: 关联常量 {name} 重复")) }
  let (q, _) = expect(q, "OP", ":")?
  let (q, tyv) = ty(q)?
  var p = q
  var val: Node? = None
  if at_op(p, "=") {
    let (q, x) = expr(skip_nl(skip(p)), false)?
    p = q
    val = Some(x)
  } else if need_value {
    return Err(e_at(n, "语法错误: impl 里的关联常量 {name} 必须有初值"))
  }
  Ok((p, AConst { name: name, ty: tyv, value: val, line: t.line }))
}

fn impl_decl(p0: P) -> Result<(P, Node), Str> {
  let (q, it) = expect(p0, "KW", "impl")?
  let ln = it.line
  let (q, gens) = generics(q)?
  let ib0 = q.last_bounds
  let icgens = q.last_cgens
  let (q, first) = ty(q)?
  var p = q
  var trait_t: TyX? = None
  var target_t = first
  if at_kw(p, "for") {
    let (q, tt) = ty(skip(p))?
    p = q
    trait_t = Some(first)
    target_t = tt
  }
  let target: Str? = match target_t {
    YCon(n, _, _) => Some(n),
    _ => None,
  }
  let (q, ibounds) = where_clause(p, gens, ib0)?
  let (q, _) = expect(q, "OP", "\{")?
  p = skip_nl(q)
  var methods: List<Node> = []
  var assoc: List<(Str, TyX)> = []
  var consts: List<AConst> = []
  let saved_tgt = p.impl_target
  p.impl_target = target
  while !at_op(p, "}") {
    let (q, ats) = attrs(p)?
    p = q
    if at_kw(p, "pub") { p = skip(p) }
    if at_kw(p, "type") {
      let (q, at) = adv(p)
      let (q, an) = expect_ident(q)?
      let (q, _) = expect(q, "OP", "=")?
      p = q
      if any(assoc, (a) => a.0 == an) { return Err(e_at(at, "语法错误: 关联类型 {an} 重复")) }
      let (q, x) = ty(p)?
      p = q
      assoc = push(assoc, (an, x))
    } else if at_kw(p, "const") {
      let (q, c) = assoc_const(p, consts, true)?
      p = q
      consts = push(consts, c)
    } else {
      let (q, m) = fn_decl(p)?
      p = q
      methods = push(methods, with_attrs(m, ats))
    }
    p = skip_nl(p)
  }
  p = skip(p)
  p.impl_target = saved_tgt
  let d = ImplD {
    tr: trait_t,
    target: unwrap_or(target, "Tuple"),
    target_t: target_t,
    methods: methods,
    gen: Gen {
      names: gens,
      bounds:
        ibounds,
      cgens: icgens,
    },
    assoc: assoc,
    consts: consts,
  }
  Ok((p, mkn(ln, NImpl(d))))
}

// ── 语句 ──

const ASSIGN_OPS: List<Str> = ["=", "+=", "-=", "*=", "/=", "%=", "|=", "&=", "^=", "<<=", ">>="]

fn break_block(ln: Int) -> Node { block_of(ln, [mkn(ln, NBreak(None, None, true))]) }

fn arm(pat: Pat, guard: Node?, body: Node) -> Arm { Arm { pat: pat, guard: guard, body: body } }

fn match_n(ln: Int, subj: Node, arms: List<Arm>) -> Node {
  mkn(ln, NMatch(MatchD { subject: subj, arms: arms, is_conj: None, let_else: None }))
}

fn stmt(p0: P, label: Str?) -> Result<(P, Node), Str> {
  var p = p0
  let tok = cur(p)
  if at_kw(p, "const") {
    p = skip(p)
    let nt = cur(p)
    let (q, name) = expect_ident(p)?
    if !first_upper(name) {
      return Err(e_at(nt, "语法错误: const 的名字必须以大写字母开头（{name}）"))
    }
    let (q, _) = expect(q, "OP", ":")?
    let (q, t) = ty(q)?
    let (q, _) = expect(q, "OP", "=")?
    let (q, value) = expr(q, false)?
    return Ok((q, mkn(tok.line, NLet(bind(name), false, Some(t), value, true))))
  }
  if at_kw(p, "let") || at_kw(p, "var") {
    let (q, kt) = adv(p)
    let mutable = sv(kt.val) == "var"
    let (q, pat) = pattern(q)?
    p = q
    var t: TyX? = None
    if at_op(p, ":") {
      let (q, x) = ty(skip(p))?
      p = q
      t = Some(x)
    }
    let (q, _) = expect(p, "OP", "=")?
    let (q, value) = expr(q, false)?
    p = q
    if at_kw(p, "else") {
      let (q, els) = block(skip(p))?
      p = q
      let names = pat_names(pat)
      let ln = tok.line
      let res = if len(names) == 1 {
        name_node(ln, names[0])
      } else {
        mkn(ln, NTuple(map(names, (n) => name_node(ln, n))))
      }
      let m = mkn(ln, NMatch(MatchD {
        subject: value,
        arms: [arm(pat, None, res), arm(PWild, None, els)],
        is_conj: None,
        let_else: Some(els),
      }))
      var bpat = if len(names) == 1 { bind(names[0]) } else { PTuple(map(names, bind)) }
      if len(names) == 0 { bpat = PWild }
      return Ok((p, mkn(ln, NLet(bpat, mutable, if len(names) == 1 { t } else { None }, m, false))))
    }
    return Ok((p, mkn(tok.line, NLet(pat, mutable, t, value, false))))
  }
  if at_kw(p, "return") {
    p = skip(p)
    if at_k(p, "NEWLINE") || at_op(p, "}") || at_op(p, ";") {
      return Ok((p, mkn(tok.line, NReturn(None))))
    }
    let (q, v) = expr(p, false)?
    return Ok((q, mkn(tok.line, NReturn(Some(v)))))
  }
  if tok.kind == "LABEL" {
    let lab = sv(tok.val)
    let (q, _) = expect(skip(p), "OP", ":")?
    p = q
    if !(at_kw(p, "while") || at_kw(p, "for") || at_kw(p, "loop")) {
      return Err(e_at(cur(p), "语法错误: 标签 '{lab} 后面必须是 while / for / loop"))
    }
    let (q, s0) = stmt(p, Some(lab))?
    var s = with_label(s0, lab)
    match s.k {
      NExprStmt(e) => { s = Node { k: NExprStmt(with_label(e, lab)), ..s } },
      _ => {},
    }
    return Ok((q, s))
  }
  if at_kw(p, "break") || at_kw(p, "continue") {
    p = skip(p)
    var lab: Str? = None
    if at_k(p, "LABEL") && !cur(p).nl {
      let (q, lt) = adv(p)
      p = q
      lab = Some(sv(lt.val))
    }
    var val: Node? = None
    let is_break = sv(tok.val) == "break"
    if is_break
      && !cur(p).nl
      && !(
        at_k(p, "NEWLINE")
          || at_k(p, "EOF")
          || at_op(p, "}")
          || at_op(p, ";")
          || at_op(p, ",")
          || at_op(p, ")")
      ) {
      let (q, v) = expr(p, false)?
      p = q
      val = Some(v)
      var k = len(p.loopfr) - 1
      while k >= 0 {
        let (fl, _) = p.loopfr[k]
        if is_none(lab) || fl == lab {
          p.loopfr = set(p.loopfr, k, (fl, true))
          break
        }
        k -= 1
      }
    }
    return Ok((p, mkn(tok.line, if is_break { NBreak(lab, val, false) } else { NContinue(lab) })))
  }
  if at_kw(p, "while") && tis(peek(p, 1), "KW", "let") {
    let (q, pat) = pattern(skip(skip(p)))?
    let (q, _) = expect(q, "OP", "=")?
    let (q, subj) = expr(q, true)?
    let (q, lb) = loop_block(q, label)?
    let body = unit_tail(lb)
    let ln = tok.line
    let m = match_n(ln, subj, [arm(pat, None, body), arm(PWild, None, break_block(ln))])
    return Ok((q, mkn(ln, NWhile(None, block_of(ln, [expr_stmt(ln, m)])))))
  }
  if at_kw(p, "while") {
    let (q, c) = expr(skip(p), true)?
    let (q, body) = loop_block(q, label)?
    return Ok((q, mkn(tok.line, NWhile(Some(c), body))))
  }
  if at_kw(p, "loop") {
    let (q, e) = loop_expr(skip(p), tok.line, label, false)?
    match e.k {
      NLoop(..) => { return Ok((q, expr_stmt(tok.line, e))) },
      _ => { return Ok((q, e)) },
    }
  }
  if at_kw(p, "for") {
    let (q, pat) = pattern(skip(p))?
    let (q, _) = expect(q, "KW", "in")?
    let (q, it) = expr(q, true)?
    let (q, body) = loop_block(q, label)?
    return Ok((q, mkn(tok.line, NFor(pat, it, body))))
  }
  if at_kw(p, "defer") {
    p = skip(p)
    let (q, b) = if at_op(p, "\{") { block(p)? } else { expr(p, false)? }
    return Ok((q, mkn(tok.line, NDefer(b))))
  }
  if is_fn_decl(p) { return fn_decl(p) }
  let (q, e) = expr(p, false)?
  p = q
  if at_ops(p, ASSIGN_OPS) {
    let (q, ot) = adv(p)
    let ok = match e.k {
      NName(_) => true,
      NField(..) => true,
      NIndex(..) => true,
      _ => false,
    }
    if !ok { return Err(e_at(tok, "赋值目标无效")) }
    let (q, v) = expr(q, false)?
    return Ok((q, mkn(tok.line, NAssign(e, sv(ot.val), v))))
  }
  Ok((p, expr_stmt(tok.line, e)))
}

fn block(p0: P) -> Result<(P, Node), Str> {
  let (q, bt) = expect(p0, "OP", "\{")?
  var p = skip_nl(q)
  var stmts: List<Node> = []
  while !at_op(p, "}") {
    let (q, s) = item(p, false)?
    p = end_stmt(q)?
    stmts = push(stmts, s)
  }
  Ok((skip(p), block_of(bt.line, stmts)))
}

// ── 表达式 ──

fn expr(p0: P, no_struct: Bool) -> Result<(P, Node), Str> {
  var p = p0
  let saved = p.no_struct
  p.no_struct = no_struct
  let (q, e) = binary(p, 0)?
  var q2 = q
  q2.no_struct = saved
  Ok((q2, e))
}

fn is_conj(left: Node, right: Node, ln: Int) -> Node {
  match left.k {
    NIs(v, pat) => mkn(ln, NMatch(MatchD {
      subject: v,
      arms: [arm(pat, None, right), arm(PWild, None, lit(ln, LBool(false)))],
      is_conj:
        Some((left, right)),
      let_else: None,
    })),
    NBin(op, l, Some(r)) => if op == "&&" {
      mkn(left.line, NBin("&&", l, Some(is_conj(r, right, ln))))
    } else {
      mkn(ln, NBin("&&", left, Some(right)))
    },
    _ => mkn(ln, NBin("&&", left, Some(right))),
  }
}

const BIN: List<List<Str>> = [
  ["||"],
  ["&&"],
  ["==", "!="],
  ["<", ">", "<=", ">="],
  ["|>"],
  ["..", "..="],
  ["|"],
  ["^"],
  ["&"],
  ["<<", ">>"],
  ["+", "-"],
  ["*", "/", "%"],
]
const HIGH_OPS: List<Str> = ["..", "..=", "|", "^", "&", "<<", ">>", "+", "-", "*", "/", "%"]

fn binary(p0: P, lvl: Int) -> Result<(P, Node), Str> {
  var p = p0
  let s0 = p.i
  if lvl == len(BIN) {
    let (q, e0) = unary(p)?
    p = q
    var e = e0
    while at_kw(p, "as") {
      let (q, at) = adv(p)
      let (q, t) = ty(q)?
      p = q
      e = mkn(at.line, NCast(e, t))
    }
    return Ok((p, e))
  }
  if lvl == 4 {
    let (q, l0) = binary(p, lvl + 1)?
    p = q
    var left = l0
    while at_op(p, "|>") {
      let (q, pt) = adv(p)
      let (q, prim) = primary(q)?
      let (q, right) = postfix(q, prim)?
      p = q
      if at_ops(p, HIGH_OPS) || at_kw(p, "as") {
        let t = cur(p)
        return Err(
          e_at(
            t,
            "语法错误: 管道 |> 的右侧只能是函数或调用，不会吸收后面的 {sv(t.val)}；请写成 (a |> f) {sv(t.val)} …",
          ),
        )
      }
      left = mkn(pt.line, NPipe(left, right))
    }
    return Ok((p, left))
  }
  let (q, l0) = binary(p, lvl + 1)?
  p = q
  var left = l0
  while at_ops(p, BIN[lvl]) {
    let (q, tok) = adv(p)
    p = q
    let op = sv(tok.val)
    var right: Node? = None
    if lvl == 5 && op == ".." && at_op(p, "]") && s0 == p.slice_start {
      right = None
    } else {
      let (q, r) = binary(p, lvl + 1)?
      p = q
      right = Some(r)
    }
    if op == "&&" {
      left = is_conj(left, unwrap(right), tok.line)
    } else {
      left = mkn(tok.line, NBin(op, left, right))
    }
    if lvl == 5 { break }
    if (lvl == 2 || lvl == 3 || lvl == 5) && at_ops(p, BIN[lvl]) {
      let t = cur(p)
      return Err(
        e_at(
          t,
          "语法错误: {op} 与 {sv(t.val)} 不可连用（比较不可结合）：a < b < c 请写成 a < b && b < c",
        ),
      )
    }
  }
  if lvl == 2 && at_kw(p, "is") {
    let (q, it) = adv(p)
    let (q, pat) = pattern(q)?
    p = q
    left = mkn(it.line, NIs(left, pat))
  }
  Ok((p, left))
}

fn loop_block(p0: P, label: Str?) -> Result<(P, Node), Str> {
  var p = p0
  p.loopfr = push(p.loopfr, (label, false))
  let (q, b) = block(p)?
  var q2 = q
  q2.loopfr = q2.loopfr[0..len(q2.loopfr) - 1]
  Ok((q2, b))
}

fn loop_expr(p0: P, ln: Int, label: Str?, force: Bool) -> Result<(P, Node), Str> {
  var p = p0
  p.loopfr = push(p.loopfr, (label, force))
  let (q, body) = block(p)?
  var q2 = q
  let (_, marked) = q2.loopfr[len(q2.loopfr) - 1]
  q2.loopfr = q2.loopfr[0..len(q2.loopfr) - 1]
  if marked { return Ok((q2, mkn(ln, NLoop(body, label)))) }
  Ok((q2, mkn(ln, NWhile(None, body))))
}

fn slice_node(obj: Node, lo: Node?, op: Str, hi: Node?, ln: Int) -> Node {
  let mode = if is_none(hi) { 2 } else if op == "..=" { 1 } else { 0 }
  call_name(ln, "__slice", [
    obj,
    unwrap_or(lo, lit(ln, LInt(0))),
    unwrap_or(hi, lit(ln, LInt(0))),
    lit(ln, LInt(mode)),
  ])
}

fn unary(p0: P) -> Result<(P, Node), Str> {
  if at_op(p0, "-") || at_op(p0, "!") || at_op(p0, "~") {
    let (q, tok) = adv(p0)
    let (q, operand) = unary(q)?
    return Ok((q, mkn(tok.line, NUnary(sv(tok.val), operand, tok.pos))))
  }
  let (q, e) = primary(p0)?
  postfix(q, e)
}

fn name_of(e: Node) -> Str? {
  match e.k {
    NName(n) => Some(n),
    _ => None,
  }
}

fn postfix(p0: P, e0: Node) -> Result<(P, Node), Str> {
  var p = p0
  var e = e0
  while true {
    if at_op(p, "(") {
      let ln = cur(p).line
      let (q, a) = args(p)?
      p = q
      e = mkn(ln, NCall(e, a))
    } else if at_op(p, ".") {
      let (q, dt) = adv(p)
      p = q
      let ln = dt.line
      if at_kw(p, "await") {
        let (q, at) = adv(p)
        p = q
        let sr = match e.k {
          NSpawn(_) => true,
          NRace(_) => true,
          _ => false,
        }
        if !sr && !p.in_async {
          return Err(e_at(at, "语法错误: .await 只能用在 async fn、async 块或 async 闭包里"))
        }
        if sr { e = mkn(ln, NAwait(e)) } else { e = call_name(ln, "__await", [e]) }
        continue
      }
      if at_op(p, "<") {
        p = skip(p)
        var targs: List<TyX?> = []
        while true {
          let (q, g) = at_gt(p)
          p = q
          if g { break }
          p = skip_nl(p)
          if at_k(p, "IDENT") && cv(p) == "_" {
            p = skip(p)
            targs = push(targs, None)
          } else {
            let (q, t) = ty(p)?
            p = q
            targs = push(targs, Some(t))
          }
          p = skip_nl(p)
          if at_op(p, ",") {
            p = skip(p)
          } else {
            let (q, g2) = at_gt(p)
            p = q
            if !g2 {
              let (q, _) = expect(p, "OP", ">")?
              p = q
            }
          }
        }
        p = skip(p)
        if len(targs) == 0 { return Err(e_ln(ln, "语法错误: .<> 里至少要有一个类型")) }
        e = mkn(ln, NTypeApp(e, targs))
        continue
      }
      if at_k(p, "INT") {
        let (q, it) = adv(p)
        p = q
        e = mkn(ln, NTupleIndex(e, v_lit(it.val)))
        continue
      }
      if at_k(p, "FLOAT") {
        let (q, ft) = adv(p)
        p = q
        let parts = split(repr_v(ft.val), ".")
        let a = unwrap(parse_int(parts[0]))
        let b = unwrap(parse_int(parts[1]))
        e = mkn(ln, NTupleIndex(mkn(ln, NTupleIndex(e, LInt(a))), LInt(b)))
        continue
      }
      let nt = cur(p)
      let (q, name) = expect_ident(p)?
      p = q
      let en = name_of(e)
      if first_upper(name) && is_some(en) && first_upper(unwrap(en)) && at_struct_lit(p) {
        let (q, s) = struct_lit(p, nt, NmQ(name, en))?
        p = q
        e = s
        continue
      }
      if first_upper(name) && at_struct_lit(p) {
        var path_names: List<Str> = []
        var x = e
        var go = true
        while go {
          match x.k {
            NField(o, fnm0) => {
              let fnm = ast.nm_str(fnm0)
              path_names = push(path_names, fnm)
              x = o
            },
            _ => { go = false },
          }
        }
        let xn = name_of(x)
        if is_some(xn) && first_lower(unwrap(xn)) && all(path_names, (n) => first_lower(n)) {
          let qn = join([unwrap(xn)] + reverse(path_names) + [name], ".")
          let (q, s) = struct_lit(p, nt, NmS(qn))?
          p = q
          e = s
          continue
        }
      }
      e = mkn(ln, NField(e, NmS(name)))
    } else if at_op(p, "[") {
      let (q, bt) = adv(p)
      p = q
      let ln = bt.line
      if at_op(p, "..") || at_op(p, "..=") {
        let (q, ot) = adv(p)
        p = q
        let op = sv(ot.val)
        var hi: Node? = None
        if !(op == ".." && at_op(p, "]")) {
          let (q, h) = binary(p, 6)?
          p = q
          hi = Some(h)
        }
        let (q, _) = expect(p, "OP", "]")?
        p = q
        e = slice_node(e, None, op, hi, ln)
        continue
      }
      let saved = p.slice_start
      p.slice_start = p.i
      let (q, idx) = expr(p, false)?
      p = q
      p.slice_start = saved
      let (q, _) = expect(p, "OP", "]")?
      p = q
      var sliced = false
      match idx.k {
        NBin(op, l, r) => {
          if op == ".." || op == "..=" {
            e = slice_node(e, Some(l), op, r, ln)
            sliced = true
          }
        },
        _ => {},
      }
      if sliced { continue }
      e = mkn(ln, NIndex(e, idx))
    } else if at_op(p, "?") {
      let (q, qt) = adv(p)
      p = q
      e = mkn(qt.line, NTry(e))
    } else {
      return Ok((p, e))
    }
  }
  Ok((p, e))
}

fn args(p0: P) -> Result<(P, List<Node>), Str> {
  let (q, _) = expect(p0, "OP", "(")?
  var p = q
  var out: List<Node> = []
  while !at_op(p, ")") {
    let (q, a) = expr(p, false)?
    p = q
    out = push(out, a)
    if at_op(p, ",") {
      p = skip(p)
    } else if !at_op(p, ")") {
      let (q, _) = expect(p, "OP", ",")?
      p = q
    }
  }
  Ok((skip(p), out))
}

fn is_paren_lambda(p: P) -> Bool {
  var depth = 0
  var j = p.i
  while j < len(p.t) {
    let tk = p.t[j]
    let v = sv(tk.val)
    if tk.kind == "OP" && (v == "(" || v == "[" || v == "\{") {
      depth += 1
    } else if tk.kind == "OP" && (v == ")" || v == "]" || v == "}") {
      depth -= 1
      if depth == 0 { return tis(p.t[j + 1], "OP", "=>") }
    } else if tk.kind == "EOF" {
      return false
    }
    j += 1
  }
  false
}

fn is_fn_decl(p: P) -> Bool {
  var j = p.i
  if tis(p.t[j], "KW", "async") { j += 1 }
  if tis(p.t[j], "KW", "unsafe") { j += 1 }
  tis(p.t[j], "KW", "fn") && p.t[j + 1].kind == "IDENT"
}

fn future_of(ln: Int, body: Node, ctx: Str) -> Node {
  future_lit(ln, mkn(ln, NLambda([], body, Some(ctx))))
}

fn async_body(p0: P, ln: Int, ctx: Str) -> Result<(P, Node), Str> {
  var p = p0
  let saved = p.loopfr
  let sa = p.in_async
  p.loopfr = []
  p.in_async = true
  let (q, body) = if at_op(p, "\{") { block(p)? } else { expr(p, false)? }
  var q2 = q
  q2.loopfr = saved
  q2.in_async = sa
  Ok((q2, future_of(ln, body, ctx)))
}

fn async_expr(p0: P) -> Result<(P, Node), Str> {
  let (q, tok) = adv(p0)
  var p = q
  if at_op(p, "\{") { return async_body(p, tok.line, "async 块的值") }
  var ps: List<(Str, TyX?)> = []
  if at_kw(p, "fn") {
    let (q, x) = params(skip(p))?
    p = q
    ps = x
    if at_op(p, "->") {
      let (q, _) = ty(skip(p))?
      p = q
    }
    if !at_op(p, "\{") {
      let (q, _) = expect(p, "OP", "\{")?
      p = q
    }
  } else if at_k(p, "IDENT") && tis(peek(p, 1), "OP", "=>") {
    let (q, nt) = adv(p)
    p = skip(q)
    ps = [(sv(nt.val), None)]
  } else if at_op(p, "(") && is_paren_lambda(p) {
    let (q, x) = params(p)?
    let (q, _) = expect(q, "OP", "=>")?
    p = q
    ps = x
  } else {
    return Err(e_at(tok, "语法错误: async 后面应该是 \{ 块 }、闭包或 fn"))
  }
  let (q, body) = async_body(p, tok.line, "async 闭包的返回值")?
  Ok((q, mkn(tok.line, NLambda(ps, body, None))))
}

fn lambda_body(p0: P) -> Result<(P, Node), Str> {
  var p = p0
  let saved = p.loopfr
  let sa = p.in_async
  p.loopfr = []
  p.in_async = false
  let (q, body) = if at_op(p, "\{") { block(p)? } else { expr(p, false)? }
  var q2 = q
  q2.loopfr = saved
  q2.in_async = sa
  Ok((q2, body))
}

// 插值 {expr:spec}：冒号必须在括号外、字符串和字符外
fn split_fmt_spec(src: Str) -> (Str, Str?) {
  let cs = chars(src)
  let n = len(cs)
  var depth = 0
  var i = 0
  while i < n {
    let c = cs[i]
    if c == "(" || c == "[" || c == "\{" {
      depth += 1
    } else if c == ")" || c == "]" || c == "}" {
      depth -= 1
    } else if c == "\"" {
      i += 1
      while i < n && cs[i] != "\"" { i += if cs[i] == "\\" { 2 } else { 1 } }
    } else if c == "'" && i + 2 < n && (cs[i + 1] == "\\" || cs[i + 2] == "'") {
      let from = if cs[i + 1] != "\\" { i + 2 } else { i + 3 }
      var j = from
      while j < n && cs[j] != "'" { j += 1 }
      if j >= n { j = -1 }
      i = if j > 0 { j } else { i }
    } else if c == ":" && depth == 0 {
      return (join(cs[0..i], ""), Some(join(cs[i + 1..n], "")))
    }
    i += 1
  }
  (src, None)
}

fn is_dig(c: Str) -> Bool {
  let o = __ord(c)
  o >= 48 && o <= 57
}

// [[填充]对齐][0][宽度][.精度][x|X|o|b|e|?] 整串匹配
fn fmt_spec_ok(spec: Str) -> Bool {
  let cs = chars(spec)
  let n = len(cs)
  let is_al = (c: Str) => c == "<" || c == ">" || c == "^"
  var starts: List<Int> = []
  if n >= 2 && is_al(cs[1]) { starts = push(starts, 2) }
  if n >= 1 && is_al(cs[0]) { starts = push(starts, 1) }
  starts = push(starts, 0)
  for s in starts {
    var i = s
    while i < n && is_dig(cs[i]) { i += 1 }
    var ok = true
    if i < n && cs[i] == "." {
      if i + 1 < n && is_dig(cs[i + 1]) {
        i += 1
        while i < n && is_dig(cs[i]) { i += 1 }
      } else {
        ok = false
      }
    }
    if ok && i < n && contains(["x", "X", "o", "b", "e", "?"], cs[i]) { i += 1 }
    if ok && i == n { return true }
  }
  false
}

fn primary(p0: P) -> Result<(P, Node), Str> {
  var p = p0
  let tok = cur(p)
  if tok.kind == "INT" || tok.kind == "FLOAT" {
    return Ok((skip(p), lit(tok.line, v_lit(tok.val))))
  }
  if tok.kind == "STR" {
    p = skip(p)
    var parts: List<IPart> = []
    for part in lexer.parts(tok.val) {
      match part {
        SExpr(etext, _) => {
          let (src, spec) = split_fmt_spec(etext)
          let stoks0 = lexer.lex(src)?
          let stoks = map(stoks0, (st) => Tok { line: tok.line + st.line - 1, ..st })
          let sub = skip_nl(new_p(stoks))
          if at_k(sub, "EOF") {
            return Err(e_at(tok, "语法错误: 空的字符串插值 \{}（字面的 \{ 写成 \\\{）"))
          }
          let (sub2, ex0) = expr(sub, false)?
          let sub3 = skip_nl(sub2)
          if !at_k(sub3, "EOF") {
            return Err(
              e_at(tok, "语法错误: 字符串插值里表达式后面有多余内容 " + repr_v(cur(sub3).val)),
            )
          }
          var ex = ex0
          match spec {
            Some(sp) => {
              if !fmt_spec_ok(sp) {
                return Err(
                  e_at(
                    tok,
                    "语法错误: 无效的格式说明 " + repr_str(
                      sp,
                    ) + "（[[填充]对齐][0][宽度][.精度][x|X|o|b|e|?]）",
                  ),
                )
              }
              ex = call_name(tok.line, "__fmt", [ex, lit(tok.line, LStr(sp))])
            },
            None => {},
          }
          parts = push(parts, IExpr(ex))
        },
        SStr(ps) => { parts = push(parts, IStr(ps)) },
      }
    }
    if len(parts) == 1 {
      match parts[0] {
        IStr(s) => { return Ok((p, lit(tok.line, LStr(s)))) },
        _ => {},
      }
    }
    return Ok((p, mkn(tok.line, NInterp(parts))))
  }
  if at_kw(p, "true") || at_kw(p, "false") {
    return Ok((skip(p), lit(tok.line, LBool(sv(tok.val) == "true"))))
  }
  if tok.kind == "IDENT" && tis(peek(p, 1), "OP", "=>") && !p.in_guard {
    let (q, body) = lambda_body(skip(skip(p)))?
    return Ok((q, mkn(tok.line, NLambda([(sv(tok.val), None)], body, None))))
  }
  if tok.kind == "IDENT" && sv(tok.val) == "select" && tis(peek(p, 1), "OP", "\{") {
    return select_expr(p)
  }
  if tok.kind == "IDENT" && sv(tok.val) == "race" && tis(peek(p, 1), "OP", "\{") {
    p = skip_nl(skip(skip(p)))
    var its: List<Node> = []
    while !at_op(p, "}") {
      let (q, x) = expr(p, false)?
      p = q
      its = push(its, x)
      if at_op(p, ",") { p = skip(p) }
      p = skip_nl(p)
    }
    p = skip(p)
    if len(its) == 0 { return Err(e_ln(tok.line, "语法错误: race 至少要有一项")) }
    return Ok((p, mkn(tok.line, NRace(its))))
  }
  if tok.kind == "IDENT" || at_kw(p, "self") || at_kw(p, "Self") {
    p = skip(p)
    let tv = sv(tok.val)
    if tok.kind == "IDENT"
      && tv == "Set"
      && at_op(p, "\{")
      && (!p.no_struct || (cur(p).line == tok.line && cur(p).col == tok.col + 3)) {
      p = skip_nl(skip(p))
      var its: List<Node> = []
      let saved = p.no_struct
      p.no_struct = false
      while !at_op(p, "}") {
        let (q, x) = expr(p, false)?
        p = q
        its = push(its, x)
        if at_op(p, ",") {
          p = skip(p)
        } else if !at_op(p, "}") {
          p = skip_nl(p)
        }
        p = skip_nl(p)
      }
      p.no_struct = saved
      p = skip(p)
      return Ok((p, call_name(tok.line, "__set_lit", [mkn(tok.line, NList(its))])))
    }
    if first_upper(tv) && at_struct_lit(p) { return struct_lit(p, tok, NmS(tv)) }
    return Ok((p, name_node(tok.line, tv)))
  }
  if at_op(p, "(") { return paren_expr(p, tok) }
  primary2(p, tok)
}

fn at_struct_lit(p: P) -> Bool {
  if p.no_struct || !at_op(p, "\{") { return false }
  let a = peek(p, 1)
  let b = peek(p, 2)
  (a.kind == "IDENT" && b.kind == "OP" && contains([":", ",", "}"], sv(b.val)))
    || (a.kind == "OP" && contains(["}", ".."], sv(a.val)))
}

fn struct_lit(p0: P, tok: Tok, name: Nm) -> Result<(P, Node), Str> {
  var p = skip_nl(skip(p0))
  var fs: List<(Str, Node)> = []
  var base: Node? = None
  while !at_op(p, "}") {
    if at_op(p, "..") {
      let (q, bt) = adv(p)
      let (q, b) = expr(q, false)?
      p = skip_nl(q)
      base = Some(b)
      if at_op(p, ",") { p = skip_nl(skip(p)) }
      if !at_op(p, "}") { return Err(e_at(bt, "语法错误: ..base 必须是结构体字面量的最后一项")) }
      break
    }
    let (q, fname) = expect_ident(p)?
    p = q
    if at_op(p, ":") {
      let (q, v) = expr(skip(p), false)?
      p = q
      fs = push(fs, (fname, v))
    } else {
      fs = push(fs, (fname, name_node(tok.line, fname)))
    }
    if at_op(p, ",") { p = skip(p) }
    p = skip_nl(p)
  }
  p = skip(p)
  Ok((p, mkn(tok.line, NStructLit(name, fs, base))))
}

fn paren_expr(p0: P, tok: Tok) -> Result<(P, Node), Str> {
  if is_paren_lambda(p0) {
    let (q, ps) = params(p0)?
    let (q, _) = expect(q, "OP", "=>")?
    let (q, body) = lambda_body(q)?
    return Ok((q, mkn(tok.line, NLambda(ps, body, None))))
  }
  var p = skip(p0)
  if at_op(p, ")") { return Ok((skip(p), mkn(tok.line, NTuple([])))) }
  let (q, first) = expr(p, false)?
  p = q
  if at_op(p, ")") { return Ok((skip(p), first)) }
  var its = [first]
  while at_op(p, ",") {
    p = skip(p)
    if at_op(p, ")") { break }
    let (q, x) = expr(p, false)?
    p = q
    its = push(its, x)
  }
  let (q, _) = expect(p, "OP", ")")?
  Ok((q, mkn(tok.line, NTuple(its))))
}

fn expr_items(p0: P) -> Result<(P, List<Node>), Str> {
  var p = p0
  var its: List<Node> = []
  while !at_op(p, "}") {
    let (q, x) = expr(p, false)?
    p = q
    its = push(its, x)
    if at_op(p, ",") { p = skip(p) }
    p = skip_nl(p)
  }
  Ok((skip(p), its))
}

fn primary2(p0: P, tok: Tok) -> Result<(P, Node), Str> {
  var p = p0
  if at_op(p, "[") {
    p = skip(p)
    var its: List<Node> = []
    while !at_op(p, "]") {
      let (q, x) = expr(p, false)?
      p = q
      its = push(its, x)
      if len(its) == 1 && at_op(p, ";") {
        let (q, cnt) = expr(skip(p), false)?
        let (q, _) = expect(q, "OP", "]")?
        return Ok((q, call_name(tok.line, "__repeat", [its[0], cnt])))
      }
      if at_op(p, ",") {
        p = skip(p)
      } else if !at_op(p, "]") {
        let (q, _) = expect(p, "OP", ",")?
        p = q
      }
    }
    return Ok((skip(p), mkn(tok.line, NList(its))))
  }
  if at_op(p, "\{") { return block(p) }
  if at_kw(p, "if") { return if_expr(p) }
  if at_kw(p, "match") { return match_expr(p) }
  if at_kw(p, "loop") { return loop_expr(skip(p), tok.line, None, true) }
  if tok.kind == "LABEL" && tis(peek(p, 1), "OP", ":") {
    p = skip(skip(p))
    if !at_kw(p, "loop") {
      return Err(e_at(cur(p), "语法错误: 表达式里的标签 '{sv(tok.val)} 后面必须是 loop"))
    }
    return loop_expr(skip(p), tok.line, Some(sv(tok.val)), true)
  }
  if at_kw(p, "spawn") {
    let (q, _) = expect(skip(p), "OP", "\{")?
    let (q, its) = expr_items(skip_nl(q))?
    return Ok((q, mkn(tok.line, NSpawn(its))))
  }
  if at_kw(p, "unsafe") {
    let (q, b) = block(skip(p))?
    return Ok((q, Node { k: NBlock(block_stmts(b), true), ..b }))
  }
  if at_kw(p, "async") { return async_expr(p) }
  if at_kw(p, "fn") {
    let (q, ps) = params(skip(p))?
    p = q
    if at_op(p, "->") {
      let (q, _) = ty(skip(p))?
      p = q
    }
    let (q, body) = lambda_body(p)?
    return Ok((q, mkn(tok.line, NLambda(ps, body, None))))
  }
  Err(e_at(tok, "语法错误: 意外的 " + tval(tok)))
}

// 返回 else 部分（没有时为 None）
fn else_part(p0: P, ln: Int) -> Result<(P, Node?), Str> {
  if !at_kw(p0, "else") { return Ok((p0, None)) }
  let p = skip(p0)
  if at_kw(p, "if") {
    let (q, e) = if_expr(p)?
    return Ok((q, Some(e)))
  }
  let (q, b) = block(p)?
  Ok((q, Some(b)))
}

fn is_block(n: Node) -> Bool {
  match n.k {
    NBlock(..) => true,
    _ => false,
  }
}

fn wrap_els(then0: Node, els0: Node?, ln: Int) -> (Node, Node) {
  match els0 {
    None => (unit_tail(then0), block_of(ln, [])),
    Some(e) => if is_block(e) { (then0, e) } else { (then0, block_of(ln, [expr_stmt(ln, e)])) },
  }
}

fn if_expr(p0: P) -> Result<(P, Node), Str> {
  let (q, it) = expect(p0, "KW", "if")?
  let ln = it.line
  if at_kw(q, "let") {
    let (q, pat) = pattern(skip(q))?
    let (q, _) = expect(q, "OP", "=")?
    let (q, subj) = expr(q, true)?
    let (q, then0) = block(q)?
    let (q, els0) = else_part(q, ln)?
    let (then, els) = wrap_els(then0, els0, ln)
    return Ok((q, match_n(ln, subj, [arm(pat, None, then), arm(PWild, None, els)])))
  }
  let (q, c) = expr(q, true)?
  var isn: (Node, Pat, Node?)? = None
  match c.k {
    NIs(v, pt) => { isn = Some((v, pt, None)) },
    NMatch(m) => {
      if let Some(ic) = m.is_conj {
        match ic.0.k {
          NIs(v, pt) => { isn = Some((v, pt, Some(ic.1))) },
          _ => {},
        }
      }
    },
    _ => {},
  }
  if let Some(x) = isn {
    let (q, then0) = block(q)?
    let (q, els0) = else_part(q, ln)?
    let (then, els) = wrap_els(then0, els0, ln)
    return Ok((q, match_n(ln, x.0, [arm(x.1, x.2, then), arm(PWild, None, els)])))
  }
  let (q, then) = block(q)?
  let (q, els) = else_part(q, ln)?
  Ok((q, mkn(ln, NIf(c, then, els))))
}

fn guard_expr(p0: P) -> Result<(P, Node), Str> {
  var p = p0
  let saved = p.in_guard
  p.in_guard = true
  let (q, e) = expr(p, false)?
  var q2 = q
  q2.in_guard = saved
  Ok((q2, e))
}

fn select_expr(p0: P) -> Result<(P, Node), Str> {
  let (q, st) = adv(p0)
  let ln = st.line
  let (q, _) = expect(q, "OP", "\{")?
  var p = skip_nl(q)
  var arms: List<SArm> = []
  while !at_op(p, "}") {
    let t = cur(p)
    let tv = sv(t.val)
    var kd = "default"
    var a: Node? = None
    var b: Node? = None
    var pat: Pat? = None
    var guard: Node? = None
    if t.kind == "IDENT" && tv == "_" {
      p = skip(p)
    } else if t.kind == "IDENT"
      && (tv == "recv" || tv == "send" || tv == "after")
      && tis(peek(p, 1), "OP", "(") {
      kd = tv
      let (q, x) = expr(skip(skip(p)), false)?
      p = q
      a = Some(x)
      if tv == "send" {
        let (q, _) = expect(p, "OP", ",")?
        let (q, x) = expr(q, false)?
        p = q
        b = Some(x)
      }
      let (q, _) = expect(p, "OP", ")")?
      p = q
      if tv == "recv" && at_kw(p, "as") {
        let (q, x) = pattern(skip(p))?
        p = q
        pat = Some(x)
      }
      if tv != "after" && at_kw(p, "if") {
        let (q, x) = guard_expr(skip(p))?
        p = q
        guard = Some(x)
      }
    } else {
      return Err(
        e_at(t, "语法错误: select 的分支必须是 recv(通道)、send(通道, 值)、after(毫秒) 或 _"),
      )
    }
    let (q, _) = expect(p, "OP", "=>")?
    let (q, body) = expr(q, false)?
    p = q
    arms = push(arms, SArm { kind: kd, a: a, b: b, pat: pat, guard: guard, body: body })
    if at_op(p, ",") { p = skip(p) }
    p = skip_nl(p)
  }
  p = skip(p)
  let kinds = map(arms, (x) => x.kind)
  if !any(kinds, (k) => k == "recv" || k == "send") {
    return Err(e_ln(ln, "语法错误: select 至少要有一个 recv 或 send 分支"))
  }
  if count(kinds, (k) => k == "after" || k == "default") > 1 {
    return Err(e_ln(ln, "语法错误: select 最多只能有一个 after 或 _ 分支（二者不能同时出现）"))
  }
  Ok((p, mkn(ln, NSelect(arms))))
}

fn match_expr(p0: P) -> Result<(P, Node), Str> {
  let (q, mt) = expect(p0, "KW", "match")?
  let ln = mt.line
  let (q, subj) = expr(q, true)?
  let (q, _) = expect(q, "OP", "\{")?
  var p = skip_nl(q)
  var arms: List<Arm> = []
  while !at_op(p, "}") {
    let (q, pat) = pattern(p)?
    p = q
    var guard: Node? = None
    if at_kw(p, "if") {
      let (q, g) = guard_expr(skip(p))?
      p = q
      guard = Some(g)
    }
    let (q, _) = expect(p, "OP", "=>")?
    let (q, body) = expr(q, false)?
    p = q
    arms = push(arms, arm(pat, guard, body))
    if at_op(p, ",") { p = skip(p) }
    p = skip_nl(p)
  }
  Ok((skip(p), match_n(ln, subj, arms)))
}

// ── 模式 ──

fn pattern(p0: P) -> Result<(P, Pat), Str> {
  let (q, first) = pattern1(p0)?
  var p = q
  if !at_op(p, "|") { return Ok((p, first)) }
  var alts = [first]
  while at_op(p, "|") {
    let (q, x) = pattern1(skip_nl(skip(p)))?
    p = q
    alts = push(alts, x)
  }
  Ok((p, POr(alts)))
}

fn pat_lit_start(p: P, k: Int) -> Bool {
  let t = if k > 0 { peek(p, k) } else { cur(p) }
  let nk = peek(p, k + 1).kind
  t.kind == "INT"
    || t.kind == "FLOAT"
    || t.kind == "STR"
    || (tis(t, "OP", "-") && (nk == "INT" || nk == "FLOAT"))
}

fn neg(v: TV) -> Lit {
  match v {
    TkInt(i) => LInt(-i),
    TkFlt(f) => LFlt(-f),
    TkBig(t) => if t == "9223372036854775808" {
      LInt(-9223372036854775807 - 1)
    } else {
      LBig("-" + t)
    },
    _ => v_lit(v),
  }
}

fn pat_lit(p0: P) -> Result<(P, Lit), Str> {
  let tok = cur(p0)
  if at_op(p0, "-") {
    let (q, t) = adv(skip(p0))
    if t.kind != "INT" && t.kind != "FLOAT" { return Err(e_at(t, "语法错误: - 后面必须是数字")) }
    return Ok((q, neg(t.val)))
  }
  if tok.kind == "STR" {
    if !all_str(lexer.parts(tok.val)) {
      return Err(e_at(tok, "语法错误: 模式里的字符串不能有插值"))
    }
    return Ok((skip(p0), LStr(join_strs(lexer.parts(tok.val)))))
  }
  if tok.kind == "INT" || tok.kind == "FLOAT" { return Ok((skip(p0), v_lit(tok.val))) }
  Err(e_at(tok, "语法错误: 期望字面量，实际是 " + repr_v(tok.val)))
}

fn seq_pats(p0: P, close: Str, allow_bind: Bool) -> Result<(P, List<Pat>, Str?, List<Pat>), Str> {
  var p = p0
  var pre: List<Pat> = []
  var post: List<Pat> = []
  var rest = "_"
  var seen = false
  while !at_op(p, close) {
    p = skip_nl(p)
    if at_op(p, "..") && !pat_lit_start(p, 1) {
      let (q, t) = adv(p)
      p = q
      if seen { return Err(e_at(t, "语法错误: 一个序列模式里只能有一个 ..")) }
      seen = true
      rest = "_"
      if at_k(p, "IDENT") && cv(p) != "_" {
        if !allow_bind { return Err(e_at(t, "语法错误: 元组 / 变体模式里的 .. 不能绑定名字")) }
        let (q, nt) = adv(p)
        p = q
        rest = sv(nt.val)
      } else if at_k(p, "IDENT") {
        p = skip(p)
      }
    } else {
      let (q, x) = pattern(p)?
      p = q
      if seen { post = push(post, x) } else { pre = push(pre, x) }
    }
    p = skip_nl(p)
    if at_op(p, ",") {
      p = skip(p)
    } else if !at_op(p, close) {
      let (q, _) = expect(p, "OP", close)?
      p = q
    }
  }
  Ok((skip(p), pre, if seen { Some(rest) } else { None }, post))
}

fn pattern1(p0: P) -> Result<(P, Pat), Str> {
  var p = p0
  let tok = cur(p)
  if tok.kind == "IDENT" && sv(tok.val) == "_" { return Ok((skip(p), PWild)) }
  if at_kw(p, "var") {
    p = skip(p)
    let n = cur(p)
    if n.kind != "IDENT" || sv(n.val) == "_" || first_upper(sv(n.val)) {
      return Err(e_at(n, "语法错误: var 后面必须是小写的绑定名"))
    }
    p = skip(p)
    let b = PVar(NmS(sv(n.val)))
    if at_op(p, "@") {
      let (q, x) = pattern1(skip(p))?
      return Ok((q, PAt(b, x)))
    }
    return Ok((p, b))
  }
  if at_op(p, "..") || at_op(p, "..=") {
    let (q, op) = adv(p)
    if !pat_lit_start(q, 0) { return Err(e_at(op, "语法错误: 区间模式 .. 后面需要字面量")) }
    let (q, hi) = pat_lit(q)?
    return Ok((q, PRange(None, Some(hi), sv(op.val) == "..=")))
  }
  if pat_lit_start(p, 0) {
    let (q, lo) = pat_lit(p)?
    p = q
    if at_op(p, "..=") {
      let (q, hi) = pat_lit(skip(p))?
      return Ok((q, PRange(Some(lo), Some(hi), true)))
    }
    if at_op(p, "..") {
      p = skip(p)
      if pat_lit_start(p, 0) {
        let (q, hi) = pat_lit(p)?
        return Ok((q, PRange(Some(lo), Some(hi), false)))
      }
      return Ok((p, PRange(Some(lo), None, false)))
    }
    return Ok((p, PLit(lo)))
  }
  if at_kw(p, "true") || at_kw(p, "false") {
    return Ok((skip(p), PLit(LBool(sv(tok.val) == "true"))))
  }
  if at_op(p, "(") {
    let (q, pre, rest, post) = seq_pats(skip_nl(skip(p)), ")", false)?
    if is_none(rest) && len(pre) == 1 { return Ok((q, pre[0])) }
    if is_none(rest) { return Ok((q, PTuple(pre))) }
    return Ok((q, PTuple(pre + [PDots] + post)))
  }
  if at_op(p, "[") {
    let (q, pre, rest, post) = seq_pats(skip(p), "]", true)?
    return Ok((q, PList(pre, rest, post)))
  }
  if tok.kind == "IDENT" || at_kw(p, "self") || at_kw(p, "Self") {
    var name = NmS("")
    if at_kw(p, "Self") {
      match p.impl_target {
        Some(t) => { name = NmS(t) },
        None => { return Err(e_at(tok, "语法错误: 模式里的 Self 只能用在 impl 里")) },
      }
      p = skip(p)
    } else {
      let (q, nt) = adv(p)
      p = q
      name = NmS(sv(nt.val))
    }
    while at_op(p, ".") && peek(p, 1).kind == "IDENT" {
      let qual = nm_s(name)
      let (q, nt) = adv(skip(p))
      p = q
      name = NmQ(sv(nt.val), Some(qual))
    }
    let ns = nm_s(name)
    let is_q = match name {
      NmQ(..) => true,
      _ => false,
    }
    if at_op(p, "@") {
      if first_upper(ns) || is_q || ns == "self" {
        return Err(e_at(tok, "语法错误: @ 左边必须是小写的绑定名"))
      }
      let (q, x) = pattern1(skip(p))?
      return Ok((q, PAt(PBind(name), x)))
    }
    if at_op(p, "(") {
      let (q, pre, rest, post) = seq_pats(skip(p), ")", false)?
      let subs = if is_none(rest) { pre } else { pre + [PDots] + post }
      return Ok((q, PVariant(name, Some(subs))))
    }
    if at_op(p, "\{") && first_upper(ns) {
      p = skip(p)
      var fs: List<(Str, Pat)> = []
      while !at_op(p, "}") {
        if at_op(p, "..") {
          p = skip(p)
          continue
        }
        let (q, f) = expect_ident(p)?
        p = q
        if at_op(p, ":") {
          let (q, x) = pattern(skip(p))?
          p = q
          fs = push(fs, (f, x))
        } else {
          fs = push(fs, (f, bind(f)))
        }
        if at_op(p, ",") { p = skip(p) }
      }
      return Ok((skip(p), PStruct(name, fs)))
    }
    if first_upper(ns) { return Ok((p, PVariant(name, None))) }
    return Ok((p, PBind(name)))
  }
  Err(e_at(tok, "语法错误: 无效的模式 " + repr_v(tok.val)))
}
