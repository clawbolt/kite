use std.fs
use std.env
use ast
use lexer
use parser
use check
use modules
use std.path
use bc
use cgen
use kir
use kirdump
use std.process

fn main() {
  let args = env.args()
  let mode = args[0]
  let src = match fs.read(args[1]) {
    Ok(s)  => s,
    Err(e) => {
      print("读取失败: {e}")
      return
    },
  }
  if mode == "build" {
    process.exit(build(args))
  }
  if mode == "lex" {
    match lexer.lex(src) {
      Ok(ts) => {
        for t in ts { print(t.kind, lexer.repr_v(t.val), t.line, t.col, if t.nl { "True" } else { "False" }) }
      },
      Err(e) => print(e),
    }
  } else if mode == "check" || mode == "lower" || mode == "bc" || mode == "c" || mode == "kir" || mode == "ck" {
    let cwd = __getcwd()
    let kdir = path.dir(if path.is_abs(args[2]) { args[2] } else { path.join([cwd, args[2]]) })
    let (items, srcs) = match modules.load_main_src(modules.new_l(cwd, args[1], kdir), args[1]) {
      Ok(r)   => r,
      Err(e)  => {
        if e.ln == -2 { print("SKIP parse") } else if e.ln == -1 { print("UNSUP kitec 未支持: " + e.msg) } else { print("L {e.ln} " + modules.strip_lm(e.msg)) }
        return
      },
    }
    let pre = match fs.read(args[2]) {
      Ok(s)  => s,
      Err(e) => {
        print("读取失败: {e}")
        return
      },
    }
    let pits = match parser.parse(pre) {
      Ok(its) => its,
      Err(e)  => {
        print(e)
        return
      },
    }
    let (errs, sigs, lown, cst) = check.check_c(pits, items)
    let low = map(lown, ast.to_v)
    if len(errs) > 0 && errs[0].0 == -1 {
      print("UNSUP " + errs[0].1)
      return
    }
    for (ln, msg) in errs { print("E {ln} " + modules.strip_lm(msg)) }
    if mode == "kir" {
      if len(errs) == 0 {
        let (st, _) = bc.compile_chunk(low)
        if st.err != "" {
          print(st.err)
          return
        }
        let (fns, why) = kir.collect(low, cst)
        print(kirdump.dump(fns, why))
      }
      return
    }
    if mode == "lower" {
      if len(errs) == 0 { for it in low { print(ast.dump(it)) } }
      return
    }
    if mode == "c" || mode == "ck" {
      if len(errs) == 0 {
        let (st, chunk) = bc.compile_chunk(low)
        if st.err != "" {
          print(st.err)
          return
        }
        let rt = match fs.read(path.join([kdir, "runtime", "kite_rt.c"])) {
          Ok(x) => x,
          Err(_) => "",
        }
        let case_h = match fs.read(path.join([kdir, "runtime", "kite_case.h"])) {
          Ok(x) => x,
          Err(_) => "",
        }
        let rt2 = cgen.first_replace(rt, "#include \"kite_case.h\"\n", case_h)
        if mode == "ck" {
          let (kf, _) = kir.collect(low, cst)
          print(cgen.generate_k(st, chunk, path.base(args[1]), srcs, rt2, kf))
        } else {
          print(cgen.generate(st, chunk, path.base(args[1]), srcs, rt2))
        }
      }
      return
    }
    if mode == "bc" {
      if len(errs) == 0 {
        let (st, chunk) = bc.compile_chunk(low)
        print(join(bc.dump(st, chunk), "\n"))
      }
      return
    }
    for (n, s) in sigs { print("F {n}: {s}") }
  } else {
    match parser.parse(src) {
      Ok(items) => { for it in items { print(ast.dump(ast.to_v(it))) } },
      Err(e)    => print(e),
    }
  }
}

// ───────── kitec build FILE PRELUDE [-o 输出] [--emit-c C 文件] [--no-kir] ─────────
// 和 kite build 相同的流程：类型检查 → 字节码 → KIR → C（cgen.generate_k）→ C 编译器；成功时输出“已生成 …”

fn sq(s: Str) -> Str { "'" + replace(s, "'", "'\\''") + "'" }

fn eprint(s: Str) { __eprint(s) }

fn has_cmd(c: Str) -> Bool { process.run("command -v " + c + " >/dev/null 2>&1").0 == 0 }

// 对应 native.find_cc：$CC，然后 cc / clang / gcc，最后 python3 -m ziglang cc
fn find_cc() -> Str? {
  if let Some(cc) = env.get("CC") { if trim(cc) != "" { return Some(cc) } }
  for c in ["cc", "clang", "gcc"] { if has_cmd(c) { return Some(c) } }
  if process.run("python3 -c 'import ziglang' >/dev/null 2>&1").0 == 0 { return Some("python3 -m ziglang cc -mcpu=baseline") }
  None
}

fn loc(file: Str, ln: Int, msg: Str) -> Str { if ln > 0 && ln < 1000000 { file + ":{ln}: " + msg } else { file + ": " + msg } }

fn build(args: List<Str>) -> Int {
  if len(args) < 3 {
    eprint("用法: kitec build FILE PRELUDE [-o 输出] [--emit-c C 文件] [--no-kir]")
    return 2
  }
  let file = args[1]
  var out = ""
  var emit = ""
  var use_kir = true
  var i = 3
  while i < len(args) {
    let a = args[i]
    if a == "-o" && i + 1 < len(args) {
      out = args[i + 1]
      i += 1
    } else if a == "--emit-c" && i + 1 < len(args) {
      emit = args[i + 1]
      i += 1
    } else if a == "--no-kir" {
      use_kir = false
    } else {
      eprint("未知参数 " + a)
      return 2
    }
    i += 1
  }
  if out == "" {
    let b = path.base(file)
    out = if ends_with(b, ".kite") { __str_slice(b, 0, len(b) - 5) } else { b }
  }
  let cwd = __getcwd()
  let kdir = path.dir(if path.is_abs(args[2]) { args[2] } else { path.join([cwd, args[2]]) })
  let (items, srcs) = match modules.load_main_src(modules.new_l(cwd, file, kdir), file) {
    Ok(r)  => r,
    Err(e) => {
      eprint(loc(file, e.ln, modules.strip_lm(e.msg)))
      return 1
    },
  }
  let pre = match fs.read(args[2]) {
    Ok(x)  => x,
    Err(e) => {
      eprint("读取失败: {e}")
      return 1
    },
  }
  let pits = match parser.parse(pre) {
    Ok(its) => its,
    Err(e)  => {
      eprint("prelude: " + e)
      return 1
    },
  }
  let (errs, _, lown, cst) = check.check_c(pits, items)
  let low = map(lown, ast.to_v)
  if len(errs) > 0 {
    for (ln, msg) in take(errs, 20) { eprint(loc(file, ln, modules.strip_lm(msg))) }
    return 1
  }
  let (st, chunk) = bc.compile_chunk(low)
  if st.err != "" {
    eprint(file + ": " + st.err)
    return 1
  }
  let rt = match fs.read(path.join([kdir, "runtime", "kite_rt.c"])) {
    Ok(x)  => x,
    Err(e) => {
      eprint("找不到运行时 runtime/kite_rt.c: {e}")
      return 1
    },
  }
  let case_h = match fs.read(path.join([kdir, "runtime", "kite_case.h"])) {
    Ok(x)  => x,
    Err(_) => "",
  }
  let rt2 = cgen.first_replace(rt, "#include \"kite_case.h\"\n", case_h)
  let kf = if use_kir { kir.collect(low, cst).0 } else { Map() }
  let csrc = cgen.generate_k(st, chunk, path.base(file), srcs, rt2, kf)
  if starts_with(csrc, "N ") {
    eprint(file + ": " + __str_slice(csrc, 2, len(csrc)))
    return 1
  }
  let cpath = if emit != "" { emit } else { out + ".c" }
  match fs.write(cpath, csrc) {
    Ok(_)  => (),
    Err(e) => {
      eprint("写入失败: {e}")
      return 1
    },
  }
  let cc = match find_cc() {
    Some(x) => x,
    None    => {
      eprint("找不到 C 编译器：请安装 clang / gcc，或 pip install ziglang；也可设置环境变量 CC")
      return 1
    },
  }
  var libs = ""
  for l in cgen.ext_libs(st) { libs = libs + " -l" + sq(l) }
  let (code, _) = process.run(cc + " -O2 -w -o " + sq(out) + " " + sq(cpath) + " -lm -lpthread" + libs)
  if emit == "" { let _ = fs.remove(cpath) }
  if code != 0 {
    eprint("C 编译失败（原生后端内部错误），退出码 {code}")
    return 1
  }
  print("已生成 " + out)
  0
}
