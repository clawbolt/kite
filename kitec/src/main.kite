use std.fs
use std.env
use std.kite.ast as ast
use std.kite.scanner as lexer
use std.kite.parser as parser
use std.kite.check as check
use std.kite.modules as modules
use std.path
use bc
use cgen
use kir
use kirdump
use std.process
use driver
use pkg
use fmtcli
use testing
use lsp
use std.ptr

extern "C" {
  fn system(cmd: Str) -> Int
  fn read(fd: Int, buf: Ptr, n: Int) -> Int
  fn write(fd: Int, s: Str, n: Int) -> Int
}

// 语言服务器的标准输入输出：按字节读写（Content-Length 是字节数）
fn rd_stdin(n: Int) -> List<Int> {
  unsafe {
    let buf = ptr.alloc(n)
    let k = read(0, buf, n)
    var out: List<Int> = []
    var i = 0
    while i < k {
      out = push(out, ptr.read_byte(buf, i))
      i += 1
    }
    ptr.free(buf)
    out
  }
}

fn wr_stdout(s: Str) {
  var off = 0
  let total = __byte_len(s)
  // write 可能只写一部分：剩下的部分按字节切出来再写
  var rest = s
  while off < total {
    let k = unsafe { write(1, rest, __byte_len(rest)) }
    if k <= 0 { return }
    off += k
    if off < total { rest = unwrap_or(__from_bytes(skip(__bytes(s), off)), "") }
  }
}

fn lsp_cmd() -> Int {
  let pre = match driver.prelude_path() {
    Some(p) => p,
    None => { return 1 },
  }
  let pits = match fs.read(pre) {
    Ok(src) => match parser.parse(src) {
      Ok(its) => its,
      Err(e) => {
        driver.eprint("prelude: " + e)
        return 1
      },
    },
    Err(e) => {
      driver.eprint("读取失败: {e}")
      return 1
    },
  }
  lsp.serve(pits, path.dir(pre), rd_stdin, wr_stdout)
}

fn usage() -> Str {
  join(
    [
      "用法:",
      "  kitec run FILE [参数…]          编译成临时可执行文件并运行（也可以写 kitec FILE.kite [参数…]）",
      "  kitec build [FILE] [-o 输出] [--emit-c C 文件] [--no-kir]",
      "  kitec check FILE                只做类型检查",
      "  kitec dis FILE                  查看字节码",
      "  kitec kir FILE                  查看 KIR（不装箱的中间表示）",
      "  kitec fmt [-w] [--check] [文件…]  格式化（不给文件时读标准输入）",
      "  kitec test [过滤词] [文件/目录…] [-v]  运行 test_ 开头 / 标了 @test 的测试函数",
      "  kitec lsp                       语言服务器（LSP，标准输入输出）",
      "  kitec new <名字> [--lib] | add <包>[@约束] | add <包> --path <目录> | get | update | publish | tree  包管理",
      "  （在包目录里，run / build / check 不写文件名时使用 src/main.kite）",
      "  kitec dump MODE FILE [PRELUDE]  对拍输出（MODE = lex / parse / check / lower / bc / c / kir / ck）",
      "环境变量: KITE_HOME（prelude.kite 和 runtime/ 所在目录）、CC（C 编译器）、KITE_NO_KIR=1",
    ],
    "\n",
  )
}

fn dump_modes() -> List<Str> { ["lex", "parse", "check", "lower", "bc", "c", "kir", "ck"] }

fn main() {
  let args = env.args()
  if len(args) == 0 || contains(["help", "-h", "--help"], args[0]) {
    print(usage())
    process.exit(if len(args) == 0 { 2 } else { 0 })
  }
  let cmd = args[0]
  if cmd == "build" { process.exit(build(args)) }
  if cmd == "run" { process.exit(run_cmd(skip(args, 1))) }
  if cmd == "fmt" { process.exit(fmtcli.main(skip(args, 1))) }
  if cmd == "test" { process.exit(testing.main(skip(args, 1))) }
  if cmd == "lsp" { process.exit(lsp_cmd()) }
  if pkg.is_cmd(cmd) { process.exit(pkg.main(cmd, skip(args, 1))) }
  if cmd == "check" && len(args) == 1 { process.exit(check_cmd("")) }
  if cmd == "dump" {
    if len(args) < 3 {
      driver.eprint(usage())
      process.exit(2)
    }
    process.exit(dump_cmd(skip(args, 1)))
  }
  // 旧写法 kitec MODE FILE PRELUDE、kitec parse FILE（tools/ 里的对拍脚本用）
  if len(args) >= 3 && contains(dump_modes(), cmd)
    || len(args) == 2 && (cmd == "lex" || cmd == "parse") {
    dump(args)
    return
  }
  if len(args) == 2 && (cmd == "check" || cmd == "dis" || cmd == "kir") {
    process.exit(if cmd == "check" {
      check_cmd(args[1])
    } else {
      dump_cmd([if cmd == "dis" { "bc" } else { "kir" }, args[1]])
    })
  }
  if ends_with(cmd, ".kite") { process.exit(run_cmd(args)) }
  driver.eprint("未知命令 " + cmd)
  driver.eprint(usage())
  process.exit(2)
}

// kitec dump MODE FILE [PRELUDE]；dis / kir 也走这里
fn dump_cmd(xs: List<Str>) -> Int {
  if len(xs) >= 3 {
    dump(xs)
    return 0
  }
  if xs[0] == "lex" || xs[0] == "parse" {
    dump([xs[0], xs[1], ""])
    return 0
  }
  match driver.prelude_path() {
    Some(p) => {
      dump([xs[0], xs[1], p])
      0
    },
    None => 1,
  }
}

// kitec check FILE：报错格式和 kite check 相同（最多 20 条，FILE:行: 信息）
fn check_cmd(file0: Str) -> Int {
  let file = match entry_or(file0) {
    Some(f) => f.0,
    None => { return 1 },
  }
  let pre = match driver.prelude_path() {
    Some(p) => p,
    None => { return 1 },
  }
  if let Err(e) = pkg.prepare(file) {
    driver.eprint(file + ": " + e)
    return 1
  }
  let (items, pits) = match driver.load(file, pre) {
    Ok(r) => r,
    Err(m) => {
      driver.eprint(m)
      return 1
    },
  }
  let (errs, _, _, cst) = check.check_c(pits, items.0)
  driver.print_warns(cst, items.1, file)
  if len(errs) > 0 {
    for (ln, msg) in take(errs, 20) {
      driver.eprint(driver.locs(items.1, file, ln, modules.strip_lm(msg)))
    }
    if len(errs) > 20 { driver.eprint("…共 {len(errs)} 个错误") }
    return 1
  }
  print(file + ": 类型检查通过")
  0
}

// 给了文件就用它；没给时在 Kite 包里用 src/main.kite（返回 (文件, 包名)）
fn entry_or(file: Str) -> (Str, Str)? {
  if file != "" { return Some((file, "")) }
  match pkg.entry() {
    Ok(r) => Some(r),
    Err(e) => {
      driver.eprint(e)
      None
    },
  }
}

// kitec run FILE [参数…]：编译到临时目录再运行，退出码就是程序的退出码
fn run_cmd(xs: List<Str>) -> Int {
  let file = match entry_or(if len(xs) > 0 { xs[0] } else { "" }) {
    Some(f) => f.0,
    None => { return 1 },
  }
  let pre = match driver.prelude_path() {
    Some(p) => p,
    None => { return 1 },
  }
  if let Err(e) = pkg.prepare(file) {
    driver.eprint(file + ": " + e)
    return 1
  }
  let tmp = env.get_or("TMPDIR", "/tmp")
  let dir = path.join([if tmp == "" { "/tmp" } else { tmp }, "kitec-run-{__getpid()}"])
  let _ = fs.mkdir(dir)
  let out = path.join([dir, path.stem(file)])
  let code = driver.compile(file, pre, out, "", env.get_or("KITE_NO_KIR", "") != "1", true)
  if code != 0 {
    let _ = process.run("rm -rf " + driver.sq(dir))
    return code
  }
  var cmd = driver.sq(out)
  for a in skip(xs, 1) { cmd = cmd + " " + driver.sq(a) }
  let st = unsafe { system(cmd) }
  let _ = process.run("rm -rf " + driver.sq(dir))
  if st == -1 { return 127 }
  let sig = st & 127
  if sig != 0 { return 128 + sig }
  (st >> 8) & 255
}

// 对拍用的输出模式：kitec MODE FILE PRELUDE（MODE = lex / parse / check / lower / bc / c / kir / ck），格式和 tools/*_dump.py 相同
fn dump(args: List<Str>) {
  let mode = args[0]
  let src = match fs.read(args[1]) {
    Ok(s) => s,
    Err(e) => {
      print("读取失败: {e}")
      return
    },
  }
  if mode == "lex" {
    match lexer.lex(src) {
      Ok(ts) => {
        for t in ts {
          print(t.kind, lexer.repr_v(t.val), t.line, t.col, if t.nl { "True" } else { "False" })
        }
      },
      Err(e) => print(e),
    }
  } else if mode == "check"
    || mode == "lower"
    || mode == "bc"
    || mode == "c"
    || mode == "kir"
    || mode == "ck" {
    let cwd = __getcwd()
    let kdir = path.dir(if path.is_abs(args[2]) { args[2] } else { path.join([cwd, args[2]]) })
    let (items, srcs) = match modules.load_main_src(modules.new_l(cwd, args[1], kdir), args[1]) {
      Ok(r) => r,
      Err(e) => {
        if e.ln == -2 {
          print("SKIP parse")
        } else if e.ln == -1 {
          print("UNSUP kitec 未支持: " + e.msg)
        } else {
          print("L {e.ln} " + modules.strip_lm(e.msg))
        }
        return
      },
    }
    let pre = match fs.read(args[2]) {
      Ok(s) => s,
      Err(e) => {
        print("读取失败: {e}")
        return
      },
    }
    let pits = match parser.parse(pre) {
      Ok(its) => its,
      Err(e) => {
        print(e)
        return
      },
    }
    let (errs, sigs, low, cst) = check.check_c(pits, items)
    if len(errs) > 0 && errs[0].0 == -1 {
      print("UNSUP " + errs[0].1)
      return
    }
    for (ln, msg) in errs { print("E {ln} " + modules.strip_lm(msg)) }
    if mode == "kir" {
      if len(errs) == 0 {
        let (st, _) = bc.compile_chunk(low)
        if st.err != "" {
          print(st.err)
          return
        }
        let (fns, why) = kir.collect(low, cst)
        print(kirdump.dump(fns, why))
      }
      return
    }
    if mode == "lower" {
      if len(errs) == 0 { for it in low { print(ast.dump(it)) } }
      return
    }
    if mode == "c" || mode == "ck" {
      if len(errs) == 0 {
        let (st, chunk) = bc.compile_chunk(low)
        if st.err != "" {
          print(st.err)
          return
        }
        let rt = match fs.read(path.join([kdir, "runtime", "kite_rt.c"])) {
          Ok(x) => x,
          Err(_) => "",
        }
        let case_h = match fs.read(path.join([kdir, "runtime", "kite_case.h"])) {
          Ok(x) => x,
          Err(_) => "",
        }
        let rt2 = cgen.first_replace(rt, "#include \"kite_case.h\"\n", case_h)
        if mode == "ck" {
          let (kf, _) = kir.collect(low, cst)
          print(cgen.generate_k(st, chunk, path.base(args[1]), srcs, rt2, kf))
        } else {
          print(cgen.generate(st, chunk, path.base(args[1]), srcs, rt2))
        }
      }
      return
    }
    if mode == "bc" {
      if len(errs) == 0 {
        let (st, chunk) = bc.compile_chunk(low)
        print(join(bc.dump(st, chunk), "\n"))
      }
      return
    }
    for (n, s) in sigs { print("F {n}: {s}") }
  } else {
    match parser.parse(src) {
      Ok(items) => { for it in items { print(ast.dump(it)) } },
      Err(e) => print(e),
    }
  }
}

// ───────── kitec build FILE [PRELUDE] [-o 输出] [--emit-c C 文件] [--no-kir] ─────────
// 和 kite build 相同的流程：类型检查 → 字节码 → KIR → C（cgen.generate_k）→ C 编译器；成功时输出“已生成 …”

fn build(args: List<Str>) -> Int {
  var pos: List<Str> = []
  var out = ""
  var emit = ""
  var use_kir = env.get_or("KITE_NO_KIR", "") != "1"
  var i = 1
  while i < len(args) {
    let a = args[i]
    if a == "-o" && i + 1 < len(args) {
      out = args[i + 1]
      i += 1
    } else if a == "--emit-c" && i + 1 < len(args) {
      emit = args[i + 1]
      i += 1
    } else if a == "--no-kir" {
      use_kir = false
    } else if a == "--no-check" {
      ()
    } else if starts_with(a, "-") || len(pos) >= 2 {
      driver.eprint("未知参数 " + a)
      return 2
    } else {
      pos = push(pos, a)
    }
    i += 1
  }
  let (file, pkgname) = match entry_or(if len(pos) > 0 { pos[0] } else { "" }) {
    Some(f) => f,
    None => { return 1 },
  }
  if out == "" {
    let b = path.base(file)
    out = if pkgname != "" {
      pkgname
    } else if ends_with(b, ".kite") {
      __str_slice(b, 0, len(b) - 5)
    } else {
      b
    }
  }
  let pre = if len(pos) > 1 {
    pos[1]
  } else {
    match driver.prelude_path() {
      Some(p) => p,
      None => { return 1 },
    }
  }
  if let Err(e) = pkg.prepare(file) {
    driver.eprint(file + ": " + e)
    return 1
  }
  driver.compile(file, pre, out, emit, use_kir, false)
}
