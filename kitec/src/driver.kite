// kitec 的编译驱动：找安装目录、读入程序、类型检查 → 字节码 → KIR → C → C 编译器
use std.fs
use std.env
use std.path
use std.process
use ast
use parser
use check
use modules
use bc
use cgen
use kir

// ───────── 找 prelude.kite 和 runtime/：$KITE_HOME，然后可执行文件所在目录往上，最后当前目录往上 ─────────

pub fn is_home(d: Str) -> Bool { fs.exists(path.join([d, "prelude.kite"])) && fs.exists(path.join([d, "runtime", "kite_rt.c"])) }

pub fn up_find(d0: Str) -> Str? {
  var d = d0
  var n = 0
  while d != "" && n < 8 {
    if is_home(d) { return Some(d) }
    let p = path.dir(d)
    if p == d { return None }
    d = p
    n += 1
  }
  None
}

pub fn kite_home() -> Str? {
  if let Some(h) = env.get("KITE_HOME") { if trim(h) != "" && is_home(h) { return Some(h) } }
  let (code, out) = process.run("readlink -f /proc/$PPID/exe 2>/dev/null")
  if code == 0 && trim(out) != "" {
    if let Some(h) = up_find(path.dir(trim(out))) { return Some(h) }
  }
  up_find(__getcwd())
}

pub fn prelude_path() -> Str? {
  match kite_home() {
    Some(h) => Some(path.join([h, "prelude.kite"])),
    None    => {
      eprint("找不到 Kite 安装目录（prelude.kite 和 runtime/）：请设置环境变量 KITE_HOME")
      None
    },
  }
}

// 读入程序和 prelude
pub fn load(file: Str, pre_path: Str) -> Result<((List<ast.Node>, List<Str>), List<ast.Node>), Str> {
  let cwd = __getcwd()
  let kdir = path.dir(if path.is_abs(pre_path) { pre_path } else { path.join([cwd, pre_path]) })
  let r = match modules.load_main_src(modules.new_l(cwd, file, kdir), file) {
    Ok(x)  => x,
    Err(e) => { return Err(if e.ln == -2 { e.msg } else { loc(file, e.ln, modules.strip_lm(e.msg)) }) },
  }
  let pre = match fs.read(pre_path) {
    Ok(x)  => x,
    Err(e) => { return Err("读取失败: {e}") },
  }
  let pits = match parser.parse(pre) {
    Ok(its) => its,
    Err(e)  => { return Err("prelude: " + e) },
  }
  Ok((r, pits))
}

pub fn sq(s: Str) -> Str { "'" + replace(s, "'", "'\\''") + "'" }

pub fn eprint(s: Str) { __eprint(s) }

pub fn has_cmd(c: Str) -> Bool { process.run("command -v " + c + " >/dev/null 2>&1").0 == 0 }

// $CC，然后 cc / clang / gcc，最后 zig cc
pub fn find_cc() -> Str? {
  if let Some(cc) = env.get("CC") { if trim(cc) != "" { return Some(cc) } }
  for c in ["cc", "clang", "gcc"] { if has_cmd(c) { return Some(c) } }
  if has_cmd("zig") { return Some("zig cc -mcpu=baseline") }
  None
}

// 编码过的行号（文件序号 * LINE_BASE + 行）还原成 文件:行（kite.py 的 locate）
pub fn locs(srcs: List<Str>, file: Str, ln: Int, msg: Str) -> Str {
  let i = ln / modules.LINE_BASE
  if ln > 0 && i > 0 && i < len(srcs) { srcs[i] + ":{ln % modules.LINE_BASE}: " + msg } else { loc(file, ln, msg) }
}

// 检查器的警告（@deprecated、没有 .await 的 Future），按行号输出到 stderr
pub fn print_warns(c: check.C, srcs: List<Str>, file: Str) {
  for (ln, msg) in sort(c.warns) { eprint(locs(srcs, file, ln, msg)) }
}

pub fn loc(file: Str, ln: Int, msg: Str) -> Str { if ln > 0 && ln < 1000000 { file + ":{ln}: " + msg } else { file + ": " + msg } }

// 类型检查 → 字节码 → KIR → C（cgen.generate_k）→ C 编译器
pub fn compile(file: Str, pre_path: Str, out: Str, emit: Str, use_kir: Bool, quiet: Bool) -> Int {
  let ((items, srcs), pits) = match load(file, pre_path) {
    Ok(r)  => r,
    Err(m) => {
      eprint(m)
      return 1
    },
  }
  compile_items(file, pre_path, items, srcs, pits, out, emit, use_kir, quiet)
}

// 已经读入的程序 → 可执行文件（kitec test 给程序补上分派测试的 main 后也走这里）
pub fn compile_items(file: Str, pre_path: Str, items: List<ast.Node>, srcs: List<Str>, pits: List<ast.Node>, out: Str, emit: Str, use_kir: Bool, quiet: Bool) -> Int {
  let kdir = path.dir(if path.is_abs(pre_path) { pre_path } else { path.join([__getcwd(), pre_path]) })
  let (errs, _, low, cst) = check.check_c(pits, items)
  print_warns(cst, srcs, file)
  if len(errs) > 0 {
    for (ln, msg) in take(errs, 20) { eprint(locs(srcs, file, ln, modules.strip_lm(msg))) }
    return 1
  }
  let (st, chunk) = bc.compile_chunk(low)
  if st.err != "" {
    eprint(file + ": " + st.err)
    return 1
  }
  let rt = match fs.read(path.join([kdir, "runtime", "kite_rt.c"])) {
    Ok(x)  => x,
    Err(e) => {
      eprint("找不到运行时 runtime/kite_rt.c: {e}")
      return 1
    },
  }
  let case_h = match fs.read(path.join([kdir, "runtime", "kite_case.h"])) {
    Ok(x)  => x,
    Err(_) => "",
  }
  let rt2 = cgen.first_replace(rt, "#include \"kite_case.h\"\n", case_h)
  let kf = if use_kir { kir.collect(low, cst).0 } else { Map() }
  let csrc = cgen.generate_k(st, chunk, path.base(file), srcs, rt2, kf)
  if starts_with(csrc, "N ") {
    eprint(file + ": " + __str_slice(csrc, 2, len(csrc)))
    return 1
  }
  let cpath = if emit != "" { emit } else { out + ".c" }
  match fs.write(cpath, csrc) {
    Ok(_)  => (),
    Err(e) => {
      eprint("写入失败: {e}")
      return 1
    },
  }
  let cc = match find_cc() {
    Some(x) => x,
    None    => {
      eprint("找不到 C 编译器：请安装 clang / gcc / zig；也可设置环境变量 CC")
      return 1
    },
  }
  var libs = ""
  for l in cgen.ext_libs(st) { libs = libs + " -l" + sq(l) }
  let (code, _) = process.run(cc + " -O2 -w -o " + sq(out) + " " + sq(cpath) + " -lm -lpthread" + libs)
  if emit == "" { let _ = fs.remove(cpath) }
  if code != 0 {
    eprint("C 编译失败（原生后端内部错误），退出码 {code}")
    return 1
  }
  if !quiet { print("已生成 " + out) }
  0
}
