// Kite 自举编译器：KIR 的文本形式，与 tools/kir_dump.py 逐字节相同（自举第 3d 步）

use val
use val.{ V }
use kir
use kir.{ A, X, T, In, Bk, KF }
use cgen

fn cs(s: Str) -> Str { cgen.c_str(s) }

fn fstr(x: Float) -> Str {
  if x != x { return "nan" }
  if x > 1.7976931348623157e308 { return "inf" }
  if x < -1.7976931348623157e308 { return "-inf" }
  cgen.float_hex(x)
}

fn av(a: A) -> Str {
  match a {
    R(i, _) => "v{i}",
    CI(i)   => "{i}",
    CF(x)   => fstr(x),
    CB(b)   => if b { "true" } else { "false" },
    CS(s)   => "S" + cs(s),
    CU      => "()",
  }
}

fn rs(f: KF, a: A) -> Str {
  let i = kir.rid(a)
  "v{i}:" + kir.aty(a) + (match get(f.rn, i) {
    Some(n) => ":" + n,
    None    => "",
  })
}

fn xs(f: KF, op: Str, x: X) -> Str {
  match x {
    XN          => "",
    XS(s)       => s,
    XI(i)       => "{i}",
    XR(i, t)    => rs(f, R(i, t)),
    XL(i)       => f.lams[i].name,
    XST(n, fs)  => n + " " + join(fs, ","),
    XP(ps)      => join(map(ps, (p) => if p.0 { cs(p.1) } else { "_" }), ","),
  }
}

fn dump_fn(f: KF, lamf: KF, out0: List<Str>) -> List<Str> {
  var out = out0
  var hdr = "fn " + f.name + " (" + join(map(f.params, (p) => rs(f, p)), ", ") + ") -> " + f.ret
  if f.closure { hdr = hdr + " closure " + f.label + " caps " + join(map(f.caps, (c) => rs(f, c)), " ") }
  hdr = hdr + " npb {f.npb} ndefer {f.ndefer} line {f.line}"
  out = push(out, hdr)
  var i = 0
  for p in f.pats {
    out = push(out, "pat {i} " + val.dump(p))
    i += 1
  }
  for b in f.blocks {
    out = push(out, "b{b.id}:")
    for ins in b.ins {
      let lhs = match ins.d {
        Some(d) => rs(f, d) + " = ",
        None    => "",
      }
      let ex = xs(lamf, ins.op, ins.x)
      let exs = if ins.op == "next" { match ins.x {
        XR(ri, rt) => rs(f, R(ri, rt)),
        _          => ex,
      } } else { ex }
      out = push(out, "  L{ins.ln} " + lhs + ins.op + " " + join(map(ins.args, av), ", ") + (if exs != "" { " | " + exs } else { "" }))
    }
    out = push(out, match b.t {
      TNone              => "  unreachable",
      TUnr               => "  unreachable",
      TBr(x)             => "  br b{x}",
      TCbr(c, x, y)      => "  cbr " + av(c) + ", b{x}, b{y}",
      TRet(None)         => "  ret",
      TRet(Some(v))      => "  ret " + av(v),
      TPanic(m, v, ln)   => "  panic L{ln} " + cs(m) + (match v {
        Some(x) => " " + av(x) + ":" + kir.aty(x),
        None    => "",
      }),
    })
  }
  out
}

pub fn dump(fns: Map<Str, KF>, why: Map<Str, Str>) -> Str {
  var out: List<Str> = []
  for n in sort(keys(fns)) {
    let f = unwrap(get(fns, n))
    out = dump_fn(f, f, out)
    for lf in f.lams { out = dump_fn(lf, f, out) }
  }
  for n in sort(keys(why)) { out = push(out, "why " + n + ": " + unwrap(get(why, n))) }
  join(out, "\n")
}
