// kitec test：发现并运行测试（对应 testing.py；测试编译成原生程序运行）
//
// 约定
// - 测试是顶层的、无参数的、名字以 test_ 开头的函数，或者标了 @test 的函数
// - 在包里不写参数时，扫描 src/ 和 tests/ 下所有 .kite 文件：
//   src/ 里的测试和被测代码在同一个模块，可以测私有函数；
//   tests/ 里的文件用 `use 包名` 引用本包（只能访问 pub 项），也可以引用依赖
// - 也可以直接给文件或目录：kitec test a.kite tests/
// - 断言：assert(条件[, 消息])、assert_eq(左, 右[, 消息])、assert_ne(左, 右[, 消息])、panic(消息)
//
// 每个文件编译一次（补上按 KITE_TEST 环境变量分派测试的 main），每个测试一个进程：测试之间互不影响；
// 测试的输出被捕获，只在失败时显示。
//
// kitec test [过滤词] [文件/目录...] [-v]
//     过滤词     只运行名字（或 “文件::名字”）包含它的测试
//     -v         通过的测试也显示输出
use std.fs
use std.env
use std.path
use std.process
use std.kite.ast as ast
use std.kite.parser as parser
use check
use modules
use driver
use pkg

const USAGE: Str =
  "kitec test [过滤词] [文件/目录...] [-v]\n    过滤词     只运行名字（或 “文件::名字”）包含它的测试\n    -v         通过的测试也显示输出"

fn is_word(c: Str) -> Bool {
  (c >= "a" && c <= "z")
    || (c >= "A" && c <= "Z")
    || (c >= "0" && c <= "9")
    || c == "_"
    || __ord(c) > 127
}

fn is_sp(c: Str) -> Bool { c == " " || c == "\t" || c == "\r" || c == "\x0b" || c == "\x0c" }

// 一行是否形如 `fn test_xxx()` 或 `@test`（testing.py 的 TEST_RE，逐行匹配）
fn test_line(line: Str) -> Bool {
  let cs = chars(line)
  var i = 0
  while i < len(cs) && is_sp(cs[i]) { i += 1 }
  let rest = join(cs[i..], "")
  if starts_with(rest, "@test") { return len(cs) == i + 5 || !is_word(cs[i + 5]) }
  if !starts_with(rest, "fn") { return false }
  var j = i + 2
  if j >= len(cs) || !is_sp(cs[j]) { return false }
  while j < len(cs) && is_sp(cs[j]) { j += 1 }
  if !starts_with(join(cs[j..], ""), "test_") { return false }
  j += 5
  var k = j
  while k < len(cs) && is_word(cs[k]) { k += 1 }
  if k == j { return false }
  while k < len(cs) && is_sp(cs[k]) { k += 1 }
  if k >= len(cs) || cs[k] != "(" { return false }
  k += 1
  while k < len(cs) && is_sp(cs[k]) { k += 1 }
  k < len(cs) && cs[k] == ")"
}

fn walk(d: Str) -> List<Str> {
  let names = match fs.list(d) {
    Ok(xs) => sort(xs),
    Err(_) => [],
  }
  var files: List<Str> = []
  var dirs: List<Str> = []
  for n in names {
    let full = path.join([d, n])
    if fs.is_dir(full) {
      if !starts_with(n, ".") { dirs = push(dirs, full) }
    } else if ends_with(n, ".kite") {
      files = push(files, full)
    }
  }
  for x in dirs { files = files + walk(x) }
  files
}

fn collect_files(targets: List<Str>) -> Result<List<Str>, Str> {
  var files: List<Str> = []
  for t in targets { files = files + (if fs.is_dir(t) { walk(t) } else { [t] }) }
  var out: List<Str> = []
  for f in files {
    let src = match fs.read(f) {
      Ok(s) => s,
      Err(e) => { return Err("无法读取 {f}: {e}") },
    }
    if any(split(src, "\n"), test_line) { out = push(out, f) }
  }
  Ok(out)
}

// 返回测试函数名；@test 函数带参数时报错（行号, 信息）
fn test_names(items: List<ast.Node>) -> Result<List<Str>, (Int, Str)> {
  var out: List<Str> = []
  for it in items {
    match it.k {
      ast.NFn(f) => {
        if contains(f.name, ".") { continue }
        let marked = match it.attrs {
          Some(xs) => any(xs, (a) => a.name == "test"),
          None => false,
        }
        if marked && (len(f.params) > 0 || len(f.gen.names) > 0 || len(f.gen.cgens) > 0) {
          return Err((it.line, "@test 函数 {f.name} 不能有参数或泛型参数"))
        }
        if marked || starts_with(f.name, "test_") && len(f.params) == 0 { out = push(out, f.name) }
      },
      _ => (),
    }
  }
  Ok(out)
}

fn is_main(it: ast.Node) -> Bool {
  match it.k {
    ast.NFn(f) => f.name == "main",
    _ => false,
  }
}

type Outcome = { name: Str, ok: Bool, ns: Int, err: Str, output: Str }

fn pad3(n: Int) -> Str { if n < 10 { "00{n}" } else if n < 100 { "0{n}" } else { "{n}" } }

// 和 Python 的 f"{s * 1000:.1f}ms" / f"{s:.2f}s" 一样的格式（四舍五入）
fn fmt_time(ns: Int) -> Str {
  if ns < 1000000000 {
    let t = (ns + 50000) / 100000
    "{t / 10}.{t % 10}ms"
  } else {
    let t = (ns + 5000000) / 10000000
    let c = t % 100
    "{t / 100}." + (if c < 10 { "0{c}" } else { "{c}" }) + "s"
  }
}

fn indent(s: Str) -> Str {
  var t = s
  while ends_with(t, "\n") { t = __str_slice(t, 0, len(t) - 1) }
  join(map(split(t, "\n"), (l) => "      " + l), "\n")
}

fn read_or(p: Str) -> Str {
  match fs.read(p) {
    Ok(s) => s,
    Err(_) => "",
  }
}

fn safe_name(p: Str) -> Str {
  var out = ""
  for c in chars(p) { out = out + (if is_word(c) && __ord(c) < 128 { c } else { "_" }) }
  out
}

fn run_native(
  items: List<ast.Node>,
  srcs: List<Str>,
  pits: List<ast.Node>,
  names: List<Str>,
  file: Str,
  pre: Str,
  workdir: Str,
) -> Result<List<Outcome>, Str> {
  let branches = join(map(names, (n) => "if t == \"{n}\" \{ {n}() \}"), " else ")
  let extra = match parser.parse("fn main() \{\n  let t = __kite_test()\n  {branches}\n\}\n") {
    Ok(xs) => xs,
    Err(e) => { return Err(e) },
  }
  let items2 = filter(items, (it) => !is_main(it)) + extra
  let exe = path.join([workdir, safe_name(file)])
  let errf = path.join([workdir, "stderr.txt"])
  if driver.compile_items(file, pre, items2, srcs, pits, exe, "", true, true) != 0 {
    return Err("见上面的报错")
  }
  let tmo = if driver.has_cmd("timeout") { "timeout 120 " } else { "" }
  var out: List<Outcome> = []
  for n in names {
    let t0 = __unix_ns()
    let (code, so) = process.run(
      "KITE_TEST=" + driver.sq(n) + " " + tmo + driver.sq(exe) + " 2>" + driver.sq(errf),
    )
    let ns = __unix_ns() - t0
    let el = filter(split(trim(read_or(errf)), "\n"), (l) => l != "")
    let ok = code == 0
    let err = if ok {
      ""
    } else if code == 124 && tmo != "" {
      "超时（120 秒）"
    } else if len(el) > 0 {
      el[len(el) - 1]
    } else {
      "退出码 {code}"
    }
    out = push(out, Outcome { name: n, ok: ok, ns: ns, err: err, output: so })
  }
  Ok(out)
}

pub fn main(args: List<Str>) -> Int {
  var verbose = false
  var rest: List<Str> = []
  for a in args {
    if a == "-v" {
      verbose = true
    } else if a == "-h" || a == "--help" {
      print(USAGE)
      return 0
    } else if a == "--native" || a == "--no-check" {
      ()
    } else if a == "--tree" {
      __eprint("--tree（树遍历解释器）已废弃")
      return 2
    } else {
      rest = push(rest, a)
    }
  }
  var targets = filter(rest, (a) => fs.exists(a))
  let filters = filter(rest, (a) => !fs.exists(a))
  if len(targets) == 0 {
    let root = match pkg.find_root(__getcwd()) {
      Some(r) => r,
      None => {
        __eprint("用法: kite test [过滤词] [文件/目录...]（不在 Kite 包里时需要给出文件）")
        return 2
      },
    }
    let cwd = __getcwd()
    for d in ["src", "tests"] {
      let full = path.join([root, d])
      if fs.is_dir(full) { targets = push(targets, rel(full, cwd)) }
    }
  }
  let files = match collect_files(targets) {
    Ok(x) => x,
    Err(e) => {
      __eprint("错误: {e}")
      return 1
    },
  }
  let pre = match driver.prelude_path() {
    Some(p) => p,
    None => { return 1 },
  }
  let t_start = __unix_ns()
  var passed = 0
  var failed = 0
  var failures: List<Str> = []
  let workdir = path.join([env.get_or("TMPDIR", "/tmp"), "kite_test_{__getpid()}"])
  let _ = fs.mkdir(workdir)
  for p in files {
    if let Err(e) = pkg.prepare(p) {
      print("{p}\n  ✗ {p}: {e}")
      failed += 1
      failures = push(failures, "{p}（加载失败）")
      continue
    }
    let ((items, srcs), pits) = match driver.load(p, pre) {
      Ok(r) => r,
      Err(m) => {
        print("{p}\n  ✗ {m}")
        failed += 1
        failures = push(failures, "{p}（加载失败）")
        continue
      },
    }
    let names0 = match test_names(items) {
      Ok(ns) => ns,
      Err((ln, m)) => {
        print("{p}\n  ✗ " + driver.loc(p, ln, m))
        failed += 1
        failures = push(failures, "{p}（加载失败）")
        continue
      },
    }
    let names = filter(
      names0,
      (n) => len(filters) == 0 || any(filters, (f) => contains(n, f) || contains("{p}::{n}", f)),
    )
    if len(names) == 0 { continue }
    let (errs, _, _, _) = check.check_c(pits, items)
    if len(errs) > 0 {
      print(p)
      for (ln, msg) in take(errs, 10) {
        print("  ✗ " + driver.locs(srcs, p, ln, modules.strip_lm(msg)))
      }
      failed += 1
      failures = push(failures, "{p}（类型检查失败）")
      continue
    }
    print(p)
    let results = match run_native(items, srcs, pits, names, p, pre, workdir) {
      Ok(r) => r,
      Err(e) => {
        print("  ✗ 编译失败: {e}")
        failed += len(names)
        failures = failures + map(names, (n) => "{p}::{n}")
        continue
      },
    }
    for r in results {
      if r.ok {
        passed += 1
        print("  ✓ {r.name} ({fmt_time(r.ns)})")
        if verbose && r.output != "" { print(indent(r.output)) }
      } else {
        failed += 1
        failures = push(failures, "{p}::{r.name}")
        print("  ✗ {r.name} ({fmt_time(r.ns)})")
        print("      {r.err}")
        if r.output != "" {
          print("      ── 输出 ──")
          print(indent(r.output))
        }
      }
    }
  }
  let _ = process.run("rm -rf " + driver.sq(workdir))
  let total = passed + failed
  let secs = __unix_ns() - t_start
  if total == 0 {
    print("没有找到测试（测试是名字以 test_ 开头、没有参数的顶层函数）")
    return 0
  }
  print("")
  if len(failures) > 0 {
    print("失败的测试:")
    for f in failures { print("  {f}") }
  }
  let t = (secs + 5000000) / 10000000
  let c = t % 100
  print(
    "结果: {passed} 通过，{failed} 失败（用时 {t / 100}." + (if c < 10 {
      "0{c}"
    } else {
      "{c}"
    }) + "s）",
  )
  if failed > 0 { 1 } else { 0 }
}

// os.path.relpath(target, base)（两者都是绝对路径）
fn rel(target: Str, base: Str) -> Str {
  let t = filter(split(path.clean(target), "/"), (x) => x != "")
  let b = filter(split(path.clean(base), "/"), (x) => x != "")
  var i = 0
  while i < len(t) && i < len(b) && t[i] == b[i] { i += 1 }
  var parts: List<Str> = []
  for _ in i..len(b) { parts = push(parts, "..") }
  let all_parts = parts + t[i..]
  if len(all_parts) == 0 { "." } else { join(all_parts, "/") }
}
