// Kite 自举编译器：字节码编译器（vm.py 的 FnComp / Compiler 的移植，自举第 3b 步）
// 输入是检查后改写过的语法树（check.check 的第三个结果），输出和 tools/bc_dump.py 逐字节相同
// 指令的操作码直接用名字（Str），操作数用 V：Proto 引用是 VI(创建序号)，输出时换成 {P@序号}；Unit 是 {U@0}

use ast
use val
use val.{ V, sv, iv, items, is_nil }
use ast.{ Node, K, Lit, Nm, Pat, Arm, SArm, MatchD, FnD, kname }
use modules

type Lp = {
  breaks: List<Int>,
  cont: Int,
  depth: Int,
  slot: Int,
  defers: Int,
  label: Str?,
  res: Int,
}

type FC = {
  name: Str,
  np: Int,
  nl: Int,
  code: List<(Str, V)>,
  lines: List<Int>,
  upd: List<V>,
  scopes: List<Map<Str, (Int, Bool)>>,
  ns: Int,
  upn: Map<Str, (Int, Bool)>,
  depth: Int,
  loops: List<Lp>,
  nd: Int,
  ln: Int,
  chunk: Bool,
  par: Bool,
  orb: Map<Str, V>,
  orb_on: Bool,
}

pub type PR = { name: Str, np: Int, nl: Int, code: List<(Str, V)>, lines: List<Int>, upd: List<V> }

// 全局的值（对应 Python VM globals 里的对象种类，原生后端按种类生成初始化代码）
pub enum GV {
  GOther,
  GFn(Int),
  GStruct(V),
  GEnum(V),
  GBuiltin(Str),
  GCtor(Str),
  GEVal(Str, Str),
  GMod(Str),
  GMember(Str),
  GExt(Node, List<Str>?),
}

pub type S = {
  f: FC,
  outer: List<FC>,
  protos: List<PR>,
  gmut: Map<Str, Bool>,
  gord: List<Str>,
  gval: Map<Str, GV>,
  mord: List<Str>,
  mtab: Map<Str, (List<Str>, Map<Str, Int>)>,
  traits: Map<Str, List<Node>>,
  err: Str,
}

const DECLS: List<Str> = ["Fn", "Struct", "Enum", "Trait", "Impl", "Alias", "Use", "Mod"]

// 虚拟机启动时已有的全局（kite.py 的内建函数表，顺序有意义：重新定义的名字保持原来的位置）
const INIT_GLOBALS: Str =
  "print len str __fmt __repeat int float type_of map par_map __race timeout actor tell ask __recover_raw __repanic __restart_log __restart_log_w supervise actor_supervised chan send recv try_recv close __select sleep now_ms filter each reduce fold sum count any all find first last get take skip reverse sort sort_by sort_with zip enumerate push concat contains join split trim upper lower starts_with ends_with replace chars parse_int parse_float remove keys values set Set __set_lit __set_union __set_intersect __set_difference insert union intersect difference is_subset to_list Map min max abs Ok Err Some unwrap unwrap_or is_ok is_err is_some is_none panic assert assert_eq assert_ne __kite_test __env_get __args __exit __run __ord __chr __unix_ms __slice __band __bor __bxor __bnot __shl __shr __str_slice __str_find __tls_server_ctx __tls_accept __tls_client __tls_handshake __tcp_listen __tcp_port __tcp_accept __tcp_connect __tcp_read_line __tcp_read_bytes __tcp_read_all __tcp_write __tcp_flush __tcp_close __byte_len __bytes __from_bytes __eprint __fs_stat __getcwd __chdir __chmod __env_set __env_unset __environ __hostname __getpid __read_bytes __write_bytes __tz_offset __random_bytes __unix_ns None Result Option"

fn new_fc(name: Str, np: Int, chunk: Bool, par: Bool) -> FC {
  FC {
    name: name,
    np: np,
    nl: 0,
    code: [],
    lines: [],
    upd: [],
    scopes: [],
    ns: 0,
    upn: Map(),
    depth: 0,
    loops: [],
    nd: 0,
    ln: 0,
    chunk: chunk,
    par: par,
    orb: Map(),
    orb_on: false,
  }
}

fn new_s() -> S {
  var gval: Map<Str, GV> = Map()
  let names = split(INIT_GLOBALS, " ")
  for n in names { gval = set(gval, n, GBuiltin(n)) }
  gval = set(gval, "None", GEVal("Option", "None"))
  gval = set(gval, "Result", GEnum(VL([VT([VS("Ok"), VNil]), VT([VS("Err"), VNil])])))
  gval = set(gval, "Option", GEnum(VL([VT([VS("Some"), VNil]), VT([VS("None"), VNil])])))
  S {
    f: new_fc("<main>", 0, true, false),
    outer: [],
    protos: [],
    gmut: Map(),
    gord: names,
    gval: gval,
    mord: [],
    mtab: Map(),
    traits: Map(),
    err: "",
  }
}

fn fail(s: S, ln: Int, msg: Str) -> S {
  if s.err == "" { S { err: "C {ln} " + msg, ..s } } else { s }
}

fn lset<T>(xs: List<T>, i: Int, v: T) -> List<T> { take(xs, i) + [v] + skip(xs, i + 1) }

fn gset(s: S, name: Str, v: GV) -> S {
  let ord = if contains(s.gval, name) { s.gord } else { push(s.gord, name) }
  S { gord: ord, gval: set(s.gval, name, v), ..s }
}

fn setln(s: S, ln: Int) -> S { S { f: FC { ln: ln, ..s.f }, ..s } }

// ───────── 发射 ─────────

fn em(s: S, op: Str, arg: V, eff: Int) -> S {
  let f = s.f
  S {
    f: FC { code: push(f.code, (op, arg)), lines: push(f.lines, f.ln), depth: f.depth + eff, ..f },
    ..s
  }
}

fn emi(s: S, op: Str, arg: V, eff: Int) -> (S, Int) { (em(s, op, arg, eff), len(s.f.code)) }

fn here(s: S) -> Int { len(s.f.code) }

fn patch(s: S, i: Int, target: Int) -> S {
  let f = s.f
  let (op, arg) = f.code[i]
  let t = if target < 0 { len(f.code) } else { target }
  let na = if op == "FOR_NEXT" { VT([items(arg)[0], VI(t)]) } else { VI(t) }
  S { f: FC { code: lset(f.code, i, (op, na)), ..f }, ..s }
}

fn dec_depth(s: S) -> S { S { f: FC { depth: s.f.depth - 1, ..s.f }, ..s } }

// ───────── 作用域 ─────────

fn push_scope(s: S) -> (S, Int, Int) {
  let f = s.f
  (S { f: FC { scopes: push(f.scopes, Map()), ..f }, ..s }, f.ns, f.nd)
}

fn pop_scope(s0: S, base: Int, dbase: Int, close: Bool) -> S {
  var s = S { f: FC { scopes: take(s0.f.scopes, len(s0.f.scopes) - 1), ..s0.f }, ..s0 }
  if s.f.nd > dbase { s = em(s, "RUN_DEFERS", VI(dbase), 0) }
  if close && s.f.ns > base { s = em(s, "CLOSE", VI(base), 0) }
  S { f: FC { ns: base, nd: dbase, ..s.f }, ..s }
}

fn drop_scope(s: S, base: Int) -> S {
  S { f: FC { scopes: take(s.f.scopes, len(s.f.scopes) - 1), ns: base, ..s.f }, ..s }
}

fn alloc(s: S) -> (S, Int) {
  let f = s.f
  let n = f.ns
  (S { f: FC { ns: n + 1, nl: max(f.nl, n + 1), ..f }, ..s }, n)
}

fn declare(s0: S, name: Str, m: Bool) -> (S, Int) {
  let (s, slot) = alloc(s0)
  let f = s.f
  let k = len(f.scopes) - 1
  (S { f: FC { scopes: lset(f.scopes, k, set(f.scopes[k], name, (slot, m))), ..f }, ..s }, slot)
}

// 名字解析：0 局部槽位 / 1 upvalue / 2 全局
fn res_at(all: List<FC>, i: Int, name: Str, gmut: Map<Str, Bool>) -> (List<FC>, Int, Int, Bool) {
  let fc = all[i]
  var j = len(fc.scopes) - 1
  while j >= 0 {
    if let Some((slot, m)) = get(fc.scopes[j], name) { return (all, 0, slot, m) }
    j -= 1
  }
  if let Some((u, m)) = get(fc.upn, name) { return (all, 1, u, m) }
  if fc.par && i > 0 {
    let (all2, k, slot, m) = res_at(all, i - 1, name, gmut)
    if k < 2 {
      let f2 = all2[i]
      let idx = len(f2.upd)
      let f3 = FC {
        upd: push(f2.upd, VT([VB(k == 0), VI(slot)])),
        upn: set(f2.upn, name, (idx, m)),
        ..f2
      }
      return (lset(all2, i, f3), 1, idx, m)
    }
  }
  (all, 2, 0, unwrap_or(get(gmut, name), false))
}

fn resolve(s: S, name: Str) -> (S, Int, V, Bool) {
  let all = push(s.outer, s.f)
  let n = len(all)
  let (all2, k, slot, m) = res_at(all, n - 1, name, s.gmut)
  let s2 = S { f: all2[n - 1], outer: take(all2, n - 1), ..s }
  (s2, k, if k == 2 { VS(name) } else { VI(slot) }, m)
}

fn load(s0: S, name: Str) -> S {
  let (s, k, a, _) = resolve(s0, name)
  em(s, if k == 0 { "LOAD_L" } else if k == 1 { "LOAD_U" } else { "LOAD_G" }, a, 1)
}

fn store(s0: S, name: Str, ln: Int) -> S {
  let (s, k, a, m) = resolve(s0, name)
  if !m { return fail(s, ln, "编译错误: 不能给不可变绑定 `{name}` 赋值（用 var 声明）") }
  em(s, if k == 0 { "STORE_L" } else if k == 1 { "STORE_U" } else { "STORE_G" }, a, -1)
}

fn bind_target(s: S, name: Str, m: Bool) -> (S, V) {
  if s.f.chunk && len(s.f.scopes) == 0 {
    return (S { gmut: set(s.gmut, name, m), ..s }, VT([VS("gbind"), VS(name)]))
  }
  let (s2, slot) = declare(s, name, m)
  (s2, VT([VS("bind"), VI(slot)]))
}

// ───────── 模式 ─────────

fn cpats(s0: S, ps: List<Pat>, m: Bool) -> (S, List<V>) {
  var s = s0
  var out: List<V> = []
  for p in ps {
    let (s2, q) = cpat(s, p, m)
    s = s2
    out = push(out, q)
  }
  (s, out)
}

fn cbind(s0: S, nm: Str, m: Bool) -> (S, V) {
  if !s0.f.orb_on { return bind_target(s0, nm, m) }
  if let Some(t) = get(s0.f.orb, nm) { return (s0, t) }
  let (s1, t) = bind_target(s0, nm, m)
  (S { f: FC { orb: set(s1.f.orb, nm, t), ..s1.f }, ..s1 }, t)
}

// 模式编译成 MATCH / TEST_PAT 的操作数（和 Python 版 FnComp.cpat 一样的元组）
fn cpat(s0: S, p: Pat, mutable: Bool) -> (S, V) {
  match p {
    PBind(n) => cbind(s0, ast.nm_str(n), mutable),
    PVar(n) => cbind(s0, ast.nm_str(n), true),
    PAt(a, b) => {
      let (s1, x) = cpat(s0, a, mutable)
      let (s2, y) = cpat(s1, b, mutable)
      (s2, VT([VS("at"), x, y]))
    },
    POr(xs) => {
      let saved = s0.f.orb_on
      var s = s0
      if !saved { s = S { f: FC { orb_on: true, orb: Map(), ..s.f }, ..s } }
      let (s1, alts) = cpats(s, xs, mutable)
      var s2 = s1
      if !saved { s2 = S { f: FC { orb_on: false, orb: Map(), ..s2.f }, ..s2 } }
      (s2, VT([VS("or"), VL(alts)]))
    },
    PTuple(xs) => {
      let (s1, ys) = cpats(s0, xs, mutable)
      (s1, VT([VS("tuple"), VL(ys)]))
    },
    PList(pre_, rest, post) => {
      var s = s0
      var r = VNil
      if let Some(rn) = rest {
        if rn == "_" {
          r = VT([VS("wild")])
        } else {
          let (s1, t) = bind_target(s, rn, mutable)
          s = s1
          r = t
        }
      }
      let (s2, pre) = cpats(s, pre_, mutable)
      if len(post) > 0 {
        let (s3, pst) = cpats(s2, post, mutable)
        return (s3, VT([VS("list"), VL(pre), r, VL(pst)]))
      }
      (s2, VT([VS("list"), VL(pre), r]))
    },
    PVariant(n, subs) => match subs {
      None => (s0, VT([VS("variant"), ast.nm_v(n), VNil])),
      Some(xs) => {
        let (s1, ys) = cpats(s0, xs, mutable)
        (s1, VT([VS("variant"), ast.nm_v(n), VL(ys)]))
      },
    },
    PStruct(n, fs) => {
      var s = s0
      var out: List<V> = []
      for fp in fs {
        let (s1, q) = cpat(s, fp.1, mutable)
        s = s1
        out = push(out, VT([VS(fp.0), q]))
      }
      (s, VT([VS("struct"), ast.nm_v(n), VL(out)]))
    },
    _ => (s0, ast.pat_v(p)),
  }
}

// ───────── 函数 ─────────

fn compile_fn(s0: S, name: Str, params: List<(Str, ast.TyX?)>, body: Node, par: Bool) -> (S, Int) {
  var fc = new_fc(name, len(params), false, par)
  fc = FC { ln: body.line, scopes: [Map()], ..fc }
  var s = S { f: fc, outer: push(s0.outer, s0.f), ..s0 }
  for p in params {
    let (s1, _) = declare(s, p.0, false)
    s = s1
  }
  if kname(body) == "Block" { s = block(s, body, false) } else { s = expr(s, body) }
  s = em(s, "RET", VNil, -1)
  let f = s.f
  let idx = len(s.protos)
  let pr = PR { name: f.name, np: f.np, nl: f.nl, code: f.code, lines: f.lines, upd: f.upd }
  (
    S {
      f: s.outer[len(s.outer) - 1],
      outer: take(s.outer, len(s.outer) - 1),
      protos: push(s.protos, pr),
      ..s
    },
    idx,
  )
}

fn fnd(n: Node) -> FnD {
  match n.k {
    NFn(f) => f,
    _ => FnD {
      name: "",
      params: [],
      ret: None,
      body: None,
      gen: ast.no_gen(),
      is_async: false,
      is_unsafe: false,
      varargs: false,
      ext: None,
      cname: None,
      x: ast.no_fnx(),
    },
  }
}

fn is_decl(x: Node) -> Bool { contains(DECLS, kname(x)) }

// ───────── 块与语句 ─────────

fn hoist(s0: S, stmts: List<Node>) -> S {
  let decls = filter(stmts, is_decl)
  if len(decls) == 0 { return s0 }
  var s = declare_types(s0, decls)
  let fns = filter(decls, (x) => kname(x) == "Fn" && is_some(fnd(x).body))
  if s.f.chunk && len(s.f.scopes) == 0 { return s }
  var slots: List<(Node, Int)> = []
  for fnv in fns {
    let (s1, slot) = declare(s, fnd(fnv).name, false)
    s = s1
    slots = push(slots, (fnv, slot))
  }
  for (fnv, slot) in slots {
    s = setln(s, fnv.line)
    let f = fnd(fnv)
    let (s2, pi) = compile_fn(s, f.name, f.params, unwrap(f.body), true)
    s = em(em(s2, "CLOSURE", VI(pi), 1), "STORE_L", VI(slot), -1)
  }
  s
}

fn stmts_of(b: Node) -> List<Node> {
  match b.k {
    NBlock(ss, _) => ss,
    _ => [],
  }
}

fn block(s0: S, b: Node, close: Bool) -> S {
  let (s1, base, dbase) = push_scope(s0)
  let stmts = stmts_of(b)
  var s = hoist(s1, stmts)
  let body = filter(stmts, (x) => !is_decl(x))
  if len(body) == 0 { s = em(s, "CONST", unit_v(), 1) }
  var i = 0
  for st in body {
    let last = i == len(body) - 1
    if let NExprStmt(e) = st.k {
      s = expr(s, e)
      if !last { s = em(s, "POP", VNil, -1) }
    } else {
      s = stmt(s, st)
      if last { s = em(s, "CONST", unit_v(), 1) }
    }
    i += 1
  }
  pop_scope(s, base, dbase, close)
}

fn unit_v() -> V { VN("U", 0, Map()) }

fn new_loop(s: S, cont: Int, slot: Int, label: Str?, res: Int) -> Lp {
  Lp {
    breaks: [],
    cont: cont,
    depth: s.f.depth,
    slot: slot,
    defers: s.f.nd,
    label: label,
    res: res,
  }
}

fn push_loop(s: S, lp: Lp) -> S { S { f: FC { loops: push(s.f.loops, lp), ..s.f }, ..s } }

fn pop_loop(s: S) -> (S, Lp) {
  let ls = s.f.loops
  (S { f: FC { loops: take(ls, len(ls) - 1), ..s.f }, ..s }, ls[len(ls) - 1])
}

fn patch_all(s0: S, js: List<Int>) -> S {
  var s = s0
  for j in js { s = patch(s, j, -1) }
  s
}

fn stmt(s0: S, st: Node) -> S {
  let ln = st.line
  var s = setln(s0, ln)
  match st.k {
    NExprStmt(e) => { return em(expr(s, e), "POP", VNil, -1) },
    NLet(pat, mt, _, value, _) => {
      s = expr(s, value)
      if let PBind(n) = pat {
        let (s1, t) = bind_target(s, ast.nm_str(n), mt)
        let tx = items(t)
        return if sv(tx[0]) == "gbind" {
          em(s1, "DEF_G", tx[1], -1)
        } else {
          em(s1, "STORE_L", tx[1], -1)
        }
      }
      if let PVar(n) = pat {
        let (s1, t) = bind_target(s, ast.nm_str(n), mt)
        let tx = items(t)
        return if sv(tx[0]) == "gbind" {
          em(s1, "DEF_G", tx[1], -1)
        } else {
          em(s1, "STORE_L", tx[1], -1)
        }
      }
      let (s2, cp) = cpat(s, pat, mt)
      return em(s2, "MATCH_OR_FAIL", cp, -1)
    },
    NAssign(..) => { return assign(s, st) },
    NReturn(v) => {
      s = match v {
        None => em(s, "CONST", unit_v(), 1),
        Some(x) => expr(s, x),
      }
      return em(s, "RET", VNil, -1)
    },
    NBreak(lab, val, _) => { return brk(s, ln, true, lab, val) },
    NContinue(lab) => { return brk(s, ln, false, lab, None) },
    NWhile(cond, body) => {
      let top = here(s)
      var exit_j = -1
      if let Some(cd) = cond {
        let (s1, j) = emi(expr(s, cd), "JIF", VNil, -1)
        s = s1
        exit_j = j
      }
      s = push_loop(s, new_loop(s, top, s.f.ns, st.label, -1))
      s = em(block(s, body, true), "POP", VNil, -1)
      let (s2, lp) = pop_loop(s)
      s = em(s2, "JUMP", VI(top), 0)
      if exit_j >= 0 { s = patch(s, exit_j, -1) }
      return patch_all(s, lp.breaks)
    },
    NFor(pat, iter, body) => {
      let (s1, base, dbase) = push_scope(s)
      let (s2, it_slot) = alloc(s1)
      s = em(expr(s2, iter), "ITER", VI(it_slot), -1)
      let top = here(s)
      let (s3, nxt) = emi(s, "FOR_NEXT", VT([VI(it_slot), VNil]), 1)
      let (s4, ibase, idb) = push_scope(s3)
      let (s5, cp) = cpat(s4, pat, false)
      s = em(s5, "MATCH_OR_FAIL", cp, -1)
      s = push_loop(s, new_loop(s, top, ibase, st.label, -1))
      s = em(block(s, body, true), "POP", VNil, -1)
      let (s6, lp) = pop_loop(s)
      s = pop_scope(s6, ibase, idb, true)
      s = em(s, "JUMP", VI(top), 0)
      s = patch(s, nxt, -1)
      s = patch_all(s, lp.breaks)
      return pop_scope(s, base, dbase, true)
    },
    NDefer(b) => {
      let (s1, pi) = compile_fn(s, "<defer>", [], b, true)
      s = em(em(s1, "CLOSURE", VI(pi), 1), "DEFER", VNil, -1)
      return S { f: FC { nd: s.f.nd + 1, ..s.f }, ..s }
    },
    _ => (),
  }
  if is_decl(st) { return s }
  fail(s, ln, "编译错误: 未知语句 {kname(st)}")
}

fn brk(s0: S, ln: Int, is_break: Bool, lab: Str?, val: Node?) -> S {
  var s = s0
  let k = if is_break { "break" } else { "continue" }
  if len(s.f.loops) == 0 { return fail(s, ln, "编译错误: " + k + " 只能出现在循环里") }
  var li = len(s.f.loops) - 1
  if let Some(lb) = lab {
    while li >= 0 && !(is_some(s.f.loops[li].label) && unwrap(s.f.loops[li].label) == lb) {
      li -= 1
    }
    if li < 0 { return fail(s, ln, "编译错误: 找不到循环标签 '{lb}") }
  }
  let lp = s.f.loops[li]
  if is_break && lp.res >= 0 {
    s = match val {
      None => em(s, "CONST", unit_v(), 1),
      Some(v) => expr(s, v),
    }
    s = em(s, "STORE_L", VI(lp.res), -1)
  } else if is_some(val) {
    return fail(s, ln, "编译错误: 只有 loop 的 break 能带值")
  }
  let extra = s.f.depth - lp.depth
  if extra != 0 { s = em(s, "POPN", VI(extra), 0) }
  if s.f.nd > lp.defers { s = em(s, "RUN_DEFERS", VI(lp.defers), 0) }
  s = em(s, "CLOSE", VI(lp.slot), 0)
  if is_break {
    let (s3, j) = emi(s, "JUMP", VNil, 0)
    let lp2 = s3.f.loops[li]
    return S {
      f: FC { loops: lset(s3.f.loops, li, Lp { breaks: push(lp2.breaks, j), ..lp2 }), ..s3.f },
      ..s3
    }
  }
  em(s, "JUMP", VI(lp.cont), 0)
}

fn assign(s0: S, st: Node) -> S {
  let ln = st.line
  let (t, op, value) = match st.k {
    NAssign(a, b, c) => (a, b, c),
    _ => { return s0 },
  }
  var root = t
  var go = true
  while go {
    match root.k {
      NField(o, _) => { root = o },
      NIndex(o, _) => { root = o },
      _ => { go = false },
    }
  }
  let rn = match root.k {
    NName(x) => x,
    _ => { return fail(s0, ln, "编译错误: 赋值目标无效") },
  }
  let (s, _, _, m) = resolve(s0, rn)
  if !m { return fail(s, ln, "编译错误: 不能修改不可变绑定 `{rn}`（用 var 声明）") }
  let leaf = (x: S) => {
    if op == "=" {
      expr(x, value)
    } else {
      em(expr(expr(x, t), value), binop(__str_slice(op, 0, 1)), VNil, -1)
    }
  }
  update(s, t, leaf, ln)
}

fn update(s: S, node: Node, produce: fn(S) -> S, ln: Int) -> S {
  match node.k {
    NName(n) => store(produce(s), n, ln),
    NField(o, f) => {
      let p2 = (x: S) => em(produce(expr(x, o)), "WFIELD", ast.nm_v(f), -1)
      update(s, o, p2, ln)
    },
    NIndex(o, i) => {
      let p3 = (x: S) => em(produce(expr(expr(x, o), i)), "WINDEX", VNil, -2)
      update(s, o, p3, ln)
    },
    _ => s,
  }
}

fn binop(op: Str) -> Str {
  match op {
    "+" => "ADD",
    "-" => "SUB",
    "*" => "MUL",
    "/" => "DIV",
    "%" => "MOD",
    "<" => "LT",
    ">" => "GT",
    "<=" => "LE",
    ">=" => "GE",
    "==" => "EQ",
    "!=" => "NE",
    ".." => "RANGE",
    "..=" => "RANGE_INC",
    _ => "?" + op,
  }
}

// ───────── 表达式（每个表达式恰好压入一个值）─────────

fn exprs(s0: S, xs: List<Node>) -> S {
  var s = s0
  for x in xs { s = expr(s, x) }
  s
}

fn expr(s0: S, e: Node) -> S {
  let ln = e.line
  var s = setln(s0, ln)
  match e.k {
    NLit(l) => em(s, "CONST", ast.lit_v(l), 1),
    NName(n) => load(s, n),
    NInterp(ps) => {
      for p in ps {
        s = match p {
          IStr(x) => em(s, "CONST", VS(x), 1),
          IExpr(x) => expr(s, x),
        }
      }
      em(s, "INTERP", VI(len(ps)), 1 - len(ps))
    },
    NBin(op, l, r) => {
      if op == "&&" || op == "||" {
        let (s1, j) = emi(
          expr(s, l),
          if op == "&&" { "JIF_OR_POP" } else { "JIT_OR_POP" },
          VNil,
          -1,
        )
        return patch(expr_o(s1, r), j, -1)
      }
      s = expr_o(expr(s, l), r)
      em(setln(s, ln), binop(op), VNil, -1)
    },
    NUnary(op, x, _) => em(expr(s, x), if op == "-" { "NEG" } else { "NOT" }, VNil, 0),
    NTuple(xs) => {
      s = exprs(s, xs)
      if len(xs) > 0 { em(s, "TUPLE", VI(len(xs)), 1 - len(xs)) } else { em(s, "TUPLE", VI(0), 1) }
    },
    NList(xs) => em(exprs(s, xs), "LIST", VI(len(xs)), 1 - len(xs)),
    NBlock(..) => block(s, e, true),
    NLoop(body, lab) => {
      let (s1, base, dbase) = push_scope(s)
      let (s2, rs) = alloc(s1)
      let top = here(s2)
      s = push_loop(s2, new_loop(s2, top, s2.f.ns, lab, rs))
      s = em(block(s, body, true), "POP", VNil, -1)
      let (s3, lp) = pop_loop(s)
      s = patch_all(em(s3, "JUMP", VI(top), 0), lp.breaks)
      s = em(s, "LOAD_L", VI(rs), 1)
      pop_scope(s, base, dbase, true)
    },
    NIf(cond, thn, els) => {
      let (s1, j) = emi(expr(s, cond), "JIF", VNil, -1)
      let (s2, end) = emi(block(s1, thn, true), "JUMP", VNil, 0)
      s = dec_depth(patch(s2, j, -1))
      s = match els {
        None => em(s, "CONST", unit_v(), 1),
        Some(x) => expr(s, x),
      }
      patch(s, end, -1)
    },
    NMatch(m) => match_e(s, e, m),
    NIs(v, p) => {
      s = expr(s, v)
      let (s1, base, _) = push_scope(s)
      let (s2, cp) = cpat(s1, p, false)
      drop_scope(em(s2, "TEST_PAT", cp, 0), base)
    },
    NLambda(ps, body, _) => {
      let (s1, pi) = compile_fn(s, "<lambda>", ps, body, true)
      em(s1, "CLOSURE", VI(pi), 1)
    },
    NCall(f, args) => call(s, f, args, -1, ln),
    NPipe(l, r) => {
      let pushed = len(s.f.scopes) == 0
      if pushed { s = S { f: FC { scopes: [Map()], ..s.f }, ..s } }
      let (s1, tmp) = alloc(s)
      s = em(expr(s1, l), "STORE_L", VI(tmp), -1)
      s = match r.k {
        NCall(rf, ra) => call(s, rf, ra, tmp, ln),
        _ => call(s, r, [], tmp, ln),
      }
      if pushed { s = S { f: FC { scopes: [], ..s.f }, ..s } }
      s
    },
    NField(o, f) => em(setln(expr(s, o), ln), "FIELD", ast.nm_v(f), 0),
    NTupleIndex(o, i) => em(expr(s, o), "TIDX", ast.lit_v(i), 0),
    NIndex(o, i) => em(setln(expr(expr(s, o), i), ln), "INDEX", VNil, -1),
    NTry(v) => em(setln(expr(s, v), ln), "TRY", VNil, 0),
    NStructLit(n, fs, _) => {
      for fx in fs { s = expr(s, fx.1) }
      em(setln(s, ln), "STRUCT", VT([ast.nm_v(n), VT(map(fs, (fx) => VS(fx.0)))]), 1 - len(fs))
    },
    NSelect(_) => expr(s, lower_select(e)),
    NRace(xs) => {
      s = em(setln(s, ln), "LOAD_G", VS("__race"), 1)
      for x in xs {
        let (s1, pi) = compile_fn(s, "<race>", [], x, true)
        s = em(s1, "CLOSURE", VI(pi), 1)
      }
      em(em(s, "LIST", VI(len(xs)), 1 - len(xs)), "CALL", VI(1), -1)
    },
    NSpawn(xs) => {
      for x in xs {
        let (s1, pi) = compile_fn(s, "<spawn>", [], x, true)
        s = em(s1, "CLOSURE", VI(pi), 1)
      }
      em(setln(s, ln), "SPAWN", VI(len(xs)), 1 - len(xs))
    },
    NAwait(v) => expr(s, v),
    _ => fail(s, ln, "编译错误: 未知表达式 {kname(e)}"),
  }
}

// Bin 的右边缺省（开区间切片）时 Python 版 expr(None) 会出错：这里按未知表达式处理
fn expr_o(s: S, x: Node?) -> S {
  match x {
    Some(n) => expr(s, n),
    None => fail(s, 0, "编译错误: 未知表达式 "),
  }
}

fn call(s0: S, fnode: Node, args: List<Node>, pre: Int, ln: Int) -> S {
  let n = len(args) + (if pre >= 0 { 1 } else { 0 })
  var s = s0
  if let NField(o, f) = fnode.k {
    s = expr(s, o)
    if pre >= 0 { s = em(s, "LOAD_L", VI(pre), 1) }
    s = exprs(s, args)
    return em(setln(s, ln), "CALL_M", VT([ast.nm_v(f), VI(n)]), -n)
  }
  s = expr(s, fnode)
  if pre >= 0 { s = em(s, "LOAD_L", VI(pre), 1) }
  s = exprs(s, args)
  em(setln(s, ln), "CALL", VI(n), -n)
}

fn match_e(s0: S, e: Node, m: MatchD) -> S {
  let (s1, base, _) = push_scope(s0)
  let (s2, subj) = alloc(s1)
  var s = em(expr(s2, m.subject), "STORE_L", VI(subj), -1)
  var ends: List<Int> = []
  for a in m.arms {
    let (s3, abase, adb) = push_scope(s)
    let (s4, cp) = cpat(em(s3, "LOAD_L", VI(subj), 1), a.pat, false)
    let (s5, nxt) = emi(em(s4, "TEST_PAT", cp, 0), "JIF", VNil, -1)
    s = s5
    var nxt2 = -1
    if let Some(g) = a.guard {
      let (s6, j) = emi(expr(s, g), "JIF", VNil, -1)
      s = s6
      nxt2 = j
    }
    s = pop_scope(expr(s, a.body), abase, adb, true)
    let (s7, ej) = emi(s, "JUMP", VNil, 0)
    ends = push(ends, ej)
    s = patch(dec_depth(s7), nxt, -1)
    if nxt2 >= 0 { s = patch(s, nxt2, -1) }
  }
  s = em(em(setln(s, e.line), "LOAD_L", VI(subj), 1), "MATCH_FAIL", VNil, 0)
  drop_scope(patch_all(s, ends), base)
}

fn mk(ln: Int, k: K) -> Node { ast.mkn(ln, k) }

fn ilit(ln: Int, i: Int) -> Node { mk(ln, NLit(LInt(i))) }

// select 改写成 __select 调用 + match（kite.py 的 lower_select）
pub fn lower_select(e: Node) -> Node {
  let ln = e.line
  let sarms = match e.k {
    NSelect(a) => a,
    _ => [],
  }
  var ops: List<Node> = []
  var arms: List<Arm> = []
  var timeout = ilit(ln, -1)
  var has_default = false
  var ci = 0
  var extra: Node? = None
  let blk = (x: Node) => mk(ln, NBlock([mk(ln, NExprStmt(x))], false))
  for ax in sarms {
    let kd = ax.kind
    if kd == "recv" || kd == "send" {
      var kn = ilit(ln, if kd == "recv" { 0 } else { 1 })
      if let Some(g) = ax.guard { kn = mk(ln, NIf(g, blk(kn), Some(blk(ilit(ln, -1))))) }
      ops = push(ops, mk(ln, NTuple([kn, unwrap(ax.a), unwrap_or(ax.b, mk(ln, NTuple([])))])))
      arms = push(arms, Arm {
        pat: PTuple([PLit(LInt(ci)), unwrap_or(ax.pat, PWild)]),
        guard: None,
        body: ax.body,
      })
      ci += 1
    } else {
      extra = Some(ax.body)
      if kd == "after" { timeout = unwrap(ax.a) } else { has_default = true }
    }
  }
  if let Some(x) = extra { arms = push(arms, Arm { pat: PWild, guard: None, body: x }) }
  let callv = mk(ln, NCall(mk(ln, NName("__select")), [
    mk(ln, NList(ops)),
    timeout,
    mk(ln, NLit(LBool(has_default))),
  ]))
  mk(ln, NMatch(MatchD { subject: callv, arms: arms, is_conj: None, let_else: None }))
}

// ───────── 声明（Compiler.declare_types）─────────

fn ev_names(vf: ast.EvF) -> List<(Str, ast.TyX)> {
  match vf {
    EvList(l) => l,
    EvRec(l) => l,
    EvNone => [],
  }
}

fn ev_v(vf: ast.EvF) -> V {
  match vf {
    EvNone => VNil,
    EvList(l) => VL(map(l, (f) => VT([VS(f.0), ast.ty_v(f.1)]))),
    EvRec(l) => VR(map(l, (f) => VT([VS(f.0), ast.ty_v(f.1)]))),
  }
}

fn use_src(e: (Str, Str?)) -> Str { e.0 }

fn use_bind(e: (Str, Str?)) -> Str { unwrap_or(e.1, e.0) }

fn up_s(u: ast.UseP) -> Str {
  match u {
    UName(s) => s,
    UGroup(_) => "",
  }
}

fn declare_types(s0: S, decls: List<Node>) -> S {
  var s = s0
  let top = s.f.chunk && len(s.f.scopes) == 0
  for it in decls {
    match it.k {
      NStruct(name, fs, _) => { s = gset(s, name, GStruct(VL(map(fs, (f) => VS(f.0))))) },
      NEnum(name, vs, _) => {
        for v in vs {
          let vn = v.0
          s = gset(s, vn, if len(ev_names(v.1)) > 0 { GCtor(vn) } else { GEVal(name, vn) })
        }
        s = gset(s, name, GEnum(VL(map(vs, (v) => VT([VS(v.0), ev_v(v.1)])))))
      },
      NTrait(t) => { s = S { traits: set(s.traits, t.name, t.methods), ..s } },
      NUse(p, alias) => {
        if len(p) >= 2 && up_s(p[0]) == "std" {
          match p[1] {
            UGroup(es) => { for e2 in es { s = gset(s, use_bind(e2), GMod(use_src(e2))) } },
            UName(p1) => {
              if len(p) == 2 {
                s = gset(s, unwrap_or(alias, p1), GMod(p1))
              } else {
                match p[2] {
                  UGroup(es) => {
                    for e2 in es { s = gset(s, use_bind(e2), GMember(use_src(e2))) }
                  },
                  UName(p2) => {
                    if p2 == "*" {
                      s = fail(s, it.line, "UNSUP use std.{p1}.*")
                    } else {
                      s = gset(s, unwrap_or(alias, p2), GMember(p2))
                    }
                  },
                }
              }
            },
          }
        }
      },
      _ => (),
    }
  }
  for it in decls {
    match it.k {
      NFn(f) => {
        if is_some(f.body) && top {
          s = setln(s, it.line)
          let (s1, pi) = compile_fn(s, f.name, f.params, unwrap(f.body), false)
          s = gset(s1, f.name, GFn(pi))
        } else if is_some(f.ext) && top {
          if !f.varargs { s = gset(s, f.name, GExt(it, None)) }
          for va in f.x.va { s = gset(s, va.0, GExt(it, Some(va.1))) }
        }
      },
      NImpl(d) => {
        let target = d.target
        var ms = d.methods
        let own = map(ms, (m) => fnd(m).name)
        if let Some(tr) = d.tr {
          if let Some(tms) = get(s.traits, ast.bound_name(tr)) {
            ms = ms + filter(tms, (m) => is_some(fnd(m).body) && !contains(own, fnd(m).name))
          }
        }
        for m in ms {
          let mf = fnd(m)
          let (s2, pi) = compile_fn(s, mf.name, mf.params, unwrap(mf.body), false)
          s = s2
          let (mo, mt) = unwrap_or(get(s.mtab, target), ([], Map()))
          let mname = mf.name
          let mo2 = if contains(mt, mname) { mo } else { push(mo, mname) }
          let mord = if contains(s.mtab, target) { s.mord } else { push(s.mord, target) }
          s = S { mtab: set(s.mtab, target, (mo2, set(mt, mname, pi))), mord: mord, ..s }
        }
      },
      _ => (),
    }
  }
  s
}

// ───────── 入口（Compiler.compile_chunk）─────────

pub fn compile_chunk(its: List<Node>) -> (S, Int) {
  var s = new_s()
  for st in its {
    if let NLet(p, mt, _, _, _) = st.k {
      if mt { for nm in modules.pat_binds(p) { s = S { gmut: set(s.gmut, nm, true), ..s } } }
    }
  }
  s = hoist(s, its)
  let body = filter(its, (x) => !is_decl(x))
  var i = 0
  for st in body {
    let last = i == len(body) - 1
    var done = false
    if last {
      if let NExprStmt(e) = st.k {
        s = expr(s, e)
        done = true
      }
    }
    if !done {
      s = stmt(s, st)
      if last { s = em(s, "CONST", unit_v(), 1) }
    }
    i += 1
  }
  if len(body) == 0 { s = em(s, "CONST", unit_v(), 1) }
  s = em(s, "RET", VNil, -1)
  let f = s.f
  let idx = len(s.protos)
  (
    S {
      protos: push(s.protos, PR {
        name: f.name,
        np: f.np,
        nl: f.nl,
        code: f.code,
        lines: f.lines,
        upd: f.upd,
      }),
      ..s
    },
    idx,
  )
}

// ───────── 输出（与 tools/bc_dump.py 相同的格式，按 native.Gen 的 Proto 顺序）─────────

fn add_p(s: S, order: List<Int>, seen: Map<Int, Int>, p: Int) -> (List<Int>, Map<Int, Int>) {
  if contains(seen, p) { return (order, seen) }
  var o = push(order, p)
  var sn = set(seen, p, len(order))
  for (op, arg) in s.protos[p].code {
    if op == "CLOSURE" {
      let (o2, s2) = add_p(s, o, sn, iv(arg))
      o = o2
      sn = s2
    }
  }
  (o, sn)
}

fn conv_arg(seen: Map<Int, Int>, op: Str, a: V) -> V {
  if op == "CLOSURE" { return VN("P", unwrap(get(seen, iv(a))), Map()) }
  a
}

pub fn dump(s: S, chunk: Int) -> List<Str> {
  if s.err != "" { return [s.err] }
  var (order, seen) = add_p(s, [], Map(), chunk)
  var out: List<Str> = []
  for name in s.gord {
    match unwrap(get(s.gval, name)) {
      GFn(pi) => {
        let (o2, s2) = add_p(s, order, seen, pi)
        order = o2
        seen = s2
        out = push(out, "G " + val.dump(VS(name)) + " fn")
      },
      GStruct(f) => { out = push(out, "G " + val.dump(VS(name)) + " struct " + val.dump(f)) },
      GEnum(v) => { out = push(out, "G " + val.dump(VS(name)) + " enum " + val.dump(v)) },
      _ => {},
    }
  }
  var pname: Map<Int, Str> = Map()
  for t in s.mord {
    let (mo, mt) = unwrap(get(s.mtab, t))
    for m in mo {
      let pi = unwrap(get(mt, m))
      pname = set(pname, pi, t + "." + m)
      let (o2, s2) = add_p(s, order, seen, pi)
      order = o2
      seen = s2
      out = push(out, "M " + val.dump(VS(t + "." + m)) + " P{unwrap(get(seen, pi))}")
    }
  }
  var k = 0
  for pi in order {
    let p = s.protos[pi]
    let nm = unwrap_or(get(pname, pi), p.name)
    out = push(out, "P {k} " + val.dump(VS(nm)) + " {p.np} {p.nl} " + val.dump(VL(p.upd)))
    var i = 0
    for (op, arg) in p.code {
      out = push(out, "  {i} {op} " + val.dump(conv_arg(seen, op, arg)) + " {p.lines[i]}")
      i += 1
    }
    k += 1
  }
  out
}
