{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kite",
  "scopeName": "source.kite",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "match": "'[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.label.kite" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.kite", "match": "//.*$" },
        { "name": "comment.block.kite", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kite",
      "begin": "\"", "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.kite", "match": "\\\\[ntr0\\\\\"{}]|\\{\\{|\\}\\}" },
        {
          "name": "meta.interpolation.kite",
          "begin": "\\{", "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.kite" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.kite" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "declarations": {
      "patterns": [
        { "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.function.kite" }, "2": { "name": "entity.name.function.kite" } } },
        { "match": "\\b(type|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.type.kite" }, "2": { "name": "entity.name.type.kite" } } },
        { "match": "\\b(let|var)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.variable.kite" }, "2": { "name": "variable.other.kite" } } }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.kite", "match": "\\b(if|else|match|for|while|loop|break|continue|return|in|is|spawn|await|defer)\\b" },
        { "name": "keyword.other.kite", "match": "\\b(fn|type|enum|trait|impl|let|var|use|mod|pub|unsafe|extern|as)\\b" },
        { "name": "variable.language.self.kite", "match": "\\b(self|Self)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.kite", "match": "\\b(true|false)\\b" },
        { "name": "support.constant.kite", "match": "\\b(Ok|Err|Some|None)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.kite", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b" },
        { "name": "constant.numeric.integer.kite", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.kite", "match": "\\b(Int|Float|Bool|Str|Unit|List|Map|Set|Result|Option)\\b" },
        { "name": "entity.name.type.kite", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.kite" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.pipe.kite", "match": "\\|>" },
        { "name": "keyword.operator.arrow.kite", "match": "=>|->" },
        { "name": "keyword.operator.range.kite", "match": "\\.\\.=?" },
        { "name": "keyword.operator.kite", "match": "==|!=|<=|>=|&&|\\|\\||[-+*/%]=?|[<>=!?]" }
      ]
    }
  }
}
