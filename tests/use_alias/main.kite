use geom as g
use geom.Point as P
use geom.{ origin as o, dist2 }
use std.math as m
use std.math.{ sqrt as root }
use std.strings as s
use std.encoding.json.*
fn main() {
  let p = P { x: 3, y: 4 }
  print(dist2(p), g.dist2(o()), root(16.0), m.sqrt(9.0))
  print(s.slice("hello", 1, 3))
  print(stringify(parse("[1,2]").unwrap()))
}
