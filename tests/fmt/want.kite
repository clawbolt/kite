type Point = { x: Float, y: Float }
fn largest<T: Ord>(xs: List<T>) -> Option<T> {
  var best = first(xs)?
  for x in xs {
    if x > best { best = x }   // 更新
  }

  Some(best)
}
fn main() {
  let ok = !false && -3 < 0
  let xs = [1, 2, 3]
    |> map(x => x * 2)
  match largest(xs) {
    Some(v) => print(v, ok, 1..=3)
    None    => print("空")
  }
}
