enum E {
  A(x: Int)
  B(y: Int)
  C(s: Str)
  D
}

fn f(e: E) -> Int {
  match e {
    A(x) | B(_) => 1
    _ => 0
  }
}

fn g(e: E) -> Int {
  match e {
    A(x) | C(x) => 1
    _ => 0
  }
}

fn h(e: E) -> Int {
  match e {
    A(_) | B(_) => 1
    C(_) => 2
  }
}

fn k(n: Int) -> Int {
  match n {
    1 | "a" => 1
    _ => 0
  }
}
