# basics
== Retrieval of a plain host cookie.
  content: A=a ok=true
  http://www.host.test -> A=a ok=true
  http://www.host.test/ -> A=a ok=true
  http://www.host.test/some/path -> A=a ok=true
  https://www.host.test -> A=a ok=true
  https://www.host.test/ -> A=a ok=true
  https://www.host.test/some/path -> A=a ok=true
  ftp://www.host.test ->  ok=true
  ftp://www.host.test/ ->  ok=true
  ftp://www.host.test/some/path ->  ok=true
  http://www.other.org ->  ok=true
  http://sibling.host.test ->  ok=true
  http://deep.www.host.test ->  ok=true
== Secure cookies are not returned to http.
  content: A=a ok=true
  http://www.host.test ->  ok=true
  http://www.host.test/ ->  ok=true
  http://www.host.test/some/path ->  ok=true
  https://www.host.test -> A=a ok=true
  https://www.host.test/ -> A=a ok=true
  https://www.host.test/some/path -> A=a ok=true
== Secure cookies are sent for localhost
  content: A=a ok=true
  http://localhost:8910 -> A=a ok=true
  http://localhost:8910/ -> A=a ok=true
  http://localhost:8910/some/path -> A=a ok=true
  https://localhost:8910 -> A=a ok=true
  https://localhost:8910/ -> A=a ok=true
  https://localhost:8910/some/path -> A=a ok=true
== Secure cookies are sent for localhost (tld)
  content: A=a ok=true
  http://example.LOCALHOST:8910 -> A=a ok=true
  http://example.LOCALHOST:8910/ -> A=a ok=true
  http://example.LOCALHOST:8910/some/path -> A=a ok=true
  https://example.LOCALHOST:8910 -> A=a ok=true
  https://example.LOCALHOST:8910/ -> A=a ok=true
  https://example.LOCALHOST:8910/some/path -> A=a ok=true
== Secure cookies are sent for localhost (ipv6)
  content: A=a ok=true
  http://[::1]:8910 -> A=a ok=true
  http://[::1]:8910/ -> A=a ok=true
  http://[::1]:8910/some/path -> A=a ok=true
  https://[::1]:8910 -> A=a ok=true
  https://[::1]:8910/ -> A=a ok=true
  https://[::1]:8910/some/path -> A=a ok=true
== Localhost only if it's a segment
  content: A=a ok=true
  http://notlocalhost ->  ok=true
  http://notlocalhost/ ->  ok=true
  http://notlocalhost/some/path ->  ok=true
  https://notlocalhost -> A=a ok=true
  https://notlocalhost/ -> A=a ok=true
  https://notlocalhost/some/path -> A=a ok=true
== Explicit path.
  content: A=a ok=true
  http://www.host.test ->  ok=true
  http://www.host.test/ ->  ok=true
  http://www.host.test/some ->  ok=true
  http://www.host.test/some/ ->  ok=true
  http://www.host.test/some/path -> A=a ok=true
  http://www.host.test/some/paths ->  ok=true
  http://www.host.test/some/path/foo -> A=a ok=true
  http://www.host.test/some/path/foo/ -> A=a ok=true
== Implicit path #1: path is a directory.
  content: A=a ok=true
  http://www.host.test ->  ok=true
  http://www.host.test/ ->  ok=true
  http://www.host.test/some ->  ok=true
  http://www.host.test/some/ ->  ok=true
  http://www.host.test/some/path -> A=a ok=true
  http://www.host.test/some/paths ->  ok=true
  http://www.host.test/some/path/foo -> A=a ok=true
  http://www.host.test/some/path/foo/ -> A=a ok=true
== Implicit path #2: path is not a directory.
  content: A=a ok=true
  http://www.host.test ->  ok=true
  http://www.host.test/ ->  ok=true
  http://www.host.test/some ->  ok=true
  http://www.host.test/some/ ->  ok=true
  http://www.host.test/some/path -> A=a ok=true
  http://www.host.test/some/paths ->  ok=true
  http://www.host.test/some/path/foo -> A=a ok=true
  http://www.host.test/some/path/foo/ -> A=a ok=true
== Implicit path #3: no path in URL at all.
  content: A=a ok=true
  http://www.host.test -> A=a ok=true
  http://www.host.test/ -> A=a ok=true
  http://www.host.test/some/path -> A=a ok=true
== Cookies are sorted by path length.
  content: A=a B=b C=c D=d ok=true
  http://www.host.test/foo/bar/baz/qux -> B=b C=c A=a D=d ok=true
  http://www.host.test/foo/bar/baz/ -> C=c A=a D=d ok=true
  http://www.host.test/foo/bar -> A=a D=d ok=true
== Creation time determines sorting on same length paths.
  content: A=a B=b C=c D=d W=w X=x Y=y Z=z ok=true
  http://www.host.test/foo/bar/baz/qux -> Y=y B=b C=c W=w A=a X=x Z=z D=d ok=true
  http://www.host.test/foo/bar/baz/ -> C=c W=w A=a X=x Z=z D=d ok=true
  http://www.host.test/foo/bar -> A=a X=x Z=z D=d ok=true
== Sorting of same-name cookies.
  content: A=1 A=2 A=3 A=4 A=5 A=6 A=7 ok=true
  http://www.host.test/path -> A=2 A=5 A=1 ok=true
  http://www.host.test/path/foo -> A=4 A=7 A=2 A=5 A=1 ok=true
== Disallow domain cookie on public suffix.
  content: a=1 ok=true
  http://www.bbc.co.uk -> a=1 ok=true
== Host cookie on IP.
  content: a=1 ok=true
  http://192.168.0.10 -> a=1 ok=true
== Domain cookies on IP.
  content: a=1 ok=true
  http://192.168.0.10 -> a=1 ok=true
  http://172.31.9.9 ->  ok=true
  http://www.fancy.192.168.0.10 ->  ok=true
== Port is ignored #1.
  content: a=1 ok=true
  http://www.host.test -> a=1 ok=true
  http://www.host.test:8080/ -> a=1 ok=true
== Port is ignored #2.
  content: a=1 ok=true
  http://www.host.test -> a=1 ok=true
  http://www.host.test:8080/ -> a=1 ok=true
  http://www.host.test:1234/ -> a=1 ok=true
== IPv6 zone is not treated as a host.
  content: a=1 ok=true
  https://[::1%25.example.com]:80/ ->  ok=true
== Retrieval of cookies with quoted values
  content: cookie-1="quoted" cookie-2="quoted with spaces" cookie-3="quoted,with,commas" cookie-4=" ," ok=true
  http://www.host.test -> cookie-1="quoted" cookie-2="quoted with spaces" cookie-3="quoted,with,commas" cookie-4=" ," ok=true
# updateAndDelete
== Set initial cookies.
  content: a=1 b=2 c=3 d=4 ok=true
  http://www.host.test -> a=1 c=3 ok=true
  https://www.host.test -> a=1 b=2 c=3 d=4 ok=true
== Update value via http.
  content: a=w b=x c=y d=z ok=true
  http://www.host.test -> a=w c=y ok=true
  https://www.host.test -> a=w b=x c=y d=z ok=true
== Clear Secure flag from an http.
  content: a=w b=xx c=y d=zz ok=true
  http://www.host.test -> a=w b=xx c=y d=zz ok=true
== Delete all.
  content:  ok=true
  http://www.host.test ->  ok=true
== Refill #1.
  content: A=1 A=2 A=3 A=4 ok=true
  http://www.host.test/foo -> A=2 A=4 A=1 A=3 ok=true
== Refill #2.
  content: A=1 A=2 A=3 A=4 A=6 A=7 A=8 A=9 ok=true
  http://www.host.test/foo -> A=2 A=4 A=1 A=3 ok=true
  http://www.google.com/foo -> A=7 A=9 A=6 A=8 ok=true
== Delete A7.
  content: A=1 A=2 A=3 A=4 A=6 A=8 A=9 ok=true
  http://www.host.test/foo -> A=2 A=4 A=1 A=3 ok=true
  http://www.google.com/foo -> A=9 A=6 A=8 ok=true
== Delete A4.
  content: A=1 A=2 A=3 A=6 A=8 A=9 ok=true
  http://www.host.test/foo -> A=2 A=1 A=3 ok=true
  http://www.google.com/foo -> A=9 A=6 A=8 ok=true
== Delete A6.
  content: A=1 A=2 A=3 A=8 A=9 ok=true
  http://www.host.test/foo -> A=2 A=1 A=3 ok=true
  http://www.google.com/foo -> A=9 A=8 ok=true
== Delete A3.
  content: A=1 A=2 A=8 A=9 ok=true
  http://www.host.test/foo -> A=2 A=1 ok=true
  http://www.google.com/foo -> A=9 A=8 ok=true
== No cross-domain delete.
  content: A=1 A=2 A=8 A=9 ok=true
  http://www.host.test/foo -> A=2 A=1 ok=true
  http://www.google.com/foo -> A=9 A=8 ok=true
== Delete A8 and A9.
  content: A=1 A=2 ok=true
  http://www.host.test/foo -> A=2 A=1 ok=true
  http://www.google.com/foo ->  ok=true
