enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
  Tri(a: Float, b: Float, c: Float)
}

fn area(s: Shape) -> Float {
  match s {
    Circle(r) => 3.14 * r * r
    Rect(w, h) => w * h
  }
}

fn half(n: Int) -> Int { n / 2.0 }

