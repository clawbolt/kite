 w "dir2/up" up dir=false link=true nil
 w "empty" empty dir=true link=false nil
 w "link_abs" link_abs dir=false link=true nil
 w "link_dir" link_dir dir=false link=true nil
 w "link_rel" link_rel dir=false link=true nil
 w "loop1" loop1 dir=false link=true nil
 w "loop2" loop2 dir=false link=true nil
 w "skip" skip dir=true link=false nil
 w "skip/g.txt" g.txt dir=false link=false size=1 perm=644 nil
 w "空 格.txt" 空 格.txt dir=false link=false size=1 perm=644 nil
walk all nil
 w "."
 w ".hidden"
 w "a.txt"
 w "b.go"
 w "broken"
 w "chain"
 w "dir1"
 w "dir2"
 w "dir2/f.txt"
 w "empty"
 w "link_abs"
 w "link_dir"
 w "link_rel"
 w "loop1"
 w "loop2"
 w "skip"
 w "skip/g.txt"
walk skip nil
