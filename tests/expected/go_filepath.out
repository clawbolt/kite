walk file nil
 w "/tmp/kite_filepath_test/missing" nil lstat /tmp/kite_filepath_test/missing: no such file or directory
walk missing lstat /tmp/kite_filepath_test/missing: no such file or directory
 w "/tmp/kite_filepath_test/dir1"
 w "/tmp/kite_filepath_test/dir1/c.txt"
 w "/tmp/kite_filepath_test/dir1/d.md"
