module geom

几何小工具。用来测试 std.kite.doc。

第二段：坐标都是 Float。

pub type Point = { x: Float, y: Float }
    平面上的点

pub enum Shape {
  Circle(Point, Float)
  Rect { lo: Point, hi: Point }
}
    形状

pub const PI: Float = 3.14159
    圆周率（近似）

pub trait Area {
  fn area(self) -> Float
}
    能算面积的东西

impl Area for Shape
    fn area(self) -> Float
        面积

pub fn dist2(a: Point, b: Point) -> Float
    两点距离的平方。
    不开方，比较大小时够用

pub fn make_rect(
  x0: Float,
  y0: Float,
  x1: Float,
  y1: Float,
) -> Shape
    很长的参数表会被格式化器折行

pub fn distance2(a: Point, b: Point) -> Float
