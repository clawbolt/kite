// std.time：时间
// 全局的 now_ms() 是单调时钟（只适合测耗时），sleep(ms) 让当前任务睡眠

// 自 1970-01-01 UTC 起的毫秒数（墙上时间）
pub fn unix_ms() -> Int { __unix_ms() }

// 单调时钟的毫秒数，与 now_ms() 相同
pub fn mono_ms() -> Int { now_ms() }

// 从 start（mono_ms 的返回值）到现在过了多少毫秒
pub fn since_ms(start: Int) -> Int { now_ms() - start }

pub fn sleep_ms(ms: Int) { sleep(ms) }

fn two(n: Int) -> Str { if n < 10 { "0{n}" } else { "{n}" } }

fn three(n: Int) -> Str { if n < 10 { "00{n}" } else if n < 100 { "0{n}" } else { "{n}" } }

// unix 毫秒 → "2026-10-08T05:08:00.123Z"（UTC；只支持 1970 年以后）
pub fn format_utc(ms: Int) -> Str {
  let days = ms / 86400000
  let rem = ms % 86400000
  // 公历日期（Howard Hinnant 的 civil_from_days）
  let z = days + 719468
  let era = z / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  let h = rem / 3600000
  let mi = rem % 3600000 / 60000
  let s = rem % 60000 / 1000
  "{y}-{two(m)}-{two(d)}T{two(h)}:{two(mi)}:{two(s)}.{three(rem % 1000)}Z"
}

// ── 0.79 补充（对齐 Go 的 time 包） ──
// 时间点统一用 unix 毫秒（Int）表示；时长也用毫秒

pub const MILLISECOND: Int = 1
pub const SECOND: Int = 1000
pub const MINUTE: Int = 60000
pub const HOUR: Int = 3600000
pub const DAY: Int = 86400000

// 拆开的日期时间。weekday：0 是星期日；yday：一年里的第几天（1 起）；offset：相对 UTC 的秒数
pub type DateTime = {
  year: Int,
  month: Int,
  day: Int,
  hour: Int,
  minute: Int,
  second: Int,
  ms: Int,
  weekday: Int,
  yday: Int,
  offset: Int,
}

fn fdiv(a: Int, b: Int) -> Int { if a >= 0 { a / b } else { -((-a + b - 1) / b) } }

fn days_from_civil(y0: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { y0 - 1 } else { y0 }
  let era = fdiv(y, 400)
  let yoe = y - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

pub fn is_leap(y: Int) -> Bool { (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }

pub fn days_in_month(y: Int, m: Int) -> Int {
  if m == 2 {
    if is_leap(y) { 29 } else { 28 }
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else {
    31
  }
}

// 按偏移 offset 秒拆开（0 就是 UTC）；1970 年以前也正确
pub fn in_offset(ms: Int, offset: Int) -> DateTime {
  let t = ms + offset * 1000
  let days = fdiv(t, DAY)
  let rem = t - days * DAY
  let z = days + 719468
  let era = fdiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  let wd = (days % 7 + 11) % 7
  DateTime {
    year: y,
    month: m,
    day: d,
    hour: rem / HOUR,
    minute: rem % HOUR / MINUTE,
    second: rem % MINUTE / 1000,
    ms: rem % 1000,
    weekday: wd,
    yday: days - days_from_civil(y, 1, 1) + 1,
    offset: offset,
  }
}

pub fn utc(ms: Int) -> DateTime { in_offset(ms, 0) }

// 本机时区
pub fn local(ms: Int) -> DateTime { in_offset(ms, __tz_offset(ms)) }

pub fn local_offset(ms: Int) -> Int { __tz_offset(ms) }

// 组装成 unix 毫秒（按 UTC）；月、日超出范围时自动进位，比如 2 月 30 日就是 3 月 1 日或 2 日
pub fn date(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int, ms: Int) -> Int {
  let m0 = month - 1
  let y = year + fdiv(m0, 12)
  let m = m0 - fdiv(m0, 12) * 12 + 1
  days_from_civil(y, m, 1) * DAY + (
    day - 1
  ) * DAY + hour * HOUR + minute * MINUTE + second * SECOND + ms
}

pub fn to_ms(dt: DateTime) -> Int {
  date(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.ms) - dt.offset * 1000
}

// 按日历加年、月、日（同 Go 的 AddDate），结果按 UTC 计
pub fn add_date(ms: Int, years: Int, months: Int, days: Int) -> Int {
  let t = utc(ms)
  date(t.year + years, t.month + months, t.day + days, t.hour, t.minute, t.second, t.ms)
}

// 截到 d 的整数倍（同 Go 的 Truncate），比如 truncate(t, DAY) 是当天 0 点（UTC）
pub fn truncate(ms: Int, d: Int) -> Int { fdiv(ms, d) * d }

fn month_names() -> List<Str> {
  [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ]
}

fn day_names() -> List<Str> {
  ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
}

fn pad(n: Int, w: Int, c: Str) -> Str {
  var s = "{n}"
  while len(s) < w { s = c + s }
  s
}

fn offset_str(off: Int, colon: Bool, z: Bool) -> Str {
  if z && off == 0 { return "Z" }
  let sign = if off < 0 { "-" } else { "+" }
  let a = if off < 0 { -off } else { off }
  sign + pad(a / 3600, 2, "0") + (if colon { ":" } else { "" }) + pad(a % 3600 / 60, 2, "0")
}

// Go 风格的布局：用参考时间 Mon Jan 2 15:04:05 MST 2006 的各部分表示格式
//   2006 06 | 01 1 Jan January | 02 2 _2 | 002（年内第几天）| 15 03 3 | 04 4 | 05 5 | .000 .000000 | PM pm | Mon Monday | -0700 -07:00 Z07:00 Z0700 MST
pub fn format_dt(t: DateTime, layout: Str) -> Str {
  let toks = [
    ("January", 0),
    ("Monday", 1),
    ("Z07:00", 2),
    ("Z0700", 3),
    ("-07:00", 4),
    ("-0700", 5),
    (".000000", 6),
    (".000", 7),
    ("2006", 8),
    ("002", 9),
    ("Jan", 10),
    ("Mon", 11),
    ("MST", 12),
    ("01", 13),
    ("02", 14),
    ("_2", 15),
    ("06", 16),
    ("15", 17),
    ("03", 18),
    ("04", 19),
    ("05", 20),
    ("PM", 21),
    ("pm", 22),
    ("1", 23),
    ("2", 24),
    ("3", 25),
    ("4", 26),
    ("5", 27),
  ]
  let h12 = if t.hour % 12 == 0 { 12 } else { t.hour % 12 }
  var out = ""
  var i = 0
  let n = len(layout)
  while i < n {
    var hit = -1
    var tl = 0
    for (tok, id) in toks {
      if starts_with(__str_slice(layout, i, i + len(tok)), tok) && len(tok) <= n - i {
        hit = id
        tl = len(tok)
        break
      }
    }
    if hit < 0 {
      out = out + __str_slice(layout, i, i + 1)
      i += 1
      continue
    }
    let piece = match hit {
      0 => month_names()[t.month - 1],
      1 => day_names()[t.weekday],
      2 => offset_str(t.offset, true, true),
      3 => offset_str(t.offset, false, true),
      4 => offset_str(t.offset, true, false),
      5 => offset_str(t.offset, false, false),
      6 => "." + pad(t.ms * 1000, 6, "0"),
      7 => "." + pad(t.ms, 3, "0"),
      8 => pad(t.year, 4, "0"),
      9 => pad(t.yday, 3, "0"),
      10 => __str_slice(month_names()[t.month - 1], 0, 3),
      11 => __str_slice(day_names()[t.weekday], 0, 3),
      12 => if t.offset == 0 { "UTC" } else { offset_str(t.offset, false, false) },
      13 => pad(t.month, 2, "0"),
      14 => pad(t.day, 2, "0"),
      15 => pad(t.day, 2, " "),
      16 => pad(t.year % 100, 2, "0"),
      17 => pad(t.hour, 2, "0"),
      18 => pad(h12, 2, "0"),
      19 => pad(t.minute, 2, "0"),
      20 => pad(t.second, 2, "0"),
      21 => if t.hour < 12 { "AM" } else { "PM" },
      22 => if t.hour < 12 { "am" } else { "pm" },
      23 => "{t.month}",
      24 => "{t.day}",
      25 => "{h12}",
      26 => "{t.minute}",
      _ => "{t.second}",
    }
    out = out + piece
    i += tl
  }
  out
}

pub fn format(ms: Int, layout: Str) -> Str { format_dt(utc(ms), layout) }

pub fn format_local(ms: Int, layout: Str) -> Str { format_dt(local(ms), layout) }

pub const RFC3339: Str = "2006-01-02T15:04:05Z07:00"
pub const DATETIME: Str = "2006-01-02 15:04:05"
pub const DATE_ONLY: Str = "2006-01-02"
pub const TIME_ONLY: Str = "15:04:05"
pub const RFC1123: Str = "Mon, 02 Jan 2006 15:04:05 MST"

fn digits(s: Str, i: Int, lo: Int, hi: Int) -> (Int, Int) {
  // 从 i 开始读 lo 到 hi 位数字：(值, 结束位置)，读不到返回 (-1, i)
  var j = i
  var v = 0
  while j < len(s) && j - i < hi {
    let o = __ord(__str_slice(s, j, j + 1))
    if o < 48 || o > 57 { break }
    v = v * 10 + o - 48
    j += 1
  }
  if j - i < lo { (-1, i) } else { (v, j) }
}

fn name_at(s: Str, i: Int, names: List<Str>, short: Bool) -> (Int, Int) {
  var k = 0
  for nm in names {
    let w = if short { __str_slice(nm, 0, 3) } else { nm }
    if lower(__str_slice(s, i, i + len(w))) == lower(w) { return (k, i + len(w)) }
    k += 1
  }
  (-1, i)
}

// 按布局解析成 unix 毫秒；布局里没有时区时按 UTC
pub fn parse(layout: Str, s: Str) -> Result<Int, Str> {
  let toks = [
    "January", "Monday", "Z07:00", "Z0700", "-07:00", "-0700", ".000000", ".000", "2006", "002",
    "Jan", "Mon", "MST", "01", "02", "_2", "06", "15", "03", "04", "05", "PM", "pm", "1", "2", "3",
    "4", "5",
  ]
  let bad = "无法按布局 {layout} 解析时间: {s}"
  var y = 1970
  var mo = 1
  var d = 1
  var h = 0
  var mi = 0
  var sec = 0
  var ms = 0
  var off = 0
  var pm = -1
  var i = 0
  var j = 0
  let n = len(layout)
  while i < n {
    var tok = ""
    for t in toks {
      if __str_slice(layout, i, i + len(t)) == t {
        tok = t
        break
      }
    }
    if tok == "" {
      if __str_slice(layout, i, i + 1) != __str_slice(s, j, j + 1) { return Err(bad) }
      i += 1
      j += 1
      continue
    }
    var v = 0
    var e = j
    if tok == "January" || tok == "Jan" {
      let (k, e2) = name_at(s, j, month_names(), tok == "Jan")
      v = k + 1
      e = e2
    } else if tok == "Monday" || tok == "Mon" {
      let (k, e2) = name_at(s, j, day_names(), tok == "Mon")
      v = k
      e = e2
    } else if tok == "PM" || tok == "pm" {
      let w = upper(__str_slice(s, j, j + 2))
      if w == "AM" { pm = 0 } else if w == "PM" { pm = 1 } else { return Err(bad) }
      e = j + 2
    } else if tok == "MST" {
      // 只认 UTC / GMT
      let w = __str_slice(s, j, j + 3)
      if w != "UTC" && w != "GMT" { return Err(bad) }
      e = j + 3
    } else if starts_with(tok, "Z") || starts_with(tok, "-") {
      if starts_with(tok, "Z") && __str_slice(s, j, j + 1) == "Z" {
        off = 0
        e = j + 1
      } else {
        let sg = __str_slice(s, j, j + 1)
        if sg != "+" && sg != "-" { return Err(bad) }
        let (hh, e1) = digits(s, j + 1, 2, 2)
        var p = e1
        if contains(tok, ":") {
          if __str_slice(s, p, p + 1) != ":" { return Err(bad) }
          p += 1
        }
        let (mm, e3) = digits(s, p, 2, 2)
        if hh < 0 || mm < 0 { return Err(bad) }
        off = (hh * 3600 + mm * 60) * (if sg == "-" { -1 } else { 1 })
        e = e3
      }
    } else if starts_with(tok, ".") {
      if __str_slice(s, j, j + 1) != "." { return Err(bad) }
      let (f, e1) = digits(s, j + 1, 1, 9)
      if f < 0 { return Err(bad) }
      var frac = f
      var k = e1 - j - 1
      while k > 3 {
        frac = frac / 10
        k -= 1
      }
      while k < 3 {
        frac = frac * 10
        k += 1
      }
      ms = frac
      e = e1
    } else {
      var j2 = j
      if tok == "_2" && __str_slice(s, j, j + 1) == " " { j2 = j + 1 }
      let w = if tok == "2006" {
        4
      } else if tok == "002" {
        3
      } else if len(tok) == 1 || tok == "_2" {
        1
      } else {
        2
      }
      let (x, e1) = digits(s, j2, w, if len(tok) == 1 || tok == "_2" { 2 } else { w })
      if x < 0 { return Err(bad) }
      v = x
      e = e1
    }
    if v < 0 { return Err(bad) }
    if tok == "2006" {
      y = v
    } else if tok == "06" {
      y = if v >= 69 { 1900 + v } else { 2000 + v }
    } else if tok == "January" || tok == "Jan" || tok == "01" || tok == "1" {
      mo = v
    } else if tok == "02" || tok == "2" || tok == "_2" {
      d = v
    } else if tok == "15" || tok == "03" || tok == "3" {
      h = v
    } else if tok == "04" || tok == "4" {
      mi = v
    } else if tok == "05" || tok == "5" {
      sec = v
    }
    i += len(tok)
    j = e
  }
  if j != len(s) { return Err(bad) }
  if pm == 1 && h < 12 { h += 12 }
  if pm == 0 && h == 12 { h = 0 }
  if mo < 1 || mo > 12 || d < 1 || d > days_in_month(y, mo) || h > 23 || mi > 59 || sec > 59 {
    return Err("时间超出范围: {s}")
  }
  Ok(date(y, mo, d, h, mi, sec, ms) - off * 1000)
}

// 时长的写法，同 Go：1h2m3.5s、250ms、0s
pub fn format_duration(d: Int) -> Str {
  if d == 0 { return "0s" }
  let neg = d < 0
  let a = if neg { -d } else { d }
  let sign = if neg { "-" } else { "" }
  if a < SECOND { return "{sign}{a}ms" }
  let h = a / HOUR
  let m = a % HOUR / MINUTE
  let s = a % MINUTE / SECOND
  let f = a % SECOND
  var frac = if f == 0 { "" } else { "." + pad(f, 3, "0") }
  while ends_with(frac, "0") { frac = __str_slice(frac, 0, len(frac) - 1) }
  var out = sign
  if h > 0 { out = out + "{h}h" }
  if h > 0 || m > 0 { out = out + "{m}m" }
  out + "{s}{frac}s"
}

// 解析 "1h30m"、"1.5s"、"-250ms"、"2d"（d 是扩展单位）
pub fn parse_duration(s: Str) -> Result<Int, Str> {
  let bad = "无法解析时长: {s}"
  var cs = chars(s)
  if len(cs) == 0 { return Err(bad) }
  var neg = false
  if cs[0] == "-" || cs[0] == "+" {
    neg = cs[0] == "-"
    cs = cs[1..]
  }
  if len(cs) == 1 && cs[0] == "0" { return Ok(0) }
  var total = 0
  var i = 0
  if len(cs) == 0 { return Err(bad) }
  while i < len(cs) {
    var whole = 0
    var nd = 0
    while i < len(cs) && __ord(cs[i]) >= 48 && __ord(cs[i]) <= 57 {
      whole = whole * 10 + __ord(cs[i]) - 48
      i += 1
      nd += 1
    }
    var frac = 0
    var scale = 1
    if i < len(cs) && cs[i] == "." {
      i += 1
      while i < len(cs) && __ord(cs[i]) >= 48 && __ord(cs[i]) <= 57 {
        if scale < 1000000 {
          frac = frac * 10 + __ord(cs[i]) - 48
          scale = scale * 10
        }
        i += 1
        nd += 1
      }
    }
    if nd == 0 { return Err(bad) }
    var u = ""
    while i < len(cs) && (__ord(cs[i]) < 48 || __ord(cs[i]) > 57) && cs[i] != "." {
      u = u + cs[i]
      i += 1
    }
    let unit = if u == "ms" {
      1
    } else if u == "s" {
      SECOND
    } else if u == "m" {
      MINUTE
    } else if u == "h" {
      HOUR
    } else if u == "d" {
      DAY
    } else {
      0
    }
    if unit == 0 { return Err(bad) }
    total = total + whole * unit + frac * unit / scale
  }
  Ok(if neg { -total } else { total })
}
