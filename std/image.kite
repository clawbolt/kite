// std.image：对齐 Go 1.27 的 image 包
//   Point / Rectangle 及其全部方法；Image 是一个带 kind 的统一类型，覆盖 Go 的
//   RGBA、RGBA64、NRGBA、NRGBA64、Alpha、Alpha16、Gray、Gray16、CMYK、Paletted、YCbCr、NYCbCrA、Uniform。
//   像素布局（pix / y / cb / cr / a 与各 stride）与 Go 完全相同。
//   Image 是不可变值：set 系列返回新图像；sub_image 返回的是副本（Go 里与原图共享像素），这是与 Go 的主要差别。
//   单个像素的 set 要复制整块像素（O(n)），大量写像素时请直接构造 pix 或用 std.image.draw

use std.image.color
use std.image.color.{ Color }

pub type Point = { x: Int, y: Int }

pub type Rectangle = { min: Point, max: Point }

pub fn pt(x: Int, y: Int) -> Point { Point { x: x, y: y } }

pub fn zp() -> Point { pt(0, 0) }

pub fn zr() -> Rectangle { Rectangle { min: zp(), max: zp() } }

pub fn rect(x0: Int, y0: Int, x1: Int, y1: Int) -> Rectangle {
  Rectangle { min: pt(if x0 > x1 { x1 } else { x0 }, if y0 > y1 { y1 } else { y0 }), max: pt(
    if x0 > x1 { x0 } else { x1 },
    if y0 > y1 { y0 } else { y1 },
  ) }
}

impl Point {
  pub fn string(self) -> Str { "({self.x},{self.y})" }
  pub fn add(self, q: Point) -> Point { pt(self.x + q.x, self.y + q.y) }
  pub fn sub(self, q: Point) -> Point { pt(self.x - q.x, self.y - q.y) }
  pub fn mul(self, k: Int) -> Point { pt(self.x * k, self.y * k) }
  pub fn div(self, k: Int) -> Point { pt(self.x / k, self.y / k) }
  pub fn in_(self, r: Rectangle) -> Bool {
    r.min.x <= self.x && self.x < r.max.x && r.min.y <= self.y && self.y < r.max.y
  }
  pub fn mod_(self, r: Rectangle) -> Point {
    let w = r.dx()
    let h = r.dy()
    let p = self.sub(r.min)
    var x = p.x % w
    if x < 0 { x += w }
    var y = p.y % h
    if y < 0 { y += h }
    pt(x, y).add(r.min)
  }
  pub fn eq(self, q: Point) -> Bool { self.x == q.x && self.y == q.y }
}

impl Rectangle {
  pub fn string(self) -> Str { self.min.string() + "-" + self.max.string() }
  pub fn dx(self) -> Int { self.max.x - self.min.x }
  pub fn dy(self) -> Int { self.max.y - self.min.y }
  pub fn size(self) -> Point { pt(self.dx(), self.dy()) }
  pub fn add(self, p: Point) -> Rectangle {
    Rectangle { min: self.min.add(p), max: self.max.add(p) }
  }
  pub fn sub(self, p: Point) -> Rectangle {
    Rectangle { min: self.min.sub(p), max: self.max.sub(p) }
  }
  pub fn inset(self, n: Int) -> Rectangle {
    var x0 = self.min.x
    var x1 = self.max.x
    var y0 = self.min.y
    var y1 = self.max.y
    if self.dx() < 2 * n {
      x0 = (x0 + x1) / 2
      x1 = x0
    } else {
      x0 += n
      x1 -= n
    }
    if self.dy() < 2 * n {
      y0 = (y0 + y1) / 2
      y1 = y0
    } else {
      y0 += n
      y1 -= n
    }
    Rectangle { min: pt(x0, y0), max: pt(x1, y1) }
  }
  pub fn intersect(self, s: Rectangle) -> Rectangle {
    let r = Rectangle {
      min: pt(if self.min.x < s.min.x { s.min.x } else { self.min.x }, if self.min.y < s.min.y {
        s.min.y
      } else {
        self.min.y
      }),
      max: pt(if self.max.x > s.max.x { s.max.x } else { self.max.x }, if self.max.y > s.max.y {
        s.max.y
      } else {
        self.max.y
      }),
    }
    if r.empty() { zr() } else { r }
  }
  pub fn union(self, s: Rectangle) -> Rectangle {
    if self.empty() { return s }
    if s.empty() { return self }
    Rectangle {
      min: pt(if self.min.x > s.min.x { s.min.x } else { self.min.x }, if self.min.y > s.min.y {
        s.min.y
      } else {
        self.min.y
      }),
      max: pt(if self.max.x < s.max.x { s.max.x } else { self.max.x }, if self.max.y < s.max.y {
        s.max.y
      } else {
        self.max.y
      }),
    }
  }
  pub fn empty(self) -> Bool { self.min.x >= self.max.x || self.min.y >= self.max.y }
  pub fn eq(self, s: Rectangle) -> Bool {
    (self.min.eq(s.min) && self.max.eq(s.max)) || (self.empty() && s.empty())
  }
  pub fn overlaps(self, s: Rectangle) -> Bool {
    !self.empty()
      && !s.empty()
      && self.min.x < s.max.x
      && s.min.x < self.max.x
      && self.min.y < s.max.y
      && s.min.y < self.max.y
  }
  pub fn in_(self, s: Rectangle) -> Bool {
    if self.empty() { return true }
    s.min.x <= self.min.x && self.max.x <= s.max.x && s.min.y <= self.min.y && self.max.y <= s.max.y
  }
  pub fn canon(self) -> Rectangle { rect(self.min.x, self.min.y, self.max.x, self.max.y) }
  // Rectangle 作为图像时的 At
  pub fn at(self, x: Int, y: Int) -> Color {
    if pt(x, y).in_(self) { color.opaque() } else { color.transparent() }
  }
}

// ── 图像 ──

pub const RGBA: Int = 0
pub const RGBA64: Int = 1
pub const NRGBA: Int = 2
pub const NRGBA64: Int = 3
pub const ALPHA: Int = 4
pub const ALPHA16: Int = 5
pub const GRAY: Int = 6
pub const GRAY16: Int = 7
pub const CMYK: Int = 8
pub const PALETTED: Int = 9
pub const YCBCR: Int = 10
pub const NYCBCRA: Int = 11
pub const UNIFORM: Int = 12

pub const RATIO_444: Int = 0
pub const RATIO_422: Int = 1
pub const RATIO_420: Int = 2
pub const RATIO_440: Int = 3
pub const RATIO_411: Int = 4
pub const RATIO_410: Int = 5

pub fn ratio_string(s: Int) -> Str {
  if s >= 0 && s <= 5 {
    return "YCbCrSubsampleRatio" + ["444", "422", "420", "440", "411", "410"][s]
  }
  "YCbCrSubsampleRatioUnknown"
}

pub type Image = {
  kind: Int,
  rect: Rectangle,
  stride: Int,
  pix: List<Int>,
  palette: List<Color>,
  y: List<Int>,
  cb: List<Int>,
  cr: List<Int>,
  a: List<Int>,
  y_stride: Int,
  c_stride: Int,
  a_stride: Int,
  ratio: Int,
  uniform: Color,
}

fn bpp(kind: Int) -> Int { [4, 8, 4, 8, 1, 2, 1, 2, 4, 1, 0, 0, 0][kind] }

pub fn kind_name(kind: Int) -> Str {
  [
    "RGBA", "RGBA64", "NRGBA", "NRGBA64", "Alpha", "Alpha16", "Gray", "Gray16", "CMYK", "Paletted",
    "YCbCr", "NYCbCrA", "Uniform",
  ][kind]
}

fn zeros(n: Int) -> List<Int> { map(0..n, (_) => 0) }

fn blank(kind: Int, r: Rectangle) -> Image {
  Image {
    kind: kind,
    rect: r,
    stride: 0,
    pix: [],
    palette: [],
    y: [],
    cb: [],
    cr: [],
    a: [],
    y_stride: 0,
    c_stride: 0,
    a_stride: 0,
    ratio: 0,
    uniform: color.transparent(),
  }
}

fn buf_len(b: Int, r: Rectangle, name: Str) -> Result<Int, Str> {
  if r.dx() < 0 || r.dy() < 0 {
    return Err("image: New" + name + " Rectangle has huge or negative dimensions")
  }
  Ok(b * r.dx() * r.dy())
}

// NewRGBA 等（kind 取 RGBA … CMYK）；尺寸为负时返回 Go panic 的文字
pub fn new(kind: Int, r: Rectangle) -> Result<Image, Str> {
  let n = buf_len(bpp(kind), r, kind_name(kind))?
  Ok(Image { stride: bpp(kind) * r.dx(), pix: zeros(n), ..blank(kind, r) })
}

pub fn new_paletted(r: Rectangle, p: List<Color>) -> Result<Image, Str> {
  let n = buf_len(1, r, "Paletted")?
  Ok(Image { stride: r.dx(), pix: zeros(n), palette: p, ..blank(PALETTED, r) })
}

fn ycbcr_size(r: Rectangle, s: Int) -> (Int, Int, Int, Int) {
  let w = r.dx()
  let h = r.dy()
  if s == RATIO_422 { return (w, h, (r.max.x + 1) / 2 - r.min.x / 2, h) }
  if s == RATIO_420 {
    return (w, h, (r.max.x + 1) / 2 - r.min.x / 2, (r.max.y + 1) / 2 - r.min.y / 2)
  }
  if s == RATIO_440 { return (w, h, w, (r.max.y + 1) / 2 - r.min.y / 2) }
  if s == RATIO_411 { return (w, h, (r.max.x + 3) / 4 - r.min.x / 4, h) }
  if s == RATIO_410 {
    return (w, h, (r.max.x + 3) / 4 - r.min.x / 4, (r.max.y + 1) / 2 - r.min.y / 2)
  }
  (w, h, w, h)
}

pub fn new_ycbcr(r: Rectangle, s: Int) -> Result<Image, Str> {
  let (w, h, cw, ch) = ycbcr_size(r, s)
  if w < 0 || h < 0 || cw < 0 || ch < 0 {
    return Err("image: NewYCbCr Rectangle has huge or negative dimensions")
  }
  Ok(Image {
    y: zeros(w * h),
    cb: zeros(cw * ch),
    cr: zeros(cw * ch),
    y_stride: w,
    c_stride: cw,
    ratio: s,
    ..blank(YCBCR, r)
  })
}

pub fn new_nycbcra(r: Rectangle, s: Int) -> Result<Image, Str> {
  let (w, h, cw, ch) = ycbcr_size(r, s)
  if w < 0 || h < 0 || cw < 0 || ch < 0 {
    return Err("image: NewNYCbCrA Rectangle has huge or negative dimension")
  }
  Ok(Image {
    y: zeros(w * h),
    cb: zeros(cw * ch),
    cr: zeros(cw * ch),
    a: zeros(w * h),
    y_stride: w,
    c_stride: cw,
    a_stride: w,
    ratio: s,
    ..blank(NYCBCRA, r)
  })
}

// image.NewUniform
pub fn new_uniform(c: Color) -> Image {
  Image { uniform: c, ..blank(UNIFORM, rect(-1000000000, -1000000000, 1000000000, 1000000000)) }
}

fn be16(p: List<Int>, i: Int) -> Int { (p[i] << 8) | p[i + 1] }

impl Image {
  pub fn bounds(self) -> Rectangle { self.rect }

  // 颜色模型：color 里的模型常量；Paletted 返回 -1（模型就是它的调色板）
  pub fn color_model(self) -> Int {
    let k = self.kind
    if k == PALETTED { return -1 }
    if k == UNIFORM { return color.model_of(self.uniform) }
    [
      color.RGBA_MODEL,
      color.RGBA64_MODEL,
      color.NRGBA_MODEL,
      color.NRGBA64_MODEL,
      color.ALPHA_MODEL,
      color.ALPHA16_MODEL,
      color.GRAY_MODEL,
      color.GRAY16_MODEL,
      color.CMYK_MODEL,
      -1,
      color.YCBCR_MODEL,
      color.NYCBCRA_MODEL,
    ][k]
  }

  // 按图像的模型转换颜色
  pub fn convert(self, c: Color) -> Color {
    if self.kind == PALETTED {
      return match color.palette_convert(self.palette, c) { Some(x) => x, None => c }
    }
    if self.kind == UNIFORM { return self.uniform }
    color.convert(self.color_model(), c)
  }

  pub fn pix_offset(self, x: Int, y: Int) -> Int {
    (y - self.rect.min.y) * self.stride + (x - self.rect.min.x) * bpp(self.kind)
  }

  pub fn y_offset(self, x: Int, y: Int) -> Int {
    (y - self.rect.min.y) * self.y_stride + (x - self.rect.min.x)
  }

  pub fn a_offset(self, x: Int, y: Int) -> Int {
    (y - self.rect.min.y) * self.a_stride + (x - self.rect.min.x)
  }

  pub fn c_offset(self, x: Int, y: Int) -> Int {
    let r = self.rect
    let s = self.ratio
    if s == RATIO_422 { return (y - r.min.y) * self.c_stride + (x / 2 - r.min.x / 2) }
    if s == RATIO_420 { return (y / 2 - r.min.y / 2) * self.c_stride + (x / 2 - r.min.x / 2) }
    if s == RATIO_440 { return (y / 2 - r.min.y / 2) * self.c_stride + (x - r.min.x) }
    if s == RATIO_411 { return (y - r.min.y) * self.c_stride + (x / 4 - r.min.x / 4) }
    if s == RATIO_410 { return (y / 2 - r.min.y / 2) * self.c_stride + (x / 4 - r.min.x / 4) }
    (y - r.min.y) * self.c_stride + (x - r.min.x)
  }

  // At；Paletted 的调色板为空时 Go 返回 nil，这里返回 None
  pub fn at_opt(self, x: Int, y: Int) -> Option<Color> {
    let k = self.kind
    if k == UNIFORM { return Some(self.uniform) }
    if k == PALETTED {
      if len(self.palette) == 0 { return None }
      if !pt(x, y).in_(self.rect) { return Some(self.palette[0]) }
      return Some(self.palette[self.pix[self.pix_offset(x, y)]])
    }
    let inside = pt(x, y).in_(self.rect)
    let p = self.pix
    let i = if inside && k < YCBCR { self.pix_offset(x, y) } else { 0 }
    Some(if k == RGBA {
      if inside { Color.RGBA(p[i], p[i + 1], p[i + 2], p[i + 3]) } else { Color.RGBA(0, 0, 0, 0) }
    } else if k == RGBA64 {
      if inside {
        Color.RGBA64(be16(p, i), be16(p, i + 2), be16(p, i + 4), be16(p, i + 6))
      } else {
        Color.RGBA64(0, 0, 0, 0)
      }
    } else if k == NRGBA {
      if inside { Color.NRGBA(p[i], p[i + 1], p[i + 2], p[i + 3]) } else { Color.NRGBA(0, 0, 0, 0) }
    } else if k == NRGBA64 {
      if inside {
        Color.NRGBA64(be16(p, i), be16(p, i + 2), be16(p, i + 4), be16(p, i + 6))
      } else {
        Color.NRGBA64(0, 0, 0, 0)
      }
    } else if k == ALPHA {
      Color.Alpha(if inside { p[i] } else { 0 })
    } else if k == ALPHA16 {
      Color.Alpha16(if inside { be16(p, i) } else { 0 })
    } else if k == GRAY {
      Color.Gray(if inside { p[i] } else { 0 })
    } else if k == GRAY16 {
      Color.Gray16(if inside { be16(p, i) } else { 0 })
    } else if k == CMYK {
      if inside { Color.CMYK(p[i], p[i + 1], p[i + 2], p[i + 3]) } else { Color.CMYK(0, 0, 0, 0) }
    } else if k == YCBCR {
      if !inside {
        Color.YCbCr(0, 0, 0)
      } else {
        let ci = self.c_offset(x, y)
        Color.YCbCr(self.y[self.y_offset(x, y)], self.cb[ci], self.cr[ci])
      }
    } else {
      if !inside {
        Color.NYCbCrA(0, 0, 0, 0)
      } else {
        let ci = self.c_offset(x, y)
        Color.NYCbCrA(self.y[self.y_offset(x, y)], self.cb[ci], self.cr[ci], self.a[
          self.a_offset(x, y)
        ])
      }
    })
  }

  pub fn at(self, x: Int, y: Int) -> Color { unwrap(self.at_opt(x, y)) }

  // RGBA64At
  pub fn rgba64_at(self, x: Int, y: Int) -> (Int, Int, Int, Int) {
    match self.at_opt(x, y) {
      None => (0, 0, 0, 0),
      Some(c) => color.rgba(c),
    }
  }

  // 用另一份像素数据读 RGBA64At（draw 在可变副本上工作时用）
  pub fn rgba64_at_pix(self, p: List<Int>, x: Int, y: Int) -> (Int, Int, Int, Int) {
    Image { pix: p, ..self }.rgba64_at(x, y)
  }

  pub fn color_index_at(self, x: Int, y: Int) -> Int {
    if pt(x, y).in_(self.rect) { self.pix[self.pix_offset(x, y)] } else { 0 }
  }

  fn put(self, i: Int, vals: List<Int>) -> Image {
    var p = self.pix
    for k in 0..len(vals) { p[i + k] = vals[k] }
    Image { pix: p, ..self }
  }

  pub fn set_color_index(self, x: Int, y: Int, idx: Int) -> Image {
    if !pt(x, y).in_(self.rect) { return self }
    self.put(self.pix_offset(x, y), [idx])
  }

  // Set
  pub fn set(self, x: Int, y: Int, c: Color) -> Image {
    if !pt(x, y).in_(self.rect) || self.kind == UNIFORM { return self }
    let k = self.kind
    if k == PALETTED {
      return self.put(self.pix_offset(x, y), [color.palette_index(self.palette, c)])
    }
    if k == YCBCR || k == NYCBCRA { return self }
    self.put(self.pix_offset(x, y), self.px_bytes(c))
  }

  // 颜色按本图像的格式编码成像素字节（Paletted 是调色板下标）
  pub fn px_bytes(self, c: Color) -> List<Int> {
    if self.kind == PALETTED { return [color.palette_index(self.palette, c)] }
    match color.convert(self.color_model(), c) {
      Color.RGBA(r, g, b, a) => [r, g, b, a],
      Color.NRGBA(r, g, b, a) => [r, g, b, a],
      Color.CMYK(r, g, b, a) => [r, g, b, a],
      Color.RGBA64(r, g, b, a) => [
        r >> 8,
        r & 255,
        g >> 8,
        g & 255,
        b >> 8,
        b & 255,
        a >> 8,
        a & 255,
      ],
      Color.NRGBA64(r, g, b, a) => [
        r >> 8,
        r & 255,
        g >> 8,
        g & 255,
        b >> 8,
        b & 255,
        a >> 8,
        a & 255,
      ],
      Color.Alpha(a) => [a],
      Color.Gray(a) => [a],
      Color.Alpha16(a) => [a >> 8, a & 255],
      Color.Gray16(a) => [a >> 8, a & 255],
      _ => [],
    }
  }

  // SetRGBA64（分量是 16 位预乘值）
  pub fn set_rgba64(self, x: Int, y: Int, r: Int, g: Int, b: Int, a: Int) -> Image {
    if !pt(x, y).in_(self.rect) { return self }
    let k = self.kind
    if k == RGBA || k == RGBA64 || k == ALPHA || k == ALPHA16 || k == PALETTED {
      return self.set(x, y, Color.RGBA64(r, g, b, a))
    }
    let i = self.pix_offset(x, y)
    if k == NRGBA || k == NRGBA64 {
      var r2 = r
      var g2 = g
      var b2 = b
      if a != 0 && a != 0xffff {
        r2 = r * 0xffff / a
        g2 = g * 0xffff / a
        b2 = b * 0xffff / a
      }
      if k == NRGBA { return self.put(i, [r2 >> 8, g2 >> 8, b2 >> 8, a >> 8]) }
      return self.put(i, [r2 >> 8, r2 & 255, g2 >> 8, g2 & 255, b2 >> 8, b2 & 255, a >> 8, a & 255])
    }
    if k == GRAY { return self.put(i, [(19595 * r + 38470 * g + 7471 * b + (1 << 15)) >> 24]) }
    if k == GRAY16 {
      let gy = ((19595 * r + 38470 * g + 7471 * b + (1 << 15)) >> 16) & 0xffff
      return self.put(i, [gy >> 8, gy & 255])
    }
    if k == CMYK {
      let (cc, mm, yy, kk) = color.rgb_to_cmyk(r >> 8, g >> 8, b >> 8)
      return self.put(i, [cc, mm, yy, kk])
    }
    self
  }

  pub fn sub_image(self, r0: Rectangle) -> Image {
    let r = r0.intersect(self.rect)
    let k = self.kind
    if k == UNIFORM { return self }
    if r.empty() {
      let e = blank(k, zr())
      return if k == PALETTED {
        Image { palette: self.palette, ..e }
      } else if k == YCBCR || k == NYCBCRA {
        Image { ratio: self.ratio, ..e }
      } else {
        e
      }
    }
    if k == YCBCR || k == NYCBCRA {
      let yi = self.y_offset(r.min.x, r.min.y)
      let ci = self.c_offset(r.min.x, r.min.y)
      let base = Image { y: self.y[yi..], cb: self.cb[ci..], cr: self.cr[ci..], rect: r, ..self }
      if k == YCBCR { return base }
      return Image { a: self.a[self.a_offset(r.min.x, r.min.y)..], ..base }
    }
    Image { pix: self.pix[self.pix_offset(r.min.x, r.min.y)..], rect: r, ..self }
  }

  pub fn opaque(self) -> Bool {
    let k = self.kind
    if k == GRAY || k == GRAY16 || k == CMYK || k == YCBCR { return true }
    if k == UNIFORM {
      let (_, _, _, a) = color.rgba(self.uniform)
      return a == 0xffff
    }
    if k == PALETTED {
      var present = map(0..256, (_) => false)
      var i0 = 0
      for _ in self.rect.min.y..self.rect.max.y {
        for i in i0..i0 + self.rect.dx() { present[self.pix[i]] = true }
        i0 += self.stride
      }
      for i in 0..len(self.palette) {
        if !present[i] { continue }
        let (_, _, _, a) = color.rgba(self.palette[i])
        if a != 0xffff { return false }
      }
      return true
    }
    if self.rect.empty() { return true }
    if k == NYCBCRA {
      var i0 = 0
      for _ in self.rect.min.y..self.rect.max.y {
        for i in i0..i0 + self.rect.dx() { if self.a[i] != 0xff { return false } }
        i0 += self.a_stride
      }
      return true
    }
    let b = bpp(k)
    let off = if k == ALPHA || k == ALPHA16 { 0 } else { b - b / 4 }
    let wide = k == RGBA64 || k == NRGBA64 || k == ALPHA16
    var row = 0
    for _ in self.rect.min.y..self.rect.max.y {
      var i = row + off
      while i < row + self.rect.dx() * b {
        if self.pix[i] != 0xff || (wide && self.pix[i + 1] != 0xff) { return false }
        i += b
      }
      row += self.stride
    }
    true
  }
}
