// std.debug.elf：ELF 目标文件读取（对齐 Go 1.27 的 debug/elf）
//   elf.new_file(bytes) / elf.open(path) -> Result<File, Str>
//   File：hdr（FileHeader）、sections、progs；方法 section(name)、section_by_type(t)、symbols()、
//         dynamic_symbols()、imported_symbols()、imported_libraries()、dyn_string(tag)、dyn_value(tag)、
//         dynamic_versions()、dynamic_version_needs()
//   Section：data()（含 SHF_COMPRESSED 和 .zdebug 的 zlib 解压）
//   常量与 Go 同名（ELFCLASS64、SHT_SYMTAB、R_X86_64_64…）；每个常量类型 T 有 t_string(i) / t_go_string(i)
//   （class_string、machine_string、section_flag_string、r_x86_64_string……），输出与 Go 的 String()/GoString() 相同。
//   st_bind / st_type / st_visibility / st_info、r_sym32 / r_type32 / r_info32 / r_sym64 / r_type64 / r_info。
// 和 Go 的差别：
//   - 不做 DWARF()（另见 debug/dwarf）和重定位应用；Prog 没有 Open()。
//   - 值不可变：Go 里 .zdebug 节在 Open() 之后改写 Size，这里不改。
//   - zstd 压缩节返回错误 "zstd compressed sections are not supported"；zlib 解码错误文字是 Kite 的。
//   - 字符串表里的名字不是合法 UTF-8 时按字节逐个转成 U+0000..U+00FF 的字符。
//   - 只接受字节列表（Go 的 io.ReaderAt 换成 List<Int>）。

use std.compress.zlib
use std.math.bits

// ───────── 名字表 ─────────

fn ustr(x: Int) -> Str { bits.ustr(x) }

fn uhex(x: Int) -> Str {
  if x == 0 { return "0" }
  let ds = "0123456789abcdef"
  var s = ""
  var v = x
  while v != 0 {
    s = __str_slice(ds, v & 15, (v & 15) + 1) + s
    v = bits.shr(v, 4)
  }
  s
}

fn string_name(i: Int, names: List<(Int, Str)>, go_syntax: Bool) -> Str {
  for (k, s) in names {
    if k == i { return if go_syntax { "elf." + s } else { s } }
  }
  var j = len(names) - 1
  while j >= 0 {
    let (k, s) = names[j]
    if k < i {
      let p = if go_syntax { "elf." + s } else { s }
      return p + "+" + ustr(i - k)
    }
    j -= 1
  }
  ustr(i)
}

fn flag_name(i0: Int, names: List<(Int, Str)>, go_syntax: Bool) -> Str {
  var i = i0
  var s = ""
  for (k, n) in names {
    if k & i == k {
      if len(s) > 0 { s = s + "+" }
      if go_syntax { s = s + "elf." }
      s = s + n
      i = i - k
    }
  }
  if len(s) == 0 { return "0x" + uhex(i) }
  if i != 0 { s = s + "+0x" + uhex(i) }
  s
}

pub fn st_bind(info: Int) -> Int { (info & 0xff) >> 4 }

pub fn st_type(info: Int) -> Int { info & 0xf }

pub fn st_info(bind: Int, typ: Int) -> Int { ((bind << 4) | (typ & 0xf)) & 0xff }

pub fn st_visibility(other: Int) -> Int { other & 3 }

pub fn r_sym32(info: Int) -> Int { (info & 0xffffffff) >> 8 }

pub fn r_type32(info: Int) -> Int { info & 0xff }

pub fn r_info32(sym: Int, typ: Int) -> Int { ((sym << 8) | typ) & 0xffffffff }

pub fn r_sym64(info: Int) -> Int { bits.shr(info, 32) }

pub fn r_type64(info: Int) -> Int { info & 0xffffffff }

pub fn r_info(sym: Int, typ: Int) -> Int { (sym << 32) | (typ & 0xffffffff) }

// VersionIndex
pub fn version_index_is_hidden(vi: Int) -> Bool { vi & 0x8000 != 0 }

pub fn version_index_index(vi: Int) -> Int { vi & 0x7fff }

// ───────── 类型 ─────────

pub type FileHeader = {
  class: Int,
  data: Int,
  version: Int,
  osabi: Int,
  abi_version: Int,
  byte_order: Str,
  typ: Int,
  machine: Int,
  entry: Int,
}

pub type Section = {
  name: Str,
  typ: Int,
  flags: Int,
  addr: Int,
  offset: Int,
  size: Int,
  link: Int,
  info: Int,
  addralign: Int,
  entsize: Int,
  file_size: Int,
  raw: List<Int>,
  ctype: Int,
  coff: Int,
}

pub type Prog = {
  typ: Int,
  flags: Int,
  off: Int,
  vaddr: Int,
  paddr: Int,
  filesz: Int,
  memsz: Int,
  align: Int,
}

pub type Symbol = {
  name: Str,
  info: Int,
  other: Int,
  has_version: Bool,
  version_index: Int,
  section: Int,
  value: Int,
  size: Int,
  version: Str,
  library: Str,
}

pub type ImportedSymbol = { name: Str, version: Str, library: Str }

pub type DynamicVersion = { name: Str, index: Int, flags: Int, deps: List<Str> }

pub type DynamicVersionDep = { flags: Int, index: Int, dep: Str }

pub type DynamicVersionNeed = { name: Str, needs: List<DynamicVersionDep> }

pub type File = { hdr: FileHeader, sections: List<Section>, progs: List<Prog> }

pub const ERR_NO_SYMBOLS: Str = "no symbol section"

// FormatError 的文字
fn fe(off: Int, msg: Str, val: Str?) -> Str {
  let mid = match val {
    Some(v) => " '" + v + "' ",
    None => "",
  }
  msg + mid + "in record at byte 0x" + uhex(off)
}

fn bytes_v(bs: List<Int>) -> Str {
  var s = "["
  var i = 0
  for b in bs {
    if i > 0 { s = s + " " }
    s = s + "{b}"
    i += 1
  }
  s + "]"
}

// ───────── 读字节 ─────────

fn u16(be: Bool, d: List<Int>, i: Int) -> Int {
  if be { (d[i] << 8) | d[i + 1] } else { d[i] | (d[i + 1] << 8) }
}

fn u32(be: Bool, d: List<Int>, i: Int) -> Int {
  if be {
    (d[i] << 24) | (d[i + 1] << 16) | (d[i + 2] << 8) | d[i + 3]
  } else {
    d[i] | (d[i + 1] << 8) | (d[i + 2] << 16) | (d[i + 3] << 24)
  }
}

fn u64(be: Bool, d: List<Int>, i: Int) -> Int {
  if be {
    (u32(be, d, i) << 32) | u32(be, d, i + 4)
  } else {
    u32(be, d, i) | (u32(be, d, i + 4) << 32)
  }
}

fn s32(x: Int) -> Int { if x >= 0x80000000 { x - 0x100000000 } else { x } }

// io.ReaderAt.ReadAt：读满 n 字节，否则 EOF（off 超出也是 EOF）
fn read_at(bs: List<Int>, off: Int, n: Int) -> Result<List<Int>, Str> {
  if n == 0 { return Ok([]) }
  if off < 0 || off >= len(bs) { return Err("EOF") }
  if n > len(bs) - off { return Err("EOF") }
  Ok(bs[off..off + n])
}

// saferio.ReadDataAt
fn read_data_at(bs: List<Int>, n: Int, off: Int) -> Result<List<Int>, Str> {
  if n < 0 { return Err("unexpected EOF") }
  read_at(bs, off, n)
}

// io.ReadFull 读 want 字节，源里有 avail
fn read_full(src: List<Int>, want: Int) -> Result<List<Int>, Str> {
  if want < 0 { return Err("unexpected EOF") }
  if want == 0 { return Ok([]) }
  if len(src) == 0 { return Err("EOF") }
  if len(src) < want { return Err("unexpected EOF") }
  Ok(take(src, want))
}

fn get_string(sec: List<Int>, start: Int) -> (Str, Bool) {
  if start < 0 || start >= len(sec) { return ("", false) }
  var end = start
  while end < len(sec) {
    if sec[end] == 0 { return (bstr(sec[start..end]), true) }
    end += 1
  }
  ("", false)
}

fn bstr(bs: List<Int>) -> Str {
  match __from_bytes(bs) {
    Some(s) => s,
    None => {
      var s = ""
      for b in bs { s = s + __chr(b) }
      s
    },
  }
}

fn starts_with_b(bs: List<Int>, s: Str) -> Bool {
  let p = __bytes(s)
  if len(bs) < len(p) { return false }
  for i in 0..len(p) {
    if bs[i] != p[i] { return false }
  }
  true
}

// ───────── Section ─────────

impl Section {
  // Section.Data()
  pub fn data(self) -> Result<List<Int>, Str> {
    if self.typ == SHT_NOBITS {
      if self.size == 0 { return Ok([]) }
      return Err("unexpected read from SHT_NOBITS section")
    }
    if self.flags & SHF_COMPRESSED == 0 {
      let nm = __bytes(self.name)
      if !starts_with_b(nm, ".zdebug") || len(self.raw) < 12 || !starts_with_b(self.raw, "ZLIB") {
        return read_full(self.raw, self.size)
      }
      let size = u64(true, self.raw, 4)
      let out = zlib.decompress(self.raw[12..len(self.raw)])?
      return read_full(out, size)
    }
    if self.flags & SHF_ALLOC != 0 {
      return Err(
        fe(
          self.offset,
          "SHF_COMPRESSED applies only to non-allocable sections",
          Some(compression_type_string(self.ctype)),
        ),
      )
    }
    if self.ctype == COMPRESS_ZLIB {
      let n = if self.coff > len(self.raw) { len(self.raw) } else { self.coff }
      let out = zlib.decompress(self.raw[n..len(self.raw)])?
      return read_full(out, self.size)
    }
    if self.ctype == COMPRESS_ZSTD { return Err("zstd compressed sections are not supported") }
    Err(fe(self.offset, "unknown compression type", Some(compression_type_string(self.ctype))))
  }
}

// ───────── NewFile ─────────

pub fn open(path: Str) -> Result<File, Str> { new_file(__read_bytes(path)?) }

pub fn new_file(r: List<Int>) -> Result<File, Str> {
  let ident = match read_at(r, 0, 16) {
    Ok(x) => x,
    Err(e) => { return Err(fe(0, "cannot read ELF identifier", Some(e))) },
  }
  if ident[0] != 0x7f || ident[1] != 69 || ident[2] != 76 || ident[3] != 70 {
    return Err(fe(0, "bad magic number", Some(bytes_v(take(ident, 4)))))
  }
  let class = ident[EI_CLASS]
  if class != ELFCLASS32 && class != ELFCLASS64 {
    return Err(fe(0, "unknown ELF class", Some(class_string(class))))
  }
  let data = ident[EI_DATA]
  if data != ELFDATA2LSB && data != ELFDATA2MSB {
    return Err(fe(0, "unknown ELF data encoding", Some(data_string(data))))
  }
  let be = data == ELFDATA2MSB
  let version = ident[EI_VERSION]
  if version != EV_CURRENT {
    return Err(fe(0, "unknown ELF version", Some(version_string(version))))
  }
  let is64 = class == ELFCLASS64
  let hsz = if is64 { 64 } else { 52 }
  let h = read_at(r, 0, hsz)?
  let typ = u16(be, h, 16)
  let machine = u16(be, h, 18)
  let v = u32(be, h, 20)
  var entry = 0
  var phoff = 0
  var shoff = 0
  var b = 0
  if is64 {
    entry = u64(be, h, 24)
    phoff = u64(be, h, 32)
    shoff = u64(be, h, 40)
    b = 52
  } else {
    entry = u32(be, h, 24)
    phoff = u32(be, h, 28)
    shoff = u32(be, h, 32)
    b = 40
  }
  if v != version { return Err(fe(0, "mismatched ELF version", Some(version_string(v)))) }
  let phentsize = u16(be, h, b + 2)
  var phnum = u16(be, h, b + 4)
  let shentsize = u16(be, h, b + 6)
  var shnum = u16(be, h, b + 8)
  var shstrndx = u16(be, h, b + 10)
  let hdr = FileHeader {
    class: class,
    data: data,
    version: version,
    osabi: ident[EI_OSABI],
    abi_version: ident[EI_ABIVERSION],
    byte_order: if be { "BigEndian" } else { "LittleEndian" },
    typ: typ,
    machine: machine,
    entry: entry,
  }
  if shoff < 0 { return Err(fe(0, "invalid shoff", Some("{shoff}"))) }
  if phoff < 0 { return Err(fe(0, "invalid phoff", Some("{phoff}"))) }
  if shoff == 0 && shnum != 0 {
    return Err(fe(0, "invalid ELF shnum for shoff=0", Some("{shnum}")))
  }
  if shnum > 0 && shstrndx >= shnum {
    return Err(fe(0, "invalid ELF shstrndx", Some("{shstrndx}")))
  }
  let want_ph = if is64 { 56 } else { 32 }
  let want_sh = if is64 { 64 } else { 40 }
  if phnum > 0 && phentsize < want_ph {
    return Err(fe(0, "invalid ELF phentsize", Some("{phentsize}")))
  }
  if shoff > 0 && (shnum == 0 || phnum == 0xffff) {
    // binary.Read 读第 0 个节头
    let n0 = if is64 { 64 } else { 40 }
    let sh = match read_at(r, shoff, n0) {
      Ok(x) => x,
      Err(_) => {
        let avail = if shoff >= len(r) { 0 } else { len(r) - shoff }
        return Err(if avail == 0 { "EOF" } else { "unexpected EOF" })
      },
    }
    let styp = u32(be, sh, 4)
    let link = if is64 { u32(be, sh, 40) } else { u32(be, sh, 24) }
    let info = if is64 { u32(be, sh, 44) } else { u32(be, sh, 28) }
    let size = if is64 { u64(be, sh, 32) } else { u32(be, sh, 20) }
    if styp != SHT_NULL {
      return Err(fe(shoff, "invalid type of the initial section", Some(section_type_string(styp))))
    }
    if shnum == 0 {
      if bits.ult(size, SHN_LORESERVE) {
        return Err(fe(shoff, "invalid ELF shnum contained in sh_size", Some("{shnum}")))
      }
      shnum = size
    }
    if phnum == 0xffff {
      if info < 0xffff {
        return Err(fe(shoff, "invalid ELF phnum contained in sh_info", Some("{info}")))
      }
      phnum = info
    }
    if shstrndx == SHN_XINDEX {
      shstrndx = link
      if shstrndx < SHN_LORESERVE || shstrndx >= shnum {
        return Err(fe(shoff, "invalid ELF shstrndx contained in sh_link", Some("{shstrndx}")))
      }
    }
  }
  // 程序头
  let phdata = read_data_at(r, phnum * phentsize, phoff)?
  var progs: List<Prog> = []
  for i in 0..phnum {
    let o = i * phentsize
    let p = if is64 {
      Prog {
        typ: u32(be, phdata, o),
        flags: u32(be, phdata, o + 4),
        off: u64(be, phdata, o + 8),
        vaddr: u64(be, phdata, o + 16),
        paddr: u64(be, phdata, o + 24),
        filesz: u64(be, phdata, o + 32),
        memsz: u64(be, phdata, o + 40),
        align: u64(be, phdata, o + 48),
      }
    } else {
      Prog {
        typ: u32(be, phdata, o),
        off: u32(be, phdata, o + 4),
        vaddr: u32(be, phdata, o + 8),
        paddr: u32(be, phdata, o + 12),
        filesz: u32(be, phdata, o + 16),
        memsz: u32(be, phdata, o + 20),
        flags: u32(be, phdata, o + 24),
        align: u32(be, phdata, o + 28),
      }
    }
    if p.off < 0 {
      return Err(fe(phoff + o, "invalid program header offset", Some(ustr(p.off))))
    }
    if p.filesz < 0 {
      return Err(fe(phoff + o, "invalid program header file size", Some(ustr(p.filesz))))
    }
    progs = push(progs, p)
  }
  if shnum > 0 && shentsize < want_sh {
    return Err(fe(0, "invalid ELF shentsize", Some("{shentsize}")))
  }
  if shnum < 0 { return Err(fe(0, "too many sections", Some("{shnum}"))) }
  if shnum > 0 && shentsize > 0 && shnum > 9223372036854775807 / shentsize {
    return Err("unexpected EOF")
  }
  let shdata = read_data_at(r, shnum * shentsize, shoff)?
  var secs: List<Section> = []
  var names: List<Int> = []
  for i in 0..shnum {
    let o = i * shentsize
    names = push(names, u32(be, shdata, o))
    var s = if is64 {
      Section {
        name: "",
        typ: u32(be, shdata, o + 4),
        flags: u64(be, shdata, o + 8),
        addr: u64(be, shdata, o + 16),
        offset: u64(be, shdata, o + 24),
        size: 0,
        file_size: u64(be, shdata, o + 32),
        link: u32(be, shdata, o + 40),
        info: u32(be, shdata, o + 44),
        addralign: u64(be, shdata, o + 48),
        entsize: u64(be, shdata, o + 56),
        raw: [],
        ctype: 0,
        coff: 0,
      }
    } else {
      Section {
        name: "",
        typ: u32(be, shdata, o + 4),
        flags: u32(be, shdata, o + 8),
        addr: u32(be, shdata, o + 12),
        offset: u32(be, shdata, o + 16),
        size: 0,
        file_size: u32(be, shdata, o + 20),
        link: u32(be, shdata, o + 24),
        info: u32(be, shdata, o + 28),
        addralign: u32(be, shdata, o + 32),
        entsize: u32(be, shdata, o + 36),
        raw: [],
        ctype: 0,
        coff: 0,
      }
    }
    if s.offset < 0 { return Err(fe(shoff + o, "invalid section offset", Some("{s.offset}"))) }
    if s.file_size < 0 {
      return Err(fe(shoff + o, "invalid section size", Some("{s.file_size}")))
    }
    // 节在文件里的那段（SectionReader 截到文件末尾）
    let a = if s.offset > len(r) { len(r) } else { s.offset }
    let e = if s.file_size > len(r) - a { len(r) } else { a + s.file_size }
    s = Section { raw: r[a..e], ..s }
    if s.flags & SHF_COMPRESSED == 0 {
      s = Section { size: s.file_size, ..s }
    } else {
      let n = if is64 { 24 } else { 12 }
      let ch = read_at(s.raw, 0, n)?
      if is64 {
        s = Section {
          ctype: u32(be, ch, 0),
          size: u64(be, ch, 8),
          addralign: u64(be, ch, 16),
          coff: 24,
          ..s
        }
      } else {
        s = Section {
          ctype: u32(be, ch, 0),
          size: u32(be, ch, 4),
          addralign: u32(be, ch, 8),
          coff: 12,
          ..s
        }
      }
    }
    secs = push(secs, s)
  }
  let f0 = File { hdr: hdr, sections: secs, progs: progs }
  if len(secs) == 0 || shstrndx == 0 { return Ok(f0) }
  let shstr = secs[shstrndx]
  if shstr.typ != SHT_STRTAB {
    return Err(
      fe(
        shoff + shstrndx * shentsize,
        "invalid ELF section name string table type",
        Some(section_type_string(shstr.typ)),
      ),
    )
  }
  let tab = shstr.data()?
  var out: List<Section> = []
  for i in 0..len(secs) {
    let (nm, ok) = get_string(tab, names[i])
    if !ok { return Err(fe(shoff + i * shentsize, "bad section name index", Some(ustr(names[i])))) }
    out = push(out, Section { name: nm, ..secs[i] })
  }
  Ok(File { sections: out, ..f0 })
}

fn data_or_empty(s: Section) -> List<Int> {
  match s.data() {
    Ok(d) => d,
    Err(_) => [],
  }
}

type Ver = { versym: List<Int>, vers: List<DynamicVersion>, needs: List<DynamicVersionNeed> }

impl File {
  pub fn section(self, name: Str) -> Section? {
    for s in self.sections {
      if s.name == name { return Some(s) }
    }
    None
  }

  pub fn section_by_type(self, typ: Int) -> Section? {
    for s in self.sections {
      if s.typ == typ { return Some(s) }
    }
    None
  }

  fn be(self) -> Bool { self.hdr.data == ELFDATA2MSB }

  fn string_table(self, link: Int) -> Result<List<Int>, Str> {
    if link <= 0 || link >= len(self.sections) {
      return Err("section has invalid string table link")
    }
    self.sections[link].data()
  }

  fn get_symbols(self, typ: Int) -> Result<(List<Symbol>, List<Int>), Str> {
    let Some(st) = self.section_by_type(typ) else { return Err(ERR_NO_SYMBOLS) }
    let data = match st.data() {
      Ok(d) => d,
      Err(e) => { return Err("cannot load symbol section: " + e) },
    }
    if len(data) == 0 { return Err(ERR_NO_SYMBOLS) }
    let is64 = self.hdr.class == ELFCLASS64
    let sz = if is64 { 24 } else { 16 }
    if len(data) % sz != 0 {
      return Err(
        if is64 {
          "length of symbol section is not a multiple of Sym64Size"
        } else {
          "length of symbol section is not a multiple of SymSize"
        },
      )
    }
    let strdata = match self.string_table(st.link) {
      Ok(d) => d,
      Err(e) => { return Err("cannot load string table section: " + e) },
    }
    let be = self.be()
    var syms: List<Symbol> = []
    var o = sz
    while o < len(data) {
      let nmo = u32(be, data, o)
      let (nm, _) = get_string(strdata, nmo)
      let s = if is64 {
        Symbol {
          name: nm,
          info: data[o + 4],
          other: data[o + 5],
          section: u16(be, data, o + 6),
          value: u64(be, data, o + 8),
          size: u64(be, data, o + 16),
          has_version: false,
          version_index: 0,
          version: "",
          library: "",
        }
      } else {
        Symbol {
          name: nm,
          value: u32(be, data, o + 4),
          size: u32(be, data, o + 8),
          info: data[o + 12],
          other: data[o + 13],
          section: u16(be, data, o + 14),
          has_version: false,
          version_index: 0,
          version: "",
          library: "",
        }
      }
      syms = push(syms, s)
      o += sz
    }
    Ok((syms, strdata))
  }

  pub fn symbols(self) -> Result<List<Symbol>, Str> {
    let (s, _) = self.get_symbols(SHT_SYMTAB)?
    Ok(s)
  }

  fn dyn_versions(self, str: List<Int>) -> Result<List<DynamicVersion>, Str> {
    let Some(vd) = self.section_by_type(SHT_GNU_VERDEF) else { return Ok([]) }
    let d = data_or_empty(vd)
    let be = self.be()
    var out: List<DynamicVersion> = []
    var i = 0
    loop {
      if i + 20 > len(d) { break }
      let version = u16(be, d, i)
      if version != 1 {
        return Err(fe(vd.offset + i, "unexpected dynamic version", Some("{version}")))
      }
      let flags = u16(be, d, i + 2)
      let ndx = u16(be, d, i + 4)
      let cnt = u16(be, d, i + 6)
      let aux = u32(be, d, i + 12)
      let next = u32(be, d, i + 16)
      if cnt == 0 { return Err(fe(vd.offset + i, "dynamic version has no name", None)) }
      var name = ""
      var deps: List<Str> = []
      var j = i + aux
      var c = 0
      while c < cnt {
        if j + 8 > len(d) { break }
        let vname = u32(be, d, j)
        let vnext = u32(be, d, j + 4)
        let (dn, _) = get_string(str, vname)
        if c == 0 { name = dn } else { deps = push(deps, dn) }
        if vnext == 0 { break }
        j += vnext
        c += 1
      }
      out = push(out, DynamicVersion { name: name, index: ndx, flags: flags, deps: deps })
      if next == 0 { break }
      i += next
    }
    Ok(out)
  }

  fn dyn_needs(self, str: List<Int>) -> Result<List<DynamicVersionNeed>, Str> {
    let Some(vn) = self.section_by_type(SHT_GNU_VERNEED) else { return Ok([]) }
    let d = data_or_empty(vn)
    let be = self.be()
    var out: List<DynamicVersionNeed> = []
    var i = 0
    loop {
      if i + 16 > len(d) { break }
      let vers = u16(be, d, i)
      if vers != 1 {
        return Err(fe(vn.offset + i, "unexpected dynamic need version", Some("{vers}")))
      }
      let cnt = u16(be, d, i + 2)
      let fileoff = u32(be, d, i + 4)
      let aux = u32(be, d, i + 8)
      let next = u32(be, d, i + 12)
      let (file, _) = get_string(str, fileoff)
      var deps: List<DynamicVersionDep> = []
      var j = i + aux
      var c = 0
      while c < cnt {
        if j + 16 > len(d) { break }
        let flags = u16(be, d, j + 4)
        let index = u16(be, d, j + 6)
        let nameoff = u32(be, d, j + 8)
        let jn = u32(be, d, j + 12)
        let (dn, _) = get_string(str, nameoff)
        deps = push(deps, DynamicVersionDep { flags: flags, index: index, dep: dn })
        if jn == 0 { break }
        j += jn
        c += 1
      }
      out = push(out, DynamicVersionNeed { name: file, needs: deps })
      if next == 0 { break }
      i += next
    }
    Ok(out)
  }

  fn gnu_version_init(self, str: List<Int>) -> Result<Ver?, Str> {
    let Some(vs) = self.section_by_type(SHT_GNU_VERSYM) else { return Ok(None) }
    let d = data_or_empty(vs)
    let vers = self.dyn_versions(str)?
    let needs = self.dyn_needs(str)?
    Ok(Some(Ver { versym: d, vers: vers, needs: needs }))
  }

  fn gnu_version(self, v: Ver, i0: Int) -> (Bool, Int, Str, Str) {
    let i = (i0 + 1) * 2
    if i >= len(v.versym) || len(v.versym) - i < 2 { return (false, 0, "", "") }
    let vi = u16(self.be(), v.versym, i)
    let ndx = vi & 0x7fff
    if ndx == 0 || ndx == 1 { return (true, vi, "", "") }
    for n in v.needs {
      for d in n.needs {
        if ndx == d.index { return (true, vi, d.dep, n.name) }
      }
    }
    for d in v.vers {
      if ndx == d.index { return (true, vi, d.name, "") }
    }
    (false, 0, "", "")
  }

  pub fn dynamic_symbols(self) -> Result<List<Symbol>, Str> {
    let (syms, str) = self.get_symbols(SHT_DYNSYM)?
    let Some(v) = self.gnu_version_init(str)? else { return Ok(syms) }
    var out: List<Symbol> = []
    var i = 0
    for s in syms {
      let (h, vi, ver, lib) = self.gnu_version(v, i)
      out = push(out, Symbol { has_version: h, version_index: vi, version: ver, library: lib, ..s })
      i += 1
    }
    Ok(out)
  }

  pub fn imported_symbols(self) -> Result<List<ImportedSymbol>, Str> {
    let (syms, str) = self.get_symbols(SHT_DYNSYM)?
    let vo = self.gnu_version_init(str)?
    var all: List<ImportedSymbol> = []
    var i = 0
    for s in syms {
      if st_bind(s.info) == STB_GLOBAL && s.section == SHN_UNDEF {
        let (ver, lib) = match vo {
          Some(v) => {
            let (_, _, a, b) = self.gnu_version(v, i)
            (a, b)
          },
          None => ("", ""),
        }
        all = push(all, ImportedSymbol { name: s.name, version: ver, library: lib })
      }
      i += 1
    }
    Ok(all)
  }

  pub fn dynamic_versions(self) -> Result<List<DynamicVersion>, Str> {
    let (_, str) = self.get_symbols(SHT_DYNSYM)?
    let Some(v) = self.gnu_version_init(str)? else {
      return Err("DynamicVersions: missing version table")
    }
    Ok(v.vers)
  }

  pub fn dynamic_version_needs(self) -> Result<List<DynamicVersionNeed>, Str> {
    let (_, str) = self.get_symbols(SHT_DYNSYM)?
    let Some(v) = self.gnu_version_init(str)? else {
      return Err("DynamicVersionNeeds: missing version table")
    }
    Ok(v.needs)
  }

  pub fn imported_libraries(self) -> Result<List<Str>, Str> { self.dyn_string(DT_NEEDED) }

  fn dyn_entries(self) -> Result<(Section, List<(Int, Int)>)?, Str> {
    let Some(ds) = self.section_by_type(SHT_DYNAMIC) else { return Ok(None) }
    let d = ds.data()?
    let is64 = self.hdr.class == ELFCLASS64
    let sz = if is64 { 16 } else { 8 }
    if len(d) % sz != 0 {
      return Err("length of dynamic section is not a multiple of dynamic entry size")
    }
    let be = self.be()
    var out: List<(Int, Int)> = []
    var o = 0
    while o < len(d) {
      if is64 {
        out = push(out, (u64(be, d, o), u64(be, d, o + 8)))
      } else {
        out = push(out, (u32(be, d, o), u32(be, d, o + 4)))
      }
      o += sz
    }
    Ok(Some((ds, out)))
  }

  pub fn dyn_string(self, tag: Int) -> Result<List<Str>, Str> {
    if tag != DT_NEEDED && tag != DT_SONAME && tag != DT_RPATH && tag != DT_RUNPATH {
      return Err("non-string-valued tag " + dyn_tag_string(tag))
    }
    let Some((ds, es)) = self.dyn_entries()? else { return Ok([]) }
    let str = self.string_table(ds.link)?
    var all: List<Str> = []
    for (t, v) in es {
      if t == tag {
        let (s, ok) = get_string(str, v)
        if ok { all = push(all, s) }
      }
    }
    Ok(all)
  }

  pub fn dyn_value(self, tag: Int) -> Result<List<Int>, Str> {
    let Some((_, es)) = self.dyn_entries()? else { return Ok([]) }
    var vals: List<Int> = []
    for (t, v) in es {
      if t == tag { vals = push(vals, v) }
    }
    Ok(vals)
  }
}

