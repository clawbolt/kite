// std.crypto.ecdh：对齐 Go 1.27 的 crypto/ecdh（X25519、P-256、P-384、P-521）
//   曲线用编号：X25519 = 0，P256 = 1，P384 = 2，P521 = 3。
//   new_private_key / new_public_key 校验输入，ecdh 计算共享密钥，错误文字与 Go 相同。
//   不提供 GenerateKey（随机数由调用方给出私钥字节）

use std.math.big
use std.crypto.ed25519
use std.crypto.internal.nistec
use std.crypto.internal.nistec.{ Curve }

pub const X25519: Int = 0
pub const P256: Int = 1
pub const P384: Int = 2
pub const P521: Int = 3

pub type PrivateKey = { curve: Int, d: List<Int>, pub_: List<Int> }

pub type PublicKey = { curve: Int, q: List<Int> }

pub fn curve_name(c: Int) -> Str {
  if c == 0 { "X25519" } else if c == 1 { "P-256" } else if c == 2 { "P-384" } else { "P-521" }
}

fn nist(c: Int) -> Curve {
  if c == P256 { nistec.p256() } else if c == P384 { nistec.p384() } else { nistec.p521() }
}

// ── X25519（RFC 7748） ──

pub fn x25519(scalar: List<Int>, point: List<Int>) -> List<Int> {
  var e = scalar
  e = set(e, 0, e[0] & 248)
  e = set(e, 31, (e[31] & 127) | 64)
  let x1 = ed25519.fe_unpack(point)
  var x2 = ed25519.fe_one()
  var z2 = ed25519.fe_zero()
  var x3 = x1
  var z3 = ed25519.fe_one()
  let a24 = [121665, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  var swap = 0
  var t = 254
  while t >= 0 {
    let kt = (e[t / 8] >> (t % 8)) & 1
    swap = swap ^ kt
    if swap == 1 {
      let tx = x2
      x2 = x3
      x3 = tx
      let tz = z2
      z2 = z3
      z3 = tz
    }
    swap = kt
    let a = ed25519.fe_add(x2, z2)
    let aa = ed25519.fe_mul(a, a)
    let b = ed25519.fe_sub(x2, z2)
    let bb = ed25519.fe_mul(b, b)
    let ee = ed25519.fe_sub(aa, bb)
    let c = ed25519.fe_add(x3, z3)
    let d = ed25519.fe_sub(x3, z3)
    let da = ed25519.fe_mul(d, a)
    let cb = ed25519.fe_mul(c, b)
    let s1 = ed25519.fe_add(da, cb)
    x3 = ed25519.fe_mul(s1, s1)
    let s2 = ed25519.fe_sub(da, cb)
    z3 = ed25519.fe_mul(x1, ed25519.fe_mul(s2, s2))
    x2 = ed25519.fe_mul(aa, bb)
    z2 = ed25519.fe_mul(ee, ed25519.fe_add(aa, ed25519.fe_mul(a24, ee)))
    t -= 1
  }
  if swap == 1 {
    x2 = x3
    z2 = z3
  }
  ed25519.fe_pack(ed25519.fe_mul(x2, ed25519.fe_inv(z2)))
}

fn is_zero(b: List<Int>) -> Bool { all(b, (x) => x == 0) }

// ── 公开接口 ──

pub fn new_private_key(curve: Int, key: List<Int>) -> Result<PrivateKey, Str> {
  if curve == X25519 {
    if len(key) != 32 { return Err("crypto/ecdh: invalid private key size") }
    return Ok(PrivateKey {
      curve: curve,
      d: key,
      pub_: x25519(key, set(map(0..32, (_) => 0), 0, 9)),
    })
  }
  let c = nist(curve)
  if len(key) != c.size || is_zero(key) || big.set_bytes(key).cmp(c.n) >= 0 {
    return Err("crypto/ecdh: invalid private key")
  }
  let p = nistec.scalar_mult(c, nistec.generator(c), key)
  Ok(PrivateKey { curve: curve, d: key, pub_: nistec.encode(c, p) })
}

pub fn new_public_key(curve: Int, key: List<Int>) -> Result<PublicKey, Str> {
  if curve == X25519 {
    if len(key) != 32 { return Err("crypto/ecdh: invalid public key") }
    return Ok(PublicKey { curve: curve, q: key })
  }
  if len(key) == 0 || key[0] != 4 { return Err("crypto/ecdh: invalid public key") }
  let c = nist(curve)
  let _ = nistec.decode(c, key)?
  Ok(PublicKey { curve: curve, q: key })
}

pub fn public_key(k: PrivateKey) -> PublicKey { PublicKey { curve: k.curve, q: k.pub_ } }

pub fn ecdh(k: PrivateKey, remote: PublicKey) -> Result<List<Int>, Str> {
  if k.curve != remote.curve {
    return Err("crypto/ecdh: private key and public key curves do not match")
  }
  if k.curve == X25519 {
    let out = x25519(k.d, remote.q)
    if is_zero(out) { return Err("crypto/ecdh: bad X25519 remote ECDH input: low order point") }
    return Ok(out)
  }
  let c = nist(k.curve)
  let p = nistec.decode(c, remote.q)?
  match nistec.to_affine(c, nistec.scalar_mult(c, p, k.d)) {
    None => Err(short_name(k.curve) + " point is the point at infinity"),
    Some((x, _)) => Ok(nistec.be_bytes(x, c.size)),
  }
}

fn short_name(c: Int) -> Str { if c == 1 { "P256" } else if c == 2 { "P384" } else { "P521" } }
