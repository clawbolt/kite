// std.crypto.md5：MD5 摘要（对齐 Go 的 crypto/md5）
//   sum(s) / sum_bytes(bs)：十六进制小写字符串；digest(bs)：16 个字节

pub const SIZE: Int = 16

pub const BLOCK_SIZE: Int = 64

const M32: Int = 0xffffffff

fn rotl(x: Int, n: Int) -> Int { ((x << n) | (x >> (32 - n))) & M32 }

fn s_table() -> List<Int> {
  [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
   5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
   4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
   6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
}

fn k_table() -> List<Int> {
  [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
   0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
   0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
   0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
   0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
   0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
   0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
   0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]
}

pub fn digest(msg: List<Int>) -> List<Int> {
  let st = s_table()
  let kt = k_table()
  let bitlen = len(msg) * 8
  var m = push(msg, 0x80)
  while len(m) % 64 != 56 { m = push(m, 0) }
  for k in 0..8 { m = push(m, (bitlen >> (8 * k)) & 255) }
  var a0 = 0x67452301
  var b0 = 0xefcdab89
  var c0 = 0x98badcfe
  var d0 = 0x10325476
  var off = 0
  while off < len(m) {
    var w: List<Int> = []
    for t in 0..16 {
      let b = off + t * 4
      w = push(w, m[b] | (m[b + 1] << 8) | (m[b + 2] << 16) | (m[b + 3] << 24))
    }
    var a = a0
    var b = b0
    var c = c0
    var d = d0
    for i in 0..64 {
      var f = 0
      var g = 0
      if i < 16 {
        f = (b & c) | ((~b) & d)
        g = i
      } else if i < 32 {
        f = (d & b) | ((~d) & c)
        g = (5 * i + 1) % 16
      } else if i < 48 {
        f = b ^ c ^ d
        g = (3 * i + 5) % 16
      } else {
        f = c ^ (b | ((~d) & M32))
        g = (7 * i) % 16
      }
      let t = d
      d = c
      c = b
      b = (b + rotl((a + (f & M32) + kt[i] + w[g]) & M32, st[i])) & M32
      a = t
    }
    a0 = (a0 + a) & M32
    b0 = (b0 + b) & M32
    c0 = (c0 + c) & M32
    d0 = (d0 + d) & M32
    off += 64
  }
  var out: List<Int> = []
  for x in [a0, b0, c0, d0] {
    for k in 0..4 { out = push(out, (x >> (8 * k)) & 255) }
  }
  out
}

fn to_hex(bs: List<Int>) -> Str {
  let ds = chars("0123456789abcdef")
  var out = ""
  for b in bs { out = out + ds[(b >> 4) & 15] + ds[b & 15] }
  out
}

pub fn sum_bytes(bs: List<Int>) -> Str { to_hex(digest(bs)) }

pub fn sum(s: Str) -> Str { to_hex(digest(__bytes(s))) }
