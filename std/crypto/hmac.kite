// std.crypto.hmac：HMAC（对齐 Go 的 crypto/hmac），可配任意摘要函数
//   hmac.sum(sha256.digest, sha256.BLOCK_SIZE, key, msg) -> 字节列表
//   equal(a, b)：常数时间比较两个 MAC

use std.crypto.subtle

pub fn sum(h: fn(List<Int>) -> List<Int>, block_size: Int, key: List<Int>, msg: List<Int>) -> List<Int> {
  var k = if len(key) > block_size { h(key) } else { key }
  while len(k) < block_size { k = push(k, 0) }
  let ipad = map(k, (b) => b ^ 0x36)
  let opad = map(k, (b) => b ^ 0x5c)
  h(opad + h(ipad + msg))
}

pub fn equal(a: List<Int>, b: List<Int>) -> Bool { subtle.constant_time_compare(a, b) == 1 }
