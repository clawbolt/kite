// std.crypto.internal.nistec：NIST P-256 / P-384 / P-521 的域和点运算（crypto/internal/fips140/nistec 的对应物），
//   给 std.crypto.ecdh 和 std.crypto.ecdsa 用。域元素是 Montgomery 形式的 26 位分量列表（乘法由 tools/gen_nistec.py 生成），
//   点用 Jacobian 坐标（a = -3），标量乘法用 4 位窗口；不是常数时间实现。

use std.math.big
use std.math.big.{ BigInt }

pub type Curve = { id: Int, name: Str, p: BigInt, n: BigInt, b: BigInt, gx: BigInt, gy: BigInt, size: Int, nl: Int, k: List<Int>, zero: List<Int>, raw_one: List<Int>, plimbs: List<Int> }

fn hexb(s: Str) -> BigInt { unwrap(big.parse(s, 16)) }

fn limbs_of(x: BigInt, n: Int) -> List<Int> {
  var out: List<Int> = []
  var v = x
  let mask = big.new_int(67108863)
  for _ in 0..n {
    out = push(out, v.and(mask).int64())
    v = v.rsh(26)
  }
  out
}

fn mk_curve(id: Int, name: Str, p: BigInt, n: BigInt, b: BigInt, gx: BigInt, gy: BigInt, size: Int, nl: Int) -> Curve {
  let zero = map(0..nl, (_) => 0)
  Curve { id: id, name: name, p: p, n: n, b: b, gx: gx, gy: gy, size: size, nl: nl, k: limbs_of(p.lsh(5), nl), zero: zero, raw_one: set(zero, 0, 1), plimbs: limbs_of(p, nl) }
}

pub fn p256() -> Curve {
  let p = big.one().lsh(256).sub(big.one().lsh(224)).add(big.one().lsh(192)).add(big.one().lsh(96)).sub(big.one())
  mk_curve(0, "P-256", p, hexb("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"), hexb("5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"), hexb("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"), hexb("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"), 32, 11)
}

pub fn p384() -> Curve {
  let p = big.one().lsh(384).sub(big.one().lsh(128)).sub(big.one().lsh(96)).add(big.one().lsh(32)).sub(big.one())
  mk_curve(1, "P-384", p, hexb("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"), hexb("b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"), hexb("aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"), hexb("3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"), 48, 16)
}

pub fn p224() -> Curve {
  let p = big.one().lsh(224).sub(big.one().lsh(96)).add(big.one())
  mk_curve(3, "P-224", p, hexb("ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3d"), hexb("b4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4"), hexb("b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21"), hexb("bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34"), 28, 10)
}

pub fn p521() -> Curve {
  let p = big.one().lsh(521).sub(big.one())
  mk_curve(2, "P-521", p, hexb("01fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409"), hexb("0051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00"), hexb("00c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66"), hexb("011839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650"), 66, 22)
}

// ── 域 ──

fn fmul(c: Curve, a: List<Int>, b: List<Int>) -> List<Int> {
  if c.id == 0 { p256_mul(a, b) } else if c.id == 1 { p384_mul(a, b) } else if c.id == 2 { p521_mul(a, b) } else { p224_mul(a, b) }
}

fn fsq(c: Curve, a: List<Int>) -> List<Int> { fmul(c, a, a) }

fn norm(x: List<Int>) -> List<Int> {
  var out: List<Int> = []
  var carry = 0
  let n = len(x)
  for i in 0..n {
    let v = x[i] + carry
    if i == n - 1 {
      out = push(out, v)
    } else {
      carry = v >> 26
      out = push(out, v & 67108863)
    }
  }
  out
}

fn fadd(a: List<Int>, b: List<Int>) -> List<Int> {
  var out: List<Int> = []
  for i in 0..len(a) { out = push(out, a[i] + b[i]) }
  norm(out)
}

// a - b + 32p（b 必须小于 32p）
fn fsub(c: Curve, a: List<Int>, b: List<Int>) -> List<Int> {
  var out: List<Int> = []
  let k = c.k
  for i in 0..len(a) { out = push(out, a[i] + k[i] - b[i]) }
  norm(out)
}

fn fsmall(a: List<Int>, m: Int) -> List<Int> { norm(map(a, (x) => x * m)) }

fn is_zero(c: Curve, a: List<Int>) -> Bool {
  let r = fmul(c, a, c.raw_one)
  r == c.zero || r == c.plimbs
}

fn limbs_big(a: List<Int>) -> BigInt {
  var r = big.zero()
  var i = len(a) - 1
  while i >= 0 {
    r = r.lsh(26).add(big.new_int(a[i]))
    i -= 1
  }
  r
}

pub fn to_mont(c: Curve, x: BigInt) -> List<Int> { limbs_of(x.lsh(26 * c.nl).modulo(c.p), c.nl) }

pub fn from_mont(c: Curve, a: List<Int>) -> BigInt {
  let v = limbs_big(fmul(c, a, c.raw_one))
  if v.cmp(c.p) >= 0 { v.sub(c.p) } else { v }
}

// ── 点 ──

pub type Jac = { x: List<Int>, y: List<Int>, z: List<Int>, inf: Bool }

pub fn infinity(c: Curve) -> Jac { Jac { x: c.zero, y: c.zero, z: c.zero, inf: true } }

pub fn from_affine(c: Curve, x: BigInt, y: BigInt) -> Jac { Jac { x: to_mont(c, x), y: to_mont(c, y), z: to_mont(c, big.one()), inf: false } }

pub fn generator(c: Curve) -> Jac { from_affine(c, c.gx, c.gy) }

// dbl-2001-b
pub fn dbl(c: Curve, p: Jac) -> Jac {
  if p.inf { return p }
  let delta = fsq(c, p.z)
  let gamma = fsq(c, p.y)
  let beta = fmul(c, p.x, gamma)
  let alpha = fsmall(fmul(c, fsub(c, p.x, delta), fadd(p.x, delta)), 3)
  let a2 = fsq(c, alpha)
  let x3 = fsub(c, a2, fsmall(beta, 8))
  let z3 = fsub(c, fsub(c, fsq(c, fadd(p.y, p.z)), gamma), delta)
  let t = fsub(c, fsmall(beta, 12), a2)
  let y3 = fsub(c, fmul(c, alpha, t), fsmall(fsq(c, gamma), 8))
  Jac { x: x3, y: y3, z: z3, inf: false }
}

// add-2007-bl
pub fn add(c: Curve, p: Jac, q: Jac) -> Jac {
  if p.inf { return q }
  if q.inf { return p }
  let z1z1 = fsq(c, p.z)
  let z2z2 = fsq(c, q.z)
  let u1 = fmul(c, p.x, z2z2)
  let u2 = fmul(c, q.x, z1z1)
  let s1 = fmul(c, fmul(c, p.y, q.z), z2z2)
  let s2 = fmul(c, fmul(c, q.y, p.z), z1z1)
  let h = fsub(c, u2, u1)
  let r = fsub(c, s2, s1)
  if is_zero(c, h) {
    if is_zero(c, r) { return dbl(c, p) }
    return infinity(c)
  }
  let i = fsq(c, fadd(h, h))
  let j = fmul(c, h, i)
  let rr = fadd(r, r)
  let v = fmul(c, u1, i)
  let rr2 = fsq(c, rr)
  let x3 = fsub(c, fsub(c, rr2, j), fadd(v, v))
  let vx = fsub(c, fadd(fsmall(v, 3), j), rr2)
  let s1j = fmul(c, s1, j)
  let y3 = fsub(c, fmul(c, rr, vx), fadd(s1j, s1j))
  let z3 = fmul(c, fsub(c, fsub(c, fsq(c, fadd(p.z, q.z)), z1z1), z2z2), h)
  Jac { x: x3, y: y3, z: z3, inf: false }
}

fn table(c: Curve, q: Jac) -> List<Jac> {
  var t = [infinity(c), q]
  for i in 2..16 { t = push(t, if i % 2 == 0 { dbl(c, t[i / 2]) } else { add(c, t[i - 1], q) }) }
  t
}

fn nibble(s: List<Int>, i: Int) -> Int {
  // 第 i 个半字节（从最低位数起）
  let byte = s[len(s) - 1 - i / 2]
  (byte >> (4 * (i % 2))) & 15
}

// s 是大端字节串
pub fn scalar_mult(c: Curve, q: Jac, s: List<Int>) -> Jac {
  let t = table(c, q)
  var p = infinity(c)
  var i = 2 * len(s) - 1
  while i >= 0 {
    p = dbl(c, dbl(c, dbl(c, dbl(c, p))))
    let nb = nibble(s, i)
    if nb != 0 { p = add(c, p, t[nb]) }
    i -= 1
  }
  p
}

// [a]P + [b]Q
pub fn double_mult(c: Curve, p1: Jac, a: List<Int>, q1: Jac, b: List<Int>) -> Jac {
  let t1 = table(c, p1)
  let t2 = table(c, q1)
  var p = infinity(c)
  var i = 2 * len(a) - 1
  while i >= 0 {
    p = dbl(c, dbl(c, dbl(c, dbl(c, p))))
    let n1 = nibble(a, i)
    if n1 != 0 { p = add(c, p, t1[n1]) }
    let n2 = nibble(b, i)
    if n2 != 0 { p = add(c, p, t2[n2]) }
    i -= 1
  }
  p
}

// 仿射坐标；无穷远点返回 None
pub fn to_affine(c: Curve, p: Jac) -> Option<(BigInt, BigInt)> {
  if p.inf || is_zero(c, p.z) { return None }
  let z = from_mont(c, p.z)
  let zi = unwrap(z.mod_inverse(c.p))
  let zi2 = zi.mul(zi).modulo(c.p)
  let x = from_mont(c, p.x).mul(zi2).modulo(c.p)
  let y = from_mont(c, p.y).mul(zi2).mul(zi).modulo(c.p)
  Some((x, y))
}

pub fn be_bytes(x: BigInt, n: Int) -> List<Int> {
  var b = x.bytes()
  while len(b) < n { b = [0] + b }
  b
}

// 0x04 || X || Y；无穷远点编码成 [0]
pub fn encode(c: Curve, p: Jac) -> List<Int> {
  match to_affine(c, p) {
    None => [0],
    Some((x, y)) => [4] + be_bytes(x, c.size) + be_bytes(y, c.size),
  }
}

pub fn on_curve(c: Curve, x: BigInt, y: BigInt) -> Bool {
  let rhs = x.mul(x).mul(x).sub(x.mul(big.new_int(3))).add(c.b).modulo(c.p)
  y.mul(y).modulo(c.p).cmp(rhs) == 0
}

fn elem_err(c: Curve) -> Str { if c.id == 0 { "invalid P256 element encoding" } else if c.id == 1 { "invalid P384Element encoding" } else if c.id == 2 { "invalid P521Element encoding" } else { "invalid P224Element encoding" } }

pub fn short(c: Curve) -> Str { if c.id == 0 { "P256" } else if c.id == 1 { "P384" } else if c.id == 2 { "P521" } else { "P224" } }

pub fn polynomial(c: Curve, x: BigInt) -> BigInt { x.mul(x).mul(x).sub(x.mul(big.new_int(3))).add(c.b).modulo(c.p) }

// 模 p 的平方根（Tonelli-Shanks）；不是二次剩余时返回 None
pub fn mod_sqrt(a0: BigInt, p: BigInt) -> Option<BigInt> {
  let a = a0.modulo(p)
  if a.sign() == 0 { return Some(a) }
  let pm1 = p.sub(big.one())
  if unwrap(a.exp(pm1.rsh(1), p)).cmp(big.one()) != 0 { return None }
  if p.bit(1) == 1 { return Some(unwrap(a.exp(p.add(big.one()).rsh(2), p))) }
  var q = pm1
  var s = 0
  while q.bit(0) == 0 {
    q = q.rsh(1)
    s += 1
  }
  var z = big.new_int(2)
  while unwrap(z.exp(pm1.rsh(1), p)).cmp(pm1) != 0 { z = z.add(big.one()) }
  var m = s
  var cc = unwrap(z.exp(q, p))
  var t = unwrap(a.exp(q, p))
  var r = unwrap(a.exp(q.add(big.one()).rsh(1), p))
  while t.cmp(big.one()) != 0 {
    var i = 0
    var tt = t
    while tt.cmp(big.one()) != 0 {
      tt = tt.mul(tt).modulo(p)
      i += 1
    }
    var bb = cc
    for _ in 0..(m - i - 1) { bb = bb.mul(bb).modulo(p) }
    m = i
    cc = bb.mul(bb).modulo(p)
    t = t.mul(cc).modulo(p)
    r = r.mul(bb).modulo(p)
  }
  Some(r)
}

// Point.SetBytes（只接受无穷远点 [0] 和未压缩编码）
pub fn decode(c: Curve, b: List<Int>) -> Result<Jac, Str> {
  if len(b) == 1 && b[0] == 0 { return Ok(infinity(c)) }
  if len(b) == 1 + 2 * c.size && b[0] == 4 {
    let x = big.set_bytes(b[1..1 + c.size])
    if x.cmp(c.p) >= 0 { return Err(elem_err(c)) }
    let y = big.set_bytes(b[1 + c.size..])
    if y.cmp(c.p) >= 0 { return Err(elem_err(c)) }
    if !on_curve(c, x, y) { return Err(short(c) + " point not on curve") }
    return Ok(from_affine(c, x, y))
  }
  if len(b) == 1 + c.size && (b[0] == 2 || b[0] == 3) {
    let x = big.set_bytes(b[1..])
    if x.cmp(c.p) >= 0 { return Err(elem_err(c)) }
    let Some(y0) = mod_sqrt(polynomial(c, x), c.p) else { return Err("invalid " + short(c) + " compressed point encoding") }
    var y = y0
    if y.bit(0) != (b[0] & 1) { y = c.p.sub(y).modulo(c.p) }
    return Ok(from_affine(c, x, y))
  }
  Err("invalid " + short(c) + " point encoding")
}

// p256：11 个 26 位分量，R = 2^286
fn p256_mul(a: List<Int>, b: List<Int>) -> List<Int> {
  let a0 = a[0]
  let a1 = a[1]
  let a2 = a[2]
  let a3 = a[3]
  let a4 = a[4]
  let a5 = a[5]
  let a6 = a[6]
  let a7 = a[7]
  let a8 = a[8]
  let a9 = a[9]
  let a10 = a[10]
  let b0 = b[0]
  let b1 = b[1]
  let b2 = b[2]
  let b3 = b[3]
  let b4 = b[4]
  let b5 = b[5]
  let b6 = b[6]
  let b7 = b[7]
  let b8 = b[8]
  let b9 = b[9]
  let b10 = b[10]
  var t0 = a0 * b0
  var t1 = a0 * b1 + a1 * b0
  var t2 = a0 * b2 + a1 * b1 + a2 * b0
  var t3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0
  var t4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0
  var t5 = a0 * b5 + a1 * b4 + a2 * b3 + a3 * b2 + a4 * b1 + a5 * b0
  var t6 = a0 * b6 + a1 * b5 + a2 * b4 + a3 * b3 + a4 * b2 + a5 * b1 + a6 * b0
  var t7 = a0 * b7 + a1 * b6 + a2 * b5 + a3 * b4 + a4 * b3 + a5 * b2 + a6 * b1 + a7 * b0
  var t8 = a0 * b8 + a1 * b7 + a2 * b6 + a3 * b5 + a4 * b4 + a5 * b3 + a6 * b2 + a7 * b1 + a8 * b0
  var t9 = a0 * b9 + a1 * b8 + a2 * b7 + a3 * b6 + a4 * b5 + a5 * b4 + a6 * b3 + a7 * b2 + a8 * b1 + a9 * b0
  var t10 = a0 * b10 + a1 * b9 + a2 * b8 + a3 * b7 + a4 * b6 + a5 * b5 + a6 * b4 + a7 * b3 + a8 * b2 + a9 * b1 + a10 * b0
  var t11 = a1 * b10 + a2 * b9 + a3 * b8 + a4 * b7 + a5 * b6 + a6 * b5 + a7 * b4 + a8 * b3 + a9 * b2 + a10 * b1
  var t12 = a2 * b10 + a3 * b9 + a4 * b8 + a5 * b7 + a6 * b6 + a7 * b5 + a8 * b4 + a9 * b3 + a10 * b2
  var t13 = a3 * b10 + a4 * b9 + a5 * b8 + a6 * b7 + a7 * b6 + a8 * b5 + a9 * b4 + a10 * b3
  var t14 = a4 * b10 + a5 * b9 + a6 * b8 + a7 * b7 + a8 * b6 + a9 * b5 + a10 * b4
  var t15 = a5 * b10 + a6 * b9 + a7 * b8 + a8 * b7 + a9 * b6 + a10 * b5
  var t16 = a6 * b10 + a7 * b9 + a8 * b8 + a9 * b7 + a10 * b6
  var t17 = a7 * b10 + a8 * b9 + a9 * b8 + a10 * b7
  var t18 = a8 * b10 + a9 * b9 + a10 * b8
  var t19 = a9 * b10 + a10 * b9
  var t20 = a10 * b10
  var t21 = 0
  var m = 0
  m = ((t0 & 67108863) * 1) & 67108863
  t0 += m * 67108863
  t1 += m * 67108863
  t2 += m * 67108863
  t3 += m * 262143
  t7 += m * 1024
  t8 += m * 67043328
  t9 += m * 4194303
  t1 += t0 >> 26
  m = ((t1 & 67108863) * 1) & 67108863
  t1 += m * 67108863
  t2 += m * 67108863
  t3 += m * 67108863
  t4 += m * 262143
  t8 += m * 1024
  t9 += m * 67043328
  t10 += m * 4194303
  t2 += t1 >> 26
  m = ((t2 & 67108863) * 1) & 67108863
  t2 += m * 67108863
  t3 += m * 67108863
  t4 += m * 67108863
  t5 += m * 262143
  t9 += m * 1024
  t10 += m * 67043328
  t11 += m * 4194303
  t3 += t2 >> 26
  m = ((t3 & 67108863) * 1) & 67108863
  t3 += m * 67108863
  t4 += m * 67108863
  t5 += m * 67108863
  t6 += m * 262143
  t10 += m * 1024
  t11 += m * 67043328
  t12 += m * 4194303
  t4 += t3 >> 26
  m = ((t4 & 67108863) * 1) & 67108863
  t4 += m * 67108863
  t5 += m * 67108863
  t6 += m * 67108863
  t7 += m * 262143
  t11 += m * 1024
  t12 += m * 67043328
  t13 += m * 4194303
  t5 += t4 >> 26
  m = ((t5 & 67108863) * 1) & 67108863
  t5 += m * 67108863
  t6 += m * 67108863
  t7 += m * 67108863
  t8 += m * 262143
  t12 += m * 1024
  t13 += m * 67043328
  t14 += m * 4194303
  t6 += t5 >> 26
  m = ((t6 & 67108863) * 1) & 67108863
  t6 += m * 67108863
  t7 += m * 67108863
  t8 += m * 67108863
  t9 += m * 262143
  t13 += m * 1024
  t14 += m * 67043328
  t15 += m * 4194303
  t7 += t6 >> 26
  m = ((t7 & 67108863) * 1) & 67108863
  t7 += m * 67108863
  t8 += m * 67108863
  t9 += m * 67108863
  t10 += m * 262143
  t14 += m * 1024
  t15 += m * 67043328
  t16 += m * 4194303
  t8 += t7 >> 26
  m = ((t8 & 67108863) * 1) & 67108863
  t8 += m * 67108863
  t9 += m * 67108863
  t10 += m * 67108863
  t11 += m * 262143
  t15 += m * 1024
  t16 += m * 67043328
  t17 += m * 4194303
  t9 += t8 >> 26
  m = ((t9 & 67108863) * 1) & 67108863
  t9 += m * 67108863
  t10 += m * 67108863
  t11 += m * 67108863
  t12 += m * 262143
  t16 += m * 1024
  t17 += m * 67043328
  t18 += m * 4194303
  t10 += t9 >> 26
  m = ((t10 & 67108863) * 1) & 67108863
  t10 += m * 67108863
  t11 += m * 67108863
  t12 += m * 67108863
  t13 += m * 262143
  t17 += m * 1024
  t18 += m * 67043328
  t19 += m * 4194303
  t11 += t10 >> 26
  t12 += t11 >> 26
  t11 = t11 & 67108863
  t13 += t12 >> 26
  t12 = t12 & 67108863
  t14 += t13 >> 26
  t13 = t13 & 67108863
  t15 += t14 >> 26
  t14 = t14 & 67108863
  t16 += t15 >> 26
  t15 = t15 & 67108863
  t17 += t16 >> 26
  t16 = t16 & 67108863
