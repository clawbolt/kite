// std.crypto.sha256：SHA-256 摘要（对齐 Go 的 crypto/sha256），以及 HMAC-SHA256
//   sum(s) / sum_bytes(bs)：十六进制小写字符串；digest(bs)：32 个字节
//   hmac(key, msg)：十六进制小写字符串

fn k_table() -> List<Int> {
  [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
   0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
   0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
   0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
   0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
   0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
   0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
   0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
}

fn rotr(x: Int, n: Int) -> Int { ((x >> n) | (x << (32 - n))) & 0xffffffff }

pub fn digest(msg: List<Int>) -> List<Int> { digest_iv(msg, [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]) }

// SHA-224：28 个字节（Go 的 sha256.Sum224）
pub fn digest224(msg: List<Int>) -> List<Int> { take(digest_iv(msg, [0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4]), 28) }

pub fn sum224(s: Str) -> Str { to_hex(digest224(__bytes(s))) }

pub fn sum224_bytes(bs: List<Int>) -> Str { to_hex(digest224(bs)) }

pub const SIZE: Int = 32

pub const SIZE224: Int = 28

pub const BLOCK_SIZE: Int = 64

fn digest_iv(msg: List<Int>, iv: List<Int>) -> List<Int> {
  let kt = k_table()
  var h = iv
  let bitlen = len(msg) * 8
  var m = push(msg, 0x80)
  while len(m) % 64 != 56 { m = push(m, 0) }
  for k in 0..8 { m = push(m, (bitlen >> (56 - 8 * k)) & 255) }
  var off = 0
  while off < len(m) {
    var w: List<Int> = []
    for t in 0..16 {
      let b = off + t * 4
      w = push(w, (m[b] << 24) | (m[b + 1] << 16) | (m[b + 2] << 8) | m[b + 3])
    }
    for t in 16..64 {
      let x = w[t - 15]
      let y = w[t - 2]
      let s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)
      let s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10)
      w = push(w, (w[t - 16] + s0 + w[t - 7] + s1) & 0xffffffff)
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..64 {
      let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
      let ch = (e & f) ^ ((e ^ 0xffffffff) & g)
      let t1 = (hh + s1 + ch + kt[t] + w[t]) & 0xffffffff
      let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
      let mj = (a & b) ^ (a & c) ^ (b & c)
      let t2 = (s0 + mj) & 0xffffffff
      hh = g
      g = f
      f = e
      e = (d + t1) & 0xffffffff
      d = c
      c = b
      b = a
      a = (t1 + t2) & 0xffffffff
    }
    h = [(h[0] + a) & 0xffffffff, (h[1] + b) & 0xffffffff, (h[2] + c) & 0xffffffff, (h[3] + d) & 0xffffffff,
         (h[4] + e) & 0xffffffff, (h[5] + f) & 0xffffffff, (h[6] + g) & 0xffffffff, (h[7] + hh) & 0xffffffff]
    off += 64
  }
  var out: List<Int> = []
  for x in h {
    out = push(out, (x >> 24) & 255)
    out = push(out, (x >> 16) & 255)
    out = push(out, (x >> 8) & 255)
    out = push(out, x & 255)
  }
  out
}

fn to_hex(bs: List<Int>) -> Str {
  let ds = chars("0123456789abcdef")
  var out = ""
  for b in bs { out = out + ds[(b >> 4) & 15] + ds[b & 15] }
  out
}

pub fn sum_bytes(bs: List<Int>) -> Str { to_hex(digest(bs)) }

pub fn sum(s: Str) -> Str { to_hex(digest(__bytes(s))) }

// HMAC-SHA256（RFC 2104），返回 32 个字节
pub fn hmac_bytes(key: List<Int>, msg: List<Int>) -> List<Int> {
  var k = if len(key) > 64 { digest(key) } else { key }
  while len(k) < 64 { k = push(k, 0) }
  let ipad = map(k, (b) => b ^ 0x36)
  let opad = map(k, (b) => b ^ 0x5c)
  digest(opad + digest(ipad + msg))
}

pub fn hmac(key: Str, msg: Str) -> Str { to_hex(hmac_bytes(__bytes(key), __bytes(msg))) }
