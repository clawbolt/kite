// (算法, 名字, OID, 公钥算法, 哈希, 是否 PSS)
pub type SigDetail = { algo: Int, name: Str, oid: List<Int>, pub_algo: Int, hash: Int, pss: Bool }

fn sd(algo: Int, name: Str, oid: List<Int>, pub_algo: Int, hash: Int, pss: Bool) -> SigDetail {
  SigDetail { algo: algo, name: name, oid: oid, pub_algo: pub_algo, hash: hash, pss: pss }
}

pub fn signature_algorithm_details() -> List<SigDetail> {
  [
    sd(MD5_WITH_RSA, "MD5-RSA", [1, 2, 840, 113549, 1, 1, 4], RSA, 2, false),
    sd(SHA1_WITH_RSA, "SHA1-RSA", [1, 2, 840, 113549, 1, 1, 5], RSA, 3, false),
    sd(SHA1_WITH_RSA, "SHA1-RSA", [1, 3, 14, 3, 2, 29], RSA, 3, false),
    sd(SHA256_WITH_RSA, "SHA256-RSA", [1, 2, 840, 113549, 1, 1, 11], RSA, 5, false),
    sd(SHA384_WITH_RSA, "SHA384-RSA", [1, 2, 840, 113549, 1, 1, 12], RSA, 6, false),
    sd(SHA512_WITH_RSA, "SHA512-RSA", [1, 2, 840, 113549, 1, 1, 13], RSA, 7, false),
    sd(SHA256_WITH_RSAPSS, "SHA256-RSAPSS", OID_RSAPSS, RSA, 5, true),
    sd(SHA384_WITH_RSAPSS, "SHA384-RSAPSS", OID_RSAPSS, RSA, 6, true),
    sd(SHA512_WITH_RSAPSS, "SHA512-RSAPSS", OID_RSAPSS, RSA, 7, true),
    sd(DSA_WITH_SHA1, "DSA-SHA1", [1, 2, 840, 10040, 4, 3], DSA, 3, false),
    sd(DSA_WITH_SHA256, "DSA-SHA256", [2, 16, 840, 1, 101, 3, 4, 3, 2], DSA, 5, false),
    sd(ECDSA_WITH_SHA1, "ECDSA-SHA1", [1, 2, 840, 10045, 4, 1], ECDSA, 3, false),
    sd(ECDSA_WITH_SHA256, "ECDSA-SHA256", [1, 2, 840, 10045, 4, 3, 2], ECDSA, 5, false),
    sd(ECDSA_WITH_SHA384, "ECDSA-SHA384", [1, 2, 840, 10045, 4, 3, 3], ECDSA, 6, false),
    sd(ECDSA_WITH_SHA512, "ECDSA-SHA512", [1, 2, 840, 10045, 4, 3, 4], ECDSA, 7, false),
    sd(PURE_ED25519, "Ed25519", OID_ED25519, ED25519, 0, false),
    sd(MLDSA44, "ML-DSA-44", OID_MLDSA44, MLDSA, 0, false),
    sd(MLDSA65, "ML-DSA-65", OID_MLDSA65, MLDSA, 0, false),
    sd(MLDSA87, "ML-DSA-87", OID_MLDSA87, MLDSA, 0, false),
  ]
}

pub fn signature_algorithm_string(algo: Int) -> Str {
  for d in signature_algorithm_details() { if d.algo == algo { return d.name } }
  "{algo}"
}

pub fn public_key_algorithm_string(algo: Int) -> Str {
  let names = ["", "RSA", "DSA", "ECDSA", "Ed25519", "ML-DSA"]
  if algo > 0 && algo < len(names) { names[algo] } else { "{algo}" }
}

