pub fn ext_key_usage_string(e: Int) -> Str {
  let names = [
    "anyExtendedKeyUsage",
    "serverAuth",
    "clientAuth",
    "codeSigning",
    "emailProtection",
    "ipsecEndSystem",
    "ipsecTunnel",
    "ipsecUser",
    "timeStamping",
    "OCSPSigning",
    "msSGC",
    "nsSGC",
    "msCodeCom",
    "msKernelCode",
  ]
  if e >= 0 && e < len(names) { names[e] } else { "ExtKeyUsage({e})" }
}

pub fn key_usage_string(k: Int) -> Str {
  let names = [
    "digitalSignature",
    "contentCommitment",
    "keyEncipherment",
    "dataEncipherment",
    "keyAgreement",
    "keyCertSign",
    "cRLSign",
    "encipherOnly",
    "decipherOnly",
  ]
  var i = 0
  while i < len(names) {
    if k == (1 << i) { return names[i] }
    i += 1
  }
  "KeyUsage({k})"
}

pub fn ext_key_usage_from_oid(oid: List<Int>) -> Int? {
  var i = 0
  while i < len(EKU_OIDS) {
    if EKU_OIDS[i] == oid { return Some(i) }
    i += 1
  }
  None
}

pub fn oid_from_ext_key_usage(eku: Int) -> List<Int>? {
  if eku >= 0 && eku < len(EKU_OIDS) { Some(EKU_OIDS[eku]) } else { None }
}

// ───────── OID（oid.go）─────────

pub type OID = { der: List<Int> }

fn new_oid_from_der(der: List<Int>) -> OID? {
  if len(der) == 0 || der[len(der) - 1] & 0x80 != 0 { return None }
  var start = 0
  var i = 0
  for v in der {
    if i == start && v == 0x80 { return None }
    if v & 0x80 == 0 { start = i + 1 }
    i += 1
  }
  Some(OID { der: der })
}

fn low7(n: BigInt) -> Int {
  let b = n.bytes()
  if len(b) == 0 { 0 } else { b[len(b) - 1] & 0x7f }
}

fn low7big(n: BigInt) -> Int {
  var v = 0
  for b in n.bytes() { v = (v << 8) | b }
  v
}

fn append_base128_big(dst: List<Int>, n: BigInt) -> List<Int> {
  if n.sign() == 0 { return push(dst, 0) }
  let l = (n.bit_len() + 6) / 7
  var out = dst
  var i = l - 1
  while i >= 0 {
    var o = low7(n.rsh(i * 7))
    if i != 0 { o = o | 0x80 }
    out = push(out, o)
    i -= 1
  }
  out
}

pub fn oid_from_ints(oid: List<Int>) -> Result<OID, Str> {
  // 分量是 uint64（以 Int 位模式给出）
  if len(oid) < 2
    || big.new_uint64(oid[0]).cmp(big.new_int(2)) > 0
    || (oid[0] >= 0 && oid[0] < 2 && big.new_uint64(oid[1]).cmp(big.new_int(40)) >= 0) {
    return Err("invalid oid")
  }
  // 同 Go：第一个分量 oid[0]*40+oid[1] 按 uint64 回绕
  var der = append_base128_big([], big.new_uint64(bits.wadd(bits.wmul(oid[0], 40), oid[1])))
  var i = 2
  while i < len(oid) {
    der = append_base128_big(der, big.new_uint64(oid[i]))
    i += 1
  }
  Ok(OID { der: der })
}

pub fn oid_from_asn1_oid(o: List<Int>) -> Result<OID, Str> {
  for c in o { if c < 0 { return Err("x509: OID components must be non-negative") } }
  oid_from_ints(o)
}

fn all_digits(s: Str) -> Bool {
  if s == "" { return false }
  for c in chars(s) { if c < "0" || c > "9" { return false } }
  true
}

pub fn parse_oid(s: Str) -> Result<OID, Str> {
  for c in chars(s) { if !(c >= "0" && c <= "9") && c != "." { return Err("invalid oid") } }
  let parts = split(s, ".")
  if len(parts) < 2 { return Err("invalid oid") }
  for p in parts { if !all_digits(p) { return Err("invalid oid") } }
  let first = unwrap(big.parse(parts[0], 10))
  let second = unwrap(big.parse(parts[1], 10))
  let two = big.new_int(2)
  if first.cmp(two) > 0 || (first.cmp(two) < 0 && second.cmp(big.new_int(40)) >= 0) {
    return Err("invalid oid")
  }
  var der = append_base128_big([], first.mul(big.new_int(40)).add(second))
  var i = 2
  while i < len(parts) {
    der = append_base128_big(der, unwrap(big.parse(parts[i], 10)))
    i += 1
  }
  Ok(OID { der: der })
}

pub fn oid_from_der(b: List<Int>) -> Result<OID, Str> {
  match new_oid_from_der(b) {
    Some(o) => Ok(o),
    None => Err("invalid oid"),
  }
}

pub fn oid_equal(a: OID, b: OID) -> Bool { a.der == b.der }

pub fn oid_string(o: OID) -> Str {
  var out = ""
  var v = big.zero()
  var first = true
  for b in o.der {
    v = v.lsh(7).or(big.new_int(b & 0x7f))
    if b & 0x80 == 0 {
      if first {
        if v.cmp(big.new_int(80)) < 0 {
          let x = low7big(v)
          out = "{x / 40}.{x % 40}"
        } else {
          out = "2." + v.sub(big.new_int(80)).string()
        }
        first = false
      } else {
        out = out + "." + v.string()
      }
      v = big.zero()
    }
  }
  out
}

pub fn oid_to_asn1(o: OID) -> List<Int>? {
  var out: List<Int> = []
  var val = 0
  for v in o.der {
    if val > (1 << 24) - 1 { return None }
    val = (val << 7) | (v & 0x7f)
    if v & 0x80 == 0 {
      if len(out) == 0 {
        if val < 80 { out = [val / 40, val % 40] } else { out = [2, val - 80] }
      } else {
        out = push(out, val)
      }
      val = 0
    }
  }
  Some(out)
}

pub fn oid_equal_asn1_oid(o: OID, other: List<Int>) -> Bool {
  match oid_to_asn1(o) {
    Some(x) => x == other && len(other) >= 2,
    None => false,
  }
}

// ───────── 证书 ─────────

pub enum PublicKey {
  NoKey
  RSAKey(rsa.PublicKey)
  DSAKey(dsa.PublicKey)
  ECDSAKey(ecdsa.PublicKey)
  Ed25519Key(List<Int>)
  X25519Key(ecdh.PublicKey)
  MLDSAKey(mldsa.PublicKey)
}

pub type IPNet = { ip: List<Int>, mask: List<Int> }

pub type PolicyMapping = { issuer_domain_policy: OID, subject_domain_policy: OID }

pub type Certificate = {
  raw: List<Int>,
  raw_tbs_certificate: List<Int>,
  raw_subject_public_key_info: List<Int>,
  raw_subject: List<Int>,
  raw_issuer: List<Int>,
  raw_signature_algorithm: List<Int>,
  signature: List<Int>,
  signature_algorithm: Int,
  public_key_algorithm: Int,
  public_key: PublicKey,
  version: Int,
  serial_number: BigInt,
  issuer: Name,
  subject: Name,
  not_before: Time,
  not_after: Time,
  key_usage: Int,
  extensions: List<Extension>,
  unhandled_critical_extensions: List<List<Int>>,
  ext_key_usage: List<Int>,
  unknown_ext_key_usage: List<List<Int>>,
  basic_constraints_valid: Bool,
  is_ca: Bool,
  max_path_len: Int,
  max_path_len_zero: Bool,
  subject_key_id: List<Int>,
  authority_key_id: List<Int>,
  ocsp_server: List<Str>,
  issuing_certificate_url: List<Str>,
  dns_names: List<Str>,
  email_addresses: List<Str>,
  ip_addresses: List<List<Int>>,
  uris: List<url.URL>,
  permitted_dns_domains_critical: Bool,
  permitted_dns_domains: List<Str>,
  excluded_dns_domains: List<Str>,
  permitted_ip_ranges: List<IPNet>,
  excluded_ip_ranges: List<IPNet>,
  permitted_email_addresses: List<Str>,
  excluded_email_addresses: List<Str>,
  permitted_uri_domains: List<Str>,
  excluded_uri_domains: List<Str>,
  crl_distribution_points: List<Str>,
  policy_identifiers: List<List<Int>>,
  policies: List<OID>,
  inhibit_any_policy: Int,
  inhibit_any_policy_zero: Bool,
  inhibit_policy_mapping: Int,
  inhibit_policy_mapping_zero: Bool,
  require_explicit_policy: Int,
  require_explicit_policy_zero: Bool,
  policy_mappings: List<PolicyMapping>,
}

const ZERO_TIME: Time = Time { unix: -62135596800, nsec: 0, offset: 0 }

pub fn zero_time() -> Time { Time { unix: -62135596800, nsec: 0, offset: 0 } }

pub fn empty_certificate() -> Certificate {
  Certificate {
    raw: [],
    raw_tbs_certificate: [],
    raw_subject_public_key_info: [],
    raw_subject: [],
    raw_issuer: [],
    raw_signature_algorithm: [],
    signature: [],
    signature_algorithm: 0,
    public_key_algorithm: 0,
    public_key: PublicKey.NoKey,
    version: 0,
    serial_number: big.zero(),
    issuer: pkix.empty_name(),
    subject: pkix.empty_name(),
    not_before: zero_time(),
    not_after: zero_time(),
    key_usage: 0,
    extensions: [],
    unhandled_critical_extensions: [],
    ext_key_usage: [],
    unknown_ext_key_usage: [],
    basic_constraints_valid: false,
    is_ca: false,
    max_path_len: 0,
    max_path_len_zero: false,
    subject_key_id: [],
    authority_key_id: [],
    ocsp_server: [],
    issuing_certificate_url: [],
    dns_names: [],
    email_addresses: [],
    ip_addresses: [],
    uris: [],
    permitted_dns_domains_critical: false,
    permitted_dns_domains: [],
    excluded_dns_domains: [],
    permitted_ip_ranges: [],
    excluded_ip_ranges: [],
    permitted_email_addresses: [],
    excluded_email_addresses: [],
    permitted_uri_domains: [],
    excluded_uri_domains: [],
    crl_distribution_points: [],
    policy_identifiers: [],
    policies: [],
    inhibit_any_policy: 0,
    inhibit_any_policy_zero: false,
    inhibit_policy_mapping: 0,
    inhibit_policy_mapping_zero: false,
    require_explicit_policy: 0,
    require_explicit_policy_zero: false,
    policy_mappings: [],
  }
}

// ───────── 字符串 ─────────

fn bstr(b: List<Int>) -> Str {
  match __from_bytes(b) {
    Some(s) => s,
    None => {
      var out = ""
      for x in b { out = out + (if x < 128 { __chr(x) } else { __chr(65533) }) }
      out
    },
  }
}

fn qbytes(b: List<Int>) -> Str { strconv.quote_bytes_with(b, 34, false, false) }

fn is_ia5(b: List<Int>) -> Bool { all(b, (x) => x < 128) }

fn ia5_err(b: List<Int>) -> Str { "x509: " + qbytes(b) + " cannot be encoded as an IA5String" }

fn is_printable(b: Int) -> Bool {
  (b >= 97 && b <= 122)
    || (b >= 65 && b <= 90)
    || (b >= 48 && b <= 57)
    || (b >= 39 && b <= 41)
    || (b >= 43 && b <= 47)
    || b == 32
    || b == 58
    || b == 61
    || b == 63
    || b == 42
    || b == 38
}

fn parse_asn1_string(tag: Int, value0: List<Int>) -> Result<Str, Str> {
  if tag == cb.T61_STRING { return Ok(join(map(value0, (v) => __chr(v)), "")) }
  if tag == cb.PRINTABLE_STRING {
    if !all(value0, is_printable) { return Err("invalid PrintableString") }
    return Ok(bstr(value0))
  }
  if tag == cb.UTF8_STRING {
    return match __from_bytes(value0) {
      Some(s) => Ok(s),
      None => Err("invalid UTF-8 string"),
    }
  }
  if tag == 30 {
    var value = value0
    if len(value) % 2 != 0 { return Err("invalid BMPString") }
    let l = len(value)
    if l >= 2 && value[l - 1] == 0 && value[l - 2] == 0 { value = value[..l - 2] }
    var out = ""
    var i = 0
    while i < len(value) {
      let p = (value[i] << 8) + value[i + 1]
      if p == 0xfffe
        || p == 0xffff
        || (p >= 0xfdd0 && p <= 0xfdef)
        || (p >= 0xd800 && p <= 0xdfff) {
        return Err("invalid BMPString")
      }
      out = out + __chr(p)
      i += 2
    }
    return Ok(out)
  }
  if tag == cb.IA5_STRING {
    if !is_ia5(value0) { return Err("invalid IA5String") }
    return Ok(bstr(value0))
  }
  if tag == 18 {
    if !all(value0, (b) => (b >= 48 && b <= 57) || b == 32) { return Err("invalid NumericString") }
    return Ok(bstr(value0))
  }
  Err("unsupported string type: {tag}")
}

fn read_asn1_any(der: List<Int>) -> Result<(Val, List<Int>), Str> {
  let Some((full, tag, rest)) = cb.read_any_asn1_element(der) else {
    return Err("invalid ASN.1 element")
  }
  if tag == cb.T61_STRING
    || tag == cb.PRINTABLE_STRING
    || tag == cb.UTF8_STRING
    || tag == 30
    || tag == cb.IA5_STRING
    || tag == 18 {
    let Some((raw, _)) = cb.read_asn1(full, tag) else { return Err("invalid ASN.1 element") }
    return Ok((Val.VStr(parse_asn1_string(tag, raw)?), rest))
  }
  if tag == cb.INTEGER {
    let Some((i, _)) = cb.read_asn1_int64(full) else { return Err("invalid ASN.1 integer") }
    return Ok((Val.VInt(i), rest))
  }
  if tag == cb.BIT_STRING {
    let Some((bs, _)) = cb.read_asn1_bit_string(full) else {
      return Err("invalid ASN.1 BIT STRING")
    }
    return Ok((Val.VBits(bs), rest))
  }
  if tag == cb.OCTET_STRING {
    let Some((s, _)) = cb.read_asn1(full, cb.OCTET_STRING) else {
      return Err("invalid ASN.1 OCTET STRING")
    }
    return Ok((Val.VBytes(s), rest))
  }
  if tag == cb.OBJECT_IDENTIFIER {
    let Some((o, _)) = cb.read_asn1_oid(full) else { return Err("invalid ASN.1 OBJECT IDENTIFIER") }
    return Ok((Val.VOid(o), rest))
  }
  if tag == cb.UTC_TIME || tag == cb.GENERALIZED_TIME {
    let (t, _) = read_asn1_time(full)?
    return Ok((Val.VTime(t), rest))
  }
  if tag == cb.BOOLEAN {
    let Some((b, _)) = cb.read_asn1_boolean(full) else { return Err("invalid ASN.1 BOOLEAN") }
    return Ok((Val.VBool(b), rest))
  }
  if tag == cb.NULL { return Ok((Val.VNil, rest)) }
  let Some((inner, _, _)) = cb.read_any_asn1(full) else { return Err("invalid ASN.1 element") }
  Ok(
    (
      Val.VRaw(RawValue {
        class: tag >> 6,
        tag: tag & 0x1f,
        is_compound: tag & 0x20 == 0x20,
        bytes: inner,
        full_bytes: full,
      }),
      rest,
    ),
  )
}

pub fn parse_name(raw: List<Int>) -> Result<List<List<AttributeTypeAndValue>>, Str> {
  let Some((seq0, _)) = cb.read_asn1(raw, cb.SEQUENCE) else {
    return Err("x509: invalid RDNSequence")
  }
  var seq = seq0
  var out: List<List<AttributeTypeAndValue>> = []
  while len(seq) > 0 {
    let Some((set0, r1)) = cb.read_asn1(seq, cb.SET) else {
      return Err("x509: invalid RDNSequence")
    }
    seq = r1
    var set_ = set0
    var rdn: List<AttributeTypeAndValue> = []
    while len(set_) > 0 {
      let Some((atav, r2)) = cb.read_asn1(set_, cb.SEQUENCE) else {
        return Err("x509: invalid RDNSequence: invalid attribute")
      }
      set_ = r2
      let Some((typ, r3)) = cb.read_asn1_oid(atav) else {
        return Err("x509: invalid RDNSequence: invalid attribute type")
      }
      let (v, _) = match read_asn1_any(r3) {
        Ok(x) => x,
        Err(e) => { return Err("x509: invalid RDNSequence: invalid attribute value: " + e) },
      }
      rdn = push(rdn, AttributeTypeAndValue { typ: typ, value: v })
    }
    out = push(out, rdn)
  }
  Ok(out)
}

fn parse_ai(der: List<Int>) -> Result<AlgorithmIdentifier, Str> {
  let Some((alg, rest)) = cb.read_asn1_oid(der) else { return Err("x509: malformed OID") }
  if len(rest) == 0 {
    return Ok(AlgorithmIdentifier { algorithm: alg, parameters: pkix.empty_raw() })
  }
  let Some((params, tag, _)) = cb.read_any_asn1_element(rest) else {
    return Err("x509: malformed parameters")
  }
  Ok(AlgorithmIdentifier {
    algorithm: alg,
    parameters: RawValue { tag: tag, full_bytes: params, ..pkix.empty_raw() },
  })
}

fn read_asn1_time(der: List<Int>) -> Result<(Time, List<Int>), Str> {
  if cb.peek_asn1_tag(der, cb.UTC_TIME) {
    return match cb.read_asn1_utc_time(der) {
      Some(x) => Ok(x),
      None => Err("x509: malformed UTCTime"),
    }
  }
  if cb.peek_asn1_tag(der, cb.GENERALIZED_TIME) {
    return match cb.read_asn1_generalized_time(der) {
      Some(x) => Ok(x),
      None => Err("x509: malformed GeneralizedTime"),
    }
  }
  Err("x509: unsupported time format")
}

fn parse_extension(der: List<Int>) -> Result<Extension, Str> {
  let Some((id, r1)) = cb.read_asn1_oid(der) else {
    return Err("x509: malformed extension OID field")
  }
  var rest = r1
  var crit = false
  if cb.peek_asn1_tag(rest, cb.BOOLEAN) {
    let Some((c, r2)) = cb.read_asn1_boolean(rest) else {
      return Err("x509: malformed extension critical field")
    }
    crit = c
    rest = r2
  }
  let Some((val, _)) = cb.read_asn1(rest, cb.OCTET_STRING) else {
    return Err("x509: malformed extension value field")
  }
  Ok(Extension { id: id, critical: crit, value: val })
}

fn right_align(b: BitString) -> List<Int> {
  let shift = 8 - (b.bit_length % 8)
  if shift == 8 || len(b.bytes) == 0 { return b.bytes }
  var out: List<Int> = []
  var i = 0
  while i < len(b.bytes) {
    var x = b.bytes[i] >> shift
    if i > 0 { x = x | ((b.bytes[i - 1] << (8 - shift)) & 0xff) }
    out = push(out, x)
    i += 1
  }
  out
}

fn bit_at(b: BitString, i: Int) -> Int {
  if i < 0 || i >= b.bit_length { return 0 }
  (b.bytes[i / 8] >> (7 - i % 8)) & 1
}

fn named_curve(oid: List<Int>) -> Int {
  if oid == [1, 3, 132, 0, 33] { return 0 }
  if oid == [1, 2, 840, 10045, 3, 1, 7] { return 1 }
  if oid == [1, 3, 132, 0, 34] { return 2 }
  if oid == [1, 3, 132, 0, 35] { return 3 }
  -1
}

fn mldsa_params(oid: List<Int>) -> mldsa.Parameters? {
  if oid == OID_MLDSA44 { return Some(mldsa.mldsa44()) }
  if oid == OID_MLDSA65 { return Some(mldsa.mldsa65()) }
  if oid == OID_MLDSA87 { return Some(mldsa.mldsa87()) }
  None
}

fn parse_public_key(ai: AlgorithmIdentifier, bits: BitString) -> Result<PublicKey, Str> {
  let oid = ai.algorithm
  let params = ai.parameters
  let data = right_align(bits)
  if oid == OID_RSA {
    if params.full_bytes != NULL_BYTES { return Err("x509: RSA key missing NULL parameters") }
    let Some((seq, _)) = cb.read_asn1(data, cb.SEQUENCE) else {
      return Err("x509: invalid RSA public key")
    }
    let Some((n, r1)) = cb.read_asn1_big_int(seq) else { return Err("x509: invalid RSA modulus") }
    let Some((e, _)) = cb.read_asn1_int64(r1) else {
      return Err("x509: invalid RSA public exponent")
    }
    if n.sign() <= 0 { return Err("x509: RSA modulus is not a positive number") }
    if e <= 0 { return Err("x509: RSA public exponent is not a positive number") }
    return Ok(PublicKey.RSAKey(rsa.PublicKey { n: n, e: e }))
  }
  if oid == OID_ECDSA {
    let Some((curve_oid, _)) = cb.read_asn1_oid(params.full_bytes) else {
      return Err("x509: invalid ECDSA parameters")
    }
    let c = named_curve(curve_oid)
    if c < 0 { return Err("x509: unsupported elliptic curve") }
    return Ok(PublicKey.ECDSAKey(ecdsa.parse_uncompressed_public_key(c, data)?))
  }
  if oid == OID_ED25519 {
    if len(params.full_bytes) != 0 {
      return Err("x509: Ed25519 key encoded with illegal parameters")
    }
    if len(data) != 32 { return Err("x509: wrong Ed25519 public key size") }
    return Ok(PublicKey.Ed25519Key(data))
  }
  if oid == OID_MLDSA44 || oid == OID_MLDSA65 || oid == OID_MLDSA87 {
    if len(params.full_bytes) != 0 {
      return Err("x509: ML-DSA key encoded with illegal parameters")
    }
    let Some(p) = mldsa_params(oid) else { return Err("x509: unsupported ML-DSA parameters") }
    return Ok(PublicKey.MLDSAKey(mldsa.new_public_key(p, data)?))
  }
  if oid == OID_X25519 {
    if len(params.full_bytes) != 0 {
      return Err("x509: X25519 key encoded with illegal parameters")
    }
    return Ok(PublicKey.X25519Key(ecdh.new_public_key(0, data)?))
  }
  if oid == OID_DSA {
    let Some((y, _)) = cb.read_asn1_big_int(data) else {
      return Err("x509: invalid DSA public key")
    }
    let bad = "x509: invalid DSA parameters"
    let Some((ps, _)) = cb.read_asn1(params.full_bytes, cb.SEQUENCE) else { return Err(bad) }
    let Some((p, r1)) = cb.read_asn1_big_int(ps) else { return Err(bad) }
    let Some((q, r2)) = cb.read_asn1_big_int(r1) else { return Err(bad) }
    let Some((g, _)) = cb.read_asn1_big_int(r2) else { return Err(bad) }
    if y.sign() <= 0 || p.sign() <= 0 || q.sign() <= 0 || g.sign() <= 0 {
      return Err("x509: zero or negative DSA parameter")
    }
    return Ok(PublicKey.DSAKey(dsa.PublicKey { params: dsa.Parameters { p: p, q: q, g: g }, y: y }))
  }
  Err("x509: unknown public key algorithm")
}

fn sig_algo_from_ai(ai: AlgorithmIdentifier) -> Int {
  let a = ai.algorithm
  if a == OID_ED25519 || a == OID_MLDSA44 || a == OID_MLDSA65 || a == OID_MLDSA87 {
    if len(ai.parameters.full_bytes) != 0 { return UNKNOWN_SIGNATURE_ALGORITHM }
  }
  if a != OID_RSAPSS {
    for d in signature_algorithm_details() { if a == d.oid { return d.algo } }
    return UNKNOWN_SIGNATURE_ALGORITHM
  }
  match pss_params(ai.parameters.full_bytes) {
    Some(x) => x,
    None => UNKNOWN_SIGNATURE_ALGORITHM,
  }
}

fn ai_ty() -> Ty {
  Ty.TStruct("AlgorithmIdentifier", [asn1.field(Ty.TOid, ""), asn1.field(Ty.TRaw, "optional")])
}

fn ai_of(v: Val) -> (List<Int>, List<Int>) {
  match v {
    VStruct(fs) => {
      let o = match fs[0] {
        VOid(x) => x,
        _ => [],
      }
      let p = match fs[1] {
        VRaw(r) => r.full_bytes,
        _ => [],
      }
      (o, p)
    },
    _ => ([], []),
  }
}

fn pss_params(fb: List<Int>) -> Int? {
  let ty = Ty.TStruct("pssParameters", [
    asn1.field(ai_ty(), "explicit,tag:0"),
    asn1.field(ai_ty(), "explicit,tag:1"),
    asn1.field(Ty.TInt, "explicit,tag:2"),
    asn1.field(Ty.TInt, "optional,explicit,tag:3,default:1"),
  ])
  let (v, _) = match asn1.unmarshal(fb, ty) {
    Ok(x) => x,
    Err(_) => { return None },
  }
  let fs = match v {
    VStruct(x) => x,
    _ => { return None },
  }
  let (hash_alg, hash_params) = ai_of(fs[0])
  let (mgf_alg, mgf_params) = ai_of(fs[1])
  let salt = match fs[2] {
    VInt(n) => n,
    _ => 0,
  }
  let trailer = match fs[3] {
    VInt(n) => n,
    _ => 0,
  }
  let (m, _) = match asn1.unmarshal(mgf_params, ai_ty()) {
    Ok(x) => x,
    Err(_) => { return None },
  }
  let (m_alg, m_params) = ai_of(m)
  if (len(hash_params) != 0 && hash_params != NULL_BYTES)
    || mgf_alg != OID_MGF1
    || m_alg != hash_alg
    || (len(m_params) != 0 && m_params != NULL_BYTES)
    || trailer != 1 {
    return None
  }
  if hash_alg == OID_SHA256 && salt == 32 { return Some(SHA256_WITH_RSAPSS) }
  if hash_alg == OID_SHA384 && salt == 48 { return Some(SHA384_WITH_RSAPSS) }
  if hash_alg == OID_SHA512 && salt == 64 { return Some(SHA512_WITH_RSAPSS) }
  None
}

fn pub_algo_from_oid(oid: List<Int>) -> Int {
  if oid == OID_RSA { return RSA }
  if oid == OID_DSA { return DSA }
  if oid == OID_ECDSA { return ECDSA }
  if oid == OID_ED25519 { return ED25519 }
  if oid == OID_MLDSA44 || oid == OID_MLDSA65 || oid == OID_MLDSA87 { return MLDSA }
  UNKNOWN_PUBLIC_KEY_ALGORITHM
}

// ───────── 扩展 ─────────

pub fn domain_name_valid(s0: Str, constraint: Bool) -> Bool {
  var s = __bytes(s0)
  if len(s) == 0 { return true }
  if s[len(s) - 1] == 46 { return false }
  var last_dot = -1
  if constraint && s[0] == 46 { s = s[1..] }
  var i = 0
  while i <= len(s) {
    if i < len(s) && (s[i] < 33 || s[i] > 126) { return false }
    if i == len(s) || s[i] == 46 {
      var label = i
      if last_dot >= 0 { label -= last_dot + 1 }
      if label == 0 { return false }
      last_dot = i
    }
    i += 1
  }
  true
}

fn domain_valid_b(b: List<Int>, constraint: Bool) -> Bool {
  // 不合法 UTF-8 的字节一定 > 126，同样判为无效
  if !all(b, (x) => x < 128) {
    return false
  }
  domain_name_valid(bstr(b), constraint)
}

pub fn parse_rfc2821_mailbox(inp: Str) -> (Str, Str)? {
  var s = __bytes(inp)
  if len(s) == 0 { return None }
  var local: List<Int> = []
  if s[0] == 34 {
    s = s[1..]
    while true {
      if len(s) == 0 { return None }
      let c = s[0]
      s = s[1..]
      if c == 34 { break }
      if c == 92 {
        if len(s) == 0 { return None }
        let d = s[0]
        if d == 11 || d == 12 || (d >= 1 && d <= 9) || (d >= 14 && d <= 127) {
          local = push(local, d)
          s = s[1..]
        } else {
          return None
        }
      } else if c == 11
        || c == 12
        || c == 32
        || c == 33
        || c == 127
        || (c >= 1 && c <= 8)
        || (c >= 14 && c <= 31)
        || (c >= 35 && c <= 91)
        || (c >= 93 && c <= 126) {
        local = push(local, c)
      } else {
        return None
      }
    }
  } else {
    while len(s) > 0 {
      var c = s[0]
      if c == 92 {
        s = s[1..]
        if len(s) == 0 { return None }
        local = push(local, s[0])
        s = s[1..]
        continue
      }
      if (c >= 48 && c <= 57)
        || (c >= 97 && c <= 122)
        || (c >= 65 && c <= 90)
        || contains(__bytes("!#$%&'*+-/=?^_`\{|}~."), c) {
        local = push(local, s[0])
        s = s[1..]
      } else {
        break
      }
    }
    if len(local) == 0 { return None }
    if local[0] == 46 || local[len(local) - 1] == 46 { return None }
    var i = 0
    while i + 1 < len(local) {
      if local[i] == 46 && local[i + 1] == 46 { return None }
      i += 1
    }
  }
  if len(s) == 0 || s[0] != 64 { return None }
  s = s[1..]
  if !domain_valid_b(s, false) { return None }
  if contains(s, 64) { return None }
  Some((bstr(local), bstr(s)))
}

fn is_v4_mapped(ip: List<Int>) -> Bool {
  if len(ip) != 16 { return false }
  var i = 0
  while i < 10 {
    if ip[i] != 0 { return false }
    i += 1
  }
  ip[10] == 0xff && ip[11] == 0xff
}

// net.ParseIP 是否成功
fn is_ip(s: Str) -> Bool {
  if contains(s, "%") { return false }
  is_ok(netip.parse_addr(s))
}

type SAN = { dns: List<Str>, emails: List<Str>, ips: List<List<Int>>, uris: List<url.URL> }

fn parse_san(der: List<Int>) -> Result<SAN, Str> {
  let Some((seq0, _)) = cb.read_asn1(der, cb.SEQUENCE) else {
    return Err("x509: invalid subject alternative names")
  }
  var seq = seq0
  var out = SAN { dns: [], emails: [], ips: [], uris: [] }
  while len(seq) > 0 {
    let Some((data, tag0, rest)) = cb.read_any_asn1(seq) else {
      return Err("x509: invalid subject alternative name")
    }
    seq = rest
    let tag = tag0 ^ 0x80
    if tag == 1 {
      if !is_ia5(data) { return Err("x509: SAN rfc822Name is malformed") }
      out = SAN { emails: push(out.emails, bstr(data)), ..out }
    } else if tag == 2 {
      if !is_ia5(data) { return Err("x509: SAN dNSName is malformed") }
      out = SAN { dns: push(out.dns, bstr(data)), ..out }
    } else if tag == 6 {
      if !is_ia5(data) { return Err("x509: SAN uniformResourceIdentifier is malformed") }
      let s = bstr(data)
      let u = match url.parse(s) {
        Ok(x) => x,
        Err(e) => { return Err("x509: cannot parse URI " + strconv.quote_go(s) + ": " + e) },
      }
      if len(u.host) > 0 && !domain_name_valid(u.host, false) {
        return Err("x509: cannot parse URI " + strconv.quote_go(s) + ": invalid domain")
      }
      out = SAN { uris: push(out.uris, u), ..out }
    } else if tag == 7 {
      if len(data) == 16 {
        if is_v4_mapped(data) {
          return Err("x509: SAN iPAddress contains IPv4-mapped IPv6 address")
        }
        out = SAN { ips: push(out.ips, data), ..out }
      } else if len(data) == 4 {
        out = SAN { ips: push(out.ips, data), ..out }
      } else {
        return Err("x509: cannot parse IP address of length {len(data)}")
      }
    }
  }
  Ok(out)
}

fn parse_akid(e: Extension) -> Result<List<Int>, Str> {
  if e.critical { return Err("x509: authority key identifier incorrectly marked critical") }
  let Some((akid, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else {
    return Err("x509: invalid authority key identifier")
  }
  if cb.peek_asn1_tag(akid, 0x80) {
    let Some((v, _)) = cb.read_asn1(akid, 0x80) else {
      return Err("x509: invalid authority key identifier")
    }
    return Ok(v)
  }
  Ok([])
}

fn is_valid_ip_mask(mask: List<Int>) -> Bool {
  var seen_zero = false
  for b in mask {
    if seen_zero {
      if b != 0 { return false }
      continue
    }
    if contains([0x00, 0x80, 0xc0, 0xe0, 0xf0, 0xf8, 0xfc, 0xfe], b) {
      seen_zero = true
    } else if b != 0xff {
      return false
    }
  }
  true
}

type NCV = { dns: List<Str>, ips: List<IPNet>, emails: List<Str>, uris: List<Str>, unhandled: Bool }

fn nc_values(sub0: List<Int>) -> Result<NCV, Str> {
  var sub = sub0
  var out = NCV { dns: [], ips: [], emails: [], uris: [], unhandled: false }
  while len(sub) > 0 {
    let Some((seq, r1)) = cb.read_asn1(sub, cb.SEQUENCE) else {
      return Err("x509: invalid NameConstraints extension")
    }
    sub = r1
    let Some((value, tag, _)) = cb.read_any_asn1(seq) else {
      return Err("x509: invalid NameConstraints extension")
    }
    if tag == 0x82 {
      if !is_ia5(value) { return Err("x509: invalid constraint value: " + ia5_err(value)) }
      let d = bstr(value)
      if !domain_name_valid(d, true) {
        return Err("x509: failed to parse dnsName constraint " + strconv.quote_go(d))
      }
      out = NCV { dns: push(out.dns, d), ..out }
    } else if tag == 0x87 {
      let l = len(value)
      var ip: List<Int> = []
      var mask: List<Int> = []
      if l == 8 {
        ip = value[..4]
        mask = value[4..]
      } else if l == 32 {
        ip = value[..16]
        mask = value[16..]
      } else {
        return Err("x509: IP constraint contained value of length {l}")
      }
      if !is_valid_ip_mask(mask) {
        return Err(
          "x509: IP constraint contained invalid mask " + join(
            map(mask, (b) => strconv.format_int(b + 256, 16)[1..]),
            "",
          ),
        )
      }
      if len(ip) == 16 && is_v4_mapped(ip) {
        return Err("x509: IP constraint contained IPv4-mapped IPv6 address")
      }
      out = NCV { ips: push(out.ips, IPNet { ip: ip, mask: mask }), ..out }
    } else if tag == 0x81 {
      if !is_ia5(value) { return Err("x509: invalid constraint value: " + ia5_err(value)) }
      let c = bstr(value)
      if contains(c, "@") {
        if parse_rfc2821_mailbox(c) == None {
          return Err("x509: failed to parse rfc822Name constraint " + strconv.quote_go(c))
        }
      } else if !domain_name_valid(c, true) {
        return Err("x509: failed to parse rfc822Name constraint " + strconv.quote_go(c))
      }
      out = NCV { emails: push(out.emails, c), ..out }
    } else if tag == 0x86 {
      if !is_ia5(value) { return Err("x509: invalid constraint value: " + ia5_err(value)) }
      let d = bstr(value)
      if is_ip(d) {
        return Err(
          "x509: failed to parse URI constraint " + strconv.quote_go(d) + ": cannot be IP address",
        )
      }
      if !domain_name_valid(d, true) {
        return Err("x509: failed to parse URI constraint " + strconv.quote_go(d))
      }
      out = NCV { uris: push(out.uris, d), ..out }
    } else {
      out = NCV { unhandled: true, ..out }
    }
  }
  Ok(out)
}

fn parse_name_constraints(c: Certificate, e: Extension) -> Result<(Certificate, Bool), Str> {
  let bad = "x509: invalid NameConstraints extension"
  let Some((top, r0)) = cb.read_asn1(e.value, cb.SEQUENCE) else { return Err(bad) }
  if len(r0) != 0 { return Err(bad) }
  let Some((permitted, r1)) = cb.read_optional_asn1(top, 0xa0) else { return Err(bad) }
  let Some((excluded, r2)) = cb.read_optional_asn1(r1, 0xa1) else { return Err(bad) }
  if len(r2) != 0 { return Err(bad) }
  let p = unwrap_or(permitted, [])
  let x = unwrap_or(excluded, [])
  if (permitted == None && excluded == None) || (len(p) == 0 && len(x) == 0) {
    return Err("x509: empty name constraints extension")
  }
  let pv = nc_values(p)?
  let xv = nc_values(x)?
  Ok(
    (
      Certificate {
        permitted_dns_domains: pv.dns,
        permitted_ip_ranges: pv.ips,
        permitted_email_addresses: pv.emails,
        permitted_uri_domains: pv.uris,
        excluded_dns_domains: xv.dns,
        excluded_ip_ranges: xv.ips,
        excluded_email_addresses: xv.emails,
        excluded_uri_domains: xv.uris,
        permitted_dns_domains_critical: e.critical,
        ..c
      },
      pv.unhandled || xv.unhandled,
    ),
  )
}

fn parse_policies(der: List<Int>) -> Result<List<OID>, Str> {
  let bad = "x509: invalid certificate policies"
  let Some((seq0, _)) = cb.read_asn1(der, cb.SEQUENCE) else { return Err(bad) }
  var seq = seq0
  var out: List<OID> = []
  var seen: List<List<Int>> = []
  while len(seq) > 0 {
    let Some((cp, r1)) = cb.read_asn1(seq, cb.SEQUENCE) else { return Err(bad) }
    seq = r1
    let Some((ob, _)) = cb.read_asn1(cp, cb.OBJECT_IDENTIFIER) else { return Err(bad) }
    if contains(seen, ob) { return Err(bad) }
    seen = push(seen, ob)
    let Some(o) = new_oid_from_der(ob) else { return Err(bad) }
    out = push(out, o)
  }
  Ok(out)
}

const OID_AIA: List<Int> = [1, 3, 6, 1, 5, 5, 7, 1, 1]
const OID_AIA_OCSP: List<Int> = [1, 3, 6, 1, 5, 5, 7, 48, 1]
const OID_AIA_ISSUERS: List<Int> = [1, 3, 6, 1, 5, 5, 7, 48, 2]

fn process_extensions(c0: Certificate) -> Result<Certificate, Str> {
  var c = c0
  for e in c0.extensions {
    var unhandled = false
    let id = e.id
    if len(id) == 4 && id[0] == 2 && id[1] == 5 && id[2] == 29 {
      let k = id[3]
      if k == 15 {
        let Some((bits, _)) = cb.read_asn1_bit_string(e.value) else {
          return Err("x509: invalid key usage")
        }
        var u = 0
        var i = 0
        while i < 9 {
          if bit_at(bits, i) != 0 { u = u | (1 << i) }
          i += 1
        }
        c = Certificate { key_usage: u, ..c }
      } else if k == 19 {
        let bad = "x509: invalid basic constraints"
        let Some((seq0, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else { return Err(bad) }
        var seq = seq0
        var is_ca = false
        if cb.peek_asn1_tag(seq, cb.BOOLEAN) {
          let Some((b, r)) = cb.read_asn1_boolean(seq) else { return Err(bad) }
          is_ca = b
          seq = r
        }
        var mpl = -1
        if cb.peek_asn1_tag(seq, cb.INTEGER) {
          let Some((u, _)) = cb.read_asn1_uint64(seq) else { return Err(bad) }
          if u < 0 { return Err(bad) }
          mpl = u
        }
        c = Certificate {
          is_ca: is_ca,
          max_path_len: mpl,
          basic_constraints_valid: true,
          max_path_len_zero: mpl == 0,
          ..c
        }
      } else if k == 17 {
        let s = parse_san(e.value)?
        c = Certificate {
          dns_names: s.dns,
          email_addresses: s.emails,
          ip_addresses: s.ips,
          uris: s.uris,
          ..c
        }
        if len(s.dns) == 0 && len(s.emails) == 0 && len(s.ips) == 0 && len(s.uris) == 0 {
          unhandled = true
        }
      } else if k == 30 {
        let (c2, u) = parse_name_constraints(c, e)?
        c = c2
        unhandled = u
      } else if k == 31 {
        let Some((v0, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else {
          return Err("x509: invalid CRL distribution points")
        }
        var v = v0
        while len(v) > 0 {
          let Some((dp, r1)) = cb.read_asn1(v, cb.SEQUENCE) else {
            return Err("x509: invalid CRL distribution point")
          }
          v = r1
          let Some((name0, _)) = cb.read_optional_asn1(dp, 0xa0) else {
            return Err("x509: invalid CRL distribution point")
          }
          let Some(nm) = name0 else { continue }
          let Some((dn0, _)) = cb.read_asn1(nm, 0xa0) else {
            return Err("x509: invalid CRL distribution point")
          }
          var dn = dn0
          while len(dn) > 0 {
            if !cb.peek_asn1_tag(dn, 0x86) { break }
            let Some((u, r2)) = cb.read_asn1(dn, 0x86) else {
              return Err("x509: invalid CRL distribution point")
            }
            dn = r2
            c = Certificate {
              crl_distribution_points: push(c.crl_distribution_points, bstr(u)),
              ..c
            }
          }
        }
      } else if k == 35 {
        c = Certificate { authority_key_id: parse_akid(e)?, ..c }
      } else if k == 36 {
        let bad = "x509: invalid policy constraints extension"
        let Some((v0, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else { return Err(bad) }
        var v = v0
        if cb.peek_asn1_tag(v, 0x80) {
          let Some((x, r)) = cb.read_asn1_int64_with_tag(v, 0x80) else { return Err(bad) }
          v = r
          c = Certificate { require_explicit_policy: x, require_explicit_policy_zero: x == 0, ..c }
        }
        if cb.peek_asn1_tag(v, 0x81) {
          let Some((x, _)) = cb.read_asn1_int64_with_tag(v, 0x81) else { return Err(bad) }
          c = Certificate { inhibit_policy_mapping: x, inhibit_policy_mapping_zero: x == 0, ..c }
        }
      } else if k == 37 {
        let bad = "x509: invalid extended key usages"
        let Some((v0, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else { return Err(bad) }
        var v = v0
        var ekus: List<Int> = []
        var unknown: List<List<Int>> = []
        while len(v) > 0 {
          let Some((o, r)) = cb.read_asn1_oid(v) else { return Err(bad) }
          v = r
          match ext_key_usage_from_oid(o) {
            Some(x) => { ekus = push(ekus, x) },
            None => { unknown = push(unknown, o) },
          }
        }
        c = Certificate { ext_key_usage: ekus, unknown_ext_key_usage: unknown, ..c }
      } else if k == 14 {
        if e.critical { return Err("x509: subject key identifier incorrectly marked critical") }
        let Some((skid, _)) = cb.read_asn1(e.value, cb.OCTET_STRING) else {
          return Err("x509: invalid subject key identifier")
        }
        c = Certificate { subject_key_id: skid, ..c }
      } else if k == 32 {
        let ps = parse_policies(e.value)?
        var ids: List<List<Int>> = []
        for p in ps { if let Some(o) = oid_to_asn1(p) { ids = push(ids, o) } }
        c = Certificate { policies: ps, policy_identifiers: ids, ..c }
      } else if k == 33 {
        let bad = "x509: invalid policy mappings extension"
        let Some((v0, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else { return Err(bad) }
        var v = v0
        while len(v) > 0 {
          let Some((s, r)) = cb.read_asn1(v, cb.SEQUENCE) else { return Err(bad) }
          v = r
          let Some((iss, r2)) = cb.read_asn1(s, cb.OBJECT_IDENTIFIER) else { return Err(bad) }
          let Some((sub, _)) = cb.read_asn1(r2, cb.OBJECT_IDENTIFIER) else { return Err(bad) }
          c = Certificate {
            policy_mappings: push(c.policy_mappings, PolicyMapping {
              issuer_domain_policy: OID { der: iss },
              subject_domain_policy: OID { der: sub },
            }),
            ..c
          }
        }
      } else if k == 54 {
        let Some((x, _)) = cb.read_asn1_int64(e.value) else {
          return Err("x509: invalid inhibit any policy extension")
        }
        c = Certificate { inhibit_any_policy: x, inhibit_any_policy_zero: x == 0, ..c }
      } else {
        unhandled = true
      }
    } else if id == OID_AIA {
      if e.critical { return Err("x509: authority info access incorrectly marked critical") }
      let bad = "x509: invalid authority info access"
      let Some((v0, _)) = cb.read_asn1(e.value, cb.SEQUENCE) else { return Err(bad) }
      var v = v0
      while len(v) > 0 {
        let Some((aia, r)) = cb.read_asn1(v, cb.SEQUENCE) else { return Err(bad) }
        v = r
        let Some((method, r2)) = cb.read_asn1_oid(aia) else { return Err(bad) }
        if !cb.peek_asn1_tag(r2, 0x86) { continue }
        let Some((loc, _)) = cb.read_asn1(r2, 0x86) else { return Err(bad) }
        if method == OID_AIA_OCSP {
          c = Certificate { ocsp_server: push(c.ocsp_server, bstr(loc)), ..c }
        } else if method == OID_AIA_ISSUERS {
          c = Certificate {
            issuing_certificate_url: push(c.issuing_certificate_url, bstr(loc)),
            ..c
          }
        }
      }
    } else {
      unhandled = true
    }
    if e.critical && unhandled {
      c = Certificate {
        unhandled_critical_extensions: push(c.unhandled_critical_extensions, e.id),
        ..c
      }
    }
  }
  Ok(c)
}

// ───────── 解析证书 ─────────

fn parse_certificate_prefix(der: List<Int>) -> Result<Certificate, Str> {
  var c = empty_certificate()
  let Some((raw, _)) = cb.read_asn1_element(der, cb.SEQUENCE) else {
    return Err("x509: malformed certificate")
  }
  c = Certificate { raw: raw, ..c }
  let Some((inp0, _)) = cb.read_asn1(raw, cb.SEQUENCE) else {
    return Err("x509: malformed certificate")
  }
  let Some((tbs_raw, inp1)) = cb.read_asn1_element(inp0, cb.SEQUENCE) else {
    return Err("x509: malformed tbs certificate")
  }
  c = Certificate { raw_tbs_certificate: tbs_raw, ..c }
  let Some((tbs0, _)) = cb.read_asn1(tbs_raw, cb.SEQUENCE) else {
    return Err("x509: malformed tbs certificate")
  }
  let Some((ver, tbs1)) = cb.read_optional_asn1_int64(tbs0, 0xa0, 0) else {
    return Err("x509: malformed version")
  }
  if ver < 0 { return Err("x509: malformed version") }
  let version = ver + 1
  if version > 3 { return Err("x509: invalid version") }
  c = Certificate { version: version, ..c }
  let Some((serial, tbs2)) = cb.read_asn1_big_int(tbs1) else {
    return Err("x509: malformed serial number")
  }
  if serial.sign() == -1 { return Err("x509: negative serial number") }
  c = Certificate { serial_number: serial, ..c }
  let Some((sig_ai_raw, tbs3)) = cb.read_asn1_element(tbs2, cb.SEQUENCE) else {
    return Err("x509: malformed signature algorithm identifier")
  }
  c = Certificate { raw_signature_algorithm: sig_ai_raw, ..c }
  let Some((sig_ai, _)) = cb.read_asn1(sig_ai_raw, cb.SEQUENCE) else {
    return Err("x509: malformed signature algorithm identifier")
  }
  let Some((outer, inp2)) = cb.read_asn1(inp1, cb.SEQUENCE) else {
    return Err("x509: malformed algorithm identifier")
  }
  if outer != sig_ai {
    return Err("x509: inner and outer signature algorithm identifiers don't match")
  }
  let ai = parse_ai(sig_ai)?
  c = Certificate { signature_algorithm: sig_algo_from_ai(ai), ..c }
  let Some((iss_raw, tbs4)) = cb.read_asn1_element(tbs3, cb.SEQUENCE) else {
    return Err("x509: malformed issuer")
  }
  let iss = parse_name(iss_raw)?
  c = Certificate { raw_issuer: iss_raw, issuer: pkix.fill_from_rdn_sequence(c.issuer, iss), ..c }
  let Some((validity, tbs5)) = cb.read_asn1(tbs4, cb.SEQUENCE) else {
    return Err("x509: malformed validity")
  }
  let (nb, v1) = read_asn1_time(validity)?
  let (na, _) = read_asn1_time(v1)?
  c = Certificate { not_before: nb, not_after: na, ..c }
  let Some((sub_raw, tbs6)) = cb.read_asn1_element(tbs5, cb.SEQUENCE) else {
    return Err("x509: malformed issuer")
  }
  let sub = parse_name(sub_raw)?
  c = Certificate {
    raw_subject: sub_raw,
    subject: pkix.fill_from_rdn_sequence(c.subject, sub),
    ..c
  }
  let Some((spki_raw, tbs7)) = cb.read_asn1_element(tbs6, cb.SEQUENCE) else {
    return Err("x509: malformed spki")
  }
  c = Certificate { raw_subject_public_key_info: spki_raw, ..c }
  let Some((spki, _)) = cb.read_asn1(spki_raw, cb.SEQUENCE) else {
    return Err("x509: malformed spki")
  }
  let Some((pk_ai_seq, spki2)) = cb.read_asn1(spki, cb.SEQUENCE) else {
    return Err("x509: malformed public key algorithm identifier")
  }
  let pk_ai = parse_ai(pk_ai_seq)?
  let pka = pub_algo_from_oid(pk_ai.algorithm)
  c = Certificate { public_key_algorithm: pka, ..c }
  let Some((spk, _)) = cb.read_asn1_bit_string(spki2) else {
    return Err("x509: malformed subjectPublicKey")
  }
  if pka != UNKNOWN_PUBLIC_KEY_ALGORITHM {
    c = Certificate { public_key: parse_public_key(pk_ai, spk)?, ..c }
  }
  var tbs = tbs7
  if version > 1 {
    let Some(t1) = cb.skip_optional_asn1(tbs, 0x81) else {
      return Err("x509: malformed issuerUniqueID")
    }
    let Some(t2) = cb.skip_optional_asn1(t1, 0x82) else {
      return Err("x509: malformed subjectUniqueID")
    }
    tbs = t2
    if version == 3 {
      let Some((exts0, _)) = cb.read_optional_asn1(tbs, 0xa3) else {
        return Err("x509: malformed extensions")
      }
      if let Some(ex) = exts0 {
        let Some((exts1, _)) = cb.read_asn1(ex, cb.SEQUENCE) else {
          return Err("x509: malformed extensions")
        }
        var exts = exts1
        var seen: List<Str> = []
        var list: List<Extension> = []
        while len(exts) > 0 {
          let Some((one, r)) = cb.read_asn1(exts, cb.SEQUENCE) else {
            return Err("x509: malformed extension")
          }
          exts = r
          let e = parse_extension(one)?
          let s = asn1.oid_string(e.id)
          if contains(seen, s) {
            return Err(
              "x509: certificate contains duplicate extension with OID " + strconv.quote_go(s),
            )
          }
          seen = push(seen, s)
          list = push(list, e)
        }
        c = process_extensions(Certificate { extensions: list, ..c })?
      }
    }
  }
  let Some((sig, _)) = cb.read_asn1_bit_string(inp2) else {
    return Err("x509: malformed signature")
  }
  Ok(Certificate { signature: right_align(sig), ..c })
}

pub fn parse_certificate(der: List<Int>) -> Result<Certificate, Str> {
  let c = parse_certificate_prefix(der)?
  if len(der) != len(c.raw) { return Err("x509: trailing data") }
  Ok(c)
}

pub fn parse_certificates(der0: List<Int>) -> Result<List<Certificate>, Str> {
  var der = der0
  var out: List<Certificate> = []
  while len(der) > 0 {
    let c = parse_certificate_prefix(der)?
    out = push(out, c)
    der = der[len(c.raw)..]
  }
  Ok(out)
}

// ───────── CRL ─────────

pub type RevocationListEntry = {
  raw: List<Int>,
  serial_number: BigInt,
  revocation_time: Time,
  reason_code: Int,
  extensions: List<Extension>,
}

pub type RevocationList = {
  raw: List<Int>,
  raw_tbs_revocation_list: List<Int>,
  raw_issuer: List<Int>,
  raw_signature_algorithm: List<Int>,
  issuer: Name,
  authority_key_id: List<Int>,
  signature: List<Int>,
  signature_algorithm: Int,
  revoked_certificate_entries: List<RevocationListEntry>,
  revoked_certificates: List<RevokedCertificate>,
  number: BigInt?,
  this_update: Time,
  next_update: Time,
  extensions: List<Extension>,
}

const OID_REASON_CODE: List<Int> = [2, 5, 29, 21]
const OID_AKID: List<Int> = [2, 5, 29, 35]
const OID_CRL_NUMBER: List<Int> = [2, 5, 29, 20]

pub fn parse_revocation_list(der: List<Int>) -> Result<RevocationList, Str> {
  let Some((raw, _)) = cb.read_asn1_element(der, cb.SEQUENCE) else {
    return Err("x509: malformed crl")
  }
  let Some((inp0, _)) = cb.read_asn1(raw, cb.SEQUENCE) else { return Err("x509: malformed crl") }
  let Some((tbs_raw, inp1)) = cb.read_asn1_element(inp0, cb.SEQUENCE) else {
    return Err("x509: malformed tbs crl")
  }
  let Some((tbs0, _)) = cb.read_asn1(tbs_raw, cb.SEQUENCE) else {
    return Err("x509: malformed tbs crl")
  }
  if !cb.peek_asn1_tag(tbs0, cb.INTEGER) { return Err("x509: unsupported crl version") }
  let Some((version, tbs1)) = cb.read_asn1_int64(tbs0) else { return Err("x509: malformed crl") }
  if version != 1 { return Err("x509: unsupported crl version: {version}") }
  let Some((sig_ai_raw, tbs2)) = cb.read_asn1_element(tbs1, cb.SEQUENCE) else {
    return Err("x509: malformed signature algorithm identifier")
  }
  let Some((sig_ai, _)) = cb.read_asn1(sig_ai_raw, cb.SEQUENCE) else {
    return Err("x509: malformed signature algorithm identifier")
  }
  let Some((outer, inp2)) = cb.read_asn1(inp1, cb.SEQUENCE) else {
    return Err("x509: malformed algorithm identifier")
  }
  if outer != sig_ai {
    return Err("x509: inner and outer signature algorithm identifiers don't match")
  }
  let ai = parse_ai(sig_ai)?
  let Some((sig, _)) = cb.read_asn1_bit_string(inp2) else {
    return Err("x509: malformed signature")
  }
  let Some((iss_raw, tbs3)) = cb.read_asn1_element(tbs2, cb.SEQUENCE) else {
    return Err("x509: malformed issuer")
  }
  let iss = parse_name(iss_raw)?
  let (this_update, tbs4) = read_asn1_time(tbs3)?
  var tbs = tbs4
  var next_update = zero_time()
  if cb.peek_asn1_tag(tbs, cb.GENERALIZED_TIME) || cb.peek_asn1_tag(tbs, cb.UTC_TIME) {
    let (nu, r) = read_asn1_time(tbs)?
    next_update = nu
    tbs = r
  }
  var entries: List<RevocationListEntry> = []
  var revoked: List<RevokedCertificate> = []
  if cb.peek_asn1_tag(tbs, cb.SEQUENCE) {
    let Some((rs0, r)) = cb.read_asn1(tbs, cb.SEQUENCE) else { return Err("x509: malformed crl") }
    tbs = r
    var rs = rs0
    while len(rs) > 0 {
      let Some((cert_raw, r1)) = cb.read_asn1_element(rs, cb.SEQUENCE) else {
        return Err("x509: malformed crl")
      }
      rs = r1
      let Some((cs0, _)) = cb.read_asn1(cert_raw, cb.SEQUENCE) else {
        return Err("x509: malformed crl")
      }
      let Some((serial, cs1)) = cb.read_asn1_big_int(cs0) else {
        return Err("x509: malformed serial number")
      }
      let (rt, cs2) = read_asn1_time(cs1)?
      let Some((exts0, _)) = cb.read_optional_asn1(cs2, cb.SEQUENCE) else {
        return Err("x509: malformed extensions")
      }
      var reason = 0
      var list: List<Extension> = []
      if let Some(ex) = exts0 {
        var exts = ex
        while len(exts) > 0 {
          let Some((one, r2)) = cb.read_asn1(exts, cb.SEQUENCE) else {
            return Err("x509: malformed extension")
          }
          exts = r2
          let e = parse_extension(one)?
          if e.id == OID_REASON_CODE {
            let Some((rc, _)) = cb.read_asn1_enum(e.value) else {
              return Err("x509: malformed reasonCode extension")
            }
            reason = rc
          }
          list = push(list, e)
        }
      }
      entries = push(entries, RevocationListEntry {
        raw: cert_raw,
        serial_number: serial,
        revocation_time: rt,
        reason_code: reason,
        extensions: list,
      })
      revoked = push(revoked, RevokedCertificate {
        serial_number: serial,
        revocation_time: rt,
        extensions: list,
      })
    }
  }
  var akid: List<Int> = []
  var number: BigInt? = None
  var list: List<Extension> = []
  let Some((exts0, _)) = cb.read_optional_asn1(tbs, 0xa0) else {
    return Err("x509: malformed extensions")
  }
  if let Some(ex) = exts0 {
    let Some((exts1, _)) = cb.read_asn1(ex, cb.SEQUENCE) else {
      return Err("x509: malformed extensions")
    }
    var exts = exts1
    while len(exts) > 0 {
      let Some((one, r)) = cb.read_asn1(exts, cb.SEQUENCE) else {
        return Err("x509: malformed extension")
      }
      exts = r
      let e = parse_extension(one)?
      if e.id == OID_AKID {
        akid = parse_akid(e)?
      } else if e.id == OID_CRL_NUMBER {
        let Some((n, _)) = cb.read_asn1_big_int(e.value) else {
          return Err("x509: malformed crl number")
        }
        number = Some(n)
      }
      list = push(list, e)
    }
  }
  Ok(RevocationList {
    raw: raw,
    raw_tbs_revocation_list: tbs_raw,
    raw_issuer: iss_raw,
    raw_signature_algorithm: sig_ai_raw,
    issuer: pkix.fill_from_rdn_sequence(pkix.empty_name(), iss),
    authority_key_id: akid,
    signature: right_align(sig),
    signature_algorithm: sig_algo_from_ai(ai),
    revoked_certificate_entries: entries,
    revoked_certificates: revoked,
    number: number,
    this_update: this_update,
    next_update: next_update,
    extensions: list,
  })
}

// ───────── PKIX 公钥 ─────────

fn spki_ty() -> Ty {
  Ty.TStruct("publicKeyInfo", [
    asn1.field(Ty.TRawContent, ""),
    asn1.field(ai_ty(), ""),
    asn1.field(Ty.TBits, ""),
  ])
}

fn pkcs1_pub_ty() -> Ty {
  Ty.TStruct("pkcs1PublicKey", [asn1.field(Ty.TBig, ""), asn1.field(Ty.TInt, "")])
}

pub fn parse_pkix_public_key(der: List<Int>) -> Result<PublicKey, Str> {
  match asn1.unmarshal(der, spki_ty()) {
    Err(e) => {
      if is_ok(asn1.unmarshal(der, pkcs1_pub_ty())) {
        return Err(
          "x509: failed to parse public key (use ParsePKCS1PublicKey instead for this key format)",
        )
      }
      Err(e)
    },
    Ok((v, rest)) => {
      if len(rest) != 0 { return Err("x509: trailing data after ASN.1 of public-key") }
      let fs = match v {
        VStruct(x) => x,
        _ => [],
      }
      let alg = match fs[1] {
        VStruct(a) => a,
        _ => [],
      }
      let oid = match alg[0] {
        VOid(o) => o,
        _ => [],
      }
      let params = match alg[1] {
        VRaw(r) => r,
        _ => pkix.empty_raw(),
      }
      let bits = match fs[2] {
        VBits(b) => b,
        _ => BitString { bytes: [], bit_length: 0 },
      }
      parse_public_key(AlgorithmIdentifier { algorithm: oid, parameters: params }, bits)
    },
  }
}

// ───────── 私钥（pkcs1.go、sec1.go、pkcs8.go）─────────

pub enum PrivateKey {
  RSAPriv(rsa.PrivateKey)
  ECDSAPriv(ecdsa.PrivateKey)
  Ed25519Priv(List<Int>)
  X25519Priv(ecdh.PrivateKey)
  ECDHPriv(ecdh.PrivateKey)
  MLDSAPriv(mldsa.PrivateKey)
}

fn big_opt() -> Ty { Ty.TBig }

fn pkcs1_priv_ty() -> Ty {
  Ty.TStruct("pkcs1PrivateKey", [
    asn1.field(Ty.TInt, ""),
    asn1.field(Ty.TBig, ""),
    asn1.field(Ty.TInt, ""),
    asn1.field(Ty.TBig, ""),
    asn1.field(Ty.TBig, ""),
    asn1.field(Ty.TBig, ""),
    asn1.field(Ty.TBig, "optional"),
    asn1.field(Ty.TBig, "optional"),
    asn1.field(Ty.TBig, "optional"),
    asn1.field(
      Ty.TSlice("[]pkcs1AdditionalRSAPrime", [
        Ty.TStruct("pkcs1AdditionalRSAPrime", [
          asn1.field(Ty.TBig, ""),
          asn1.field(Ty.TBig, ""),
          asn1.field(Ty.TBig, ""),
        ]),
      ]),
      "optional,omitempty",
    ),
  ])
}

fn ec_priv_ty() -> Ty {
  Ty.TStruct("ecPrivateKey", [
    asn1.field(Ty.TInt, ""),
    asn1.field(Ty.TBytes, ""),
    asn1.field(Ty.TOid, "optional,explicit,tag:0"),
    asn1.field(Ty.TBits, "optional,explicit,tag:1"),
  ])
}

fn pkcs8_ty() -> Ty {
  Ty.TStruct("pkcs8", [asn1.field(Ty.TInt, ""), asn1.field(ai_ty(), ""), asn1.field(Ty.TBytes, "")])
}

fn fields(v: Val) -> List<Val> {
  match v {
    VStruct(fs) => fs,
    _ => [],
  }
}

fn vint(v: Val) -> Int {
  match v {
    VInt(n) => n,
    _ => 0,
  }
}

fn vbig(v: Val) -> BigInt? {
  match v {
    VBig(b) => b,
    _ => None,
  }
}

fn vbytes(v: Val) -> List<Int> {
  match v {
    VBytes(b) => b,
    _ => [],
  }
}

fn void(v: Val) -> List<Int> {
  match v {
    VOid(o) => o,
    _ => [],
  }
}

fn pos(b: BigInt?) -> Bool {
  match b {
    Some(x) => x.sign() > 0,
    None => false,
  }
}

fn nonpos_opt(b: BigInt?) -> Bool {
  match b {
    Some(x) => x.sign() <= 0,
    None => false,
  }
}

pub fn parse_pkcs1_private_key(der: List<Int>) -> Result<rsa.PrivateKey, Str> {
  let r = asn1.unmarshal(der, pkcs1_priv_ty())
  if let Ok((_, rest)) = r { if len(rest) > 0 { return Err("asn1: syntax error: trailing data") } }
  let (v, rest) = match r {
    Ok(x) => x,
    Err(e) => {
      if is_ok(asn1.unmarshal(der, ec_priv_ty())) {
        return Err(
          "x509: failed to parse private key (use ParseECPrivateKey instead for this key format)",
        )
      }
      if is_ok(asn1.unmarshal(der, pkcs8_ty())) {
        return Err(
          "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)",
        )
      }
      return Err(e)
    },
  }
  if len(rest) > 0 { return Err("asn1: syntax error: trailing data") }
  let fs = fields(v)
  if vint(fs[0]) > 1 { return Err("x509: unsupported private key version") }
  let n = vbig(fs[1])
  let d = vbig(fs[3])
  let p = vbig(fs[4])
  let q = vbig(fs[5])
  let dp = vbig(fs[6])
  let dq = vbig(fs[7])
  let qinv = vbig(fs[8])
  if !pos(n)
    || !pos(d)
    || !pos(p)
    || !pos(q)
    || nonpos_opt(dp)
    || nonpos_opt(dq)
    || nonpos_opt(qinv) {
    return Err("x509: private key contains zero or negative value")
  }
  let extra = match fs[9] {
    VList(xs) => xs,
    _ => [],
  }
  for a in extra {
    if !pos(vbig(fields(a)[0])) { return Err("x509: private key contains zero or negative prime") }
  }
  if len(extra) > 0 { return Err("x509: multi-prime RSA keys are not supported") }
  if dp != None && dq != None && qinv != None {
    return rsa.new_private_key_with_precomputation(
      unwrap(n),
      vint(fs[2]),
      unwrap(d),
      unwrap(p),
      unwrap(q),
      unwrap(dp),
      unwrap(dq),
      unwrap(qinv),
    )
  }
  rsa.new_private_key(unwrap(n), vint(fs[2]), unwrap(d), unwrap(p), unwrap(q))
}

pub fn marshal_pkcs1_private_key(k: rsa.PrivateKey) -> List<Int> {
  let v = Val.VStruct([
    Val.VInt(0),
    Val.VBig(Some(k.pub_.n)),
    Val.VInt(k.pub_.e),
    Val.VBig(Some(k.d)),
    Val.VBig(Some(k.p)),
    Val.VBig(Some(k.q)),
    Val.VBig(Some(k.dp)),
    Val.VBig(Some(k.dq)),
    Val.VBig(Some(k.qinv)),
    Val.VList([]),
  ])
  unwrap_or(asn1.marshal(v, pkcs1_priv_ty()), [])
}

pub fn parse_pkcs1_public_key(der: List<Int>) -> Result<rsa.PublicKey, Str> {
  let (v, rest) = match asn1.unmarshal(der, pkcs1_pub_ty()) {
    Ok(x) => x,
    Err(e) => {
      if is_ok(asn1.unmarshal(der, spki_ty())) {
        return Err(
          "x509: failed to parse public key (use ParsePKIXPublicKey instead for this key format)",
        )
      }
      return Err(e)
    },
  }
  if len(rest) > 0 { return Err("asn1: syntax error: trailing data") }
  let fs = fields(v)
  let n = vbig(fs[0])
  let e = vint(fs[1])
  if !pos(n) || e <= 0 { return Err("x509: public key contains zero or negative value") }
  if e > (1 << 31) - 1 { return Err("x509: public key contains large public exponent") }
  Ok(rsa.PublicKey { n: unwrap(n), e: e })
}

pub fn marshal_pkcs1_public_key(k: rsa.PublicKey) -> List<Int> {
  unwrap_or(asn1.marshal(Val.VStruct([Val.VBig(Some(k.n)), Val.VInt(k.e)]), pkcs1_pub_ty()), [])
}

const CURVE_OIDS: List<List<Int>> = [
  [1, 3, 132, 0, 33],
  [1, 2, 840, 10045, 3, 1, 7],
  [1, 3, 132, 0, 34],
  [1, 3, 132, 0, 35],
]

const CURVE_SIZES: List<Int> = [28, 32, 48, 66]

fn parse_ec_private_key_with(named: List<Int>?, der: List<Int>) -> Result<ecdsa.PrivateKey, Str> {
  let (v, _) = match asn1.unmarshal(der, ec_priv_ty()) {
    Ok(x) => x,
    Err(e) => {
      if is_ok(asn1.unmarshal(der, pkcs8_ty())) {
        return Err(
          "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)",
        )
      }
      if is_ok(asn1.unmarshal(der, pkcs1_priv_ty())) {
        return Err(
          "x509: failed to parse private key (use ParsePKCS1PrivateKey instead for this key format)",
        )
      }
      return Err("x509: failed to parse EC private key: " + e)
    },
  }
  let fs = fields(v)
  let ver = vint(fs[0])
  if ver != 1 { return Err("x509: unknown EC private key version {ver}") }
  let curve_oid = match named {
    Some(o) => o,
    None => void(fs[2]),
  }
  let c = named_curve(curve_oid)
  if c < 0 { return Err("x509: unknown elliptic curve") }
  let size = CURVE_SIZES[c]
  var pk = vbytes(fs[1])
  while len(pk) > size {
    if pk[0] != 0 { return Err("x509: invalid private key length") }
    pk = pk[1..]
  }
  while len(pk) < size { pk = [0] + pk }
  ecdsa.parse_raw_private_key(c, pk)
}

pub fn parse_ec_private_key(der: List<Int>) -> Result<ecdsa.PrivateKey, Str> {
  parse_ec_private_key_with(None, der)
}

fn marshal_ec_raw(priv: List<Int>, pub_: List<Int>, oid: List<Int>) -> Result<List<Int>, Str> {
  asn1.marshal(
    Val.VStruct([
      Val.VInt(1),
      Val.VBytes(priv),
      Val.VOid(oid),
      Val.VBits(BitString { bytes: pub_, bit_length: 0 }),
    ]),
    ec_priv_ty(),
  )
}

pub fn marshal_ec_private_key(k: ecdsa.PrivateKey) -> Result<List<Int>, Str> {
  if k.curve < 0 || k.curve > 3 { return Err("x509: unknown elliptic curve") }
  marshal_ec_raw(k.d, k.q, CURVE_OIDS[k.curve])
}

fn oid_der(o: List<Int>) -> List<Int> { unwrap_or(asn1.marshal(Val.VOid(o), Ty.TOid), []) }

pub fn parse_pkcs8_private_key(der: List<Int>) -> Result<PrivateKey, Str> {
  let (v, _) = match asn1.unmarshal(der, pkcs8_ty()) {
    Ok(x) => x,
    Err(e) => {
      if is_ok(asn1.unmarshal(der, ec_priv_ty())) {
        return Err(
          "x509: failed to parse private key (use ParseECPrivateKey instead for this key format)",
        )
      }
      if is_ok(asn1.unmarshal(der, pkcs1_priv_ty())) {
        return Err(
          "x509: failed to parse private key (use ParsePKCS1PrivateKey instead for this key format)",
        )
      }
      return Err(e)
    },
  }
  let fs = fields(v)
  let (alg, params) = ai_of(fs[1])
  let pk = vbytes(fs[2])
  if alg == OID_RSA {
    return match parse_pkcs1_private_key(pk) {
      Ok(k) => Ok(PrivateKey.RSAPriv(k)),
      Err(e) => Err("x509: failed to parse RSA private key embedded in PKCS#8: " + e),
    }
  }
  if alg == OID_ECDSA {
    let named = match asn1.unmarshal(params, Ty.TOid) {
      Ok((o, _)) => Some(void(o)),
      Err(_) => None,
    }
    return match parse_ec_private_key_with(named, pk) {
      Ok(k) => Ok(PrivateKey.ECDSAPriv(k)),
      Err(e) => Err("x509: failed to parse EC private key embedded in PKCS#8: " + e),
    }
  }
  if alg == OID_ED25519 {
    if len(params) != 0 { return Err("x509: invalid Ed25519 private key parameters") }
    let seed = match asn1.unmarshal(pk, Ty.TBytes) {
      Ok((s, _)) => vbytes(s),
      Err(e) => { return Err("x509: invalid Ed25519 private key: " + e) },
    }
    if len(seed) != 32 { return Err("x509: invalid Ed25519 private key length: {len(seed)}") }
    return Ok(PrivateKey.Ed25519Priv(ed25519.new_key_from_seed(seed)?))
  }
  if alg == OID_MLDSA44 || alg == OID_MLDSA65 || alg == OID_MLDSA87 {
    if len(params) != 0 { return Err("x509: invalid ML-DSA private key parameters") }
    if len(pk) == 0 { return Err("x509: invalid ML-DSA private key length: 0") }
    let t = pk[0]
    if t == 0x04 {
      return Err("x509: semi-expanded ML-DSA private keys without seed are not supported")
    }
    if t == 0x30 {
      return Err(
        "x509: ML-DSA private keys with both seed and expanded key are not supported, use e.g. \"openssl pkey -provparam ml-dsa.output_formats=seed-only\" to convert to a seed-only key",
      )
    }
    if t != 0x80 {
      return Err("x509: invalid ML-DSA private key: invalid ASN.1 tag " + strconv.format_int(
        t + 256,
        16,
      )[1..])
    }
    if len(pk) != 34 { return Err("x509: invalid ML-DSA private key length: {len(pk)}") }
    if pk[1] != 32 { return Err("x509: invalid ML-DSA private key ASN.1 encoding") }
    let Some(p) = mldsa_params(alg) else { return Err("x509: unknown ML-DSA parameters") }
    return Ok(PrivateKey.MLDSAPriv(mldsa.new_private_key(p, pk[2..])?))
  }
  if alg == OID_X25519 {
    if len(params) != 0 { return Err("x509: invalid X25519 private key parameters") }
    let k = match asn1.unmarshal(pk, Ty.TBytes) {
      Ok((s, _)) => vbytes(s),
      Err(e) => { return Err("x509: invalid X25519 private key: " + e) },
    }
    return Ok(PrivateKey.X25519Priv(ecdh.new_private_key(0, k)?))
  }
  Err("x509: PKCS#8 wrapping contained private key with unknown algorithm: " + asn1.oid_string(alg))
}

fn ai_val(alg: List<Int>, params: List<Int>) -> Val {
  Val.VStruct([Val.VOid(alg), Val.VRaw(RawValue { full_bytes: params, ..pkix.empty_raw() })])
}

pub fn marshal_pkcs8_private_key(key: PrivateKey) -> Result<List<Int>, Str> {
  var alg: List<Int> = []
  var params: List<Int> = []
  var body: List<Int> = []
  match key {
    RSAPriv(k) => {
      alg = OID_RSA
      params = NULL_BYTES
      body = marshal_pkcs1_private_key(k)
    },
    ECDSAPriv(k) => {
      if k.curve < 0 || k.curve > 3 { return Err("x509: unknown curve while marshaling to PKCS#8") }
      alg = OID_ECDSA
      params = oid_der(CURVE_OIDS[k.curve])
      body = match marshal_ec_raw(k.d, k.q, []) {
        Ok(b) => b,
        Err(e) => {
          return Err("x509: failed to marshal EC private key while building PKCS#8: " + e)
        },
      }
    },
    Ed25519Priv(k) => {
      alg = OID_ED25519
      body = asn1.marshal(Val.VBytes(ed25519.seed(k)), Ty.TBytes)?
    },
    MLDSAPriv(k) => {
      alg = if k.pub_.params.name == "ML-DSA-44" {
        OID_MLDSA44
      } else if k.pub_.params.name == "ML-DSA-65" {
        OID_MLDSA65
      } else {
        OID_MLDSA87
      }
      body = [0x80, 32] + k.seed
    },
    X25519Priv(k) => {
      alg = OID_X25519
      body = asn1.marshal(Val.VBytes(k.d), Ty.TBytes)?
    },
    ECDHPriv(k) => {
      if k.curve == 0 {
        alg = OID_X25519
        body = asn1.marshal(Val.VBytes(k.d), Ty.TBytes)?
      } else {
        alg = OID_ECDSA
        params = oid_der(CURVE_OIDS[k.curve])
        body = match marshal_ec_raw(k.d, k.pub_, []) {
          Ok(b) => b,
          Err(e) => {
            return Err("x509: failed to marshal EC private key while building PKCS#8: " + e)
          },
        }
      }
    },
  }
  asn1.marshal(Val.VStruct([Val.VInt(0), ai_val(alg, params), Val.VBytes(body)]), pkcs8_ty())
}

pub fn marshal_pkix_public_key(pub_: PublicKey) -> Result<List<Int>, Str> {
  var alg: List<Int> = []
  var params: List<Int> = []
  var bytes: List<Int> = []
  match pub_ {
    RSAKey(k) => {
      bytes = marshal_pkcs1_public_key(k)
      alg = OID_RSA
      params = NULL_BYTES
    },
    ECDSAKey(k) => {
      if k.curve < 0 || k.curve > 3 { return Err("x509: unsupported elliptic curve") }
      bytes = k.q
      alg = OID_ECDSA
      params = oid_der(CURVE_OIDS[k.curve])
    },
    Ed25519Key(k) => {
      bytes = k
      alg = OID_ED25519
    },
    MLDSAKey(k) => {
      bytes = k.raw
      alg = if k.params.name == "ML-DSA-44" {
        OID_MLDSA44
      } else if k.params.name == "ML-DSA-65" {
        OID_MLDSA65
      } else {
        OID_MLDSA87
      }
    },
    X25519Key(k) => {
      bytes = k.q
      if k.curve == 0 {
        alg = OID_X25519
      } else {
        alg = OID_ECDSA
        params = oid_der(CURVE_OIDS[k.curve])
      }
    },
    DSAKey(_) => { return Err("x509: unsupported public key type: *dsa.PublicKey") },
    NoKey => { return Err("x509: unsupported public key type: <nil>") },
  }
  asn1.marshal(
    Val.VStruct([
      ai_val(alg, params),
      Val.VBits(BitString { bytes: bytes, bit_length: 8 * len(bytes) }),
    ]),
    Ty.TStruct("pkixPublicKey", [asn1.field(ai_ty(), ""), asn1.field(Ty.TBits, "")]),
  )
}

// ───────── 签名校验 ─────────

pub const ERR_UNSUPPORTED_ALGORITHM: Str = "x509: cannot verify signature: algorithm unimplemented"
pub const ERR_CONSTRAINT_VIOLATION: Str =
  "x509: invalid signature: parent certificate cannot sign this kind of certificate"

fn digest(h: Int, b: List<Int>) -> List<Int> {
  if h == 3 {
    sha1.digest(b)
  } else if h == 5 {
    sha256.digest(b)
  } else if h == 6 {
    sha512.digest384(b)
  } else {
    sha512.digest(b)
  }
}

fn go_key_type(k: PublicKey) -> Str {
  match k {
    RSAKey(_) => "*rsa.PublicKey",
    ECDSAKey(_) => "*ecdsa.PublicKey",
    Ed25519Key(_) => "ed25519.PublicKey",
    MLDSAKey(_) => "*mldsa.PublicKey",
    DSAKey(_) => "*dsa.PublicKey",
    X25519Key(_) => "*ecdh.PublicKey",
    NoKey => "<nil>",
  }
}

pub fn check_signature(
  algo: Int,
  signed0: List<Int>,
  signature: List<Int>,
  public_key: PublicKey,
  allow_sha1: Bool,
) -> Result<(), Str> {
  var hash = 0
  var pka = 0
  var pss = false
  for d in signature_algorithm_details() {
    if d.algo == algo {
      hash = d.hash
      pka = d.pub_algo
      pss = d.pss
      break
    }
  }
  var signed = signed0
  if hash == 0 {
    if pka != ED25519 && pka != MLDSA { return Err(ERR_UNSUPPORTED_ALGORITHM) }
  } else if hash == 2 {
    return Err(
      "x509: cannot verify signature: insecure algorithm " + signature_algorithm_string(algo),
    )
  } else {
    if hash == 3 && !allow_sha1 {
      return Err(
        "x509: cannot verify signature: insecure algorithm " + signature_algorithm_string(algo),
      )
    }
    signed = digest(hash, signed0)
  }
  let mismatch = "x509: signature algorithm specifies an " + public_key_algorithm_string(
    pka,
  ) + " public key, but have public key of type " + go_key_type(public_key)
  match public_key {
    RSAKey(k) => {
      if pka != RSA { return Err(mismatch) }
      if pss { return rsa.verify_pss(k, hash, signed, signature, rsa.PSS_SALT_LENGTH_EQUALS_HASH) }
      rsa.verify_pkcs1v15(k, hash, signed, signature)
    },
    ECDSAKey(k) => {
      if pka != ECDSA { return Err(mismatch) }
      if !ecdsa.verify_asn1(k, signed, signature) { return Err("x509: ECDSA verification failure") }
      Ok(())
    },
    Ed25519Key(k) => {
      if pka != ED25519 { return Err(mismatch) }
      if !ed25519.verify(k, signed, signature) { return Err("x509: Ed25519 verification failure") }
      Ok(())
    },
    MLDSAKey(k) => {
      if pka != MLDSA { return Err(mismatch) }
      let want = if k.params.name == "ML-DSA-44" {
        MLDSA44
      } else if k.params.name == "ML-DSA-65" {
        MLDSA65
      } else {
        MLDSA87
      }
      if algo != want {
        return Err(
          "x509: signature algorithm specifies an ML-DSA public key with " + signature_algorithm_string(
            algo,
          ) + " parameters, but have a public key with " + k.params.name + " parameters",
        )
      }
      match mldsa.verify(k, signed, signature, None) {
        Ok(_) => Ok(()),
        Err(e) => Err("x509: ML-DSA verification failure: " + e),
      }
    },
    _ => Err(ERR_UNSUPPORTED_ALGORITHM),
  }
}

// Certificate.CheckSignature
pub fn certificate_check_signature(
  c: Certificate,
  algo: Int,
  signed: List<Int>,
  signature: List<Int>,
) -> Result<(), Str> {
  check_signature(algo, signed, signature, c.public_key, true)
}

fn parent_ok(parent: Certificate, usage: Int) -> Result<(), Str> {
  if (parent.version == 3 && !parent.basic_constraints_valid)
    || (parent.basic_constraints_valid && !parent.is_ca) {
    return Err(ERR_CONSTRAINT_VIOLATION)
  }
  if parent.key_usage != 0 && parent.key_usage & usage == 0 { return Err(ERR_CONSTRAINT_VIOLATION) }
  if parent.public_key_algorithm == UNKNOWN_PUBLIC_KEY_ALGORITHM {
    return Err(ERR_UNSUPPORTED_ALGORITHM)
  }
  Ok(())
}

// Certificate.CheckSignatureFrom
pub fn check_signature_from(c: Certificate, parent: Certificate) -> Result<(), Str> {
  parent_ok(parent, KEY_USAGE_CERT_SIGN)?
  check_signature(
    c.signature_algorithm,
    c.raw_tbs_certificate,
    c.signature,
    parent.public_key,
    false,
  )
}

// RevocationList.CheckSignatureFrom
pub fn revocation_list_check_signature_from(
  rl: RevocationList,
  parent: Certificate,
) -> Result<(), Str> {
  parent_ok(parent, KEY_USAGE_CRL_SIGN)?
  check_signature(
    rl.signature_algorithm,
    rl.raw_tbs_revocation_list,
    rl.signature,
    parent.public_key,
    true,
  )
}

// ───────── CSR ─────────

pub type AttributeTypeAndValueSET = { typ: List<Int>, value: List<List<AttributeTypeAndValue>> }

pub type CertificateRequest = {
  raw: List<Int>,
  raw_tbs_certificate_request: List<Int>,
  raw_subject_public_key_info: List<Int>,
  raw_subject: List<Int>,
  raw_signature_algorithm: List<Int>,
  version: Int,
  signature: List<Int>,
  signature_algorithm: Int,
  public_key_algorithm: Int,
  public_key: PublicKey,
  subject: Name,
  attributes: List<AttributeTypeAndValueSET>,
  extensions: List<Extension>,
  dns_names: List<Str>,
  email_addresses: List<Str>,
  ip_addresses: List<List<Int>>,
  uris: List<url.URL>,
}

fn csr_ty() -> Ty {
  Ty.TStruct("certificateRequest", [
    asn1.field(Ty.TRawContent, ""),
    asn1.field(
      Ty.TStruct("tbsCertificateRequest", [
        asn1.field(Ty.TRawContent, ""),
        asn1.field(Ty.TInt, ""),
        asn1.field(Ty.TRaw, ""),
        asn1.field(spki_ty(), ""),
        asn1.field(Ty.TSlice("[]asn1.RawValue", [Ty.TRaw]), "tag:0"),
      ]),
      "",
    ),
    asn1.field(
      Ty.TStruct("", [
        asn1.field(Ty.TRawContent, ""),
        asn1.field(Ty.TOid, ""),
        asn1.field(Ty.TRaw, "optional"),
      ]),
      "",
    ),
    asn1.field(Ty.TBits, ""),
  ])
}

fn atv_set_ty() -> Ty {
  Ty.TStruct("AttributeTypeAndValueSET", [
    asn1.field(Ty.TOid, ""),
    asn1.field(
      Ty.TSlice("[][]pkix.AttributeTypeAndValue", [
        Ty.TSlice("[]pkix.AttributeTypeAndValue", [
          Ty.TStruct("AttributeTypeAndValue", [asn1.field(Ty.TOid, ""), asn1.field(Ty.TAny, "")]),
        ]),
      ]),
      "set",
    ),
  ])
}

fn ext_list_ty() -> Ty {
  Ty.TSlice("[]pkix.Extension", [
    Ty.TStruct("Extension", [
      asn1.field(Ty.TOid, ""),
      asn1.field(Ty.TBool, "optional"),
      asn1.field(Ty.TBytes, ""),
    ]),
  ])
}

fn vlist(v: Val) -> List<Val> {
  match v {
    VList(xs) => xs,
    _ => [],
  }
}

fn vraw(v: Val) -> RawValue {
  match v {
    VRaw(r) => r,
    _ => pkix.empty_raw(),
  }
}

fn vbits(v: Val) -> BitString {
  match v {
    VBits(b) => b,
    _ => BitString { bytes: [], bit_length: 0 },
  }
}

fn parse_raw_attributes(raws: List<Val>) -> List<AttributeTypeAndValueSET> {
  var out: List<AttributeTypeAndValueSET> = []
  for r in raws {
    if let Ok((v, rest)) = asn1.unmarshal(vraw(r).full_bytes, atv_set_ty()) {
      if len(rest) == 0 {
        let fs = fields(v)
        let sets = map(
          vlist(fs[1]),
          (s) => map(
            vlist(s),
            (a) => AttributeTypeAndValue { typ: void(fields(a)[0]), value: fields(a)[1] },
          ),
        )
        out = push(out, AttributeTypeAndValueSET { typ: void(fs[0]), value: sets })
      }
    }
  }
  out
}

const OID_EXTENSION_REQUEST: List<Int> = [1, 2, 840, 113549, 1, 9, 14]

fn parse_csr_extensions(raws: List<Val>) -> Result<List<Extension>, Str> {
  let attr_ty = Ty.TStruct("pkcs10Attribute", [
    asn1.field(Ty.TOid, ""),
    asn1.field(Ty.TSlice("[]asn1.RawValue", [Ty.TRaw]), "set"),
  ])
  var out: List<Extension> = []
  var seen: List<Str> = []
  for r in raws {
    let Ok((v, rest)) = asn1.unmarshal(vraw(r).full_bytes, attr_ty) else { continue }
    let fs = fields(v)
    let values = vlist(fs[1])
    if len(rest) != 0 || len(values) == 0 { continue }
    if void(fs[0]) != OID_EXTENSION_REQUEST { continue }
    let (ev, _) = asn1.unmarshal(vraw(values[0]).full_bytes, ext_list_ty())?
    let exts = map(
      vlist(ev),
      (e) => {
        let f = fields(e)
        let crit = match f[1] {
          VBool(b) => b,
          _ => false,
        }
        Extension { id: void(f[0]), critical: crit, value: vbytes(f[2]) }
      },
    )
    for e in exts {
      let s = asn1.oid_string(e.id)
      if contains(seen, s) {
        return Err("x509: certificate request contains duplicate requested extensions")
      }
      seen = push(seen, s)
    }
    out = out + exts
  }
  Ok(out)
}

pub fn parse_certificate_request(der: List<Int>) -> Result<CertificateRequest, Str> {
  let (v, rest) = asn1.unmarshal(der, csr_ty())?
  if len(rest) != 0 { return Err("asn1: syntax error: trailing data") }
  let fs = fields(v)
  let tbs = fields(fs[1])
  let spki = fields(tbs[3])
  let (pk_oid, pk_params) = ai_of(spki[1])
  let sa = fields(fs[2])
  let raws = vlist(tbs[4])
  let subject = vraw(tbs[2])
  let pka = pub_algo_from_oid(pk_oid)
  var pk = PublicKey.NoKey
  if pka != UNKNOWN_PUBLIC_KEY_ALGORITHM {
    let params = vraw(fields(spki[1])[1])
    pk = parse_public_key(AlgorithmIdentifier { algorithm: pk_oid, parameters: params }, vbits(spki[
      2
    ]))?
  }
  let _ = pk_params
  let sub = parse_name(subject.full_bytes)?
  let exts = parse_csr_extensions(raws)?
  var san = SAN { dns: [], emails: [], ips: [], uris: [] }
  for e in exts { if e.id == [2, 5, 29, 17] { san = parse_san(e.value)? } }
  Ok(CertificateRequest {
    raw: vbytes(fs[0]),
    raw_tbs_certificate_request: vbytes(tbs[0]),
    raw_subject_public_key_info: vbytes(spki[0]),
    raw_subject: subject.full_bytes,
    raw_signature_algorithm: vbytes(sa[0]),
    version: vint(tbs[1]),
    signature: right_align(vbits(fs[3])),
    signature_algorithm: sig_algo_from_ai(AlgorithmIdentifier {
      algorithm: void(sa[1]),
      parameters: vraw(sa[2]),
    }),
    public_key_algorithm: pka,
    public_key: pk,
    subject: pkix.fill_from_rdn_sequence(pkix.empty_name(), sub),
    attributes: parse_raw_attributes(raws),
    extensions: exts,
    dns_names: san.dns,
    email_addresses: san.emails,
    ip_addresses: san.ips,
    uris: san.uris,
  })
}

// CertificateRequest.CheckSignature
pub fn certificate_request_check_signature(c: CertificateRequest) -> Result<(), Str> {
  check_signature(
    c.signature_algorithm,
    c.raw_tbs_certificate_request,
    c.signature,
    c.public_key,
    true,
  )
}

// ───────── CertPool（cert_pool.go）─────────

pub type Constraint = fn(List<Certificate>) -> Result<(), Str>

pub type PoolEntry = { cert: Certificate, constraint: Option<Constraint> }

// 不可变：add_cert 等返回新池。按加入顺序保存；by_name 用线性筛选代替（结果顺序相同）。
pub type CertPool = { entries: List<PoolEntry>, sums: Set<Str>, system_pool: Bool }

pub fn new_cert_pool() -> CertPool { CertPool { entries: [], sums: Set(), system_pool: false } }

fn sum224(raw: List<Int>) -> Str { hex_str(sha256.digest224(raw)) }

fn hex_str(b: List<Int>) -> Str {
  let digits = "0123456789abcdef"
  var out = ""
  for x in b {
    out = out + __str_slice(digits, x >> 4, (x >> 4) + 1) + __str_slice(
      digits,
      x & 15,
      (x & 15) + 1,
    )
  }
  out
}

fn add_cert_func(s: CertPool, c: Certificate, constraint: Option<Constraint>) -> CertPool {
  let h = sum224(c.raw)
  if contains(s.sums, h) { return s }
  CertPool {
    entries: push(s.entries, PoolEntry { cert: c, constraint: constraint }),
    sums: union(s.sums, Set([h])),
    system_pool: s.system_pool,
  }
}

pub fn cert_pool_add_cert(s: CertPool, c: Certificate) -> CertPool { add_cert_func(s, c, None) }

pub fn cert_pool_add_cert_with_constraint(
  s: CertPool,
  c: Certificate,
  constraint: Constraint,
) -> CertPool {
  add_cert_func(s, c, Some(constraint))
}

// AppendCertsFromPEM：返回 (新池, ok)；Kite 的 pem 以 Str 为输入
pub fn cert_pool_append_certs_from_pem(s0: CertPool, pem_certs: Str) -> (CertPool, Bool) {
  var s = s0
  var ok = false
  var data = pem_certs
  while len(data) > 0 {
    let (b, rest) = pem.decode(data)
    data = rest
    let Some(blk) = b else { break }
    if blk.typ != "CERTIFICATE" || len(blk.headers) != 0 { continue }
    let Ok(c) = parse_certificate(blk.bytes) else { continue }
    s = add_cert_func(s, c, None)
    ok = true
  }
  (s, ok)
}

pub fn cert_pool_len(s: CertPool) -> Int { len(s.entries) }

pub fn cert_pool_subjects(s: CertPool) -> List<List<Int>> {
  map(s.entries, (e) => e.cert.raw_subject)
}

pub fn cert_pool_contains(s: CertPool, c: Certificate) -> Bool { contains(s.sums, sum224(c.raw)) }

pub fn cert_pool_equal(a: CertPool, b: CertPool) -> Bool {
  if a.system_pool != b.system_pool || len(a.sums) != len(b.sums) { return false }
  for h in a.sums { if !contains(b.sums, h) { return false } }
  true
}

fn find_potential_parents(s: CertPool, c: Certificate) -> List<PoolEntry> {
  var matching: List<PoolEntry> = []
  var one: List<PoolEntry> = []
  var mismatch: List<PoolEntry> = []
  for e in s.entries {
    if e.cert.raw_subject != c.raw_issuer { continue }
    let skid = e.cert.subject_key_id
    let akid = c.authority_key_id
    if skid == akid {
      matching = push(matching, e)
    } else if (len(skid) == 0 && len(akid) > 0) || (len(skid) > 0 && len(akid) == 0) {
      one = push(one, e)
    } else {
      mismatch = push(mismatch, e)
    }
  }
  matching + one + mismatch
}

// root_linux.go / root_unix.go：SSL_CERT_FILE、SSL_CERT_DIR，否则常见发行版路径
const CERT_FILES: List<Str> = [
  "/etc/ssl/certs/ca-certificates.crt",
  "/etc/pki/tls/certs/ca-bundle.crt",
  "/etc/ssl/ca-bundle.pem",
  "/etc/pki/tls/cacert.pem",
  "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
  "/etc/ssl/cert.pem",
]

const CERT_DIRS: List<Str> = ["/etc/ssl/certs", "/etc/pki/tls/certs"]

// SystemCertPool
pub fn system_cert_pool() -> Result<CertPool, Str> {
  var roots = CertPool { system_pool: true, ..new_cert_pool() }
  var first_err = ""
  var files = CERT_FILES
  let f = unwrap_or(os.getenv("SSL_CERT_FILE"), "")
  if f != "" { files = [f] }
  for file in files {
    match fs.read(file) {
      Ok(data) => {
        let (r, _) = cert_pool_append_certs_from_pem(roots, data)
        roots = r
        break
      },
      Err(e) => { if first_err == "" { first_err = e } },
    }
  }
  var dirs = CERT_DIRS
  let d = unwrap_or(os.getenv("SSL_CERT_DIR"), "")
  if d != "" { dirs = split(d, ":") }
  for dir in dirs {
    let Ok(names) = fs.list(dir) else { continue }
    for name in sort(names) {
      if let Ok(data) = fs.read(dir + "/" + name) {
        let (r, _) = cert_pool_append_certs_from_pem(roots, data)
        roots = r
      }
    }
  }
  if len(roots.entries) > 0 || first_err == "" { return Ok(roots) }
  Err(first_err)
}

// ───────── 名称约束（constraints.go）─────────

pub type Mailbox = { local: Str, domain: Str }

fn mailbox_string(m: Mailbox) -> Str { m.local + "@" + m.domain }

fn ipnet_contains(n: IPNet, ip0: List<Int>) -> Bool {
  // net.IPNet.Contains
  var nn = n.ip
  if len(nn) == 16 && is_v4_mapped(nn) { nn = nn[12..] }
  var ip = ip0
  if len(ip) == 16 && is_v4_mapped(ip) { ip = ip[12..] }
  let m = if len(n.mask) == 16 && len(nn) == 4 { n.mask[12..] } else { n.mask }
  if len(ip) != len(nn) || len(m) != len(nn) { return false }
  var i = 0
  while i < len(ip) {
    if nn[i] & m[i] != ip[i] & m[i] { return false }
    i += 1
  }
  true
}

fn bytes_compare(a: List<Int>, b: List<Int>) -> Int {
  var i = 0
  while i < len(a) && i < len(b) {
    if a[i] != b[i] { return if a[i] < b[i] { -1 } else { 1 } }
    i += 1
  }
  if len(a) < len(b) { -1 } else if len(a) > len(b) { 1 } else { 0 }
}

fn ip_network_subset(a: IPNet, b: IPNet) -> Bool {
  if !ipnet_contains(a, b.ip) { return false }
  var bc: List<Int> = []
  var i = 0
  while i < len(b.ip) {
    let m = if i < len(b.mask) { b.mask[i] } else { 0 }
    bc = push(bc, b.ip[i] | (255 ^ m))
    i += 1
  }
  ipnet_contains(a, bc)
}

fn ip_network_compare(a: IPNet, b: IPNet) -> Int {
  let i = bytes_compare(a.ip, b.ip)
  if i != 0 { i } else { bytes_compare(a.mask, b.mask) }
}

fn sort_and_prune<T>(set0: List<T>, cmp: fn(T, T) -> Int, subset: fn(T, T) -> Bool) -> List<T> {
  if len(set0) < 2 { return set0 }
  let set = sort_with(set0, cmp)
  var out = [set[0]]
  var r = 1
  while r < len(set) {
    if !subset(out[len(out) - 1], set[r]) { out = push(out, set[r]) }
    r += 1
  }
  out
}

fn search<T, V>(set: List<T>, s: V, cmp: fn(T, V) -> Int, matches: fn(T, V) -> Bool) -> Option<T> {
  if len(set) == 0 { return None }
  // slices.BinarySearchFunc
  var lo = 0
  var hi = len(set)
  while lo < hi {
    let h = (lo + hi) / 2
    if cmp(set[h], s) < 0 { lo = h + 1 } else { hi = h }
  }
  if lo < len(set) && cmp(set[lo], s) == 0 { return Some(set[lo]) }
  let c = if lo == 0 { set[0] } else { set[lo - 1] }
  if matches(c, s) { Some(c) } else { None }
}

fn ip_mask(ip: List<Int>, mask: List<Int>) -> List<Int>? {
  // net.IP.Mask
  var m = mask
  var p = ip
  if len(m) == 16 && len(p) == 4 && m[..12] == map(0..12, (_) => 255) { m = m[12..] }
  if len(m) == 4 && len(p) == 16 && is_v4_mapped(p) { p = p[12..] }
  if len(m) != len(p) { return None }
  var out: List<Int> = []
  var i = 0
  while i < len(p) {
    out = push(out, p[i] & m[i])
    i += 1
  }
  Some(out)
}

fn ip_equal(a: List<Int>, b: List<Int>) -> Bool {
  // net.IP.Equal
  if len(a) == len(b) { return a == b }
  if len(a) == 4 && len(b) == 16 { return is_v4_mapped(b) && b[12..] == a }
  if len(a) == 16 && len(b) == 4 { return is_v4_mapped(a) && a[12..] == b }
  false
}

type IPConstraints = { v4: List<IPNet>, v6: List<IPNet> }

fn new_ip_constraints(l: List<IPNet>) -> Option<IPConstraints> {
  if len(l) == 0 { return None }
  var v4: List<IPNet> = []
  var v6: List<IPNet> = []
  for n0 in l {
    var n = n0
    if let Some(masked) = ip_mask(n.ip, n.mask) {
      if !ip_equal(masked, n.ip) { n = IPNet { ip: masked, mask: n.mask } }
    }
    if len(n.ip) == 4 { v4 = push(v4, n) } else { v6 = push(v6, n) }
  }
  Some(IPConstraints {
    v4: sort_and_prune(v4, ip_network_compare, ip_network_subset),
    v6: sort_and_prune(v6, ip_network_compare, ip_network_subset),
  })
}

fn ip_query(c: IPConstraints, ip: List<Int>) -> Option<IPNet> {
  let set = if len(ip) == 4 { c.v4 } else { c.v6 }
  search(
    set,
    ip,
    (n: IPNet, t: List<Int>) => bytes_compare(n.ip, t),
    (n: IPNet, t: List<Int>) => ipnet_contains(n, t),
  )
}

fn ascii_lower_b(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

fn dns_has_suffix(a0: Str, b0: Str) -> Bool {
  let a = __bytes(a0)
  let b = __bytes(b0)
  let la = len(a)
  let lb = len(b)
  if la > lb { return false }
  var i = la - 1
  let offset = la - lb
  while i >= 0 {
    var ar = a[i]
    var br = b[i - offset]
    i -= 1
    if ar == br { continue }
    if br < ar {
      let t = ar
      ar = br
      br = t
    }
    if ar >= 65 && ar <= 90 && br == ar + 32 { continue }
    return false
  }
  // Go 在 la == 0 时会越界 panic；约束串在这里不会为空
  if la > 0 && a[0] != 46 && lb > la && b[lb - la - 1] != 46 { return false }
  true
}

fn dns_table(c: Int) -> Int { if c == 46 { 0 } else { ascii_lower_b(c) } }

fn dns_compare(a0: Str, b0: Str) -> Int {
  let a = __bytes(a0)
  let b = __bytes(b0)
  var ia = len(a) - 1
  var ib = len(b) - 1
  while ia >= 0 && ib >= 0 {
    let x = dns_table(a[ia])
    let y = dns_table(b[ib])
    if x == y {
      ia -= 1
      ib -= 1
      continue
    }
    return if x < y { -1 } else { 1 }
  }
  if ia < ib { -1 } else if ib < ia { 1 } else { 0 }
}

fn trim_first_label(s: Str) -> Str {
  let i = __str_find(s, ".", 0)
  if i < 0 { "" } else { __str_slice(s, i, len(s)) }
}

type DNSConstraints = { all: Bool, permitted: Bool, set: List<Str>, parents: List<(Str, Str)> }

fn new_dns_constraints(l: List<Str>, permitted: Bool) -> Option<DNSConstraints> {
  if len(l) == 0 { return None }
  for n in l {
    if len(n) == 0 {
      return Some(DNSConstraints { all: true, permitted: false, set: [], parents: [] })
    }
  }
  let set = sort_and_prune(l, dns_compare, dns_has_suffix)
  var parents: List<(Str, Str)> = []
  if !permitted {
    for name0 in set {
      let name = lower(name0)
      let t = trim_first_label(name)
      if t == "" { continue }
      parents = push(filter(parents, (p) => p.0 != t), (t, name))
    }
  }
  Some(DNSConstraints { all: false, permitted: permitted, set: set, parents: parents })
}

fn dns_query(c: DNSConstraints, s0: Str) -> Option<Str> {
  if c.all { return Some("") }
  if let Some(x) = search(c.set, s0, dns_compare, dns_has_suffix) { return Some(x) }
  if !c.permitted && len(s0) > 0 && starts_with(s0, "*") {
    let t = trim_first_label(lower(s0))
    for p in c.parents { if p.0 == t { return Some(p.1) } }
  }
  None
}

type EmailConstraints = { dns: Option<DNSConstraints>, full: List<Mailbox> }

fn new_email_constraints(l: List<Str>, permitted: Bool) -> Option<EmailConstraints> {
  if len(l) == 0 { return None }
  var full: List<Mailbox> = []
  var domains: List<Str> = []
  for c in l {
    if !contains(c, "@") {
      domains = push(domains, c)
      continue
    }
    let Some((lo, d)) = parse_rfc2821_mailbox(c) else { continue }
    full = push(full, Mailbox { local: lo, domain: lower(d) })
  }
  Some(EmailConstraints {
    dns: if len(domains) > 0 { new_dns_constraints(domains, permitted) } else { None },
    full: full,
  })
}

fn email_query(c: EmailConstraints, s: Mailbox) -> Option<Str> {
  for m in c.full { if m == s { return Some(mailbox_string(s)) } }
  match c.dns {
    Some(d) => dns_query(d, s.domain),
    None => None,
  }
}

type ChainConstraints = {
  ip_p: Option<IPConstraints>,
  ip_e: Option<IPConstraints>,
  dns_p: Option<DNSConstraints>,
  dns_e: Option<DNSConstraints>,
  uri_p: Option<DNSConstraints>,
  uri_e: Option<DNSConstraints>,
  email_p: Option<EmailConstraints>,
  email_e: Option<EmailConstraints>,
  index: Int,
}

fn go_ip_string(ip: List<Int>) -> Str {
  // net.IP.String
  if len(ip) == 0 { return "<nil>" }
  if len(ip) == 4 { return addr_from4(ip).string() }
  if len(ip) == 16 {
    if is_v4_mapped(ip) { return addr_from4(ip[12..]).string() }
    return addr_from16(ip).string()
  }
  "?" + hex_str(ip)
}

fn check_one(
  typ: Str,
  shown: Str,
  permitted: Option<Option<Str>>,
  excluded: Option<Option<Str>>,
) -> Result<(), Str> {
  // permitted / excluded：None = 没有这类约束；Some(查询结果)
  if let Some(found) = permitted {
    if found == None {
      return Err(typ + " " + strconv.quote_go(shown) + " is not permitted by any constraint")
    }
  }
  if let Some(found) = excluded {
    if let Some(c) = found {
      return Err(
        typ + " " + strconv.quote_go(shown) + " is excluded by constraint " + strconv.quote_go(c),
      )
    }
  }
  Ok(())
}

fn q_ip(c: Option<IPConstraints>, ip: List<Int>) -> Option<Option<Str>> {
  match c {
    Some(x) => Some(match ip_query(x, ip) {
      Some(n) => Some(ipnet_string(n)),
      None => None,
    }),
    None => None,
  }
}

fn q_dns(c: Option<DNSConstraints>, s: Str) -> Option<Option<Str>> {
  match c {
    Some(x) => Some(dns_query(x, s)),
    None => None,
  }
}

fn q_email(c: Option<EmailConstraints>, s: Mailbox) -> Option<Option<Str>> {
  match c {
    Some(x) => Some(email_query(x, s)),
    None => None,
  }
}

// net.IPNet.String（只在 excluded 的错误信息里用到）
fn ipnet_string(n: IPNet) -> Str {
  var ones = 0
  var ok = true
  var seen_zero = false
  for b in n.mask {
    var k = 7
    while k >= 0 {
      if (b >> k) & 1 == 1 {
        if seen_zero { ok = false }
        ones += 1
      } else {
        seen_zero = true
      }
      k -= 1
    }
  }
  let ip = go_ip_string(n.ip)
  if ok && (len(n.mask) == len(n.ip) || (len(n.mask) == 16 && len(n.ip) == 4)) {
    let o = if len(n.mask) == 16 && len(n.ip) == 4 { ones - 96 } else { ones }
    return ip + "/{o}"
  }
  ip + "/" + hex_str(n.mask)
}

type ParsedURI = { uri: Str, domain: Str }

fn cc_check(
  cc: ChainConstraints,
  dns: List<Str>,
  uris: List<ParsedURI>,
  emails: List<Mailbox>,
  ips: List<List<Int>>,
) -> Result<(), Str> {
  for ip in ips { check_one("IP address", go_ip_string(ip), q_ip(cc.ip_p, ip), q_ip(cc.ip_e, ip))? }
  for d in dns {
    if !domain_name_valid(d, false) {
      return Err("x509: cannot parse dnsName " + strconv.quote_go(d))
    }
    check_one("DNS name", d, q_dns(cc.dns_p, d), q_dns(cc.dns_e, d))?
  }
  for u in uris {
    if !domain_name_valid(u.domain, false) {
      return Err("x509: internal error: URI SAN " + strconv.quote_go(u.uri) + " failed to parse")
    }
    check_one("URI", u.uri, q_dns(cc.uri_p, u.domain), q_dns(cc.uri_e, u.domain))?
  }
  for e in emails {
    if !domain_name_valid(e.domain, false) {
      return Err("x509: cannot parse rfc822Name " + strconv.quote_go(mailbox_string(e)))
    }
    check_one("email address", mailbox_string(e), q_email(cc.email_p, e), q_email(cc.email_e, e))?
  }
  Ok(())
}

fn has_ext(c: Certificate, oid: List<Int>) -> Bool {
  for e in c.extensions { if e.id == oid { return true } }
  false
}

fn parse_uris(uris: List<url.URL>) -> Result<List<ParsedURI>, Str> {
  var out: List<ParsedURI> = []
  for u in uris {
    let us = url.to_str(u)
    var host = lower(u.host)
    if len(host) == 0 {
      return Err(
        "URI with empty host (" + strconv.quote_go(us) + ") cannot be matched against constraints",
      )
    }
    if contains(host, ":") && !ends_with(host, "]") {
      match split_host_port(u.host) {
        Ok((h, _)) => { host = h },
        Err(e) => { return Err("cannot parse URI host " + strconv.quote_go(u.host) + ": " + e) },
      }
    }
    if is_ok(parse_addr(host)) || (starts_with(host, "[") && ends_with(host, "]")) {
      return Err("URI with IP (" + strconv.quote_go(us) + ") cannot be matched against constraints")
    }
    out = push(out, ParsedURI { uri: us, domain: host })
  }
  Ok(out)
}

fn parse_mailboxes(emails: List<Str>) -> Result<List<Mailbox>, Str> {
  var out: List<Mailbox> = []
  for e in emails {
    let Some((lo, d)) = parse_rfc2821_mailbox(e) else {
      return Err("cannot parse rfc822Name " + strconv.quote_go(e))
    }
    out = push(out, Mailbox { local: lo, domain: lower(d) })
  }
  Ok(out)
}

fn check_chain_constraints(chain: List<Certificate>) -> Result<(), Str> {
  var ccs: List<ChainConstraints> = []
  var i = 0
  for c in chain {
    if has_ext(c, [2, 5, 29, 30]) {
      ccs = push(ccs, ChainConstraints {
        ip_p: new_ip_constraints(c.permitted_ip_ranges),
        ip_e: new_ip_constraints(c.excluded_ip_ranges),
        dns_p: new_dns_constraints(c.permitted_dns_domains, true),
        dns_e: new_dns_constraints(c.excluded_dns_domains, false),
        uri_p: new_dns_constraints(c.permitted_uri_domains, true),
        uri_e: new_dns_constraints(c.excluded_uri_domains, false),
        email_p: new_email_constraints(c.permitted_email_addresses, true),
        email_e: new_email_constraints(c.excluded_email_addresses, false),
        index: i,
      })
    }
    i += 1
  }
  if len(ccs) == 0 { return Ok(()) }
  var cur = 0
  i = 0
  for c in chain {
    if !has_ext(c, [2, 5, 29, 17]) {
      i += 1
      continue
    }
    if i >= ccs[cur].index {
      while ccs[cur].index <= i {
        if cur + 1 >= len(ccs) { return Ok(()) }
        cur += 1
      }
    }
    let uris = parse_uris(c.uris)?
    let emails = parse_mailboxes(c.email_addresses)?
    var n = cur
    while n < len(ccs) {
      cc_check(ccs[n], c.dns_names, uris, emails, c.ip_addresses)?
      n += 1
    }
    i += 1
  }
  Ok(())
}

fn split_host_port(hostport: Str) -> Result<(Str, Str), Str> {
  let err = (why: Str) => Err("address " + hostport + ": " + why)
  let missing_port = "missing port in address"
  let too_many_colons = "too many colons in address"
  let i = strings.last_index(hostport, ":")
  if i < 0 { return err(missing_port) }
  var host = ""
  var j = 0
  var k = 0
  if starts_with(hostport, "[") {
    let end = __str_find(hostport, "]", 0)
    if end < 0 { return err("missing ']' in address") }
    if end + 1 == len(hostport) { return err(missing_port) }
    if end + 1 != i {
      if __str_slice(hostport, end + 1, end + 2) == ":" { return err(too_many_colons) }
      return err(missing_port)
    }
    host = __str_slice(hostport, 1, end)
    j = 1
    k = end + 1
  } else {
    host = __str_slice(hostport, 0, i)
    if contains(host, ":") { return err(too_many_colons) }
  }
  if contains(__str_slice(hostport, j, len(hostport)), "[") {
    return err("unexpected '[' in address")
  }
  if contains(__str_slice(hostport, k, len(hostport)), "]") {
    return err("unexpected ']' in address")
  }
  Ok((host, __str_slice(hostport, i + 1, len(hostport))))
}

// ───────── 主机名（verify.go）─────────

fn to_lower_ascii(s: Str) -> Str {
  // Kite 的 Str 总是合法 UTF-8，只需处理 A-Z
  bstr(map(__bytes(s), ascii_lower_b))
}

fn valid_hostname(host0: Str, is_pattern: Bool) -> Bool {
  var host = host0
  if !is_pattern && ends_with(host, ".") { host = __str_slice(host, 0, len(host) - 1) }
  if len(host) == 0 || host == "*" { return false }
  var i = 0
  for part in split(host, ".") {
    if part == "" { return false }
    if is_pattern && i == 0 && part == "*" {
      i += 1
      continue
    }
    var j = 0
    for c in __bytes(part) {
      let ok = (c >= 97 && c <= 122)
        || (c >= 48 && c <= 57)
        || (c >= 65 && c <= 90)
        || (c == 45 && j != 0)
        || c == 95
      if !ok { return false }
      j += 1
    }
    i += 1
  }
  true
}

fn match_exactly(a: Str, b: Str) -> Bool {
  if a == "" || a == "." || b == "" || b == "." { return false }
  to_lower_ascii(a) == to_lower_ascii(b)
}

fn match_hostnames(pattern0: Str, host_parts: List<Str>) -> Bool {
  let pattern = to_lower_ascii(pattern0)
  if len(pattern) == 0 || len(host_parts) == 0 { return false }
  let pp = split(pattern, ".")
  if len(pp) != len(host_parts) { return false }
  var i = 0
  for p in pp {
    if !(i == 0 && p == "*") && p != host_parts[i] { return false }
    i += 1
  }
  true
}

fn split_hostname(host: Str) -> List<Str> {
  let h = if ends_with(host, ".") { __str_slice(host, 0, len(host) - 1) } else { host }
  split(to_lower_ascii(h), ".")
}

fn hostname_error(c: Certificate, host: Str) -> Str {
  if !has_ext(c, [2, 5, 29, 17]) && match_hostnames(c.subject.common_name, split_hostname(host)) {
    return "x509: certificate relies on legacy Common Name field, use SANs instead"
  }
  var valid = ""
  let parsed = match parse_addr(host) {
    Ok(a) => a.zone() == "",
    Err(_) => false,
  }
  if parsed {
    if len(c.ip_addresses) == 0 {
      return "x509: cannot validate certificate for " + host + " because it doesn't contain any IP SANs"
    }
    if len(c.ip_addresses) >= 100 {
      return "x509: certificate is valid for {len(c.ip_addresses)} IP SANs, but none matched " + host
    }
    valid = join(map(c.ip_addresses, go_ip_string), ", ")
  } else {
    if len(c.dns_names) >= 100 {
      return "x509: certificate is valid for {len(c.dns_names)} names, but none matched " + host
    }
    valid = join(c.dns_names, ", ")
  }
  if len(valid) == 0 {
    return "x509: certificate is not valid for any names, but wanted to match " + host
  }
  "x509: certificate is valid for " + valid + ", not " + host
}

// Certificate.VerifyHostname
pub fn verify_hostname(c: Certificate, h: Str) -> Result<(), Str> {
  var cand = h
  if len(h) >= 3 && starts_with(h, "[") && ends_with(h, "]") {
    cand = __str_slice(h, 1, len(h) - 1)
  }
  if let Ok(a) = parse_addr(cand) {
    let ip = a.as_slice()
    for x in c.ip_addresses { if ip_equal(ip, x) { return Ok(()) } }
    return Err(hostname_error(c, go_ip_string(ip)))
  }
  let name = to_lower_ascii(h)
  let valid = valid_hostname(name, false)
  let parts = split_hostname(name)
  for m in c.dns_names {
    if valid && valid_hostname(m, true) {
      if match_hostnames(m, parts) { return Ok(()) }
    } else if match_exactly(m, name) {
      return Ok(())
    }
  }
  Err(hostname_error(c, h))
}

// ───────── 链验证 ─────────

pub type VerifyOptions = {
  dns_name: Str,
  intermediates: CertPool,
  roots: Option<CertPool>, // None = 系统根
  current_time: Time,       // 零值 = 现在
  key_usages: List<Int>,
  certificate_policies: List<OID>,
  inhibit_policy_mapping: Bool,
  require_explicit_policy: Bool,
  inhibit_any_policy: Bool,
}

pub fn verify_options() -> VerifyOptions {
  VerifyOptions {
    dns_name: "",
    intermediates: new_cert_pool(),
    roots: None,
    current_time: zero_time(),
    key_usages: [],
    certificate_policies: [],
    inhibit_policy_mapping: false,
    require_explicit_policy: false,
    inhibit_any_policy: false,
  }
}

pub const ERR_NOT_PARSED: Str = "x509: missing ASN.1 contents; use ParseCertificate"
pub const ERR_SIGNATURE_LIMIT: Str =
  "x509: signature check attempts limit reached while verifying certificate chain"

const LEAF: Int = 0
const INTERMEDIATE: Int = 1
const ROOT: Int = 2

fn time_before(a: Time, b: Time) -> Bool {
  a.unix < b.unix || (a.unix == b.unix && a.nsec < b.nsec)
}

fn rfc3339(t: Time) -> Str {
  let (y, mo, d, h, mi, sec) = asn1.civil(t)
  let p2 = (v: Int) => if v < 10 { "0{v}" } else { "{v}" }
  let ys = if y < 10 {
    "000{y}"
  } else if y < 100 {
    "00{y}"
  } else if y < 1000 {
    "0{y}"
  } else {
    "{y}"
  }
  let base = ys + "-" + p2(mo) + "-" + p2(d) + "T" + p2(h) + ":" + p2(mi) + ":" + p2(sec)
  if t.offset == 0 { return base + "Z" }
  var z = t.offset / 60
  var sign = "+"
  if z < 0 {
    sign = "-"
    z = -z
  }
  let hh = z / 60
  let mm = z % 60
  base + sign + (if hh < 10 { "0" } else { "" }) + "{hh}:" + (if mm < 10 {
    "0"
  } else {
    ""
  }) + "{mm}"
}

fn now_time() -> Time {
  let ms = time.unix_ms()
  Time { unix: ms / 1000, nsec: (ms % 1000) * 1000000, offset: 0 }
}

fn is_valid(
  c: Certificate,
  cert_type: Int,
  chain: List<Certificate>,
  now: Time,
) -> Result<(), Str> {
  if len(c.unhandled_critical_extensions) > 0 { return Err("x509: unhandled critical extension") }
  if len(chain) > 0 {
    if chain[len(chain) - 1].raw_issuer != c.raw_subject {
      return Err("x509: issuer name does not match subject from issuing certificate")
    }
  }
  if time_before(now, c.not_before) {
    return Err(
      "x509: certificate has expired or is not yet valid: current time " + rfc3339(
        now,
      ) + " is before " + rfc3339(c.not_before),
    )
  } else if time_before(c.not_after, now) {
    return Err(
      "x509: certificate has expired or is not yet valid: current time " + rfc3339(
        now,
      ) + " is after " + rfc3339(c.not_after),
    )
  }
  if (cert_type == INTERMEDIATE || cert_type == ROOT) && len(chain) == 0 {
    return Err("x509: internal error: empty chain when appending CA cert")
  }
  if cert_type == INTERMEDIATE && (!c.basic_constraints_valid || !c.is_ca) {
    return Err("x509: certificate is not authorized to sign other certificates")
  }
  if c.basic_constraints_valid && c.max_path_len >= 0 {
    if len(chain) - 1 > c.max_path_len {
      return Err("x509: too many intermediates for path length constraint")
    }
  }
  Ok(())
}

fn already_in_chain(cand: Certificate, chain: List<Certificate>) -> Bool {
  let san_of = (c: Certificate) => {
    var r: Option<List<Int>> = None
    for e in c.extensions {
      if e.id == [2, 5, 29, 17] {
        r = Some(e.value)
        break
      }
    }
    r
  }
  let cs = san_of(cand)
  for c in chain {
    if cand.raw_subject != c.raw_subject
      || cand.raw_subject_public_key_info != c.raw_subject_public_key_info {
      continue
    }
    let s = san_of(c)
    if cs == None && s == None { return true }
    if cs == None || s == None { return false }
    if cs == s { return true }
  }
  false
}

fn unknown_authority(hint_err: Option<Str>, hint: Option<Certificate>) -> Str {
  var s = "x509: certificate signed by unknown authority"
  if let Some(he) = hint_err {
    let hc = unwrap(hint)
    var name = hc.subject.common_name
    if len(name) == 0 {
      name = if len(hc.subject.organization) > 0 {
        hc.subject.organization[0]
      } else {
        "serial:" + hc.serial_number.text(10)
      }
    }
    s = s + " (possibly because of " + strconv.quote_go(
      he,
    ) + " while trying to verify candidate authority certificate "
    s = s + strconv.quote_go(name) + ")"
  }
  s
}

type Build = { chains: List<List<Certificate>>, err: Option<Str>, sig: Int }

fn build_chains(
  c: Certificate,
  chain: List<Certificate>,
  sig0: Int,
  roots: CertPool,
  inter: CertPool,
  now: Time,
) -> Build {
  var chains: List<List<Certificate>> = []
  var err: Option<Str> = None
  var sig = sig0
  var hint_err: Option<Str> = None
  var hint: Option<Certificate> = None
  var stop = false
  for (cert_type, pool) in [(ROOT, roots), (INTERMEDIATE, inter)] {
    if stop { break }
    for cand in find_potential_parents(pool, c) {
      sig += 1
      if sig > 100 {
        err = Some(ERR_SIGNATURE_LIMIT)
        stop = true
        break
      }
      let pc = cand.cert
      if pc.public_key == PublicKey.NoKey || already_in_chain(pc, chain) { continue }
      if let Err(e) = check_signature_from(c, pc) {
        if hint_err == None {
          hint_err = Some(e)
          hint = Some(pc)
        }
        continue
      }
      match is_valid(pc, cert_type, chain, now) {
        Err(e) => {
          err = Some(e)
          if hint_err == None {
            hint_err = Some(e)
            hint = Some(pc)
          }
          continue
        },
        Ok(_) => { err = None },
      }
      if let Some(f) = cand.constraint {
        if let Err(e) = f(chain) {
          if hint_err == None {
            hint_err = Some(e)
            hint = Some(pc)
          }
          continue
        }
      }
      if cert_type == ROOT {
        chains = push(chains, push(chain, pc))
      } else {
        let b = build_chains(pc, push(chain, pc), sig, roots, inter, now)
        sig = b.sig
        err = b.err
        chains = chains + b.chains
        if err == Some(ERR_SIGNATURE_LIMIT) {
          stop = true
          break
        }
      }
    }
  }
  if len(chains) > 0 { err = None }
  if len(chains) == 0 && err == None { err = Some(unknown_authority(hint_err, hint)) }
  Build { chains: chains, err: err, sig: sig }
}

fn check_chain_for_key_usage(chain: List<Certificate>, key_usages: List<Int>) -> Bool {
  var usages = key_usages
  if len(chain) == 0 { return false }
  var remaining = len(usages)
  var i = len(chain) - 1
  while i >= 0 {
    let cert = chain[i]
    i -= 1
    if len(cert.ext_key_usage) == 0 && len(cert.unknown_ext_key_usage) == 0 { continue }
    if contains(cert.ext_key_usage, EXT_KEY_USAGE_ANY) { continue }
    var k = 0
    while k < len(usages) {
      let u = usages[k]
      if u != -1 && !contains(cert.ext_key_usage, u) {
        usages = set_at_i(usages, k, -1)
        remaining -= 1
        if remaining == 0 { return false }
      }
      k += 1
    }
  }
  true
}

fn set_at_i(xs: List<Int>, i: Int, v: Int) -> List<Int> { xs[..i] + [v] + xs[i + 1..] }

// Certificate.Verify
pub fn verify(c: Certificate, opts0: VerifyOptions) -> Result<List<List<Certificate>>, Str> {
  var opts = opts0
  if len(c.raw) == 0 { return Err(ERR_NOT_PARSED) }
  for e in opts.intermediates.entries { if len(e.cert.raw) == 0 { return Err(ERR_NOT_PARSED) } }
  let roots = match opts.roots {
    Some(r) => r,
    None => match system_cert_pool() {
      Ok(r) => r,
      Err(e) => { return Err("x509: failed to load system roots and no roots provided; " + e) },
    },
  }
  let now = if opts.current_time == zero_time() { now_time() } else { opts.current_time }
  is_valid(c, LEAF, [], now)?
  if len(opts.dns_name) > 0 { verify_hostname(c, opts.dns_name)? }
  var cands: List<List<Certificate>> = []
  if cert_pool_contains(roots, c) {
    cands = [[c]]
  } else {
    let b = build_chains(c, [c], 0, roots, opts.intermediates, now)
    if let Some(e) = b.err { return Err(e) }
    cands = b.chains
  }
  let any_usage = contains(opts.key_usages, EXT_KEY_USAGE_ANY)
  if len(opts.key_usages) == 0 {
    opts = VerifyOptions { key_usages: [EXT_KEY_USAGE_SERVER_AUTH], ..opts }
  }
  var invalid_policies = 0
  var incompatible = 0
  var hint: Option<Str> = None
  var kept: List<List<Certificate>> = []
  for ch in cands {
    if !policies_valid(ch, opts) {
      invalid_policies += 1
      continue
    }
    if !any_usage && !check_chain_for_key_usage(ch, opts.key_usages) {
      incompatible += 1
      continue
    }
    if let Err(e) = check_chain_constraints(ch) {
      if hint == None {
        hint = Some(
          "x509: a root or intermediate certificate is not authorized to sign for this name: " + e,
        )
      }
      continue
    }
    kept = push(kept, ch)
  }
  if len(kept) == 0 {
    if let Some(h) = hint { return Err(h) }
    var details: List<Str> = []
    if incompatible > 0 {
      if invalid_policies == 0 {
        return Err("x509: certificate specifies an incompatible key usage")
      }
      details = push(details, "{incompatible} candidate chains with incompatible key usage")
    }
    if invalid_policies > 0 {
      details = push(details, "{invalid_policies} candidate chains with invalid policies")
    }
    let d = join(details, ", ")
    return Err(if d != "" {
      "x509: no valid chains built: " + d
    } else {
      "x509: no valid chains built"
    })
  }
  Ok(kept)
}

// ───────── 证书策略（RFC 5280 6.1，verify.go 的 policyGraph）─────────
// 节点放在数组里，用下标代替指针；strata 每层是 (validPolicy.der, 节点) 的有序表，插入同键时覆盖（同 Go map）。

type PN = { valid: List<Int>, expected: List<List<Int>>, parents: List<Int>, children: List<Int> }

type PG = {
  nodes: List<PN>,
  strata: List<List<(List<Int>, Int)>>,
  pindex: List<(List<Int>, List<Int>)>,
  depth: Int,
}

const ANY_POLICY_DER: List<Int> = [85, 29, 32, 0]

fn pg_new() -> PG {
  PG {
    nodes: [PN { valid: ANY_POLICY_DER, expected: [ANY_POLICY_DER], parents: [], children: [] }],
    strata: [[(ANY_POLICY_DER, 0)]],
    pindex: [],
    depth: 0,
  }
}

fn set_node(pg: PG, i: Int, n: PN) -> PG {
  PG { nodes: pg.nodes[..i] + [n] + pg.nodes[i + 1..], ..pg }
}

fn add_id(xs: List<Int>, x: Int) -> List<Int> { if contains(xs, x) { xs } else { push(xs, x) } }

fn del_id(xs: List<Int>, x: Int) -> List<Int> { filter(xs, (y) => y != x) }

fn pg_new_node(pg0: PG, valid: List<Int>, parents: List<Int>) -> (PG, Int) {
  let id = len(pg0.nodes)
  var pg = PG {
    nodes: push(pg0.nodes, PN { valid: valid, expected: [valid], parents: [], children: [] }),
    ..pg0
  }
  for p in parents {
    let pn = pg.nodes[p]
    pg = set_node(pg, p, PN { children: add_id(pn.children, id), ..pn })
    let nn = pg.nodes[id]
    pg = set_node(pg, id, PN { parents: add_id(nn.parents, p), ..nn })
  }
  (pg, id)
}

fn stratum_set(s: List<(List<Int>, Int)>, k: List<Int>, v: Int) -> List<(List<Int>, Int)> {
  var out: List<(List<Int>, Int)> = []
  var done = false
  for e in s {
    if e.0 == k {
      out = push(out, (k, v))
      done = true
    } else {
      out = push(out, e)
    }
  }
  if done { out } else { push(out, (k, v)) }
}

fn stratum_get(s: List<(List<Int>, Int)>, k: List<Int>) -> Option<Int> {
  for e in s { if e.0 == k { return Some(e.1) } }
  None
}

fn pg_set_stratum(pg: PG, i: Int, s: List<(List<Int>, Int)>) -> PG {
  PG { strata: pg.strata[..i] + [s] + pg.strata[i + 1..], ..pg }
}

fn pg_insert(pg: PG, id: Int) -> PG {
  pg_set_stratum(pg, pg.depth, stratum_set(pg.strata[pg.depth], pg.nodes[id].valid, id))
}

fn pg_parents_with_expected(pg: PG, e: List<Int>) -> List<Int> {
  if pg.depth == 0 { return [] }
  for x in pg.pindex { if x.0 == e { return x.1 } }
  []
}

fn pg_parent_with_any(pg: PG) -> Option<Int> {
  if pg.depth == 0 { return None }
  stratum_get(pg.strata[pg.depth - 1], ANY_POLICY_DER)
}

fn pg_parents(pg: PG) -> List<Int> {
  if pg.depth == 0 { [] } else { map(pg.strata[pg.depth - 1], (e) => e.1) }
}

fn pg_delete_leaf(pg0: PG, policy: List<Int>) -> PG {
  let Some(n) = stratum_get(pg0.strata[pg0.depth], policy) else { return pg0 }
  var pg = pg0
  let node = pg.nodes[n]
  for p in node.parents {
    let pn = pg.nodes[p]
    pg = set_node(pg, p, PN { children: del_id(pn.children, n), ..pn })
  }
  for c in node.children {
    let cn = pg.nodes[c]
    pg = set_node(pg, c, PN { parents: del_id(cn.parents, n), ..cn })
  }
  pg_set_stratum(pg, pg.depth, filter(pg.strata[pg.depth], (e) => e.0 != policy))
}

fn pg_valid_policy_nodes(pg: PG) -> List<Int> {
  var out: List<Int> = []
  var i = pg.depth
  while i >= 0 {
    for e in pg.strata[i] {
      let n = pg.nodes[e.1]
      if n.valid == ANY_POLICY_DER { continue }
      if len(n.parents) == 1 && pg.nodes[n.parents[0]].valid == ANY_POLICY_DER {
        out = push(out, e.1)
      }
    }
    i -= 1
  }
  out
}

fn pg_prune(pg0: PG) -> PG {
  var pg = pg0
  var i = pg.depth - 1
  while i > 0 {
    for e in pg.strata[i] {
      let n = pg.nodes[e.1]
      if len(n.children) == 0 {
        for p in n.parents {
          let pn = pg.nodes[p]
          pg = set_node(pg, p, PN { children: del_id(pn.children, e.1), ..pn })
        }
        pg = pg_set_stratum(pg, i, filter(pg.strata[i], (x) => x.1 != e.1))
      }
    }
    i -= 1
  }
  pg
}

fn pg_incr_depth(pg: PG) -> PG {
  var idx: List<(List<Int>, List<Int>)> = []
  for e in pg.strata[pg.depth] {
    for x in pg.nodes[e.1].expected {
      if any(idx, (y) => y.0 == x) {
        idx = map(idx, (y) => if y.0 == x { (y.0, push(y.1, e.1)) } else { y })
      } else {
        idx = push(idx, (x, [e.1]))
      }
    }
  }
  PG { pindex: idx, depth: pg.depth + 1, strata: push(pg.strata, []), ..pg }
}

fn uniq(xs: List<List<Int>>) -> List<List<Int>> {
  var out: List<List<Int>> = []
  for x in xs { if !contains(out, x) { out = push(out, x) } }
  out
}

fn policies_valid(chain: List<Certificate>, opts: VerifyOptions) -> Bool {
  if len(chain) == 1 { return true }
  let n = len(chain) - 1
  var pgo: Option<PG> = Some(pg_new())
  var inhibit_any = if opts.inhibit_any_policy { 0 } else { n + 1 }
  var explicit = if opts.require_explicit_policy { 0 } else { n + 1 }
  var mapping = if opts.inhibit_policy_mapping { 0 } else { n + 1 }
  var user_set = uniq(map(opts.certificate_policies, (p) => p.der))
  if len(user_set) == 0 { user_set = [ANY_POLICY_DER] }
  var i = n - 1
  while i >= 0 {
    let cert = chain[i]
    let self_signed = cert.raw_issuer == cert.raw_subject
    if len(cert.policies) == 0 { pgo = None }
    if explicit == 0 && pgo == None { return false }
    if let Some(pg0) = pgo {
      var pg = pg_incr_depth(pg0)
      var policies: List<List<Int>> = []
      for pol in cert.policies {
        policies = push(policies, pol.der)
        if pol.der == ANY_POLICY_DER { continue }
        var parents = pg_parents_with_expected(pg, pol.der)
        if len(parents) == 0 { if let Some(a) = pg_parent_with_any(pg) { parents = [a] } }
        if len(parents) > 0 {
          let (pg2, id) = pg_new_node(pg, pol.der, parents)
          pg = pg_insert(pg2, id)
        }
      }
      if contains(policies, ANY_POLICY_DER) && (inhibit_any > 0 || (n - i < n && self_signed)) {
        var missing: List<(List<Int>, List<Int>)> = []
        let leaves = pg.strata[pg.depth]
        for p in pg_parents(pg) {
          for ex in pg.nodes[p].expected {
            if stratum_get(leaves, ex) == None {
              if any(missing, (m) => m.0 == ex) {
                missing = map(missing, (m) => if m.0 == ex { (m.0, push(m.1, p)) } else { m })
              } else {
                missing = push(missing, (ex, [p]))
              }
            }
          }
        }
        for m in missing {
          let (pg2, id) = pg_new_node(pg, m.0, m.1)
          pg = pg_insert(pg2, id)
        }
      }
      pg = pg_prune(pg)
      if i != 0 && len(cert.policy_mappings) > 0 {
        var mappings: List<(List<Int>, List<List<Int>>)> = []
        for mp in cert.policy_mappings {
          let iss = mp.issuer_domain_policy.der
          let sub = mp.subject_domain_policy.der
          if mapping > 0 {
            if iss == ANY_POLICY_DER || sub == ANY_POLICY_DER { return false }
            if any(mappings, (m) => m.0 == iss) {
              mappings = map(mappings, (m) => if m.0 == iss { (m.0, push(m.1, sub)) } else { m })
            } else {
              mappings = push(mappings, (iss, [sub]))
            }
          } else {
            pg = pg_delete_leaf(pg, iss)
          }
        }
        pg = pg_prune(pg)
        for m in mappings {
          if let Some(id) = stratum_get(pg.strata[pg.depth], m.0) {
            let nd = pg.nodes[id]
            pg = set_node(pg, id, PN { expected: m.1, ..nd })
          } else if let Some(a) = stratum_get(pg.strata[pg.depth], ANY_POLICY_DER) {
            let (pg2, id) = pg_new_node(pg, m.0, [a])
            let nd = pg2.nodes[id]
            pg = pg_insert(set_node(pg2, id, PN { expected: m.1, ..nd }), id)
          }
        }
      }
      pgo = Some(pg)
    }
    if i != 0 {
      if !self_signed {
        if explicit > 0 { explicit -= 1 }
        if mapping > 0 { mapping -= 1 }
        if inhibit_any > 0 { inhibit_any -= 1 }
      }
      if (cert.require_explicit_policy > 0 || cert.require_explicit_policy_zero)
        && cert.require_explicit_policy < explicit {
        explicit = cert.require_explicit_policy
      }
      if (cert.inhibit_policy_mapping > 0 || cert.inhibit_policy_mapping_zero)
        && cert.inhibit_policy_mapping < mapping {
        mapping = cert.inhibit_policy_mapping
      }
      if (cert.inhibit_any_policy > 0 || cert.inhibit_any_policy_zero)
        && cert.inhibit_any_policy < inhibit_any {
        inhibit_any = cert.inhibit_any_policy
      }
    }
    i -= 1
  }
  if explicit > 0 { explicit -= 1 }
  if chain[0].require_explicit_policy_zero { explicit = 0 }
  var valid_set: List<List<Int>> = []
  if let Some(pg) = pgo {
    valid_set = map(pg_valid_policy_nodes(pg), (id) => pg.nodes[id].valid)
    if let Some(a) = stratum_get(pg.strata[pg.depth], ANY_POLICY_DER) {
      valid_set = push(valid_set, pg.nodes[a].valid)
    }
  }
  let authority = uniq(valid_set)
  var user = authority
  if len(user_set) != 1 || user_set[0] != ANY_POLICY_DER {
    user = filter(user, (p) => contains(user_set, p))
    if contains(authority, ANY_POLICY_DER) { user = uniq(user + user_set) }
  }
  if explicit == 0 && len(user) == 0 { return false }
  true
}
