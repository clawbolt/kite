  [1, 3, 6, 1, 5, 5, 7, 3, 7],
  [1, 3, 6, 1, 5, 5, 7, 3, 8],
  [1, 3, 6, 1, 5, 5, 7, 3, 9],
  [1, 3, 6, 1, 4, 1, 311, 10, 3, 3],
