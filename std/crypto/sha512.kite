// std.crypto.sha512：SHA-512 家族（对齐 Go 的 crypto/sha512）
//   sum / sum384 / sum512_224 / sum512_256（参数是字符串，_bytes 版本参数是字节列表）：十六进制小写字符串
//   digest / digest384 / digest512_224 / digest512_256：字节列表（64 / 48 / 28 / 32 个）

use std.math.bits

pub const SIZE: Int = 64

pub const SIZE384: Int = 48

pub const SIZE224: Int = 28

pub const SIZE256: Int = 32

pub const BLOCK_SIZE: Int = 128

