}

pub fn digest512_256(msg: List<Int>) -> List<Int> {
  digest_iv(
    msg,
    [
      2463787394917988140,
      -6965556091613846334,
      2563595384472711505,
      -7622211418569250115,
      -7626776825740460061,
      -4729309413028513390,
      3098927326965381290,
      1060366662362279074,
    ],
    32,
  )
}

fn to_hex(bs: List<Int>) -> Str {
  let ds = chars("0123456789abcdef")
  var out = ""
  for b in bs { out = out + ds[(b >> 4) & 15] + ds[b & 15] }
  out
}

pub fn sum_bytes(bs: List<Int>) -> Str { to_hex(digest(bs)) }

pub fn sum(s: Str) -> Str { to_hex(digest(__bytes(s))) }

pub fn sum384_bytes(bs: List<Int>) -> Str { to_hex(digest384(bs)) }

pub fn sum384(s: Str) -> Str { to_hex(digest384(__bytes(s))) }

pub fn sum512_224_bytes(bs: List<Int>) -> Str { to_hex(digest512_224(bs)) }

pub fn sum512_224(s: Str) -> Str { to_hex(digest512_224(__bytes(s))) }

pub fn sum512_256_bytes(bs: List<Int>) -> Str { to_hex(digest512_256(bs)) }

pub fn sum512_256(s: Str) -> Str { to_hex(digest512_256(__bytes(s))) }
