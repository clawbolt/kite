fn rotr(x: Int, n: Int) -> Int { bits.shr(x, n) | (x << (64 - n)) }

fn digest_iv(msg: List<Int>, iv: List<Int>, n: Int) -> List<Int> {
  let kt = k_table()
  var h = iv
  let bitlen = len(msg) * 8
  var m = push(msg, 0x80)
  while len(m) % 128 != 112 { m = push(m, 0) }
  for _ in 0..8 { m = push(m, 0) }
  for k in 0..8 { m = push(m, (bitlen >> (56 - 8 * k)) & 255) }
  var off = 0
  while off < len(m) {
    var w: List<Int> = []
    for t in 0..16 {
      var x = 0
      for k in 0..8 { x = (x << 8) | m[off + t * 8 + k] }
      w = push(w, x)
    }
    for t in 16..80 {
      let x = w[t - 15]
      let y = w[t - 2]
      let s0 = rotr(x, 1) ^ rotr(x, 8) ^ bits.shr(x, 7)
      let s1 = rotr(y, 19) ^ rotr(y, 61) ^ bits.shr(y, 6)
      w = push(w, bits.wadd(bits.wadd(w[t - 16], s0), bits.wadd(w[t - 7], s1)))
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..80 {
      let s1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)
      let ch = (e & f) ^ ((~e) & g)
      let t1 = bits.wadd(bits.wadd(bits.wadd(hh, s1), bits.wadd(ch, kt[t])), w[t])
      let s0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)
      let mj = (a & b) ^ (a & c) ^ (b & c)
      let t2 = bits.wadd(s0, mj)
      hh = g
      g = f
      f = e
      e = bits.wadd(d, t1)
      d = c
      c = b
      b = a
      a = bits.wadd(t1, t2)
    }
    h = [
      bits.wadd(h[0], a),
      bits.wadd(h[1], b),
      bits.wadd(h[2], c),
      bits.wadd(h[3], d),
      bits.wadd(h[4], e),
      bits.wadd(h[5], f),
      bits.wadd(h[6], g),
      bits.wadd(h[7], hh),
    ]
    off += 128
  }
  var out: List<Int> = []
  for x in h {
    for k in 0..8 { out = push(out, bits.shr(x, 56 - 8 * k) & 255) }
  }
  take(out, n)
}

pub fn digest(msg: List<Int>) -> List<Int> {
  digest_iv(
    msg,
    [
      7640891576956012808,
      -4942790177534073029,
      4354685564936845355,
      -6534734903238641935,
      5840696475078001361,
      -7276294671716946913,
      2270897969802886507,
      6620516959819538809,
    ],
    64,
  )
}

