// std.log：日志（对齐 Go 的 log 包）。写到标准错误，每条一行
//   log.info / warn / error(msg)：带 UTC 时间戳和级别；log.fatal(msg) 记录后以退出码 1 结束程序
//   自定义：let l = log.new("[api] ", false)，再用 log.write(l, "INFO", msg)、log.linfo(l, msg) 等；
//   with_time 为 false 时不打印时间（输出稳定，适合测试）

use std.time

pub type Logger = { prefix: Str, with_time: Bool, min_level: Int }

pub fn new(prefix: Str, with_time: Bool) -> Logger {
  Logger { prefix: prefix, with_time: with_time, min_level: 0 }
}

fn level_of(name: Str) -> Int {
  if name == "DEBUG" {
    0
  } else if name == "INFO" {
    1
  } else if name == "WARN" {
    2
  } else if name == "ERROR" {
    3
  } else {
    4
  }
}

// 只记录 level（DEBUG / INFO / WARN / ERROR）及以上的日志
pub fn with_level(l: Logger, level: Str) -> Logger { Logger { min_level: level_of(level), ..l } }

fn stamp() -> Str {
  // 2026-10-10T05:00:00.123Z → 2026/10/10 05:00:00
  let t = time.format_utc(time.unix_ms())
  replace(__str_slice(t, 0, 10), "-", "/") + " " + __str_slice(t, 11, 19)
}

pub fn write(l: Logger, level: Str, msg: Str) {
  if level_of(level) < l.min_level { return }
  let ts = if l.with_time { stamp() + " " } else { "" }
  __eprint("{l.prefix}{ts}[{level}] {msg}")
}

pub fn ldebug(l: Logger, msg: Str) { write(l, "DEBUG", msg) }

pub fn linfo(l: Logger, msg: Str) { write(l, "INFO", msg) }

pub fn lwarn(l: Logger, msg: Str) { write(l, "WARN", msg) }

pub fn lerror(l: Logger, msg: Str) { write(l, "ERROR", msg) }

pub fn info(msg: Str) { write(new("", true), "INFO", msg) }

pub fn warn(msg: Str) { write(new("", true), "WARN", msg) }

pub fn error(msg: Str) { write(new("", true), "ERROR", msg) }

pub fn fatal(msg: Str) -> Never {
  write(new("", true), "FATAL", msg)
  __exit(1)
}

// 不带级别和时间，原样写到标准错误
pub fn eprint(msg: Str) { __eprint(msg) }
