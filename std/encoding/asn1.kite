// std.encoding.asn1：对齐 Go 1.27 的 encoding/asn1（DER）
//   Go 靠反射按目标类型解码；Kite 没有反射，所以用 Ty 描述目标类型（含结构体字段和 `asn1:"..."` 参数），
//   用 Val 承载值：
//     unmarshal(b, ty) / unmarshal_with_params(b, ty, params) -> Result<(Val, 剩余字节), Str>
//     marshal(v, ty) / marshal_with_params(v, ty, params) -> Result<List<Int>, Str>
//   错误文字与 Go 逐字节一致（"asn1: structure error: ..."、"asn1: syntax error: ..."、time.Parse 的错误）；
//   "tags don't match" 里 Go 会打印指针地址，这里统一写成 0xADDR
//   Kite 的字符串总是合法 UTF-8，所以 Go 里“字符串不是合法 UTF-8”的编码错误在这里不会出现

use std.math.big
use std.math.big.{ BigInt }
use std.unicode.utf8
use std.unicode.utf16
use std.strconv

pub const TAG_BOOLEAN: Int = 1
pub const TAG_INTEGER: Int = 2
pub const TAG_BIT_STRING: Int = 3
pub const TAG_OCTET_STRING: Int = 4
pub const TAG_NULL: Int = 5
pub const TAG_OID: Int = 6
pub const TAG_ENUM: Int = 10
pub const TAG_UTF8_STRING: Int = 12
pub const TAG_SEQUENCE: Int = 16
pub const TAG_SET: Int = 17
pub const TAG_NUMERIC_STRING: Int = 18
pub const TAG_PRINTABLE_STRING: Int = 19
pub const TAG_T61_STRING: Int = 20
pub const TAG_IA5_STRING: Int = 22
pub const TAG_UTC_TIME: Int = 23
pub const TAG_GENERALIZED_TIME: Int = 24
pub const TAG_GENERAL_STRING: Int = 27
pub const TAG_BMP_STRING: Int = 30

pub const CLASS_UNIVERSAL: Int = 0
pub const CLASS_APPLICATION: Int = 1
pub const CLASS_CONTEXT_SPECIFIC: Int = 2
pub const CLASS_PRIVATE: Int = 3

pub type BitString = { bytes: List<Int>, bit_length: Int }

pub type RawValue = { class: Int, tag: Int, is_compound: Bool, bytes: List<Int>, full_bytes: List<Int> }

// time.Time：unix 秒、纳秒、所在时区相对 UTC 的秒数
pub type Time = { unix: Int, nsec: Int, offset: Int }

// 目标类型。TInt 是 Go 的 int（64 位），TInt64 / TInt32 同名；TBig 是 *big.Int；TEnum 是 asn1.Enumerated；
//   TFlag 是 asn1.Flag；TBytes 是 []byte；TRawContent 是 asn1.RawContent（只能做结构体第一个字段）；
//   TAny 是 interface{}；TStruct(名字, 字段)；TSlice(名字, [元素类型])（名字以 SET 结尾时按 SET 处理）
pub enum Ty {
  TInt,
  TInt64,
  TInt32,
  TBig,
  TBool,
  TEnum,
  TFlag,
  TBits,
  TOid,
  TStr,
  TBytes,
  TTime,
  TRaw,
  TRawContent,
  TAny,
  TStruct(Str, List<Field>),
  TSlice(Str, List<Ty>),
}

pub type Field = { ty: Ty, params: Str }

// VBig(None) 是 nil 的 *big.Int；VNil 是 nil 的 interface{}
pub enum Val {
  VInt(Int),
  VBig(Option<BigInt>),
  VBool(Bool),
  VBits(BitString),
  VOid(List<Int>),
  VStr(Str),
  VBytes(List<Int>),
  VTime(Time),
  VRaw(RawValue),
  VList(List<Val>),
  VStruct(List<Val>),
  VNil,
}

pub fn field(ty: Ty, params: Str) -> Field { Field { ty: ty, params: params } }

fn structural(m: Str) -> Str { "asn1: structure error: " + m }

fn syntax(m: Str) -> Str { "asn1: syntax error: " + m }

pub const ZERO_UNIX: Int = -62135596800

pub fn zero_value(ty: Ty) -> Val {
  match ty {
    TInt => VInt(0),
    TInt64 => VInt(0),
    TInt32 => VInt(0),
    TEnum => VInt(0),
    TBig => VBig(None),
    TBool => VBool(false),
    TFlag => VBool(false),
    TBits => VBits(BitString { bytes: [], bit_length: 0 }),
    TOid => VOid([]),
    TStr => VStr(""),
    TBytes => VBytes([]),
    TRawContent => VBytes([]),
    TTime => VTime(Time { unix: ZERO_UNIX, nsec: 0, offset: 0 }),
    TRaw => VRaw(RawValue { class: 0, tag: 0, is_compound: false, bytes: [], full_bytes: [] }),
    TAny => VNil,
    TStruct(_, fs) => VStruct(map(fs, (f) => zero_value(f.ty))),
    TSlice(_, _) => VList([]),
  }
}

// ── 参数（parseFieldParameters） ──

pub type Params = { optional: Bool, explicit: Bool, application: Bool, private: Bool, default: Option<Int>, tag: Option<Int>, string_type: Int, time_type: Int, set: Bool, omit_empty: Bool }

pub fn parse_params(s: Str) -> Params {
  var p = Params { optional: false, explicit: false, application: false, private: false, default: None, tag: None, string_type: 0, time_type: 0, set: false, omit_empty: false }
  if s == "" { return p }
  for part in split(s, ",") {
    if part == "optional" {
      p = Params { optional: true, ..p }
    } else if part == "explicit" {
      p = Params { explicit: true, tag: if is_none(p.tag) { Some(0) } else { p.tag }, ..p }
    } else if part == "generalized" {
      p = Params { time_type: TAG_GENERALIZED_TIME, ..p }
    } else if part == "utc" {
      p = Params { time_type: TAG_UTC_TIME, ..p }
    } else if part == "ia5" {
      p = Params { string_type: TAG_IA5_STRING, ..p }
    } else if part == "printable" {
      p = Params { string_type: TAG_PRINTABLE_STRING, ..p }
    } else if part == "numeric" {
      p = Params { string_type: TAG_NUMERIC_STRING, ..p }
    } else if part == "utf8" {
      p = Params { string_type: TAG_UTF8_STRING, ..p }
    } else if starts_with(part, "default:") {
      if let Ok(v) = strconv.parse_int_base(__str_slice(part, 8, len(part)), 10) { p = Params { default: Some(v), ..p } }
    } else if starts_with(part, "tag:") {
      if let Ok(v) = strconv.parse_int_base(__str_slice(part, 4, len(part)), 10) { p = Params { tag: Some(v), ..p } }
    } else if part == "set" {
      p = Params { set: true, ..p }
    } else if part == "application" {
      p = Params { application: true, tag: if is_none(p.tag) { Some(0) } else { p.tag }, ..p }
    } else if part == "private" {
      p = Params { private: true, tag: if is_none(p.tag) { Some(0) } else { p.tag }, ..p }
    } else if part == "omitempty" {
      p = Params { omit_empty: true, ..p }
    }
  }
  p
}

fn ptr_s(o: Option<Int>) -> Str { if is_none(o) { "<nil>" } else { "0xADDR" } }

fn params_s(p: Params) -> Str {
  "\{optional:{p.optional} explicit:{p.explicit} application:{p.application} private:{p.private} defaultValue:{ptr_s(p.default)} tag:{ptr_s(p.tag)} stringType:{p.string_type} timeType:{p.time_type} set:{p.set} omitEmpty:{p.omit_empty}}"
}

// reflect.Type.Name()
fn type_name(ty: Ty) -> Str {
  match ty {
    TInt => "int",
    TInt64 => "int64",
    TInt32 => "int32",
    TEnum => "Enumerated",
    TBig => "",
    TBool => "bool",
    TFlag => "Flag",
    TBits => "BitString",
    TOid => "ObjectIdentifier",
    TStr => "string",
    TBytes => "",
    TRawContent => "RawContent",
    TTime => "Time",
    TRaw => "RawValue",
    TAny => "",
    TStruct(n, _) => n,
    TSlice(n, _) => n,
  }
}

// getUniversalType：(matchAny, tag, isCompound, ok)
fn universal_type(ty: Ty) -> (Bool, Int, Bool, Bool) {
  match ty {
    TRaw => (true, -1, false, true),
    TOid => (false, TAG_OID, false, true),
    TBits => (false, TAG_BIT_STRING, false, true),
    TTime => (false, TAG_UTC_TIME, false, true),
    TEnum => (false, TAG_ENUM, false, true),
    TBig => (false, TAG_INTEGER, false, true),
    TBool => (false, TAG_BOOLEAN, false, true),
    TFlag => (false, TAG_BOOLEAN, false, true),
    TInt => (false, TAG_INTEGER, false, true),
    TInt64 => (false, TAG_INTEGER, false, true),
    TInt32 => (false, TAG_INTEGER, false, true),
    TStruct(_, _) => (false, TAG_SEQUENCE, true, true),
    TBytes => (false, TAG_OCTET_STRING, false, true),
    TRawContent => (false, TAG_OCTET_STRING, false, true),
    TSlice(n, _) => if ends_with(n, "SET") { (false, TAG_SET, true, true) } else { (false, TAG_SEQUENCE, true, true) },
    TStr => (false, TAG_PRINTABLE_STRING, false, true),
    TAny => (false, 0, false, false),
  }
}

fn is_int_kind(ty: Ty) -> Bool {
  match ty {
    TInt => true,
    TInt64 => true,
    TInt32 => true,
    TEnum => true,
    _ => false,
  }
}

// ── 基本类型的解析 ──

pub fn parse_bool(b: List<Int>) -> Result<Bool, Str> {
  if len(b) != 1 { return Err(syntax("invalid boolean")) }
  if b[0] == 0 { return Ok(false) }
  if b[0] == 0xff { return Ok(true) }
  Err(syntax("invalid boolean"))
}

fn check_integer(b: List<Int>) -> Str {
  if len(b) == 0 { return structural("empty integer") }
  if len(b) == 1 { return "" }
  if (b[0] == 0 && (b[1] & 0x80) == 0) || (b[0] == 0xff && (b[1] & 0x80) == 0x80) { return structural("integer not minimally-encoded") }
  ""
}

pub fn parse_int64(b: List<Int>) -> Result<Int, Str> {
  let e = check_integer(b)
  if e != "" { return Err(e) }
  if len(b) > 8 { return Err(structural("integer too large")) }
  var v = if (b[0] & 0x80) != 0 { -1 } else { 0 }
  for x in b { v = (v << 8) | x }
  Ok(v)
}

pub fn parse_int32(b: List<Int>) -> Result<Int, Str> {
  let e = check_integer(b)
  if e != "" { return Err(e) }
  let v = parse_int64(b)?
  if v < -2147483648 || v > 2147483647 { return Err(structural("integer too large")) }
  Ok(v)
}

pub fn parse_big_int(b: List<Int>) -> Result<BigInt, Str> {
  let e = check_integer(b)
  if e != "" { return Err(e) }
  if (b[0] & 0x80) == 0x80 {
    let n = big.set_bytes(map(b, (x) => 255 - x))
    return Ok(n.add(big.one()).negate())
  }
  Ok(big.set_bytes(b))
}

pub fn parse_bit_string(b: List<Int>) -> Result<BitString, Str> {
  if len(b) == 0 { return Err(syntax("zero length BIT STRING")) }
  let pad = b[0]
  if pad > 7 || (len(b) == 1 && pad > 0) || (b[len(b) - 1] & ((1 << pad) - 1)) != 0 { return Err(syntax("invalid padding bits in BIT STRING")) }
  Ok(BitString { bytes: b[1..], bit_length: (len(b) - 1) * 8 - pad })
}

impl BitString {
  pub fn at(self, i: Int) -> Int {
    if i < 0 || i >= self.bit_length { return 0 }
    (self.bytes[i / 8] >> (7 - i % 8)) & 1
  }

  pub fn right_align(self) -> List<Int> {
    let shift = 8 - self.bit_length % 8
    if shift == 8 || len(self.bytes) == 0 { return self.bytes }
    var a = [self.bytes[0] >> shift]
    for i in 1..len(self.bytes) { a = push(a, ((self.bytes[i - 1] << (8 - shift)) & 255) | (self.bytes[i] >> shift)) }
    a
  }
}

pub fn oid_string(oid: List<Int>) -> Str { join(map(oid, (v) => "{v}"), ".") }

fn parse_base128(b: List<Int>, off0: Int) -> (Int, Int, Str) {
  var off = off0
  var r = 0
  var shifted = 0
  while off < len(b) {
    if shifted == 5 { return (0, off, structural("base 128 integer too large")) }
    r = r << 7
    let c = b[off]
    if shifted == 0 && c == 0x80 { return (0, off, syntax("integer is not minimally encoded")) }
    r = r | (c & 0x7f)
    off += 1
    if (c & 0x80) == 0 {
      if r > 2147483647 { return (r, off, structural("base 128 integer too large")) }
      return (r, off, "")
    }
    shifted += 1
  }
  (0, off, syntax("truncated base 128 integer"))
}

pub fn parse_oid(b: List<Int>) -> Result<List<Int>, Str> {
  if len(b) == 0 { return Err(syntax("zero length OBJECT IDENTIFIER")) }
  let (v, off0, e) = parse_base128(b, 0)
  if e != "" { return Err(e) }
  var s = if v < 80 { [v / 40, v % 40] } else { [2, v - 80] }
  var off = off0
  while off < len(b) {
    let (x, o2, e2) = parse_base128(b, off)
    if e2 != "" { return Err(e2) }
    s = push(s, x)
    off = o2
  }
  Ok(s)
}

fn is_numeric(c: Int) -> Bool { (c >= 48 && c <= 57) || c == 32 }

fn is_printable(c: Int, asterisk: Bool, ampersand: Bool) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || (c >= 39 && c <= 41) || (c >= 43 && c <= 47) || c == 32 || c == 58 || c == 61 || c == 63 || (asterisk && c == 42) || (ampersand && c == 38)
}

fn ascii(b: List<Int>) -> Str { unwrap(__from_bytes(b)) }

pub fn parse_numeric_string(b: List<Int>) -> Result<Str, Str> {
  for c in b { if !is_numeric(c) { return Err(syntax("NumericString contains invalid character")) } }
  Ok(ascii(b))
}

pub fn parse_printable_string(b: List<Int>) -> Result<Str, Str> {
  for c in b { if !is_printable(c, true, true) { return Err(syntax("PrintableString contains invalid character")) } }
  Ok(ascii(b))
}

pub fn parse_ia5_string(b: List<Int>) -> Result<Str, Str> {
  for c in b { if c >= 0x80 { return Err(syntax("IA5String contains invalid character")) } }
  Ok(ascii(b))
}

pub fn parse_t61_string(b: List<Int>) -> Result<Str, Str> {
  var out: List<Int> = []
  for c in b { out = out + utf8.encode_rune(c) }
  Ok(ascii(out))
}

pub fn parse_utf8_string(b: List<Int>) -> Result<Str, Str> {
  if !utf8.valid_bytes(b) { return Err("asn1: invalid UTF-8 string") }
  Ok(ascii(b))
}

pub fn parse_bmp_string(b0: List<Int>) -> Result<Str, Str> {
  var b = b0
  if len(b) % 2 != 0 { return Err("invalid BMPString") }
  let l = len(b)
  if l >= 2 && b[l - 1] == 0 && b[l - 2] == 0 { b = b[..l - 2] }
  var s: List<Int> = []
  var i = 0
  while i < len(b) {
    let p = (b[i] << 8) + b[i + 1]
    if p == 0xfffe || p == 0xffff || (p >= 0xfdd0 && p <= 0xfdef) || (p >= 0xd800 && p <= 0xdfff) { return Err("invalid BMPString") }
    s = push(s, p)
    i += 2
  }
  Ok(utf8.from_runes(utf16.decode(s)))
}

// ── time.Parse（只覆盖 asn1 用到的布局元素，错误文字与 Go 相同） ──

fn tquote(b: List<Int>) -> Str {
  let hexd = "0123456789abcdef"
  var out = "\""
  for c in b {
    if c >= 0x80 || c < 32 {
      out = out + "\\x" + __str_slice(hexd, c >> 4, (c >> 4) + 1) + __str_slice(hexd, c & 15, (c & 15) + 1)
    } else {
      if c == 34 || c == 92 { out = out + "\\" }
      out = out + ascii([c])
    }
  }
  out + "\""
}

fn is_dig(b: List<Int>, i: Int) -> Bool { i < len(b) && b[i] >= 48 && b[i] <= 57 }

// getnum：(值, 剩余, 是否出错)
fn getnum(b: List<Int>, fixed: Bool) -> (Int, List<Int>, Bool) {
  if !is_dig(b, 0) { return (0, b, true) }
  if !is_dig(b, 1) {
    if fixed { return (0, b, true) }
    return (b[0] - 48, b[1..], false)
  }
  ((b[0] - 48) * 10 + b[1] - 48, b[2..], false)
}

// atoi：允许一个正负号，后面全是数字
fn tatoi(b0: List<Int>) -> (Int, Bool) {
  var b = b0
  var neg = false
  if len(b) > 0 && (b[0] == 45 || b[0] == 43) {
    neg = b[0] == 45
    b = b[1..]
  }
  var x = 0
  var i = 0
  while i < len(b) && b[i] >= 48 && b[i] <= 57 {
    if x > 922337203685477580 { return (0, true) }
    x = x * 10 + b[i] - 48
    if x < 0 { return (0, true) }
    i += 1
  }
  if i < len(b) { return (0, true) }
  (if neg { -x } else { x }, false)
}

fn comma_or_period(c: Int) -> Bool { c == 46 || c == 44 }

fn parse_nanos(v: List<Int>, nb0: Int) -> (Int, Str, Bool) {
  var nb = nb0
  if !comma_or_period(v[0]) { return (0, "", true) }
  if nb > 10 { nb = 10 }
  let (ns0, bad) = tatoi(v[1..nb])
  if bad { return (0, "", true) }
  if ns0 < 0 { return (0, "fractional second", false) }
  var ns = ns0
  for _ in 0..(10 - nb) { ns = ns * 10 }
  (ns, "", false)
}

fn days_in(m: Int, y: Int) -> Int {
  if m == 2 { return if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { 29 } else { 28 } }
  if m == 4 || m == 6 || m == 9 || m == 11 { 30 } else { 31 }
}

fn days_from_civil(y0: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { y0 - 1 } else { y0 }
  let era = fdiv(y, 400)
  let yoe = y - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

fn fdiv(a: Int, b: Int) -> Int {
  let q = a / b
  if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// 本地时间各字段：(年, 月, 日, 时, 分, 秒)
pub fn civil(t: Time) -> (Int, Int, Int, Int, Int, Int) {
  let s = t.unix + t.offset
  let days = fdiv(s, 86400)
  let rem = s - days * 86400
  let z = days + 719468
  let era = fdiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  (y, m, d, rem / 3600, rem % 3600 / 60, rem % 60)
}

// time.Date（字段已在范围内）
pub fn make_time(y: Int, mo: Int, d: Int, h: Int, mi: Int, s: Int, nsec: Int, offset: Int) -> Time {
  Time { unix: days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + s - offset, nsec: nsec, offset: offset }
}

fn perr(layout: Str, value: List<Int>, lelem: Str, velem: List<Int>, msg: Str) -> Str {
  if msg == "" { return "parsing time " + tquote(value) + " as " + tquote(__bytes(layout)) + ": cannot parse " + tquote(velem) + " as " + tquote(__bytes(lelem)) }
  "parsing time " + tquote(value) + msg
}

// layout 已拆好的元素："06" "2006" "01" "02" "15" "04" "05" ".999999999" "Z0700"
fn parse_time(layout: Str, chunks: List<Str>, value: List<Int>) -> Result<Time, Str> {
  var v = value
  var year = 0
  var month = -1
  var day = -1
  var hour = 0
  var minute = 0
  var sec = 0
  var nsec = 0
  var utc = false
  var zone = -1
  var k = 0
  while k <= len(chunks) {
    if k == len(chunks) {
      if len(v) != 0 { return Err(perr(layout, value, "", v, ": extra text: " + tquote(v))) }
      break
    }
    let std = chunks[k]
    k += 1
    let hold = v
    var bad = false
    var rng = ""
    if std == "06" {
      if len(v) < 2 {
        bad = true
      } else {
        let (y, e) = tatoi(v[..2])
        v = v[2..]
        if e { bad = true } else { year = if y >= 69 { y + 1900 } else { y + 2000 } }
      }
    } else if std == "2006" {
      if len(v) < 4 || !is_dig(v, 0) {
        bad = true
      } else {
        let (y, e) = tatoi(v[..4])
        v = v[4..]
        year = y
        bad = e
      }
    } else if std == "01" {
      let (x, r, e) = getnum(v, true)
      month = x
      v = r
      bad = e
      if !e && (x <= 0 || x > 12) { rng = "month" }
    } else if std == "02" {
      let (x, r, e) = getnum(v, true)
      day = x
      v = r
      bad = e
    } else if std == "15" {
      let (x, r, e) = getnum(v, false)
      hour = x
      v = r
      bad = e
      if x < 0 || x >= 24 { rng = "hour" }
    } else if std == "04" {
      let (x, r, e) = getnum(v, true)
      minute = x
      v = r
      bad = e
      if x < 0 || x >= 60 { rng = "minute" }
    } else if std == "05" {
      let (x, r, e) = getnum(v, true)
      sec = x
      v = r
      bad = e
      if !e {
        if x < 0 || x >= 60 {
          rng = "second"
        } else if len(v) >= 2 && comma_or_period(v[0]) && is_dig(v, 1) {
          let next_frac = k < len(chunks) && chunks[k] == ".999999999"
          if !next_frac {
            var n = 2
            while n < len(v) && is_dig(v, n) { n += 1 }
            let (ns, r2, e2) = parse_nanos(v, n)
            nsec = ns
            rng = r2
            bad = e2
            v = v[n..]
          }
        }
      }
    } else if std == ".999999999" {
      if len(v) >= 2 && comma_or_period(v[0]) && v[1] >= 48 && v[1] <= 57 {
        var i = 0
        while i + 1 < len(v) && v[i + 1] >= 48 && v[i + 1] <= 57 { i += 1 }
        let (ns, r2, e2) = parse_nanos(v, 1 + i)
        nsec = ns
        rng = r2
        bad = e2
        v = v[1 + i..]
      }
    } else if std == "Z0700" {
      if len(v) >= 1 && v[0] == 90 {
        v = v[1..]
        utc = true
      } else if len(v) < 5 {
        bad = true
      } else {
        let sign = v[0]
        let (hr, _, e1) = getnum(v[1..3], true)
        var mm = 0
        var e = e1
        if !e1 {
          let (m2, _, e2) = getnum(v[3..5], true)
          mm = m2
          e = e2
        }
        v = v[5..]
        bad = e
        if hr > 24 { rng = "time zone offset hour" }
        if mm > 60 { rng = "time zone offset minute" }
        zone = (hr * 60 + mm) * 60
        if sign == 45 { zone = -zone } else if sign != 43 { bad = true }
      }
    }
    if rng != "" { return Err(perr(layout, value, std, v, ": " + rng + " out of range")) }
    if bad { return Err(perr(layout, value, std, hold, "")) }
  }
  if month < 0 { month = 1 }
  if day < 0 { day = 1 }
  if day < 1 || day > days_in(month, year) { return Err(perr(layout, value, "", v, ": day out of range")) }
  let off = if utc { 0 } else { zone }
  Ok(make_time(year, month, day, hour, minute, sec, nsec, off))
}

fn two(v: Int) -> Str { if v < 10 { "0{v}" } else { "{v}" } }

fn four(v: Int) -> Str {
  if v < 10 { "000{v}" } else if v < 100 { "00{v}" } else if v < 1000 { "0{v}" } else { "{v}" }
}

fn format_time(t: Time, chunks: List<Str>) -> Str {
  let (y, mo, d, h, mi, s) = civil(t)
  var out = ""
  for c in chunks {
    if c == "06" {
      out = out + two(((y % 100) + 100) % 100)
    } else if c == "2006" {
      out = out + four(y)
    } else if c == "01" {
      out = out + two(mo)
    } else if c == "02" {
      out = out + two(d)
    } else if c == "15" {
      out = out + two(h)
    } else if c == "04" {
      out = out + two(mi)
    } else if c == "05" {
      out = out + two(s)
    } else if c == ".999999999" {
      if t.nsec != 0 {
        var digits = "{t.nsec + 1000000000}"
        digits = __str_slice(digits, 1, len(digits))
        while ends_with(digits, "0") { digits = __str_slice(digits, 0, len(digits) - 1) }
        out = out + "." + digits
      }
    } else if c == "Z0700" {
      if t.offset == 0 {
        out = out + "Z"
      } else {
        var z = t.offset / 60
        if z < 0 {
          out = out + "-"
          z = -z
        } else {
          out = out + "+"
        }
        out = out + two(z / 60) + two(z % 60)
      }
    }
  }
  out
}

pub fn parse_utc_time(b: List<Int>) -> Result<Time, Str> {
  let l1 = ["06", "01", "02", "15", "04", "Z0700"]
  let l2 = ["06", "01", "02", "15", "04", "05", "Z0700"]
  var chunks = l1
  var r = parse_time("0601021504Z0700", l1, b)
  if is_err(r) {
    chunks = l2
    r = parse_time("060102150405Z0700", l2, b)
  }
  let t = r?
  let ser = format_time(t, chunks)
  if __bytes(ser) != b {
    return Err("asn1: time did not serialize back to the original value and may be invalid: given " + strconv.quote_go(ascii(b)) + ", but serialized as " + strconv.quote_go(ser))
  }
  let (y, mo, d, h, mi, s) = civil(t)
  if y >= 2050 { return Ok(make_time(y - 100, mo, d, h, mi, s, t.nsec, t.offset)) }
  Ok(t)
}

pub fn parse_generalized_time(b: List<Int>) -> Result<Time, Str> {
  let ch = ["2006", "01", "02", "15", "04", "05", ".999999999", "Z0700"]
  let t = parse_time("20060102150405.999999999Z0700", ch, b)?
  let ser = format_time(t, ch)
  if __bytes(ser) != b {
    return Err("asn1: time did not serialize back to the original value and may be invalid: given " + strconv.quote_go(ascii(b)) + ", but serialized as " + strconv.quote_go(ser))
  }
  Ok(t)
}

// ── 标签和长度 ──

pub type TagLen = { class: Int, tag: Int, length: Int, is_compound: Bool }

fn tl_s(t: TagLen) -> Str { "\{class:{t.class} tag:{t.tag} length:{t.length} isCompound:{t.is_compound}}" }

fn parse_tag_len(b: List<Int>, off0: Int) -> (TagLen, Int, Str) {
  var off = off0
  var t = TagLen { class: 0, tag: 0, length: 0, is_compound: false }
  if off >= len(b) { return (t, off, "asn1: internal error in parseTagAndLength") }
  var c = b[off]
  off += 1
  t = TagLen { class: c >> 6, tag: c & 0x1f, length: 0, is_compound: (c & 0x20) == 0x20 }
  if t.tag == 0x1f {
    let (tg, o2, e) = parse_base128(b, off)
    off = o2
    t = TagLen { tag: tg, ..t }
    if e != "" { return (t, off, e) }
    if tg < 0x1f { return (t, off, syntax("non-minimal tag")) }
  }
  if off >= len(b) { return (t, off, syntax("truncated tag or length")) }
  c = b[off]
  off += 1
  if (c & 0x80) == 0 {
    t = TagLen { length: c & 0x7f, ..t }
  } else {
    let n = c & 0x7f
    if n == 0 { return (t, off, syntax("indefinite length found (not DER)")) }
    var l = 0
    for _ in 0..n {
      if off >= len(b) { return (t, off, syntax("truncated tag or length")) }
      c = b[off]
      off += 1
      if l >= (1 << 23) { return (t, off, structural("length too large")) }
      l = (l << 8) | c
      if l == 0 { return (t, off, structural("superfluous leading zeros in length")) }
    }
    if l < 0x80 { return (t, off, structural("non-minimal length")) }
    t = TagLen { length: l, ..t }
  }
  (t, off, "")
}

fn invalid_length(off: Int, l: Int, n: Int) -> Bool { off + l < off || off + l > n }

// ── 解码（parseField） ──

fn set_default(ty: Ty, p: Params) -> (Bool, Val) {
  if !p.optional { return (false, zero_value(ty)) }
  if let Some(d) = p.default {
    if is_int_kind(ty) { return (true, VInt(d)) }
  }
  (true, zero_value(ty))
}

fn is_string_tag(t: Int) -> Bool {
  t == TAG_IA5_STRING || t == TAG_GENERAL_STRING || t == TAG_T61_STRING || t == TAG_UTF8_STRING || t == TAG_NUMERIC_STRING || t == TAG_BMP_STRING
}

fn res_val<T>(r: Result<T, Str>, f: fn(T) -> Val, cur: Val) -> (Val, Str) {
  match r {
    Ok(x) => (f(x), ""),
    Err(e) => (cur, e),
  }
}

// 返回 (新的偏移, 值, 错误)；出错时值无意义
fn parse_field(cur: Val, ty: Ty, b: List<Int>, init: Int, p: Params, depth0: Int) -> (Int, Val, Str) {
  let depth = depth0 + 1
  if depth > 10000 { return (init, cur, structural("nesting depth exceeded")) }
  var off = init
  if off == len(b) {
    let (ok, dv) = set_default(ty, p)
    if !ok { return (off, cur, syntax("sequence truncated")) }
    return (off, dv, "")
  }
  if ty == TAny {
    let (t, o2, e) = parse_tag_len(b, off)
    off = o2
    if e != "" { return (off, cur, e) }
    if invalid_length(off, t.length, len(b)) { return (off, cur, syntax("data truncated")) }
    var res = VNil
    var err = ""
    if !t.is_compound && t.class == CLASS_UNIVERSAL {
      let inner = b[off..off + t.length]
      let tg = t.tag
      let pr: (Val, Str) = if tg == TAG_BOOLEAN {
        res_val(parse_bool(inner), (x) => VBool(x), VNil)
      } else if tg == TAG_PRINTABLE_STRING {
        res_val(parse_printable_string(inner), (x) => VStr(x), VNil)
      } else if tg == TAG_NUMERIC_STRING {
        res_val(parse_numeric_string(inner), (x) => VStr(x), VNil)
      } else if tg == TAG_IA5_STRING {
        res_val(parse_ia5_string(inner), (x) => VStr(x), VNil)
      } else if tg == TAG_T61_STRING {
        res_val(parse_t61_string(inner), (x) => VStr(x), VNil)
      } else if tg == TAG_UTF8_STRING {
        res_val(parse_utf8_string(inner), (x) => VStr(x), VNil)
      } else if tg == TAG_INTEGER {
        res_val(parse_int64(inner), (x) => VInt(x), VNil)
      } else if tg == TAG_BIT_STRING {
        res_val(parse_bit_string(inner), (x) => VBits(x), VNil)
      } else if tg == TAG_OID {
        res_val(parse_oid(inner), (x) => VOid(x), VNil)
      } else if tg == TAG_UTC_TIME {
        res_val(parse_utc_time(inner), (x) => VTime(x), VNil)
      } else if tg == TAG_GENERALIZED_TIME {
        res_val(parse_generalized_time(inner), (x) => VTime(x), VNil)
      } else if tg == TAG_OCTET_STRING {
        (VBytes(inner), "")
      } else if tg == TAG_BMP_STRING {
        res_val(parse_bmp_string(inner), (x) => VStr(x), VNil)
      } else {
        (VNil, "")
      }
      res = pr.0
      err = pr.1
    }
    off += t.length
    if err != "" { return (off, cur, err) }
    if res != VNil { return (off, res, "") }
    return (off, cur, "")
  }
  let (t0, o3, e3) = parse_tag_len(b, off)
  off = o3
  if e3 != "" { return (off, cur, e3) }
  var t = t0
  if p.explicit {
    let ec = if p.application { CLASS_APPLICATION } else { CLASS_CONTEXT_SPECIFIC }
    if off == len(b) { return (off, cur, structural("explicit tag has no child")) }
    if t.class == ec && t.tag == unwrap(p.tag) && (t.length == 0 || t.is_compound) {
      if ty == TRaw {
      } else if t.length > 0 {
        let (t2, o4, e4) = parse_tag_len(b, off)
        off = o4
        t = t2
        if e4 != "" { return (off, cur, e4) }
      } else {
        if ty != TFlag { return (off, cur, structural("zero length explicit tag was not an asn1.Flag")) }
        return (off, VBool(true), "")
      }
    } else {
      let (ok, dv) = set_default(ty, p)
      if ok { return (init, dv, "") }
      return (off, cur, structural("explicitly tagged member didn't match"))
    }
  }
  let (match_any, ut0, compound, ok1) = universal_type(ty)
  if !ok1 { return (off, cur, structural("unknown Go type: " + type_name(ty))) }
  var ut = ut0
  if ut == TAG_PRINTABLE_STRING {
    if t.class == CLASS_UNIVERSAL {
      if is_string_tag(t.tag) { ut = t.tag }
    } else if p.string_type != 0 {
      ut = p.string_type
    }
  }
  if ut == TAG_UTC_TIME {
    if t.class == CLASS_UNIVERSAL {
      if t.tag == TAG_GENERALIZED_TIME { ut = t.tag }
    } else if p.time_type != 0 {
      ut = p.time_type
    }
  }
  if p.set { ut = TAG_SET }
  var mact = match_any
  var ecls = CLASS_UNIVERSAL
  var etag = ut
  if !p.explicit && is_some(p.tag) {
    ecls = CLASS_CONTEXT_SPECIFIC
    etag = unwrap(p.tag)
    mact = false
  }
  if !p.explicit && p.application && is_some(p.tag) {
    ecls = CLASS_APPLICATION
    etag = unwrap(p.tag)
    mact = false
  }
  if !p.explicit && p.private && is_some(p.tag) {
    ecls = CLASS_PRIVATE
    etag = unwrap(p.tag)
    mact = false
  }
  if (!mact && (t.class != ecls || t.tag != etag)) || (!match_any && t.is_compound != compound) {
    let (ok, dv) = set_default(ty, p)
    if ok { return (init, dv, "") }
    return (off, cur, structural("tags don't match ({etag} vs {tl_s(t)}) {params_s(p)} {type_name(ty)} @{off}"))
  }
  if invalid_length(off, t.length, len(b)) { return (off, cur, syntax("data truncated")) }
  let inner = b[off..off + t.length]
  off += t.length
  match ty {
    TRaw => { return (off, VRaw(RawValue { class: t.class, tag: t.tag, is_compound: t.is_compound, bytes: inner, full_bytes: b[init..off] }), "") },
    TOid => {
      let (v, e) = res_val(parse_oid(inner), (x) => VOid(x), cur)
      return (off, v, e)
    },
    TBits => {
      let (v, e) = res_val(parse_bit_string(inner), (x) => VBits(x), cur)
      return (off, v, e)
    },
    TTime => {
      let r = if ut == TAG_UTC_TIME { parse_utc_time(inner) } else { parse_generalized_time(inner) }
      let (v, e) = res_val(r, (x) => VTime(x), cur)
      return (off, v, e)
    },
    TEnum => {
      let (v, e) = res_val(parse_int32(inner), (x) => VInt(x), cur)
      return (off, v, e)
    },
    TFlag => { return (off, VBool(true), "") },
    TBig => {
      let (v, e) = res_val(parse_big_int(inner), (x) => VBig(Some(x)), cur)
      return (off, v, e)
    },
    TBool => {
      let (v, e) = res_val(parse_bool(inner), (x) => VBool(x), cur)
      return (off, v, e)
    },
    TInt32 => {
      let (v, e) = res_val(parse_int32(inner), (x) => VInt(x), cur)
      return (off, v, e)
    },
    TInt => {
      let (v, e) = res_val(parse_int64(inner), (x) => VInt(x), cur)
      return (off, v, e)
    },
    TInt64 => {
      let (v, e) = res_val(parse_int64(inner), (x) => VInt(x), cur)
      return (off, v, e)
    },
    TStruct(_, fs) => {
      var vals = match cur {
        VStruct(xs) => xs,
        _ => map(fs, (f) => zero_value(f.ty)),
      }
      var start = 0
      if len(fs) > 0 && fs[0].ty == TRawContent {
        vals = set(vals, 0, VBytes(b[init..off]))
        start = 1
      }
      var io = 0
      for i in start..len(fs) {
        let (o5, v5, e5) = parse_field(vals[i], fs[i].ty, inner, io, parse_params(fs[i].params), depth)
        io = o5
        if e5 != "" { return (off, VStruct(vals), e5) }
        vals = set(vals, i, v5)
      }
      return (off, VStruct(vals), "")
    },
    TBytes => { return (off, VBytes(inner), "") },
    TRawContent => { return (off, VBytes(inner), "") },
    TSlice(_, el) => {
      let (v, e) = parse_sequence_of(inner, el[0], depth)
      if e != "" { return (off, cur, e) }
      return (off, v, "")
    },
    TStr => {
      var r: Result<Str, Str> = Err("")
      if ut == TAG_PRINTABLE_STRING {
        r = parse_printable_string(inner)
      } else if ut == TAG_NUMERIC_STRING {
        r = parse_numeric_string(inner)
      } else if ut == TAG_IA5_STRING {
        r = parse_ia5_string(inner)
      } else if ut == TAG_T61_STRING || ut == TAG_GENERAL_STRING {
        r = parse_t61_string(inner)
      } else if ut == TAG_UTF8_STRING {
        r = parse_utf8_string(inner)
      } else if ut == TAG_BMP_STRING {
        r = parse_bmp_string(inner)
      } else {
        r = Err(syntax("internal error: unknown string type {ut}"))
      }
      let (v, e) = res_val(r, (x) => VStr(x), cur)
      return (off, v, e)
    },
    _ => { return (off, cur, structural("unsupported: " + type_name(ty))) },
  }
}

fn parse_sequence_of(b: List<Int>, el: Ty, depth: Int) -> (Val, Str) {
  let (match_any, etag, compound, ok) = universal_type(el)
  if !ok { return (VNil, structural("unknown Go type for slice")) }
  var n = 0
  var off = 0
  while off < len(b) {
    let (t0, o2, e) = parse_tag_len(b, off)
    off = o2
    if e != "" { return (VNil, e) }
    var tg = t0.tag
    if is_string_tag(tg) { tg = TAG_PRINTABLE_STRING }
    if tg == TAG_GENERALIZED_TIME || tg == TAG_UTC_TIME { tg = TAG_UTC_TIME }
    if !match_any && (t0.class != CLASS_UNIVERSAL || t0.is_compound != compound || tg != etag) { return (VNil, structural("sequence tag mismatch")) }
    if invalid_length(off, t0.length, len(b)) { return (VNil, syntax("truncated sequence")) }
    off += t0.length
    n += 1
  }
  let p = parse_params("")
  var out: List<Val> = []
  off = 0
  for _ in 0..n {
    let (o3, v, e) = parse_field(zero_value(el), el, b, off, p, depth)
    off = o3
    if e != "" { return (VNil, e) }
    out = push(out, v)
  }
  (VList(out), "")
}

pub fn unmarshal_with_params(b: List<Int>, ty: Ty, params: Str) -> Result<(Val, List<Int>), Str> {
  let (off, v, e) = parse_field(zero_value(ty), ty, b, 0, parse_params(params), 0)
  if e != "" { return Err(e) }
  Ok((v, b[off..]))
}

pub fn unmarshal(b: List<Int>, ty: Ty) -> Result<(Val, List<Int>), Str> { unmarshal_with_params(b, ty, "") }

// ── 编码（makeField / makeBody） ──

fn int_bytes(i: Int) -> List<Int> {
  var n = 1
  var x = i
  while x > 127 {
    n += 1
    x = x >> 8
  }
  while x < -128 {
    n += 1
    x = x >> 8
  }
  var out: List<Int> = []
  for j in 0..n { out = push(out, (i >> ((n - 1 - j) * 8)) & 255) }
  out
}

fn base128_len(n: Int) -> Int {
  if n == 0 { return 1 }
  var l = 0
  var i = n
  while i > 0 {
    l += 1
    i = i >> 7
  }
  l
}

fn append_base128(dst: List<Int>, n: Int) -> List<Int> {
  var out = dst
  let l = base128_len(n)
  var i = l - 1
  while i >= 0 {
    var o = (n >> (i * 7)) & 0x7f
    if i != 0 { o = o | 0x80 }
    out = push(out, o)
    i -= 1
  }
  out
}

fn append_length(dst: List<Int>, i: Int) -> List<Int> {
  var n = length_length(i)
  var out = dst
  while n > 0 {
    out = push(out, (i >> ((n - 1) * 8)) & 255)
    n -= 1
  }
  out
}

fn length_length(i0: Int) -> Int {
  var n = 1
  var i = i0
  while i > 255 {
    n += 1
    i = i >> 8
  }
  n
}

fn tag_and_length(class: Int, tag: Int, length: Int, compound: Bool) -> List<Int> {
  var b = class << 6
  if compound { b = b | 0x20 }
  var out: List<Int> = []
  if tag >= 31 {
    out = append_base128([b | 0x1f], tag)
  } else {
    out = [b | tag]
  }
  if length >= 128 {
    out = push(out, 0x80 | length_length(length))
    out = append_length(out, length)
  } else {
    out = push(out, length)
  }
  out
}

fn big_body(n: Option<BigInt>) -> Result<List<Int>, Str> {
  let Some(x) = n else { return Err(structural("empty integer")) }
  if x.sign() < 0 {
    let m1 = x.negate().sub(big.one())
    let bs = map(m1.bytes(), (c) => c ^ 0xff)
    if len(bs) == 0 || (bs[0] & 0x80) == 0 { return Ok([0xff] + bs) }
    return Ok(bs)
  }
  if x.sign() == 0 { return Ok([0]) }
  let bs = x.bytes()
  if len(bs) > 0 && (bs[0] & 0x80) != 0 { return Ok([0] + bs) }
  Ok(bs)
}

fn oid_body(oid: List<Int>) -> Result<List<Int>, Str> {
  if len(oid) < 2 || oid[0] > 2 || (oid[0] < 2 && oid[1] >= 40) { return Err(structural("invalid object identifier")) }
  var out = append_base128([], oid[0] * 40 + oid[1])
  for i in 2..len(oid) { out = append_base128(out, oid[i]) }
  Ok(out)
}

fn year_of(t: Time) -> Int {
  let (y, _, _, _, _, _) = civil(t)
  y
}

fn outside_utc(t: Time) -> Bool {
  let y = year_of(t)
  y < 1950 || y >= 2050
}

fn time_common(t: Time) -> Str {
  let (_, mo, d, h, mi, s) = civil(t)
  var out = two(mo) + two(d) + two(h) + two(mi) + two(s)
  let off = t.offset
  if off / 60 == 0 { return out + "Z" }
  out = out + (if off > 0 { "+" } else { "-" })
  var m = off / 60
  if m < 0 { m = -m }
  out + two(m / 60) + two(m % 60)
}

fn utc_time_body(t: Time) -> Result<List<Int>, Str> {
  let y = year_of(t)
  if y >= 1950 && y < 2000 { return Ok(__bytes(two(y - 1900) + time_common(t))) }
  if y >= 2000 && y < 2050 { return Ok(__bytes(two(y - 2000) + time_common(t))) }
  Err(structural("cannot represent time as UTCTime"))
}

fn generalized_time_body(t: Time) -> Result<List<Int>, Str> {
  let y = year_of(t)
  if y < 0 || y > 9999 { return Err(structural("cannot represent time as GeneralizedTime")) }
  Ok(__bytes(four(y) + time_common(t)))
}

fn sort_bytes(xs: List<List<Int>>) -> List<List<Int>> { sort_with(xs, (a, b) => compare_bytes(a, b)) }

fn compare_bytes(a: List<Int>, b: List<Int>) -> Int {
  let n = if len(a) < len(b) { len(a) } else { len(b) }
  for i in 0..n {
    if a[i] != b[i] { return if a[i] < b[i] { -1 } else { 1 } }
  }
  if len(a) < len(b) { -1 } else if len(a) > len(b) { 1 } else { 0 }
}

fn strip_tag_len(b: List<Int>) -> List<Int> {
  let (_, off, e) = parse_tag_len(b, 0)
  if e != "" { b } else { b[off..] }
}

fn make_body(v: Val, ty: Ty, p: Params) -> Result<List<Int>, Str> {
  match ty {
    TFlag => { return Ok([]) },
    TTime => {
      let VTime(t) = v else { return Err(structural("unknown Go type")) }
      if p.time_type == TAG_GENERALIZED_TIME || outside_utc(t) { return generalized_time_body(t) }
      return utc_time_body(t)
    },
    TBits => {
      let VBits(bs) = v else { return Err(structural("unknown Go type")) }
      return Ok([(8 - bs.bit_length % 8) % 8] + bs.bytes)
    },
    TOid => {
      let VOid(o) = v else { return Err(structural("unknown Go type")) }
      return oid_body(o)
    },
    TBig => {
      let VBig(n) = v else { return Err(structural("unknown Go type")) }
      return big_body(n)
    },
    TBool => {
      let VBool(x) = v else { return Err(structural("unknown Go type")) }
      return Ok([if x { 0xff } else { 0 }])
    },
    TStruct(_, fs) => {
      let VStruct(vals) = v else { return Err(structural("unknown Go type")) }
      let n = len(fs)
      if n == 0 { return Ok([]) }
      var start = 0
      if fs[0].ty == TRawContent {
        let VBytes(rc) = vals[0] else { return Err(structural("unknown Go type")) }
        if len(rc) > 0 { return Ok(strip_tag_len(rc)) }
        start = 1
      }
      var out: List<Int> = []
      for i in start..n { out = out + make_field(vals[i], fs[i].ty, parse_params(fs[i].params))? }
      return Ok(out)
    },
    TBytes => {
      let VBytes(bs) = v else { return Err(structural("unknown Go type")) }
      return Ok(bs)
    },
    TRawContent => {
      let VBytes(bs) = v else { return Err(structural("unknown Go type")) }
      return Ok(bs)
    },
    TSlice(_, el) => {
      let VList(items) = v else { return Err(structural("unknown Go type")) }
      let fp = parse_params("")
      if len(items) == 0 { return Ok([]) }
      if len(items) == 1 { return make_field(items[0], el[0], fp) }
      var parts: List<List<Int>> = []
      for it in items { parts = push(parts, make_field(it, el[0], fp)?) }
      if p.set { parts = sort_bytes(parts) }
      return Ok(fold(parts, [], (acc, x) => acc + x))
    },
    TStr => {
      let VStr(s) = v else { return Err(structural("unknown Go type")) }
      let b = __bytes(s)
      if p.string_type == TAG_IA5_STRING {
        for c in b { if c > 127 { return Err(structural("IA5String contains invalid character")) } }
      } else if p.string_type == TAG_PRINTABLE_STRING {
        for c in b { if !is_printable(c, true, false) { return Err(structural("PrintableString contains invalid character")) } }
      } else if p.string_type == TAG_NUMERIC_STRING {
        for c in b { if !is_numeric(c) { return Err(structural("NumericString contains invalid character")) } }
      }
      return Ok(b)
    },
    _ => {},
  }
  if is_int_kind(ty) {
    let VInt(i) = v else { return Err(structural("unknown Go type")) }
    return Ok(int_bytes(i))
  }
  Err(structural("unknown Go type"))
}

fn is_empty_slice(v: Val) -> Bool {
  match v {
    VBytes(b) => len(b) == 0,
    VList(xs) => len(xs) == 0,
    _ => false,
  }
}

// interface{} 里的值对应的 Go 类型
fn type_of(v: Val) -> Ty {
  match v {
    VInt(_) => TInt64,
    VBig(_) => TBig,
    VBool(_) => TBool,
    VBits(_) => TBits,
    VOid(_) => TOid,
    VStr(_) => TStr,
    VBytes(_) => TBytes,
    VTime(_) => TTime,
    VRaw(_) => TRaw,
    _ => TAny,
  }
}

fn make_field(v: Val, ty0: Ty, p0: Params) -> Result<List<Int>, Str> {
  var ty = ty0
  var p = p0
  if ty == TAny {
    if v == VNil { return Err("asn1: cannot marshal nil value") }
    ty = type_of(v)
  }
  let is_slice = match ty {
    TBytes => true,
    TRawContent => true,
    TSlice(_, _) => true,
    _ => false,
  }
  if is_slice && is_empty_slice(v) && p.omit_empty { return Ok([]) }
  if p.optional && is_some(p.default) && is_int_kind(ty) {
    if v == VInt(unwrap(p.default)) { return Ok([]) }
  }
  if p.optional && is_none(p.default) {
    if v == zero_value(ty) { return Ok([]) }
  }
  if ty == TRaw {
    let VRaw(rv) = v else { return Err(structural("unknown Go type")) }
    if len(rv.full_bytes) != 0 { return Ok(rv.full_bytes) }
    return Ok(tag_and_length(rv.class, rv.tag, len(rv.bytes), rv.is_compound) + rv.bytes)
  }
  let (match_any, tag0, compound, ok) = universal_type(ty)
  if !ok || match_any { return Err(structural("unknown Go type: " + type_name(ty))) }
  var tag = tag0
  if p.time_type != 0 && tag != TAG_UTC_TIME { return Err(structural("explicit time type given to non-time member")) }
  if p.string_type != 0 && tag != TAG_PRINTABLE_STRING { return Err(structural("explicit string type given to non-string member")) }
  if tag == TAG_PRINTABLE_STRING {
    if p.string_type == 0 {
      let VStr(s) = v else { return Err(structural("unknown Go type")) }
      for c in __bytes(s) {
        if c >= 0x80 || !is_printable(c, false, false) {
          tag = TAG_UTF8_STRING
          break
        }
      }
    } else {
      tag = p.string_type
    }
  } else if tag == TAG_UTC_TIME {
    let VTime(t) = v else { return Err(structural("unknown Go type")) }
    if p.time_type == TAG_GENERALIZED_TIME || outside_utc(t) { tag = TAG_GENERALIZED_TIME }
  }
  if p.set {
    if tag != TAG_SEQUENCE { return Err(structural("non sequence tagged as set")) }
    tag = TAG_SET
  }
  if tag == TAG_SET && !p.set { p = Params { set: true, ..p } }
  let body = make_body(v, ty, p)?
  var class = CLASS_UNIVERSAL
  if let Some(pt) = p.tag {
    class = if p.application { CLASS_APPLICATION } else if p.private { CLASS_PRIVATE } else { CLASS_CONTEXT_SPECIFIC }
    if p.explicit {
      let inner = tag_and_length(CLASS_UNIVERSAL, tag, len(body), compound) + body
      return Ok(tag_and_length(class, pt, len(inner), true) + inner)
    }
    tag = pt
  }
  Ok(tag_and_length(class, tag, len(body), compound) + body)
}

pub fn marshal_with_params(v: Val, ty: Ty, params: Str) -> Result<List<Int>, Str> { make_field(v, ty, parse_params(params)) }

pub fn marshal(v: Val, ty: Ty) -> Result<List<Int>, Str> { marshal_with_params(v, ty, "") }
