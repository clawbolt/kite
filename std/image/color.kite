fn raw_palette(raw: List<Int>) -> List<Color> {
  map(0..len(raw) / 4, (i) => RGBA(raw[4 * i], raw[4 * i + 1], raw[4 * i + 2], raw[4 * i + 3]))
}

pub fn plan9() -> List<Color> { raw_palette(PLAN9_RAW) }

pub fn web_safe() -> List<Color> { raw_palette(WEBSAFE_RAW) }
