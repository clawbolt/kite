// std.image.color：对齐 Go 1.27 的 image/color 和 image/color/palette
//   Color 是带载荷的枚举，对应 Go 的 11 种颜色类型；rgba(c) 等同 c.RGBA()（16 位预乘分量）。
//   颜色模型用整数常量表示，convert(model, c) 等同 Model.Convert；调色板是 List<Color>，palette_convert / palette_index。
//   rgb_to_ycbcr、ycbcr_to_rgb、rgb_to_cmyk、cmyk_to_rgb；plan9() / web_safe() 是 image/color/palette 的两个调色板

pub enum Color {
  RGBA(Int, Int, Int, Int),
  RGBA64(Int, Int, Int, Int),
  NRGBA(Int, Int, Int, Int),
  NRGBA64(Int, Int, Int, Int),
  Alpha(Int),
  Alpha16(Int),
  Gray(Int),
  Gray16(Int),
  YCbCr(Int, Int, Int),
  NYCbCrA(Int, Int, Int, Int),
  CMYK(Int, Int, Int, Int),
}

pub const RGBA_MODEL: Int = 0
pub const RGBA64_MODEL: Int = 1
pub const NRGBA_MODEL: Int = 2
pub const NRGBA64_MODEL: Int = 3
pub const ALPHA_MODEL: Int = 4
pub const ALPHA16_MODEL: Int = 5
pub const GRAY_MODEL: Int = 6
pub const GRAY16_MODEL: Int = 7
pub const YCBCR_MODEL: Int = 8
pub const NYCBCRA_MODEL: Int = 9
pub const CMYK_MODEL: Int = 10

pub fn black() -> Color { Gray16(0) }
pub fn white() -> Color { Gray16(0xffff) }
pub fn transparent() -> Color { Alpha16(0) }
pub fn opaque() -> Color { Alpha16(0xffff) }

// 颜色属于哪个模型
pub fn model_of(c: Color) -> Int {
  match c {
    RGBA(_, _, _, _) => 0,
    RGBA64(_, _, _, _) => 1,
    NRGBA(_, _, _, _) => 2,
    NRGBA64(_, _, _, _) => 3,
    Alpha(_) => 4,
    Alpha16(_) => 5,
    Gray(_) => 6,
    Gray16(_) => 7,
    YCbCr(_, _, _) => 8,
    NYCbCrA(_, _, _, _) => 9,
    CMYK(_, _, _, _) => 10,
  }
}

fn clamp8(x: Int) -> Int { if x < 0 { 0 } else if x >= 1 << 24 { 255 } else { x >> 16 } }
fn clamp16(x: Int) -> Int { if x < 0 { 0 } else if x >= 1 << 24 { 0xffff } else { x >> 8 } }

fn ycc_rgba16(y: Int, cb: Int, cr: Int) -> (Int, Int, Int) {
  let yy = y * 0x10101
  let cb1 = cb - 128
  let cr1 = cr - 128
  (clamp16(yy + 91881 * cr1), clamp16(yy - 22554 * cb1 - 46802 * cr1), clamp16(yy + 116130 * cb1))
}

pub fn rgba(c: Color) -> (Int, Int, Int, Int) {
  match c {
    RGBA(r, g, b, a) => (r * 0x101, g * 0x101, b * 0x101, a * 0x101),
    RGBA64(r, g, b, a) => (r, g, b, a),
    NRGBA(r, g, b, a) => (
      r * 0x101 * a / 0xff,
      g * 0x101 * a / 0xff,
      b * 0x101 * a / 0xff,
      a * 0x101,
    ),
    NRGBA64(r, g, b, a) => (r * a / 0xffff, g * a / 0xffff, b * a / 0xffff, a),
    Alpha(a) => (a * 0x101, a * 0x101, a * 0x101, a * 0x101),
    Alpha16(a) => (a, a, a, a),
    Gray(y) => (y * 0x101, y * 0x101, y * 0x101, 0xffff),
    Gray16(y) => (y, y, y, 0xffff),
    YCbCr(y, cb, cr) => {
      let (r, g, b) = ycc_rgba16(y, cb, cr)
      (r, g, b, 0xffff)
    },
    NYCbCrA(y, cb, cr, a0) => {
      let (r, g, b) = ycc_rgba16(y, cb, cr)
      let a = a0 * 0x101
      (r * a / 0xffff, g * a / 0xffff, b * a / 0xffff, a)
    },
    CMYK(cc, m, y, k) => {
      let w = 0xffff - k * 0x101
      (
        (0xffff - cc * 0x101) * w / 0xffff,
        (0xffff - m * 0x101) * w / 0xffff,
        (0xffff - y * 0x101) * w / 0xffff,
        0xffff,
      )
    },
  }
}

pub fn rgb_to_ycbcr(r: Int, g: Int, b: Int) -> (Int, Int, Int) {
  let yy = (19595 * r + 38470 * g + 7471 * b + (1 << 15)) >> 16
  let cb = -11056 * r - 21712 * g + 32768 * b + (257 << 15)
  let cr = 32768 * r - 27440 * g - 5328 * b + (257 << 15)
  (yy & 255, clamp8(cb), clamp8(cr))
}

pub fn ycbcr_to_rgb(y: Int, cb: Int, cr: Int) -> (Int, Int, Int) {
  let yy = y * 0x10101
  let cb1 = cb - 128
  let cr1 = cr - 128
  (clamp8(yy + 91881 * cr1), clamp8(yy - 22554 * cb1 - 46802 * cr1), clamp8(yy + 116130 * cb1))
}

pub fn rgb_to_cmyk(r: Int, g: Int, b: Int) -> (Int, Int, Int, Int) {
  var w = r
  if w < g { w = g }
  if w < b { w = b }
  if w == 0 { return (0, 0, 0, 0xff) }
  ((w - r) * 0xff / w, (w - g) * 0xff / w, (w - b) * 0xff / w, 0xff - w)
}

pub fn cmyk_to_rgb(c: Int, m: Int, y: Int, k: Int) -> (Int, Int, Int) {
  let w = 0xffff - k * 0x101
  (
    ((0xffff - c * 0x101) * w / 0xffff) >> 8,
    ((0xffff - m * 0x101) * w / 0xffff) >> 8,
    ((0xffff - y * 0x101) * w / 0xffff) >> 8,
  )
}

pub fn convert(model: Int, c: Color) -> Color {
  if model_of(c) == model { return c }
  let (r, g, b, a) = rgba(c)
  if model == RGBA_MODEL { return RGBA(r >> 8, g >> 8, b >> 8, a >> 8) }
  if model == RGBA64_MODEL { return RGBA64(r, g, b, a) }
  if model == NRGBA_MODEL || model == NRGBA64_MODEL {
    let big = model == NRGBA64_MODEL
    if a == 0xffff {
      return if big { NRGBA64(r, g, b, 0xffff) } else { NRGBA(r >> 8, g >> 8, b >> 8, 0xff) }
    }
    if a == 0 { return if big { NRGBA64(0, 0, 0, 0) } else { NRGBA(0, 0, 0, 0) } }
    let r2 = ((r * 0xffff) & 0xffffffff) / a
    let g2 = ((g * 0xffff) & 0xffffffff) / a
    let b2 = ((b * 0xffff) & 0xffffffff) / a
    return if big {
      NRGBA64(r2 & 0xffff, g2 & 0xffff, b2 & 0xffff, a)
    } else {
      NRGBA((r2 >> 8) & 255, (g2 >> 8) & 255, (b2 >> 8) & 255, a >> 8)
    }
  }
  if model == ALPHA_MODEL { return Alpha(a >> 8) }
  if model == ALPHA16_MODEL { return Alpha16(a) }
  if model == GRAY_MODEL { return Gray((19595 * r + 38470 * g + 7471 * b + (1 << 15)) >> 24) }
  if model == GRAY16_MODEL {
    return Gray16(((19595 * r + 38470 * g + 7471 * b + (1 << 15)) >> 16) & 0xffff)
  }
  if model == YCBCR_MODEL {
    let (y, u, v) = rgb_to_ycbcr(r >> 8, g >> 8, b >> 8)
    return YCbCr(y, u, v)
  }
  if model == NYCBCRA_MODEL {
    match c {
      YCbCr(y, u, v) => { return NYCbCrA(y, u, v, 0xff) },
      _ => {},
    }
    var r2 = r
    var g2 = g
    var b2 = b
    if a != 0 {
      r2 = r * 0xffff / a
      g2 = g * 0xffff / a
      b2 = b * 0xffff / a
    }
    let (y, u, v) = rgb_to_ycbcr((r2 >> 8) & 255, (g2 >> 8) & 255, (b2 >> 8) & 255)
    return NYCbCrA(y, u, v, a >> 8)
  }
  let (cc, mm, yy, kk) = rgb_to_cmyk(r >> 8, g >> 8, b >> 8)
  CMYK(cc, mm, yy, kk)
}

fn sq_diff(x: Int, y: Int) -> Int {
  let d = if x > y { x - y } else { y - x }
  (d * d) >> 2
}

pub fn palette_index(p: List<Color>, c: Color) -> Int {
  let (cr, cg, cb, ca) = rgba(c)
  var ret = 0
  var best = 4294967295
  for i in 0..len(p) {
    let (vr, vg, vb, va) = rgba(p[i])
    let sum = sq_diff(cr, vr) + sq_diff(cg, vg) + sq_diff(cb, vb) + sq_diff(ca, va)
    if sum < best {
      if sum == 0 { return i }
      ret = i
      best = sum
    }
  }
  ret
}

// 空调色板时 Go 返回 nil，这里返回 None
pub fn palette_convert(p: List<Color>, c: Color) -> Option<Color> {
  if len(p) == 0 { return None }
  Some(p[palette_index(p, c)])
}

// Go 的 %v 输出，例如 {255 0 0 255}
pub fn string(c: Color) -> Str {
  match c {
    RGBA(r, g, b, a) => "\{{r} {g} {b} {a}}",
    RGBA64(r, g, b, a) => "\{{r} {g} {b} {a}}",
    NRGBA(r, g, b, a) => "\{{r} {g} {b} {a}}",
    NRGBA64(r, g, b, a) => "\{{r} {g} {b} {a}}",
    Alpha(a) => "\{{a}}",
    Alpha16(a) => "\{{a}}",
    Gray(y) => "\{{y}}",
    Gray16(y) => "\{{y}}",
    YCbCr(y, cb, cr) => "\{{y} {cb} {cr}}",
    NYCbCrA(y, cb, cr, a) => "\{\{{y} {cb} {cr}} {a}}",
    CMYK(c1, m, y, k) => "\{{c1} {m} {y} {k}}",
  }
}

