// std.go.scanner：对齐 Go 1.27 的 go/scanner
//   init(file, src, mode) -> Scanner；s.scan() -> (Scanner, pos, tok, lit)；s.end()
//   Scanner 和 token.File 都是值：扫描时加的行记在 s.file 里，用完后 fset.set_file(s.file) 写回。
//   错误不走回调：都记在 s.errors（Go 里传入收集错误的 ErrorHandler 得到的就是这个列表），error_count 同 Go。
//   ErrorList：error_string、list_string、sort_errors、remove_multiples。
//   与 Go 的差异：字面量 lit 是 Str，源码里非法的 UTF-8 字节按 strings.ToValidUTF8 换成 U+FFFD。

use std.go.token as token
use std.unicode
use std.strconv
use std.path

pub const SCAN_COMMENTS: Int = 1
pub const DONT_INSERT_SEMIS: Int = 2

const BOM: Int = 65279
const EOF_CH: Int = -1

pub type Error = { pos: token.Position, msg: Str }

pub fn error_string(e: Error) -> Str {
  if e.pos.filename != "" || e.pos.line > 0 { return e.pos.to_string() + ": " + e.msg }
  e.msg
}

// sort.Sort 不稳定，但比较键包含了全部字段，结果唯一
pub fn sort_errors(es: List<Error>) -> List<Error> { sort_by(es, (e) => (e.pos.filename, e.pos.line, e.pos.column, e.msg)) }

pub fn remove_multiples(es0: List<Error>) -> List<Error> {
  let es = sort_errors(es0)
  var out: List<Error> = []
  var lf = ""
  var ll = 0
  for e in es {
    if e.pos.filename != lf || e.pos.line != ll {
      lf = e.pos.filename
      ll = e.pos.line
      out = push(out, e)
    }
  }
  out
}

pub fn list_string(es: List<Error>) -> Str {
  if len(es) == 0 { return "no errors" }
  if len(es) == 1 { return error_string(es[0]) }
  error_string(es[0]) + " (and {len(es) - 1} more errors)"
}

pub type Scanner = {
  file: token.File,
  dir: Str,
  src: List<Int>,
  mode: Int,
  ch: Int,
  offset: Int,
  rd: Int,
  line_offset: Int,
  insert_semi: Bool,
  nl_pos: Int,
  end_pos_valid: Bool,
  end_pos: Int,
  error_count: Int,
  errors: List<Error>,
}

pub fn bytes_str(bs: List<Int>) -> Str {
  match __from_bytes(bs) {
    Some(s) => s,
    None => {
      // 同 strings.ToValidUTF8(s, "\uFFFD")：连续的非法字节只换成一个 U+FFFD
      var out: List<Str> = []
      var i = 0
      var bad = false
      while i < len(bs) {
        let (r, w) = decode_rune(bs, i)
        if r == 65533 && w == 1 {
          if !bad { out = push(out, __chr(65533)) }
          bad = true
        } else {
          out = push(out, __chr(r))
          bad = false
        }
        i += w
      }
      join(out, "")
    },
  }
}

// utf8.DecodeRune：返回 (码点, 宽度)，非法时 (0xFFFD, 1)
pub fn decode_rune(p: List<Int>, i: Int) -> (Int, Int) {
  let n = len(p) - i
  if n < 1 { return (65533, 0) }
  let b0 = p[i]
  if b0 < 128 { return (b0, 1) }
  if b0 < 0xC2 || b0 > 0xF4 { return (65533, 1) }
  if b0 < 0xE0 {
    if n < 2 || p[i + 1] & 0xC0 != 0x80 { return (65533, 1) }
    return (((b0 & 0x1F) << 6) | (p[i + 1] & 0x3F), 2)
  }
  if b0 < 0xF0 {
    let lo = if b0 == 0xE0 { 0xA0 } else { 0x80 }
    let hi = if b0 == 0xED { 0x9F } else { 0xBF }
    if n < 2 || p[i + 1] < lo || p[i + 1] > hi { return (65533, 1) }
    if n < 3 || p[i + 2] & 0xC0 != 0x80 { return (65533, 1) }
    return (((b0 & 0x0F) << 12) | ((p[i + 1] & 0x3F) << 6) | (p[i + 2] & 0x3F), 3)
  }
  let lo = if b0 == 0xF0 { 0x90 } else { 0x80 }
  let hi = if b0 == 0xF4 { 0x8F } else { 0xBF }
  if n < 2 || p[i + 1] < lo || p[i + 1] > hi { return (65533, 1) }
  if n < 3 || p[i + 2] & 0xC0 != 0x80 { return (65533, 1) }
  if n < 4 || p[i + 3] & 0xC0 != 0x80 { return (65533, 1) }
  (((b0 & 0x07) << 18) | ((p[i + 1] & 0x3F) << 12) | ((p[i + 2] & 0x3F) << 6) | (p[i + 3] & 0x3F), 4)
}

fn err_at(s: Scanner, offs: Int, msg: Str) -> Scanner {
  let e = Error { pos: s.file.position(s.file.pos(offs)), msg: msg }
  Scanner { errors: push(s.errors, e), error_count: s.error_count + 1, ..s }
}

fn next(s0: Scanner) -> Scanner {
  var s = s0
  if s.rd < len(s.src) {
    let off = s.rd
    if s.ch == 10 { s = Scanner { line_offset: off, file: s.file.add_line(off), ..s } }
    s = Scanner { offset: off, ..s }
    var r = s.src[off]
    var w = 1
    if r == 0 {
      s = err_at(s, off, "illegal character NUL")
    } else if r >= 128 {
      let (r2, w2) = decode_rune(s.src, off)
      r = r2
      w = w2
      if r == 65533 && w == 1 {
        let n = len(s.src) - off
        if off == 0 && n >= 2 && (s.src[0] == 0xFF && s.src[1] == 0xFE || s.src[0] == 0xFE && s.src[1] == 0xFF) {
          s = err_at(s, off, "illegal UTF-8 encoding (got UTF-16)")
          w = n
        } else {
          s = err_at(s, off, "illegal UTF-8 encoding")
        }
      } else if r == BOM && off > 0 {
        s = err_at(s, off, "illegal byte order mark")
      }
    }
    return Scanner { rd: s.rd + w, ch: r, ..s }
  }
  let off = len(s.src)
  if s.ch == 10 { s = Scanner { line_offset: off, file: s.file.add_line(off), ..s } }
  Scanner { offset: off, ch: EOF_CH, ..s }
}

fn peek(s: Scanner) -> Int { if s.rd < len(s.src) { s.src[s.rd] } else { 0 } }

// Go 的 Init 在 file.Size() != len(src) 时 panic，这里返回 Err
pub fn init(file: token.File, src: List<Int>, mode: Int) -> Result<Scanner, Str> {
  if file.size != len(src) { return Err("file size ({file.size}) does not match src len ({len(src)})") }
  let (dir, _) = path.split(file.name)
  var s = Scanner { file: file, dir: dir, src: src, mode: mode, ch: 32, offset: 0, rd: 0, line_offset: 0, insert_semi: false,
    nl_pos: 0, end_pos_valid: true, end_pos: 0, error_count: 0, errors: [] }
  s = next(s)
  if s.ch == BOM { s = next(s) }
  Ok(s)
}

fn lower(ch: Int) -> Int { 32 | ch }
fn is_decimal(ch: Int) -> Bool { ch >= 48 && ch <= 57 }
fn is_hex(ch: Int) -> Bool { ch >= 48 && ch <= 57 || lower(ch) >= 97 && lower(ch) <= 102 }

fn is_letter(ch: Int) -> Bool {
  lower(ch) >= 97 && lower(ch) <= 122 || ch == 95 || ch >= 128 && ch <= 1114111 && unicode.is_letter(__chr(safe(ch)))
}

fn is_digit(ch: Int) -> Bool { is_decimal(ch) || ch >= 128 && ch <= 1114111 && unicode.is_digit(__chr(safe(ch))) }

fn safe(r: Int) -> Int { if r >= 55296 && r <= 57343 { 65533 } else { r } }

fn digit_val(ch: Int) -> Int {
  if ch >= 48 && ch <= 57 { return ch - 48 }
  if lower(ch) >= 97 && lower(ch) <= 102 { return lower(ch) - 87 }
  16
}

fn fmt_u(r: Int) -> Str {
  var h = strconv.format_int(if r < 0 { 0 - r } else { r }, 16)
  h = upper_ascii(h)
  while len(h) < 4 { h = "0" + h }
  var s = (if r < 0 { "U+-" } else { "U+" }) + h
  if r >= 0 && r <= 1114111 && !(r >= 55296 && r <= 57343) && unicode.is_print(__chr(r)) { s = s + " '" + __chr(r) + "'" }
  s
}

fn upper_ascii(s: Str) -> Str { join(map(chars(s), (c) => if c >= "a" && c <= "z" { __chr(__ord(c) - 32) } else { c }), "") }

fn starts_with_bytes(bs: List<Int>, from: Int, p: List<Int>) -> Bool {
  if len(bs) - from < len(p) { return false }
  var i = 0
  while i < len(p) {
    if bs[from + i] != p[i] { return false }
    i += 1
  }
  true
}

// 返回 (Scanner, 注释文本, 第一个换行的偏移)
fn scan_comment(s0: Scanner) -> (Scanner, Str, Int) {
  var s = s0
  let offs = s.offset - 1
  var nxt = -1
  var num_cr = 0
  var nl_offset = 0
  if s.ch == 47 {
    s = next(s)
    while s.ch != 10 && s.ch >= 0 {
      if s.ch == 13 { num_cr += 1 }
      s = next(s)
    }
    nxt = s.offset
    if s.ch == 10 { nxt += 1 }
  } else {
    s = next(s)
    var done = false
    while s.ch >= 0 {
      let ch = s.ch
      if ch == 13 { num_cr += 1 } else if ch == 10 && nl_offset == 0 { nl_offset = s.offset }
      s = next(s)
      if ch == 42 && s.ch == 47 {
        s = next(s)
        nxt = s.offset
        done = true
        break
      }
    }
    if !done { s = err_at(s, offs, "comment not terminated") }
  }
  var lit = s.src[offs..s.offset]
  if num_cr > 0 && len(lit) >= 2 && lit[1] == 47 && lit[len(lit) - 1] == 13 {
    lit = lit[0..len(lit) - 1]
    num_cr -= 1
  }
  if nxt >= 0 && (lit[1] == 42 || offs == s.line_offset) && starts_with_bytes(lit, 2, [108, 105, 110, 101, 32]) {
    s = update_line_info(s, nxt, offs, lit)
  }
  if num_cr > 0 { lit = strip_cr(lit, lit[1] == 42) }
  (s, bytes_str(lit), nl_offset)
}

fn trailing_digits(text: List<Int>) -> (Int, Int, Bool) {
  var i = len(text) - 1
  while i >= 0 && text[i] != 58 { i -= 1 }
  if i < 0 { return (0, 0, false) }
  let ds = text[i + 1..]
  if len(ds) == 0 { return (i + 1, 0, false) }
  var n = 0
  for d in ds {
    if d < 48 || d > 57 { return (i + 1, 0, false) }
    if n > 922337203685477580 { return (i + 1, 0, false) }
    n = n * 10 + d - 48
  }
  (i + 1, n, true)
}

fn update_line_info(s: Scanner, nxt: Int, offs0: Int, text0: List<Int>) -> Scanner {
  var text = text0
  var offs = offs0
  if text[1] == 42 { text = text[0..len(text) - 2] }
  text = text[7..]
  offs += 7
  var (i, n, ok) = trailing_digits(text)
  if i == 0 { return s }
  if !ok { return err_at(s, offs + i, "invalid line number: " + bytes_str(text[i..])) }
  let max_lc = 1073741824
  var line = 0
  var col = 0
  let (i2a, n2, ok2) = trailing_digits(text[0..i - 1])
  var i2 = i2a
  if ok2 {
    let t = i
    i = i2
    i2 = t
    line = n2
    col = n
    if col == 0 || col > max_lc { return err_at(s, offs + i2, "invalid column number: " + bytes_str(text[i2..])) }
    text = text[0..i2 - 1]
  } else {
    line = n
  }
  if line == 0 || line > max_lc { return err_at(s, offs + i, "invalid line number: " + bytes_str(text[i..])) }
  var filename = bytes_str(text[0..i - 1])
  if filename == "" && ok2 {
    filename = s.file.position(s.file.pos(offs)).filename
  } else if filename != "" {
    filename = path.clean(filename)
    if !path.is_abs(filename) { filename = path.join([s.dir, filename]) }
  }
  Scanner { file: s.file.add_line_column_info(nxt, filename, line, col), ..s }
}

fn strip_cr(b: List<Int>, comment: Bool) -> List<Int> {
  var c: List<Int> = []
  var j = 0
  while j < len(b) {
    let ch = b[j]
    if ch != 13 || comment && len(c) > 2 && c[len(c) - 1] == 42 && j + 1 < len(b) && b[j + 1] == 47 { c = push(c, ch) }
    j += 1
  }
  c
}

fn scan_identifier(s0: Scanner) -> (Scanner, Str) {
  var s = s0
  let offs = s.offset
  var k = s.rd
  let n = len(s.src)
  while k < n {
    let b = s.src[k]
    if b >= 97 && b <= 122 || b >= 65 && b <= 90 || b == 95 || b >= 48 && b <= 57 { k += 1; continue }
    if 0 < b && b < 128 {
      s = Scanner { ch: b, offset: k, rd: k + 1, ..s }
      return (s, bytes_str(s.src[offs..s.offset]))
    }
    s = next(Scanner { rd: k, ..s })
    while is_letter(s.ch) || is_digit(s.ch) { s = next(s) }
    return (s, bytes_str(s.src[offs..s.offset]))
  }
  s = Scanner { offset: n, rd: n, ch: EOF_CH, ..s }
  (s, bytes_str(s.src[offs..s.offset]))
}

// 返回 (Scanner, digsep, invalid)
fn digits(s0: Scanner, base: Int, invalid0: Int) -> (Scanner, Int, Int) {
  var s = s0
  var invalid = invalid0
  var digsep = 0
  if base <= 10 {
    let mx = 48 + base
    while is_decimal(s.ch) || s.ch == 95 {
      var ds = 1
      if s.ch == 95 { ds = 2 } else if s.ch >= mx && invalid < 0 { invalid = s.offset }
      digsep = digsep | ds
      s = next(s)
    }
  } else {
    while is_hex(s.ch) || s.ch == 95 {
      digsep = digsep | (if s.ch == 95 { 2 } else { 1 })
      s = next(s)
    }
  }
  (s, digsep, invalid)
}

fn litname(prefix: Int) -> Str {
  if prefix == 120 { return "hexadecimal literal" }
  if prefix == 111 || prefix == 48 { return "octal literal" }
  if prefix == 98 { return "binary literal" }
  "decimal literal"
}

fn invalid_sep(x: List<Int>) -> Int {
  var x1 = 32
  var d = 46
  var i = 0
  if len(x) >= 2 && x[0] == 48 {
    x1 = lower(x[1])
    if x1 == 120 || x1 == 111 || x1 == 98 {
      d = 48
      i = 2
    }
  }
  while i < len(x) {
    let p = d
    d = x[i]
    if d == 95 {
      if p != 48 { return i }
    } else if is_decimal(d) || x1 == 120 && is_hex(d) {
      d = 48
    } else {
      if p == 95 { return i - 1 }
      d = 46
    }
    i += 1
  }
  if d == 95 { return len(x) - 1 }
  -1
}

fn scan_number(s0: Scanner) -> (Scanner, Int, Str) {
  var s = s0
  let offs = s.offset
  var tok = token.ILLEGAL
  var base = 10
  var prefix = 0
  var digsep = 0
  var invalid = -1
  if s.ch != 46 {
    tok = token.INT
    if s.ch == 48 {
      s = next(s)
      let l = lower(s.ch)
      if l == 120 { s = next(s); base = 16; prefix = 120 }
      else if l == 111 { s = next(s); base = 8; prefix = 111 }
      else if l == 98 { s = next(s); base = 2; prefix = 98 }
      else { base = 8; prefix = 48; digsep = 1 }
    }
    let (s2, ds, inv) = digits(s, base, invalid)
    s = s2
    digsep = digsep | ds
    invalid = inv
  }
  if s.ch == 46 {
    tok = token.FLOAT
    if prefix == 111 || prefix == 98 { s = err_at(s, s.offset, "invalid radix point in " + litname(prefix)) }
    s = next(s)
    let (s2, ds, inv) = digits(s, base, invalid)
    s = s2
    digsep = digsep | ds
    invalid = inv
  }
  if digsep & 1 == 0 { s = err_at(s, s.offset, litname(prefix) + " has no digits") }
  let e = lower(s.ch)
  if e == 101 || e == 112 {
    if e == 101 && prefix != 0 && prefix != 48 {
      s = err_at(s, s.offset, strconv.quote_rune(s.ch) + " exponent requires decimal mantissa")
    } else if e == 112 && prefix != 120 {
      s = err_at(s, s.offset, strconv.quote_rune(s.ch) + " exponent requires hexadecimal mantissa")
    }
    s = next(s)
    tok = token.FLOAT
    if s.ch == 43 || s.ch == 45 { s = next(s) }
    let (s2, ds, _) = digits(s, 10, 0)
    s = s2
    digsep = digsep | ds
    if ds & 1 == 0 { s = err_at(s, s.offset, "exponent has no digits") }
  } else if prefix == 120 && tok == token.FLOAT {
    s = err_at(s, s.offset, "hexadecimal mantissa requires a 'p' exponent")
  }
  if s.ch == 105 {
    tok = token.IMAG
    s = next(s)
  }
  let litb = s.src[offs..s.offset]
  if tok == token.INT && invalid >= 0 {
    s = err_at(s, invalid, "invalid digit " + strconv.quote_rune(litb[invalid - offs]) + " in " + litname(prefix))
  }
  if digsep & 2 != 0 {
    let i = invalid_sep(litb)
    if i >= 0 { s = err_at(s, offs + i, "'_' must separate successive digits") }
  }
  (s, tok, bytes_str(litb))
}

fn scan_escape(s0: Scanner, quote: Int) -> (Scanner, Bool) {
  var s = s0
  let offs = s.offset
  var n = 0
  var base = 0
  var mx = 0
  let c = s.ch
  if c == 97 || c == 98 || c == 102 || c == 110 || c == 114 || c == 116 || c == 118 || c == 92 || c == quote {
    return (next(s), true)
  }
  if c >= 48 && c <= 55 { n = 3; base = 8; mx = 255 }
  else if c == 120 { s = next(s); n = 2; base = 16; mx = 255 }
  else if c == 117 { s = next(s); n = 4; base = 16; mx = 1114111 }
  else if c == 85 { s = next(s); n = 8; base = 16; mx = 1114111 }
  else {
    let msg = if s.ch < 0 { "escape sequence not terminated" } else { "unknown escape sequence" }
    return (err_at(s, offs, msg), false)
  }
  var x = 0
  while n > 0 {
    let d = if s.ch < 0 { 16 } else { digit_val(s.ch) }
    if d >= base {
      let msg = if s.ch < 0 { "escape sequence not terminated" } else { "illegal character " + fmt_u(s.ch) + " in escape sequence" }
      return (err_at(s, s.offset, msg), false)
    }
    x = (x * base + d) % 4294967296
    s = next(s)
    n -= 1
  }
  if x > mx || 55296 <= x && x < 57344 { return (err_at(s, offs, "escape sequence is invalid Unicode code point"), false) }
  (s, true)
}

fn scan_rune(s0: Scanner) -> (Scanner, Str) {
  var s = s0
  let offs = s.offset - 1
  var valid = true
  var n = 0
  loop {
    let ch = s.ch
    if ch == 10 || ch < 0 {
      if valid {
        s = err_at(s, offs, "rune literal not terminated")
        valid = false
      }
      break
    }
    s = next(s)
    if ch == 39 { break }
    n += 1
    if ch == 92 {
      let (s2, ok) = scan_escape(s, 39)
      s = s2
      if !ok { valid = false }
    }
  }
  if valid && n != 1 { s = err_at(s, offs, "illegal rune literal") }
  (s, bytes_str(s.src[offs..s.offset]))
}

fn scan_string(s0: Scanner) -> (Scanner, Str) {
  var s = s0
  let offs = s.offset - 1
  loop {
    let ch = s.ch
    if ch == 10 || ch < 0 {
      s = err_at(s, offs, "string literal not terminated")
      break
    }
    s = next(s)
    if ch == 34 { break }
    if ch == 92 {
      let (s2, _) = scan_escape(s, 34)
      s = s2
    }
  }
  (s, bytes_str(s.src[offs..s.offset]))
}

fn scan_raw_string(s0: Scanner) -> (Scanner, Str) {
  var s = s0
  let offs = s.offset - 1
  var has_cr = false
  loop {
    let ch = s.ch
    if ch < 0 {
      s = err_at(s, offs, "raw string literal not terminated")
      break
    }
    s = next(s)
    if ch == 96 { break }
    if ch == 13 { has_cr = true }
  }
  var lit = s.src[offs..s.offset]
  if has_cr { lit = strip_cr(lit, false) }
  (s, bytes_str(lit))
}

fn skip_whitespace(s0: Scanner) -> Scanner {
  var s = s0
  while s.ch == 32 || s.ch == 9 || s.ch == 10 && !s.insert_semi || s.ch == 13 { s = next(s) }
  s
}

fn switch2(s: Scanner, t0: Int, t1: Int) -> (Scanner, Int) {
  if s.ch == 61 { return (next(s), t1) }
  (s, t0)
}

fn switch3(s: Scanner, t0: Int, t1: Int, ch2: Int, t2: Int) -> (Scanner, Int) {
  if s.ch == 61 { return (next(s), t1) }
  if s.ch == ch2 { return (next(s), t2) }
  (s, t0)
}

fn switch4(s0: Scanner, t0: Int, t1: Int, ch2: Int, t2: Int, t3: Int) -> (Scanner, Int) {
  var s = s0
  if s.ch == 61 { return (next(s), t1) }
  if s.ch == ch2 {
    s = next(s)
    if s.ch == 61 { return (next(s), t3) }
    return (s, t2)
  }
  (s, t0)
}

impl Scanner {
  pub fn end(self) -> Int { if self.end_pos_valid { self.end_pos } else { self.file.pos(self.offset) } }

  pub fn scan(self) -> (Scanner, Int, Int, Str) {
    var s = self
    loop {
      s = Scanner { end_pos_valid: false, ..s }
      if s.nl_pos != 0 {
        let pos = s.nl_pos
        s = Scanner { end_pos: pos + 1, end_pos_valid: true, nl_pos: 0, ..s }
        return (s, pos, token.SEMICOLON, "\n")
      }
      s = skip_whitespace(s)
      let pos = s.file.pos(s.offset)
      var insert_semi = false
      var tok = token.ILLEGAL
      var lit = ""
      let ch = s.ch
      var again = false
      if is_letter(ch) {
        let (s2, l) = scan_identifier(s)
        s = s2
        lit = l
        if len(__bytes(lit)) > 1 {
          tok = token.lookup(lit)
          if tok == token.IDENT || tok == token.BREAK || tok == token.CONTINUE || tok == token.FALLTHROUGH || tok == token.RETURN { insert_semi = true }
        } else {
          insert_semi = true
          tok = token.IDENT
        }
      } else if is_decimal(ch) || ch == 46 && is_decimal(peek(s)) {
        insert_semi = true
        let (s2, t, l) = scan_number(s)
        s = s2
        tok = t
        lit = l
      } else {
        s = next(s)
        if ch == EOF_CH {
          if s.insert_semi { return (Scanner { insert_semi: false, ..s }, pos, token.SEMICOLON, "\n") }
          tok = token.EOF
        } else if ch == 10 {
          return (Scanner { insert_semi: false, ..s }, pos, token.SEMICOLON, "\n")
        } else if ch == 34 {
          insert_semi = true
          tok = token.STRING
          let (s2, l) = scan_string(s)
          s = s2
          lit = l
        } else if ch == 39 {
          insert_semi = true
          tok = token.CHAR
          let (s2, l) = scan_rune(s)
          s = s2
          lit = l
        } else if ch == 96 {
          insert_semi = true
          tok = token.STRING
          let (s2, l) = scan_raw_string(s)
          s = s2
          lit = l
        } else if ch == 58 {
          let (s2, t) = switch2(s, token.COLON, token.DEFINE); s = s2; tok = t
        } else if ch == 46 {
          tok = token.PERIOD
          if s.ch == 46 && peek(s) == 46 {
            s = next(next(s))
            tok = token.ELLIPSIS
          }
        } else if ch == 44 { tok = token.COMMA }
        else if ch == 59 { tok = token.SEMICOLON; lit = ";" }
        else if ch == 40 { tok = token.LPAREN }
        else if ch == 41 { insert_semi = true; tok = token.RPAREN }
        else if ch == 91 { tok = token.LBRACK }
        else if ch == 93 { insert_semi = true; tok = token.RBRACK }
        else if ch == 123 { tok = token.LBRACE }
        else if ch == 125 { insert_semi = true; tok = token.RBRACE }
        else if ch == 43 {
          let (s2, t) = switch3(s, token.ADD, token.ADD_ASSIGN, 43, token.INC); s = s2; tok = t
          if tok == token.INC { insert_semi = true }
        } else if ch == 45 {
          let (s2, t) = switch3(s, token.SUB, token.SUB_ASSIGN, 45, token.DEC); s = s2; tok = t
          if tok == token.DEC { insert_semi = true }
        } else if ch == 42 {
          let (s2, t) = switch2(s, token.MUL, token.MUL_ASSIGN); s = s2; tok = t
        } else if ch == 47 {
          if s.ch == 47 || s.ch == 42 {
            let (s2, comment, nl_offset) = scan_comment(s)
            s = s2
            if s.insert_semi && nl_offset != 0 {
              s = Scanner { nl_pos: s.file.pos(nl_offset), insert_semi: false, ..s }
            } else {
              insert_semi = s.insert_semi
            }
            if s.mode & SCAN_COMMENTS == 0 {
              again = true
            } else {
              tok = token.COMMENT
              lit = comment
            }
          } else {
            let (s2, t) = switch2(s, token.QUO, token.QUO_ASSIGN); s = s2; tok = t
          }
        } else if ch == 37 { let (s2, t) = switch2(s, token.REM, token.REM_ASSIGN); s = s2; tok = t }
        else if ch == 94 { let (s2, t) = switch2(s, token.XOR, token.XOR_ASSIGN); s = s2; tok = t }
        else if ch == 60 {
          if s.ch == 45 {
            s = next(s)
            tok = token.ARROW
          } else {
            let (s2, t) = switch4(s, token.LSS, token.LEQ, 60, token.SHL, token.SHL_ASSIGN); s = s2; tok = t
          }
        } else if ch == 62 { let (s2, t) = switch4(s, token.GTR, token.GEQ, 62, token.SHR, token.SHR_ASSIGN); s = s2; tok = t }
        else if ch == 61 { let (s2, t) = switch2(s, token.ASSIGN, token.EQL); s = s2; tok = t }
        else if ch == 33 { let (s2, t) = switch2(s, token.NOT, token.NEQ); s = s2; tok = t }
        else if ch == 38 {
          if s.ch == 94 {
            s = next(s)
            let (s2, t) = switch2(s, token.AND_NOT, token.AND_NOT_ASSIGN); s = s2; tok = t
          } else {
            let (s2, t) = switch3(s, token.AND, token.AND_ASSIGN, 38, token.LAND); s = s2; tok = t
          }
        } else if ch == 124 { let (s2, t) = switch3(s, token.OR, token.OR_ASSIGN, 124, token.LOR); s = s2; tok = t }
        else if ch == 126 { tok = token.TILDE }
        else {
          if ch != BOM {
            if ch == 8220 || ch == 8221 {
              s = err_at(s, s.file.offset(pos), "curly quotation mark " + strconv.quote_rune(ch) + " (use neutral " + strconv.quote_rune(34) + ")")
            } else {
              s = err_at(s, s.file.offset(pos), "illegal character " + fmt_u(ch))
            }
          }
          insert_semi = s.insert_semi
          tok = token.ILLEGAL
          lit = __chr(safe(ch))
        }
      }
      if again {
        if s.mode & DONT_INSERT_SEMIS == 0 { s = Scanner { insert_semi: insert_semi, ..s } }
        continue
      }
      if s.mode & DONT_INSERT_SEMIS == 0 { s = Scanner { insert_semi: insert_semi, ..s } }
      return (s, pos, tok, lit)
    }
    (s, 0, token.EOF, "")
  }
}
