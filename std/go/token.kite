// std.go.token：对齐 Go 1.27 的 go/token
//   记号常量（ILLEGAL … TILDE）、token_string / precedence / lookup / is_literal / is_operator / is_keyword、
//   is_exported / is_keyword_name / is_identifier；Position、File、FileSet。
//   与 Go 的差异：File 和 FileSet 是值。扫描器给 File 加行之后，用 fset.set_file(f) 把新的 File 写回 FileSet；
//   add_file 返回 (新的 FileSet, File)。没有 Read/Write（serialize.go）。

use std.unicode

pub const ILLEGAL: Int = 0
pub const EOF: Int = 1
pub const COMMENT: Int = 2
const LITERAL_BEG_: Int = 3
pub const IDENT: Int = 4
pub const INT: Int = 5
pub const FLOAT: Int = 6
pub const IMAG: Int = 7
pub const CHAR: Int = 8
pub const STRING: Int = 9
const LITERAL_END_: Int = 10
const OPERATOR_BEG_: Int = 11
pub const ADD: Int = 12
pub const SUB: Int = 13
pub const MUL: Int = 14
pub const QUO: Int = 15
pub const REM: Int = 16
pub const AND: Int = 17
pub const OR: Int = 18
pub const XOR: Int = 19
pub const SHL: Int = 20
pub const SHR: Int = 21
pub const AND_NOT: Int = 22
pub const ADD_ASSIGN: Int = 23
pub const SUB_ASSIGN: Int = 24
pub const MUL_ASSIGN: Int = 25
pub const QUO_ASSIGN: Int = 26
pub const REM_ASSIGN: Int = 27
pub const AND_ASSIGN: Int = 28
pub const OR_ASSIGN: Int = 29
pub const XOR_ASSIGN: Int = 30
pub const SHL_ASSIGN: Int = 31
pub const SHR_ASSIGN: Int = 32
pub const AND_NOT_ASSIGN: Int = 33
