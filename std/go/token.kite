  "|",
  "^",
  "<<",
  ">>",
  "&^",
  "+=",
  "-=",
  "*=",
  "/=",
  "%=",
  "&=",
  "|=",
  "^=",
  "<<=",
  ">>=",
  "&^=",
  "&&",
  "||",
  "<-",
  "++",
  "--",
  "==",
  "<",
  ">",
  "=",
  "!",
  "!=",
  "<=",
