pub const LOWEST_PREC: Int = 0
pub const UNARY_PREC: Int = 6
pub const HIGHEST_PREC: Int = 7

pub fn token_string(tok: Int) -> Str {
  var s = ""
  if 0 <= tok && tok < len(TOKENS) { s = TOKENS[tok] }
  if s == "" { s = "token(" + "{tok}" + ")" }
  s
}

pub fn precedence(op: Int) -> Int {
  if op == LOR { return 1 }
  if op == LAND { return 2 }
  if op == EQL || op == NEQ || op == LSS || op == LEQ || op == GTR || op == GEQ { return 3 }
  if op == ADD || op == SUB || op == OR || op == XOR { return 4 }
  if op == MUL || op == QUO || op == REM || op == SHL || op == SHR || op == AND || op == AND_NOT {
    return 5
  }
  LOWEST_PREC
}

pub fn lookup(ident: Str) -> Int {
  var i = KEYWORD_BEG_ + 1
  while i < KEYWORD_END_ {
    if TOKENS[i] == ident { return i }
    i += 1
  }
  IDENT
}

pub fn is_literal(tok: Int) -> Bool { LITERAL_BEG_ < tok && tok < LITERAL_END_ }
pub fn is_operator(tok: Int) -> Bool { OPERATOR_BEG_ < tok && tok < OPERATOR_END_ || tok == TILDE }
pub fn is_keyword(tok: Int) -> Bool { KEYWORD_BEG_ < tok && tok < KEYWORD_END_ }

pub fn is_exported(name: Str) -> Bool {
  if name == "" { return false }
  unicode.is_upper(__str_slice(name, 0, 1))
}

pub fn is_keyword_name(name: Str) -> Bool { lookup(name) != IDENT }

pub fn is_identifier(name: Str) -> Bool {
  if name == "" || is_keyword_name(name) { return false }
  var i = 0
  for c in name {
    if !unicode.is_letter(c) && c != "_" && (i == 0 || !unicode.is_digit(c)) { return false }
    i += 1
  }
  true
}

// ── 位置 ──
pub type Position = { filename: Str, offset: Int, line: Int, column: Int }

pub const NO_POS: Int = 0

pub fn no_position() -> Position { Position { filename: "", offset: 0, line: 0, column: 0 } }

impl Position {
  pub fn is_valid(self) -> Bool { self.line > 0 }

  pub fn to_string(self) -> Str {
    var s = self.filename
    if self.line > 0 {
      if s != "" { s = s + ":" }
      s = s + "{self.line}"
      if self.column != 0 { s = s + ":{self.column}" }
    }
    if s == "" { s = "-" }
    s
  }
}

pub fn pos_is_valid(p: Int) -> Bool { p != NO_POS }

type LineInfo = { offset: Int, filename: Str, line: Int, column: Int }

pub type File = { name: Str, base: Int, size: Int, lines: List<Int>, infos: List<LineInfo> }

fn search_ints(a: List<Int>, x: Int) -> Int {
  var i = 0
  var j = len(a)
  while i < j {
    let h = (i + j) / 2
    if a[h] <= x { i = h + 1 } else { j = h }
  }
  i - 1
}

impl File {
  pub fn to_string(self) -> Str { "{self.name}({self.base}-{self.base + self.size})" }
  pub fn end(self) -> Int { self.base + self.size }
  pub fn line_count(self) -> Int { len(self.lines) }

  pub fn add_line(self, offset: Int) -> File {
    let i = len(self.lines)
    if (i == 0 || self.lines[i - 1] < offset) && offset < self.size {
      return File { lines: push(self.lines, offset), ..self }
    }
    self
  }

  // Go 的 MergeLine 遇到非法行号会 panic；这里返回 Err
  pub fn merge_line(self, line: Int) -> Result<File, Str> {
    if line < 1 { return Err("invalid line number {line} (should be >= 1)") }
    if line >= len(self.lines) {
      return Err("invalid line number {line} (should be < {len(self.lines)})")
    }
    Ok(File { lines: self.lines[0..line] + self.lines[line + 1..], ..self })
  }

  // 返回 (新的 File, 是否接受)
  pub fn set_lines(self, lines: List<Int>) -> (File, Bool) {
    var i = 0
    while i < len(lines) {
      if i > 0 && lines[i] <= lines[i - 1] || self.size <= lines[i] { return (self, false) }
      i += 1
    }
    (File { lines: lines, ..self }, true)
  }

  pub fn set_lines_for_content(self, content: List<Int>) -> File {
    var lines: List<Int> = []
    var line = 0
    var off = 0
    for b in content {
      if line >= 0 { lines = push(lines, line) }
      line = -1
      if b == 10 { line = off + 1 }
      off += 1
    }
    File { lines: lines, ..self }
  }

  pub fn line_start(self, line: Int) -> Result<Int, Str> {
    if line < 1 { return Err("invalid line number {line} (should be >= 1)") }
    if line > len(self.lines) {
      return Err("invalid line number {line} (should be < {len(self.lines)})")
    }
    Ok(self.base + self.lines[line - 1])
  }

  pub fn add_line_info(self, offset: Int, filename: Str, line: Int) -> File {
    self.add_line_column_info(offset, filename, line, 1)
  }

  pub fn add_line_column_info(self, offset: Int, filename: Str, line: Int, column: Int) -> File {
    let i = len(self.infos)
    if (i == 0 || self.infos[i - 1].offset < offset) && offset < self.size {
      return File {
        infos: push(self.infos, LineInfo {
          offset: offset,
          filename: filename,
          line: line,
          column: column,
        }),
        ..self
      }
    }
    self
  }

  fn fix_offset(self, offset: Int) -> Int {
    if offset > self.size { self.size } else if offset < 0 { 0 } else { offset }
  }

  pub fn pos(self, offset: Int) -> Int { self.base + self.fix_offset(offset) }
  pub fn offset(self, p: Int) -> Int { self.fix_offset(p - self.base) }
  pub fn line(self, p: Int) -> Int { self.position(p).line }

  fn unpack(self, offset: Int, adjusted: Bool) -> (Str, Int, Int) {
    var filename = self.name
    var line = 0
    var column = 0
    let i = search_ints(self.lines, offset)
    if i >= 0 {
      line = i + 1
      column = offset - self.lines[i] + 1
    }
    if adjusted && len(self.infos) > 0 {
      var lo = 0
      var hi = len(self.infos)
      while lo < hi {
        let m = (lo + hi) / 2
        if self.infos[m].offset < offset { lo = m + 1 } else { hi = m }
      }
      var k = lo
      if !(k < len(self.infos) && self.infos[k].offset == offset) { k -= 1 }
      if k >= 0 {
        let alt = self.infos[k]
        filename = alt.filename
        let j = search_ints(self.lines, alt.offset)
        if j >= 0 {
          let d = line - (j + 1)
          line = alt.line + d
          if alt.column == 0 {
            column = 0
          } else if d == 0 {
            column = alt.column + (offset - alt.offset)
          }
        }
      }
    }
    (filename, line, column)
  }

  pub fn position_for(self, p: Int, adjusted: Bool) -> Position {
    if p == NO_POS { return no_position() }
    let offset = self.fix_offset(p - self.base)
    let (fname, line, col) = self.unpack(offset, adjusted)
    Position { filename: fname, offset: offset, line: line, column: col }
  }

  pub fn position(self, p: Int) -> Position { self.position_for(p, true) }
}

pub type FileSet = { base: Int, files: List<File> }

pub fn new_file_set() -> FileSet { FileSet { base: 1, files: [] } }

impl FileSet {
  // base < 0 表示用 fset.base；Go 遇到非法 base / size 会 panic，这里返回 Err
  pub fn add_file(self, filename: Str, base0: Int, size: Int) -> Result<(FileSet, File), Str> {
    var base = base0
    if base < 0 { base = self.base }
    if base < self.base { return Err("invalid base {base} (should be >= {self.base})") }
    if size < 0 { return Err("invalid size {size} (should be >= 0)") }
    let f = File { name: filename, base: base, size: size, lines: [0], infos: [] }
    let fs = self.insert(f)
    Ok((FileSet { base: base + size + 1, files: fs.files }, f))
  }

  fn insert(self, f: File) -> FileSet {
    var out: List<File> = []
    var done = false
    for g in self.files {
      if !done && f.base < g.base { out = push(out, f); done = true }
      if g.base == f.base && !done { out = push(out, f); done = true; continue }
      out = push(out, g)
    }
    if !done { out = push(out, f) }
    FileSet { files: out, ..self }
  }

  pub fn add_existing_files(self, files: List<File>) -> FileSet {
    var s = self
    for f in files {
      s = s.insert(f)
      let e = f.base + f.size + 1
      if e > s.base { s = FileSet { base: e, ..s } }
    }
    s
  }

  // 把扫描 / 解析之后更新过的 File（按 base 认）写回
  pub fn set_file(self, f: File) -> FileSet {
    FileSet {
      files: map(self.files, (g) => if g.base == f.base && g.name == f.name { f } else { g }),
      ..self
    }
  }

  pub fn remove_file(self, f: File) -> FileSet {
    FileSet {
      files: filter(self.files, (g) => !(g.base == f.base && g.size == f.size && g.name == f.name)),
      ..self
    }
  }

  pub fn iterate(self) -> List<File> { self.files }

  pub fn file(self, p: Int) -> Option<File> {
    if p == NO_POS { return None }
    var lo = 0
    var hi = len(self.files)
    while lo < hi {
      let m = (lo + hi) / 2
      let f = self.files[m]
      if p < f.base { hi = m } else if p > f.base + f.size { lo = m + 1 } else { return Some(f) }
    }
    None
  }

  pub fn position_for(self, p: Int, adjusted: Bool) -> Position {
    match self.file(p) { Some(f) => f.position_for(p, adjusted), None => no_position() }
  }

  pub fn position(self, p: Int) -> Position { self.position_for(p, true) }
}
