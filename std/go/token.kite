pub const RANGE: Int = 79
pub const RETURN: Int = 80
pub const SELECT: Int = 81
pub const STRUCT: Int = 82
pub const SWITCH: Int = 83
pub const TYPE: Int = 84
pub const VAR: Int = 85
const KEYWORD_END_: Int = 86
const ADDITIONAL_BEG_: Int = 87
pub const TILDE: Int = 88
const ADDITIONAL_END_: Int = 89

const TOKENS: List<Str> = [
  "ILLEGAL",
  "EOF",
  "COMMENT",
  "",
  "IDENT",
  "INT",
  "FLOAT",
  "IMAG",
  "CHAR",
  "STRING",
  "",
  "",
  "+",
  "-",
  "*",
  "/",
