pub const LBRACE: Int = 51
pub const COMMA: Int = 52
pub const PERIOD: Int = 53
pub const RPAREN: Int = 54
pub const RBRACK: Int = 55
pub const RBRACE: Int = 56
pub const SEMICOLON: Int = 57
pub const COLON: Int = 58
const OPERATOR_END_: Int = 59
const KEYWORD_BEG_: Int = 60
pub const BREAK: Int = 61
pub const CASE: Int = 62
pub const CHAN: Int = 63
pub const CONST: Int = 64
pub const CONTINUE: Int = 65
pub const DEFAULT: Int = 66
pub const DEFER: Int = 67
