// std.unicode：Unicode 字符属性和大小写映射（对齐 Go 的 unicode 包）
// 参数是单个字符的 Str（取第一个字符的码点）；表格来自 std.internal.unicode_tables（tools/gen_unicode.go 从 Go 1.27 的 unicode 包生成，Unicode 17.0.0）
//   分类：is_letter is_upper is_lower is_title is_digit is_number is_mark is_punct is_symbol is_space is_control
//         is_graphic is_print，以及 in_class(名字, c)：名字可以是一般分类（L、Lu、Nd、P、Sc…）或文字（Han、Latin、Greek…）
//   大小写：to_upper / to_lower / to_title（单个字符，简单映射），upper / lower（整个字符串）
//   table(名字)：一般分类或文字（Go 的 Categories / Scripts，全部 170 多种文字）；property_table(名字)：Go 的 Properties
//   script_names() / property_names()：按字母排序的名字列表

use std.internal.unicode_tables as ut

fn b36(c: Str) -> Int {
  let o = __ord(c)
  if o >= 97 { o - 87 } else { o - 48 }
}

fn nums(s: Str) -> List<Int> {
  var out: List<Int> = []
  var v = 0
  var neg = false
  var any = false
  for c in chars(s) {
    if c == "," {
      out = push(out, if neg { -v } else { v })
      v = 0
      neg = false
      any = false
    } else if c == "-" {
      neg = true
    } else {
      v = v * 36 + b36(c)
      any = true
    }
  }
  if any { out = push(out, if neg { -v } else { v }) }
  out
}

fn decode_pairs(s: Str) -> List<(Int, Int)> {
  let ns = nums(s)
  var out: List<(Int, Int)> = []
  var i = 0
  while i + 1 < len(ns) {
    out = push(out, (ns[i], ns[i + 1]))
    i += 2
  }
  out
}

// 把编码后的表格解成 [(起点, 终点)]
pub fn decode(s: Str) -> List<(Int, Int)> {
  let xs = nums(s)
  var out: List<(Int, Int)> = []
  var prev = -1
  var i = 0
  while i + 1 < len(xs) {
    let a = prev + 1 + xs[i]
    let b = a + xs[i + 1]
    out = push(out, (a, b))
    prev = b
    i += 2
  }
  out
}

fn decode_case(s: Str) -> List<(Int, Int, Int, Int)> {
  let xs = nums(s)
  var out: List<(Int, Int, Int, Int)> = []
  var prev = -1
  var i = 0
  while i + 3 < len(xs) {
    let a = prev + 1 + xs[i]
    let b = a + xs[i + 1]
    out = push(out, (a, b, xs[i + 2], xs[i + 3]))
    prev = b
    i += 4
  }
  out
}

const LETTER: List<(Int, Int)> = decode(ut.category_data("L"))
const UPPER: List<(Int, Int)> = decode(ut.category_data("Lu"))
const LOWER: List<(Int, Int)> = decode(ut.category_data("Ll"))
const TITLE: List<(Int, Int)> = decode(ut.category_data("Lt"))
const DIGIT: List<(Int, Int)> = decode(ut.category_data("Nd"))
const NUMBER: List<(Int, Int)> = decode(ut.category_data("N"))
const MARK: List<(Int, Int)> = decode(ut.category_data("M"))
const PUNCT: List<(Int, Int)> = decode(ut.category_data("P"))
const SYMBOL: List<(Int, Int)> = decode(ut.category_data("S"))
const SPACE_Z: List<(Int, Int)> = decode(ut.category_data("Z"))
const CASES: List<(Int, Int, Int, Int)> = decode_case(ut.case_data())
const TITLES: List<(Int, Int)> = decode_pairs(ut.title_data())

pub const VERSION: Str = ut.UNICODE_VERSION

// 码点是否在表里（二分查找）
pub fn in_table(t: List<(Int, Int)>, c: Int) -> Bool {
  var lo = 0
  var hi = len(t)
  while lo < hi {
    let mid = (lo + hi) / 2
    let (a, b) = t[mid]
    if c < a { hi = mid } else if c > b { lo = mid + 1 } else { return true }
  }
  false
}

// 按名字取表：一般分类（L Lu Ll Lt Lm Lo M Mn Mc Me N Nd Nl No P Pc Pd Ps Pe Pi Pf Po S Sm Sc Sk So Z Zs Zl Zp Cc Cf Co）
// 或文字（Han Hiragana Katakana Hangul Latin Greek Cyrillic Arabic Hebrew Thai Devanagari）
pub fn table(name: Str) -> Option<List<(Int, Int)>> {
  if name == "L" { return Some(LETTER) }
  if name == "Lu" { return Some(UPPER) }
  if name == "Ll" { return Some(LOWER) }
  if name == "Nd" { return Some(DIGIT) }
  if name == "N" { return Some(NUMBER) }
  if name == "P" { return Some(PUNCT) }
  if name == "S" { return Some(SYMBOL) }
  if name == "Z" { return Some(SPACE_Z) }
  if name == "M" { return Some(MARK) }
  if !contains(ut.category_names(), name) && !contains(ut.script_names(), name) { return None }
  Some(decode(ut.category_data(name)))
}

// Go 的 unicode.Properties（White_Space、Dash 等）
pub fn property_table(name: Str) -> Option<List<(Int, Int)>> {
  if !contains(ut.property_names(), name) { return None }
  Some(decode(ut.category_data(name)))
}

// 分类名（Go 的 unicode.Categories 的键）
pub fn names() -> List<Str> { ut.category_names() }

// 文字名（Go 的 unicode.Scripts 的键，按字母排序）
pub fn script_names() -> List<Str> { ut.script_names() }

// 属性名（Go 的 unicode.Properties 的键，按字母排序）
pub fn property_names() -> List<Str> { ut.property_names() }

pub fn in_class(name: Str, c: Str) -> Bool {
  match table(name) {
    Some(t) => in_table(t, __ord(c)),
    None => false,
  }
}

pub fn is_letter(c: Str) -> Bool { in_table(LETTER, __ord(c)) }

pub fn is_upper(c: Str) -> Bool { in_table(UPPER, __ord(c)) }

pub fn is_lower(c: Str) -> Bool { in_table(LOWER, __ord(c)) }

pub fn is_title(c: Str) -> Bool { in_table(TITLE, __ord(c)) }

pub fn is_digit(c: Str) -> Bool { in_table(DIGIT, __ord(c)) }

pub fn is_number(c: Str) -> Bool { in_table(NUMBER, __ord(c)) }

pub fn is_mark(c: Str) -> Bool { in_table(MARK, __ord(c)) }

pub fn is_punct(c: Str) -> Bool { in_table(PUNCT, __ord(c)) }

pub fn is_symbol(c: Str) -> Bool { in_table(SYMBOL, __ord(c)) }

// 同 Go：\t \n \v \f \r 空格、U+0085、U+00A0，以及 Z 类
pub fn is_space(c: Str) -> Bool {
  let o = __ord(c)
  if o < 256 {
    (o >= 9 && o <= 13) || o == 32 || o == 133 || o == 160
  } else {
    in_table(SPACE_Z, o)
  }
}

pub fn is_control(c: Str) -> Bool {
  let o = __ord(c)
  o < 32 || (o >= 127 && o < 160)
}

// L M N P S Zs
pub fn is_graphic(c: Str) -> Bool {
  let o = __ord(c)
  in_table(LETTER, o)
    || in_table(MARK, o)
    || in_table(NUMBER, o)
    || in_table(PUNCT, o)
    || in_table(SYMBOL, o)
    || (in_table(SPACE_Z, o) && o != 8232 && o != 8233)
}

// 同 is_graphic，但空白里只算 ASCII 空格
pub fn is_print(c: Str) -> Bool {
  let o = __ord(c)
  if o == 32 { return true }
  in_table(LETTER, o)
    || in_table(MARK, o)
    || in_table(NUMBER, o)
    || in_table(PUNCT, o)
    || in_table(SYMBOL, o)
}

fn case_of(o: Int) -> Option<(Int, Int, Int, Int)> {
  var lo = 0
  var hi = len(CASES)
  while lo < hi {
    let mid = (lo + hi) / 2
    let (a, b, _, _) = CASES[mid]
    if o < a { hi = mid } else if o > b { lo = mid + 1 } else { return Some(CASES[mid]) }
  }
  None
}

// 码点的大小写映射；which：0 大写、1 小写
pub fn map_case(o: Int, which: Int) -> Int {
  let Some((a, _, du, dl)) = case_of(o) else { return o }
  if du == 999999 {
    let even = (o - a) % 2 == 0
    if which == 0 { if even { o } else { o - 1 } } else { if even { o + 1 } else { o } }
  } else if which == 0 {
    o + du
  } else {
    o + dl
  }
}

pub fn to_upper(c: Str) -> Str { __chr(map_case(__ord(c), 0)) }

pub fn to_lower(c: Str) -> Str { __chr(map_case(__ord(c), 1)) }

// 标题大写：大多数码点和大写相同，不同的在 TITLES 里（Ǆ ǅ ǆ 这类合字、格鲁吉亚文等）
pub fn to_title(c: Str) -> Str {
  let o = __ord(c)
  var lo = 0
  var hi = len(TITLES)
  while lo < hi {
    let mid = (lo + hi) / 2
    let (a, t) = TITLES[mid]
    if o < a { hi = mid } else if o > a { lo = mid + 1 } else { return __chr(t) }
  }
  to_upper(c)
}

// 整个字符串（逐字符简单映射，长度不变；ß 这类不会变成两个字母）
pub fn upper(s: Str) -> Str { join(map(chars(s), (c) => to_upper(c)), "") }

pub fn lower(s: Str) -> Str { join(map(chars(s), (c) => to_lower(c)), "") }

// Go 的 unicode.SimpleFold：大小写等价类里的下一个码点（按码点升序循环）
const FOLD_EXC: List<(Int, Int)> = [
  (107, 8490),
  (115, 383),
  (223, 7838),
  (229, 8491),
  (304, 304),
  (305, 305),
  (452, 453),
  (455, 456),
  (458, 459),
  (497, 498),
  (912, 8147),
  (931, 962),
  (944, 8163),
  (946, 976),
  (949, 1013),
  (952, 977),
  (953, 8126),
  (954, 1008),
  (956, 181),
  (960, 982),
  (961, 1009),
  (962, 963),
  (966, 981),
  (969, 8486),
  (977, 1012),
  (1012, 920),
  (1074, 7296),
  (1076, 7297),
  (1086, 7298),
  (1089, 7299),
  (1090, 7300),
  (1098, 7302),
  (1123, 7303),
  (7300, 7301),
  (7777, 7835),
  (8126, 837),
  (8147, 912),
  (8163, 944),
  (8486, 937),
  (8490, 75),
  (8491, 197),
  (42571, 7304),
  (64261, 64262),
  (64262, 64261),
]

pub fn simple_fold(r: Int) -> Int {
  if r < 0 || r > 1114111 { return r }
  var lo = 0
  var hi = len(FOLD_EXC)
  while lo < hi {
    let mid = (lo + hi) / 2
    let (a, b) = FOLD_EXC[mid]
    if r < a { hi = mid } else if r > a { lo = mid + 1 } else { return b }
  }
  let l = map_case(r, 1)
  if l != r { return l }
  map_case(r, 0)
}

