// std.kite.ast：Kite 强类型语法树（对应 Go 的 go/ast；kitec 自己用的就是这一份）
//   Node = { k: K, line, …, t（类型检查后的类型）}；K 是各种节点的枚举（NFn、NName、NCall…）
//   kname(n) 节点种类名、kids(n) 子节点、with_kids(n, ks) 替换子节点、dump(n) 打印（kitec parse 的格式）
// 解析器产出，模块系统改名，类型检查后成为类型化 IR（表达式节点带 Node.t）
use std.kite.ty as tys
use std.kite.ty.{ Ty }
use std.kite.val as val
use std.kite.val.{ V, nd, opt, strs, items, sv }

// 解析器直接产出下面这些类型；每种节点一个变体，字段都有确定的类型。
// to_v 只用于输出：转成 val.V 后按 Python 版的格式打印。

// 字面量
pub enum Lit {
  LInt(Int),
  LBig(Str),
  LFlt(Float),
  LStr(Str),
  LBool(Bool),
}

// 名字：普通名字或限定名（A.Other）
pub enum Nm {
  NmS(Str),
  NmQ(Str, Str?),
}

// 类型表达式（检查前的语法形式）
pub enum TyX {
  YCon(Str, List<TyX>, Int),
  YTup(List<TyX>, Int),
  YDyn(List<Str>, Int),
  YImpl(List<Str>, Int),
  YUnsafe(TyX, Int),
  YFn(List<TyX>, TyX, Int),
}

// 模式
pub enum Pat {
  PWild,
  PBind(Nm),
  PVar(Nm),
  PLit(Lit),
  PRange(Lit?, Lit?, Bool),
  PTuple(List<Pat>),
  PList(List<Pat>, Str?, List<Pat>),
  PVariant(Nm, List<Pat>?),
  PStruct(Nm, List<(Str, Pat)>),
  POr(List<Pat>),
  PAt(Pat, Pat),
  PDots,
}

// 属性 @name(k: v, …)
pub type Attr = { name: Str, args: List<(Str?, Lit?)>, line: Int }

// 可见性：pub 和 pub(pkg) / pub(mod)；has_vis 为假时只有 pub 字段（extern 块里的 fn）
pub type Vis = { is_pub: Bool, vis: Str?, has_vis: Bool }

// 枚举变体的字段：无字段 / 元组式 / 记录式
pub enum EvF {
  EvNone,
  EvList(List<(Str, TyX)>),
  EvRec(List<(Str, TyX)>),
}

// use 路径的一段
pub enum UseP {
  UName(Str),
  UGroup(List<(Str, Str?)>),
}

// 字符串插值的一段
pub enum IPart {
  IStr(Str),
  IExpr(Node),
}

// 关联常量 const NAME: T = v
pub type AConst = { name: Str, ty: TyX, value: Node?, line: Int }

// trait 里的关联类型 type A: B + C = D
pub type TAssoc = { name: Str, bounds: List<Str>, dflt: TyX? }

// match 分支
pub type Arm = { pat: Pat, guard: Node?, body: Node }

// select 分支：kind 是 recv / send / after / default
pub type SArm = { kind: Str, a: Node?, b: Node?, pat: Pat?, guard: Node?, body: Node }

// 泛型参数：名字、约束（保持插入顺序）、常量泛型
// 约束按语法存成类型（Python 版取 ty(...)[1]，通常是名字）；ty_head 给出那一项
pub type Gen = { names: List<Str>, bounds: List<(Str, List<TyX>)>, cgens: List<Str> }

pub type FnD = {
  name: Str,
  params: List<(Str, TyX?)>,
  ret: TyX?,
  body: Node?,
  gen: Gen,
  is_async: Bool,
  is_unsafe: Bool,
  varargs: Bool,
  ext: List<Str>?,
  cname: Str?,
  x: FnX,
}

// 检查器补上的信息（Python 版检查 / 降级时挂在 Fn 节点上的属性）
// bare：lower_consts 生成的 __c_N 方法（没有 is_async / is_unsafe / cgens 字段）
// static_of：impl 静态方法提升成的顶层函数；const_name：关联常量方法对应的常量名
// ext_tys：extern 函数参数 / 返回值的 C 类型描述；va：可变参数 extern 的各个变体
pub type FnX = {
  bare: Bool,
  static_of: Str?,
  const_name: Str?,
  ext_tys: (List<XD>, XD)?,
  va: List<(Str, List<Str>)>,
}

// extern 类型描述：基本类型名 / 结构体 <"S" 名 <<字段 描述>…>> / 回调 <"F" <参数…> 返回>
pub enum XD {
  XdH(Str),
  XdS(Str, List<(Str, XD)>),
  XdF(List<Str>, Str),
}

pub fn no_fnx() -> FnX {
  FnX { bare: false, static_of: None, const_name: None, ext_tys: None, va: [] }
}

pub type ImplD = {
  tr: TyX?,
  target: Str,
  target_t: TyX,
  methods: List<Node>,
  gen: Gen,
  assoc: List<(Str, TyX)>,
  consts: List<AConst>,
}

pub type TraitD = {
  name: Str,
  methods: List<Node>,
  assoc: List<TAssoc>,
  supers: List<Str>,
  consts: List<AConst>,
}

pub type MatchD = { subject: Node, arms: List<Arm>, is_conj: (Node, Node)?, let_else: Node? }

pub enum K {
  // 声明
  NFn(FnD),
  NStruct(Str, List<(Str, TyX?)>, Gen),
  NAlias(Str, TyX, Gen),
  NEnum(Str, List<(Str, EvF)>, Gen),
  NTrait(TraitD),
  NImpl(ImplD),
  NUse(List<UseP>, Str?),
  NMod(Str?, List<Node>?),
  NExtern(List<Node>),
  // 语句
  NLet(pat: Pat, mutable: Bool, ty: TyX?, value: Node, is_const: Bool),
  NReturn(Node?),
  NBreak(Str?, Node?, Bool),  // 第三项：while let 改写出来的 break（Python 版没有 label / value 字段）
  NContinue(Str?),
  NWhile(Node?, Node),
  NFor(Pat, Node, Node),
  NLoop(Node, Str?),
  NDefer(Node),
  NAssign(target: Node, op: Str, value: Node),
  NExprStmt(Node),
  // 表达式
  NBlock(List<Node>, Bool),
  NIf(Node, Node, Node?),
  NLit(Lit),
  NName(Str),
  NBin(op: Str, left: Node, right: Node?),
  NUnary(op: Str, operand: Node, pos: Int),
  NCast(Node, TyX),
  NPipe(Node, Node),
  NIs(Node, Pat),
  NCall(Node, List<Node>),
  NAwait(Node),
  NTypeApp(Node, List<TyX?>),
  NTupleIndex(Node, Lit),
  NField(Node, Nm),  // 字段名：检查器合成的 Enum.Variant 记录变体调用里是限定名
  NIndex(Node, Node),
  NTry(Node),
  NInterp(List<IPart>),
  NLambda(List<(Str, TyX?)>, Node, Str?),
  NStructLit(Nm, List<(Str, Node)>, Node?),
  NTuple(List<Node>),
  NList(List<Node>),
  NSpawn(List<Node>),
  NRace(List<Node>),
  NSelect(List<SArm>),
  NMatch(MatchD),
}

// 节点：编号、行号、种类；vis / label / attrs 是解析器在语句和声明上补的字段（Python 版的 node.pub / node.label / node.attrs）
// pre：来自 prelude 的项（Python 版的 node.prelude）
// t：检查后表达式的类型（类型化 IR，Python 版的 e._t）；检查前和检查器合成的无类型节点为 None
pub type Node = {
  id: Int,
  line: Int,
  k: K,
  vis: Vis?,
  label: Str?,
  attrs: List<Attr>?,
  pre: Bool,
  t: Ty?,
}

pub fn mkn(line: Int, k: K) -> Node {
  Node { id: -1, line: line, k: k, vis: None, label: None, attrs: None, pre: false, t: None }
}

pub fn no_gen() -> Gen { Gen { names: [], bounds: [], cgens: [] } }

pub fn kname(n: Node) -> Str {
  match n.k {
    NFn(_) => "Fn",
    NStruct(..) => "Struct",
    NAlias(..) => "Alias",
    NEnum(..) => "Enum",
    NTrait(_) => "Trait",
    NImpl(_) => "Impl",
    NUse(..) => "Use",
    NMod(..) => "Mod",
    NExtern(_) => "Extern",
    NLet(..) => "Let",
    NReturn(_) => "Return",
    NBreak(..) => "Break",
    NContinue(_) => "Continue",
    NWhile(..) => "While",
    NFor(..) => "For",
    NLoop(..) => "Loop",
    NDefer(_) => "Defer",
    NAssign(..) => "Assign",
    NExprStmt(_) => "ExprStmt",
    NBlock(..) => "Block",
    NIf(..) => "If",
    NLit(_) => "Lit",
    NName(_) => "Name",
    NBin(..) => "Bin",
    NUnary(..) => "Unary",
    NCast(..) => "Cast",
    NPipe(..) => "Pipe",
    NIs(..) => "Is",
    NCall(..) => "Call",
    NAwait(_) => "Await",
    NTypeApp(..) => "TypeApp",
    NTupleIndex(..) => "TupleIndex",
    NField(..) => "Field",
    NIndex(..) => "Index",
    NTry(_) => "Try",
    NInterp(_) => "Interp",
    NLambda(..) => "Lambda",
    NStructLit(..) => "StructLit",
    NTuple(_) => "Tuple",
    NList(_) => "List",
    NSpawn(_) => "Spawn",
    NRace(_) => "Race",
    NSelect(_) => "Select",
    NMatch(_) => "Match",
  }
}

pub fn nm_str(n: Nm) -> Str {
  match n {
    NmS(s) => s,
    NmQ(s, _) => s,
  }
}

// ── 转回动态表示 ──

pub fn lit_v(l: Lit) -> V {
  match l {
    LInt(i) => VI(i),
    LBig(t) => VBig(t),
    LFlt(f) => VF(f),
    LStr(s) => VS(s),
    LBool(b) => VB(b),
  }
}

pub fn olit_v(l: Lit?) -> V {
  match l {
    Some(x) => lit_v(x),
    None => VNil,
  }
}

pub fn nm_v(n: Nm) -> V {
  match n {
    NmS(s) => VS(s),
    NmQ(s, q) => VQ(s, q),
  }
}

pub fn ty_v(t: TyX) -> V {
  match t {
    YCon(n, a, l) => VT([VS("con"), VS(n), VL(map(a, ty_v)), VI(l)]),
    YTup(a, l) => VT([VS("tuple"), VL(map(a, ty_v)), VI(l)]),
    YDyn(bs, l) => VT([VS("dyn"), strs(bs), VI(l)]),
    YImpl(bs, l) => VT([VS("impl"), strs(bs), VI(l)]),
    YUnsafe(x, l) => VT([VS("unsafe"), ty_v(x), VI(l)]),
    YFn(a, r, l) => VT([VS("fn"), VL(map(a, ty_v)), ty_v(r), VI(l)]),
  }
}

pub fn oty_v(t: TyX?) -> V {
  match t {
    Some(x) => ty_v(x),
    None => VNil,
  }
}

pub fn pat_v(p: Pat) -> V {
  match p {
    PWild => VT([VS("wild")]),
    PBind(n) => VT([VS("bind"), nm_v(n)]),
    PVar(n) => VT([VS("bind"), nm_v(n), VB(true)]),
    PLit(l) => VT([VS("lit"), lit_v(l)]),
    PRange(lo, hi, inc) => VT([VS("range"), olit_v(lo), olit_v(hi), VB(inc)]),
    PTuple(xs) => VT([VS("tuple"), VL(map(xs, pat_v))]),
    PList(pre, rest, post) => {
      let r = opt(rest)
      if len(post) > 0 {
        VT([VS("list"), VL(map(pre, pat_v)), r, VL(map(post, pat_v))])
      } else {
        VT([VS("list"), VL(map(pre, pat_v)), r])
      }
    },
    PVariant(n, subs) => VT([VS("variant"), nm_v(n), match subs {
      Some(xs) => VL(map(xs, pat_v)),
      None => VNil,
    }]),
    PStruct(n, fs) => VT([VS("struct"), nm_v(n), VL(map(fs, (f) => VT([VS(f.0), pat_v(f.1)])))]),
    POr(xs) => VT([VS("or"), VL(map(xs, pat_v))]),
    PAt(a, b) => VT([VS("at"), pat_v(a), pat_v(b)]),
    PDots => VT([VS("dots")]),
  }
}

pub fn opat_v(p: Pat?) -> V {
  match p {
    Some(x) => pat_v(x),
    None => VNil,
  }
}

pub fn attr_v(a: Attr) -> V {
  VT([VS(a.name), VL(map(a.args, (kv) => VT([opt(kv.0), olit_v(kv.1)]))), VI(a.line)])
}

fn params_v(ps: List<(Str, TyX?)>) -> V { VL(map(ps, (pr) => VT([VS(pr.0), oty_v(pr.1)]))) }

fn bounds_v(bs: List<(Str, List<TyX>)>) -> V { VD(map(bs, (b) => (b.0, VL(map(b.1, ty_head))))) }

// 类型元组的第二项（Python 版 where / 泛型约束、impl Trait for 里取的 ty(...)[1]）
pub fn ty_head(t: TyX) -> V { items(ty_v(t))[1] }

// 约束的名字（非 con 形式的约束是 ""）
pub fn bound_name(t: TyX) -> Str { sv(ty_head(t)) }

fn aconst_v(c: AConst) -> V { VT([VS(c.name), ty_v(c.ty), onode_v(c.value), VI(c.line)]) }

pub fn onode_v(n: Node?) -> V {
  match n {
    Some(x) => to_v(x),
    None => VNil,
  }
}

fn nodes_v(xs: List<Node>) -> V { VL(map(xs, to_v)) }

fn gen_fs(g: Gen) -> List<(Str, V)> {
  [("generics", strs(g.names)), ("bounds", bounds_v(g.bounds)), ("cgens", strs(g.cgens))]
}

fn kfields(n: Node) -> List<(Str, V)> {
  match n.k {
    NFn(f) => {
      var fs = [
        ("name", VS(f.name)),
        ("params", params_v(f.params)),
        ("ret", oty_v(f.ret)),
        ("body", onode_v(f.body)),
      ]
      if f.x.bare {
        fs = fs + [("generics", strs(f.gen.names)), ("bounds", bounds_v(f.gen.bounds))]
      } else {
        fs = fs + [("is_async", VB(f.is_async)), ("is_unsafe", VB(f.is_unsafe))] + gen_fs(f.gen)
      }
      if f.varargs { fs = push(fs, ("varargs", VB(true))) }
      if let Some(ls) = f.ext { fs = push(fs, ("extern", strs(ls))) }
      if let Some(c) = f.cname { fs = push(fs, ("cname", VS(c))) }
      if let Some(so) = f.x.static_of { fs = push(fs, ("static_of", VS(so))) }
      if let Some(cn) = f.x.const_name { fs = push(fs, ("const_name", VS(cn))) }
      if let Some((ds, d)) = f.x.ext_tys {
        fs = push(fs, ("ext_tys", VT([VL(map(ds, xd_v)), xd_v(d)])))
      }
      if len(f.x.va) > 0 {
        fs = push(fs, ("_va", VL(map(f.x.va, (t) => VT([VS(t.0), strs(t.1)])))))
      }
      fs
    },
    NStruct(name, fs, g) => [("name", VS(name)), ("fields", params_v(fs))] + gen_fs(g),
    NAlias(name, t, g) => [("name", VS(name)), ("target", ty_v(t))] + gen_fs(g),
    NEnum(name, vs, g) => {
      let vv = map(vs, (v) => VT([VS(v.0), match v.1 {
        EvNone => VNil,
        EvList(l) => VL(map(l, (f) => VT([VS(f.0), ty_v(f.1)]))),
        EvRec(l) => VR(map(l, (f) => VT([VS(f.0), ty_v(f.1)]))),
      }]))
      [("name", VS(name)), ("variants", VL(vv))] + gen_fs(g)
    },
    NTrait(t) => [
      ("name", VS(t.name)),
      ("methods", nodes_v(t.methods)),
      ("assoc", VL(map(t.assoc, (a) => VT([VS(a.name), strs(a.bounds), oty_v(a.dflt)])))),
      ("supers", strs(t.supers)),
      ("consts", VL(map(t.consts, aconst_v))),
    ],
    NImpl(d) => [
      ("trait", match d.tr {
        Some(t) => ty_head(t),
        None => VNil,
      }),
      ("target", VS(d.target)),
      ("target_t", ty_v(d.target_t)),
      ("methods", nodes_v(d.methods)),
      ("assoc", VL(map(d.assoc, (a) => VT([VS(a.0), ty_v(a.1)])))),
      ("consts", VL(map(d.consts, aconst_v))),
    ] + gen_fs(d.gen),
    NUse(path, alias) => [
      ("path", VL(map(path, (u) => match u {
        UName(s) => VS(s),
        UGroup(g) => VL(map(g, (e) => match e.1 {
          Some(a) => VT([VS(e.0), VS(a)]),
          None => VS(e.0),
        })),
      }))),
      ("alias", opt(alias)),
    ],
    NMod(name, its) => [("name", opt(name)), ("items", match its {
      Some(xs) => nodes_v(xs),
      None => VNil,
    })],
    NExtern(fs) => [("fns", nodes_v(fs))],
    NLet(pat, mutable, t, value, is_const) => {
      let fs = [
        ("pat", pat_v(pat)),
        ("mutable", VB(mutable)),
        ("ty", oty_v(t)),
        ("value", to_v(value)),
      ]
      if is_const { push(fs, ("is_const", VB(true))) } else { fs }
    },
    NReturn(v) => [("value", onode_v(v))],
    NBreak(l, v, bare) => if bare { [] } else { [("label", opt(l)), ("value", onode_v(v))] },
    NContinue(l) => [("label", opt(l)), ("value", VNil)],
    NWhile(c, b) => [("cond", onode_v(c)), ("body", to_v(b))],
    NFor(p, it, b) => [("pat", pat_v(p)), ("iter", to_v(it)), ("body", to_v(b))],
    NLoop(b, l) => [("body", to_v(b)), ("label", opt(l))],
    NDefer(b) => [("body", to_v(b))],
    NAssign(t, op, v) => [("target", to_v(t)), ("op", VS(op)), ("value", to_v(v))],
    NExprStmt(e) => [("expr", to_v(e))],
    NBlock(ss, u) => if u {
      [("stmts", nodes_v(ss)), ("unsafe", VB(true))]
    } else {
      [("stmts", nodes_v(ss))]
    },
    NIf(c, t, e) => [("cond", to_v(c)), ("then", to_v(t)), ("els", onode_v(e))],
    NLit(l) => [("value", lit_v(l))],
    NName(s) => [("name", VS(s))],
    NBin(op, l, r) => [("op", VS(op)), ("left", to_v(l)), ("right", onode_v(r))],
    NUnary(op, x, pos) => [("op", VS(op)), ("operand", to_v(x)), ("pos", VI(pos))],
    NCast(v, t) => [("value", to_v(v)), ("ty", ty_v(t))],
    NPipe(l, r) => [("left", to_v(l)), ("right", to_v(r))],
    NIs(v, p) => [("value", to_v(v)), ("pat", pat_v(p))],
    NCall(f, a) => [("fn", to_v(f)), ("args", nodes_v(a))],
    NAwait(v) => [("value", to_v(v))],
    NTypeApp(f, ts) => [("fn", to_v(f)), ("targs", VL(map(ts, oty_v)))],
    NTupleIndex(o, i) => [("obj", to_v(o)), ("index", lit_v(i))],
    NField(o, s) => [("obj", to_v(o)), ("name", nm_v(s))],
    NIndex(o, i) => [("obj", to_v(o)), ("index", to_v(i))],
    NTry(v) => [("value", to_v(v))],
    NInterp(ps) => [("parts", VL(map(ps, (x) => match x {
      IStr(s) => VS(s),
      IExpr(e) => to_v(e),
    })))],
    NLambda(ps, b, ctx) => {
      let fs = [("params", params_v(ps)), ("body", to_v(b))]
      match ctx {
        Some(c) => push(fs, ("ctx", VS(c))),
        None => fs,
      }
    },
    NStructLit(name, fs, base) => [
      ("name", nm_v(name)),
      ("fields", VL(map(fs, (f) => VT([VS(f.0), to_v(f.1)])))),
      ("base", onode_v(base)),
    ],
    NTuple(xs) => [("items", nodes_v(xs))],
    NList(xs) => [("items", nodes_v(xs))],
    NSpawn(xs) => [("items", nodes_v(xs))],
    NRace(xs) => [("items", nodes_v(xs))],
    NSelect(arms) => [("arms", VL(map(arms, (a) => VT([
      VS(a.kind),
      onode_v(a.a),
      onode_v(a.b),
      opat_v(a.pat),
      onode_v(a.guard),
      to_v(a.body),
    ]))))],
    NMatch(m) => {
      var fs = [("subject", to_v(m.subject)), ("arms", VL(map(m.arms, (a) => VT([
        pat_v(a.pat),
        onode_v(a.guard),
        to_v(a.body),
      ]))))]
      if let Some(ic) = m.is_conj { fs = push(fs, ("is_conj", VT([to_v(ic.0), to_v(ic.1)]))) }
      if let Some(le) = m.let_else { fs = push(fs, ("let_else", to_v(le))) }
      fs
    },
  }
}

pub fn to_v(n: Node) -> V {
  var fs = kfields(n)
  if let Some(v) = n.vis {
    fs = push(fs, ("pub", VB(v.is_pub)))
    if v.has_vis { fs = push(fs, ("vis", opt(v.vis))) }
  }
  if let Some(l) = n.label { fs = push(fs, ("label", VS(l))) }
  if let Some(a) = n.attrs { fs = push(fs, ("attrs", VL(map(a, attr_v)))) }
  if n.pre { fs = push(fs, ("prelude", VB(true))) }
  if n.id >= 0 { fs = push(fs, ("_id", VI(n.id))) }
  nd(kname(n), n.line, fs)
}

pub fn xd_v(d: XD) -> V {
  match d {
    XdH(h) => VS(h),
    XdS(h, fs) => VT([VS("S"), VS(h), VT(map(fs, (f) => VT([VS(f.0), xd_v(f.1)])))]),
    XdF(ps, r) => VT([VS("F"), VT(map(ps, (a) => VS(a))), VS(r)]),
  }
}

// ── 子节点：按字段顺序（和 to_v 的字段顺序一致）列出 / 替换直接子节点 ──
// 泛型遍历（改名、提升、编号、改写）都用这一对函数

fn on(x: Node?) -> List<Node> {
  match x {
    Some(n) => [n],
    None => [],
  }
}

pub fn kids(n: Node) -> List<Node> {
  match n.k {
    NFn(f) => on(f.body),
    NTrait(t) => t.methods + flat(map(t.consts, (c) => on(c.value))),
    NImpl(d) => d.methods + flat(map(d.consts, (c) => on(c.value))),
    NMod(_, its) => unwrap_or(its, []),
    NExtern(fs) => fs,
    NLet(_, _, _, v, _) => [v],
    NReturn(v) => on(v),
    NBreak(_, v, _) => on(v),
    NWhile(c, b) => on(c) + [b],
    NFor(_, it, b) => [it, b],
    NLoop(b, _) => [b],
    NDefer(b) => [b],
    NAssign(t, _, v) => [t, v],
    NExprStmt(e) => [e],
    NBlock(ss, _) => ss,
    NIf(c, t, e) => [c, t] + on(e),
    NBin(_, l, r) => [l] + on(r),
    NUnary(_, x, _) => [x],
    NCast(v, _) => [v],
    NPipe(l, r) => [l, r],
    NIs(v, _) => [v],
    NCall(f, a) => [f] + a,
    NAwait(v) => [v],
    NTypeApp(f, _) => [f],
    NTupleIndex(o, _) => [o],
    NField(o, _) => [o],
    NIndex(o, i) => [o, i],
    NTry(v) => [v],
    NInterp(ps) => flat(map(ps, (p) => match p {
      IExpr(e) => [e],
      IStr(_) => [],
    })),
    NLambda(_, b, _) => [b],
    NStructLit(_, fs, b) => map(fs, (f) => f.1) + on(b),
    NTuple(xs) => xs,
    NList(xs) => xs,
    NSpawn(xs) => xs,
    NRace(xs) => xs,
    NSelect(arms) => flat(map(arms, (a) => on(a.a) + on(a.b) + on(a.guard) + [a.body])),
    NMatch(m) => {
      var out = [m.subject] + flat(map(m.arms, (a) => on(a.guard) + [a.body]))
      if let Some(ic) = m.is_conj { out = out + [ic.0, ic.1] }
      out + on(m.let_else)
    },
    _ => [],
  }
}

fn flat(xss: List<List<Node>>) -> List<Node> {
  var out: List<Node> = []
  for xs in xss { out = out + xs }
  out
}

// 游标：依次取出替换用的子节点
type Cur = { ks: List<Node>, i: Int }

fn nx(c: Cur) -> (Cur, Node) { (Cur { i: c.i + 1, ..c }, c.ks[c.i]) }

fn nxo(c: Cur, x: Node?) -> (Cur, Node?) {
  match x {
    Some(_) => {
      let (c1, y) = nx(c)
      (c1, Some(y))
    },
    None => (c, None),
  }
}

fn nxs(c0: Cur, xs: List<Node>) -> (Cur, List<Node>) {
  let n = len(xs)
  (Cur { i: c0.i + n, ..c0 }, take(skip(c0.ks, c0.i), n))
}

fn nx_consts(c0: Cur, cs: List<AConst>) -> (Cur, List<AConst>) {
  var c = c0
  var out: List<AConst> = []
  for x in cs {
    let (c1, v) = nxo(c, x.value)
    c = c1
    out = push(out, AConst { value: v, ..x })
  }
  (c, out)
}

pub fn with_kids(n: Node, ks: List<Node>) -> Node {
  let c = Cur { ks: ks, i: 0 }
  let k2 = match n.k {
    NFn(f) => NFn(FnD { body: nxo(c, f.body).1, ..f }),
    NTrait(t) => {
      let (c1, ms) = nxs(c, t.methods)
      NTrait(TraitD { methods: ms, consts: nx_consts(c1, t.consts).1, ..t })
    },
    NImpl(d) => {
      let (c1, ms) = nxs(c, d.methods)
      NImpl(ImplD { methods: ms, consts: nx_consts(c1, d.consts).1, ..d })
    },
    NMod(nm, its) => NMod(nm, match its {
      Some(xs) => Some(nxs(c, xs).1),
      None => None,
    }),
    NExtern(fs) => NExtern(nxs(c, fs).1),
    NLet(p, m, t, _, ic) => NLet(p, m, t, ks[0], ic),
    NReturn(v) => NReturn(nxo(c, v).1),
    NBreak(l, v, b) => NBreak(l, nxo(c, v).1, b),
    NWhile(cd, _) => {
      let (c1, cd2) = nxo(c, cd)
      NWhile(cd2, nx(c1).1)
    },
    NFor(p, _, _) => NFor(p, ks[0], ks[1]),
    NLoop(_, l) => NLoop(ks[0], l),
    NDefer(_) => NDefer(ks[0]),
    NAssign(_, op, _) => NAssign(ks[0], op, ks[1]),
    NExprStmt(_) => NExprStmt(ks[0]),
    NBlock(_, u) => NBlock(ks, u),
    NIf(_, _, e) => NIf(ks[0], ks[1], nxo(Cur { i: 2, ..c }, e).1),
    NBin(op, _, r) => NBin(op, ks[0], nxo(Cur { i: 1, ..c }, r).1),
    NUnary(op, _, pos) => NUnary(op, ks[0], pos),
    NCast(_, t) => NCast(ks[0], t),
    NPipe(_, _) => NPipe(ks[0], ks[1]),
    NIs(_, p) => NIs(ks[0], p),
    NCall(_, _) => NCall(ks[0], skip(ks, 1)),
    NAwait(_) => NAwait(ks[0]),
    NTypeApp(_, ts) => NTypeApp(ks[0], ts),
    NTupleIndex(_, i) => NTupleIndex(ks[0], i),
    NField(_, s) => NField(ks[0], s),
    NIndex(_, _) => NIndex(ks[0], ks[1]),
    NTry(_) => NTry(ks[0]),
    NInterp(ps) => {
      var cc = c
      var out: List<IPart> = []
      for p in ps {
        match p {
          IExpr(_) => {
            let (c1, e) = nx(cc)
            cc = c1
            out = push(out, IExpr(e))
          },
          IStr(_) => { out = push(out, p) },
        }
      }
      NInterp(out)
    },
    NLambda(ps, _, ctx) => NLambda(ps, ks[0], ctx),
    NStructLit(nm, fs, b) => {
      var cc = c
      var out: List<(Str, Node)> = []
      for f in fs {
        let (c1, e) = nx(cc)
        cc = c1
        out = push(out, (f.0, e))
      }
      NStructLit(nm, out, nxo(cc, b).1)
    },
    NTuple(_) => NTuple(ks),
    NList(_) => NList(ks),
    NSpawn(_) => NSpawn(ks),
    NRace(_) => NRace(ks),
    NSelect(arms) => {
      var cc = c
      var out: List<SArm> = []
      for a in arms {
        let (c1, x) = nxo(cc, a.a)
        let (c2, y) = nxo(c1, a.b)
        let (c3, g) = nxo(c2, a.guard)
        let (c4, b) = nx(c3)
        cc = c4
        out = push(out, SArm { a: x, b: y, guard: g, body: b, ..a })
      }
      NSelect(out)
    },
    NMatch(m) => {
      let (c0, subj) = nx(c)
      var cc = c0
      var arms: List<Arm> = []
      for a in m.arms {
        let (c1, g) = nxo(cc, a.guard)
        let (c2, b) = nx(c1)
        cc = c2
        arms = push(arms, Arm { guard: g, body: b, ..a })
      }
      var ic: (Node, Node)? = None
      if let Some(_) = m.is_conj {
        let (c3, a) = nx(cc)
        let (c4, b) = nx(c3)
        cc = c4
        ic = Some((a, b))
      }
      NMatch(MatchD { subject: subj, arms: arms, is_conj: ic, let_else: nxo(cc, m.let_else).1 })
    },
    _ => n.k,
  }
  Node { k: k2, ..n }
}

// 节点按 tools/ast_dump.py 的格式输出
pub fn dump(n: Node) -> Str { val.dump(to_v(n)) }
