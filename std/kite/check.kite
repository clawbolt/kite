// Kite 自举编译器：类型检查（对应 typecheck.py 的 Checker，逐条移植，报错文字相同）
// 检查器状态 C 按值传递；会出错的函数返回 Result<(C, 结果), F>，F 里带着出错时的状态（Python 版出错前的修改会保留）
// 检查函数直接返回类型化 IR（改写后的节点，表达式带 Node.t）；只有求解后才能定的改动按 Node.id 记成补丁（Pt），最后套上
use std.kite.ast as ast
use std.kite.val as val
use std.kite.ast.{
  Node,
  K,
  Lit,
  Nm,
  TyX,
  Pat,
  Attr,
  Vis,
  EvF,
  UseP,
  IPart,
  AConst,
  TAssoc,
  Arm,
  SArm,
  Gen,
  FnD,
  FnX,
  XD,
  ImplD,
  TraitD,
  MatchD,
  kname,
}
use std.kite.ty as tys
use std.kite.ty.{ Ty, tcon, fn_t, list_t, tname, targs, is_tv, is_tr, is_tg, is_con }
use std.kite.parser as parser
use std.kite.builtins as builtins
use std.kite.scanner.{ repr_str }
pub enum FT {
  FTy(Ty),
  FVar,
  FDict(List<(Str, Str)>),
}

// ext："extern 函数|名字" / "unsafe 函数|名字"（使用处必须在 unsafe 里）；va：可变参数 extern
pub type Ent = {
  t: FT,
  mt: Bool,
  sch: Bool,
  bi: Bool,
  gens: List<Str>,
  ext: Str,
  va: Bool,
  cga: List<Str>,
  dep: Str,
}

pub enum Sc {
  STop,
  SFr(Map<Str, Ent>, Bool, Sc),
}

pub enum Kd {
  KNum,
  KAdd,
  KOrd,
  KImpl(Str),
  KVar(Str, List<Str>),
}

// 隐藏实参的待求解值：常量泛型参数是类型变量；T.N 是 (T 的类型变量, N)
pub enum CgV {
  CgT(Ty),
  CgTc(Ty, Str),
}

pub enum Arg {
  AN(Node),
  AT(Ty, Int, Node?),
}

// 类型求解之后才能确定的改动（按 Node.id 记，检查结束后套到类型化 IR 上）：
// impl 补全的约束、extern 的 C 类型描述、常量泛型的隐藏实参 / 隐藏参数、sort / min / max 换成比较函数版
pub enum Pt {
  PtBounds(List<(Str, List<TyX>)>),
  PtExt((List<XD>, XD)),
  PtArgs(List<Node>),
  PtParams(List<(Str, TyX?)>),
  PtName(Str),
}

pub type C = {
  sub: Map<Int, Ty>,
  nv: Int,
  g: Map<Str, Ent>,
  structs: Map<Str, (List<Str>, List<(Str, TyX?)>)>,
  enums: Map<Str, (List<Str>, List<(Str, EvF)>)>,
  variant_owner: Map<Str, Str>,
  variant_alts: Map<Str, List<Str>>,
  aliases: Map<Str, (List<Str>, TyX)>,
  traits: Map<Str, List<Node>>,
  supers: Map<Str, List<Str>>,
  type_bounds: Map<Str, List<(Str, List<Str>)>>,
  methods: Map<Str, Map<Str, (Ty, Bool)>>,
  impls: Map<Str, Bool>,
  errors: List<(Int, Str)>,
  cons: List<(Ty, Kd, Int)>,
  ord_sites: List<(Str, Ty, Int, Int, Node)>,
  ret: List<Ty>,
  loop_depth: Int,
  labels: List<(Str?, Ty?, Bool)>,
  rigid: List<Map<Str, Ty>>,
  const_lits: Map<Str, Lit>,
  sigs: Map<Str, Ty>,
  fsigs: Map<Str, Ty>,
  msigs: Map<Str, Ty>,
  impl_info: Map<Str, (Ty, List<Node>)>,
  unsafe_d: Int,
  va_ok: Bool,
  vav: List<(Str, Str, List<Str>)>,
  umeth: Map<Str, Bool>,
  tcg: Map<Str, List<Str>>,
  tc_info: Map<Str, (Str, Str, TyX)>,
  tconsts: Map<Str, List<(Str, TyX)>>,
  fcga: Map<Str, List<Str>>,
  mcga: Map<Str, List<Str>>,
  pend: List<CgV>,
  cg_node: Node?,
  cg_fns: Map<Int, (Node, List<Str>)>,
  cg_sites: List<(List<CgV>, List<Str>, Int, Str, Node?)>,
  cg_ctx: List<List<Str>>,
  trait_assoc: Map<Str, List<(Str, List<Str>, TyX?)>>,
  impl_assoc: Map<Str, (Node, TyX)>,
  deferred: List<(Ty, Ty, Int, Str)>,
  patch: Map<Int, List<Pt>>,
  dflt: Map<Str, Node>,
  idn: Int,
  upd_n: Int,
  in_pre: Bool,
  warns: List<(Int, Str)>,
  locs: List<(Int, Str, Ty, Str)>,
}

pub type F = { c: C, ln: Int, msg: Str }

// ───────── 常量表 ─────────

fn int_t() -> Ty { tcon("Int") }

fn float_t() -> Ty { tcon("Float") }

fn str_t() -> Ty { tcon("Str") }

fn bool_t() -> Ty { tcon("Bool") }

fn unit_t() -> Ty { tcon("Unit") }

fn any_t() -> Ty { tcon("Any") }

fn never_t() -> Ty { tcon("Never") }

fn prim(n: Str) -> Ty? {
  if contains(["Int", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64"], n) {
    return Some(int_t())
  }
  if contains(["Float", "F32", "F64"], n) { return Some(float_t()) }
  if n == "Str" || n == "Char" { return Some(str_t()) }
  if contains(["Bool", "Unit", "Bytes", "Ptr", "Any", "Never"], n) { return Some(tcon(n)) }
  None
}

fn builtin_generic(n: Str) -> Int {
  if contains(["List", "Set", "Option", "Chan", "Actor"], n) { return 1 }
  if n == "Map" || n == "Result" { return 2 }
  -1
}

fn builtin_traits() -> List<Str> { ["Eq", "Ord", "Show", "Num", "Hash"] }

fn builtin_impls(tr: Str) -> List<Str> {
  if tr == "Num" { return ["Int", "Float"] }
  if tr == "Ord" { return ["Int", "Float", "Str"] }
  if tr == "Eq" {
    return [
      "Int", "Float", "Str", "Bool", "Unit", "List", "Tuple", "Option", "Result", "Map", "Set",
    ]
  }
  if tr == "Hash" { return ["Int", "Str", "Bool", "Tuple"] }
  []
}

fn implied(b: Str) -> List<Str> {
  if b == "Ord" { return ["Eq"] }
  if b == "Num" { return ["Ord", "Eq"] }
  []
}

fn op_method(op: Str) -> Str {
  if op == "+" { return "add" }
  if op == "-" { return "sub" }
  if op == "*" { return "mul" }
  if op == "/" { return "div" }
  if op == "%" { return "rem" }
  if contains(["<", ">", "<=", ">="], op) { return "cmp" }
  ""
}

fn op_trait(op: Str) -> Str {
  if op == "+" { return "Add" }
  if op == "-" { return "Sub" }
  if op == "*" { return "Mul" }
  if op == "/" { return "Div" }
  if op == "%" { return "Rem" }
  if op == "neg" { return "Neg" }
  if contains(["<", ">", "<=", ">="], op) { return "Cmp" }
  ""
}

fn unsafe_ptr(n: Str) -> Bool {
  contains(
    [
      "from_addr",
      "alloc",
      "free",
      "read_int",
      "write_int",
      "read_float",
      "write_float",
      "read_byte",
      "write_byte",
      "to_str",
      "from_str",
    ],
    n,
  )
}

fn std_mod(m: Str) -> List<(Str, Str, List<(Str, Str)>)>? {
  for (n, tbl) in builtins.std_sigs() { if n == m { return Some(tbl) } }
  None
}

fn std_member(m: Str, nm: Str) -> (Str, List<(Str, Str)>)? {
  match std_mod(m) {
    Some(tbl) => {
      for (n, k, s) in tbl { if n == nm { return Some((k, s)) } }
      None
    },
    None => None,
  }
}

// ───────── 小工具 ─────────

pub fn new_c() -> C {
  C {
    patch: Map(),
    dflt: Map(),
    idn: 0,
    upd_n: 0,
    in_pre: false,
    warns: [],
    locs: [],
    sub: Map(),
    nv: 0,
    g: Map(),
    structs: Map(),
    enums: Map(),
    variant_owner: Map(),
    variant_alts: Map(),
    aliases: Map(),
    traits: Map(),
    supers: Map(),
    type_bounds: Map(),
    methods: Map(),
    impls: Map(),
    errors: [],
    cons: [],
    ord_sites: [],
    ret: [],
    loop_depth: 0,
    labels: [],
    rigid: [],
    const_lits: Map(),
    sigs: Map(),
    fsigs: Map(),
    msigs: Map(),
    impl_info: Map(),
    unsafe_d: 0,
    va_ok: false,
    vav: [],
    umeth: Map(),
    tcg: Map(),
    tc_info: Map(),
    tconsts: Map(),
    fcga: Map(),
    mcga: Map(),
    pend: [],
    cg_node: None,
    cg_fns: Map(),
    cg_sites: [],
    cg_ctx: [],
    trait_assoc: Map(),
    impl_assoc: Map(),
    deferred: [],
  }
}

fn te(c: C, ln: Int, msg: Str) -> F { F { c: c, ln: ln, msg: "类型错误: " + msg } }

fn unsup(c: C, what: Str) -> F { F { c: c, ln: -1, msg: "kitec 未支持: " + what } }

fn is_unsup(f: F) -> Bool { f.ln == -1 }

// prune + 关联类型投影规约（Python 版 prune 的完整行为），KIR 用
pub fn prn(c: C, t: Ty) -> Ty { pr(c, t) }

fn pr(c: C, t: Ty) -> Ty {
  let p = tys.prune(c.sub, t)
  match p {
    TC(n, a) => if starts(n, "@") && len(a) == 1 { norm_proj(c, p) } else { p },
    _ => p,
  }
}

fn is_proj(t: Ty) -> Bool {
  match t {
    TC(n, a) => starts(n, "@") && len(a) == 1,
    _ => false,
  }
}

fn assoc_owner(c: C, bounds: List<Str>, item: Str) -> Str? {
  for b in closure(c, bounds) {
    for (an, _, _) in unwrap_or(get(c.trait_assoc, b), []) { if an == item { return Some(b) } }
  }
  None
}

// 关联类型投影 T.Item 的规约（Python 版 norm_proj，在 prune 里调用）
fn norm_proj(c: C, t: Ty) -> Ty {
  let item = __str_slice(tname(t), 1, len(tname(t)))
  let base = pr(c, targs(t)[0])
  match base {
    TR(bn, bbs) => match assoc_owner(c, bbs, item) {
      None => t,
      Some(tr) => {
        var bs: List<Str> = []
        for (an, abs, _) in unwrap_or(get(c.trait_assoc, tr), []) { if an == item { bs = abs } }
        TR(bn + "." + item, bs)
      },
    },
    TC(bn, bargs) => {
      if starts(bn, "@") { return t }
      if bn == "Any" || bn == "Never" { return any_t() }
      match get(c.impl_assoc, bn + "|" + item) {
        None => t,
        Some((it, ta)) => {
          let d = implv(it)
          let gens = d.gen.names
          var gm: Map<Str, Ty> = Map()
          if let YCon(_, targs0, _) = d.target_t {
            var i = 0
            for a in targs0 {
              if let YCon(an, aa, _) = a {
                if i < len(bargs) && contains(gens, an) && len(aa) == 0 {
                  gm = set(gm, an, bargs[i])
                }
              }
              i += 1
            }
          }
          for g in gens { if !contains(gm, g) { return t } }
          gm = set(gm, "Self", base)
          match conv(c, Some(ta), gm, false) {
            Ok((_, r)) => pr(c, r),
            Err(_) => t,
          }
        },
      }
    },
    _ => t,
  }
}

// 显示前把投影都规约掉
fn deepnorm(c: C, t: Ty) -> Ty {
  let p = pr(c, t)
  match p {
    TC(n, a) => TC(n, map(a, (x) => deepnorm(c, x))),
    _ => p,
  }
}

fn sh(c: C, t: Ty) -> Str { tys.show(c.sub, deepnorm(c, t)) }

fn pre(ctx: Str) -> Str { if ctx == "" { "" } else { ctx + "：" } }

fn fresh(c: C) -> (C, Ty) { (C { nv: c.nv + 1, ..c }, TV(c.nv)) }

fn fresh_n(c0: C, n: Int) -> (C, List<Ty>) {
  var c = c0
  var out: List<Ty> = []
  var i = 0
  while i < n {
    let (c1, v) = fresh(c)
    c = c1
    out = push(out, v)
    i += 1
  }
  (c, out)
}

fn add_err(c: C, f: F) -> C { C { errors: push(f.c.errors, (f.ln, f.msg)), ..f.c } }

fn add_con(c: C, t: Ty, k: Kd, ln: Int) -> C { C { cons: push(c.cons, (t, k, ln)), ..c } }

fn is_dyn(t: Ty) -> Bool {
  match t {
    TR(n, _) => starts(n, "dyn "),
    _ => false,
  }
}

fn head(c: C, t: Ty) -> Str {
  let p = pr(c, t)
  if is_con(p) && tname(p) == "Array" && len(targs(p)) == 2 { return "List" }
  tname(p)
}

fn ent(t: Ty, mt: Bool, sch: Bool) -> Ent {
  Ent { t: FTy(t), mt: mt, sch: sch, bi: false, gens: [], ext: "", va: false, cga: [], dep: "" }
}

fn sc_find(c: C, sc: Sc, n: Str) -> Ent? {
  match sc {
    STop => get(c.g, n),
    SFr(m, _, p) => match get(m, n) {
      Some(e) => Some(e),
      None => sc_find(c, p, n),
    },
  }
}

fn is_local(sc: Sc, n: Str) -> Bool {
  match sc {
    STop => false,
    SFr(m, _, p) => contains(m, n) || is_local(p, n),
  }
}

fn define(c: C, sc: Sc, n: Str, e: Ent) -> (C, Sc) {
  match sc {
    STop => (C { g: set(c.g, n, e), ..c }, sc),
    SFr(m, tk, p) => (c, SFr(set(m, n, e), tk, p)),
  }
}

fn frame(sc: Sc) -> Sc { SFr(Map(), false, sc) }

fn task_frame(sc: Sc) -> Sc { SFr(Map(), true, sc) }

fn task_between(sc: Sc, n: Str) -> Bool {
  match sc {
    STop => false,
    SFr(m, tk, p) => if contains(m, n) { false } else { tk || task_between(p, n) },
  }
}

fn spawn_t() -> Ty { TC("@spawn", []) }

fn is_spawn(t: Ty) -> Bool { tname(t) == "@spawn" }

fn frame_vars(sc: Sc) -> Map<Str, Ent> {
  match sc {
    SFr(m, _, _) => m,
    STop => Map(),
  }
}

fn bget(bs: List<(Str, List<Str>)>, g: Str) -> List<Str> {
  for (k, v) in bs { if k == g { return v } }
  []
}

// 泛型约束：按名字（Python 版存的是类型元组的第二项）
fn bounds_of(g: Gen) -> List<(Str, List<Str>)> {
  map(g.bounds, (kv) => (kv.0, map(kv.1, ast.bound_name)))
}

// ── 节点访问 ──

fn empty_fn() -> FnD {
  FnD {
    name: "",
    params: [],
    ret: None,
    body: None,
    gen: ast.no_gen(),
    is_async: false,
    is_unsafe: false,
    varargs: false,
    ext: None,
    cname: None,
    x: ast.no_fnx(),
  }
}

pub fn fnd(n: Node) -> FnD {
  match n.k {
    NFn(f) => f,
    _ => empty_fn(),
  }
}

pub fn implv(n: Node) -> ImplD {
  match n.k {
    NImpl(d) => d,
    _ => ImplD {
      tr: None,
      target: "",
      target_t: YTup([], 0),
      methods: [],
      gen: ast.no_gen(),
      assoc: [],
      consts: [],
    },
  }
}

fn traitv(n: Node) -> TraitD {
  match n.k {
    NTrait(t) => t,
    _ => TraitD { name: "", methods: [], assoc: [], supers: [], consts: [] },
  }
}

fn with_fnd(n: Node, f: FnD) -> Node { Node { k: NFn(f), ..n } }

// 声明的名字（Python 版的 node.name）
fn nname(n: Node) -> Str {
  match n.k {
    NFn(f) => f.name,
    NStruct(m, _, _) => m,
    NEnum(m, _, _) => m,
    NTrait(t) => t.name,
    NAlias(m, _, _) => m,
    NMod(m, _) => unwrap_or(m, ""),
    NName(s) => s,
    NField(_, s) => ast.nm_str(s),
    _ => "",
  }
}

fn name_of(n: Node) -> Str? {
  match n.k {
    NName(s) => Some(s),
    _ => None,
  }
}

fn is_k(n: Node, k: Str) -> Bool { kname(n) == k }

// impl 的 trait 名（Python 版 impl.trait，取类型元组的第二项）
fn trait_name(d: ImplD) -> Str? {
  match d.tr {
    Some(t) => Some(ast.bound_name(t)),
    None => None,
  }
}

fn gen_of(n: Node) -> Gen {
  match n.k {
    NFn(f) => f.gen,
    NStruct(_, _, g) => g,
    NEnum(_, _, g) => g,
    NAlias(_, _, g) => g,
    NImpl(d) => d.gen,
    _ => ast.no_gen(),
  }
}

fn ev_fields(e: EvF) -> List<(Str, TyX)> {
  match e {
    EvList(l) => l,
    EvRec(l) => l,
    EvNone => [],
  }
}

fn vf_fields(o: EvF?) -> List<(Str, TyX)> {
  match o {
    Some(e) => ev_fields(e),
    None => [],
  }
}

// 变体没有字段（或不存在）：Python 版的 fields is None
fn vf_nil(o: EvF?) -> Bool {
  match o {
    Some(EvNone) => true,
    None => true,
    _ => false,
  }
}

fn tbounds(c: C, n: Str) -> List<(Str, List<Str>)> { unwrap_or(get(c.type_bounds, n), []) }

fn first_upper(s: Str) -> Bool {
  if len(s) == 0 { return false }
  let o = __ord(__str_slice(s, 0, 1))
  o >= 65 && o <= 90
}

fn starts(s: Str, p: Str) -> Bool { starts_with(s, p) }

fn has_self(m: Node) -> Bool {
  let ps = fnd(m).params
  len(ps) > 0 && ps[0].0 == "self"
}

fn fkey(fnode: Node) -> Str { fnd(fnode).name + "@" + "{fnode.line}" }

fn gens_of(c: C, n: Str) -> List<Str> {
  match get(c.structs, n) {
    Some(s) => s.0,
    None => match get(c.enums, n) {
      Some(e) => e.0,
      None => [],
    },
  }
}

fn variant_fs(c: C, en: Str, vn: Str) -> EvF? {
  match get(c.enums, en) {
    Some((_, vs)) => {
      for v in vs { if v.0 == vn { return Some(v.1) } }
      None
    },
    None => None,
  }
}

fn has_variant(c: C, en: Str, vn: Str) -> Bool {
  match variant_fs(c, en, vn) {
    Some(_) => true,
    None => false,
  }
}

fn closure(c: C, bounds: List<Str>) -> List<Str> {
  var out: List<Str> = []
  for b in bounds { out = clo_add(c, b, out) }
  out
}

fn clo_add(c: C, b: Str, out0: List<Str>) -> List<Str> {
  if contains(out0, b) { return out0 }
  var out = push(out0, b)
  for s in unwrap_or(get(c.supers, b), []) { out = clo_add(c, s, out) }
  out
}

fn has_bound(c: C, bounds: List<Str>, tr: Str) -> Bool {
  let bs = closure(c, bounds)
  if contains(bs, tr) { return true }
  any(bs, (b) => contains(implied(b), tr))
}

fn known_trait(c: C, b: Str) -> Bool { contains(builtin_traits(), b) || contains(c.traits, b) }

fn implements(c: C, t0: Ty, tr: Str) -> Bool {
  let t = pr(c, t0)
  match t {
    TV(_) => true,
    TG(_, _) => true,
    TR(_, bs) => has_bound(c, bs, tr),
    TC(n, _) => {
      if tr == "Show" || n == "Any" || n == "Never" { return true }
      if contains(builtin_impls(tr), n) { return true }
      contains(c.impls, n + "|" + tr)
    },
  }
}

fn inst(c0: C, t: Ty, ln: Int) -> (C, Ty) { inst_cg(c0, t, ln, []) }

fn cg_vals(c0: C, cga: List<Str>, m: Map<Str, Ty>) -> (C, List<CgV>) {
  var c = c0
  var out: List<CgV> = []
  for n in cga {
    match get(c.tc_info, n) {
      Some((tn, cn, _)) => {
        let v = match get(m, tn) {
          Some(x) => x,
          None => {
            let (c1, x) = fresh(c)
            c = c1
            x
          },
        }
        out = push(out, CgTc(v, cn))
      },
      None => {
        let v = match get(m, n) {
          Some(x) => x,
          None => {
            let (c1, x) = fresh(c)
            c = c1
            x
          },
        }
        out = push(out, CgT(v))
      },
    }
  }
  (c, out)
}

fn inst_cg(c0: C, t: Ty, ln: Int, cga: List<Str>) -> (C, Ty) {
  let objs = tys.gen_objs(c0.sub, t)
  if len(objs) == 0 {
    if len(cga) > 0 {
      let (c1, vs) = cg_vals(c0, cga, Map())
      return (C { pend: vs, ..c1 }, t)
    }
    return (c0, t)
  }
  var c = c0
  var m: Map<Str, Ty> = Map()
  for (n, bs) in objs {
    let (c1, v) = fresh(c)
    c = c1
    m = set(m, n, v)
    for b in bs { c = add_con(c, v, KImpl(b), ln) }
  }
  if len(cga) > 0 {
    let (c2, vs) = cg_vals(c, cga, m)
    c = C { pend: vs, ..c2 }
  }
  (c, tys.subst(c.sub, t, m))
}

// 调用了带常量泛型参数的函数：记下调用点，类型求解后检查隐藏实参
// 调用了带常量泛型参数的函数：记下调用点，类型求解后检查隐藏实参
fn take_cg(c0: C, node: Node?, name: Str, ln: Int) -> Result<C, F> {
  let vals = c0.pend
  let c = C { pend: [], ..c0 }
  if len(vals) == 0 { return Ok(c) }
  if is_none(node) { return Err(te(c, ln, "{name} 带常量泛型参数，这里请写成调用形式 {name}(…)")) }
  let ctx = if len(c.cg_ctx) > 0 { c.cg_ctx[len(c.cg_ctx) - 1] } else { [] }
  Ok(C { cg_sites: push(c.cg_sites, (vals, ctx, ln, name, node)), ..c })
}

fn name_n(ln: Int, s: Str) -> Node { ast.mkn(ln, NName(s)) }

fn lit_n(ln: Int, l: Lit) -> Node { ast.mkn(ln, NLit(l)) }

fn call_n(ln: Int, f: Node, args: List<Node>) -> Node { ast.mkn(ln, NCall(f, args)) }

fn solve_cg_sites(c0: C) -> C {
  var c = c0
  let bad = map(c0.errors, (e) => e.0)
  for (vals, ctx, ln, name, node0) in c0.cg_sites {
    if contains(bad, ln) { continue }
    let node = unwrap(node0)
    var extra: List<Node> = []
    var failed = false
    for v in vals {
      match v {
        CgTc(tv, cn) => {
          let p = pr(c, tv)
          var a: Node? = None
          match p {
            TR(pn, _) => {
              if contains(ctx, "__tc_{pn}_{cn}") { a = Some(name_n(ln, "__tc_{pn}_{cn}")) }
            },
            TC(pn, _) => { a = Some(call_n(ln, name_n(ln, pn + "." + cn), [])) },
            _ => {},
          }
          if is_none(a) {
            c = C {
              errors: push(
                c.errors,
                (ln, "类型错误: 无法确定 {name} 的类型参数，取不到它的关联常量 {cn}"),
              ),
              ..c
            }
            failed = true
            break
          }
          extra = push(extra, unwrap(a))
        },
        CgT(tv) => {
          let p = pr(c, tv)
          var msg = ""
          var a: Node? = None
          match p {
            TC(pn, _) => {
              if !starts(pn, "#") {
                msg = "{name} 的常量泛型参数必须是整数，实际是 {sh(c, p)}"
              } else {
                a = Some(lit_n(ln, LInt(unwrap_or(parse_int(__str_slice(pn, 1, len(pn))), 0))))
              }
            },
            TR(pn, _) => {
              if !contains(ctx, pn) {
                msg = "{name} 的常量泛型参数必须是整数，实际是 {sh(c, p)}"
              } else {
                let (cn2, a2) = typed_node(c, name_n(ln, pn), int_t())
                c = cn2
                a = Some(a2)
              }
            },
            TV(_) => {
              msg = "无法推断 {name} 的常量泛型参数（标注数组长度，或用 {name}.<…>(…) 显式指定）"
            },
            _ => { msg = "{name} 的常量泛型参数必须是整数，实际是 {sh(c, p)}" },
          }
          if msg != "" {
            c = C { errors: push(c.errors, (ln, "类型错误: " + msg)), ..c }
            failed = true
            break
          }
          extra = push(extra, unwrap(a))
        },
      }
    }
    if !failed { c = add_patch(c, node, PtArgs(extra)) }
  }
  // 带常量泛型参数的函数补上隐藏参数
  for i in keys(c.cg_fns) {
    let (fnode, cga) = unwrap(get(c.cg_fns, i))
    let hid = map(cga, (n) => (n, Some(match get(c.tc_info, n) {
      Some((_, _, cty)) => cty,
      None => YCon("Int", [], fnode.line),
    })))
    c = add_patch(c, fnode, PtParams(hid))
  }
  C { cg_sites: [], cg_fns: Map(), ..c }
}
fn instantiate(c0: C, t: Ty) -> (C, Ty) {
  var c = c0
  var m: Map<Str, Ty> = Map()
  for (n, _) in tys.gen_objs(c0.sub, t) {
    let (c1, v) = fresh(c)
    c = c1
    m = set(m, n, v)
  }
  (c, tys.subst(c.sub, t, m))
}

fn rigidify(c: C, t: Ty) -> Ty {
  var m: Map<Str, Ty> = Map()
  for (n, bs) in tys.gen_objs(c.sub, t) { m = set(m, n, TR(n, bs)) }
  tys.subst(c.sub, t, m)
}

// ───────── 类型 AST → 类型 ─────────

fn convs(c0: C, tas: List<TyX?>, gm: Map<Str, Ty>, sigv: Bool) -> Result<(C, List<Ty>), F> {
  var c = c0
  var out: List<Ty> = []
  for ta in tas {
    let (c1, t) = conv(c, ta, gm, sigv)?
    c = c1
    out = push(out, t)
  }
  Ok((c, out))
}

fn is_lower1(s: Str) -> Bool {
  if len(s) != 1 { return false }
  let o = __ord(s)
  o >= 97 && o <= 122
}

fn conv(c0: C, ta: TyX?, gm: Map<Str, Ty>, sigv: Bool) -> Result<(C, Ty), F> {
  conv2(c0, ta, gm, sigv, false, false)
}

fn cg_rigid_has(c: C, n: Str) -> Bool {
  len(c.cg_ctx) > 0 && contains(c.cg_ctx[len(c.cg_ctx) - 1], n)
}

fn somes(ts: List<TyX>) -> List<TyX?> { map(ts, (t) => Some(t)) }

fn conv2(
  c0: C,
  ta0: TyX?,
  gm: Map<Str, Ty>,
  sigv: Bool,
  const_ok: Bool,
  want_const: Bool,
) -> Result<(C, Ty), F> {
  let ta = match ta0 {
    Some(x) => x,
    None => { return Ok(fresh(c0)) },
  }
  var name = ""
  var args: List<TyX> = []
  var ln = 0
  match ta {
    YTup(a, _) => {
      let (c, ts) = convs(c0, somes(a), gm, sigv)?
      return Ok((c, TC("Tuple", ts)))
    },
    YFn(a, r, _) => {
      let (c1, ps) = convs(c0, somes(a), gm, sigv)?
      let (c2, rt) = conv(c1, Some(r), gm, sigv)?
      return Ok((c2, fn_t(ps, rt)))
    },
    YUnsafe(x, _) => {
      let (c3, t) = conv(c0, Some(x), gm, sigv)?
      return Ok((c3, TC("UnsafeFn", [t])))
    },
    YImpl(bs, l) => {
      return Err(te(c0, l, "impl " + join(bs, " + ") + " 只能写在函数参数或返回类型里"))
    },
    YDyn(bs, l) => {
      for b in bs { if !known_trait(c0, b) { return Err(te(c0, l, "未知 trait {b}")) } }
      return Ok((c0, TR("dyn " + join(bs, " + "), bs)))
    },
    YCon(n, a, l) => {
      name = n
      args = a
      ln = l
    },
  }
  if starts(name, "#") {
    if !const_ok {
      return Err(
        te(
          c0,
          ln,
          "这里需要类型，{__str_slice(name, 1, len(name))} 是常量（只能用作常量泛型实参或数组长度）",
        ),
      )
    }
    return Ok((c0, TC(name, [])))
  }
  if name == "Array" && len(args) == 2 {
    let (c1, el) = conv(c0, Some(args[0]), gm, sigv)?
    let (c2, n) = conv2(c1, Some(args[1]), gm, sigv, true, true)?
    return Ok((c2, TC("Array", [el, n])))
  }
  if let Some(g) = get(gm, name) {
    if is_tv(g) { return Ok((c0, g)) }
    let isc = is_tg(g) && contains(gm, "#c:" + name) || is_tr(g) && cg_rigid_has(c0, tname(g))
    if isc && !const_ok { return Err(te(c0, ln, "{name} 是常量泛型参数，不能当类型用")) }
    if want_const && !isc { return Err(te(c0, ln, "数组长度 {name} 必须是整数或常量泛型参数")) }
    return Ok((c0, g))
  }
  if want_const {
    return Err(te(c0, ln, "数组长度 {name} 必须是整数或常量泛型参数（const {name}: Int）"))
  }
  if name == "_" && len(args) == 0 { return Ok(fresh(c0)) }
  if contains(name, ".") {
    let segs = split(name, ".")
    let hd = segs[0]
    if len(segs) == 2 && contains(gm, hd) {
      let item = segs[1]
      let base = unwrap(get(gm, hd))
      let pb = pr(c0, base)
      let bs: List<Str>? = match pb {
        TG(_, b) => Some(b),
        TR(_, b) => Some(b),
        _ => None,
      }
      if let Some(b) = bs {
        if is_none(assoc_owner(c0, b, item)) {
          return Err(te(c0, ln, "{hd} 的约束里没有关联类型 {item}"))
        }
      }
      return Ok((c0, TC("@" + item, [base])))
    }
  }
  if sigv && is_lower1(name) { return Ok((c0, TG(name, []))) }
  if let Some(p) = prim(name) { return Ok((c0, p)) }
  if let Some((gens, target)) = get(c0.aliases, name) {
    if len(args) > 0 && len(args) != len(gens) {
      return Err(te(c0, ln, "类型别名 {name} 需要 {len(gens)} 个类型参数，给了 {len(args)} 个"))
    }
    var c = c0
    var sub = gm
    let tb = tbounds(c0, name)
    for (g, a) in zip(gens, args) {
      let (c1, at) = conv(c, Some(a), gm, sigv)?
      c = c1
      sub = set(sub, g, at)
      for b in bget(tb, g) {
        let pt = pr(c, at)
        match pt {
          TR(pn, pbs) => {
            if !contains(closure(c, pbs), b) {
              return Err(te(c, ln, "{name}<{sh(c, pt)}> 要求 {pn}: {b}（给 {pn} 加上约束 {b}）"))
            }
          },
          TG(pn, pbs) => {
            if !contains(closure(c, pbs), b) {
              return Err(te(c, ln, "{name}<{sh(c, pt)}> 要求 {pn}: {b}（给 {pn} 加上约束 {b}）"))
            }
          },
          TV(_) => (),
          _ => { if len(tys.gen_objs(c.sub, pt)) == 0 { c = add_con(c, pt, KImpl(b), ln) } },
        }
      }
    }
    return conv(c, Some(target), sub, sigv)
  }
  var cargs: List<Ty> = []
  var c = c0
  let cgo = get(c0.tcg, name)
  if is_some(cgo) && (contains(c0.structs, name) || contains(c0.enums, name)) {
    let cg = unwrap(cgo)
    let gl = gens_of(c0, name)
    for (g, a) in zip(gl, args) {
      if let YCon(an, _, _) = a {
        if contains(cg, g) && !starts(an, "#") && !contains(gm, an) {
          return Err(te(c, ln, "{name} 的常量泛型参数 {g} 需要整数，实际是 {an}"))
        }
        if !contains(cg, g) && starts(an, "#") {
          return Err(
            te(c, ln, "{name} 的泛型参数 {g} 需要类型，实际是常量 {__str_slice(an, 1, len(an))}"),
          )
        }
      }
    }
    var i = 0
    for a in args {
      let isc = i < len(gl) && contains(cg, gl[i])
      let (c1, t) = conv2(c, Some(a), gm, sigv, isc, isc)?
      c = c1
      cargs = push(cargs, t)
      i += 1
    }
  } else {
    let (c1, ts) = convs(c0, somes(args), gm, sigv)?
    c = c1
    cargs = ts
  }
  let bn = builtin_generic(name)
  if bn >= 0 {
    if len(cargs) != bn {
      return Err(te(c, ln, "{name} 需要 {bn} 个类型参数，给了 {len(cargs)} 个"))
    }
    return Ok((c, TC(name, cargs)))
  }
  if contains(c.structs, name) || contains(c.enums, name) {
    let n = len(gens_of(c, name))
    if len(cargs) != 0 && len(cargs) != n {
      return Err(te(c, ln, "{name} 需要 {n} 个类型参数，给了 {len(cargs)} 个"))
    }
    if len(cargs) == 0 && n > 0 {
      let (c2, vs) = fresh_n(c, n)
      return Ok((c2, TC(name, vs)))
    }
    return Ok((c, TC(name, cargs)))
  }
  Err(te(c, ln, "未知类型 {name}"))
}

fn variant_ctor_type(c: C, en: Str, vn: Str) -> Result<(C, Ty), F> {
  let gens = gens_of(c, en)
  let tb = tbounds(c, en)
  var gm: Map<Str, Ty> = Map()
  let cgs = unwrap_or(get(c.tcg, en), [])
  for g in gens {
    gm = set(gm, g, TG(g, bget(tb, g)))
    if contains(cgs, g) { gm = set(gm, "#c:" + g, any_t()) }
  }
  let res = TC(en, map(gens, (g) => unwrap(get(gm, g))))
  let fs = vf_fields(variant_fs(c, en, vn))
  if len(fs) == 0 { return Ok((c, res)) }
  let (c1, ts) = convs(c, map(fs, (f) => Some(f.1)), gm, false)?
  Ok((c1, fn_t(ts, res)))
}

// ───────── 合一 ─────────

fn mismatch(c: C, e: Ty, a: Ty, ln: Int, ctx: Str) -> F {
  let (ns, s1) = tys.show_n(c.sub, deepnorm(c, e), [])
  let (_, s2) = tys.show_n(c.sub, deepnorm(c, a), ns)
  te(c, ln, pre(ctx) + "期望 " + s1 + "，实际是 " + s2)
}

fn is_anyn(t: Ty) -> Bool {
  match t {
    TC(n, _) => n == "Any" || n == "Never",
    _ => false,
  }
}

fn bindv(c: C, v: Int, t: Ty, ln: Int) -> Result<C, F> {
  if tys.occurs(c.sub, v, t) {
    return Err(te(c, ln, "无限类型 " + sh(c, TV(v)) + " = " + sh(c, t)))
  }
  Ok(C { sub: set(c.sub, v, t), ..c })
}

fn unify(c: C, e0: Ty, a0: Ty, ln: Int, ctx: Str) -> Result<C, F> {
  let a = pr(c, e0)
  let b = pr(c, a0)
  if let TV(i) = a {
    if let TV(j) = b { if i == j { return Ok(c) } }
  }
  if is_anyn(a) || is_anyn(b) { return Ok(c) }
  if let TV(i) = a { return bindv(c, i, b, ln) }
  if let TV(j) = b { return bindv(c, j, a, ln) }
  if is_proj(a) || is_proj(b) {
    if is_proj(a) && is_proj(b) && tname(a) == tname(b) {
      let x = pr(c, targs(a)[0])
      let y = pr(c, targs(b)[0])
      let same = match (x, y) {
        (TV(i), TV(j)) => i == j,
        (TR(p, _), TR(q, _)) => p == q,
        _ => false,
      }
      if same { return Ok(c) }
    }
    // 投影还没法规约：等类型确定后再合一
    return Ok(C { deferred: push(c.deferred, (e0, a0, ln, ctx)), ..c })
  }
  if let TR(an, abs) = a {
    if starts(an, "dyn ") {
      let up = match b {
        TR(bn, bbs) => starts(bn, "dyn ") && all(abs, (x) => contains(closure(c, bbs), x)),
        _ => false,
      }
      if up && tname(b) != an { return Ok(c) }   // dyn 向上转换：dyn B → dyn A
      if !up {
        // 隐式转换为 dyn：实际类型必须实现全部 trait
        if is_tg(b) { return Err(mismatch(c, e0, a0, ln, ctx)) }
        for tr in abs {
          if !implements(c, b, tr) {
            let pre = if ctx != "" { ctx + "：" } else { "" }
            return Err(te(c, ln, pre + "{sh(c, b)} 没有实现 {tr}，不能当作 {an}"))
          }
        }
        return Ok(c)
      }
    }
  }
  if is_tg(a) || is_tg(b) {
    if let TG(x, _) = a {
      if let TG(y, _) = b { if x == y { return Ok(c) } }
    }
    return Err(mismatch(c, e0, a0, ln, ctx))
  }
  if is_con(a) && tname(a) == "UnsafeFn" && is_con(b) && tname(b) == "fn" {
    // 普通函数可以当 unsafe fn 用（反过来不行）
    return match unify(c, targs(a)[0], b, ln, ctx) {
      Ok(c1) => Ok(c1),
      Err(f) => Err(mismatch(f.c, e0, a0, ln, ctx)),
    }
  }
  if is_con(a) && tname(a) == "fn" && is_con(b) && tname(b) == "UnsafeFn" {
    let pre = if ctx != "" { ctx + "：" } else { "" }
    return Err(te(c, ln, pre + "期望 {sh(c, a)}，实际是 {sh(c, b)}（unsafe fn 不能当普通函数用）"))
  }
  if is_con(a)
    && tname(a) == "List"
    && len(targs(a)) == 1
    && is_con(b)
    && tname(b) == "Array"
    && len(targs(b)) == 2 {
    // 定长数组可以当作列表用；反过来不行，长度未知
    return match unify(c, targs(a)[0], targs(b)[0], ln, ctx) {
      Ok(c1) => Ok(c1),
      Err(f) => Err(mismatch(f.c, e0, a0, ln, ctx)),
    }
  }
  if is_con(a) && tname(a) == "Array" && is_con(b) && tname(b) == "List" {
    return Err(
      te(
        c,
        ln,
        pre(
          ctx,
        ) + "期望 {sh(c, a)}，实际是 {sh(c, b)}（列表的长度编译期未知：直接传数组字面量，或给变量标注 [T; n]）",
      ),
    )
  }
  let xa = targs(a)
  let xb = targs(b)
  if tname(a) != tname(b) || len(xa) != len(xb) { return Err(mismatch(c, e0, a0, ln, ctx)) }
  var c1 = c
  var i = 0
  while i < len(xa) {
    match unify(c1, xa[i], xb[i], ln, ctx) {
      Ok(c2) => { c1 = c2 },
      Err(f) => { return Err(mismatch(f.c, e0, a0, ln, ctx)) },
    }
    i += 1
  }
  Ok(c1)
}

fn join_t(c: C, a: Ty, b: Ty, ln: Int, ctx: Str) -> Result<(C, Ty), F> {
  if tname(pr(c, a)) == "Never" && is_con(pr(c, a)) { return Ok((c, b)) }
  if tname(pr(c, b)) == "Never" && is_con(pr(c, b)) { return Ok((c, a)) }
  let c1 = unify(c, a, b, ln, ctx)?
  Ok((c1, a))
}

// ───────── 内建 ─────────

fn builtin_ft(c: C, k: Str, s: List<(Str, Str)>) -> Result<(C, FT), F> {
  if k == "v" { return Ok((c, FVar)) }
  if k == "d" { return Ok((c, FDict(s))) }
  let (c1, t) = parse_sig(c, s[0].1)?
  Ok((c1, FTy(t)))
}

fn parse_sig(c: C, s: Str) -> Result<(C, Ty), F> {
  if let Some(t) = get(c.sigs, s) { return Ok((c, t)) }
  let ta = match parser.parse_type(s) {
    Ok(v) => v,
    Err(e) => { return Err(F { c: c, ln: 0, msg: e }) },
  }
  let (c1, t) = conv(c, Some(ta), Map(), true)?
  Ok((C { sigs: set(c1.sigs, s, t), ..c1 }, t))
}

fn con_t(n: Str) -> TyX { YCon(n, [], 0) }

fn install(c0: C) -> Result<C, F> {
  var c = c0
  let some = ("Some", EvList([("_0", con_t("T"))]))
  let none = ("None", EvNone)
  let ok = ("Ok", EvList([("_0", con_t("T"))]))
  let er = ("Err", EvList([("_0", con_t("E"))]))
  c = C {
    enums: set(set(c.enums, "Option", (["T"], [some, none])), "Result", (["T", "E"], [ok, er])),
    ..c
  }
  for (en, vn) in [("Option", "Some"), ("Option", "None"), ("Result", "Ok"), ("Result", "Err")] {
    c = C { variant_owner: set(c.variant_owner, vn, en), ..c }
    let (c1, t) = variant_ctor_type(c, en, vn)?
    c = C { g: set(c1.g, vn, ent(t, false, true)), ..c1 }
  }
  for (n, k, s) in builtins.builtin_sigs() {
    let (c1, ft) = builtin_ft(c, k, s)?
    c = C {
      g: set(c1.g, n, Ent {
        t: ft,
        mt: false,
        sch: true,
        bi: true,
        gens: [],
        ext: "",
        va: false,
        cga: [],
        dep: "",
      }),
      ..c1
    }
  }
  Ok(c)
}

// ───────── 声明 ─────────

fn guard_c(c: C, r: Result<C, F>) -> Result<C, F> {
  match r {
    Ok(c1) => Ok(c1),
    Err(f) => if is_unsup(f) { Err(f) } else { Ok(add_err(c, f)) },
  }
}

fn fn_sig(c0: C, fnode: Node, gm0: Map<Str, Ty>, self_t: Ty?) -> Result<(C, Ty), F> {
  let (c, t, _) = fn_sig3(c0, fnode, gm0, self_t)?
  Ok((c, t))
}

fn mentions_self(t: TyX) -> Bool {
  match t {
    YCon(n, a, _) => n == "Self" || any(a, mentions_self),
    YTup(a, _) => any(a, mentions_self),
    YFn(a, r, _) => any(a, mentions_self) || mentions_self(r),
    YUnsafe(x, _) => mentions_self(x),
    YDyn(_, _) => false,
    YImpl(_, _) => false,
  }
}

// 签名和它的隐藏常量参数（常量泛型参数 + 泛型参数上的关联常量 __tc_T_N）
fn fn_sig3(c0: C, fnode: Node, gm0: Map<Str, Ty>, self_t: Ty?) -> Result<(C, Ty, List<Str>), F> {
  let (c1, sig) = fn_sig0(c0, fnode, gm0, self_t)?
  var c = c1
  let f = fnd(fnode)
  let own = f.gen.cgens
  let fg = f.gen.names
  var gm = gm0
  let bounds = bounds_of(f.gen)
  for g in fg {
    gm = set(gm, g, TG(g, bget(bounds, g)))
    if contains(own, g) { gm = set(gm, "#c:" + g, any_t()) } else { gm = remove(gm, "#c:" + g) }
  }
  let nocg = contains(gm, "#nocg")
  // Python 按 dict 插入顺序：外层（impl）的泛型参数在前，函数自己的在后
  var order: List<Str> = []
  for k in sort(keys(gm)) { if !starts(k, "#") && !contains(fg, k) { order = push(order, k) } }
  order = order + fg
  var cga: List<Str> = []
  if !nocg {
    for n in order {
      if contains(gm, "#c:" + n) && is_tg(unwrap(get(gm, n))) && !contains(own, n) {
        cga = push(cga, n)
      }
    }
  }
  cga = cga + own
  if !nocg {
    for n in order {
      if let Some(TG(_, bs)) = get(gm, n) {
        if contains(gm, "#c:" + n) || len(bs) == 0 { continue }
        for tr in closure(c, bs) {
          for (cn, cty) in unwrap_or(get(c.tconsts, tr), []) {
            let hn = "__tc_{n}_{cn}"
            if !contains(cga, hn) && !mentions_self(cty) {
              cga = push(cga, hn)
              c = C { tc_info: set(c.tc_info, hn, (n, cn, cty)), ..c }
            }
          }
        }
      }
    }
  }
  if len(cga) > 0 && fnode.id >= 0 { c = C { cg_fns: set(c.cg_fns, fnode.id, (fnode, cga)), ..c } }
  Ok((c, sig, cga))
}

fn fn_sig0(c0: C, fnode: Node, gm0: Map<Str, Ty>, self_t: Ty?) -> Result<(C, Ty), F> {
  var gm = gm0
  let f = fnd(fnode)
  let bounds = bounds_of(f.gen)
  let own = f.gen.cgens
  for g in f.gen.names {
    for b in bget(bounds, g) {
      if !known_trait(c0, b) { return Err(te(c0, fnode.line, "未知 trait {b}")) }
    }
    gm = set(gm, g, TG(g, bget(bounds, g)))
    if contains(own, g) { gm = set(gm, "#c:" + g, any_t()) } else { gm = remove(gm, "#c:" + g) }
  }
  var c = c0
  var ps: List<Ty> = []
  for p in f.params {
    if p.0 == "self" && is_none(p.1) {
      match self_t {
        Some(st) => { ps = push(ps, st) },
        None => { return Err(te(c, fnode.line, "self 只能出现在 impl 方法里")) },
      }
    } else {
      let (c1, t) = conv(c, p.1, gm, false)?
      c = c1
      ps = push(ps, t)
    }
  }
  if is_none(f.ret) && is_some(f.ext) { return Ok((c, fn_t(ps, unit_t()))) }
  let (c2, r) = conv(c, f.ret, gm, false)?
  Ok((c2, fn_t(ps, r)))
}

fn declare(c0: C, its: List<Node>, sc0: Sc) -> Result<(C, Sc), F> {
  var c = c0
  var sc = sc0
  for it in its {
    let g = gen_of(it)
    match it.k {
      NStruct(nm, fs, _) => {
        if len(g.bounds) > 0 { c = C { type_bounds: set(c.type_bounds, nm, bounds_of(g)), ..c } }
        if len(g.cgens) > 0 { c = C { tcg: set(c.tcg, nm, g.cgens), ..c } }
        c = C { structs: set(c.structs, nm, (g.names, fs)), ..c }
      },
      NEnum(nm, vs, _) => {
        if len(g.bounds) > 0 { c = C { type_bounds: set(c.type_bounds, nm, bounds_of(g)), ..c } }
        if len(g.cgens) > 0 { c = C { tcg: set(c.tcg, nm, g.cgens), ..c } }
        c = C { enums: set(c.enums, nm, (g.names, vs)), ..c }
      },
      NAlias(nm, t, _) => {
        if len(g.bounds) > 0 { c = C { type_bounds: set(c.type_bounds, nm, bounds_of(g)), ..c } }
        c = C { aliases: set(c.aliases, nm, (g.names, t)), ..c }
      },
      NTrait(t) => {
        let ta = map(t.assoc, (a) => (a.name, a.bounds, a.dflt))
        c = C { trait_assoc: set(c.trait_assoc, t.name, ta), ..c }
        c = C {
          traits: set(c.traits, t.name, t.methods),
          supers: set(c.supers, t.name, t.supers),
          ..c
        }
      },
      _ => (),
    }
  }
  for it in its {
    match decl_item(c, sc, it) {
      Ok((c1, s1)) => {
        c = c1
        sc = s1
      },
      Err(f) => {
        if is_unsup(f) { return Err(f) }
        c = add_err(c, f)
      },
    }
  }
  for it in its {
    if is_k(it, "Impl") { c = guard_c(c, declare_impl(c, it))? }
  }
  Ok((check_supers(c, its), sc))
}

fn decl_item(c0: C, sc0: Sc, it: Node) -> Result<(C, Sc), F> {
  var c = c0
  var sc = sc0
  let k = kname(it)
  let nm = nname(it)
  if k == "Struct" || k == "Enum" || k == "Alias" {
    for (_, bs) in bounds_of(gen_of(it)) {
      for b in bs { if !known_trait(c, b) { return Err(te(c, it.line, "未知 trait {b}")) } }
    }
  }
  match it.k {
    NStruct(_, fields, g) => {
      let tb = tbounds(c, nm)
      let gens = g.names
      var gm: Map<Str, Ty> = Map()
      let cgs = g.cgens
      for gn in gens {
        gm = set(gm, gn, TG(gn, bget(tb, gn)))
        if contains(cgs, gn) { gm = set(gm, "#c:" + gn, any_t()) }
      }
      let fts = map(fields, (f) => f.1)
      let (c1, _) = convs(c, fts, gm, false)?
      let (c2, ts) = convs(c1, fts, gm, false)?
      let st = TC(nm, map(gens, (gn) => unwrap(get(gm, gn))))
      return Ok(define(c2, sc, nm, ent(fn_t(ts, st), false, true)))
    },
    NEnum(_, vs, _) => {
      for v in vs {
        let vn = v.0
        let alts = unwrap_or(get(c.variant_alts, vn), [])
        c = C {
          variant_owner: set(c.variant_owner, vn, nm),
          variant_alts: set(c.variant_alts, vn, if contains(alts, nm) {
            alts
          } else {
            push(alts, nm)
          }),
          ..c
        }
        let (c1, t) = variant_ctor_type(c, nm, vn)?
        let (c2, s2) = define(c1, sc, vn, ent(t, false, true))
        c = c2
        sc = s2
      }
      return Ok((c, sc))
    },
    NFn(f) => {
      let (c1, sig, cga) = fn_sig3(c, it, Map(), None)?
      let c2 = C { fsigs: set(c1.fsigs, fkey(it), sig), fcga: set(c1.fcga, fkey(it), cga), ..c1 }
      var ext = ""
      var va = false
      let dep = depr_msg(it, nm)
      let (c3, s3) = define(c2, sc, nm, Ent {
        t: FTy(sig),
        mt: false,
        sch: true,
        bi: false,
        gens: f.gen.names,
        ext: "",
        va: false,
        cga: cga,
        dep: dep,
      })
      if is_some(f.ext) {
        let c4 = match check_extern(c3, it, sig) {
          Ok(cx) => cx,
          Err(e) => {
            if is_unsup(e) { return Err(e) }
            return Ok((add_err(c3, e), s3))
          },
        }
        ext = "extern 函数|" + nm
        va = f.varargs
        return Ok(define(c4, s3, nm, Ent {
          t: FTy(sig),
          mt: false,
          sch: true,
          bi: false,
          gens: f.gen.names,
          ext: ext,
          va: va,
          cga: cga,
          dep: dep,
        }))
      }
      if f.is_unsafe { ext = "unsafe 函数|" + nm }
      if ext == "" && dep == "" { return Ok((c3, s3)) }
      return Ok(define(c3, s3, nm, Ent {
        t: FTy(sig),
        mt: false,
        sch: true,
        bi: false,
        gens: f.gen.names,
        ext: ext,
        va: va,
        cga: cga,
        dep: dep,
      }))
    },
    NUse(..) => { return use_item(c, sc, it) },
    _ => (),
  }
  Ok((c, sc))
}

// @deprecated("说明") 的警告文本；没有标记时为 ""
fn depr_msg(it: Node, nm: Str) -> Str {
  for a in unwrap_or(it.attrs, []) {
    if a.name == "deprecated" {
      for (_, v) in a.args {
        if let Some(LStr(m)) = v { return "警告: {nm} 已弃用：{m}" }
      }
      return "警告: {nm} 已弃用"
    }
  }
  ""
}

// 记录局部绑定（供 LSP 悬停显示类型）；预导入里的不记录
fn rec(c: C, name: Str, t: Ty, ln: Int, kind: Str) -> C {
  if c.in_pre || ln == 0 || name == "_" { return c }
  C { locs: push(c.locs, (ln, name, t, kind)), ..c }
}

// 局部绑定 (行, 名字, 类型文本, 种类)，类型按求解结果显示
pub fn local_types(c: C) -> List<(Int, Str, Str, Str)> {
  map(c.locs, (l) => (l.0, l.1, sh(c, l.2), l.3))
}

fn warn(c: C, ln: Int, msg: Str) -> C {
  if contains(c.warns, (ln, msg)) { c } else { C { warns: push(c.warns, (ln, msg)), ..c } }
}

fn use_name(e: (Str, Str?)) -> (Str, Str) { (e.0, unwrap_or(e.1, e.0)) }

fn up_s(u: UseP) -> Str {
  match u {
    UName(s) => s,
    UGroup(_) => "",
  }
}

fn use_item(c0: C, sc0: Sc, it: Node) -> Result<(C, Sc), F> {
  let (p, alias) = match it.k {
    NUse(x, a) => (x, a),
    _ => { return Ok((c0, sc0)) },
  }
  if up_s(p[0]) != "std" || len(p) < 2 { return Ok((c0, sc0)) }
  var es: List<(Str, Str, Str, Str)> = []
  match p[1] {
    UGroup(xs) => {
      for e in xs {
        let (m, b) = use_name(e)
        es = push(es, ("mod", m, b, ""))
      }
    },
    UName(p1) => {
      if len(p) == 2 {
        es = push(es, ("mod", p1, unwrap_or(alias, p1), ""))
      } else if up_s(p[2]) == "*" {
        es = push(es, ("all", p1, "", ""))
      } else {
        let ms = match p[2] {
          UGroup(xs) => xs,
          UName(p2) => [(p2, Some(unwrap_or(alias, p2)))],
        }
        for e in ms {
          let (n, b) = use_name(e)
          es = push(es, ("member", p1, n, b))
        }
      }
    },
  }
  var c = c0
  var sc = sc0
  for (k, m, a, b) in es {
    let tbl = match std_mod(m) {
      Some(t) => t,
      None => { return Err(te(c, it.line, "未知标准库模块 std.{m}")) },
    }
    if k == "mod" {
      let (c1, s1) = define(c, sc, a, ent(TC("Module:" + m, []), false, false))
      c = c1
      sc = s1
    } else if k == "all" {
      for (n, kk, s) in tbl {
        let (c1, ft) = builtin_ft(c, kk, s)?
        let ex = if m == "ptr" && unsafe_ptr(n) { "unsafe 函数|{m}.{n}" } else { "" }
        let (c2, s2) = define(c1, sc, n, Ent {
          t: ft,
          mt: false,
          sch: true,
          bi: false,
          gens: [],
          ext: ex,
          va: false,
          cga: [],
          dep: "",
        })
        c = c2
        sc = s2
      }
    } else {
      match std_member(m, a) {
        Some((kk, s)) => {
          let (c1, ft) = builtin_ft(c, kk, s)?
          let ex = if m == "ptr" && unsafe_ptr(a) { "unsafe 函数|{m}.{a}" } else { "" }
          let (c2, s2) = define(c1, sc, b, Ent {
            t: ft,
            mt: false,
            sch: true,
            bi: false,
            gens: [],
            ext: ex,
            va: false,
            cga: [],
            dep: "",
          })
          c = c2
          sc = s2
        },
        None => { return Err(te(c, it.line, "std.{m} 没有 {a}")) },
      }
    }
  }
  Ok((c, sc))
}

fn check_supers(c0: C, its: List<Node>) -> C {
  var c = c0
  for it in its {
    if !is_k(it, "Trait") { continue }
    let nm = nname(it)
    let sups = unwrap_or(get(c.supers, nm), [])
    for sb in sups {
      if !contains(c.traits, sb) && !contains(builtin_traits(), sb) {
        c = C {
          errors: push(c.errors, (it.line, "类型错误: trait {nm} 的超 trait {sb} 不存在")),
          ..c
        }
      }
    }
    var seen: List<Str> = []
    var stack = sups
    while len(stack) > 0 {
      let b = stack[len(stack) - 1]
      stack = take(stack, len(stack) - 1)
      if b == nm {
        c = C {
          errors: push(c.errors, (it.line, "类型错误: trait {nm} 的超 trait 构成了循环")),
          ..c
        }
        break
      }
      if contains(seen, b) { continue }
      seen = push(seen, b)
      stack = stack + unwrap_or(get(c.supers, b), [])
    }
  }
  for it in its {
    if !is_k(it, "Impl") { continue }
    let d = implv(it)
    let tr = match trait_name(d) {
      Some(x) => x,
      None => { continue },
    }
    let tg = d.target
    for sb in skip(closure(c, [tr]), 1) {
      if contains(builtin_traits(), sb) && (sb == "Show" || contains(builtin_impls(sb), tg)) {
        continue
      }
      if !contains(c.impls, tg + "|" + sb) {
        c = C {
          errors: push(
            c.errors,
            (it.line, "类型错误: impl {tr} for {tg} 要求 {tg} 也实现超 trait {sb}"),
          ),
          ..c
        }
      }
    }
  }
  c
}

fn trait_m(c: C, tr: Str, nm: Str) -> Node? {
  for m in unwrap_or(get(c.traits, tr), []) { if fnd(m).name == nm { return Some(m) } }
  None
}

fn ikey(it: Node) -> Str { implv(it).target + "@" + "{it.line}" }

fn declare_impl(c0: C, it: Node) -> Result<C, F> {
  var c = c0
  let d = implv(it)
  let gens = d.gen.names
  let target = d.target
  var ib = bounds_of(d.gen)
  for g in gens {
    for b in bget(ib, g) { if !known_trait(c, b) { return Err(te(c, it.line, "未知 trait {b}")) } }
  }
  let tb = tbounds(c, target)
  if len(tb) > 0 {
    if let YCon(_, targs0, _) = d.target_t {
      for (tg, arg) in zip(gens_of(c, target), targs0) {
        if let YCon(an, aa, _) = arg {
          if contains(gens, an) && len(aa) == 0 {
            var cur = bget(ib, an)
            for b in bget(tb, tg) { if !contains(cur, b) { cur = push(cur, b) } }
            ib = if any(ib, (kv) => kv.0 == an) {
              map(ib, (kv) => if kv.0 == an { (an, cur) } else { kv })
            } else {
              push(ib, (an, cur))
            }
          }
        }
      }
      let nb = map(ib, (kv) => (kv.0, map(kv.1, (b) => YCon(b, [], 0))))
      c = add_patch(c, it, PtBounds(nb))
    }
  }
  var gm: Map<Str, Ty> = Map()
  let icg = d.gen.cgens
  for g in gens {
    gm = set(gm, g, TG(g, bget(ib, g)))
    if contains(icg, g) { gm = set(gm, "#c:" + g, any_t()) }
  }
  let trv = trait_name(d)
  // trait impl 的方法不接收隐藏的常量参数（动态分派时传不了）
  if is_some(trv) && len(icg) > 0 { gm = set(gm, "#nocg", any_t()) }
  if !contains(c.structs, target)
    && !contains(c.enums, target)
    && is_none(prim(target))
    && builtin_generic(target) < 0 {
    return Err(te(c, it.line, "impl 的目标类型 {target} 未定义"))
  }
  let (c1, self_t) = conv(c, Some(d.target_t), gm, false)?
  c = c1
  gm = set(gm, "Self", self_t)
  var tbl = unwrap_or(get(c.methods, target), Map())
  c = C { methods: set(c.methods, target, tbl), ..c }
  let own = d.methods
  var ms: List<(Node, Bool)> = map(own, (m) => (m, true))
  let tr = unwrap_or(trv, "")
  let given = d.assoc
  if len(given) > 0 && is_none(trv) {
    return Err(
      te(
        c,
        it.line,
        "关联类型只能写在 impl Trait for 类型 里（" + join(map(given, (g) => g.0), ", ") + "）",
      ),
    )
  }
  if is_some(trv) {
    let decl = unwrap_or(get(c.trait_assoc, tr), [])
    for (an, _) in given {
      if !any(decl, (dd) => dd.0 == an) {
        return Err(te(c, it.line, "trait {tr} 没有关联类型 {an}"))
      }
    }
    for (an, bs, dflt) in decl {
      var ta = dflt
      for (gn, gt) in given { if gn == an { ta = Some(gt) } }
      let tax = match ta {
        Some(x) => x,
        None => {
          return Err(te(c, it.line, "impl {tr} for {target} 缺少关联类型 {an}（写 type {an} = …）"))
        },
      }
      c = C { impl_assoc: set(c.impl_assoc, target + "|" + an, (it, tax)), ..c }
      let (ca, at) = conv(c, Some(tax), gm, false)?
      c = ca
      for b in bs { c = add_con(c, at, KImpl(b), it.line) }
    }
    c = C { impls: set(c.impls, target + "|" + tr, true), ..c }
    if !contains(c.traits, tr) && !contains(builtin_traits(), tr) {
      return Err(te(c, it.line, "未知 trait {tr}"))
    }
    let names = map(own, (m) => fnd(m).name)
    for m in unwrap_or(get(c.traits, tr), []) {
      let mf = fnd(m)
      let mn = mf.name
      if !contains(names, mn) {
        if is_none(mf.body) {
          if let Some(cn) = mf.x.const_name {
            return Err(
              te(c, it.line, "impl {tr} for {target} 缺少关联常量 {cn}（写 const {cn}: … = …）"),
            )
          }
          return Err(te(c, it.line, "impl {tr} for {target} 缺少方法 {mn}"))
        }
        ms = push(ms, (m, false))
      }
    }
  }
  c = C { impl_info: set(c.impl_info, ikey(it), (self_t, map(ms, (x) => x.0))), ..c }
  for (m, is_own) in ms {
    let mn = fnd(m).name
    let (c2, msig, mcg) = fn_sig3(c, m, gm, Some(self_t))?
    c = C { mcga: set(set(c2.mcga, target + "|" + fkey(m), mcg), target + "|#" + mn, mcg), ..c2 }
    if is_own && is_some(trv) {
      if let Some(tm) = trait_m(c, tr, mn) {
        match fn_sig(c, tm, gm, Some(self_t)) {
          Ok((c3, tsig)) => { c = guard_c(c3, check_impl_sig(c3, it, m, tm, msig, tsig))? },
          Err(f) => {
            if is_unsup(f) { return Err(f) }
            c = add_err(c, f)
          },
        }
      }
    }
    tbl = set(unwrap_or(get(c.methods, target), Map()), mn, (msig, has_self(m)))
    c = C {
      methods: set(c.methods, target, tbl),
      msigs: set(c.msigs, target + "|" + fkey(m), msig),
      ..c
    }
    c = C {
      umeth: if fnd(m).is_unsafe {
        set(c.umeth, target + "|" + mn, true)
      } else {
        remove(c.umeth, target + "|" + mn)
      },
      ..c
    }
  }
  Ok(c)
}

fn check_impl_sig(c0: C, it: Node, m: Node, tm: Node, isig: Ty, tsig: Ty) -> Result<C, F> {
  let d = implv(it)
  let tr = unwrap_or(trait_name(d), "")
  let mf = fnd(m)
  let cnm = mf.x.const_name
  let wh = match cnm {
    None => "impl {tr} for {d.target} 的方法 {mf.name}",
    Some(cn) => "impl {tr} for {d.target} 的关联常量 {cn}",
  }
  if has_self(m) != has_self(tm) {
    return Err(te(c0, m.line, "{wh} 和 trait 声明不一致：self 参数" + (if has_self(m) {
      "多了"
    } else {
      "少了"
    })))
  }
  let tu = fnd(tm).is_unsafe
  if mf.is_unsafe != tu {
    return Err(te(c0, m.line, "{wh} 和 trait 声明不一致：" + (if tu {
      "trait 里是 unsafe fn"
    } else {
      "trait 里不是 unsafe fn"
    })))
  }
  let na = len(targs(isig)) - 1
  let nb = len(targs(tsig)) - 1
  if na != nb { return Err(te(c0, m.line, "{wh} 有 {na} 个参数，trait 声明的是 {nb} 个")) }
  let (c1, ti) = instantiate(c0, tsig)
  let (c2, ii) = instantiate(c1, isig)
  let r = match unify(c2, ti, rigidify(c2, isig), m.line, "") {
    Ok(c3) => unify(c3, rigidify(c3, tsig), ii, m.line, ""),
    Err(f) => Err(f),
  }
  match r {
    Ok(c4) => Ok(c4),
    Err(f) => {
      if is_some(cnm) {
        let ta = targs(tsig)
        let ia = targs(isig)
        return Err(
          te(
            f.c,
            m.line,
            "{wh} 的类型和 trait 声明不一致：期望 {sh(f.c, ta[len(ta) - 1])}，实际是 {sh(f.c, ia[len(ia) - 1])}",
          ),
        )
      }
      Err(
        te(
          f.c,
          m.line,
          "{wh} 的签名和 trait 声明不一致：期望 {sh(f.c, tsig)}，实际是 {sh(f.c, isig)}",
        ),
      )
    },
  }
}

// ───────── 函数体 ─────────

type Saved = {
  ret: List<Ty>,
  rigid: List<Map<Str, Ty>>,
  loop_depth: Int,
  labels: List<(Str?, Ty?, Bool)>,
  unsafe_d: Int,
  cg_ctx: List<List<Str>>,
  in_pre: Bool,
}
fn save(c: C) -> Saved {
  Saved {
    ret: c.ret,
    rigid: c.rigid,
    loop_depth: c.loop_depth,
    labels: c.labels,
    unsafe_d: c.unsafe_d,
    cg_ctx: c.cg_ctx,
    in_pre: c.in_pre,
  }
}

// 循环帧在 Python 版里是可变列表：内层设置的 break 标记要保留，所以只截断，不整体换回
fn restore(c: C, s: Saved) -> C {
  let lb = if len(c.labels) >= len(s.labels) && s.loop_depth > 0 {
    take(c.labels, len(s.labels))
  } else {
    s.labels
  }
  C {
    ret: s.ret,
    rigid: s.rigid,
    loop_depth: s.loop_depth,
    labels: lb,
    unsafe_d: s.unsafe_d,
    cg_ctx: s.cg_ctx,
    in_pre: s.in_pre,
    ..c
  }
}

fn rest_r<T>(r: Result<(C, T), F>, s: Saved) -> Result<(C, T), F> {
  match r {
    Ok((c, x)) => Ok((restore(c, s), x)),
    Err(f) => Err(F { c: restore(f.c, s), ..f }),
  }
}

// trait 默认方法：每个 impl 各自检查出一份类型化的函数体，按 "类型.方法名@行" 存在 C.dflt（Python 版的 _tsnap）
fn check_impl_bodies(c0: C, it: Node, sc: Sc) -> Result<(C, Node), F> {
  var c = c0
  let d = implv(it)
  let target = d.target
  var own = d.methods
  match get(c.impl_info, ikey(it)) {
    Some((_, ms)) => {
      for m in ms {
        if is_none(fnd(m).body) { continue }
        match get(c.msigs, target + "|" + fkey(m)) {
          Some(sig) => {
            var m2 = m
            match check_fn_body2(
              c,
              m,
              sc,
              Some(sig),
              unwrap_or(get(c.mcga, target + "|" + fkey(m)), []),
            ) {
              Ok((c1, x)) => {
                c = c1
                m2 = x
              },
              Err(f) => {
                if is_unsup(f) { return Err(f) }
                c = add_err(c, f)
              },
            }
            if any(d.methods, (x) => fkey(x) == fkey(m)) {
              own = map(own, (x) => if fkey(x) == fkey(m) { m2 } else { x })
            } else {
              c = C { dflt: set(c.dflt, target + "." + fnd(m).name + "@" + "{m.line}", m2), ..c }
            }
          },
          None => (),
        }
      }
    },
    None => (),
  }
  Ok((c, Node { k: NImpl(ImplD { methods: own, ..d }), ..it }))
}

fn stmts_of(b: Node) -> List<Node> {
  match b.k {
    NBlock(ss, _) => ss,
    _ => [],
  }
}

fn last_line(b: Node) -> Int {
  let ss = stmts_of(b)
  if len(ss) > 0 { ss[len(ss) - 1].line } else { b.line }
}

fn diverges(b: Node) -> Bool {
  let ss = stmts_of(b)
  len(ss) > 0 && contains(["Return", "Break", "Continue"], kname(ss[len(ss) - 1]))
}

fn check_fn_body(c0: C, fnode: Node, sc: Sc, sig0: Ty?) -> Result<(C, Node), F> {
  check_fn_body2(c0, fnode, sc, sig0, unwrap_or(get(c0.fcga, fkey(fnode)), []))
}

// 检查函数体，返回函数体换成类型化 IR 的函数节点
fn check_fn_body2(c0: C, fnode: Node, sc: Sc, sig0: Ty?, cga: List<Str>) -> Result<(C, Node), F> {
  let f = fnd(fnode)
  let body = match f.body {
    Some(b) => b,
    None => { return Ok((c0, fnode)) },
  }
  let sig = match sig0 {
    Some(s) => s,
    None => match get(c0.fsigs, fkey(fnode)) {
      Some(s) => s,
      None => { return Ok((c0, fnode)) },
    },
  }
  var rigid: Map<Str, Ty> = Map()
  for (n, bs) in tys.gen_objs(c0.sub, sig) { rigid = set(rigid, n, TR(n, bs)) }
  let ft = tys.subst(c0.sub, sig, rigid)
  let s = save(c0)
  var sc2 = frame(sc)
  let pts = targs(ft)
  let rt = pts[len(pts) - 1]
  var c = c0
  for n in cga {
    if !contains(rigid, n) { rigid = set(rigid, n, TR(n, [])) }
    var vt = int_t()
    if let Some((_, _, cty)) = get(c.tc_info, n) {
      let (cx, t1) = conv(c, Some(cty), Map(), false)?
      c = cx
      vt = t1
    }
    let (cy, sy) = define(c, sc2, n, ent(vt, false, false))
    c = cy
    sc2 = sy
  }
  c = C {
    rigid: push(c.rigid, rigid),
    ret: push(c.ret, rt),
    cg_ctx: push(c.cg_ctx, cga),
    in_pre: fnode.pre,
    ..c
  }
  var i = 0
  for p in f.params {
    let (c1, s1) = define(c, sc2, p.0, ent(pts[i], false, false))
    c = rec(c1, p.0, pts[i], fnode.line, "param")
    sc2 = s1
    i += 1
  }
  if f.is_unsafe { c = C { unsafe_d: c.unsafe_d + 1, ..c } }
  let fname = f.name
  if f.is_async && fname != "main" && head(c, rt) == "Future" {
    // async fn：直接按内层类型 T 检查 Future { run: () => body } 里的闭包
    let lamv = async_lambda(body)
    let inner = targs(pr(c, rt))[0]
    let (c5, lam2) = rest_r(async_body(c, lamv, sc2, inner, fnode.line, fname), s)?
    return Ok((c5, with_fnd(fnode, FnD { body: Some(async_with(body, lam2)), ..f })))
  }
  let (c3, b2) = rest_r(fn_body2(c, body, sc2, rt, fname), s)?
  Ok((c3, with_fnd(fnode, FnD { body: Some(b2), ..f })))
}

// async fn 的函数体是 { Future { run: () => 原函数体 } }：取出那个闭包
fn async_lambda(body: Node) -> Node {
  let st = stmts_of(body)[0]
  match st.k {
    NExprStmt(e) => match e.k {
      NStructLit(_, fs, _) => fs[0].1,
      _ => e,
    },
    _ => st,
  }
}

// 把检查过的闭包放回 async fn 的函数体
fn async_with(body: Node, lam2: Node) -> Node {
  let ss = stmts_of(body)
  let st = ss[0]
  let st2 = match st.k {
    NExprStmt(e) => match e.k {
      NStructLit(n, fs, b) => Node {
        k: NExprStmt(Node { k: NStructLit(n, [(fs[0].0, lam2)] + skip(fs, 1), b), ..e }),
        ..st
      },
      _ => st,
    },
    _ => st,
  }
  match body.k {
    NBlock(_, u) => Node { k: NBlock([st2] + skip(ss, 1), u), ..body },
    _ => body,
  }
}

fn async_body(c: C, lamv: Node, sc: Sc, inner: Ty, ln: Int, name: Str) -> Result<(C, Node), F> {
  let (c1, lt, l2) = expr(c, lamv, sc, Some(fn_t([], inner)))?
  let xs = targs(pr(c1, lt))
  let c2 = unify(c1, inner, xs[len(xs) - 1], ln, "async fn {name} 的返回值")?
  Ok((c2, l2))
}

fn call_parts(e: Node) -> (Node, List<Node>) {
  match e.k {
    NCall(f, a) => (f, a),
    _ => (e, []),
  }
}

// 调用可变参数 extern：固定参数照常检查；多出来的参数只能是 Int/Float/Bool/Str/Ptr
fn va_call(c0: C, e: Node, en: Ent, sig: Ty, sc: Sc) -> Result<(C, Ty, Node), F> {
  let (f, args) = call_parts(e)
  let ln = e.line
  let nm = split(en.ext, "|")[1]
  let fname = nname(f)
  let (c1, _) = lookup(C { va_ok: true, ..c0 }, fname, sc, ln)?
  var c = C { va_ok: false, ..c1 }
  let xs = targs(sig)
  let fixed = take(xs, len(xs) - 1)
  if len(args) < len(fixed) {
    return Err(te(c, ln, "{nm} 至少需要 {len(fixed)} 个参数，给了 {len(args)} 个"))
  }
  var out: List<Node> = []
  var i = 0
  while i < len(fixed) {
    let (c2, at, a2) = expr(c, args[i], sc, Some(fixed[i]))?
    c = unify(c2, fixed[i], at, args[i].line, "{nm} 的参数")?
    out = push(out, a2)
    i += 1
  }
  var extra: List<Str> = []
  while i < len(args) {
    let (c3, at0, a3) = expr(c, args[i], sc, None)?
    c = c3
    out = push(out, a3)
    let at = pr(c, at0)
    if !(is_con(at) && contains(["Int", "Float", "Bool", "Str", "Ptr"], tname(at))) {
      return Err(
        te(
          c,
          args[i].line,
          "{nm} 的可变参数不能是 {sh(c, at)}（只支持 Int、Float、Bool、Str、Ptr）",
        ),
      )
    }
    extra = push(extra, tname(at))
    i += 1
  }
  // 每种可变参数组合一个变体名（Python 版同时把变体记在 extern 函数的 _va_variants 上，代码生成时再补）
  let vkey = fname + "__va_" + join(extra, "_")
  if !any(c.vav, (t) => t.1 == vkey) { c = C { vav: push(c.vav, (fname, vkey, extra)), ..c } }
  Ok((c, xs[len(xs) - 1], Node { k: NCall(Node { k: NName(vkey), ..f }, out), ..e }))
}

fn narrow_c(ta: TyX?) -> Bool {
  match ta {
    Some(YCon(n, a, _)) => contains(
      ["I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"],
      n,
    )
      && len(a) == 0,
    _ => false,
  }
}

fn ext_head(c: C, ta: TyX?, t: Ty) -> Str {
  if narrow_c(ta) { return ast.bound_name(unwrap(ta)) }
  let p = pr(c, t)
  if is_con(p) || is_tr(p) { tname(p) } else { "" }
}

// 可以按值传给 C 的结构体：非泛型，字段都是 Int/Float/Bool/Ptr 或这样的结构体
// 描述（和 Python 版 c_struct_desc 一样）：<"S" 名字 <<字段 描述> …>>，不行时 None
fn c_struct_ok(c0: C, t: Ty, depth: Int) -> Result<(C, XD?), F> {
  let h = ext_head(c0, None, t)
  if !contains(c0.structs, h) || depth > 8 { return Ok((c0, None)) }
  let (gens, fields) = unwrap(get(c0.structs, h))
  if len(gens) > 0 { return Ok((c0, None)) }
  var c = c0
  var out: List<(Str, XD)> = []
  for f in fields {
    let fa = f.1
    let (c1, ft) = conv(c, fa, Map(), false)?
    c = c1
    let fh = ext_head(c, fa, ft)
    var d = XdH(fh)
    if !(
      contains(
        [
          "Int", "Float", "Bool", "Ptr", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64",
          "F32", "F64",
        ],
        fh,
      )
    ) {
      let (c2, sd) = c_struct_ok(c, ft, depth + 1)?
      c = c2
      match sd {
        Some(x) => { d = x },
        None => { return Ok((c, None)) },
      }
    }
    out = push(out, (f.0, d))
  }
  Ok((c, if len(out) > 0 { Some(XdS(h, out)) } else { None }))
}

fn c_callback_ok(c: C, t: Ty) -> XD? {
  let p = pr(c, t)
  if !(is_con(p) && tname(p) == "fn") { return None }
  let xs = targs(p)
  let cb = ["Int", "Float", "Bool", "Ptr"]
  let ps = map(take(xs, len(xs) - 1), (a) => ext_head(c, None, a))
  let r = ext_head(c, None, xs[len(xs) - 1])
  if all(ps, (a) => contains(cb, a)) && (contains(cb, r) || r == "Unit") {
    Some(XdF(ps, r))
  } else {
    None
  }
}

fn check_extern(c0: C, it: Node, sig: Ty) -> Result<C, F> {
  var c = c0
  let xs = targs(sig)
  let f = fnd(it)
  let ps = f.params
  var i = 0
  var descs: List<XD> = []
  let nm = f.name
  while i < len(xs) {
    let isret = i == len(xs) - 1
    let pn = if isret { "返回值" } else { ps[i].0 }
    let pa = if isret { f.ret } else { ps[i].1 }
    let pt = pr(c, xs[i])
    let h = ext_head(c, pa, pt)
    var ok = contains(
      [
        "Int", "Float", "Bool", "Str", "Ptr", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64",
        "F32", "F64",
      ],
      h,
    )
      || isret && h == "Unit"
    var d = XdH(h)
    if !ok {
      let (c1, sd) = c_struct_ok(c, pt, 0)?
      c = c1
      if let Some(x) = sd {
        ok = true
        d = x
      }
    }
    if !ok && !isret {
      if let Some(x) = c_callback_ok(c, pt) {
        ok = true
        d = x
      }
    }
    descs = push(descs, d)
    if !ok {
      let what = if isret { "返回值" } else { "参数 " + pn + " " }
      let tail = if isret {
        "，或字段都是 Int/Float/Bool/Ptr 的结构体"
      } else {
        "，或字段都是 Int/Float/Bool/Ptr 的结构体，或参数和返回值都是 Int/Float/Bool/Ptr 的 fn 回调"
      }
      let u = if isret { "、Unit" } else { "" }
      return Err(
        te(
          c,
          it.line,
          "extern fn {nm} 的{what}不能是 {sh(c, pt)}（只支持 Int、Float、Bool、Str、Ptr{u}" + tail + "）",
        ),
      )
    }
    i += 1
  }
  let et = (take(descs, len(descs) - 1), descs[len(descs) - 1])
  Ok(add_patch(c, it, PtExt(et)))
}

fn fn_body2(c: C, body: Node, sc: Sc, rt: Ty, name: Str) -> Result<(C, Node), F> {
  let (c1, bt, b2) = block(c, body, sc, Some(rt))?
  if !diverges(body) {
    let c2 = unify(c1, rt, bt, last_line(body), "函数 {name} 的返回值")?
    return Ok((c2, b2))
  }
  Ok((c1, b2))
}

fn body_gmap(c: C) -> Map<Str, Ty> {
  var g: Map<Str, Ty> = Map()
  for r in c.rigid { for k in keys(r) { g = set(g, k, unwrap(get(r, k))) } }
  g
}

fn is_decl(k: Str) -> Bool {
  contains(["Fn", "Struct", "Enum", "Trait", "Impl", "Alias", "Use", "Mod"], k)
}

// 块：返回块的类型和类型化的块（块节点本身的类型由 expr 记）
fn block(c0: C, b: Node, scope: Sc, expected: Ty?) -> Result<(C, Ty, Node), F> {
  var c = c0
  var sc = frame(scope)
  let ss = stmts_of(b)
  let local = filter(ss, (s) => is_decl(kname(s)))
  var done: Map<Int, Node> = Map()
  if len(local) > 0 {
    let (c1, s1) = declare(c, local, sc)?
    c = c1
    sc = s1
    var li = 0
    for s in local {
      if is_k(s, "Fn") {
        let (c2, x) = check_fn_body(c, s, sc, None)?
        c = c2
        done = set(done, li, x)
      } else if is_k(s, "Impl") {
        let (c2, x) = check_impl_bodies(c, s, sc)?
        c = c2
        done = set(done, li, x)
      }
      li += 1
    }
  }
  var t = unit_t()
  var i = 0
  var di = 0
  var out: List<Node> = []
  for s in ss {
    if is_decl(kname(s)) {
      out = push(out, unwrap_or(get(done, di), s))
      di += 1
      t = unit_t()
      i += 1
      continue
    }
    let r = match s.k {
      NExprStmt(ex) => if i == len(ss) - 1 && is_some(expected) {
        match expr(c, ex, sc, expected) {
          Ok((c1, t1, x)) => Ok((c1, sc, t1, Node { k: NExprStmt(x), ..s })),
          Err(f) => Err(f),
        }
      } else {
        stmt(c, s, sc)
      },
      _ => stmt(c, s, sc),
    }
    match r {
      Ok((c1, s1, t1, x)) => {
        c = c1
        sc = s1
        t = t1
        out = push(out, x)
        if is_k(s, "ExprStmt") && i < len(ss) - 1 && !c.in_pre && head(c, t1) == "Future" {
          c = warn(c, s.line, "警告: Future 没有被 .await，不会执行")
        }
      },
      Err(f) => {
        if is_unsup(f) { return Err(f) }
        c = add_err(c, f)
        out = push(out, s)
        if let NLet(p, mutable, _, _, _) = s.k {
          for nm in pat_names(p) {
            if !contains(frame_vars(sc), nm) {
              let (c2, s2) = define(c, sc, nm, ent(any_t(), mutable, false))
              c = c2
              sc = s2
            }
          }
        }
        t = any_t()
      },
    }
    i += 1
  }
  let u = match b.k {
    NBlock(_, x) => x,
    _ => false,
  }
  Ok((c, t, Node { k: NBlock(out, u), ..b }))
}

fn pat_names(p: Pat) -> List<Str> {
  match p {
    PBind(n) => [ast.nm_str(n)],
    PVar(n) => [ast.nm_str(n)],
    PTuple(xs) => flat_names(xs),
    PList(pre, rest, post) => {
      var out = flat_names(pre)
      if let Some(r) = rest { if r != "_" && r != "" { out = push(out, r) } }
      out + flat_names(post)
    },
    PVariant(_, Some(xs)) => flat_names(xs),
    PStruct(_, fs) => flat_names(map(fs, (f) => f.1)),
    POr(xs) => pat_names(xs[0]),
    PAt(a, b) => pat_names(a) + pat_names(b),
    _ => [],
  }
}

fn flat_names(ps: List<Pat>) -> List<Str> {
  var out: List<Str> = []
  for p in ps { out = out + pat_names(p) }
  out
}

fn const_literal(e: Node) -> Lit? {
  match e.k {
    NLit(l) => match l {
      LBig(_) => None,
      _ => Some(l),
    },
    NUnary(op, o, _) => {
      if op != "-" { return None }
      match o.k {
        NLit(LInt(i)) => Some(LInt(-i)),
        NLit(LFlt(f)) => Some(LFlt(-f)),
        _ => None,
      }
    },
    _ => None,
  }
}

fn stmt(c0: C, s: Node, sc: Sc) -> Result<(C, Sc, Ty, Node), F> {
  let ln = s.line
  match s.k {
    NExprStmt(e) => {
      let (c, t, x) = expr(c0, e, sc, None)?
      return Ok((c, sc, t, Node { k: NExprStmt(x), ..s }))
    },
    NLet(pat0, mutable, ty, value, is_const) => {
      var c = c0
      var ann: Ty? = None
      if is_some(ty) {
        let (c1, a) = conv(c, ty, body_gmap(c), false)?
        c = c1
        ann = Some(a)
      }
      let (c2, vt, v2) = expr(c, value, sc, ann)?
      c = c2
      var vt2 = vt
      if let Some(a) = ann {
        c = unify(c, a, vt, ln, "let 的类型标注")?
        if is_dyn(pr(c, a)) { vt2 = a }
      }
      let (c3, sc3, p) = pattern(c, pat0, vt2, sc, mutable, ln)?
      c = c3
      if is_const {
        let pn = match p {
          PBind(n) => ast.nm_str(n),
          PVar(n) => ast.nm_str(n),
          PVariant(n, _) => ast.nm_str(n),
          PStruct(n, _) => ast.nm_str(n),
          PLit(LStr(x)) => x,
          PRange(Some(LStr(x)), _, _) => x,
          _ => "",
        }
        match const_literal(value) {
          Some(v) => { c = C { const_lits: set(c.const_lits, pn, v), ..c } },
          None => { c = C { const_lits: remove(c.const_lits, pn), ..c } },
        }
      }
      return Ok((c, sc3, unit_t(), Node { k: NLet(p, mutable, ty, v2, is_const), ..s }))
    },
    NAssign(..) => {
      let (c, x) = assign(c0, s, sc)?
      return Ok((c, sc, unit_t(), x))
    },
    NReturn(value) => {
      if len(c0.ret) == 0 { return Err(te(c0, ln, "return 只能出现在函数里")) }
      let rt = c0.ret[len(c0.ret) - 1]
      if is_spawn(rt) {
        return Err(te(c0, ln, "spawn 任务里不能用 return（任务的值就是它的表达式）"))
      }
      var c = c0
      var vt = unit_t()
      var v2: Node? = None
      if let Some(v) = value {
        let (c1, t, x) = expr(c, v, sc, Some(rt))?
        c = c1
        vt = t
        v2 = Some(x)
      }
      c = unify(c, rt, vt, ln, "return 的值")?
      return Ok((c, sc, never_t(), Node { k: NReturn(v2), ..s }))
    },
    NBreak(lab, val, bare) => {
      let (c, v2) = brk(c0, s, sc, true, lab, val)?
      return Ok((c, sc, never_t(), Node { k: NBreak(lab, v2, bare), ..s }))
    },
    NContinue(lab) => {
      let (c, _) = brk(c0, s, sc, false, lab, None)?
      return Ok((c, sc, never_t(), s))
    },
    NWhile(cond, body) => {
      var c = c0
      var cd2: Node? = None
      if let Some(cd) = cond {
        let (c1, t, x) = expr(c, cd, sc, None)?
        c = unify(c1, bool_t(), t, ln, "while 条件")?
        cd2 = Some(x)
      }
      let sv0 = save(c)
      c = C { loop_depth: c.loop_depth + 1, labels: push(c.labels, (s.label, None, false)), ..c }
      let r = block(c, body, sc, None)
      let broke = match r {
        Ok((cb, _, _)) => cb.labels[len(cb.labels) - 1].2,
        Err(_) => true,
      }
      let (c2, _, b2) = rest_r3(r, sv0)?
      // 语句位置的 loop（cond 为空）里没有 break 时永不结束，类型是 Never
      return Ok((c2, sc, if is_none(cond) && !broke { never_t() } else { unit_t() }, Node {
        k: NWhile(cd2, b2),
        ..s
      }))
    },
    NFor(pat0, iter, body) => {
      let (c1, it0, it2) = expr(c0, iter, sc, None)?
      var c = c1
      let it = pr(c, it0)
      let h = head(c, it)
      var el = unit_t()
      if h == "List" || h == "Set" || h == "Chan" {
        el = targs(it)[0]
      } else if h == "Map" {
        el = TC("Tuple", [targs(it)[0], targs(it)[1]])
      } else if h == "Str" {
        el = str_t()
      } else if is_tv(it) {
        let (c2, v) = fresh(c)
        c = unify(c2, list_t(v), it, ln, "")?
        el = v
      } else {
        return Err(te(c, ln, "{sh(c, it)} 不可迭代"))
      }
      let (c3, inner, fp) = pattern(c, pat0, el, frame(sc), false, ln)?
      let sv0 = save(c3)
      c = C { loop_depth: c3.loop_depth + 1, labels: push(c3.labels, (s.label, None, false)), ..c3 }
      let (c4, _, b2) = rest_r3(block(c, body, inner, None), sv0)?
      return Ok((c4, sc, unit_t(), Node { k: NFor(fp, it2, b2), ..s }))
    },
    NDefer(b) => {
      if is_k(b, "Block") {
        let (c, _, b2) = block(c0, b, sc, None)?
        return Ok((c, sc, unit_t(), Node { k: NDefer(b2), ..s }))
      }
      let (c, _, b3) = expr(c0, b, sc, None)?
      return Ok((c, sc, unit_t(), Node { k: NDefer(b3), ..s }))
    },
    _ => (),
  }
  let k = kname(s)
  if is_decl(k) { return Ok((c0, sc, unit_t(), s)) }
  Err(te(c0, ln, "未知语句 {k}"))
}

fn rest_r3<T, U>(r: Result<(C, T, U), F>, s: Saved) -> Result<(C, T, U), F> {
  match r {
    Ok((c, x, y)) => Ok((restore(c, s), x, y)),
    Err(f) => Err(F { c: restore(f.c, s), ..f }),
  }
}

// break / continue（Python 版两者共用 label / value 字段）；返回检查过的值
fn brk(c0: C, s: Node, sc: Sc, is_break: Bool, lab: Str?, val: Node?) -> Result<(C, Node?), F> {
  let ln = s.line
  let k = if is_break { "break" } else { "continue" }
  if c0.loop_depth == 0 { return Err(te(c0, ln, k + " 只能出现在循环里")) }
  var fi = len(c0.labels) - 1
  while fi >= 0 {
    let l = c0.labels[fi].0
    if is_none(lab) || is_some(l) && unwrap(l) == unwrap(lab) { break }
    fi -= 1
  }
  if fi < 0 { return Err(te(c0, ln, "找不到循环标签 '{unwrap_or(lab, "")}")) }
  var c = c0
  var v2 = val
  if is_break {
    let fr = c.labels[fi]
    match fr.1 {
      None => {
        if is_some(val) {
          return Err(te(c, ln, "只有 loop 的 break 能带值（while / for 的值总是 ()）"))
        }
        c = C { labels: set(c.labels, fi, (fr.0, fr.1, true)), ..c }
      },
      Some(lt) => {
        var vt = unit_t()
        if let Some(v) = val {
          let (c1, t, x) = expr(c, v, sc, None)?
          c = c1
          vt = t
          v2 = Some(x)
        }
        c = C { labels: set(c.labels, fi, (fr.0, fr.1, true)), ..c }
        c = unify(c, lt, vt, match val {
          Some(v) => v.line,
          None => ln,
        }, "loop 的 break 值")?
      },
    }
  }
  Ok((c, v2))
}

fn bin_node(ln: Int, op: Str, l: Node, r: Node) -> Node { ast.mkn(ln, NBin(op, l, Some(r))) }

fn call_node(ln: Int, f: Str, args: List<Node>) -> Node { call_n(ln, name_n(ln, f), args) }

fn assign(c0: C, s: Node, sc: Sc) -> Result<(C, Node), F> {
  let ln = s.line
  let (t, op0s, value0) = match s.k {
    NAssign(a, b, x) => (a, b, x),
    _ => { return Ok((c0, s)) },
  }
  var root = t
  var go = true
  while go {
    match root.k {
      NField(o, _) => { root = o },
      NIndex(o, _) => { root = o },
      _ => { go = false },
    }
  }
  let rn = match root.k {
    NName(x) => x,
    _ => { return Err(te(c0, ln, "赋值目标无效")) },
  }
  let e = match sc_find(c0, sc, rn) {
    Some(x) => x,
    None => { return Err(te(c0, ln, "未定义的变量 {rn}")) },
  }
  if !e.mt { return Err(te(c0, ln, "不能修改不可变绑定 `{rn}`（改用 var 声明）")) }
  if task_between(sc, rn) {
    return Err(te(c0, ln, "spawn 任务不能修改外层变量 `{rn}`（数据竞争）"))
  }
  let (c1, tt, t2) = expr(c0, t, sc, None)?
  var c = c1
  var op = op0s
  let op0 = if len(op) > 0 { __str_slice(op, 0, 1) } else { "" }
  if contains(["|=", "&=", "^=", "<<=", ">>="], op)
    || op == "-=" && head(c, tt) == "Set"
    || op != "=" && op_method(op0) != "" && (user_type(c, tt) || op_bound(c, tt, op0)) {
    // a op= b 改写成 a = a op b：目标在新的值里又检查一遍（Python 版两处是同一个节点，取后一次的结果）
    let (c0b, bn) = fid(c, bin_node(ln, __str_slice(op, 0, len(op) - 1), t, value0))
    let (c2, vt, v2) = expr(c0b, bn, sc, None)?
    c = unify(c2, tt, vt, ln, "赋值")?
    let tgt = unwrap_or(find_id(v2, t.id), t2)
    return Ok((c, Node { k: NAssign(tgt, "=", v2), ..s }))
  }
  let (c2, vt, v2) = expr(c, value0, sc, None)?
  c = unify(c2, tt, vt, ln, "赋值")?
  if op != "=" { c = add_con(c, tt, if op == "+=" { KAdd } else { KNum }, ln) }
  Ok((c, Node { k: NAssign(t2, op, v2), ..s }))
}

// 子树里编号为 i 的节点（先序第一个）
fn find_id(n: Node, i: Int) -> Node? {
  if n.id == i { return Some(n) }
  for k in ast.kids(n) {
    if let Some(x) = find_id(k, i) { return Some(x) }
  }
  None
}

fn lookup(c0: C, name: Str, sc: Sc, ln: Int) -> Result<(C, FT), F> {
  let c = c0
  let e = match sc_find(c, sc, name) {
    Some(x) => x,
    None => {
      if is_some(std_mod(name)) {
        return Err(te(c, ln, "未定义的名字 {name}（需要 use std.{name}）"))
      }
      if contains(c.structs, name) || contains(c.enums, name) {
        return Err(te(c, ln, "{name} 是类型，不是值"))
      }
      return Err(te(c, ln, "未定义的名字 {name}"))
    },
  }
  if e.sch && e.va && !c.va_ok {
    return Err(te(c, ln, "可变参数的 extern fn {name} 只能直接调用，不能当作值使用"))
  }
  if e.sch && e.ext != "" && c.unsafe_d == 0 {
    let ps = split(e.ext, "|")
    return Err(te(c, ln, "使用 {ps[0]} {ps[1]} 需要放在 unsafe \{ … } 里"))
  }
  let c = if e.sch && e.dep != "" && !c0.in_pre { warn(c0, ln, e.dep) } else { c0 }
  match e.t {
    FTy(t) => if e.sch {
      let (c1, t1) = inst_cg(c, t, ln, e.cga)
      Ok((c1, FTy(t1)))
    } else {
      Ok((c, FTy(t)))
    },
    _ => Ok((c, e.t)),
  }
}

// ───────── 表达式 ─────────

fn ft_ty(ft: FT) -> Ty {
  match ft {
    FTy(t) => t,
    _ => any_t(),
  }
}

fn exprs(c0: C, es: List<Node>, sc: Sc) -> Result<(C, List<Ty>, List<Node>), F> {
  var c = c0
  var out: List<Ty> = []
  var ns: List<Node> = []
  for e in es {
    let (c1, t, x) = expr(c, e, sc, None)?
    c = c1
    out = push(out, t)
    ns = push(ns, x)
  }
  Ok((c, out, ns))
}

// 检查表达式，返回类型和类型化 IR 节点：有编号的节点带上自己的类型（Python 版的 e._t）
fn expr(c0: C, e: Node, sc: Sc, expected: Ty?) -> Result<(C, Ty, Node), F> {
  let (c, t, x) = expr_(c0, e, sc, expected)?
  if e.id < 0 { return Ok((c, t, x)) }
  Ok((c, t, Node { t: Some(t), ..x }))
}

fn expr_t(c0: C, e: Node, sc: Sc, expected: Ty?) -> Result<(C, Ty), F> {
  let (c, t, _) = expr(c0, e, sc, expected)?
  Ok((c, t))
}

// 检查器合成、带类型的新节点（Python 版里新建 Node 后直接设 _t）
fn typed_node(c: C, v: Node, t: Ty) -> (C, Node) {
  let (c1, v1) = fid(c, v)
  (c1, Node { t: Some(t), ..v1 })
}

fn with_k(e: Node, k: K) -> Node { Node { k: k, ..e } }

fn expr_(c0: C, e: Node, sc: Sc, expected: Ty?) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  match e.k {
    NLit(l) => {
      match l {
        LBool(_) => { return Ok((c0, bool_t(), e)) },
        LInt(_) => { return Ok((c0, int_t(), e)) },
        LBig(t) => { return Err(te(c0, ln, "整数常量 {t} 超出 64 位范围")) },
        LFlt(_) => { return Ok((c0, float_t(), e)) },
        LStr(_) => { return Ok((c0, str_t(), e)) },
      }
    },
    NName(n) => {
      let alts = unwrap_or(get(c0.variant_alts, n), [])
      if len(alts) > 1 && !is_local(sc, n) && all(alts, (a) => vf_nil(variant_fs(c0, a, n))) {
        let (c1, v) = fresh(c0)
        return Ok((add_con(c1, v, KVar(n, alts), ln), v, e))
      }
      if let Some(en) = sc_find(c0, sc, n) {
        if en.sch && starts(en.ext, "unsafe 函数|") {
          if let FTy(_) = en.t {
            // 取 unsafe 函数的值是安全的，得到 unsafe fn 类型；调用它时才需要 unsafe
            let (c1, ft1) = lookup(C { unsafe_d: c0.unsafe_d + 1, ..c0 }, n, sc, ln)?
            return Ok((C { unsafe_d: c0.unsafe_d, ..c1 }, TC("UnsafeFn", [ft_ty(ft1)]), e))
          }
        }
      }
      let (cl, ft) = lookup(C { pend: [], ..c0 }, n, sc, ln)?
      if len(cl.pend) > 0 {
        return Err(
          te(C { pend: [], ..cl }, ln, "{n} 带常量泛型参数，不能当值传递，请用 lambda 包一层"),
        )
      }
      let c = cl
      match ft {
        FTy(t) => { return Ok((c, t, e)) },
        FVar => { return Ok((c, fn_t([any_t()], unit_t()), e)) },
        FDict(_) => {
          return Err(te(c, ln, "内建函数 {n} 有多个重载，不能当值传递，请用 lambda 包一层"))
        },
      }
    },
    NInterp(ps) => {
      var c = c0
      var out: List<IPart> = []
      for p in ps {
        match p {
          IExpr(x) => {
            let (c1, _, x2) = expr(c, x, sc, None)?
            c = c1
            out = push(out, IExpr(x2))
          },
          IStr(_) => { out = push(out, p) },
        }
      }
      return Ok((c, str_t(), with_k(e, NInterp(out))))
    },
    NBin(..) => { return binop(c0, e, sc) },
    NUnary(op, o, pos) => {
      if op == "-" {
        if let NLit(LBig(s)) = o.k {
          if s == "9223372036854775808" {
            let (_, ne) = repl(c0, e, lit_n(o.line, LInt(-9223372036854775807 - 1)))
            return Ok((c0, int_t(), ne))
          }
        }
      }
      let (c1, t, o2) = expr(c0, o, sc, None)?
      var c = c1
      if op == "~" || op == "!" && head(c, t) == "Int" {
        if head(c, t) != "Int" {
          if is_tv(pr(c, t)) {
            c = unify(c, int_t(), t, ln, "~ 的操作数")?
          } else {
            return Err(te(c, ln, "~ 是 Int 的按位取反，不能用于 {sh(c, t)}（逻辑非请写 !）"))
          }
        }
        if op == "!" {
          return Err(
            te(c, ln, "! 只用于 Bool；Int 的按位取反请写 ~x（kite fmt --migrate 可自动改写）"),
          )
        }
        let (cb, ne) = repl(c, e, call_node(ln, "__bnot", [o]))
        return expr_(cb, ne, sc, None)
      }
      if op == "!" {
        let c2 = unify(c, bool_t(), t, ln, "! 的操作数")?
        return Ok((c2, bool_t(), with_k(e, NUnary(op, o2, pos))))
      }
      if op == "-" && (user_type(c, t) || op_bound(c, t, "neg")) {
        return overload(c, e, "neg", t, sc)
      }
      return Ok((add_con(c, t, KNum, ln), t, with_k(e, NUnary(op, o2, pos))))
    },
    NTuple(xs) => {
      if len(xs) == 0 { return Ok((c0, unit_t(), e)) }
      let (c, ts, ns) = exprs(c0, xs, sc)?
      return Ok((c, TC("Tuple", ts), with_k(e, NTuple(ns))))
    },
    NList(xs) => {
      if let Some(ex) = expected {
        let pe = pr(c0, ex)
        if is_con(pe) && tname(pe) == "Array" && len(targs(pe)) == 2 {
          let (ca, ev) = fresh(c0)
          var el = ev
          let pel = pr(ca, targs(pe)[0])
          if is_dyn(pel) { el = pel }
          var c = ca
          var ns: List<Node> = []
          for x in xs {
            let (c2, xt, x2) = expr(c, x, sc, Some(el))?
            c = unify(c2, el, xt, x.line, "数组元素")?
            ns = push(ns, x2)
          }
          return Ok((c, TC("Array", [el, TC("#{len(xs)}", [])]), with_k(e, NList(ns))))
        }
      }
      let (c1, el0) = fresh(c0)
      var el = el0
      if let Some(ex) = expected {
        let pe = pr(c1, ex)
        if is_con(pe) && tname(pe) == "List" && len(targs(pe)) > 0 && is_dyn(pr(c1, targs(pe)[0])) {
          el = pr(c1, targs(pe)[0])
        }
      }
      var c = c1
      var ns: List<Node> = []
      for x in xs {
        let (c2, xt, x2) = expr(c, x, sc, Some(el))?
        c = unify(c2, el, xt, x.line, "列表元素")?
        ns = push(ns, x2)
      }
      return Ok((c, list_t(el), with_k(e, NList(ns))))
    },
    NCast(..) => { return cast(c0, e, sc) },
    NBlock(_, u) => {
      if u {
        return rest_r3(block(C { unsafe_d: c0.unsafe_d + 1, ..c0 }, e, sc, expected), save(c0))
      }
      return block(c0, e, sc, expected)
    },
    NLoop(body, lab) => {
      let (c1, v) = fresh(c0)
      let s = save(c1)
      let c = C {
        loop_depth: c1.loop_depth + 1,
        labels: push(c1.labels, (lab, Some(v), false)),
        ..c1
      }
      let (c2, _, b2) = block(c, body, sc, None)?
      let hit = c2.labels[len(c2.labels) - 1].2
      return Ok((restore(c2, s), if hit { v } else { never_t() }, with_k(e, NLoop(b2, lab))))
    },
    NIf(cond, thn, els) => {
      let (c1, ct, cond2) = expr(c0, cond, sc, None)?
      let c2 = unify(c1, bool_t(), ct, ln, "if 条件")?
      let (c3, tt, thn2) = block(c2, thn, sc, expected)?
      let ex = match els {
        Some(x) => x,
        None => { return Ok((c3, unit_t(), with_k(e, NIf(cond2, thn2, None)))) },
      }
      let (c4, et, ex2) = expr(c3, ex, sc, expected)?
      let e2 = with_k(e, NIf(cond2, thn2, Some(ex2)))
      if let Some(dy) = expected {
        if is_dyn(pr(c4, dy)) {
          // 两个分支分别转换成 dyn
          let c5 = unify(c4, dy, tt, ln, "if 分支")?
          let c6 = unify(c5, dy, et, ln, "else 分支")?
          return Ok((c6, dy, e2))
        }
      }
      let (c7, jt) = join_t(c4, tt, et, ln, "if 两个分支")?
      return Ok((c7, jt, e2))
    },
    NMatch(_) => { return match_e(c0, e, sc, expected) },
    NIs(v, p0) => {
      let (c1, vt, v2) = expr(c0, v, sc, None)?
      let (c2, _, ip) = pattern(c1, p0, vt, frame(sc), false, ln)?
      return Ok((c2, bool_t(), with_k(e, NIs(v2, ip))))
    },
    NLambda(..) => { return lam(c0, e, sc, expected) },
    NCall(f, fargs) => {
      let fname = unwrap_or(name_of(f), "")
      if fname == "__await" && len(fargs) == 1 {
        let (c1, a0, a2) = expr(c0, fargs[0], sc, None)?
        let at = pr(c1, a0)
        if tname(at) != "Future" && tname(at) != "" && !is_tv(at) {
          return Err(
            te(c1, ln, "只能 .await 一个 Future（async fn 的调用结果），这里是 {sh(c1, at)}"),
          )
        }
        let (c2, rt, f2, as2) = call(c1, f, [AT(at, fargs[0].line, Some(a2))], sc, ln)?
        return Ok((c2, rt, with_k(e, NCall(f2, as2))))
      }
      if fname == "__repeat" && len(fargs) == 2 {
        let cnt = fargs[1]
        var lt: Ty? = None
        let ctx = if len(c0.cg_ctx) > 0 { c0.cg_ctx[len(c0.cg_ctx) - 1] } else { [] }
        let cn = name_of(cnt)
        if is_some(cn) && contains(ctx, unwrap(cn)) {
          lt = get(c0.rigid[len(c0.rigid) - 1], unwrap(cn))
        } else if let NLit(LInt(n)) = cnt.k {
          if let Some(ex) = expected {
            let pe = pr(c0, ex)
            if is_con(pe) && tname(pe) == "Array" { lt = Some(TC("#{n}", [])) }
          }
        }
        let (c1, rt, f2, as2) = call(c0, f, map(fargs, (a) => AN(a)), sc, ln)?
        let e2 = with_k(e, NCall(f2, as2))
        return match lt {
          Some(l) => Ok((c1, TC("Array", [targs(pr(c1, rt))[0], l]), e2)),
          None => Ok((c1, rt, e2)),
        }
      }
      if is_k(f, "Name") {
        if let Some(en) = sc_find(c0, sc, fname) {
          if en.va {
            if let FTy(sig) = en.t { return va_call(c0, e, en, sig, sc) }
          }
        }
      }
      let (c3, rt3, f3, as3) = call(
        C { cg_node: Some(e), ..c0 },
        f,
        map(fargs, (a) => AN(a)),
        sc,
        ln,
      )?
      return Ok((c3, rt3, with_k(e, NCall(f3, as3))))
    },
    NPipe(l, r) => {
      let (c1, lt, l2) = expr(c0, l, sc, None)?
      let left = AT(lt, l.line, None)
      if let NCall(rf, ra) = r.k {
        let (c2, rt, rf2, ra2) = call(
          C { cg_node: Some(r), ..c1 },
          rf,
          push([], left) + map(ra, (a) => AN(a)),
          sc,
          ln,
        )?
        // 管道右边的调用节点本身不经过 expr，没有类型（和 Python 版一样）
        return Ok((c2, rt, with_k(e, NPipe(l2, with_k(r, NCall(rf2, ra2))))))
      }
      let (c3, rt3, r3, _) = call(c1, r, [left], sc, ln)?
      return Ok((c3, rt3, with_k(e, NPipe(l2, r3))))
    },
    NField(obj, fname0) => {
      let fname = ast.nm_str(fname0)
      if let Some(on) = name_of(obj) {
        if len(c0.cg_ctx) > 0 {
          let hn = "__tc_{on}_{fname}"
          if contains(c0.cg_ctx[len(c0.cg_ctx) - 1], hn) && is_none(sc_find(c0, sc, on)) {
            let (cb, ne) = repl(c0, e, name_n(ln, hn))
            return expr_(cb, ne, sc, expected)
          }
        }
        if len(c0.rigid) > 0 {
          if contains(c0.rigid[len(c0.rigid) - 1], on)
            && !starts(on, "__tc_")
            && is_none(sc_find(c0, sc, on)) {
            return Err(
              te(
                c0,
                ln,
                "类型参数 {on} 没有关联常量 {fname}（需要约束 {on}: 某个声明了 const {fname} 的 trait）",
              ),
            )
          }
        }
      }
      return field(c0, e, sc)
    },
    NTupleIndex(obj, il) => {
      let (c, t0, o2) = expr(c0, obj, sc, None)?
      let t = pr(c, t0)
      let idx = match il {
        LInt(i) => i,
        _ => 0,
      }
      if tname(t) == "Tuple" && is_con(t) {
        if idx >= len(targs(t)) { return Err(te(c, ln, "元组只有 {len(targs(t))} 个元素")) }
        return Ok((c, targs(t)[idx], with_k(e, NTupleIndex(o2, il))))
      }
      return Err(te(c, ln, "{sh(c, t)} 不能用 .{idx} 取元素（需要明确的元组类型）"))
    },
    NIndex(obj, index) => {
      let (c1, t0, o2) = expr(c0, obj, sc, None)?
      let (c2, it, i2) = expr(c1, index, sc, None)?
      let e2 = with_k(e, NIndex(o2, i2))
      let t = pr(c2, t0)
      let h = head(c2, t)
      if h == "List" {
        let c3 = unify(c2, int_t(), it, ln, "下标")?
        return Ok((c3, targs(t)[0], e2))
      }
      if h == "Map" {
        let c3 = unify(c2, targs(t)[0], it, ln, "Map 的键")?
        return Ok((c3, targs(t)[1], e2))
      }
      if h == "Str" {
        let c3 = unify(c2, int_t(), it, ln, "下标")?
        return Ok((c3, str_t(), e2))
      }
      if is_tv(t) {
        let (c3, el) = fresh(c2)
        let c4 = unify(c3, list_t(el), t, ln, "")?
        let c5 = unify(c4, int_t(), it, ln, "")?
        return Ok((c5, el, e2))
      }
      return Err(te(c2, ln, "{sh(c2, t)} 不支持下标"))
    },
    NTry(v) => {
      let (c1, t0, v2) = expr(c0, v, sc, None)?
      let e2 = with_k(e, NTry(v2))
      let t = pr(c1, t0)
      if len(c1.ret) == 0 { return Err(te(c1, ln, "? 只能用在函数里")) }
      let rt = c1.ret[len(c1.ret) - 1]
      if is_spawn(rt) { return Err(te(c1, ln, "spawn 任务里不能用 ?（任务不能替外层函数返回）")) }
      let h = head(c1, t)
      if h == "Result" {
        let (c2, tv) = fresh(c1)
        let c3 = unify(
          c2,
          rt,
          TC("Result", [tv, targs(t)[1]]),
          ln,
          "? 要求函数返回同错误类型的 Result",
        )?
        return Ok((c3, targs(t)[0], e2))
      }
      if h == "Option" {
        let (c2, tv) = fresh(c1)
        let c3 = unify(c2, rt, TC("Option", [tv]), ln, "? 要求函数返回 Option")?
        return Ok((c3, targs(t)[0], e2))
      }
      return Err(te(c1, ln, "? 只能用于 Result 或 Option，实际是 {sh(c1, t)}"))
    },
    NStructLit(..) => { return struct_lit(c0, e, sc, expected) },
    NSpawn(xs) => {
      let (c1, ts, ns) = spawn_items(c0, xs, sc)?
      let (c2, t) = group_t(c1, "Spawn", xs, ts)?
      return Ok((c2, t, with_k(e, NSpawn(ns))))
    },
    NRace(xs) => {
      let (c1, ts, ns) = spawn_items(c0, xs, sc)?
      let (c2, t) = group_t(c1, "Race", xs, ts)?
      return Ok((c2, t, with_k(e, NRace(ns))))
    },
    NAwait(g) => {
      let gi = group_items(g)
      let gk = kname(g)
      let (c1a, ts0, ns0) = spawn_items(c0, gi, sc)?
      let (c1, _) = group_t(c1a, gk, gi, ts0)?
      var c = c1
      var ts: List<Ty> = []
      var ni: List<Node> = []
      var i = 0
      for x in gi {
        var t = pr(c, ts0[i])
        var nx = ns0[i]
        if tname(t) == "Future" && is_con(t) {
          let (c2, ft) = lookup(c, "__await", sc, x.line)?
          let fa = targs(ft_ty(ft))
          c = unify(c2, fa[0], t, x.line, "")?
          t = fa[len(fa) - 1]
          let (c3, nx2) = typed_node(c, call_node(x.line, "__await", [ns0[i]]), t)
          c = c3
          nx = nx2
        }
        ni = push(ni, nx)
        ts = push(ts, t)
        i += 1
      }
      let g2 = match g.k {
        NSpawn(_) => Node { k: NSpawn(ni), ..g },
        NRace(_) => Node { k: NRace(ni), ..g },
        NTuple(_) => Node { k: NTuple(ni), ..g },
        NList(_) => Node { k: NList(ni), ..g },
        _ => g,
      }
      let (cb, ne) = repl(c, e, g2)
      let (cc, t2) = group_t(cb, gk, gi, ts)?
      return Ok((cc, t2, ne))
    },
    NSelect(_) => { return select_e(c0, e, sc) },
    NTypeApp(..) => { return type_app(c0, e, sc) },
    _ => (),
  }
  Err(te(c0, ln, "未知表达式 {kname(e)}"))
}

// spawn / race 的各项（Python 版 g.items）
fn group_items(g: Node) -> List<Node> {
  match g.k {
    NSpawn(xs) => xs,
    NRace(xs) => xs,
    NTuple(xs) => xs,
    NList(xs) => xs,
    _ => [],
  }
}

fn spawn_items(c0: C, xs: List<Node>, sc: Sc) -> Result<(C, List<Ty>, List<Node>), F> {
  var c = c0
  var ts: List<Ty> = []
  var ns: List<Node> = []
  for x in xs {
    let s = save(c)
    c = C { ret: push(c.ret, spawn_t()), loop_depth: 0, labels: [], ..c }
    let (c1, t, x2) = rest_r3(expr(c, x, task_frame(sc), None), s)?
    c = c1
    ts = push(ts, t)
    ns = push(ns, x2)
  }
  Ok((c, ts, ns))
}

fn group_t(c0: C, k: Str, xs: List<Node>, ts: List<Ty>) -> Result<(C, Ty), F> {
  if k == "Race" {
    var c = c0
    var r = ts[0]
    var i = 1
    while i < len(ts) {
      let (c1, j) = join_t(c, r, ts[i], xs[i].line, "race 各项")?
      c = c1
      r = j
      i += 1
    }
    return Ok((c, r))
  }
  Ok((c0, if len(ts) > 0 { TC("Tuple", ts) } else { unit_t() }))
}

fn expr_o(c: C, e: Node?, sc: Sc) -> Result<(C, Ty, Node?), F> {
  match e {
    Some(x) => {
      let (c1, t, x2) = expr(c, x, sc, None)?
      Ok((c1, t, Some(x2)))
    },
    None => Ok((c, unit_t(), None)),
  }
}

fn select_e(c0: C, e: Node, sc: Sc) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let arms = match e.k {
    NSelect(a) => a,
    _ => [],
  }
  var c = c0
  var result: Ty? = None
  var out: List<SArm> = []
  for arm in arms {
    let k = arm.kind
    var asc = frame(sc)
    var g2 = arm.guard
    var a2 = arm.a
    var b2 = arm.b
    if let Some(g) = arm.guard {
      let (c1, gt, gx) = expr(c, g, sc, None)?
      c = unify(c1, bool_t(), gt, ln, "select 守卫")?
      g2 = Some(gx)
    }
    if k == "recv" || k == "send" {
      let (c1, el) = fresh(c)
      let (c2, at, ax) = expr(c1, unwrap(arm.a), sc, None)?
      c = unify(c2, TC("Chan", [el]), at, ln, "{k} 的通道")?
      a2 = Some(ax)
      if k == "send" {
        let (c3, bt, bx) = expr(c, unwrap(arm.b), sc, None)?
        c = unify(c3, el, bt, ln, "send 的值")?
        b2 = Some(bx)
      } else if let Some(p) = arm.pat {
        if !irrefutable(c, p) {
          return Err(
            te(c, ln, "select 的 recv 绑定必须是变量名或 _（值是 Option，在分支里再 match）"),
          )
        }
        let (c4, s4, _) = pattern(c, p, TC("Option", [el]), asc, false, ln)?
        c = c4
        asc = s4
      }
    } else if k == "after" {
      let (c1, at, ax) = expr(c, unwrap(arm.a), sc, None)?
      c = unify(c1, int_t(), at, ln, "after 的毫秒数")?
      a2 = Some(ax)
    }
    let (c5, bt, body2) = expr(c, arm.body, asc, None)?
    c = c5
    out = push(out, SArm { a: a2, b: b2, guard: g2, body: body2, ..arm })
    match result {
      None => { result = Some(bt) },
      Some(r) => {
        let (c6, j) = join_t(c, r, bt, arm.body.line, "select 各分支")?
        c = c6
        result = Some(j)
      },
    }
  }
  Ok((c, unwrap_or(result, unit_t()), with_k(e, NSelect(out))))
}

// f.<T>：运行时就是 f 本身（Python 版去掉 TypeApp），类型记在 f 上
fn type_app(c0: C, e: Node, sc: Sc) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let (f, targs_) = match e.k {
    NTypeApp(a, b) => (a, b),
    _ => { return Err(te(c0, ln, "未知表达式")) },
  }
  let fname = match name_of(f) {
    Some(x) => x,
    None => { return Err(te(c0, ln, "显式泛型实参 .<…> 只能跟在泛型函数名后面")) },
  }
  let en = match sc_find(c0, sc, fname) {
    Some(x) => x,
    None => {
      let (_, _) = lookup(c0, fname, sc, ln)?
      return Err(te(c0, ln, "{fname} 不是泛型函数，不能写 .<…>"))
    },
  }
  let t = match en.t {
    FTy(x) => x,
    _ => { return Err(te(c0, ln, "{fname} 不是泛型函数，不能写 .<…>")) },
  }
  if !en.sch || len(en.gens) == 0 { return Err(te(c0, ln, "{fname} 不是泛型函数，不能写 .<…>")) }
  if len(en.gens) != len(targs_) {
    return Err(
      te(
        c0,
        ln,
        "{fname} 有 {len(en.gens)} 个泛型参数（" + join(
          en.gens,
          ", ",
        ) + "），给了 {len(targs_)} 个",
      ),
    )
  }
  var c = c0
  var rg: Map<Str, Ty> = Map()
  if len(c.rigid) > 0 {
    let r0 = c.rigid[len(c.rigid) - 1]
    for k in keys(r0) { if !starts(k, "__tc_") { rg = set(rg, k, unwrap(get(r0, k))) } }
  }
  var m: Map<Str, Ty> = Map()
  var i = 0
  for g in en.gens {
    let isc = contains(en.cga, g)
    let (c1, at) = conv2(c, targs_[i], rg, false, isc, isc)?
    c = c1
    m = set(m, g, at)
    i += 1
  }
  for (n, bs) in tys.gen_objs(c.sub, t) {
    if !contains(m, n) {
      let (c2, v) = fresh(c)
      c = c2
      m = set(m, n, v)
    }
    for b in bs { c = add_con(c, unwrap(get(m, n)), KImpl(b), ln) }
  }
  let res = tys.subst(c.sub, t, m)
  if len(en.cga) > 0 {
    let (c3, vs) = cg_vals(c, en.cga, m)
    c = take_cg(C { pend: vs, ..c3 }, c3.cg_node, fname, ln)?
  }
  Ok((c, res, if f.id >= 0 { Node { t: Some(res), ..f } } else { f }))
}

fn blk_of(ln: Int, e: Node) -> Node { ast.mkn(ln, NBlock([ast.mkn(ln, NExprStmt(e))], false)) }

fn cast(c0: C, e: Node, sc: Sc) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let (v, ty) = match e.k {
    NCast(a, b) => (a, b),
    _ => { return Err(te(c0, ln, "未知表达式")) },
  }
  let (c1, s0) = expr_t(c0, v, sc, None)?
  let (c2, d0) = conv(c1, Some(ty), body_gmap(c1), false)?
  let src = pr(c2, s0)
  let dst = pr(c2, d0)
  let sn = head(c2, src)
  let dn = head(c2, dst)
  if is_tv(src) { return Err(te(c2, ln, "无法推断 as 左边的类型，请加类型标注")) }
  var rep = v
  if sn == dn && contains(["Int", "Float", "Bool"], sn) {
    rep = v
  } else if sn == "Int" && dn == "Float" {
    rep = call_node(ln, "float", [v])
  } else if sn == "Float" && dn == "Int" {
    rep = call_node(ln, "int", [v])
  } else if sn == "Bool" && (dn == "Int" || dn == "Float") {
    let one = if dn == "Int" { LInt(1) } else { LFlt(1.0) }
    let zero = if dn == "Int" { LInt(0) } else { LFlt(0.0) }
    rep = ast.mkn(ln, NIf(v, blk_of(ln, lit_n(ln, one)), Some(blk_of(ln, lit_n(ln, zero)))))
  } else {
    return Err(
      te(
        c2,
        ln,
        "不能把 {sh(c2, src)} 转换为 {sh(c2, dst)}（as 只支持 Int、Float、Bool 之间的数值转换）",
      ),
    )
  }
  let (cb, ne) = repl(c2, e, rep)
  let (c3, t3, n3) = expr(cb, ne, sc, None)?
  Ok((c3, t3, n3))
}

fn struct_lit(c0: C, e: Node, sc: Sc, expected: Ty?) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let (nv, fields, base) = match e.k {
    NStructLit(a, b, x) => (a, b, x),
    _ => { return Err(te(c0, ln, "未知表达式")) },
  }
  let name = ast.nm_str(nv)
  let q = match nv {
    NmQ(_, Some(x)) => x,
    _ => "",
  }
  if q != "" && contains(c0.enums, q) && !has_variant(c0, q, name) {
    return Err(te(c0, ln, "{q} 没有变体 {name}"))
  }
  if (q != "" || !contains(c0.structs, name)) && contains(c0.variant_owner, name) {
    var en = unwrap(get(c0.variant_owner, name))
    let pt = match expected {
      Some(x) => pr(c0, x),
      None => unit_t(),
    }
    if q != "" && contains(c0.enums, q) && has_variant(c0, q, name) {
      en = q
    } else if q != "" {
      return Err(te(c0, ln, "{q} 没有变体 {name}"))
    } else if is_con(pt) && contains(c0.enums, tname(pt)) && has_variant(c0, tname(pt), name) {
      en = tname(pt)
    }
    let fs = vf_fields(variant_fs(c0, en, name))
    let vn = "{en}.{name}"
    if len(fs) == 0 || starts(fs[0].0, "_") {
      return Err(te(c0, ln, "{vn} 不是记录变体，请写 {name}(…)"))
    }
    if is_some(base) { return Err(te(c0, ln, "记录变体 {vn} 不支持 ..base 更新")) }
    let fnames = map(fs, (f) => f.0)
    for (f, _) in fields { if !contains(fnames, f) { return Err(te(c0, ln, "{vn} 没有字段 {f}")) } }
    let given = map(fields, (f) => f.0)
    let missing = filter(fnames, (f) => !contains(given, f))
    if len(missing) > 0 { return Err(te(c0, ln, "{vn} 缺少字段 " + join(missing, ", "))) }
    let fnode = if q != "" { ast.mkn(ln, NField(name_n(ln, en), nv)) } else { name_n(ln, name) }
    var args: List<Node> = []
    for f in fnames {
      var last: Node? = None
      for (g, x) in fields { if g == f { last = Some(x) } }
      args = push(args, unwrap(last))
    }
    let (cb, ne) = repl(c0, e, call_n(ln, fnode, args))
    return expr(cb, ne, sc, expected)
  }
  if !contains(c0.structs, name) { return Err(te(c0, ln, "未知结构体 {name}")) }
  let (gens, fdecl) = unwrap(get(c0.structs, name))
  let (c1, gvs) = fresh_n(c0, len(gens))
  var c = c1
  var gm: Map<Str, Ty> = Map()
  var i = 0
  for g in gens {
    gm = set(gm, g, gvs[i])
    i += 1
  }
  for (g, bs) in tbounds(c, name) {
    for b in bs { c = add_con(c, unwrap(get(gm, g)), KImpl(b), ln) }
  }
  var decl: List<(Str, Ty)> = []
  for f in fdecl {
    let (c2, t) = conv(c, f.1, gm, false)?
    c = c2
    decl = push(decl, (f.0, t))
  }
  let dnames = map(decl, (d) => d.0)
  let given = map(fields, (f) => f.0)
  let missing = filter(dnames, (f) => !contains(given, f))
  let st = TC(name, gvs)
  if let Some(bse) = base {
    let (c3, bt) = expr_t(c, bse, sc, Some(st))?
    c = unify(c3, st, bt, bse.line, "..base（应为 {name}）")?
    var fs1: List<(Str, Node)> = []
    for (f, x) in fields {
      if !contains(dnames, f) { return Err(te(c, ln, "{name} 没有字段 {f}")) }
      let dt = dget_t(decl, f)
      let (c4, xt, x2) = expr(c, x, sc, Some(dt))?
      c = unify(c4, dt, xt, x.line, "字段 {f}")?
      fs1 = push(fs1, (f, x2))
    }
    if is_k(bse, "Name") {
      var mf: List<Node> = []
      for f in missing {
        let (cf, fx) = fid(c, ast.mkn(ln, NField(bse, NmS(f))))
        c = cf
        mf = push(mf, fx)
      }
      var mi = 0
      for fx in mf {
        let (c5, _, fx2) = expr(c, fx, sc, None)?
        c = c5
        fs1 = push(fs1, (missing[mi], fx2))
        mi += 1
      }
      return Ok((c, st, with_k(e, NStructLit(nv, fs1, None))))
    }
    c = C { upd_n: c.upd_n + 1, ..c }
    let tmp = "__upd{c.upd_n}"
    let src = name_n(ln, tmp)
    let fs2 = fields + map(missing, (f) => (f, ast.mkn(ln, NField(src, NmS(f)))))
    let lit = ast.mkn(ln, NStructLit(nv, fs2, None))
    let pre_ = ast.mkn(ln, NLet(PBind(NmS(tmp)), false, None, bse, false))
    let (cn, blk) = fresh_ids(c, ast.mkn(ln, NBlock([pre_, ast.mkn(ln, NExprStmt(lit))], false)))
    let (cb, ne) = repl(cn, e, blk)
    return expr(cb, ne, sc, None)
  }
  if len(missing) > 0 { return Err(te(c, ln, "{name} 缺少字段 " + join(missing, ", "))) }
  var fs3: List<(Str, Node)> = []
  for (f, x) in fields {
    if !contains(dnames, f) { return Err(te(c, ln, "{name} 没有字段 {f}")) }
    let dt = dget_t(decl, f)
    let (c4, xt, x2) = expr(c, x, sc, Some(dt))?
    c = unify(c4, dt, xt, x.line, "字段 {f}")?
    fs3 = push(fs3, (f, x2))
  }
  Ok((c, st, with_k(e, NStructLit(nv, fs3, base))))
}

fn dget_t(d: List<(Str, Ty)>, k: Str) -> Ty {
  for (a, b) in d { if a == k { return b } }
  unit_t()
}

fn bin_parts(e: Node) -> (Str, Node, Node) {
  match e.k {
    NBin(op, l, r) => (op, l, unwrap_or(r, l)),
    _ => ("", e, e),
  }
}

fn binop(c0: C, e: Node, sc: Sc) -> Result<(C, Ty, Node), F> {
  let (op, left, right) = bin_parts(e)
  let ln = e.line
  let (c1, lt, l2) = expr(c0, left, sc, None)?
  if let NBin(_, _, None) = e.k { return Err(te(c1, 0, "未知表达式 ")) }
  let (c, rt, r2) = expr(c1, right, sc, None)?
  let e2 = with_k(e, NBin(op, l2, Some(r2)))
  if op == "&&" || op == "||" {
    let c2 = unify(c, bool_t(), lt, ln, "{op} 左边")?
    let c3 = unify(c2, bool_t(), rt, ln, "{op} 右边")?
    return Ok((c3, bool_t(), e2))
  }
  if op == ".." || op == "..=" {
    let c2 = unify(c, int_t(), lt, ln, "区间起点")?
    let c3 = unify(c2, int_t(), rt, ln, "区间终点")?
    return Ok((c3, list_t(int_t()), e2))
  }
  if op == "^"
    || op == "<<"
    || op == ">>"
    || (op == "|" || op == "&") && (head(c, lt) == "Int" || head(c, rt) == "Int") {
    let c2 = unify(c, int_t(), lt, ln, "运算 {op} 左边")?
    let c3 = unify(c2, int_t(), rt, ln, "运算 {op} 右边")?
    let f = if op == "|" {
      "__bor"
    } else if op == "&" {
      "__band"
    } else if op == "^" {
      "__bxor"
    } else if op == "<<" {
      "__shl"
    } else {
      "__shr"
    }
    let (c3b, ne) = repl(c3, e, call_node(ln, f, [left, right]))
    return expr(c3b, ne, sc, None)
  }
  if op == "|" || op == "&" || op == "-" && (head(c, lt) == "Set" || head(c, rt) == "Set") {
    let (c2, el) = fresh(c)
    let c3 = unify(c2, TC("Set", [el]), lt, ln, "运算 {op} 左边")?
    let c4 = unify(c3, TC("Set", [el]), rt, ln, "运算 {op} 右边")?
    let f = if op == "|" {
      "__set_union"
    } else if op == "&" {
      "__set_intersect"
    } else {
      "__set_difference"
    }
    let (c4b, ne) = repl(c4, e, call_node(ln, f, [left, right]))
    return expr(c4b, ne, sc, None)
  }
  if op_method(op) != "" && (user_type(c, lt) || op_bound(c, lt, op)) {
    return overload(c, e, op, lt, sc)
  }
  let c2 = unify(c, lt, rt, ln, "运算 {op} 两边类型必须相同")?
  if op == "==" || op == "!=" { return Ok((c2, bool_t(), e2)) }
  if contains(["<", ">", "<=", ">="], op) { return Ok((add_con(c2, lt, KOrd, ln), bool_t(), e2)) }
  Ok((add_con(c2, lt, if op == "+" { KAdd } else { KNum }, ln), lt, e2))
}

fn user_type(c: C, t: Ty) -> Bool {
  let p = pr(c, t)
  let h = tname(p)
  h != ""
    && !is_tr(p)
    && h != "Option"
    && h != "Result"
    && (contains(c.structs, h) || contains(c.enums, h))
}

fn op_bound(c: C, t: Ty, op: Str) -> Bool {
  match pr(c, t) {
    TR(_, bs) => {
      let tr = op_trait(op)
      if tr == "" || !has_bound(c, bs, tr) { return false }
      let bi = if contains(["<", ">", "<=", ">="], op) { "Ord" } else { "Num" }
      !has_bound(c, bs, bi)
    },
    _ => false,
  }
}

fn overload(c: C, e: Node, op: Str, lt: Ty, sc: Sc) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let meth = if op == "neg" { "neg" } else { op_method(op) }
  let h = head(c, lt)
  if !is_tr(pr(c, lt)) && !contains(unwrap_or(get(c.methods, h), Map()), meth) {
    let sym = if op == "neg" { "-（取负）" } else { op }
    return Err(
      te(c, ln, "{sh(c, lt)} 没有方法 {meth}，不能用运算符 {sym}（在 impl {h} 里定义 fn {meth}）"),
    )
  }
  let callv = match e.k {
    NUnary(_, o, _) => call_n(ln, ast.mkn(ln, NField(o, NmS(meth))), []),
    NBin(bop, l, r) => call_n(ln, ast.mkn(ln, NField(l, NmS(meth))), on_list(r)),
    _ => e,
  }
  if contains(["<", ">", "<=", ">="], op) {
    // a < b 改写成 a.cmp(b) < 0
    let (c0a, cv) = fid(c, callv)
    let (c1, ct, cv2) = expr(c0a, cv, sc, None)?
    let c2 = unify(c1, int_t(), ct, ln, "{h}.cmp 的返回值")?
    let k2 = match e.k {
      NBin(bop, _, _) => NBin(bop, cv2, Some(lit_n(ln, LInt(0)))),
      _ => e.k,
    }
    return Ok((c2, bool_t(), with_k(e, k2)))
  }
  let (cb, ne) = repl(c, e, callv)
  expr(cb, ne, sc, None)
}

fn on_list(x: Node?) -> List<Node> {
  match x {
    Some(n) => [n],
    None => [],
  }
}

fn lam(c0: C, e: Node, sc: Sc, expected: Ty?) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let (ps, body, ctx) = match e.k {
    NLambda(a, b, x) => (a, b, x),
    _ => { return Err(te(c0, ln, "未知表达式")) },
  }
  let n = len(ps)
  var c = c0
  var pts: List<Ty> = []
  var ret = unit_t()
  let exp = match expected {
    Some(x) => pr(c0, x),
    None => unit_t(),
  }
  if is_some(expected) && tname(exp) == "fn" && is_con(exp) && len(targs(exp)) - 1 == n {
    pts = take(targs(exp), n)
    ret = targs(exp)[n]
  } else {
    let (c1, vs) = fresh_n(c, n + 1)
    c = c1
    pts = take(vs, n)
    ret = vs[n]
  }
  var inner = frame(sc)
  var i = 0
  for p in ps {
    let pn = p.0
    if is_some(p.1) {
      let (c2, at) = conv(c, p.1, Map(), false)?
      c = unify(c2, at, pts[i], ln, "lambda 参数 {pn}")?
    }
    let (c3, s3) = define(c, inner, pn, ent(pts[i], false, false))
    c = rec(c3, pn, pts[i], ln, "param")
    inner = s3
    i += 1
  }
  let s = save(c)
  c = C { ret: push(c.ret, ret), loop_depth: 0, labels: [], ..c }
  let isb = match body.k {
    NBlock(_, u) => !u,
    _ => false,
  }
  let (c4, b2) = rest_r(lam_body(c, body, inner, ret, isb, unwrap_or(ctx, "lambda 返回值"), ln), s)?
  Ok((c4, fn_t(pts, ret), with_k(e, NLambda(ps, b2, ctx))))
}

fn lam_body(c: C, body: Node, inner: Sc, ret: Ty, isb: Bool, ctx: Str, ln: Int) -> Result<(
  C, Node
), F> {
  let (c1, bt, b2) = if isb {
    block(c, body, inner, Some(ret))?
  } else {
    expr(c, body, inner, Some(ret))?
  }
  let blk = is_k(body, "Block")
  if !(blk && diverges(body)) {
    let c2 = unify(c1, ret, bt, if blk { last_line(body) } else { ln }, ctx)?
    return Ok((c2, b2))
  }
  Ok((c1, b2))
}

// 字段访问：返回类型和类型化的 Field 节点（Field 节点自己的类型由 expr 记）
fn field(c0: C, e: Node, sc: Sc) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let (obj, fname0) = match e.k {
    NField(o, f) => (o, f),
    _ => { return Err(te(c0, ln, "未知表达式")) },
  }
  let fname = ast.nm_str(fname0)
  if let Some(en) = name_of(obj) {
    if is_none(sc_find(c0, sc, en)) && contains(c0.enums, en) {
      if !has_variant(c0, en, fname) { return Err(te(c0, ln, "{en} 没有变体 {fname}")) }
      let (c1, vt) = variant_ctor_type(c0, en, fname)?
      let (c2, t2) = inst(c1, vt, ln)
      return Ok((c2, t2, e))
    }
  }
  let (c, t0, o2) = expr(c0, obj, sc, None)?
  let e2 = with_k(e, NField(o2, fname0))
  let t = pr(c, t0)
  let h = head(c, t)
  if starts(h, "Module:") {
    let m = __str_slice(h, 7, len(h))
    match std_member(m, fname) {
      Some((kk, s)) => {
        let (c1, ft) = builtin_ft(c, kk, s)?
        if m == "ptr" && unsafe_ptr(fname) && c1.unsafe_d == 0 {
          return Err(te(c1, ln, "使用 unsafe 函数 {m}.{fname} 需要放在 unsafe \{ … } 里"))
        }
        match ft {
          FTy(bt) => {
            let (c2, t2) = inst(c1, bt, ln)
            return Ok((c2, t2, e2))
          },
          _ => { return Ok((c1, fn_t([any_t()], unit_t()), e2)) },
        }
      },
      None => { return Err(te(c, ln, "std.{m} 没有 {fname}")) },
    }
  }
  if contains(c.structs, h) && is_con(t) {
    let (gens, fs) = unwrap(get(c.structs, h))
    var gm: Map<Str, Ty> = Map()
    for (g, a) in zip(gens, targs(t)) { gm = set(gm, g, a) }
    for f in fs {
      if f.0 == fname {
        let (c3, ft3) = conv(c, f.1, gm, false)?
        return Ok((c3, ft3, e2))
      }
    }
    return Err(te(c, ln, "{h} 没有字段 {fname}"))
  }
  if is_tv(t) { return Err(te(c, ln, "无法推断 .{fname} 的接收者类型，请加类型标注")) }
  Err(te(c, ln, "{sh(c, t)} 没有字段 {fname}"))
}

// ───────── 调用 ─────────

// 实参：AN 是还没检查的节点；AT 是已经知道类型的值（管道左边、接收者等），可带着已检查的节点
fn arg_type(c: C, a: Arg, sc: Sc, expected: Ty?) -> Result<(C, Ty, Node?), F> {
  match a {
    AT(t, _, n) => Ok((c, t, n)),
    AN(v) => {
      let (c1, t, x) = expr(c, v, sc, expected)?
      Ok((c1, t, Some(x)))
    },
  }
}

fn arg_line(a: Arg, ln: Int) -> Int {
  match a {
    AT(_, l, _) => l,
    AN(v) => v.line,
  }
}

fn is_lam_arg(a: Arg) -> Bool {
  match a {
    AN(v) => is_k(v, "Lambda"),
    _ => false,
  }
}

fn somes_n(xs: List<Node?>) -> List<Node> {
  var out: List<Node> = []
  for x in xs { if let Some(n) = x { out = push(out, n) } }
  out
}

// 返回 (状态, 结果类型, 类型化的被调函数节点, 类型化的实参节点：只含带节点的实参，按原顺序)
fn call(cin: C, fnode: Node, args: List<Arg>, sc: Sc, ln: Int) -> Result<(
  C, Ty, Node, List<Node>
), F> {
  let cg_node = cin.cg_node
  let c0 = C { cg_node: None, ..cin }
  if let NField(obj, fname0) = fnode.k {
    let fname = ast.nm_str(fname0)
    let on0 = name_of(obj)
    let on = unwrap_or(on0, "")
    if is_some(on0) {
      let segs = split(on, ".")
      if first_upper(segs[len(segs) - 1])
        && (contains(c0.structs, on) || contains(c0.methods, on))
        && !(contains(c0.enums, on) && is_none(sc_find(c0, sc, on))) {
        let tbl = unwrap_or(get(c0.methods, on), Map())
        if let Some((_, hs)) = get(tbl, fname) {
          if hs {
            return Err(te(c0, ln, "{on}.{fname} 是实例方法（带 self），请用 值.{fname}(...) 调用"))
          }
        }
        return Err(te(c0, ln, "类型 {on} 没有静态方法 {fname}"))
      }
    }
    if !(is_some(on0) && is_none(sc_find(c0, sc, on)) && contains(c0.enums, on)) {
      let (c, rt0, o2) = expr(c0, obj, sc, None)?
      let f2 = with_k(fnode, NField(o2, fname0))
      let rt = pr(c, rt0)
      let h = head(c, rt)
      if starts(h, "Module:") {
        let m = __str_slice(h, 7, len(h))
        match std_member(m, fname) {
          Some(("v", _)) => {
            let (ca, ta, xa) = apply(c, FVar, args, sc, ln, fname)?
            return Ok((ca, ta, f2, xa))
          },
          _ => {
            let (c1, ft, f3) = field(c, fnode, sc)?
            let (cb, tb, xb) = apply(c1, FTy(ft), args, sc, ln, fname)?
            return Ok((cb, tb, f3, xb))
          },
        }
      }
      if let TR(rn, bs) = rt {
        for b in closure(c, bs) {
          for m in unwrap_or(get(c.traits, b), []) {
            if fnd(m).name == fname {
              if fnd(m).is_unsafe && c.unsafe_d == 0 {
                return Err(te(c, ln, "使用 unsafe 方法 {fname} 需要放在 unsafe \{ … } 里"))
              }
              let (c1, sig) = fn_sig(c, m, set(Map(), "Self", rt), Some(rt))?
              let recv = if has_self(m) { [AT(rt, ln, None)] } else { [] }
              let (cc, tc, xc) = apply(c1, FTy(sig), recv + args, sc, ln, fname)?
              return Ok((cc, tc, f2, xc))
            }
          }
        }
        let bl = if len(bs) > 0 { join(bs, ", ") } else { "无" }
        let gp = if starts(rn, "dyn ") { "" } else { "泛型 " }
        return Err(te(c, ln, gp + "{rn} 没有方法 {fname}（约束: {bl}）"))
      }
      let tbl = unwrap_or(get(c.methods, h), Map())
      if let Some((sig, hs)) = get(tbl, fname) {
        if contains(c.umeth, h + "|" + fname) && c.unsafe_d == 0 {
          return Err(te(c, ln, "使用 unsafe 方法 {h}.{fname} 需要放在 unsafe \{ … } 里"))
        }
        let recv = if hs { [AT(rt, ln, None)] } else { [] }
        let (c1, isig) = inst_cg(
          C { pend: [], ..c },
          sig,
          ln,
          unwrap_or(get(c.mcga, h + "|#" + fname), []),
        )
        let c1b = take_cg(c1, cg_node, fname, ln)?
        let (cd, td, xd) = apply(c1b, FTy(isig), recv + args, sc, ln, fname)?
        return Ok((cd, td, f2, xd))
      }
      if contains(c.structs, h) && any(unwrap(get(c.structs, h)).1, (f) => f.0 == fname) {
        let (c1, ft, f3) = field(c, fnode, sc)?
        let (ce, te_, xe) = apply(c1, FTy(ft), args, sc, ln, fname)?
        return Ok((ce, te_, f3, xe))
      }
      if is_some(sc_find(c, sc, fname)) {
        if is_tv(rt) { return Err(te(c, ln, "无法推断 .{fname}() 的接收者类型，请加类型标注")) }
        let (c1, ft) = lookup(c, fname, sc, ln)?
        let (cf, tf, xf) = apply(c1, ft, push([], AT(rt, ln, None)) + args, sc, ln, fname)?
        return Ok((cf, tf, f2, xf))
      }
      if is_tv(rt) { return Err(te(c, ln, "无法推断 .{fname}() 的接收者类型，请加类型标注")) }
      return Err(te(c, ln, "{sh(c, rt)} 没有方法 {fname}"))
    }
  }
  var c = C { pend: [], ..c0 }
  var ft = FVar
  var f2 = fnode
  let fnm = name_of(fnode)
  if let Some(fx) = fnm {
    let (c1, f1) = lookup(c, fx, sc, ln)?
    c = take_cg(c1, cg_node, fx, ln)?
    ft = f1
  } else {
    if is_k(fnode, "TypeApp") { c = C { cg_node: cg_node, ..c } }
    let (c1, t1, fx2) = expr(c, fnode, sc, None)?
    c = C { cg_node: None, ..c1 }
    ft = FTy(t1)
    f2 = fx2
  }
  let name = match fnode.k {
    NName(x) => x,
    NTypeApp(g, _) => unwrap_or(name_of(g), "函数"),
    _ => "函数",
  }
  let (c2, rt, xs) = apply(c, ft, args, sc, ln, name)?
  c = c2
  if is_some(fnm) && contains(["sort", "min", "max"], name) {
    if let Some(en) = sc_find(c, sc, name) {
      if en.bi {
        var el: Ty? = Some(rt)
        if name == "sort" {
          let p = pr(c, rt)
          el = if tname(p) == "List" { Some(targs(p)[0]) } else { None }
        }
        if let Some(x) = el {
          c = C { ord_sites: push(c.ord_sites, (name, x, len(args), ln, fnode)), ..c }
        }
      }
    }
  }
  Ok((c, rt, f2, xs))
}

fn dict_get(d: List<(Str, Str)>, k: Str) -> Str? {
  for (a, b) in d { if a == k { return Some(b) } }
  None
}

// 返回结果类型和类型化的实参节点（只含带节点的实参，按原顺序）
fn apply(c0: C, ft: FT, args0: List<Arg>, sc: Sc, ln: Int, name: Str) -> Result<(
  C, Ty, List<Node>
), F> {
  var args = args0
  match ft {
    FVar => {
      var c = c0
      var out: List<Node?> = []
      for a in args {
        let (c1, _, x) = arg_type(c, a, sc, None)?
        c = c1
        out = push(out, x)
      }
      return Ok((c, unit_t(), somes_n(out)))
    },
    FDict(d) => {
      var c = c0
      var chosen = ""
      match dict_get(d, "#{len(args)}") {
        Some(s) => { chosen = s },
        None => {
          if len(args) == 0 { return Err(te(c, ln, "{name} 参数个数不对")) }
          let (c1, f0, x0) = arg_type(c, args[0], sc, None)?
          c = c1
          let first = pr(c, f0)
          args = push([], AT(first, arg_line(args[0], ln), x0)) + skip(args, 1)
          let h = head(c, first)
          match dict_get(d, h) {
            Some(s) => { chosen = s },
            None => {
              if is_tv(first) {
                return Err(te(c, ln, "无法推断 {name} 第一个参数的类型，请加类型标注"))
              }
              if name == "__slice" {
                return Err(te(c, ln, "{sh(c, first)} 不支持切片（只有 List 和 Str 可以切片）"))
              }
              return Err(
                te(
                  c,
                  ln,
                  "{name} 不支持 {sh(c, first)}，可用于 " + join(map(d, (kv) => kv.0), ", "),
                ),
              )
            },
          }
        },
      }
      let (c2, bt) = parse_sig(c, chosen)?
      let (c3, it) = inst(c2, bt, ln)
      return apply(c3, FTy(it), args, sc, ln, name)
    },
    FTy(t0) => {
      var c = c0
      var t = pr(c, t0)
      if is_con(t) && tname(t) == "UnsafeFn" {
        if c.unsafe_d == 0 {
          return Err(te(c, ln, "调用 unsafe 函数值 {name}（{sh(c, t)}）需要放在 unsafe \{ … } 里"))
        }
        t = pr(c, targs(t)[0])
      }
      if is_tv(t) {
        let (c1, vs) = fresh_n(c, len(args) + 1)
        let nt = fn_t(take(vs, len(args)), vs[len(args)])
        c = unify(c1, t, nt, ln, "")?
        t = nt
      }
      if !(tname(t) == "fn" && is_con(t)) { return Err(te(c, ln, "{sh(c, t)} 不能被调用")) }
      let xs = targs(t)
      let ps = take(xs, len(xs) - 1)
      let ret = xs[len(xs) - 1]
      if len(ps) != len(args) {
        return Err(te(c, ln, "{name} 需要 {len(ps)} 个参数，给了 {len(args)} 个"))
      }
      var order: List<Int> = []
      var i = 0
      while i < len(args) {
        if !is_lam_arg(args[i]) { order = push(order, i) }
        i += 1
      }
      i = 0
      while i < len(args) {
        if is_lam_arg(args[i]) { order = push(order, i) }
        i += 1
      }
      var res: List<Node?> = map(args, (a) => match a {
        AT(_, _, n) => n,
        AN(_) => None,
      })
      for j in order {
        let (c1, at, x) = arg_type(c, args[j], sc, Some(ps[j]))?
        c = unify(c1, ps[j], at, arg_line(args[j], ln), if name == "__slice" {
          "切片的下标"
        } else {
          "{name} 的第 {j + 1} 个参数"
        })?
        res = set(res, j, x)
      }
      if name == "sum" || name == "abs" { c = add_con(c, ret, KNum, ln) }
      return Ok((c, ret, somes_n(res)))
    },
  }
}

// ───────── match 与模式 ─────────

fn match_e(c0: C, e: Node, sc: Sc, expected: Ty?) -> Result<(C, Ty, Node), F> {
  let ln = e.line
  let md = match e.k {
    NMatch(m) => m,
    _ => { return Err(te(c0, ln, "未知表达式")) },
  }
  if let Some(els) = md.let_else {
    let ss = stmts_of(els)
    var ok = diverges(els)
    if !ok && len(ss) > 0 {
      let last = ss[len(ss) - 1]
      if let NExprStmt(x) = last.k {
        if let NCall(f, _) = x.k { ok = contains(["panic", "repanic"], unwrap_or(name_of(f), "")) }
      }
    }
    if !ok {
      return Err(
        te(
          c0,
          els.line,
          "let ... else 的 else 块必须跳出（以 return / break / continue / panic 结尾）",
        ),
      )
    }
  }
  let (c1, st, subj2) = expr(c0, md.subject, sc, None)?
  var c = c1
  var result: Ty? = None
  var arms: List<Pat> = []
  var narms: List<Arm> = []
  for a in md.arms {
    let (c2, arm, p) = pattern(c, a.pat, st, frame(sc), false, ln)?
    c = c2
    var g2 = a.guard
    if let Some(g) = a.guard {
      let (c3, gt, gx) = expr(c, g, arm, None)?
      c = unify(c3, bool_t(), gt, ln, "match 守卫")?
      g2 = Some(gx)
    } else {
      arms = push(arms, p)
    }
    let (c4, bt0, body2) = expr(c, a.body, arm, expected)?
    c = c4
    narms = push(narms, Arm { pat: p, guard: g2, body: body2 })
    var bt = bt0
    if let Some(ex) = expected {
      if is_dyn(pr(c, ex)) {
        c = unify(c, ex, bt, a.body.line, "match 分支")?
        bt = ex
      }
    }
    match result {
      None => { result = Some(bt) },
      Some(r) => {
        let (c5, j) = join_t(c, r, bt, a.body.line, "match 各分支")?
        c = c5
        result = Some(j)
      },
    }
  }
  // let … else：let_else 和第二个分支的块是同一个对象（Python 版的改写两处一起生效）
  let le = if is_some(md.let_else) && len(narms) == 2 { Some(narms[1].body) } else { md.let_else }
  let e2 = with_k(e, NMatch(MatchD { subject: subj2, arms: narms, let_else: le, ..md }))
  c = exhaustive(c, ln, arms, st)?
  Ok((c, unwrap_or(result, never_t()), e2))
}

fn pname(n: Nm) -> Str { ast.nm_str(n) }

fn irrefutable(c: C, p: Pat) -> Bool {
  match p {
    PWild => true,
    PBind(_) => true,
    PVar(_) => true,
    PTuple(xs) => all(xs, (x) => irrefutable(c, x)),
    PStruct(n, fs) => contains(c.structs, pname(n)) && all(fs, (f) => irrefutable(c, f.1)),
    POr(xs) => any(xs, (x) => irrefutable(c, x)),
    PAt(_, b) => irrefutable(c, b),
    _ => false,
  }
}

fn prod(parts: List<List<Pat>>) -> List<List<Pat>> {
  var out: List<List<Pat>> = [[]]
  for ps in parts {
    var nxt: List<List<Pat>> = []
    for o in out { for x in ps { nxt = push(nxt, push(o, x)) } }
    out = nxt
  }
  out
}

fn expand_or(p: Pat) -> List<Pat> {
  match p {
    POr(xs) => {
      var out: List<Pat> = []
      for a in xs { out = out + expand_or(a) }
      out
    },
    PTuple(xs) => map(prod(map(xs, expand_or)), (cs) => PTuple(cs)),
    PAt(_, b) => expand_or(b),
    PList(pre, rest, post) => {
      let n = len(pre)
      // Python 版展开后总是带着第四项（后缀）
      map(prod(map(pre + post, expand_or)), (cs) => PList(take(cs, n), rest, skip(cs, n)))
    },
    PVariant(n, Some(xs)) => map(prod(map(xs, expand_or)), (cs) => PVariant(n, Some(cs))),
    PStruct(n, fs) => {
      let names = map(fs, (f) => f.0)
      map(prod(map(fs, (f) => expand_or(f.1))), (cs) => PStruct(n, zip(names, cs)))
    },
    _ => [p],
  }
}

fn exhaustive(c0: C, ln: Int, pats0: List<Pat>, st: Ty) -> Result<C, F> {
  var arms: List<Pat> = []
  for p in pats0 { arms = arms + expand_or(p) }
  if any(arms, (p) => irrefutable(c0, p)) { return Ok(c0) }
  let t = pr(c0, st)
  let h = head(c0, t)
  let (c, w0) = missing_case(c0, arms, t)
  let w = match w0 {
    Some(x) => x,
    None => { return Ok(c) },
  }
  if contains(c.enums, h) {
    let vs = map(unwrap(get(c.enums, h)).1, (v) => v.0)
    var have: List<Str> = []
    for p in arms {
      match p {
        PVariant(n, subs) => {
          if is_none(subs) || all(unwrap(subs), (x) => irrefutable(c, x)) {
            have = push(have, pname(n))
          }
        },
        PStruct(n, fs) => {
          if contains(vs, pname(n)) && all(fs, (f) => irrefutable(c, f.1)) {
            have = push(have, pname(n))
          }
        },
        _ => (),
      }
    }
    let missing_ = filter(vs, (v) => !contains(have, v))
    let named = (p: Pat, m: Str) => match p {
      PVariant(n, _) => pname(n) == m,
      PStruct(n, _) => pname(n) == m,
      _ => false,
    }
    if len(missing_) > 0
      && all(missing_, (m) => !contains(have, m) && !any(arms, (p) => named(p, m))) {
      return Err(te(c, ln, "match 没有覆盖 {h} 的 " + join(missing_, ", ")))
    }
  }
  if h == "Bool" && (w == "true" || w == "false") {
    return Err(te(c, ln, "match 没有覆盖 Bool 的所有值"))
  }
  if w == "_" { return Err(te(c, ln, "match 不穷尽，{sh(c, t)} 需要一个兜底分支 _")) }
  Err(te(c, ln, "match 不穷尽，没有覆盖 {w}"))
}

enum Key {
  KB(Bool),
  KLit(Str),
  KT(Int),
  KVn(Str),
  KS(Str),
  KLen(Int),
  KRest(Int, Int),
}

enum Cell {
  CW,
  CP(Pat),
  CN(Key, List<Cell>),
}

fn key_eq(a: Key, b: Key) -> Bool {
  match (a, b) {
    (KB(x), KB(y)) => x == y,
    (KLit(x), KLit(y)) => x == y,
    (KT(x), KT(y)) => x == y,
    (KVn(x), KVn(y)) => x == y,
    (KS(x), KS(y)) => x == y,
    (KLen(x), KLen(y)) => x == y,
    (KRest(x, p), KRest(y, q)) => x == y && p == q,
    _ => false,
  }
}

fn pdump(p: Pat) -> Str { val.dump(ast.pat_v(p)) }

fn norm(c: C, p: Pat) -> Cell {
  match p {
    PWild => CW,
    PBind(_) => CW,
    PVar(_) => CW,
    PLit(l) => match l {
      LBool(b) => CN(KB(b), []),
      _ => CN(KLit("L" + val.dump(ast.lit_v(l))), []),
    },
    PRange(..) => CN(KLit("R" + pdump(p)), []),
    PTuple(xs) => CN(KT(len(xs)), map(xs, (x) => CP(x))),
    PVariant(n, subs) => CN(KVn(pname(n)), map(unwrap_or(subs, []), (x) => CP(x))),
    PStruct(n, fs) => {
      let name = pname(n)
      let pick = (fname: Str) => {
        var r = CW
        for (a, b) in fs { if a == fname { r = CP(b) } }
        r
      }
      if !contains(c.structs, name) && contains(c.variant_owner, name) {
        let vf = vf_fields(variant_fs(c, unwrap(get(c.variant_owner, name)), name))
        return CN(KVn(name), map(vf, (f) => pick(f.0)))
      }
      let sf = match get(c.structs, name) {
        Some(s) => s.1,
        None => [],
      }
      CN(KS(name), map(sf, (f) => pick(f.0)))
    },
    PList(pre, rest, post) => {
      let n = len(pre) + len(post)
      let key = match rest {
        Some(r) => if r == "" { KLen(n) } else { KRest(n, len(post)) },
        None => KLen(n),
      }
      CN(key, map(pre + post, (x) => CP(x)))
    },
    _ => CN(KLit("X" + pdump(p)), []),
  }
}

fn conv_or_fresh(c: C, tas: List<TyX?>, gm: Map<Str, Ty>) -> (C, List<Ty>) {
  match convs(c, tas, gm, false) {
    Ok(r) => r,
    Err(_) => fresh_n(c, len(tas)),
  }
}
fn universe(c0: C, t0: Ty, heads: List<Key>) -> (C, List<(Key, List<Ty>)>?) {
  var c = c0
  var t = pr(c, t0)
  var h = head(c, t)
  if h == "" || is_tv(t) {
    var vs: List<Str> = []
    var nb = false
    var tn = -1
    var nl = false
    for k in heads {
      match k {
        KVn(v) => { vs = push(vs, v) },
        KB(_) => { nb = true },
        KT(n) => { if tn < 0 { tn = n } },
        KLen(_) => { nl = true },
        KRest(_, _) => { nl = true },
        _ => (),
      }
    }
    if len(vs) > 0 && contains(c.variant_owner, vs[0]) {
      h = unwrap(get(c.variant_owner, vs[0]))
      let (c1, gv) = fresh_n(c, len(gens_of(c, h)))
      c = c1
      t = TC(h, gv)
    } else if nb {
      h = "Bool"
      t = bool_t()
    } else if tn >= 0 {
      let (c1, tv) = fresh_n(c, tn)
      c = c1
      h = "Tuple"
      t = TC("Tuple", tv)
    } else if nl {
      let (c1, v) = fresh(c)
      c = c1
      h = "List"
      t = list_t(v)
    } else {
      return (c, None)
    }
  }
  let args = targs(t)
  if contains(c.enums, h) {
    let (gens, vs) = unwrap(get(c.enums, h))
    var gm: Map<Str, Ty> = Map()
    var i = 0
    for g in gens {
      if i < len(args) {
        gm = set(gm, g, args[i])
      } else {
        let (c1, v) = fresh(c)
        c = c1
        gm = set(gm, g, v)
      }
      i += 1
    }
    var out: List<(Key, List<Ty>)> = []
    for v in vs {
      let (c2, sub) = conv_or_fresh(c, map(ev_fields(v.1), (f) => Some(f.1)), gm)
      c = c2
      out = push(out, (KVn(v.0), sub))
    }
    return (c, Some(out))
  }
  if h == "Bool" { return (c, Some([(KB(true), []), (KB(false), [])])) }
  if h == "Tuple" { return (c, Some([(KT(len(args)), args)])) }
  if contains(c.structs, h) {
    let (gens, fs) = unwrap(get(c.structs, h))
    var gm: Map<Str, Ty> = Map()
    var i = 0
    for g in gens {
      if i < len(args) {
        gm = set(gm, g, args[i])
      } else {
        let (c1, v) = fresh(c)
        c = c1
        gm = set(gm, g, v)
      }
      i += 1
    }
    let (c2, sub) = conv_or_fresh(c, map(fs, (f) => f.1), gm)
    return (c2, Some([(KS(h), sub)]))
  }
  if h == "List" {
    var el = unit_t()
    if len(args) > 0 {
      el = args[0]
    } else {
      let (c1, v) = fresh(c)
      c = c1
      el = v
    }
    let l = max_len(heads)
    var out: List<(Key, List<Ty>)> = []
    var n = 0
    while n < l + 2 {
      out = push(out, (KLen(n), __repeat(el, n)))
      n += 1
    }
    return (c, Some(out))
  }
  (c, None)
}

fn max_len(heads: List<Key>) -> Int {
  var m = 0
  for k in heads {
    match k {
      KLen(n) => { if n > m { m = n } },
      KRest(n, _) => { if n > m { m = n } },
      _ => (),
    }
  }
  m
}

fn specialize(rows: List<List<Cell>>, key: Key, arity: Int) -> List<List<Cell>> {
  var out: List<List<Cell>> = []
  for r in rows {
    let rest = skip(r, 1)
    match r[0] {
      CW => { out = push(out, __repeat(CW, arity) + rest) },
      CN(k, subs) => {
        if key_eq(k, key) {
          out = push(out, subs + rest)
        } else {
          match (k, key) {
            (KRest(n, post), KLen(m)) => {
              if m >= n {
                let cut = len(subs) - post
                out = push(out, take(subs, cut) + __repeat(CW, m - n) + skip(subs, cut) + rest)
              }
            },
            _ => (),
          }
        }
      },
      CP(_) => (),
    }
  }
  out
}

fn show_case(key: Key, subs: List<Str>, top_l: Int) -> Str {
  match key {
    KB(b) => if b { "true" } else { "false" },
    KT(_) => "(" + join(subs, ", ") + ")",
    KVn(v) => v + (if len(subs) > 0 { "(" + join(subs, ", ") + ")" } else { "" }),
    KS(s) => s + " \{ .. }",
    KLen(n) => if top_l >= 0 && n == top_l + 1 {
      "[" + join(subs, ", ") + ", ..]"
    } else {
      "[" + join(subs, ", ") + "]"
    },
    _ => "_",
  }
}

fn missing(c0: C, rows0: List<List<Cell>>, types: List<Ty>, depth: Int) -> (C, List<Str>?) {
  if len(types) == 0 { return (c0, if len(rows0) > 0 { None } else { Some([]) }) }
  if depth > 60 { return (c0, None) }
  var c = c0
  let rows = map(rows0, (r) => match r[0] {
    CP(p) => push([], norm(c0, p)) + skip(r, 1),
    _ => r,
  })
  var heads: List<Key> = []
  for r in rows {
    if let CN(k, _) = r[0] { heads = push(heads, k) }
  }
  var uni: List<(Key, List<Ty>)>? = None
  if len(heads) > 0 {
    let (c1, u) = universe(c, types[0], heads)
    c = c1
    uni = u
  }
  match uni {
    None => {
      var d: List<List<Cell>> = []
      for r in rows {
        if let CW = r[0] { d = push(d, skip(r, 1)) }
      }
      let (c2, w) = missing(c, d, skip(types, 1), depth + 1)
      return (c2, match w {
        Some(x) => Some(push([], "_") + x),
        None => None,
      })
    },
    Some(us) => {
      let top_l = match us[0].0 {
        KLen(_) => max_len(heads),
        _ => -1,
      }
      for (key, sub) in us {
        let n = len(sub)
        let sp = specialize(rows, key, n)
        let (c3, w) = missing(c, sp, sub + skip(types, 1), depth + 1)
        c = c3
        if let Some(x) = w {
          return (c, Some(push([], show_case(key, take(x, n), top_l)) + skip(x, n)))
        }
      }
      return (c, None)
    },
  }
}

fn missing_case(c: C, arms: List<Pat>, t: Ty) -> (C, Str?) {
  let (c1, w) = missing(c, map(arms, (p) => [CP(p)]), [t], 0)
  (c1, match w {
    Some(x) => Some(x[0]),
    None => None,
  })
}

fn pattern(c: C, p: Pat, t: Ty, sc: Sc, mt: Bool, ln: Int) -> Result<(C, Sc, Pat), F> {
  let names = pat_names(p)
  var dup: List<Str> = []
  for n in names {
    if len(filter(names, (x) => x == n)) > 1 && !contains(dup, n) { dup = push(dup, n) }
  }
  if len(dup) > 0 { return Err(te(c, ln, "模式里重复绑定了 " + join(sort(dup), "、"))) }
  pat(c, p, t, sc, mt, ln)
}

fn is_dots(p: Pat) -> Bool {
  match p {
    PDots => true,
    _ => false,
  }
}

fn expand_dots(c: C, subs: List<Pat>, n: Int, what: Str, ln: Int) -> Result<List<Pat>, F> {
  var i = -1
  var j = 0
  for x in subs {
    if is_dots(x) && i < 0 { i = j }
    j += 1
  }
  if i < 0 { return Ok(subs) }
  let fixed = len(subs) - 1
  if fixed > n { return Err(te(c, ln, "{what}只有 {n} 项，模式里写了 {fixed} 项")) }
  Ok(take(subs, i) + __repeat(PWild, n - fixed) + skip(subs, i + 1))
}

fn uniq_sorted(xs: List<Str>) -> List<Str> {
  var out: List<Str> = []
  for x in sort(xs) { if len(out) == 0 || out[len(out) - 1] != x { out = push(out, x) } }
  out
}

fn lit_ty(v: Lit) -> Ty {
  match v {
    LBool(_) => bool_t(),
    LInt(_) => int_t(),
    LBig(_) => int_t(),
    LFlt(_) => float_t(),
    LStr(_) => str_t(),
  }
}

fn pats(c0: C, ps: List<Pat>, ts: List<Ty>, sc0: Sc, mt: Bool, ln: Int) -> Result<(
  C, Sc, List<Pat>
), F> {
  var c = c0
  var sc = sc0
  var out: List<Pat> = []
  var i = 0
  for p in ps {
    let (c1, s1, q) = pat(c, p, ts[i], sc, mt, ln)?
    c = c1
    sc = s1
    out = push(out, q)
    i += 1
  }
  Ok((c, sc, out))
}

fn lit_repr(v: Lit) -> Str {
  match v {
    LStr(s) => repr_str(s),
    LInt(i) => "{i}",
    LFlt(f) => "{f}",
    _ => val.dump(ast.lit_v(v)),
  }
}

fn lit_lt(a: Lit, b: Lit) -> Bool {
  match (a, b) {
    (LInt(x), LInt(y)) => x < y,
    (LFlt(x), LFlt(y)) => x < y,
    (LStr(x), LStr(y)) => x < y,
    _ => false,
  }
}

fn lit_eq(a: Lit, b: Lit) -> Bool {
  match (a, b) {
    (LInt(x), LInt(y)) => x == y,
    (LFlt(x), LFlt(y)) => x == y,
    (LStr(x), LStr(y)) => x == y,
    _ => false,
  }
}

fn lit_rt(v: Lit) -> Str {
  match v {
    LStr(_) => "Str",
    LFlt(_) => "Float",
    _ => "Int",
  }
}

fn pat(c0: C, p: Pat, t: Ty, sc0: Sc, mt: Bool, ln: Int) -> Result<(C, Sc, Pat), F> {
  var c = c0
  var sc = sc0
  match p {
    PWild => { return Ok((c, sc, p)) },
    POr(xs) => {
      let names = uniq_sorted(pat_names(xs[0]))
      let (c1, vs) = fresh_n(c, len(names))
      c = c1
      var alts: List<Pat> = []
      var muts: List<Str> = []
      for a in xs {
        let got = uniq_sorted(pat_names(a))
        if got != names {
          let fmt = (ns: List<Str>) => if len(ns) > 0 { join(ns, "、") } else { "（无）" }
          return Err(te(c, ln, "或模式的每个分支必须绑定相同的变量：{fmt(names)} 与 {fmt(got)}"))
        }
        let (c2, tmp, q) = pat(c, a, t, frame(sc), mt, ln)?
        c = c2
        alts = push(alts, q)
        let vars = frame_vars(tmp)
        var i = 0
        for n in names {
          let en = unwrap(get(vars, n))
          c = unify(c, vs[i], ft_ty(en.t), ln, "或模式里的 {n}")?
          if en.mt { muts = push(muts, n) }
          i += 1
        }
      }
      var i = 0
      for n in names {
        let (c3, s3) = define(c, sc, n, ent(vs[i], mt || contains(muts, n), false))
        c = c3
        sc = s3
        i += 1
      }
      return Ok((c, sc, POr(alts)))
    },
    PBind(n) => {
      let (c1, s1) = define(c, sc, pname(n), ent(t, mt, false))
      return Ok((rec(c1, pname(n), t, ln, if mt { "var" } else { "let" }), s1, p))
    },
    PVar(n) => {
      let (c1, s1) = define(c, sc, pname(n), ent(t, true, false))
      return Ok((rec(c1, pname(n), t, ln, "var"), s1, p))
    },
    PAt(a, b) => {
      let (c1, s1, sub) = pat(c, b, t, sc, mt, ln)?
      let (c2, s2, _) = pat(c1, a, t, s1, mt, ln)?
      return Ok((c2, s2, PAt(a, sub)))
    },
    PLit(l) => {
      let c1 = unify(c, t, lit_ty(l), ln, "模式")?
      return Ok((c1, sc, p))
    },
    PRange(lo, hi, inc) => {
      if is_some(lo) && is_some(hi) {
        let a = unwrap(lo)
        let b = unwrap(hi)
        if lit_rt(a) != lit_rt(b) { return Err(te(c, ln, "区间模式两端的类型不一致")) }
        if lit_lt(b, a) || lit_eq(b, a) && !inc {
          return Err(
            te(
              c,
              ln,
              "区间模式 {lit_repr(a)}.." + (if inc { "=" } else { "" }) + "{lit_repr(b)} 是空的",
            ),
          )
        }
      }
      let c1 = unify(
        c,
        t,
        tcon(lit_rt(match lo {
          Some(x) => x,
          None => match hi {
            Some(y) => y,
            None => LInt(0),
          },
        })),
        ln,
        "区间模式",
      )?
      return Ok((c1, sc, p))
    },
    PDots => { return Err(te(c, ln, ".. 只能出现在元组、变体或列表模式里")) },
    PTuple(subs0) => {
      var subs = subs0
      if any(subs, is_dots) {
        let pt = pr(c, t)
        if !(tname(pt) == "Tuple" && is_con(pt)) {
          return Err(te(c, ln, "带 .. 的元组模式需要已知长度的元组"))
        }
        subs = expand_dots(c, subs, len(targs(pt)), "元组", ln)?
      }
      let (c1, ts) = fresh_n(c, len(subs))
      let c2 = unify(c1, t, TC("Tuple", ts), ln, "元组模式")?
      let (c3, s3, qs) = pats(c2, subs, ts, sc, mt, ln)?
      return Ok((c3, s3, PTuple(qs)))
    },
    PList(pre_, rest, post) => {
      let (c1, el) = fresh(c)
      let c2 = unify(c1, t, list_t(el), ln, "列表模式")?
      let (c3, s3, qa) = pats(c2, pre_, __repeat(el, len(pre_)), sc, mt, ln)?
      let (c4, s4, qb) = pats(c3, post, __repeat(el, len(post)), s3, mt, ln)?
      c = c4
      sc = s4
      if let Some(r) = rest {
        if r != "_" && r != "" {
          let (c5, s5) = define(c, sc, r, ent(list_t(el), mt, false))
          c = rec(c5, r, list_t(el), ln, if mt { "var" } else { "let" })
          sc = s5
        }
      }
      return Ok((c, sc, PList(qa, rest, qb)))
    },
    PVariant(nv, subs0) => {
      let name = pname(nv)
      if contains(c.variant_owner, name) {
        var en = unwrap(get(c.variant_owner, name))
        let q = match nv {
          NmQ(_, Some(x)) => x,
          _ => "",
        }
        let pt = pr(c, t)
        if q != "" && contains(c.enums, q) && has_variant(c, q, name) {
          en = q
        } else if is_con(pt) && contains(c.enums, tname(pt)) && has_variant(c, tname(pt), name) {
          en = tname(pt)
        }
        let gens = gens_of(c, en)
        let (c1, gv) = fresh_n(c, len(gens))
        var gm: Map<Str, Ty> = Map()
        var i = 0
        for g in gens {
          gm = set(gm, g, gv[i])
          i += 1
        }
        c = unify(c1, t, TC(en, gv), ln, "模式 {name}")?
        let fs = vf_fields(variant_fs(c, en, name))
        let subs1 = match subs0 {
          Some(x) => x,
          None => { return Ok((c, sc, p)) },
        }
        let subs = expand_dots(c, subs1, len(fs), "变体 {name} ", ln)?
        if len(subs) != len(fs) {
          return Err(te(c, ln, "模式 {name} 需要 {len(fs)} 个字段，给了 {len(subs)} 个"))
        }
        var fts: List<Ty> = []
        for f in fs {
          let (c2, ft) = conv(c, Some(f.1), gm, false)?
          c = c2
          fts = push(fts, ft)
        }
        let (c3, s3, qs) = pats(c, subs, fts, sc, mt, ln)?
        return Ok((c3, s3, PVariant(nv, Some(qs))))
      }
      if is_none(subs0) && contains(c.structs, name) {
        let (c1, gv) = fresh_n(c, len(gens_of(c, name)))
        let c2 = unify(c1, t, TC(name, gv), ln, "")?
        return Ok((c2, sc, p))
      }
      if is_none(subs0) && contains(c.const_lits, name) && is_some(sc_find(c, sc, name)) {
        return pat(c, PLit(unwrap(get(c.const_lits, name))), t, sc, mt, ln)
      }
      if is_none(subs0) && first_upper(name) && is_some(sc_find(c, sc, name)) {
        return Err(
          te(c, ln, "常量 {name} 的值不是字面量，不能用作模式（请改用守卫 if x == {name}）"),
        )
      }
      return Err(te(c, ln, "未知的变体 {name}"))
    },
    PStruct(nv, fs) => {
      let name = pname(nv)
      var gens: List<Str> = []
      var en = name
      var decl: List<(Str, TyX?)> = []
      if contains(c.structs, name) {
        gens = gens_of(c, name)
        decl = unwrap(get(c.structs, name)).1
      } else if contains(c.variant_owner, name) {
        en = unwrap(get(c.variant_owner, name))
        gens = gens_of(c, en)
        decl = map(vf_fields(variant_fs(c, en, name)), (f) => (f.0, Some(f.1)))
      } else {
        return Err(te(c, ln, "未知类型 {name}"))
      }
      let (c1, gv) = fresh_n(c, len(gens))
      var gm: Map<Str, Ty> = Map()
      var i = 0
      for g in gens {
        gm = set(gm, g, gv[i])
        i += 1
      }
      c = unify(c1, t, TC(en, gv), ln, "模式 {name}")?
      var out: List<(Str, Pat)> = []
      for f in fs {
        let fname = f.0
        var dt: TyX? = None
        var found = false
        for d in decl {
          if d.0 == fname {
            dt = d.1
            found = true
          }
        }
        if !found { return Err(te(c, ln, "{name} 没有字段 {fname}")) }
        let (c2, ft) = conv(c, dt, gm, false)?
        let (c3, s3, q) = pat(c2, f.1, ft, sc, mt, ln)?
        c = c3
        sc = s3
        out = push(out, (fname, q))
      }
      return Ok((c, sc, PStruct(nv, out)))
    },
  }
}
// ───────── 约束求解 ─────────

fn solve_constraints(cin: C) -> C {
  var c = cin
  var round = 0
  while round < 4 {
    let todo = c.deferred
    c = C { deferred: [], ..c }
    for (e, a, ln, ctx) in todo {
      match unify(c, e, a, ln, ctx) {
        Ok(c1) => { c = c1 },
        Err(f) => { c = add_err(c, f) },
      }
    }
    if len(c.deferred) == 0 || len(c.deferred) == len(todo) { break }
    round += 1
  }
  for (e, a, ln, ctx) in c.deferred {
    c = C {
      errors: push(
        c.errors,
        (ln, "类型错误: " + pre(ctx) + "无法确定 {sh(c, e)} 和 {sh(c, a)} 是否一致，请加类型标注"),
      ),
      ..c
    }
  }
  c = C { deferred: [], ..c }
  let c0 = c
  for (t0, kd, ln) in c0.cons {
    var t = pr(c, t0)
    match kd {
      KVar(vn, alts) => {
        if is_con(t) && contains(alts, tname(t)) { continue }
        let en = alts[len(alts) - 1]
        let (c1, gv) = fresh_n(c, len(gens_of(c, en)))
        match unify(c1, t, TC(en, gv), ln, "变体 {vn}") {
          Ok(c2) => { c = c2 },
          Err(f) => { c = add_err(c, f) },
        }
        continue
      },
      KImpl(tr) => {
        if !implements(c, t, tr) {
          let hint = if is_tr(t) {
            "（给泛型参数加约束 {sh(c, t)}: {tr}）"
          } else {
            "（需要 impl {tr} for {sh(c, t)}）"
          }
          c = C { errors: push(c.errors, (ln, "类型错误: {sh(c, t)} 没有实现 {tr}{hint}")), ..c }
        }
        continue
      },
      _ => (),
    }
    let kn = match kd {
      KNum => "num",
      KAdd => "add",
      _ => "ord",
    }
    if let TR(rn, bs) = t {
      let need = if kn == "ord" { "Ord" } else { "Num" }
      if !has_bound(c, bs, need) {
        let what = if kn == "num" {
          "数值运算"
        } else if kn == "add" {
          "+ 运算"
        } else {
          "大小比较"
        }
        let alt = if kn == "add" {
          "Add"
        } else if kn == "ord" {
          "Cmp"
        } else {
          "Sub/Mul/Div/Rem/Neg"
        }
        c = C {
          errors: push(
            c.errors,
            (
              ln,
              "类型错误: 泛型 {rn} 不能做 {what}，请加约束 {rn}: {need}（或运算符 trait {rn}: {alt}）",
            ),
          ),
          ..c
        }
      }
      continue
    }
    if let TV(i) = t {
      c = C { sub: set(c.sub, i, int_t()), ..c }
      t = int_t()
    }
    if is_anyn(t) { continue }
    let ok = if kn == "num" {
      ["Int", "Float"]
    } else if kn == "add" {
      ["Int", "Float", "Str", "List"]
    } else {
      ["Int", "Float", "Str"]
    }
    if !(is_con(t) && contains(ok, tname(t))) {
      let what = if kn == "num" { "数值运算" } else if kn == "add" { "+ 运算" } else { "大小比较" }
      c = C { errors: push(c.errors, (ln, "类型错误: {what}不支持类型 {sh(c, t)}")), ..c }
    }
  }
  C { cons: [], ..c }
}

fn solve_ord_sites(c0: C) -> C {
  var c = c0
  for (name, el, n, ln, fnode) in c0.ord_sites {
    let t = pr(c, el)
    let cmpn = if name == "sort" {
      "__sort_cmp"
    } else {
      "__{name}" + (if n == 2 { "2" } else { "" }) + "_cmp"
    }
    if let TR(rn, bs) = t {
      if has_bound(c, bs, "Ord") { continue }
      if has_bound(c, bs, "Cmp") {
        c = add_patch(c, fnode, PtName(cmpn))
        continue
      }
      c = C {
        errors: push(
          c.errors,
          (ln, "类型错误: {name} 需要可比较的元素，请给泛型加约束 {rn}: Ord 或 {rn}: Cmp"),
        ),
        ..c
      }
      continue
    }
    let h = tname(t)
    if h == ""
      || h == "Option"
      || h == "Result"
      || !(contains(c.structs, h) || contains(c.enums, h)) {
      continue
    }
    if !contains(c.impls, h + "|Cmp") {
      c = C {
        errors: push(
          c.errors,
          (ln, "类型错误: {name} 需要可比较的元素：{sh(c, t)} 没有实现 Cmp（impl Cmp for {h}）"),
        ),
        ..c
      }
    } else {
      c = add_patch(c, fnode, PtName(cmpn))
    }
  }
  C { ord_sites: [], ..c }
}

// ───────── 静态方法改写（kite.py 的 lower_statics）─────────

fn subst_self(t: TyX?, tt: TyX) -> TyX? {
  match t {
    Some(x) => Some(subst_self1(x, tt)),
    None => None,
  }
}

fn subst_self1(t: TyX, tt: TyX) -> TyX {
  match t {
    YCon(n, a, l) => if n == "Self" && len(a) == 0 {
      tt
    } else {
      YCon(n, map(a, (x) => subst_self1(x, tt)), l)
    },
    YTup(a, l) => YTup(map(a, (x) => subst_self1(x, tt)), l),
    YFn(a, r, l) => YFn(map(a, (x) => subst_self1(x, tt)), subst_self1(r, tt), l),
    _ => t,
  }
}

fn pub_vis(p: Bool) -> Vis? { Some(Vis { is_pub: p, vis: None, has_vis: false }) }

fn fn_body(n: Node) -> Node? { fnd(n).body }

fn set_body(n: Node, b: Node?) -> Node {
  let f = fnd(n)
  with_fnd(n, FnD { body: b, ..f })
}

fn walk_body(n: Node, w: fn(Node) -> Node) -> Node {
  match fn_body(n) {
    Some(b) => set_body(n, Some(w(b))),
    None => n,
  }
}

fn lower_statics(its: List<Node>) -> List<Node> {
  var statics: List<Str> = []
  var extra: List<(Node, Str)> = []
  for it in its {
    if !is_k(it, "Impl") { continue }
    let d = implv(it)
    if is_some(d.tr) { continue }
    let target = d.target
    let tt = d.target_t
    for m in d.methods {
      if has_self(m) { continue }
      let mf = fnd(m)
      statics = push(statics, target + "|" + mf.name)
      var b = d.gen.bounds
      for (k, v) in mf.gen.bounds { b = push(filter(b, (kv) => kv.0 != k), (k, v)) }
      let ign = d.gen.names
      let gens = ign + filter(mf.gen.names, (g) => !contains(ign, g))
      let ps = map(mf.params, (p) => (p.0, subst_self(p.1, tt)))
      let cg = d.gen.cgens + filter(mf.gen.cgens, (g) => !contains(d.gen.cgens, g))
      let fd = FnD {
        name: target + "." + mf.name,
        params: ps,
        ret: subst_self(mf.ret, tt),
        body: mf.body,
        gen: Gen { names: gens, bounds: b, cgens: cg },
        is_async: mf.is_async,
        is_unsafe: mf.is_unsafe,
        varargs: false,
        ext: None,
        cname: None,
        x: FnX { static_of: Some(target), ..ast.no_fnx() },
      }
      let pv = match m.vis {
        Some(v) => v.is_pub,
        None => true,
      }
      let fnv = Node { vis: pub_vis(pv), pre: it.pre, ..ast.mkn(m.line, NFn(fd)) }
      extra = push(extra, (fnv, target))
    }
  }
  if len(statics) == 0 { return its }
  let ex = map(extra, (x) => walk_body(x.0, (b) => walk_st(b, x.1, statics)))
  map(its, (it) => walk_st(it, "", statics)) + ex
}

fn walk_st(x: Node, target0: Str, st: List<Str>) -> Node {
  let target = if is_k(x, "Impl") { implv(x).target } else { target0 }
  if let NField(obj, fname0) = x.k {
    let fname = ast.nm_str(fname0)
    if let Some(on) = name_of(obj) {
      let q = if on == "Self" && target != "" { target } else { on }
      if contains(st, q + "|" + fname) { return name_n(x.line, q + "." + fname) }
    }
  }
  ast.with_kids(x, map(ast.kids(x), (y) => walk_st(y, target, st)))
}

// ───────── 关联常量改写（kite.py 的 lower_consts）─────────

fn mk_body(e: Node, ln: Int) -> Node { ast.mkn(ln, NBlock([ast.mkn(ln, NExprStmt(e))], false)) }

// __c_N 方法（trait 里 / impl 里）：字段和 Python 版 lower_consts 生成的完全一样
fn cfn(name: Str, ln: Int, ret: TyX, body: Node?, cname: Str) -> Node {
  let fd = FnD {
    name: name,
    params: [("self", None)],
    ret: Some(ret),
    body: body,
    gen: ast.no_gen(),
    is_async: false,
    is_unsafe: false,
    varargs: false,
    ext: None,
    cname: None,
    x: FnX { bare: true, const_name: Some(cname), ..ast.no_fnx() },
  }
  Node { attrs: Some([]), ..ast.mkn(ln, NFn(fd)) }
}

// impl 里的常量生成的顶层函数 "类型.N"()
fn cfn_top(name: Str, ln: Int, ret: TyX?, body: Node, it: Node, target: Str) -> Node {
  let d = implv(it)
  let fd = FnD {
    name: name,
    params: [],
    ret: ret,
    body: Some(body),
    gen: d.gen,
    is_async: false,
    is_unsafe: false,
    varargs: false,
    ext: None,
    cname: None,
    x: FnX { static_of: Some(target), ..ast.no_fnx() },
  }
  Node { vis: pub_vis(true), pre: it.pre, ..ast.mkn(ln, NFn(fd)) }
}

fn tclosure(t: Str, sup: Map<Str, List<Str>>, out0: List<Str>) -> List<Str> {
  if contains(out0, t) { return out0 }
  var out = push(out0, t)
  for s in unwrap_or(get(sup, t), []) { out = tclosure(s, sup, out) }
  out
}

type LC = { owned: List<Str>, tconsts: Map<Str, List<AConst>>, sup: Map<Str, List<Str>> }

fn lower_consts(its: List<Node>) -> Result<(List<Node>, Map<Str, List<(Str, TyX)>>), (Int, Str)> {
  var tconsts: Map<Str, List<AConst>> = Map()
  var sup: Map<Str, List<Str>> = Map()
  var tc2: Map<Str, List<(Str, TyX)>> = Map()
  var any_c = false
  for it in its {
    match it.k {
      NTrait(t) => {
        tconsts = set(tconsts, t.name, t.consts)
        tc2 = set(tc2, t.name, map(t.consts, (x) => (x.name, x.ty)))
        sup = set(sup, t.name, t.supers)
        if len(t.consts) > 0 { any_c = true }
      },
      NImpl(d) => { if len(d.consts) > 0 { any_c = true } },
      _ => (),
    }
  }
  if !any_c { return Ok((its, tc2)) }
  var owned: List<Str> = []
  var extra: List<(Node, Str)> = []
  var out: List<Node> = []
  for it in its {
    match it.k {
      NTrait(t) => {
        var ms = t.methods
        for cx in t.consts {
          let body = match cx.value {
            Some(v) => Some(mk_body(v, cx.line)),
            None => None,
          }
          ms = push(ms, cfn("__c_" + cx.name, cx.line, cx.ty, body, cx.name))
        }
        out = push(out, Node { k: NTrait(TraitD { methods: ms, ..t }), ..it })
      },
      NImpl(d) => {
        var given = d.consts
        if let Some(tr) = trait_name(d) {
          let decl = unwrap_or(get(tconsts, tr), [])
          let dn = map(decl, (x) => x.name)
          for cx in given {
            if contains(tconsts, tr) && !contains(dn, cx.name) {
              return Err((cx.line, "类型错误: trait {tr} 没有关联常量 {cx.name}"))
            }
          }
          let gn = map(given, (g) => g.name)
          for dc in decl {
            if !contains(gn, dc.name) && is_some(dc.value) { given = push(given, dc) }
          }
        }
        let target = d.target
        let tt = d.target_t
        var ms = d.methods
        for cx in given {
          let ln = cx.line
          let nm = cx.name
          let fnv = cfn_top(
            target + "." + nm,
            ln,
            subst_self(Some(cx.ty), tt),
            mk_body(unwrap(cx.value), ln),
            it,
            target,
          )
          extra = push(extra, (fnv, target))
          owned = push(owned, target + "|" + nm)
          let call = call_n(ln, name_n(ln, target + "." + nm), [])
          ms = push(ms, Node {
            vis: pub_vis(true),
            ..cfn("__c_" + nm, ln, cx.ty, Some(mk_body(call, ln)), nm)
          })
        }
        out = push(out, Node { k: NImpl(ImplD { methods: ms, ..d }), ..it })
      },
      _ => { out = push(out, it) },
    }
  }
  let lc = LC { owned: owned, tconsts: tconsts, sup: sup }
  var res: List<Node> = []
  for it in out {
    let w = walk_c(lc, it, "", "", false)?
    res = push(res, w)
  }
  for (fnv, target) in extra {
    var x = fnv
    if let Some(b) = fn_body(fnv) {
      let b2 = walk_c(lc, b, target, "", false)?
      x = set_body(fnv, Some(b2))
    }
    res = push(res, x)
  }
  Ok((res, tc2))
}

fn walk_cs(lc: LC, xs: List<Node>, target: Str, trn: Str, hs: Bool) -> Result<List<Node>, (
  Int, Str
)> {
  var out: List<Node> = []
  for y in xs {
    let w = walk_c(lc, y, target, trn, hs)?
    out = push(out, w)
  }
  Ok(out)
}

fn walk_c(lc: LC, x: Node, target0: Str, tr0: Str, hs0: Bool) -> Result<Node, (Int, Str)> {
  var target = target0
  var trn = tr0
  var hs = hs0
  let l = x.line
  match x.k {
    NImpl(d) => {
      target = d.target
      trn = ""
    },
    NTrait(t) => {
      target = ""
      trn = t.name
    },
    NFn(f) => { if (target != "" || trn != "") && !starts(f.name, "__c_") { hs = has_self(x) } },
    NField(obj, fname0) => {
      let fname = ast.nm_str(fname0)
      if let Some(on) = name_of(obj) {
        let q = if on == "Self" && target != "" { target } else { on }
        if contains(lc.owned, q + "|" + fname) {
          return Ok(call_n(l, name_n(l, q + "." + fname), []))
        }
        if q == "Self" && trn != "" {
          var hit = false
          for t in tclosure(trn, lc.sup, []) {
            for cx in unwrap_or(get(lc.tconsts, t), []) { if cx.name == fname { hit = true } }
          }
          if hit {
            if !hs { return Err((l, "类型错误: trait 里没有 self 的方法不能使用 Self.{fname}")) }
            return Ok(call_n(l, ast.mkn(l, NField(name_n(l, "self"), NmS("__c_" + fname))), []))
          }
        }
      }
    },
    _ => (),
  }
  // Python 版跳过 consts 字段：trait / impl 只走方法
  match x.k {
    NTrait(t) => {
      return Ok(Node {
        k: NTrait(TraitD { methods: walk_cs(lc, t.methods, target, trn, hs)?, ..t }),
        ..x
      })
    },
    NImpl(d) => {
      return Ok(Node {
        k: NImpl(ImplD { methods: walk_cs(lc, d.methods, target, trn, hs)?, ..d }),
        ..x
      })
    },
    _ => (),
  }
  Ok(ast.with_kids(x, walk_cs(lc, ast.kids(x), target, trn, hs)?))
}

// ───────── 入口 ─────────

// 返回 (错误 [(行, 文本)]，按行号稳定排序；每个用户顶层函数的签名；类型化 IR)
pub fn check(prelude: List<Node>, user: List<Node>) -> (
  List<(Int, Str)>,
  List<(Str, Str)>,
  List<Node>,
) {
  let (errs, sigs, low, _) = check_c(prelude, user)
  (errs, sigs, low)
}

fn mark_pre(it: Node) -> Node {
  match it.k {
    NTrait(t) => Node {
      pre: true,
      k: NTrait(TraitD { methods: map(t.methods, (x) => Node { pre: true, ..x }), ..t }),
      ..it
    },
    NImpl(d) => Node {
      pre: true,
      k: NImpl(ImplD { methods: map(d.methods, (x) => Node { pre: true, ..x }), ..d }),
      ..it
    },
    _ => Node { pre: true, ..it },
  }
}

// 同 check，另外返回检查器的最终状态（KIR 要用其中的签名表、替换表 sub 和各 impl 的 trait 默认方法 dflt）
pub fn check_c(prelude: List<Node>, user: List<Node>) -> (
  List<(Int, Str)>,
  List<(Str, Str)>,
  List<Node>,
  C,
) {
  let c0 = match install(new_c()) {
    Ok(c) => c,
    Err(f) => { return ([(f.ln, f.msg)], [], [], new_c()) },
  }
  let pmark = map(prelude, mark_pre)
  let (low, tconsts) = match lower_consts(pmark + user) {
    Ok(r) => r,
    Err((ln, m)) => {
      var sg: List<(Str, Str)> = []
      for it in user {
        if is_k(it, "Fn") && it.line < 1000000 { sg = push(sg, (fnd(it).name, "~")) }
      }
      return ([(ln, m)], sg, [], c0)
    },
  }
  let (its, nids) = number_list(lower_statics(low), 0)
  match check2(C { tconsts: tconsts, idn: nids, ..c0 }, its) {
    Ok((c, out)) => {
      var keyed: List<(Int, (Int, Str))> = []
      var i = 0
      for e in c.errors {
        keyed = push(keyed, (e.0 * 1000000 + i, e))
        i += 1
      }
      let errs = map(sort_by(keyed, (k) => k.0), (k) => k.1)
      var sigs: List<(Str, Str)> = []
      for it in user {
        if is_k(it, "Fn") && it.line < 1000000 {
          sigs = push(sigs, (fnd(it).name, match get(c.fsigs, fkey(it)) {
            Some(s) => sh(c, s),
            None => "~",
          }))
        }
      }
      if len(errs) > 0 { return (errs, sigs, [], c) }
      var dflt: Map<Str, Node> = Map()
      for k in keys(c.dflt) { dflt = set(dflt, k, patched(c.patch, unwrap(get(c.dflt, k)))) }
      (errs, sigs, map(out, (it) => with_va(c.vav, patched(c.patch, it))), C { dflt: dflt, ..c })
    },
    Err(f) => ([(-1, f.msg)], [], [], c0),
  }
}

// 返回类型化 IR：函数 / impl 换成检查过的版本，顶层语句换成检查结果，其余声明不变
fn check2(c0: C, its: List<Node>) -> Result<(C, List<Node>), F> {
  let (c1, _) = declare(c0, its, STop)?
  var c = c1
  var out: List<Node> = []
  for it in its {
    if !is_decl(kname(it)) {
      match stmt(c, it, STop) {
        Ok((c2, _, _, x)) => {
          c = c2
          out = push(out, x)
        },
        Err(f) => {
          if is_unsup(f) { return Err(f) }
          c = add_err(c, f)
          out = push(out, it)
        },
      }
    } else {
      out = push(out, it)
    }
  }
  var i = 0
  for it in its {
    if is_k(it, "Fn") {
      match check_fn_body(c, it, STop, None) {
        Ok((c2, x)) => {
          c = c2
          out = set(out, i, x)
        },
        Err(f) => {
          if is_unsup(f) { return Err(f) }
          c = add_err(c, f)
        },
      }
    } else if is_k(it, "Impl") {
      let (c3, x) = check_impl_bodies(c, it, STop)?
      c = c3
      out = set(out, i, x)
    }
    i += 1
  }
  c = solve_constraints(c)
  c = solve_ord_sites(c)
  c = solve_cg_sites(c)
  Ok((c, out))
}

// ── 编号：每个节点一个 Node.id（检查后有编号的表达式才带类型；求解后的补丁按编号套用）──

fn number_ids(v: Node, n0: Int) -> (Node, Int) {
  let (ks, n) = number_list(ast.kids(v), n0 + 1)
  (ast.with_kids(Node { id: n0, ..v }, ks), n)
}

fn number_list(xs: List<Node>, n0: Int) -> (List<Node>, Int) {
  var n = n0
  var out: List<Node> = []
  for x in xs {
    let (y, n2) = number_ids(x, n)
    out = push(out, y)
    n = n2
  }
  (out, n)
}

fn add_patch(c: C, v: Node, p: Pt) -> C {
  if v.id < 0 { return c }
  C { patch: set(c.patch, v.id, push(unwrap_or(get(c.patch, v.id), []), p)), ..c }
}

// e 整个换成 new（Python 的 e.__dict__ 替换）：new 继承 e 的编号
fn repl(c: C, e: Node, new: Node) -> (C, Node) {
  if e.id < 0 { return (c, new) }
  (c, Node { id: e.id, ..new })
}

// 新建的节点给一个新编号（检查后才会带类型、才能挂补丁）
fn fid(c: C, v: Node) -> (C, Node) { (C { idn: c.idn + 1, ..c }, Node { id: c.idn, ..v }) }

// 新合成的子树里没有编号的节点都给一个新编号（已有编号的原节点保留）
fn fresh_ids(c0: C, v: Node) -> (C, Node) {
  if v.id >= 0 { return (c0, v) }
  var c = C { idn: c0.idn + 1, ..c0 }
  let v1 = Node { id: c0.idn, ..v }
  var ks: List<Node> = []
  for x in ast.kids(v1) {
    let (c1, y) = fresh_ids(c, x)
    c = c1
    ks = push(ks, y)
  }
  (c, ast.with_kids(v1, ks))
}

// 可变参数 extern 的各个变体（Python 版的 fn._va_variants），挂在 extern 声明上
fn with_va(vav: List<(Str, Str, List<Str>)>, it: Node) -> Node {
  let f = match it.k {
    NFn(x) => x,
    _ => { return it },
  }
  if is_none(f.ext) { return it }
  let vs = filter(vav, (t) => t.0 == f.name)
  if len(vs) == 0 { return it }
  with_fnd(it, FnD { x: FnX { va: map(vs, (t) => (t.1, t.2)), ..f.x }, ..f })
}

fn patch1(n: Node, p: Pt) -> Node {
  match (p, n.k) {
    (PtBounds(bs), NImpl(d)) => Node {
      k: NImpl(ImplD { gen: Gen { bounds: bs, ..d.gen }, ..d }),
      ..n
    },
    (PtExt(et), NFn(f)) => with_fnd(n, FnD { x: FnX { ext_tys: Some(et), ..f.x }, ..f }),
    (PtParams(hid), NFn(f)) => with_fnd(n, FnD { params: f.params + hid, ..f }),
    (PtArgs(extra), NCall(f, a)) => Node { k: NCall(f, a + extra), ..n },
    (PtName(nm), NName(_)) => Node { k: NName(nm), ..n },
    _ => n,
  }
}

// 套用求解后的补丁
fn patched(pm: Map<Int, List<Pt>>, n0: Node) -> Node {
  var n = n0
  if n.id >= 0 {
    if let Some(ps) = get(pm, n.id) { for p in ps { n = patch1(n, p) } }
  }
  ast.with_kids(n, map(ast.kids(n), (x) => patched(pm, x)))
}
