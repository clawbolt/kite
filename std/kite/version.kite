// std.kite.version：Kite 包的语义化版本（对应 Go 的 go/version；kitec 的包管理用的就是这一份）
//   Ver = (主, 次, 修订, 正式版 1 / 预发布 0, 预发布标签)；parse_version、vstr、vcmp（-1 / 0 / 1）
//   parse_constraint、satisfies：约束规则与 Cargo 一致——
//     "1.2.3" 或 "^1.2.3"  >=1.2.3 <2.0.0（0.x 时：^0.2.3 → <0.3.0，^0.0.3 → <0.0.4）
//     "~1.2.3"            >=1.2.3 <1.3.0
//     "=1.2.3"  ">=1.0"  "<2.0"  ">=1.0, <1.5"  "*"
//     预发布版本只在约束明确写了预发布时才匹配
//   字符串版：is_valid、compare、sat_str（版本满足约束）、max_ver、sort_vers
use std.kite.scanner as lexer

fn rpr(s: Str) -> Str { lexer.repr_str(s) }

fn is_digit(c: Str) -> Bool { c >= "0" && c <= "9" }

fn all_digits(s: Str) -> Bool {
  if s == "" { return false }
  for c in chars(s) { if !is_digit(c) { return false } }
  true
}

pub fn is_valid(s: Str) -> Bool { is_ok(parse_version(s)) }

// 两个版本字符串比较；有一个无效时返回 Err
pub fn compare(a: Str, b: Str) -> Result<Int, Str> {
  Ok(vcmp(parse_version(a)?, parse_version(b)?))
}

// (主, 次, 修订, 正式版 1 / 预发布 0, 预发布标签)
pub type Ver = (Int, Int, Int, Int, Str)

pub fn vcmp(a: Ver, b: Ver) -> Int {
  if a.0 != b.0 { return if a.0 < b.0 { -1 } else { 1 } }
  if a.1 != b.1 { return if a.1 < b.1 { -1 } else { 1 } }
  if a.2 != b.2 { return if a.2 < b.2 { -1 } else { 1 } }
  if a.3 != b.3 { return if a.3 < b.3 { -1 } else { 1 } }
  if a.4 == b.4 { 0 } else if a.4 < b.4 { -1 } else { 1 }
}

fn pre_ok(s: Str) -> Bool {
  if s == "" { return false }
  for c in chars(s) {
    if !(
      (c >= "0" && c <= "9")
        || (c >= "A" && c <= "Z")
        || (c >= "a" && c <= "z")
        || c == "."
        || c == "-"
    ) {
      return false
    }
  }
  true
}

pub fn parse_version(s0: Str) -> Result<Ver, Str> {
  let s = trim(s0)
  let bad = "无效的版本号 {rpr(s0)}（应为 主.次.修订，例如 1.2.0）"
  let i = __str_find(s, "-", 0)
  let core = if i >= 0 { __str_slice(s, 0, i) } else { s }
  let pre = if i >= 0 { __str_slice(s, i + 1, len(s)) } else { "" }
  if i >= 0 && !pre_ok(pre) { return Err(bad) }
  let ps = split(core, ".")
  if len(ps) != 3 || !all(ps, all_digits) { return Err(bad) }
  Ok(
    (
      unwrap(parse_int(ps[0])),
      unwrap(parse_int(ps[1])),
      unwrap(parse_int(ps[2])),
      if pre != "" { 0 } else { 1 },
      pre,
    ),
  )
}

pub fn vstr(v: Ver) -> Str { "{v.0}.{v.1}.{v.2}" + (if v.4 != "" { "-" + v.4 } else { "" }) }

fn partial(s: Str) -> Result<(List<Int>, Int), Str> {
  let parts = split(trim(s), ".")
  if len(parts) < 1 || len(parts) > 3 || !all(parts, all_digits) {
    return Err("无效的版本约束 {rpr(s)}")
  }
  var nums = map(parts, (p) => unwrap(parse_int(p)))
  let n = len(nums)
  while len(nums) < 3 { nums = push(nums, 0) }
  Ok((nums, n))
}

fn ver_tail_ok(s: Str) -> Bool {
  let cs = chars(s)
  if len(cs) == 0 || !is_digit(cs[0]) { return false }
  for c in cs {
    if !(
      (c >= "0" && c <= "9")
        || (c >= "A" && c <= "Z")
        || (c >= "a" && c <= "z")
        || c == "."
        || c == "-"
    ) {
      return false
    }
  }
  true
}

// 返回 [(运算符, 版本)]，全部满足才算匹配
pub fn parse_constraint(c0: Str) -> Result<List<(Str, Ver)>, Str> {
  let c = trim(c0)
  if c == "*" || c == "" { return Ok([]) }
  var out: List<(Str, Ver)> = []
  for part0 in split(c, ",") {
    let part = trim(part0)
    var op = ""
    for o in [">=", "<=", "^", "~", "=", ">", "<"] {
      if op == "" && starts_with(part, o) { op = o }
    }
    let ver = trim(__str_slice(part, len(op), len(part)))
    if !ver_tail_ok(ver)
      || (
        op != ""
          && ver != __str_slice(part, len(op), len(part))
          && trim(__str_slice(part, len(op), len(part))) != ver
      ) {
      return Err("无效的版本约束 {rpr(part)}")
    }
    if op == "" { op = "^" }
    var nums: List<Int> = []
    var n = 0
    var lo: Ver = (0, 0, 0, 0, "")
    if contains(ver, "-") {
      let pv = parse_version(ver)?
      nums = [pv.0, pv.1, pv.2]
      n = 3
      lo = pv
    } else {
      let (ns, k) = partial(ver)?
      nums = ns
      n = k
      lo = (nums[0], nums[1], nums[2], 0, "")
    }
    if op == "^" {
      let hi = if nums[0] > 0 || n == 1 {
        (nums[0] + 1, 0, 0, 0, "")
      } else if nums[1] > 0 || n == 2 {
        (0, nums[1] + 1, 0, 0, "")
      } else {
        (0, 0, nums[2] + 1, 0, "")
      }
      out = out + [(">=", lo), ("<", hi)]
    } else if op == "~" {
      let hi = if n == 1 { (nums[0] + 1, 0, 0, 0, "") } else { (nums[0], nums[1] + 1, 0, 0, "") }
      out = out + [(">=", lo), ("<", hi)]
    } else if op == "=" {
      if n < 3 { return Err("= 约束需要完整版本号: {rpr(part)}") }
      out = push(out, ("=", parse_version(ver)?))
    } else {
      out = push(out, (op, if op == ">=" || op == "<" || lo.4 != "" {
        lo
      } else {
        (nums[0], nums[1], nums[2], 1, "")
      }))
    }
  }
  Ok(out)
}

pub fn satisfies(v: Ver, cons: List<(Str, Ver)>) -> Bool {
  for (op, b) in cons {
    let c = vcmp(v, b)
    if op == "=" && c != 0 { return false }
    if op == ">=" && c < 0 { return false }
    if op == ">" && c <= 0 { return false }
    if op == "<" && c >= 0 { return false }
    if op == "<=" && c > 0 { return false }
  }
  // 预发布版本只在约束明确写了预发布时才匹配
  if v.3 == 0 && !any(cons, (x) => x.1.3 == 0 && x.1.4 != "") { return false }
  true
}

pub fn sat_str(v: Str, c: Str) -> Bool {
  match (parse_version(v), parse_constraint(c)) {
    (Ok(a), Ok(b)) => satisfies(a, b),
    _ => false,
  }
}

pub fn max_ver(vs: List<Str>) -> Str {
  var best = vs[0]
  for v in vs { if vcmp(unwrap(parse_version(v)), unwrap(parse_version(best))) > 0 { best = v } }
  best
}

pub fn sort_vers(vs: List<Str>) -> List<Str> {
  sort_with(vs, (a, b) => vcmp(unwrap(parse_version(a)), unwrap(parse_version(b))))
}
