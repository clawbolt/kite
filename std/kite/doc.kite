// std.kite.doc：从 Kite 源码提取文档（对应 Go 的 go/doc）
//   文档 = 声明正上方连续的 // 注释（中间可以夹 @属性 行）；文件开头的注释块是模块文档
//   from_source(name, src) / from_file(path) -> Result<Module, Str>：只收 pub 的 fn / type / enum / trait / const，
//     以及 impl（列出其中 pub 的方法；trait 的 impl 列出全部方法）
//   Item.decl 是声明的源码：fn 只到函数体前，type / enum / trait / const 是整个声明
//   synopsis(doc)：第一句；text(m)：纯文本（类似 go doc）；markdown(m)：Markdown
use std.fs
use std.path
use std.kite.ast as ast
use std.kite.parser as parser
use std.kite.ast.{ Node, K, Pat }

pub type Item = {
  kind: Str,
  name: Str,
  line: Int,
  decl: Str,
  doc: Str,
  attrs: List<Str>,
  methods: List<Item>,
}

pub type Module = { name: Str, doc: Str, items: List<Item> }

fn is_pub(n: Node) -> Bool {
  match n.vis {
    Some(v) => v.is_pub,
    None => false,
  }
}

fn comment_text(l: Str) -> Str? {
  let t = trim(l)
  if !starts_with(t, "//") { return None }
  let b = __str_slice(t, 2, len(t))
  Some(if starts_with(b, " ") { __str_slice(b, 1, len(b)) } else { b })
}

// 第 ln 行（从 1 开始）正上方的注释
fn doc_above(lines: List<Str>, ln: Int) -> Str {
  var i = ln - 2
  var out: List<Str> = []
  while i >= 0 {
    let t = trim(lines[i])
    if starts_with(t, "@") {
      i -= 1
      continue
    }
    match comment_text(lines[i]) {
      Some(c) => { out = [c] + out },
      None => { break },
    }
    i -= 1
  }
  join(out, "\n")
}

// 文件开头的注释块（遇到空行或代码为止）
fn head_doc(lines: List<Str>) -> Str {
  var out: List<Str> = []
  for l in lines {
    match comment_text(l) {
      Some(c) => { out = push(out, c) },
      None => { break },
    }
  }
  join(out, "\n")
}

// 从第 ln 行开头取声明源码。head_only：遇到深度 0 的 { 就停（函数体）；否则取到括号配平后的行尾
fn decl_text(lines: List<Str>, ln: Int, head_only: Bool) -> Str {
  var depth = 0
  var out: List<Str> = []
  var i = ln - 1
  var opened = false
  while i < len(lines) {
    let cs = chars(lines[i])
    var line = ""
    var j = 0
    var in_str = false
    var stop = false
    while j < len(cs) {
      let c = cs[j]
      if in_str {
        if c == "\\" && j + 1 < len(cs) {
          line = line + c + cs[j + 1]
          j += 2
          continue
        }
        if c == "\"" { in_str = false }
        line = line + c
        j += 1
        continue
      }
      if c == "/" && j + 1 < len(cs) && cs[j + 1] == "/" { break }
      if c == "\"" { in_str = true }
      if c == "(" || c == "[" || c == "\{" {
        if head_only && c == "\{" && depth == 0 {
          stop = true
          break
        }
        depth += 1
        opened = true
      }
      if c == ")" || c == "]" || c == "}" { depth -= 1 }
      line = line + c
      j += 1
    }
    out = push(out, rstrip(line))
    if stop { break }
    if depth <= 0 && (opened || !ends_with(trim(line), "=")) {
      if !head_only { break }
      if !ends_with(trim(line), ",") && !ends_with(trim(line), "(") { break }
    }
    i += 1
  }
  trim(join(out, "\n"))
}

fn rstrip(s: Str) -> Str {
  var n = len(s)
  while n > 0 && (__str_slice(s, n - 1, n) == " " || __str_slice(s, n - 1, n) == "\t") { n -= 1 }
  __str_slice(s, 0, n)
}

fn attrs_of(n: Node) -> List<Str> {
  match n.attrs {
    Some(xs) => map(xs, (a) => a.name),
    None => [],
  }
}

fn mk(lines: List<Str>, n: Node, kind: Str, name: Str, head_only: Bool) -> Item {
  Item {
    kind: kind,
    name: name,
    line: n.line,
    decl: decl_text(lines, n.line, head_only),
    doc: doc_above(lines, n.line),
    attrs: attrs_of(n),
    methods: [],
  }
}

fn binds(p: Pat) -> List<Str> {
  match p {
    PBind(n) => [ast.nm_str(n)],
    PVar(n) => [ast.nm_str(n)],
    PTuple(xs) => {
      var out: List<Str> = []
      for x in xs { out = out + binds(x) }
      out
    },
    _ => [],
  }
}

fn fn_name(n: Node) -> Str {
  match n.k {
    NFn(d) => d.name,
    _ => "",
  }
}

fn item_of(lines: List<Str>, n: Node) -> Item? {
  match n.k {
    NFn(d) => if is_pub(n) { Some(mk(lines, n, "fn", d.name, true)) } else { None },
    NStruct(name, _, _) => if is_pub(n) { Some(mk(lines, n, "type", name, false)) } else { None },
    NAlias(name, _, _) => if is_pub(n) { Some(mk(lines, n, "type", name, false)) } else { None },
    NEnum(name, _, _) => if is_pub(n) { Some(mk(lines, n, "enum", name, false)) } else { None },
    NTrait(t) => if is_pub(n) { Some(mk(lines, n, "trait", t.name, false)) } else { None },
    NLet(p, _, _, _, is_const) => {
      if !is_const || !is_pub(n) { return None }
      let names = binds(p)
      Some(mk(lines, n, "const", join(names, ", "), false))
    },
    NImpl(d) => {
      let all = match d.tr {
        Some(_) => true,
        None => false,
      }
      let ms = map(
        filter(d.methods, (m) => all || is_pub(m)),
        (m) => mk(lines, m, "fn", fn_name(m), true),
      )
      if len(ms) == 0 { return None }
      let it = mk(lines, n, "impl", d.target, true)
      Some(Item { methods: ms, ..it })
    },
    _ => None,
  }
}

pub fn from_source(name: Str, src: Str) -> Result<Module, Str> {
  let decls = parser.parse(src)?
  let lines = split(src, "\n")
  var items: List<Item> = []
  for n in decls {
    if let Some(it) = item_of(lines, n) { items = push(items, it) }
  }
  Ok(Module { name: name, doc: head_doc(lines), items: items })
}

// 模块名取文件名去掉 .kite
pub fn from_file(p: Str) -> Result<Module, Str> {
  let src = fs.read(p)?
  let b = path.base(p)
  from_source(if ends_with(b, ".kite") { __str_slice(b, 0, len(b) - 5) } else { b }, src)
}

// 第一句：到第一个句号（。或 ". "）或空行为止，换行并成空格
pub fn synopsis(doc: Str) -> Str {
  var out = ""
  for l in split(doc, "\n") {
    if trim(l) == "" { break }
    let s = if out == "" { trim(l) } else { out + " " + trim(l) }
    let i = __str_find(s, "。", 0)
    if i >= 0 { return __str_slice(s, 0, i + 1) }
    let k = __str_find(s, ". ", 0)
    if k >= 0 { return __str_slice(s, 0, k + 1) }
    out = s
  }
  out
}

fn indent(s: Str, pre: Str) -> Str {
  join(map(split(s, "\n"), (l) => if l == "" { l } else { pre + l }), "\n")
}

fn item_text(it: Item, pre: Str) -> List<Str> {
  var out: List<Str> = [indent(it.decl, pre)]
  if it.doc != "" { out = push(out, indent(it.doc, pre + "    ")) }
  for m in it.methods { out = out + item_text(m, pre + "    ") }
  out
}

pub fn text(m: Module) -> Str {
  var out: List<Str> = ["module {m.name}"]
  if m.doc != "" { out = out + ["", m.doc] }
  for it in m.items { out = out + [""] + item_text(it, "") }
  join(out, "\n") + "\n"
}

fn item_md(it: Item, level: Str) -> List<Str> {
  let title = if it.kind == "impl" { "impl {it.name}" } else { "{it.kind} {it.name}" }
  var out: List<Str> = ["{level} {title}", "", "```kite", it.decl, "```"]
  if it.doc != "" { out = out + ["", it.doc] }
  if contains(it.attrs, "deprecated") { out = out + ["", "**已废弃**"] }
  for x in it.methods { out = out + [""] + item_md(x, level + "#") }
  out
}

pub fn markdown(m: Module) -> Str {
  var out: List<Str> = ["# {m.name}"]
  if m.doc != "" { out = out + ["", m.doc] }
  for it in m.items { out = out + [""] + item_md(it, "##") }
  join(out, "\n") + "\n"
}
