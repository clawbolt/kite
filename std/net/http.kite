// std.net.http：HTTP/1.1 客户端与服务器（http:// 与 https://）
//   http.get(url) / http.post(url, body, content_type) / http.request(method, url, headers, body)
//   let l = http.listen(8080)?;  http.serve(l, handler)      handler: fn(http.Request) -> http.Response
//   http.text(200, "hi")、http.json(200, "\{\}")、http.html(...)、with_header(resp, k, v)
//   let c = http.client(url)?;  c.get("/a"); c.get("/b"); c.close()   复用同一个连接（keep-alive）
// 头部名一律转成小写。服务器支持 keep-alive：HTTP/1.1 默认保持连接，空闲 5 秒或处理满 100 个请求后关闭

use std.net
use std.strings
use std.strconv
use std.time
use std.net.textproto
use std.net.http.cookiejar

pub type Request = { method: Str, path: Str, query: Str, headers: Map<Str, Str>, body: Str }

pub type Response = { status: Int, headers: Map<Str, Str>, body: Str }

fn lookup(h: Map<Str, Str>, k: Str) -> Option<Str> {
  if contains(h, k) { Some(h[k]) } else { None }
}

impl Request {
  fn header(self, name: Str) -> Option<Str> { lookup(self.headers, lower(name)) }
}

impl Response {
  fn header(self, name: Str) -> Option<Str> { lookup(self.headers, lower(name)) }
}

pub fn response(status: Int, content_type: Str, body: Str) -> Response {
  Response { status: status, headers: Map([("content-type", content_type)]), body: body }
}

pub fn text(status: Int, body: Str) -> Response {
  response(status, "text/plain; charset=utf-8", body)
}

pub fn html(status: Int, body: Str) -> Response {
  response(status, "text/html; charset=utf-8", body)
}

pub fn json(status: Int, body: Str) -> Response { response(status, "application/json", body) }

pub fn with_header(r: Response, name: Str, value: Str) -> Response {
  Response { status: r.status, headers: set(r.headers, lower(name), value), body: r.body }
}

pub fn reason(status: Int) -> Str {
  match status {
    200 => "OK",
    201 => "Created",
    202 => "Accepted",
    204 => "No Content",
    301 => "Moved Permanently",
    302 => "Found",
    304 => "Not Modified",
    400 => "Bad Request",
    401 => "Unauthorized",
    403 => "Forbidden",
    404 => "Not Found",
    405 => "Method Not Allowed",
    409 => "Conflict",
    413 => "Payload Too Large",
    500 => "Internal Server Error",
    502 => "Bad Gateway",
    503 => "Service Unavailable",
    _ => "Unknown",
  }
}

// ── 报文读写 ──
fn read_headers(c: net.Conn) -> Result<Map<Str, Str>, Str> {
  var h = Map()
  while true {
    let line = c.read_line()?
    if line == "" { return Ok(h) }
    match strings.find(line, ":") {
      Some(i) => {
        h = set(
          h,
          lower(trim(strings.slice(line, 0, i))),
          trim(strings.slice(line, i + 1, len(line))),
        )
      },
      None => { return Err("无效的头部：{line}") },
    }
  }
  Ok(h)
}

fn hex_num(s: Str) -> Int {
  if s == "" { return -1 }
  var n = 0
  for c in chars(lower(s)) {
    let o = strings.ord(c)
    let v = if o >= 48 && o <= 57 { o - 48 } else if o >= 97 && o <= 102 { o - 87 } else { -1 }
    if v < 0 { return -1 }
    n = n * 16 + v
  }
  n
}

// to_eof：没有长度信息时一直读到连接关闭（响应），否则当作空（请求）
fn read_body(c: net.Conn, h: Map<Str, Str>, to_eof: Bool) -> Result<Str, Str> {
  if contains(lower(unwrap_or(lookup(h, "transfer-encoding"), "")), "chunked") {
    var out = ""
    while true {
      let line = c.read_line()?
      let size = hex_num(trim(split(line, ";")[0]))
      if size < 0 { return Err("无效的分块长度：{line}") }
      if size == 0 {
        while c.read_line()? != "" {}
        return Ok(out)
      }
      out = out + c.read_bytes(size)?
      c.read_line()?
    }
  }
  match lookup(h, "content-length") {
    Some(n) => match parse_int(n) {
      Ok(k) => c.read_bytes(k),
      Err(_) => Err("无效的 Content-Length：{n}"),
    },
    None => if to_eof { c.read_all() } else { Ok("") },
  }
}

fn head_lines(h: Map<Str, Str>, skip: List<Str>) -> Str {
  var out = ""
  for (k, v) in h {
    if !contains(skip, k) { out = out + "{k}: {v}\r\n" }
  }
  out
}

// ── 客户端 ──
type Url = { host: Str, port: Int, hostport: Str, path: Str, tls: Bool }

fn parse_url(url: Str) -> Result<Url, Str> {
  let (rest, tls) = match strings.strip_prefix(url, "http://") {
    Some(r) => (r, false),
    None => match strings.strip_prefix(url, "https://") {
      Some(r) => (r, true),
      None => { return Err("无效的 URL：{url}") },
    },
  }
  let slash = strings.find(rest, "/")
  let hostport = match slash {
    Some(i) => strings.slice(rest, 0, i),
    None => rest,
  }
  let path = match slash {
    Some(i) => strings.slice(rest, i, len(rest)),
    None => "/",
  }
  match strings.find(hostport, ":") {
    Some(i) => match parse_int(strings.slice(hostport, i + 1, len(hostport))) {
      Ok(p) => Ok(Url {
        host: strings.slice(hostport, 0, i),
        port: p,
        hostport: hostport,
        path: path,
        tls: tls,
      }),
      Err(_) => Err("无效的 URL：{url}"),
    },
    None => Ok(Url {
      host: hostport,
      port: if tls { 443 } else { 80 },
      hostport: hostport,
      path: path,
      tls: tls,
    }),
  }
}

fn dial(host: Str, port: Int, tls: Bool, cfg: net.TlsConfig) -> Result<net.Conn, Str> {
  if tls { net.connect_tls_with(host, port, cfg) } else { net.connect(host, port) }
}

fn wants_close(h: Map<Str, Str>) -> Bool {
  contains(lower(unwrap_or(lookup(h, "connection"), "")), "close")
}

// 在 c 上发一个请求并读完响应；返回 (响应, 这个连接还能不能继续用)
fn exchange(
  c: net.Conn,
  method: Str,
  hostport: Str,
  path: Str,
  headers: Map<Str, Str>,
  body: Str,
  keep: Bool,
) -> Result<(Response, Bool), Str> {
  var lower_h = Map()
  for (k, v) in headers { lower_h = set(lower_h, lower(k), v) }
  let conn = if keep { "keep-alive" } else { "close" }
  let head =
    "{method} {path} HTTP/1.1\r\nHost: {hostport}\r\nConnection: {conn}\r\nContent-Length: {__byte_len(body)}\r\n"
  c.write(head + head_lines(lower_h, ["host", "connection", "content-length"]) + "\r\n" + body)?
  let status_line = c.read_line()?
  let parts = split(status_line, " ")
  if len(parts) < 2 || !starts_with(parts[0], "HTTP/") { return Err("无效的响应：{status_line}") }
  let status = match parse_int(parts[1]) {
    Ok(s) => s,
    Err(_) => { return Err("无效的响应：{status_line}") },
  }
  let h = read_headers(c)?
  let framed = method == "HEAD"
    || status == 204
    || status == 304
    || contains(h, "content-length")
    || contains(lower(unwrap_or(lookup(h, "transfer-encoding"), "")), "chunked")
  let b = if method == "HEAD" || status == 204 || status == 304 {
    ""
  } else {
    read_body(c, h, true)?
  }
  Ok(
    (
      Response { status: status, headers: h, body: b },
      keep && framed && !wants_close(h) && parts[0] == "HTTP/1.1",
    ),
  )
}

// 一次性请求：新建连接，用完关闭
pub fn request(method: Str, url: Str, headers: Map<Str, Str>, body: Str) -> Result<Response, Str> {
  request_with(method, url, headers, body, net.tls_config())
}

// 同 request，但 https 用给定的 TLS 选项（自定义 CA、关闭校验）
pub fn request_with(
  method: Str,
  url: Str,
  headers: Map<Str, Str>,
  body: Str,
  tls: net.TlsConfig,
) -> Result<Response, Str> {
  let u = parse_url(url)?
  let c = dial(u.host, u.port, u.tls, tls)?
  defer { c.close() }
  let (resp, _) = exchange(c, method, u.hostport, u.path, headers, body, false)?
  Ok(resp)
}

pub fn get(url: Str) -> Result<Response, Str> { request("GET", url, Map(), "") }

pub fn post(url: Str, body: Str, content_type: Str) -> Result<Response, Str> {
  request("POST", url, Map([("content-type", content_type)]), body)
}

// 复用连接的客户端。slot 是容量为 1 的通道，当作可变的连接槽：取出连接 → 用 → 放回，
// 所以多个任务共用一个 Client 也是安全的（请求会排队）
pub type Client = {
  host: Str,
  port: Int,
  hostport: Str,
  tls: Bool,
  cfg: net.TlsConfig,
  slot: Chan<Option<net.Conn>>,
}

// url 只取 http(s)://主机:端口 部分；连接在第一次请求时才建立
pub fn client(url: Str) -> Result<Client, Str> { client_with(url, net.tls_config()) }

pub fn client_with(url: Str, tls: net.TlsConfig) -> Result<Client, Str> {
  let u = parse_url(url)?
  let slot = chan(1)
  send(slot, None)
  Ok(Client { host: u.host, port: u.port, hostport: u.hostport, tls: u.tls, cfg: tls, slot: slot })
}

fn take_conn(cl: Client) -> Result<(net.Conn, Bool), Str> {
  match recv(cl.slot) {
    Some(Some(c)) => Ok((c, true)),
    _ => match dial(cl.host, cl.port, cl.tls, cl.cfg) {
      Ok(c) => Ok((c, false)),
      Err(e) => {
        send(cl.slot, None)
        Err(e)
      },
    },
  }
}

impl Client {
  fn request(
    self,
    method: Str,
    path: Str,
    headers: Map<Str, Str>,
    body: Str,
  ) -> Result<Response, Str> {
    let (c, reused) = take_conn(self)?
    match exchange(c, method, self.hostport, path, headers, body, true) {
      Ok((resp, alive)) => {
        if alive {
          send(self.slot, Some(c))
        } else {
          c.close()
          send(self.slot, None)
        }
        Ok(resp)
      },
      Err(e) => {
        c.close()
        if !reused {
          send(self.slot, None)
          return Err(e)
        }
        // 复用的连接可能已被服务器关掉：换一个新连接重试一次
        match dial(self.host, self.port, self.tls, self.cfg) {
          Ok(c2) => match exchange(c2, method, self.hostport, path, headers, body, true) {
            Ok((resp, alive)) => {
              if alive {
                send(self.slot, Some(c2))
              } else {
                c2.close()
                send(self.slot, None)
              }
              Ok(resp)
            },
            Err(e2) => {
              c2.close()
              send(self.slot, None)
              Err(e2)
            },
          },
          Err(e2) => {
            send(self.slot, None)
            Err(e2)
          },
        }
      },
    }
  }

  fn get(self, path: Str) -> Result<Response, Str> { self.request("GET", path, Map(), "") }

  fn post(self, path: Str, body: Str, content_type: Str) -> Result<Response, Str> {
    self.request("POST", path, Map([("content-type", content_type)]), body)
  }

  fn close(self) {
    match recv(self.slot) {
      Some(Some(c)) => c.close(),
      _ => {},
    }
    send(self.slot, None)
  }
}

// ── 服务器 ──
// 监听所有地址；port 为 0 时由系统分配（看 .port）
pub fn listen(port: Int) -> Result<net.Listener, Str> { net.listen("0.0.0.0", port) }

// HTTPS 服务器：cert / key 是 PEM 文件
pub fn listen_tls(port: Int, cert: Str, key: Str) -> Result<net.Listener, Str> {
  net.listen_tls("0.0.0.0", port, cert, key)
}

fn send_response(c: net.Conn, r: Response, keep: Bool) -> Result<Unit, Str> {
  let conn = if keep { "keep-alive" } else { "close" }
  let head =
    "HTTP/1.1 {r.status} {reason(r.status)}\r\nContent-Length: {__byte_len(r.body)}\r\nConnection: {conn}\r\n"
  c.write(head + head_lines(r.headers, ["content-length", "connection"]) + "\r\n" + r.body)
}

// HTTP/1.1 默认保持连接，HTTP/1.0 要客户端明确要求
fn keep_alive(version: Str, h: Map<Str, Str>) -> Bool {
  let v = lower(unwrap_or(lookup(h, "connection"), ""))
  if version == "HTTP/1.1" { !contains(v, "close") } else { contains(v, "keep-alive") }
}

// 第一个请求最多等 10 秒，之后的空闲超时 5 秒；一个连接最多处理 100 个请求
fn serve_conn(c: net.Conn, handler: fn(Request) -> Response) -> Result<Unit, Str> {
  var n = 0
  while true {
    let line = match c.read_line_within(if n == 0 { 10000 } else { 5000 })? {
      Some(l) => l,
      None => { return Ok(()) },
    }
    if line != "" {
      let parts = split(line, " ")
      if len(parts) != 3 { return send_response(c, text(400, "Bad Request"), false) }
      let target = parts[1]
      let (path, query) = match strings.find(target, "?") {
        Some(i) => (strings.slice(target, 0, i), strings.slice(target, i + 1, len(target))),
        None => (target, ""),
      }
      let h = read_headers(c)?
      let body = read_body(c, h, false)?
      let req = Request { method: parts[0], path: path, query: query, headers: h, body: body }
      let resp = match recover(() => handler(req)) {
        Ok(r) => r,
        Err(_) => text(500, "Internal Server Error"),
      }
      n += 1
      let keep = keep_alive(parts[2], h) && !wants_close(resp.headers) && n < 100
      send_response(c, resp, keep)?
      if !keep { return Ok(()) }
    }
  }
  Ok(())
}

// 接受一个连接，处理它上面的所有请求（keep-alive）；handler panic 时回复 500
pub fn handle_one(l: net.Listener, handler: fn(Request) -> Response) -> Result<Unit, Str> {
  let c = l.accept()?
  defer { c.close() }
  serve_conn(c, handler)
}

// 依次处理 n 个连接（测试和脚本用）
pub fn serve_n(l: net.Listener, n: Int, handler: fn(Request) -> Response) {
  for _ in 0..n { handle_one(l, handler) }
}

// 一直服务下去：workers 个任务并发地接受连接（每个任务同一时间服务一个连接）
pub fn serve_with(l: net.Listener, workers: Int, handler: fn(Request) -> Response) {
  par_map(0..workers |> map((i) => i), (_) => {
    while true { handle_one(l, handler) }
  })
}

pub fn serve(l: net.Listener, handler: fn(Request) -> Response) { serve_with(l, 32, handler) }

// 把 "a=1&b=x%20y" 解析成 Map（处理 %XX 和 +）
pub fn parse_query(q: Str) -> Map<Str, Str> {
  var m = Map()
  for part in split(q, "&") {
    if part != "" {
      match strings.find(part, "=") {
        Some(i) => {
          m = set(
            m,
            url_decode(strings.slice(part, 0, i)),
            url_decode(strings.slice(part, i + 1, len(part))),
          )
        },
        None => { m = set(m, url_decode(part), "") },
      }
    }
  }
  m
}

// %XX 是 UTF-8 字节：连续的几个先收集起来再解码
pub fn url_decode(s: Str) -> Str {
  let cs = chars(s)
  var out = ""
  var bytes = []
  var i = 0
  while i < len(cs) {
    let b = if cs[i] == "%" && i + 2 < len(cs) { hex_num(cs[i + 1] + cs[i + 2]) } else { -1 }
    if b >= 0 {
      bytes = push(bytes, b)
      i += 3
    } else {
      out = out + utf8(bytes) + (if cs[i] == "+" { " " } else { cs[i] })
      bytes = []
      i += 1
    }
  }
  out + utf8(bytes)
}

fn utf8(bs: List<Int>) -> Str {
  var out = ""
  var i = 0
  while i < len(bs) {
    let b = bs[i]
    let n = if b < 128 {
      1
    } else if b >= 240 {
      4
    } else if b >= 224 {
      3
    } else if b >= 192 {
      2
    } else {
      0
    }
    if n == 0 || i + n > len(bs) {
      out = out + strings.chr(65533)
      i += 1
    } else {
      var cp = if n == 1 { b } else if n == 2 { b % 32 } else if n == 3 { b % 16 } else { b % 8 }
      for k in 1..n { cp = cp * 64 + bs[i + k] % 64 }
      out = out + strings.chr(cp)
      i += n
    }
  }
  out
}

// ───────────── 协议层纯函数（对齐 Go 1.27 net/http） ─────────────
// Header 就是 textproto.MIMEHeader（值不可变，add/set/del 返回新值）；canonical_header_key、header_write、
// has_token、status_text、detect_content_type、parse_http_version、parse_time、parse_cookie、read_cookies、
// cookie_valid。Cookie 类型在 std.net.http.cookiejar 里。

pub const TIME_FORMAT: Str = "Mon, 02 Jan 2006 15:04:05 GMT"
pub const SNIFF_LEN: Int = 512
pub const DEFAULT_MAX_HEADER_BYTES: Int = 1048576

pub fn new_header() -> textproto.MIMEHeader { textproto.new_header() }

pub fn canonical_header_key(s: Str) -> Str { textproto.canonical_mime_header_key(s) }

fn tok_char(o: Int) -> Bool {
  (o >= 48 && o <= 57)
    || (o >= 65 && o <= 90)
    || (o >= 97 && o <= 122)
    || o == 33
    || (o >= 35 && o <= 39)
    || o == 42
    || o == 43
    || o == 45
    || o == 46
    || (o >= 94 && o <= 96)
    || o == 124
    || o == 126
}

// httpguts.ValidHeaderFieldName（= Go 的 isToken）
pub fn valid_header_field_name(s: Str) -> Bool {
  if s == "" { return false }
  for b in __bytes(s) { if !tok_char(b) { return false } }
  true
}

// Header.Write / WriteSubset：按键排序，跳过非法键，值里的 \r \n 换成空格再去掉首尾空白
pub fn header_write_subset(h: textproto.MIMEHeader, exclude: List<Str>) -> Str {
  var out = ""
  for (k, vs) in h.sorted() {
    if contains(exclude, k) || !valid_header_field_name(k) { continue }
    for v0 in vs {
      let v = textproto.trim_string(replace(replace(v0, "\n", " "), "\r", " "))
      out = out + k + ": " + v + "\r\n"
    }
  }
  out
}

pub fn header_write(h: textproto.MIMEHeader) -> Str { header_write_subset(h, []) }

fn lower_b(b: Int) -> Int { if b >= 65 && b <= 90 { b + 32 } else { b } }

fn token_boundary(b: Int) -> Bool { b == 32 || b == 44 || b == 9 }

// hasToken：v 里是否含有以空格 / 逗号 / tab 为边界的 token（token 须为小写，ASCII 不区分大小写）
pub fn has_token(v0: Str, token0: Str) -> Bool {
  let v = __bytes(v0)
  let t = __bytes(token0)
  if len(t) > len(v) || len(t) == 0 { return false }
  if v0 == token0 { return true }
  var sp = 0
  while sp <= len(v) - len(t) {
    let b = v[sp]
    let ok = (b == t[0] || (b | 0x20) == t[0])
      && !(sp > 0 && !token_boundary(v[sp - 1]))
      && !(sp + len(t) != len(v) && !token_boundary(v[sp + len(t)]))
    if ok {
      var eq = true
      for i in 0..len(t) { if lower_b(v[sp + i]) != lower_b(t[i]) { eq = false } }
      if eq { return true }
    }
    sp += 1
  }
  false
}

// ParseHTTPVersion -> (major, minor, ok)
pub fn parse_http_version(vers: Str) -> (Int, Int, Bool) {
  if vers == "HTTP/1.1" { return (1, 1, true) }
  if vers == "HTTP/1.0" { return (1, 0, true) }
  let b = __bytes(vers)
  if !starts_with(vers, "HTTP/") || len(b) != 8 || b[6] != 46 { return (0, 0, false) }
  if b[5] < 48 || b[5] > 57 || b[7] < 48 || b[7] > 57 { return (0, 0, false) }
  (b[5] - 48, b[7] - 48, true)
}

// ParseTime：依次试 TimeFormat、RFC850、ANSIC，返回 unix 毫秒
pub fn parse_time(text: Str) -> Result<Int, Str> {
  var last = ""
  for layout in [TIME_FORMAT, "Monday, 02-Jan-06 15:04:05 MST", "Mon Jan _2 15:04:05 2006"] {
    match time.parse(layout, text) {
      Ok(t) => { return Ok(t) },
      Err(e) => { last = e },
    }
  }
  Err(last)
}

// ── Cookie 请求头 ──

fn cookie_value_byte(o: Int) -> Bool { o >= 32 && o < 127 && o != 34 && o != 59 && o != 92 }

fn cookie_path_byte(o: Int) -> Bool { o >= 32 && o < 127 && o != 59 }

fn cookie_value(raw0: Str, allow_dq: Bool) -> (Str, Bool, Bool) {
  var raw = raw0
  var quoted = false
  if allow_dq && len(__bytes(raw)) > 1 && starts_with(raw, "\"") && ends_with(raw, "\"") {
    raw = __str_slice(raw, 1, len(raw) - 1)
    quoted = true
  }
  for b in __bytes(raw) { if !cookie_value_byte(b) { return ("", quoted, false) } }
  (raw, quoted, true)
}

fn cut1(s: Str, sep: Str) -> (Str, Str, Bool) {
  let i = __str_find(s, sep, 0)
  if i < 0 {
    (s, "", false)
  } else {
    (__str_slice(s, 0, i), __str_slice(s, i + len(sep), len(s)), true)
  }
}

fn count_semi(s: Str) -> Int { len(split(s, ";")) - 1 }

// ParseCookie（解析 Cookie 请求头，Go 1.23+）
pub fn parse_cookie(line: Str) -> Result<List<cookiejar.Cookie>, Str> {
  let n = count_semi(line) + 1
  if n > 3000 { return Err("http: number of cookies exceeded limit") }
  if n == 1 && textproto.trim_string(line) == "" { return Err(cookiejar.ERR_BLANK_COOKIE) }
  var out = []
  for s0 in split(line, ";") {
    let s = textproto.trim_string(s0)
    let (name, value0, found) = cut1(s, "=")
    if !found { return Err(cookiejar.ERR_EQUAL_NOT_FOUND_IN_COOKIE) }
    if !valid_header_field_name(name) { return Err(cookiejar.ERR_INVALID_COOKIE_NAME) }
    let (value, quoted, ok) = cookie_value(value0, true)
    if !ok { return Err(cookiejar.ERR_INVALID_COOKIE_VALUE) }
    out = push(out, cookiejar.Cookie {
      name: name,
      value: value,
      quoted: quoted,
      ..cookiejar.new_cookie("", "")
    })
  }
  Ok(out)
}

// readCookies（Request.Cookies / Request.Cookie 的核心）：filter 为空时返回全部
pub fn read_cookies(h: textproto.MIMEHeader, filter: Str) -> List<cookiejar.Cookie> {
  let lines = h.values("Cookie")
  if len(lines) == 0 { return [] }
  var total = 0
  for l in lines { total += count_semi(l) + 1 }
  if total > 3000 { return [] }
  var out = []
  for l0 in lines {
    var line = textproto.trim_string(l0)
    while line != "" {
      let (part0, rest, _) = cut1(line, ";")
      line = rest
      let part = textproto.trim_string(part0)
      if part == "" { continue }
      let (name0, val0, _) = cut1(part, "=")
      let name = textproto.trim_string(name0)
      if !valid_header_field_name(name) { continue }
      if filter != "" && filter != name { continue }
      let (val, quoted, ok) = cookie_value(val0, true)
      if !ok { continue }
      out = push(out, cookiejar.Cookie {
        name: name,
        value: val,
        quoted: quoted,
        ..cookiejar.new_cookie("", "")
      })
    }
  }
  out
}

fn quote_byte(b: Int) -> Str { strconv.quote_rune(b) }

// Cookie.Valid：Ok(()) 或 Go 的错误文字
pub fn cookie_valid(c: cookiejar.Cookie) -> Result<Unit, Str> {
  if !valid_header_field_name(c.name) { return Err("http: invalid Cookie.Name") }
  match c.expires {
    Some(t) => { if time.utc(t).year < 1601 { return Err("http: invalid Cookie.Expires") } },
    None => {},
  }
  for b in __bytes(c.value) {
    if !cookie_value_byte(b) {
      return Err("http: invalid byte " + quote_byte(b) + " in Cookie.Value")
    }
  }
  for b in __bytes(c.path) {
    if !cookie_path_byte(b) {
      return Err("http: invalid byte " + quote_byte(b) + " in Cookie.Path")
    }
  }
  if c.domain != "" && !cookiejar.valid_cookie_domain(c.domain) {
    return Err("http: invalid Cookie.Domain")
  }
  if c.partitioned && !c.secure { return Err("http: partitioned cookies must be set with Secure") }
  Ok(())
}

// ── DetectContentType（sniff.go） ──

fn hx(s: Str) -> List<Int> {
  let b = __bytes(s)
  var out = []
  var i = 0
  while i < len(b) {
    out = push(out, hexv(b[i]) * 16 + hexv(b[i + 1]))
    i += 2
  }
  out
}

fn hexv(c: Int) -> Int { if c <= 57 { c - 48 } else if c <= 70 { c - 55 } else { c - 87 } }

fn has_prefix_b(d: List<Int>, p: List<Int>) -> Bool {
  if len(d) < len(p) { return false }
  for i in 0..len(p) { if d[i] != p[i] { return false } }
  true
}

fn masked(d: List<Int>, mask: List<Int>, pat: List<Int>) -> Bool {
  if len(d) < len(pat) { return false }
  for i in 0..len(pat) { if (d[i] & mask[i]) != pat[i] { return false } }
  true
}

fn html_sig(d: List<Int>, h0: Str) -> Bool {
  let h = __bytes(h0)
  if len(d) < len(h) + 1 { return false }
  for i in 0..len(h) {
    let b = h[i]
    let db = if b >= 65 && b <= 90 { d[i] & 0xDF } else { d[i] }
    if b != db { return false }
  }
  d[len(h)] == 32 || d[len(h)] == 62
}

fn is_ws(b: Int) -> Bool { b == 9 || b == 10 || b == 12 || b == 13 || b == 32 }

fn mp4_sig(d: List<Int>) -> Bool {
  if len(d) < 12 { return false }
  let size = d[0] * 16777216 + d[1] * 65536 + d[2] * 256 + d[3]
  if len(d) < size || size % 4 != 0 { return false }
  if d[4..8] != __bytes("ftyp") { return false }
  var st = 8
  while st < size {
    if st != 12 && d[st..st + 3] == __bytes("mp4") { return true }
    st += 4
  }
  false
}

const HTML_SIGS: List<Str> = [
  "<!DOCTYPE HTML",
  "<HTML",
  "<HEAD",
  "<SCRIPT",
  "<IFRAME",
  "<H1",
  "<DIV",
  "<FONT",
  "<TABLE",
  "<A",
  "<STYLE",
  "<TITLE",
  "<B",
  "<BODY",
  "<BR",
  "<P",
  "<!--",
]

// (种类, 掩码十六进制, 模式十六进制, 类型)；种类 0 = 精确前缀，1 = 掩码，2 = 跳过空白的掩码，3 = mp4
const SIGS: List<(Int, Str, Str, Str)> = [
  (2, "FFFFFFFFFF", "3C3F786D6C", "text/xml; charset=utf-8"),
  (0, "", "255044462D", "application/pdf"),
  (0, "", "252150532D41646F62652D", "application/postscript"),
