// ───────────── 报文读取（对齐 Go 1.27 的 ReadRequest / ReadResponse / chunked） ─────────────
// 输入是整块字节；读出头部后把正文也一次读完（= io.ReadAll(req.Body)），正文出错时 body 是出错前读到的部分、
// body_err 是错误文字（没有错误为 ""），rest 是正文之后剩下的字节（流水线里的下一条报文；正文出错时为 []）。
// trailer 是 chunked 正文后面的尾部头（Trailer 头声明过的键值为空列表）。

pub type WireRequest = {
  method: Str,
  url: url.URL,
  proto: Str,
  proto_major: Int,
  proto_minor: Int,
  header: textproto.MIMEHeader,
  content_length: Int,
  transfer_encoding: List<Str>,
  close: Bool,
  host: Str,
  trailer: textproto.MIMEHeader,
  request_uri: Str,
  body: List<Int>,
  body_err: Str,
  rest: List<Int>,
}

pub type WireResponse = {
  status: Str,
  status_code: Int,
  proto: Str,
  proto_major: Int,
  proto_minor: Int,
  header: textproto.MIMEHeader,
  content_length: Int,
  transfer_encoding: List<Str>,
  close: Bool,
  trailer: textproto.MIMEHeader,
  // Trailer 头声明的键数（读正文之前 Go 的 len(resp.Trailer)）
  trailer_declared: Int,
  body: List<Int>,
  body_err: Str,
  rest: List<Int>,
}

fn qgo(s: Str) -> Str { strconv.quote_go(s) }

fn qlist(xs: List<Str>) -> Str { "[" + join(map(xs, qgo), " ") + "]" }

fn bad_string(what: Str, v: Str) -> Str { what + " " + qgo(v) }

fn is_ows(b: Int) -> Bool { b == 32 || b == 9 }

fn hexval(b: Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    -1
  }
}

fn index_byte(d: List<Int>, from: Int, to: Int, b: Int) -> Int {
  var i = from
  while i < to {
    if d[i] == b { return i }
    i += 1
  }
  -1
}

// bufio.Reader（4096 字节缓冲）上的 ReadSlice('\n') + readChunkLine 的检查；返回 (行, 新位置, 错误)
fn read_chunk_line(d: List<Int>, pos: Int) -> (List<Int>, Int, Str) {
  let lim = if len(d) - pos > 4096 { pos + 4096 } else { len(d) }
  let nl = index_byte(d, pos, lim, 10)
  if nl < 0 {
    if lim == len(d) && len(d) - pos < 4096 { return ([], len(d), "unexpected EOF") }
    return ([], lim, "header line too long")
  }
  let p = d[pos..nl + 1]
  let cr = index_byte(p, 0, len(p), 13)
  if cr < 0 { return ([], nl + 1, "chunked line ends with bare LF") }
  if cr != len(p) - 2 { return ([], nl + 1, "invalid CR in chunked line") }
  let line = p[..len(p) - 2]
  if len(line) >= 4096 { return ([], nl + 1, "header line too long") }
  (line, nl + 1, "")
}

// chunked 解码（internal.NewChunkedReader 读到 EOF）：返回 (数据, 结束位置, 错误)。
// 错误为 "" 表示正常读到长度为 0 的块，位置在 "0\r\n" 之后（尾部头从这里开始）
pub fn chunked_decode(d: List<Int>, start: Int) -> (List<Int>, Int, Str) {
  var out: List<Int> = []
  var pos = start
  var excess = 0
  loop {
    let (line0, p2, e) = read_chunk_line(d, pos)
    pos = p2
    if e != "" { return (out, pos, e) }
    excess += len(line0) + 2
    var n0 = len(line0)
    while n0 > 0 && is_ows(line0[n0 - 1]) { n0 -= 1 }
    var line = line0[..n0]
    let semi = index_byte(line, 0, len(line), 59)
    if semi >= 0 { line = line[..semi] }
    if len(line) == 0 { return (out, pos, "empty hex number for chunk length") }
    var n = 0
    for i in 0..len(line) {
      let v = hexval(line[i])
      if v < 0 { return (out, pos, "invalid byte in chunk length") }
      if i == 16 { return (out, pos, "http chunk length too large") }
      n = (n << 4) | v
    }
    // n 最多 16 个十六进制位；超过 Int 正数范围时按溢出后的值处理（Go 里是 uint64）
    excess = excess - 16 - 2 * n
    if excess < 0 { excess = 0 }
    if excess > 16 * 1024 { return (out, pos, "chunked encoding contains too much non-data") }
    if n == 0 { return (out, pos, "") }
    if n < 0 || len(d) - pos < n {
      return (out + d[pos..], len(d), "unexpected EOF")
    }
    out = out + d[pos..pos + n]
    pos += n
    if len(d) - pos < 2 { return (out, len(d), "unexpected EOF") }
    if d[pos] != 13 || d[pos + 1] != 10 { return (out, pos + 2, "malformed chunked encoding") }
    pos += 2
  }
}

// httputil.NewChunkedWriter：每次 Write（非空）写 "%x\r\n" + 数据 + "\r\n"，Close 写 "0\r\n"
pub fn chunked_encode(chunks: List<List<Int>>) -> List<Int> {
  var out: List<Int> = []
  for c in chunks {
    if len(c) == 0 { continue }
    out = out + __bytes(strconv.format_int(len(c), 16) + "\r\n") + c + [13, 10]
  }
  out + [48, 13, 10]
}

// httpguts.HeaderValuesContainsToken
pub fn header_values_contains_token(values: List<Str>, token: Str) -> Bool {
  let t = lower(token)
  for v in values {
    for f in split(v, ",") {
      if lower(trim_ows(f)) == t && is_ascii(f) { return true }
    }
  }
  false
}

fn is_ascii(s: Str) -> Bool {
  for b in __bytes(s) { if b >= 128 { return false } }
  true
}

fn trim_ows(s: Str) -> Str {
  let b = __bytes(s)
  var i = 0
  var j = len(b)
  while i < j && is_ows(b[i]) { i += 1 }
  while j > i && is_ows(b[j - 1]) { j -= 1 }
  unwrap_or(__from_bytes(b[i..j]), s)
}

fn should_close(major: Int, minor: Int, h: textproto.MIMEHeader, remove: Bool) -> (
  Bool,
  textproto.MIMEHeader,
) {
  if major < 1 { return (true, h) }
  let conv = h.values("Connection")
  let has_close = header_values_contains_token(conv, "close")
  if major == 1 && minor == 0 {
    return (has_close || !header_values_contains_token(conv, "keep-alive"), h)
  }
  if has_close && remove { return (true, h.del("Connection")) }
  (has_close, h)
}

fn has_key(h: textproto.MIMEHeader, k: Str) -> Bool { contains(h.keys, k) }

fn fix_pragma(h: textproto.MIMEHeader) -> textproto.MIMEHeader {
  let hp = h.values("Pragma")
  if len(hp) > 0 && hp[0] == "no-cache" && !has_key(h, "Cache-Control") {
    return h.set("Cache-Control", "no-cache")
  }
  h
}

fn parse_content_length(cls: List<Str>) -> Result<Int, Str> {
  if len(cls) == 0 { return Ok(-1) }
  let cl = textproto.trim_string(cls[0])
  if cl == "" { return Err(bad_string("invalid empty Content-Length", cl)) }
  var n = 0
  for b in __bytes(cl) {
    if b < 48 || b > 57 || n > (9223372036854775807 - (b - 48)) / 10 {
      return Err(bad_string("bad Content-Length", cl))
    }
    n = n * 10 + (b - 48)
  }
  Ok(n)
}

fn body_allowed(status: Int) -> Bool {
  !((status >= 100 && status <= 199) || status == 204 || status == 304)
}

fn foreach_header_element(v0: Str) -> List<Str> {
  let v = textproto.trim_string(v0)
  if v == "" { return [] }
  if !contains(v, ",") { return [v] }
  var out: List<Str> = []
  for f0 in split(v, ",") {
    let f = textproto.trim_string(f0)
    if f != "" { out = push(out, f) }
  }
  out
}

type Transfer = {
  header: textproto.MIMEHeader,
  content_length: Int,
  chunked: Bool,
  close: Bool,
  trailer: textproto.MIMEHeader,
  trailer_declared: Int,
  body: List<Int>,
  body_err: Str,
  rest: List<Int>,
}

fn ascii_equal_fold(a: Str, b: Str) -> Bool { is_ascii(a) && lower(a) == lower(b) }

// readTransfer + 把 body 读完
fn read_transfer(
  is_response: Bool,
  status: Int,
  method: Str,
  major0: Int,
  minor0: Int,
  h0: textproto.MIMEHeader,
  close0: Bool,
  d: List<Int>,
  pos: Int,
) -> Result<Transfer, Str> {
  var h = h0
  var close = close0
  let (major, minor) = if major0 == 0 && minor0 == 0 { (1, 1) } else { (major0, minor0) }
  var chunked = false
  if has_key(h, "Transfer-Encoding") {
    let raw = h.values("Transfer-Encoding")
    h = h.del("Transfer-Encoding")
    if major > 1 || (major == 1 && minor >= 1) {
      if len(raw) != 1 { return Err("too many transfer encodings: " + qlist(raw)) }
      if !ascii_equal_fold(raw[0], "chunked") {
        return Err("unsupported transfer encoding: " + qgo(raw[0]))
      }
      chunked = true
    }
  }
  // fixLength
  var cls = h.values("Content-Length")
  if len(cls) > 1 {
    let first = textproto.trim_string(cls[0])
    for ct in cls[1..] {
      if first != textproto.trim_string(ct) {
        return Err(
          "http: message cannot contain multiple Content-Length headers; got " + qlist(cls),
        )
      }
    }
    h = h.del("Content-Length").add("Content-Length", first)
    cls = h.values("Content-Length")
  }
  var n = 0
  if len(cls) > 0 {
    n = match parse_content_length(cls) {
      Ok(x) => x,
      Err(e) => { return Err(e) },
    }
  }
  let real = if is_response && method == "HEAD" {
    0
  } else if status / 100 == 1 || status == 204 || status == 304 {
    0
  } else if chunked {
    h = h.del("Content-Length")
    -1
  } else if len(cls) > 0 {
    n
  } else {
    h = h.del("Content-Length")
    if is_response { -1 } else { 0 }
  }
  let content_length = if is_response && method == "HEAD" {
    parse_content_length(h.values("Content-Length"))?
  } else {
    real
  }
  // fixTrailer
  var trailer = textproto.new_header()
  if has_key(h, "Trailer") && chunked {
    let vv = h.values("Trailer")
    h = h.del("Trailer")
    var err = ""
    for v in vv {
      for k0 in foreach_header_element(v) {
        let k = canonical_header_key(k0)
        if k == "Transfer-Encoding" || k == "Trailer" || k == "Content-Length" {
          if err == "" {
            err = bad_string("bad trailer key", k)
            continue
          }
        }
        if !has_key(trailer, k) {
          trailer = textproto.MIMEHeader {
            keys: push(trailer.keys, k),
            vals: push(trailer.vals, []),
          }
        }
      }
    }
    if err != "" { return Err(err) }
  }
  let declared = len(trailer.keys)
  if is_response && real == -1 && !chunked && body_allowed(status) { close = true }
  var body: List<Int> = []
  var berr = ""
  var rest = d[pos..]
  if chunked {
    if !(is_response && (method == "HEAD" || !body_allowed(status))) {
      let (b, p2, e) = chunked_decode(d, pos)
      body = b
      if e != "" {
        berr = e
        rest = []
      } else {
        let (tr, p3, e2) = read_trailer(d, p2, trailer)
        trailer = tr
        if e2 != "" {
          berr = e2
          rest = []
        } else {
          rest = d[p3..]
        }
      }
    }
  } else if real > 0 {
    if len(d) - pos < real {
      body = d[pos..]
      berr = "unexpected EOF"
      rest = []
    } else {
      body = d[pos..pos + real]
      rest = d[pos + real..]
    }
  } else if real < 0 && close {
    body = d[pos..]
    rest = []
  }
  Ok(Transfer {
    header: h,
    content_length: content_length,
    chunked: chunked,
    close: close,
    trailer: trailer,
    trailer_declared: declared,
    body: body,
    body_err: berr,
    rest: rest,
  })
}

fn ends_crlfcrlf(d: List<Int>, i: Int) -> Bool {
  d[i - 4] == 13 && d[i - 3] == 10 && d[i - 2] == 13 && d[i - 1] == 10
}

// body.readTrailer
fn read_trailer(d: List<Int>, pos: Int, tr: textproto.MIMEHeader) -> (
  textproto.MIMEHeader,
  Int,
  Str,
) {
  let avail = len(d) - pos
  if avail >= 2 && d[pos] == 13 && d[pos + 1] == 10 { return (tr, pos + 2, "") }
  if avail < 2 { return (tr, pos, "http: unexpected EOF reading trailer") }
  let lim = if avail > 4096 { 4096 } else { avail }
  var seen = false
  var k = 4
  while k <= lim && !seen {
    if ends_crlfcrlf(d, pos + k) { seen = true }
    k += 1
  }
  if !seen { return (tr, pos, "http: suspiciously long trailer after chunked body") }
  let r = textproto.Reader { data: d, pos: pos }
  let (r2, h, e) = r.read_mime_header()
  if e != "" {
    return (tr, r2.pos, if e == "EOF" { "http: unexpected EOF reading trailer" } else { e })
  }
  var out = tr
  if len(tr.keys) == 0 {
    out = h
  } else {
    for (k2, vs) in zip(h.keys, h.vals) {
      out = out.del(k2)
      out = textproto.MIMEHeader { keys: push(out.keys, k2), vals: push(out.vals, vs) }
    }
  }
  (out, r2.pos, "")
}

fn eof_to_unexpected(e: Str) -> Str { if e == "EOF" { "unexpected EOF" } else { e } }

// http.ReadRequest
pub fn read_request(d: List<Int>) -> Result<WireRequest, Str> {
  let r0 = textproto.new_reader(d)
  let (r1, l) = r0.read_line()
  let s = l?
  let (method, rest1, ok1) = cut_str(s, " ")
  let (ruri, proto, ok2) = cut_str(rest1, " ")
  if !ok1 || !ok2 { return Err(bad_string("malformed HTTP request", s)) }
  if !valid_header_field_name(method) { return Err(bad_string("invalid method", method)) }
  let (major, minor, okv) = parse_http_version(proto)
  if !okv { return Err(bad_string("malformed HTTP version", proto)) }
  let just_authority = method == "CONNECT" && !starts_with(ruri, "/")
  let raw = if just_authority { "http://" + ruri } else { ruri }
  var u = url.parse_request_uri(raw)?
  if just_authority { u = url.URL { scheme: "", ..u } }
  let (r2, h0, he) = r1.read_mime_header()
  if he != "" { return Err(eof_to_unexpected(he)) }
  var h = h0
  if len(h.values("Host")) > 1 { return Err("too many Host headers") }
  let host = if u.host != "" { u.host } else { h.get("Host") }
  h = fix_pragma(h)
  let (close, _) = should_close(major, minor, h, false)
  let t = match read_transfer(false, 200, method, major, minor, h, close, d, r2.pos) {
    Ok(x) => x,
    Err(e) => { return Err(eof_to_unexpected(e)) },
  }
  let h2u = method == "PRI" && len(t.header.keys) == 0 && u.path == "*" && proto == "HTTP/2.0"
  Ok(WireRequest {
    method: method,
    url: u,
    proto: proto,
    proto_major: major,
    proto_minor: minor,
    header: t.header.del("Host"),
    content_length: if h2u { -1 } else { t.content_length },
    transfer_encoding: if t.chunked { ["chunked"] } else { [] },
    close: h2u || t.close,
    host: host,
    trailer: t.trailer,
    request_uri: ruri,
    body: t.body,
    body_err: t.body_err,
    rest: t.rest,
  })
}

fn cut_str(s: Str, sep: Str) -> (Str, Str, Bool) {
  let i = __str_find(s, sep, 0)
  if i < 0 {
    (s, "", false)
  } else {
    (__str_slice(s, 0, i), __str_slice(s, i + len(sep), len(s)), true)
  }
}

fn atoi_go(s: Str) -> Option<Int> {
  let b = __bytes(s)
  if len(b) == 0 { return None }
  var i = 0
  var neg = false
  if b[0] == 43 || b[0] == 45 {
    neg = b[0] == 45
    i = 1
    if len(b) == 1 { return None }
  }
  var n = 0
  while i < len(b) {
    if b[i] < 48 || b[i] > 57 { return None }
    n = n * 10 + (b[i] - 48)
    i += 1
  }
  Some(if neg { -n } else { n })
}

// http.ReadResponse；method 是对应请求的方法（Go 里 req 为 nil 时传 "GET"）
pub fn read_response(d: List<Int>, method: Str) -> Result<WireResponse, Str> {
  let r0 = textproto.new_reader(d)
  let (r1, l) = r0.read_line()
  let line = match l {
    Ok(x) => x,
    Err(e) => { return Err(eof_to_unexpected(e)) },
  }
  let (proto, status0, ok) = cut_str(line, " ")
  if !ok { return Err(bad_string("malformed HTTP response", line)) }
  var sb = __bytes(status0)
  var i = 0
  while i < len(sb) && sb[i] == 32 { i += 1 }
  let status = unwrap_or(__from_bytes(sb[i..]), status0)
  let (code_s, _, _) = cut_str(status, " ")
  if len(__bytes(code_s)) != 3 { return Err(bad_string("malformed HTTP status code", code_s)) }
  let code = match atoi_go(code_s) {
    Some(c) => c,
    None => { return Err(bad_string("malformed HTTP status code", code_s)) },
  }
  if code < 0 { return Err(bad_string("malformed HTTP status code", code_s)) }
  let (major, minor, okv) = parse_http_version(proto)
  if !okv { return Err(bad_string("malformed HTTP version", proto)) }
  let (r2, h0, he) = r1.read_mime_header()
  if he != "" { return Err(eof_to_unexpected(he)) }
  let h1 = fix_pragma(h0)
  let (close, h) = should_close(major, minor, h1, true)
  let t = read_transfer(true, code, method, major, minor, h, close, d, r2.pos)?
  Ok(WireResponse {
    status: status,
    status_code: code,
    proto: proto,
    proto_major: major,
    proto_minor: minor,
    header: t.header,
    content_length: t.content_length,
    transfer_encoding: if t.chunked { ["chunked"] } else { [] },
    close: t.close,
    trailer: t.trailer,
    trailer_declared: t.trailer_declared,
    body: t.body,
    body_err: t.body_err,
    rest: t.rest,
  })
}

// ───────────── 报文写出（对齐 Go 1.27 的 Request.Write / Response.Write） ─────────────
// body：None = nil Body；Some(bytes) = 内存里的正文（Go 里的 bytes.Reader）。trailer 为空表示 nil。
// 返回 (写出的字节, 错误)；出错时字节是 Go 在出错前已经写进 io.Writer 的部分。

pub type OutRequest = {
  method: Str,
  url: url.URL,
  host: Str,
  header: textproto.MIMEHeader,
  body: Option<List<Int>>,
  content_length: Int,
  transfer_encoding: List<Str>,
  close: Bool,
  trailer: textproto.MIMEHeader,
}

pub type OutResponse = {
  status: Str,
  status_code: Int,
  proto_major: Int,
  proto_minor: Int,
  header: textproto.MIMEHeader,
  body: Option<List<Int>>,
  content_length: Int,
  transfer_encoding: List<Str>,
  close: Bool,
  uncompressed: Bool,
  trailer: textproto.MIMEHeader,
  // 对应请求的方法；"" = Response.Request 为 nil
  request_method: Str,
}

pub fn out_request(method: Str, u: url.URL) -> OutRequest {
  OutRequest {
    method: method,
    url: u,
    host: "",
    header: textproto.new_header(),
    body: None,
    content_length: 0,
    transfer_encoding: [],
    close: false,
    trailer: textproto.new_header(),
  }
}

pub fn out_response(code: Int) -> OutResponse {
  OutResponse {
    status: "",
    status_code: code,
    proto_major: 1,
    proto_minor: 1,
    header: textproto.new_header(),
    body: None,
    content_length: 0,
    transfer_encoding: [],
    close: false,
    uncompressed: false,
    trailer: textproto.new_header(),
    request_method: "",
  }
}

pub const DEFAULT_USER_AGENT: Str = "Go-http-client/1.1"

fn valid_host_byte(c: Int) -> Bool {
  (c >= 48 && c <= 57)
    || (c >= 97 && c <= 122)
    || (c >= 65 && c <= 90)
    || contains(
      [33, 36, 37, 38, 40, 41, 42, 43, 44, 45, 46, 58, 59, 61, 91, 39, 93, 95, 126],
      c,
    )
}

// httpguts.ValidHostHeader
pub fn valid_host_header(h: Str) -> Bool {
  for c in __bytes(h) { if !valid_host_byte(c) { return false } }
  true
}

// httpguts.ValidHeaderFieldValue
pub fn valid_header_field_value(v: Str) -> Bool {
  for c in __bytes(v) { if (c < 32 && c != 9) || c == 127 { return false } }
  true
}

// httpguts.PunycodeHostPort
pub fn punycode_host_port(v: Str) -> Result<Str, Str> {
  if is_ascii(v) { return Ok(v) }
  let (host, port) = match net.split_host_port(v) {
    Ok(x) => x,
    Err(_) => (v, ""),
  }
  let h = cookiejar.to_ascii(host)?
  if port == "" { Ok(h) } else { Ok(net.join_host_port(h, port)) }
}

fn remove_zone(host: Str) -> Str {
  if !starts_with(host, "[") { return host }
  let b = __bytes(host)
  var i = len(b) - 1
  while i >= 0 && b[i] != 93 { i -= 1 }
  if i < 0 { return host }
  var j = i - 1
  while j >= 0 && b[j] != 37 { j -= 1 }
  if j < 0 { return host }
  unwrap_or(__from_bytes(b[..j] + b[i..]), host)
}

fn has_ctl(s: Str) -> Bool {
  for b in __bytes(s) { if b < 32 || b == 127 { return true } }
  false
}

fn is_chunked(te: List<Str>) -> Bool { len(te) > 0 && te[0] == "chunked" }

fn is_identity(te: List<Str>) -> Bool { len(te) == 1 && te[0] == "identity" }

type TW = {
  method: Str,
  is_response: Bool,
  to_head: Bool,
  header: textproto.MIMEHeader,
  trailer: textproto.MIMEHeader,
  body: Option<List<Int>>,
  // 正文按 Go 的 io.Copy 会切成的块（只影响 chunked 输出）
  chunks: List<List<Int>>,
  content_length: Int,
  te: List<Str>,
  close: Bool,
}

fn first_bad_header(h: textproto.MIMEHeader) -> Str {
  for (k, vv) in zip(h.keys, h.vals) {
    if !valid_header_field_name(k) { return "field name " + qgo(k) }
    for v in vv { if !valid_header_field_value(v) { return "field value for " + qgo(k) } }
  }
  ""
}

fn tw_finish(t0: TW, at_least_11: Bool) -> Result<TW, Str> {
  var t = t0
  if t.to_head {
    t = TW { body: None, ..t }
    if is_chunked(t.te) { t = TW { content_length: -1, ..t } }
  } else {
    if !at_least_11 || is_none(t.body) { t = TW { te: [], ..t } }
    if is_chunked(t.te) {
      t = TW { content_length: -1, ..t }
    } else if is_none(t.body) {
      t = TW { content_length: 0, ..t }
    }
  }
  if !is_chunked(t.te) { t = TW { trailer: textproto.new_header(), ..t } }
  let bad = first_bad_header(t.trailer)
  if bad != "" { return Err("net/http: invalid trailer " + bad) }
  Ok(t)
}

fn should_send_cl(t: TW) -> Bool {
  if is_chunked(t.te) { return false }
  if t.content_length > 0 { return true }
  if t.content_length < 0 { return false }
  if t.method == "POST" || t.method == "PUT" || t.method == "PATCH" { return true }
  if t.content_length == 0 && is_identity(t.te) {
    return !(t.method == "GET" || t.method == "HEAD")
  }
  false
}

fn tw_header(t: TW) -> (Str, Str) {
  var out = ""
  if t.close && !has_token(t.header.get("Connection"), "close") {
    out = out + "Connection: close\r\n"
  }
  if should_send_cl(t) {
    out = out + "Content-Length: " + str(t.content_length) + "\r\n"
  } else if is_chunked(t.te) {
    out = out + "Transfer-Encoding: chunked\r\n"
  }
  if len(t.trailer.keys) > 0 {
    var ks: List<Str> = []
    for k0 in t.trailer.keys {
      let k = canonical_header_key(k0)
      if k == "Transfer-Encoding" || k == "Trailer" || k == "Content-Length" {
        return (out, bad_string("invalid Trailer key", k))
      }
      ks = push(ks, k)
    }
    out = out + "Trailer: " + join(sort(ks), ",") + "\r\n"
  }
  (out, "")
}

fn tw_body(t: TW) -> (List<Int>, Str) {
  var out: List<Int> = []
  var ncopy = 0
  if !t.to_head {
    match t.body {
      None => {},
      Some(b) => {
        if is_chunked(t.te) {
          out = chunked_encode(t.chunks)
        } else if t.content_length == -1 {
          out = b
          ncopy = len(b)
        } else {
          out = if len(b) > t.content_length { b[..t.content_length] } else { b }
          ncopy = len(b)
        }
      },
    }
  }
  if !t.to_head && t.content_length != -1 && t.content_length != ncopy {
    return (out, "http: ContentLength={t.content_length} with Body length {ncopy}")
  }
  if !t.to_head && is_chunked(t.te) {
    if len(t.trailer.keys) > 0 { out = out + __bytes(header_write(t.trailer)) }
    out = out + [13, 10]
  }
  (out, "")
}

fn lacks_body(m: Str) -> Bool {
  contains(["GET", "HEAD", "DELETE", "OPTIONS", "PROPFIND", "SEARCH"], m)
}

// Request.Write
pub fn request_write(r: OutRequest) -> (List<Int>, Str) {
  request_write_extra(r, textproto.new_header())
}

// Request.write 带 extraHeaders（Transport 用，比如 Accept-Encoding: gzip）：写在 Header 之后
pub fn request_write_extra(r: OutRequest, extra: textproto.MIMEHeader) -> (List<Int>, Str) {
  var host = if r.host != "" { r.host } else { r.url.host }
  host = match punycode_host_port(host) {
    Ok(h) => h,
    Err(e) => { return ([], e) },
  }
  if !valid_host_header(host) { host = "" }
  host = remove_zone(host)
  var ruri = url.request_uri(r.url)
  if r.method == "CONNECT" && r.url.path == "" {
    ruri = if r.url.opaque != "" { r.url.opaque } else { host }
  }
  if has_ctl(ruri) { return ([], "net/http: can't write control character in Request.URL") }
  let method = if r.method == "" { "GET" } else { r.method }
  var out = method + " " + ruri + " HTTP/1.1\r\nHost: " + host + "\r\n"
  var ua = DEFAULT_USER_AGENT
  if has_key(r.header, "User-Agent") { ua = r.header.get("User-Agent") }
  if ua != "" {
    out = out + "User-Agent: " + textproto.trim_string(
      replace(replace(ua, "\n", " "), "\r", " "),
    ) + "\r\n"
  }
  // newTransferWriter
  if r.content_length != 0 && is_none(r.body) {
    return (__bytes(out), "http: Request.ContentLength={r.content_length} with nil Body")
  }
  var body = r.body
  var cl = match r.body {
    None => 0,
    Some(_) => if r.content_length != 0 { r.content_length } else { -1 },
  }
  var te = r.transfer_encoding
  var chunks: List<List<Int>> = match r.body {
    None => [],
    Some(b) => [b],
  }
  if cl < 0 && len(te) == 0 && is_some(body) && method != "CONNECT" {
    let b = unwrap(body)
    if lacks_body(method) {
      if len(b) == 0 {
        body = None
        cl = 0
      } else {
        chunks = [b[..1], b[1..]]
        te = ["chunked"]
      }
    } else {
      te = ["chunked"]
    }
  }
  let t = match tw_finish(
    TW {
      method: method,
      is_response: false,
      to_head: false,
      header: r.header,
      trailer: r.trailer,
      body: body,
      chunks: chunks,
      content_length: cl,
      te: te,
      close: r.close,
    },
    true,
  ) {
    Ok(x) => x,
    Err(e) => { return (__bytes(out), e) },
  }
  let (th, te2) = tw_header(t)
  out = out + th
  if te2 != "" { return (__bytes(out), te2) }
  out = out + header_write_subset(
    r.header,
    ["Host", "User-Agent", "Content-Length", "Transfer-Encoding", "Trailer"],
  ) + header_write(extra) + "\r\n"
  let (bb, be) = tw_body(t)
  (__bytes(out) + bb, be)
}

fn pad3(n: Int) -> Str {
  if n >= 0 && n < 10 { "00" + str(n) } else if n >= 0 && n < 100 { "0" + str(n) } else { str(n) }
}

// Response.Write
pub fn response_write(r: OutResponse) -> (List<Int>, Str) {
  var text = r.status
  if text == "" {
    text = status_text(r.status_code)
    if text == "" { text = "status code " + str(r.status_code) }
  } else {
    let p = str(r.status_code) + " "
    if starts_with(text, p) { text = __str_slice(text, len(p), len(text)) }
  }
  var out = "HTTP/{r.proto_major}.{r.proto_minor} {pad3(r.status_code)} {text}\r\n"
  var cl = r.content_length
  var body = r.body
  var chunks: List<List<Int>> = match r.body {
    None => [],
    Some(b) => [b],
  }
  if cl == 0 && is_some(body) {
    let b = unwrap(body)
    if len(b) == 0 {
      body = Some([])
      chunks = []
    } else {
      cl = -1
      var cs = [b[..1]]
      var i = 1
      while i < len(b) {
        let e = if i + 32768 < len(b) { i + 32768 } else { len(b) }
        cs = push(cs, b[i..e])
        i = e
      }
      chunks = cs
    }
  }
  let at11 = r.proto_major > 1 || (r.proto_major == 1 && r.proto_minor >= 1)
  var close = r.close
  if cl == -1 && !close && at11 && !is_chunked(r.transfer_encoding) && !r.uncompressed {
    close = true
  }
  let t = match tw_finish(
    TW {
      method: r.request_method,
      is_response: true,
      to_head: r.request_method == "HEAD",
      header: r.header,
      trailer: r.trailer,
      body: body,
      chunks: chunks,
      content_length: cl,
      te: r.transfer_encoding,
      close: close,
    },
    at11,
  ) {
    Ok(x) => x,
    Err(e) => { return (__bytes(out), e) },
  }
  let (th, te2) = tw_header(t)
  out = out + th
  if te2 != "" { return (__bytes(out), te2) }
  out = out + header_write_subset(r.header, ["Content-Length", "Transfer-Encoding", "Trailer"])
  if cl == 0
    && !is_chunked(r.transfer_encoding)
    && !should_send_cl(t)
    && body_allowed(r.status_code) {
    out = out + "Content-Length: 0\r\n"
  }
  out = out + "\r\n"
  let (bb, be) = tw_body(t)
  (__bytes(out) + bb, be)
}

// ───────────── ServeMux（对齐 Go 1.22+ 的模式路由：pattern.go / routing_tree.go / routing_index.go） ─────────────
// mux 是不可变值：handle(mux, pattern) 返回新的 mux，处理器用登记顺序的编号（0、1、2…）表示。
// find(mux, method, host, u) 等于 ServeMux.findHandler：结果是处理器 / 307 重定向 / 405 / 404，
// 以及匹配的模式字符串和路径通配符的值（= Request.PathValue）。
// 和 Go 的差别：冲突错误里没有 "(registered at 文件:行)"。

type Segment = { s: Str, wild: Bool, multi: Bool }

pub type Pattern = { str: Str, method: Str, host: Str, segments: List<Segment> }

type RNode = { pat: Int, kids: List<(Str, Int)>, multi: Int, empty: Int }

pub type ServeMux = {
  pats: List<Pattern>,
  nodes: List<RNode>,
  idx_keys: List<(Int, Str)>,
  idx_vals: List<List<Int>>,
  multis: List<Int>,
}

pub type MuxMatch = {
  // "handler"、"redirect"、"405"、"404"
  kind: Str,
  handler: Int,
  pattern: Str,
  // (通配符名, 值)，顺序同模式
  values: List<(Str, Str)>,
  // Location 头的值（= http.Redirect 处理后的地址）
  location: Str,
  allow: Str,
}

fn new_node() -> RNode { RNode { pat: -1, kids: [], multi: -1, empty: -1 } }

pub fn new_serve_mux() -> ServeMux {
  ServeMux { pats: [], nodes: [new_node()], idx_keys: [], idx_vals: [], multis: [] }
}

fn index_any(s: Str, a: Int, b: Int) -> Int {
  let bs = __bytes(s)
  for i in 0..len(bs) { if bs[i] == a || bs[i] == b { return i } }
  -1
}

fn bslice(b: List<Int>, i: Int, j: Int) -> Str { unwrap_or(__from_bytes(b[i..j]), "") }

fn path_unescape_or(s: Str) -> Str {
  match url.path_unescape(s) {
    Ok(x) => x,
    Err(_) => s,
  }
}

fn valid_wildcard_name(s: Str) -> Bool {
  if s == "" { return false }
  var i = 0
  for c in chars(s) {
    if !unicode.is_letter(c) && c != "_" && (i == 0 || !unicode.is_digit(c)) { return false }
    i += 1
  }
  true
}

// cleanPath
pub fn clean_path(p0: Str) -> Str {
  if p0 == "" { return "/" }
  let p = if starts_with(p0, "/") { p0 } else { "/" + p0 }
  var np = path.clean(p)
  if ends_with(p, "/") && np != "/" {
    np = if len(p) == len(np) + 1 && starts_with(p, np) { p } else { np + "/" }
  }
  np
}

// parsePattern；错误文字同 Go（"at offset N: …"）
pub fn parse_pattern(s: Str) -> Result<Pattern, Str> {
  if s == "" { return Err("empty pattern") }
  let b = __bytes(s)
  var off = 0
  let sp = index_any(s, 32, 9)
  var method = ""
  var rest: List<Int> = b
  if sp >= 0 {
    method = bslice(b, 0, sp)
    var k = sp + 1
    while k < len(b) && (b[k] == 32 || b[k] == 9) { k += 1 }
    rest = b[k..]
  }
  let fail = (o: Int, e: Str) => Err("at offset {o}: {e}")
  if method != "" && !valid_header_field_name(method) {
    return fail(0, "invalid method " + qgo(method))
  }
  if sp >= 0 { off = len(__bytes(method)) + 1 }
  let slash = index_byte(rest, 0, len(rest), 47)
  if slash < 0 { return fail(off, "host/path missing /") }
  let host = bslice(rest, 0, slash)
  rest = rest[slash..]
  let brace = index_byte(__bytes(host), 0, len(__bytes(host)), 123)
  if brace >= 0 { return fail(off + brace, "host contains '\{' (missing initial '/'?)") }
  off += slash
  let rs = unwrap_or(__from_bytes(rest), "")
  if method != "" && method != "CONNECT" && rs != clean_path(rs) {
    return fail(off, "non-CONNECT pattern with unclean path can never match")
  }
  var segs: List<Segment> = []
  var seen: List<Str> = []
  while len(rest) > 0 {
    rest = rest[1..]
    off = len(b) - len(rest)
    if len(rest) == 0 {
      segs = push(segs, Segment { s: "", wild: true, multi: true })
      break
    }
    var i = index_byte(rest, 0, len(rest), 47)
    if i < 0 { i = len(rest) }
    let seg = rest[..i]
    rest = rest[i..]
    let bi = index_byte(seg, 0, len(seg), 123)
    if bi < 0 {
      segs = push(segs, Segment {
        s: path_unescape_or(unwrap_or(__from_bytes(seg), "")),
        wild: false,
        multi: false,
      })
    } else {
      if bi != 0 { return fail(off, "bad wildcard segment (must start with '\{')") }
      if seg[len(seg) - 1] != 125 { return fail(off, "bad wildcard segment (must end with '\}')") }
      var name = bslice(seg, 1, len(seg) - 1)
      if name == "$" {
        if len(rest) != 0 { return fail(off, "\{$\} not at end") }
        segs = push(segs, Segment { s: "/", wild: false, multi: false })
        break
      }
      let multi = ends_with(name, "...")
      if multi { name = __str_slice(name, 0, len(name) - 3) }
      if multi && len(rest) != 0 { return fail(off, "\{...\} wildcard not at end") }
      if name == "" { return fail(off, "empty wildcard") }
      if !valid_wildcard_name(name) { return fail(off, "bad wildcard name " + qgo(name)) }
      if contains(seen, name) { return fail(off, "duplicate wildcard name " + qgo(name)) }
      seen = push(seen, name)
      segs = push(segs, Segment { s: name, wild: true, multi: multi })
    }
  }
  Ok(Pattern { str: s, method: method, host: host, segments: segs })
}

fn last_seg(p: Pattern) -> Segment { p.segments[len(p.segments) - 1] }

fn inverse_rel(r: Str) -> Str {
  if r == "moreSpecific" { "moreGeneral" } else if r == "moreGeneral" { "moreSpecific" } else { r }
}

fn combine_rel(r1: Str, r2: Str) -> Str {
  if r1 == "equivalent" { return r2 }
  if r1 == "disjoint" { return "disjoint" }
  if r1 == "overlaps" { return if r2 == "disjoint" { "disjoint" } else { "overlaps" } }
  if r2 == "equivalent" { return r1 }
  if r2 == inverse_rel(r1) { return "overlaps" }
  r2
}

fn compare_methods(p1: Pattern, p2: Pattern) -> Str {
  if p1.method == p2.method { return "equivalent" }
  if p1.method == "" { return "moreGeneral" }
  if p2.method == "" { return "moreSpecific" }
  if p1.method == "GET" && p2.method == "HEAD" { return "moreGeneral" }
  if p2.method == "GET" && p1.method == "HEAD" { return "moreSpecific" }
  "disjoint"
}

fn compare_segments(s1: Segment, s2: Segment) -> Str {
  if s1.multi && s2.multi { return "equivalent" }
  if s1.multi { return "moreGeneral" }
  if s2.multi { return "moreSpecific" }
  if s1.wild && s2.wild { return "equivalent" }
  if s1.wild { return if s2.s == "/" { "disjoint" } else { "moreGeneral" } }
  if s2.wild { return if s1.s == "/" { "disjoint" } else { "moreSpecific" } }
  if s1.s == s2.s { "equivalent" } else { "disjoint" }
}

fn compare_paths(p1: Pattern, p2: Pattern) -> Str {
  let n1 = len(p1.segments)
  let n2 = len(p2.segments)
  if n1 != n2 && !last_seg(p1).multi && !last_seg(p2).multi { return "disjoint" }
  var rel = "equivalent"
  var i = 0
  while i < n1 && i < n2 {
    rel = combine_rel(rel, compare_segments(p1.segments[i], p2.segments[i]))
    if rel == "disjoint" { return rel }
    i += 1
  }
  if n1 == n2 { return rel }
  if n1 < n2 && last_seg(p1).multi { return combine_rel(rel, "moreGeneral") }
  if n2 < n1 && last_seg(p2).multi { return combine_rel(rel, "moreSpecific") }
  "disjoint"
}

fn conflicts_with(p1: Pattern, p2: Pattern) -> Bool {
  if p1.host != p2.host { return false }
  let m = compare_methods(p1, p2)
  if m == "disjoint" { return false }
  let rel = combine_rel(m, compare_paths(p1, p2))
  rel == "equivalent" || rel == "overlaps"
}

fn write_seg(s: Segment) -> Str { if !s.multi && s.s != "/" { "/" + s.s } else { "/" } }

fn write_segs(ss: List<Segment>) -> Str { join(map(ss, write_seg), "") }

fn common_path(p1: Pattern, p2: Pattern) -> Str {
  var b = ""
  var i = 0
  let n1 = len(p1.segments)
  let n2 = len(p2.segments)
  while i < n1 && i < n2 {
    let s1 = p1.segments[i]
    b = b + if s1.wild { write_seg(p2.segments[i]) } else { write_seg(s1) }
    i += 1
  }
  if i < n1 {
    b + write_segs(p1.segments[i..])
  } else if i < n2 {
    b + write_segs(p2.segments[i..])
  } else {
    b
  }
}

fn difference_path(p1: Pattern, p2: Pattern) -> Str {
  var b = ""
  var i = 0
  let n1 = len(p1.segments)
  let n2 = len(p2.segments)
  while i < n1 && i < n2 {
    let s1 = p1.segments[i]
    let s2 = p2.segments[i]
    if s1.multi && s2.multi { return b + "/" }
    if s1.multi && !s2.multi {
      b = b + "/"
      if s2.s == "/" { b = b + if s1.s != "" { s1.s } else { "x" } }
      return b
    }
    if !s1.multi && s2.multi {
      b = b + write_seg(s1)
    } else if s1.wild && s2.wild {
      b = b + write_seg(s1)
    } else if s1.wild && !s2.wild {
      b = b + if s1.s != s2.s { write_seg(s1) } else { "/" + s2.s + "x" }
    } else {
      b = b + write_seg(s1)
    }
    i += 1
  }
  if i < n1 {
    b + write_segs(p1.segments[i..])
  } else if i < n2 {
    b + write_segs(p2.segments[i..])
  } else {
    b
  }
}

fn describe_conflict(p1: Pattern, p2: Pattern) -> Str {
  let mrel = compare_methods(p1, p2)
  let prel = compare_paths(p1, p2)
  let rel = combine_rel(mrel, prel)
  if rel == "equivalent" { return "{p1.str} matches the same requests as {p2.str}" }
  if prel == "overlaps" {
    return "{p1.str} and {p2.str} both match some paths, like {qgo(common_path(p1, p2))}.\nBut neither is more specific than the other.\n{p1.str} matches {qgo(
      difference_path(p1, p2),
    )}, but {p2.str} doesn't.\n{p2.str} matches {qgo(difference_path(p2, p1))}, but {p1.str} doesn't."
  }
  if mrel == "moreGeneral" && prel == "moreSpecific" {
    return "{p1.str} matches more methods than {p2.str}, but has a more specific path pattern"
  }
  if mrel == "moreSpecific" && prel == "moreGeneral" {
    return "{p1.str} matches fewer methods than {p2.str}, but has a more general path pattern"
  }
  "bug: unexpected way for two patterns {p1.str} and {p2.str} to conflict: methods {mrel}, paths {prel}"
}

fn idx_get(m: ServeMux, pos: Int, s: Str) -> List<Int> {
  for i in 0..len(m.idx_keys) {
    let (p, k) = m.idx_keys[i]
    if p == pos && k == s { return m.idx_vals[i] }
  }
  []
}

fn idx_add(m: ServeMux, pos: Int, s: Str, v: Int) -> ServeMux {
  for i in 0..len(m.idx_keys) {
    let (p, k) = m.idx_keys[i]
    if p == pos && k == s {
      return ServeMux { idx_vals: set(m.idx_vals, i, push(m.idx_vals[i], v)), ..m }
    }
  }
  ServeMux { idx_keys: push(m.idx_keys, (pos, s)), idx_vals: push(m.idx_vals, [v]), ..m }
}

// routingIndex.possiblyConflictingPatterns 给出的候选顺序
fn candidates(m: ServeMux, p: Pattern) -> List<Int> {
  var out = m.multis
  if last_seg(p).s == "/" && !last_seg(p).wild { return out + idx_get(m, len(p.segments) - 1, "/") }
  var lmin: List<Int> = []
  var wmin: List<Int> = []
  var min = -1
  var has_lit = false
  for i in 0..len(p.segments) {
    let seg = p.segments[i]
    if seg.multi { break }
    if !seg.wild {
      has_lit = true
      let l = idx_get(m, i, seg.s)
      let w = idx_get(m, i, "")
      if min < 0 || len(l) + len(w) < min {
        lmin = l
        wmin = w
        min = len(l) + len(w)
      }
    }
  }
  if has_lit { return out + lmin + wmin }
  for vs in m.idx_vals { out = out + vs }
  out
}

fn find_kid(m: ServeMux, n: Int, key: Str) -> Int {
  if n < 0 { return -1 }
  if key == "" { return m.nodes[n].empty }
  for (k, c) in m.nodes[n].kids { if k == key { return c } }
  -1
}

fn add_kid(m: ServeMux, n: Int, key: Str) -> (ServeMux, Int) {
  let f = find_kid(m, n, key)
  if f >= 0 { return (m, f) }
  let c = len(m.nodes)
  var nodes = push(m.nodes, new_node())
  let nd = nodes[n]
  nodes = set(nodes, n, if key == "" {
    RNode { empty: c, ..nd }
  } else {
    RNode { kids: push(nd.kids, (key, c)), ..nd }
  })
  (ServeMux { nodes: nodes, ..m }, c)
}

// ServeMux.Handle（registerErr）：返回新的 mux，处理器编号是 len(mux.pats)
pub fn handle(m0: ServeMux, patstr: Str) -> Result<ServeMux, Str> {
  if patstr == "" { return Err("http: invalid pattern") }
  let p = match parse_pattern(patstr) {
    Ok(x) => x,
    Err(e) => { return Err("parsing " + qgo(patstr) + ": " + e) },
  }
  for c in candidates(m0, p) {
    let p2 = m0.pats[c]
    if conflicts_with(p, p2) {
      return Err(
        "pattern " + qgo(p.str) + " conflicts with pattern " + qgo(
          p2.str,
        ) + ":\n" + describe_conflict(p, p2),
      )
    }
  }
  let id = len(m0.pats)
  var m = ServeMux { pats: push(m0.pats, p), ..m0 }
  var (m1, n) = add_kid(m, 0, p.host)
  let (m2, n2) = add_kid(m1, n, p.method)
  m = m2
  var cur = n2
  for seg in p.segments {
    if seg.multi {
      let c = len(m.nodes)
      let nd = m.nodes[cur]
      m = ServeMux {
        nodes: set(push(m.nodes, RNode { pat: id, ..new_node() }), cur, RNode { multi: c, ..nd }),
        ..m
      }
      cur = -1
      break
    }
    let (m3, c) = add_kid(m, cur, if seg.wild { "" } else { seg.s })
    m = m3
    cur = c
  }
  if cur >= 0 { m = ServeMux { nodes: set(m.nodes, cur, RNode { pat: id, ..m.nodes[cur] }), ..m } }
  // routingIndex.addPattern
  if last_seg(p).multi {
    m = ServeMux { multis: push(m.multis, id), ..m }
  } else {
    for i in 0..len(p.segments) {
      let seg = p.segments[i]
      m = idx_add(m, i, if seg.wild { "" } else { seg.s }, id)
    }
  }
  Ok(m)
}

fn first_segment(p: Str) -> (Str, Str) {
  if p == "/" { return ("/", "") }
  let r = __str_slice(p, 1, len(p))
  let i = __str_find(r, "/", 0)
  let j = if i < 0 { len(r) } else { i }
  (path_unescape_or(__str_slice(r, 0, j)), __str_slice(r, j, len(r)))
}

fn match_path(m: ServeMux, n: Int, p: Str, ms: List<Str>) -> (Int, List<Str>) {
  if n < 0 { return (-1, []) }
  let nd = m.nodes[n]
  if p == "" { return if nd.pat < 0 { (-1, []) } else { (n, ms) } }
  let (seg, rest) = first_segment(p)
  let (a, am) = match_path(m, find_kid(m, n, seg), rest, ms)
  if a >= 0 { return (a, am) }
  if seg != "/" {
    let (b, bm) = match_path(m, nd.empty, rest, push(ms, seg))
    if b >= 0 { return (b, bm) }
  }
  if nd.multi >= 0 {
    let c = nd.multi
    let pat = m.pats[m.nodes[c].pat]
    if last_seg(pat).s != "" { return (c, push(ms, path_unescape_or(__str_slice(p, 1, len(p))))) }
    return (c, ms)
  }
  (-1, [])
}

fn match_method_and_path(m: ServeMux, n: Int, method: Str, p: Str) -> (Int, List<Str>) {
  if n < 0 { return (-1, []) }
  let (a, am) = match_path(m, find_kid(m, n, method), p, [])
  if a >= 0 { return (a, am) }
  if method == "HEAD" {
    let (b, bm) = match_path(m, find_kid(m, n, "GET"), p, [])
    if b >= 0 { return (b, bm) }
  }
  match_path(m, m.nodes[n].empty, p, [])
}

fn tree_match(m: ServeMux, host: Str, method: Str, p: Str) -> (Int, List<Str>) {
  if host != "" {
    let (a, am) = match_method_and_path(m, find_kid(m, 0, host), method, p)
    if a >= 0 { return (a, am) }
  }
  match_method_and_path(m, m.nodes[0].empty, method, p)
}

fn exact_match(m: ServeMux, n: Int, p: Str) -> Bool {
  if n < 0 { return false }
  let pat = m.pats[m.nodes[n].pat]
  if !last_seg(pat).multi { return true }
  if p != "" && !ends_with(p, "/") { return false }
  len(pat.segments) == len(split(p, "/")) - 1
}

fn url_from_escaped(escaped: Str, raw_query: Str) -> Str {
  url.to_str(url.URL {
    path: path_unescape_or(escaped),
    raw_path: escaped,
    raw_query: raw_query,
    ..url.empty()
  })
}

// 返回 (节点, 匹配值, 重定向地址；"" 表示没有)
fn match_or_redirect(m: ServeMux, host: Str, method: Str, p: Str, u: Option<url.URL>) -> (
  Int,
  List<Str>,
  Str,
) {
  let (n, ms) = tree_match(m, host, method, p)
  if !exact_match(m, n, p) && is_some(u) && !ends_with(p, "/") && p != "" {
    let p2 = p + "/"
    let (n2, _) = tree_match(m, host, method, p2)
    if exact_match(m, n2, p2) { return (n2, [], url_from_escaped(p2, unwrap(u).raw_query)) }
  }
  (n, ms, "")
}

fn methods_path(m: ServeMux, n: Int, p: Str, acc: List<Str>) -> List<Str> {
  if n < 0 { return acc }
  var out = acc
  for (meth, c) in m.nodes[n].kids {
    let (x, _) = match_path(m, c, p, [])
    if x >= 0 && !contains(out, meth) { out = push(out, meth) }
  }
  out
}

fn matching_methods(m: ServeMux, host: Str, p: Str) -> List<Str> {
  var ms: List<Str> = []
  for pp in if ends_with(p, "/") {
    [p]
  } else {
    [p, p + "/"]
  } {
    if host != "" { ms = methods_path(m, find_kid(m, 0, host), pp, ms) }
    ms = methods_path(m, m.nodes[0].empty, pp, ms)
    if contains(ms, "GET") && !contains(ms, "HEAD") { ms = push(ms, "HEAD") }
  }
  sort(ms)
}

fn strip_host_port(h: Str) -> Str {
  if !contains(h, ":") { return h }
  match net.split_host_port(h) {
    Ok((host, _)) => host,
    Err(_) => h,
  }
}

fn mux_result(kind: Str, handler: Int, pattern: Str) -> MuxMatch {
  MuxMatch { kind: kind, handler: handler, pattern: pattern, values: [], location: "", allow: "" }
}

// ServeMux.findHandler；host 是 Request.Host，u 是 Request.URL
pub fn find(m: ServeMux, method: Str, host: Str, u: url.URL) -> MuxMatch {
  let escaped = url.escaped_path(u)
  var p = escaped
  var h = u.host
  var n = -1
  var ms: List<Str> = []
  if method == "CONNECT" {
    let (_, _, loc) = match_or_redirect(m, h, method, p, Some(u))
    if loc != "" {
      let pu = unwrap_or(url.parse(loc), url.empty())
      return MuxMatch { location: redirect_location(loc, u), ..mux_result("redirect", -1, pu.path) }
    }
    let (n1, ms1, _) = match_or_redirect(m, host, method, p, None)
    n = n1
    ms = ms1
  } else {
    h = strip_host_port(host)
    p = clean_path(p)
    let (n1, ms1, loc) = match_or_redirect(m, h, method, p, Some(u))
    if loc != "" {
      return MuxMatch {
        location: redirect_location(loc, u),
        ..mux_result("redirect", -1, m.pats[m.nodes[n1].pat].str)
      }
    }
    if p != escaped {
      let ps = if n1 >= 0 { m.pats[m.nodes[n1].pat].str } else { "" }
      return MuxMatch {
        location: redirect_location(url_from_escaped(p, u.raw_query), u),
        ..mux_result("redirect", -1, ps)
      }
    }
    n = n1
    ms = ms1
  }
  if n < 0 {
    let allowed = matching_methods(m, h, p)
    if len(allowed) > 0 {
      return MuxMatch { allow: join(allowed, ", "), ..mux_result("405", -1, "") }
    }
    return mux_result("404", -1, "")
  }
  let id = m.nodes[n].pat
  let pat = m.pats[id]
  var vals: List<(Str, Str)> = []
  var i = 0
  for seg in pat.segments {
    if seg.wild && seg.s != "" {
      if i < len(ms) { vals = push(vals, (seg.s, ms[i])) }
      i += 1
    }
  }
  MuxMatch { values: vals, ..mux_result("handler", id, pat.str) }
}

fn hex_escape_non_ascii(s: Str) -> Str {
  var out: List<Int> = []
  for b in __bytes(s) {
    if b >= 128 {
      out = out + __bytes("%" + upper(strconv.format_int(b, 16)))
    } else {
      out = push(out, b)
    }
  }
  unwrap_or(__from_bytes(out), s)
}

// http.Redirect 写进 Location 头的值（相对路径按请求路径解析并清理，非 ASCII 字节转成 %XX）
pub fn redirect_location(loc0: Str, req_url: url.URL) -> Str {
  var loc = loc0
  match url.parse(loc0) {
    Ok(u) => {
      if u.scheme == "" && u.host == "" {
        var old = url.escaped_path(req_url)
        if old == "" { old = "/" }
        if loc == "" || !starts_with(loc, "/") {
          let i = last_index_str(old, "/")
          loc = __str_slice(old, 0, i + 1) + loc
        }
        var query = ""
        let qi = __str_find(loc, "?", 0)
        if qi >= 0 {
          query = __str_slice(loc, qi, len(loc))
          loc = __str_slice(loc, 0, qi)
        }
        let trailing = ends_with(loc, "/")
        loc = path.clean(loc)
        if trailing && !ends_with(loc, "/") { loc = loc + "/" }
        loc = loc + query
      }
    },
    Err(_) => {},
  }
  hex_escape_non_ascii(loc)
}

fn last_index_str(s: Str, sub: Str) -> Int {
  var i = len(s) - len(sub)
  while i >= 0 {
    if __str_slice(s, i, i + len(sub)) == sub { return i }
    i -= 1
  }
  -1
}
