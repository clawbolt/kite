// std.env：环境变量与命令行参数

// 环境变量；没有设置时为 None
pub fn get(name: Str) -> Option<Str> { __env_get(name) }

pub fn get_or(name: Str, fallback: Str) -> Str {
  match __env_get(name) {
    Some(v) => v,
    None => fallback,
  }
}

// 程序自己的参数：kite run app.kite a b 或 ./app a b 都得到 ["a", "b"]
pub fn args() -> List<Str> { __args() }
