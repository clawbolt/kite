// std.path：用 / 分隔的路径处理（对齐 Go 的 path 包，只做字符串运算，不访问文件系统）

// 按 / 拆分（这个模块自己定义了 join / split，所以不能用同名的全局函数）
fn segments(p: Str) -> List<Str> {
  var out: List<Str> = []
  var cur = ""
  for c in chars(p) {
    if c == "/" {
      out = push(out, cur)
      cur = ""
    } else {
      cur = cur + c
    }
  }
  push(out, cur)
}

fn glue(xs: List<Str>) -> Str {
  var out = ""
  var i = 0
  while i < len(xs) {
    out = if i == 0 { xs[i] } else { out + "/" + xs[i] }
    i += 1
  }
  out
}

// 规整：合并多个 /，去掉 .，消解 ..；空路径得到 "."
pub fn clean(p: Str) -> Str {
  if p == "" { return "." }
  let rooted = starts_with(p, "/")
  var out: List<Str> = []
  for seg in segments(p) {
    if seg == "" || seg == "." { continue }
    if seg == ".." {
      if len(out) > 0 && out[len(out) - 1] != ".." {
        out = take(out, len(out) - 1)
      } else if !rooted {
        out = push(out, "..")
      }
      continue
    }
    out = push(out, seg)
  }
  let body = glue(out)
  if rooted { "/" + body } else if body == "" { "." } else { body }
}

// 用 / 连接非空的部分后规整
pub fn join(parts: List<Str>) -> Str {
  let ps = filter(parts, (x) => x != "")
  if len(ps) == 0 { "" } else { clean(glue(ps)) }
}

// 最后一段；去掉末尾的 /；空路径得到 "."，全是 / 得到 "/"
pub fn base(p: Str) -> Str {
  if p == "" { return "." }
  var s = p
  while len(s) > 1 && ends_with(s, "/") { s = __str_slice(s, 0, len(s) - 1) }
  if s == "/" { return "/" }
  let segs = segments(s)
  segs[len(segs) - 1]
}

// 去掉最后一段后规整
pub fn dir(p: Str) -> Str {
  let (d, _) = split(p)
  clean(d)
}

// (目录部分含末尾的 /, 文件名)
pub fn split(p: Str) -> (Str, Str) {
  let cs = chars(p)
  var i = len(cs)
  while i > 0 && cs[i - 1] != "/" { i -= 1 }
  (__str_slice(p, 0, i), __str_slice(p, i, len(cs)))
}

// 最后一段里最后一个 . 开始的扩展名，没有时为 ""
pub fn ext(p: Str) -> Str {
  let cs = chars(p)
  var i = len(cs) - 1
  while i >= 0 && cs[i] != "/" {
    if cs[i] == "." { return __str_slice(p, i, len(cs)) }
    i -= 1
  }
  ""
}

pub fn is_abs(p: Str) -> Bool { starts_with(p, "/") }

// 去掉扩展名
pub fn stem(p: Str) -> Str {
  let b = base(p)
  let e = ext(b)
  __str_slice(b, 0, len(b) - len(e))
}

// 按 shell 通配符匹配：* 任意多个非 / 字符，? 一个非 / 字符，[abc] / [a-z] / [!a] 字符类，\ 转义
pub fn match_glob(pattern: Str, name: Str) -> Bool { glob(chars(pattern), 0, chars(name), 0) }

fn glob(p: List<Str>, i: Int, s: List<Str>, j: Int) -> Bool {
  if i == len(p) { return j == len(s) }
  let c = p[i]
  if c == "*" {
    var k = j
    while true {
      if glob(p, i + 1, s, k) { return true }
      if k >= len(s) || s[k] == "/" { return false }
      k += 1
    }
    false
  } else if j >= len(s) {
    false
  } else if c == "?" {
    s[j] != "/" && glob(p, i + 1, s, j + 1)
  } else if c == "[" {
    var k = i + 1
    let neg = k < len(p) && (p[k] == "!" || p[k] == "^")
    if neg { k += 1 }
    var hit = false
    var first = true
    while k < len(p) && (first || p[k] != "]") {
      first = false
      if k + 2 < len(p) && p[k + 1] == "-" && p[k + 2] != "]" {
        if s[j] >= p[k] && s[j] <= p[k + 2] { hit = true }
        k += 3
      } else {
        if s[j] == p[k] { hit = true }
        k += 1
      }
    }
    if k >= len(p) { return false }
    hit != neg && s[j] != "/" && glob(p, k + 1, s, j + 1)
  } else if c == "\\" && i + 1 < len(p) {
    s[j] == p[i + 1] && glob(p, i + 2, s, j + 1)
  } else {
    s[j] == c && glob(p, i + 1, s, j + 1)
  }
}
