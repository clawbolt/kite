// std.log.slog：对齐 Go 1.27 的 log/slog
//   Level（DEBUG=-4 INFO=0 WARN=4 ERROR=8，level_string 同 Level.String）、Value / Attr 构造函数、
//   Record、TextHandler / JSONHandler（HandlerOptions：最低级别、ReplaceAttr），with_attrs / with_group，
//   Logger（debug/info/warn/error/log、with、with_group、enabled），输出格式与 Go 逐字节相同。
//   与 Go 的差异：没有反射，Any 值用 any_value(文本形式, JSON 形式) 显式给出两种写法；
//   handle 返回要写出的一行（含换行），Logger 写到标准输出；不支持 AddSource 与自定义 Handler 接口。

use std.strconv
use std.unicode

pub const LEVEL_DEBUG: Int = -4
pub const LEVEL_INFO: Int = 0
pub const LEVEL_WARN: Int = 4
pub const LEVEL_ERROR: Int = 8

pub const TIME_KEY: Str = "time"
pub const LEVEL_KEY: Str = "level"
pub const MESSAGE_KEY: Str = "msg"
pub const SOURCE_KEY: Str = "source"

pub fn level_string(l: Int) -> Str {
  let (base, d) = if l < LEVEL_INFO {
    ("DEBUG", l - LEVEL_DEBUG)
  } else if l < LEVEL_WARN {
    ("INFO", l - LEVEL_INFO)
  } else if l < LEVEL_ERROR {
    ("WARN", l - LEVEL_WARN)
  } else {
    ("ERROR", l - LEVEL_ERROR)
  }
  if d == 0 { base } else if d > 0 { "{base}+{d}" } else { "{base}{d}" }
}

// Level.UnmarshalText：名字不分大小写，可带 +n / -n
pub fn parse_level(s: Str) -> Result<Int, Str> {
  let err = "slog: level string \"{s}\": unknown name"
  var name = s
  var off = 0
  let i = index_of_sign(s)
  if i >= 0 {
    name = __str_slice(s, 0, i)
    match strconv.atoi(__str_slice(s, i, len(s))) {
      Ok(n) => { off = n },
      Err(_) => {
        return Err(
          "slog: level string \"{s}\": strconv.Atoi: parsing \"{__str_slice(s, i, len(s))}\": invalid syntax",
        )
      },
    }
  }
  let base = match upper(name) {
    "DEBUG" => LEVEL_DEBUG,
    "INFO" => LEVEL_INFO,
    "WARN" => LEVEL_WARN,
    "ERROR" => LEVEL_ERROR,
    _ => { return Err(err) },
  }
  Ok(base + off)
}

fn index_of_sign(s: Str) -> Int {
  let b = __bytes(s)
  var i = 0
  while i < len(b) {
    if b[i] == 43 || b[i] == 45 { return i }
    i += 1
  }
  -1
}

fn upper(s: Str) -> Str {
  var b = __bytes(s)
  var i = 0
  while i < len(b) {
    if b[i] >= 97 && b[i] <= 122 { b[i] = b[i] - 32 }
    i += 1
  }
  match __from_bytes(b) { Some(t) => t, None => s }
}

pub enum Value {
  VStr(s: Str)
  VInt(i: Int)
  VUint(u: Int)
  VFloat(f: Float)
  VBool(b: Bool)
  VDuration(ns: Int)
  VGroup(attrs: List<Attr>)
  VLevel(l: Int)
  VErr(msg: Str)
  VAny(text: Str, json: Str)
  VNil
}

pub type Attr = { key: Str, value: Value }

pub fn string(k: Str, v: Str) -> Attr { Attr { key: k, value: VStr(v) } }
pub fn int(k: Str, v: Int) -> Attr { Attr { key: k, value: VInt(v) } }
pub fn uint64(k: Str, v: Int) -> Attr { Attr { key: k, value: VUint(v) } }
pub fn float64(k: Str, v: Float) -> Attr { Attr { key: k, value: VFloat(v) } }
pub fn bool(k: Str, v: Bool) -> Attr { Attr { key: k, value: VBool(v) } }
pub fn duration(k: Str, ns: Int) -> Attr { Attr { key: k, value: VDuration(ns) } }
pub fn group(k: Str, attrs: List<Attr>) -> Attr { Attr { key: k, value: VGroup(attrs) } }
pub fn level(k: Str, l: Int) -> Attr { Attr { key: k, value: VLevel(l) } }
pub fn err(k: Str, msg: Str) -> Attr { Attr { key: k, value: VErr(msg) } }
pub fn any_value(k: Str, text: Str, json: Str) -> Attr { Attr { key: k, value: VAny(text, json) } }
pub fn nil_attr(k: Str) -> Attr { Attr { key: k, value: VNil } }

pub fn kind_string(v: Value) -> Str {
  match v {
    VStr(_) => "String",
    VInt(_) => "Int64",
    VUint(_) => "Uint64",
    VFloat(_) => "Float64",
    VBool(_) => "Bool",
    VDuration(_) => "Duration",
    VGroup(_) => "Group",
    _ => "Any",
  }
}

fn is_empty_attr(a: Attr) -> Bool {
  a.key == "" && match a.value { VNil => true, _ => false }
}

fn is_empty_group(v: Value) -> Bool {
  match v {
    VGroup(xs) => {
      for a in xs { if !is_empty_attr(a) && !is_empty_group(a.value) { return false } }
      true
    },
    _ => false,
  }
}

fn count_empty_groups(xs: List<Attr>) -> Int {
  var n = 0
  for a in xs { if is_empty_group(a.value) { n += 1 } }
  n
}

// Go 的 Duration.String（纳秒）
pub fn duration_string(d: Int) -> Str {
  if d == 0 { return "0s" }
  let neg = d < 0
  let u = if neg { 0 - d } else { d }
  let sign = if neg { "-" } else { "" }
  if u < 1000000000 {
    if u < 1000 { return "{sign}{u}ns" }
    if u < 1000000 { return sign + frac(u, 1000) + "µs" }
    return sign + frac(u, 1000000) + "ms"
  }
  let secs = u / 1000000000
  let fs = frac(u % 60000000000, 1000000000) + "s"
  let h = secs / 3600
  let m = secs / 60 % 60
  if h > 0 { return "{sign}{h}h{m}m{fs}" }
  if m > 0 { return "{sign}{m}m{fs}" }
  sign + fs
}

fn frac(v: Int, unit: Int) -> Str {
  let w = v / unit
  var f = v % unit
  if f == 0 { return "{w}" }
  var digits = ""
  var u = unit / 10
  while u > 0 && f > 0 {
    digits = digits + "{f / u}"
    f = f % u
    u = u / 10
  }
  "{w}.{digits}"
}

// encoding/json 的浮点写法（ES6）
fn json_float(f: Float) -> Str {
  let a = if f < 0.0 { 0.0 - f } else { f }
  var e = false
  if a != 0.0 && (a < 0.000001 || a >= 1e21) { e = true }
  var s = strconv.format_float_go(f, if e { "e" } else { "f" }, -1, 64)
  if e {
    let b = __bytes(s)
    let n = len(b)
    if n >= 4 && b[n - 4] == 101 && b[n - 3] == 45 && b[n - 2] == 48 {
      s = __str_slice(s, 0, n - 2) + __str_slice(s, n - 1, n)
    }
  }
  s
}

fn json_safe(b: Int) -> Bool { b >= 32 && b != 34 && b != 92 && b < 127 || b == 127 }

const HEXD: Str = "0123456789abcdef"

fn json_escape(s: Str) -> Str {
  var out = ""
  for c in s {
    let o = __ord(c)
    if o < 128 {
      if json_safe(o) {
        out = out + c
      } else if o == 92 || o == 34 {
        out = out + "\\" + c
      } else if o == 10 {
        out = out + "\\n"
      } else if o == 13 {
        out = out + "\\r"
      } else if o == 9 {
        out = out + "\\t"
      } else {
        out = out + "\\u00" + __str_slice(HEXD, o / 16, o / 16 + 1) + __str_slice(
          HEXD,
          o % 16,
          o % 16 + 1,
        )
      }
    } else if o == 8232 {
      out = out + "\\u2028"
    } else if o == 8233 {
      out = out + "\\u2029"
    } else {
      out = out + c
    }
  }
  out
}

pub fn needs_quoting(s: Str) -> Bool {
  if s == "" { return true }
  for c in s {
    let o = __ord(c)
    if o < 128 {
      if o != 92 && (o == 32 || o == 61 || o == 34 || o < 32) { return true }
    } else if o == 65533 || unicode.is_space(c) || !unicode.is_print(c) {
      return true
    }
  }
  false
}

pub type HandlerOptions = { level: Int, replace_attr: Option<fn(List<Str>, Attr) -> Attr> }

pub fn default_options() -> HandlerOptions {
  HandlerOptions { level: LEVEL_INFO, replace_attr: None }
}

pub type Handler = {
  json: Bool,
  opts: HandlerOptions,
  pre: Str,              // preformattedAttrs
  group_prefix: Str,
  groups: List<Str>,
  n_open: Int,
}

pub fn new_text_handler(opts: HandlerOptions) -> Handler {
  Handler { json: false, opts: opts, pre: "", group_prefix: "", groups: [], n_open: 0 }
}

pub fn new_json_handler(opts: HandlerOptions) -> Handler {
  Handler { json: true, opts: opts, pre: "", group_prefix: "", groups: [], n_open: 0 }
}

pub type Record = { time: Option<Int>, level: Int, message: Str, attrs: List<Attr> }

pub fn new_record(level: Int, msg: Str) -> Record {
  Record { time: None, level: level, message: msg, attrs: [] }
}

impl Record {
  pub fn add_attrs(self, more: List<Attr>) -> Record {
    var xs = self.attrs
    for a in more { if !is_empty_group(a.value) { xs = push(xs, a) } }
    Record { attrs: xs, ..self }
  }
  pub fn num_attrs(self) -> Int { len(self.attrs) }
}

// handleState：值语义，所有方法返回新的状态
type St = { h: Handler, buf: Str, sep: Str, prefix: Str, groups: Option<List<Str>> }

fn attr_sep(h: Handler) -> Str { if h.json { "," } else { " " } }

fn new_state(h: Handler, buf: Str, sep: Str) -> St {
  let gs = match h.opts.replace_attr { Some(_) => Some(h.groups[0..h.n_open]), None => None }
  St { h: h, buf: buf, sep: sep, prefix: "", groups: gs }
}

fn st_string(s: St, str: Str) -> St {
  if s.h.json {
    St { buf: s.buf + "\"" + json_escape(str) + "\"", ..s }
  } else if needs_quoting(str) {
    St { buf: s.buf + strconv.quote_go(str), ..s }
  } else {
    St { buf: s.buf + str, ..s }
  }
}

fn st_key(s0: St, key: Str) -> St {
  var s = St { buf: s0.buf + s0.sep, ..s0 }
  if s.prefix != "" {
    if s.h.json {
      s = St { buf: s.buf + "\"" + json_escape(s.prefix) + json_escape(key) + "\"", ..s }
    } else if !needs_quoting(s.prefix) && !needs_quoting(key) {
      s = St { buf: s.buf + s.prefix + key, ..s }
    } else {
      s = St { buf: s.buf + strconv.quote_go(s.prefix + key), ..s }
    }
  } else {
    s = st_string(s, key)
  }
  St { buf: s.buf + if s.h.json { ":" } else { "=" }, sep: attr_sep(s.h), ..s }
}

fn st_value(s: St, v: Value) -> St {
  match v {
    VStr(x) => st_string(s, x),
    VInt(i) => St { buf: s.buf + "{i}", ..s },
    VUint(u) => St { buf: s.buf + strconv.format_uint(u, 10), ..s },
    VFloat(f) => {
      if s.h.json {
        if f != f {
          st_string(s, "!ERROR:json: unsupported value: NaN")
        } else if f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {
          st_string(s, "!ERROR:json: unsupported value: " + strconv.format_float_go(f, "g", -1, 64))
        } else {
          St { buf: s.buf + json_float(f), ..s }
        }
      } else {
        St { buf: s.buf + strconv.format_float_go(f, "g", -1, 64), ..s }
      }
    },
    VBool(b) => St { buf: s.buf + if b { "true" } else { "false" }, ..s },
    VDuration(ns) => if s.h.json {
      St { buf: s.buf + "{ns}", ..s }
    } else {
      St { buf: s.buf + duration_string(ns), ..s }
    },
    VLevel(l) => if s.h.json {
      St { buf: s.buf + "\"" + level_string(l) + "\"", ..s }
    } else {
      st_string(s, level_string(l))
    },
    VErr(m) => st_string(s, m),
    VAny(t, j) => if s.h.json { St { buf: s.buf + j, ..s } } else { st_string(s, t) },
    VNil => if s.h.json { St { buf: s.buf + "null", ..s } } else { st_string(s, "<nil>") },
    VGroup(xs) => {
      // 只会出现在 ReplaceAttr 之外的非常规路径；同 Go 的 %v
      var t = "["
      var first = true
      for a in xs {
        if !first { t = t + " " }
        first = false
        t = t + a.key + "=" + value_text(a.value)
      }
      St { buf: s.buf + t + "]", ..s }
    },
  }
}

fn value_text(v: Value) -> Str {
  match v {
    VStr(x) => x,
    VInt(i) => "{i}",
    VUint(u) => strconv.format_uint(u, 10),
    VFloat(f) => strconv.format_float_go(f, "g", -1, 64),
    VBool(b) => if b { "true" } else { "false" },
    VDuration(ns) => duration_string(ns),
    VLevel(l) => level_string(l),
    VErr(m) => m,
    VAny(t, _) => t,
    VNil => "<nil>",
    VGroup(_) => "[...]",
  }
}

fn open_group(s0: St, name: Str) -> St {
  var s = s0
  if s.h.json {
    s = st_key(s, name)
    s = St { buf: s.buf + "{{", sep: "", ..s }
  } else {
    s = St { prefix: s.prefix + name + ".", ..s }
  }
  match s.groups { Some(gs) => St { groups: Some(push(gs, name)), ..s }, None => s }
}

fn close_group(s0: St, name: Str) -> St {
  var s = s0
  if s.h.json {
    s = St { buf: s.buf + "}}", ..s }
  } else {
    s = St { prefix: __str_slice(s.prefix, 0, len(s.prefix) - len(name) - 1), ..s }
  }
  s = St { sep: attr_sep(s.h), ..s }
  match s.groups { Some(gs) => St { groups: Some(gs[0..len(gs) - 1]), ..s }, None => s }
}

fn open_groups(s0: St) -> St {
  var s = s0
  var i = s.h.n_open
  while i < len(s.h.groups) { s = open_group(s, s.h.groups[i]); i += 1 }
  s
}

fn append_attrs(s0: St, xs: List<Attr>) -> (St, Bool) {
  var s = s0
  var non = false
  for a in xs {
    let (s2, ok) = append_attr(s, a)
    s = s2
    if ok { non = true }
  }
  (s, non)
}

fn append_attr(s0: St, a0: Attr) -> (St, Bool) {
  var s = s0
  var a = a0
  match s.h.opts.replace_attr {
    Some(rep) => {
      let isg = match a.value { VGroup(_) => true, _ => false }
      if !isg {
        let gs = match s.groups { Some(g) => g, None => [] }
        a = rep(gs, a)
      }
    },
    None => {},
  }
  if is_empty_attr(a) { return (s, false) }
  match a.value {
    VGroup(attrs) => {
      if len(attrs) > 0 {
        let pos = s.buf
        if a.key != "" { s = open_group(s, a.key) }
        let (s2, ok) = append_attrs(s, attrs)
        s = s2
        if !ok { return (St { buf: pos, ..s }, false) }
        if a.key != "" { s = close_group(s, a.key) }
      }
    },
    _ => {
      s = st_key(s, a.key)
      s = st_value(s, a.value)
    },
  }
  (s, true)
}

// "2006-01-02T15:04:05.000Z07:00"（文本）/ RFC 3339 纳秒（JSON），这里用 UTC，参数是 Unix 纳秒
fn st_time(s: St, ns: Int) -> St {
  let days = fdiv(ns, 86400000000000)
  let rem = ns - days * 86400000000000
  let (y, mo, d) = civil(days)
  let hh = rem / 3600000000000
  let mi = rem / 60000000000 % 60
  let ss = rem / 1000000000 % 60
  let sub = rem % 1000000000
  let base = "{pad(y, 4)}-{pad(mo, 2)}-{pad(d, 2)}T{pad(hh, 2)}:{pad(mi, 2)}:{pad(ss, 2)}"
  if s.h.json {
    var f = ""
    if sub != 0 {
      f = "." + pad(sub, 9)
      while __str_slice(f, len(f) - 1, len(f)) == "0" { f = __str_slice(f, 0, len(f) - 1) }
    }
    St { buf: s.buf + "\"" + base + f + "Z\"", ..s }
  } else {
    st_string(s, base + "." + pad(sub / 1000000, 3) + "Z")
  }
}

fn fdiv(a: Int, b: Int) -> Int { if a >= 0 { a / b } else { 0 - ((0 - a + b - 1) / b) } }

fn pad(n: Int, w: Int) -> Str {
  var t = "{n}"
  while len(t) < w { t = "0" + t }
  t
}

fn civil(z0: Int) -> (Int, Int, Int) {
  let z = z0 + 719468
  let era = fdiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  (if m <= 2 { y + 1 } else { y }, m, d)
}

impl Handler {
  pub fn enabled(self, l: Int) -> Bool { l >= self.opts.level }

  pub fn with_attrs(self, xs: List<Attr>) -> Handler {
    if count_empty_groups(xs) == len(xs) { return self }
    var s = new_state(self, self.pre, "")
    s = St { prefix: self.group_prefix, ..s }
    if self.pre != "" {
      s = St { sep: attr_sep(self), ..s }
      if self.json && __str_slice(self.pre, len(self.pre) - 1, len(self.pre)) == "{{" {
        s = St { sep: "", ..s }
      }
    }
    let pos = s.buf
    s = open_groups(s)
    let (s2, ok) = append_attrs(s, xs)
    if !ok { return Handler { pre: pos, ..self } }
    Handler { pre: s2.buf, group_prefix: s2.prefix, n_open: len(self.groups), ..self }
  }

  pub fn with_group(self, name: Str) -> Handler {
    Handler { groups: push(self.groups, name), ..self }
  }

  // 返回要写出的一整行（含换行）
  pub fn handle(self, r: Record) -> Str {
    var s = new_state(self, if self.json { "{{" } else { "" }, "")
    let saved = s.groups
    s = St { groups: None, ..s }
    let has_rep = match self.opts.replace_attr { Some(_) => true, None => false }
    match r.time {
      Some(t) => {
        if !has_rep {
          s = st_key(s, TIME_KEY); s = st_time(s, t)
        } else {
          // ReplaceAttr 看到的是 Any 形式的时间；这里给出与输出一致的文本 / JSON
          let tt = st_time(St { buf: "", ..s }, t).buf
          let tj = st_time(St { buf: "", h: Handler { json: true, ..self }, ..s }, t).buf
          let (s2, _) = append_attr(s, any_value(TIME_KEY, tt, tj))
          s = s2
        }
      },
      None => {},
    }
    if !has_rep {
      s = st_key(s, LEVEL_KEY); s = st_string(s, level_string(r.level))
    } else {
      let (s2, _) = append_attr(s, level(LEVEL_KEY, r.level)); s = s2
    }
    if !has_rep {
      s = st_key(s, MESSAGE_KEY); s = st_string(s, r.message)
    } else {
      let (s2, _) = append_attr(s, string(MESSAGE_KEY, r.message)); s = s2
    }
    s = St { groups: saved, ..s }
    // appendNonBuiltIns
    if self.pre != "" {
      s = St { buf: s.buf + s.sep + self.pre, sep: attr_sep(self), ..s }
      if self.json && __str_slice(self.pre, len(self.pre) - 1, len(self.pre)) == "{{" {
        s = St { sep: "", ..s }
      }
    }
    var nopen = self.n_open
    if len(r.attrs) > 0 {
      s = St { prefix: s.prefix + self.group_prefix, ..s }
      let pos = s.buf
      s = open_groups(s)
      nopen = len(self.groups)
      var empty = true
      for a in r.attrs {
        let (s2, ok) = append_attr(s, a)
        s = s2
        if ok { empty = false }
      }
      if empty { s = St { buf: pos, ..s }; nopen = self.n_open }
    }
    if self.json {
      var i = 0
      while i < nopen { s = St { buf: s.buf + "}}", ..s }; i += 1 }
      s = St { buf: s.buf + "}}", ..s }
    }
    s.buf + "\n"
  }
}

// ── Logger ──
pub type Logger = { handler: Handler }

pub fn new(h: Handler) -> Logger { Logger { handler: h } }

impl Logger {
  pub fn with(self, xs: List<Attr>) -> Logger {
    if len(xs) == 0 { return self }
    Logger { handler: self.handler.with_attrs(xs) }
  }
  pub fn with_group(self, name: Str) -> Logger {
    if name == "" { return self }
    Logger { handler: self.handler.with_group(name) }
  }
  pub fn enabled(self, l: Int) -> Bool { self.handler.enabled(l) }
  // 生成这一行（不写出）；没开启的级别返回 ""
  pub fn format(self, l: Int, msg: Str, xs: List<Attr>) -> Str {
    if !self.enabled(l) { return "" }
    let r = Record { time: Some(__unix_ns()), level: l, message: msg, attrs: [] }.add_attrs(xs)
    self.handler.handle(r)
  }
  pub fn log(self, l: Int, msg: Str, xs: List<Attr>) {
    let line = self.format(l, msg, xs)
    if line != "" { print(__str_slice(line, 0, len(line) - 1)) }
  }
  pub fn debug(self, msg: Str, xs: List<Attr>) { self.log(LEVEL_DEBUG, msg, xs) }
  pub fn info(self, msg: Str, xs: List<Attr>) { self.log(LEVEL_INFO, msg, xs) }
  pub fn warn(self, msg: Str, xs: List<Attr>) { self.log(LEVEL_WARN, msg, xs) }
  pub fn error(self, msg: Str, xs: List<Attr>) { self.log(LEVEL_ERROR, msg, xs) }
}
